# hoosh.bcyr — hoosh gateway benchmarks, on the real src/ code.
#
# Run: cyrius bench tests/hoosh.bcyr
#   or: cyrius build tests/hoosh.bcyr /tmp/hoosh_bench && /tmp/hoosh_bench
#
# 2.9.24: every row times the gateway's own functions. Through 2.9.23 this file included no src/ module and 62 of
# its 65 functions were copies of src/ (the router, the cache, the pools, the DLP scanner, the rate limiter, cost
# accounting, the audit step, the event ring, the work queue, ...), so a change to src/ could not move a row. It
# now includes src/lib the way tests/hoosh.tcyr does, and each row calls the real function. Two rows were dropped:
# queue_enqueue_dequeue and queue_5tier_sort timed a five-tier priority queue the gateway does not have (requests
# go through wq.cyr). CHANGELOG 2.9.24 has each row's old-against-new numbers.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/chrono.cyr"
include "lib/freelist.cyr"
include "lib/bayan.cyr"
include "lib/ct.cyr"
include "lib/sigil.cyr"
# NOTE: do NOT explicitly `include "lib/syscalls.cyr"` here — see the same note
# in tests/hoosh.tcyr. `cyrius build` prepends the auto-injected stdlib `tls`
# (which takes `&sys_getrandom` since 6.2.28) ahead of this file's explicit
# includes; an explicit syscalls here would land after it → single-pass
# "undefined variable 'sys_getrandom'". Let syscalls auto-inject before tls.
include "lib/sakshi.cyr"

# src/lib, in tests/hoosh.tcyr's order (which follows src/main.cyr's). 2.12.0: cli.cyr, for the command-line parse,
# and cmdit's bundle before it.
include "lib/ai-hwaccel.cyr"
include "lib/tyche.cyr"
include "lib/rosnet.cyr"
include "lib/tentib.cyr"
include "lib/cmdit.cyr"
# 2.12.2: the speech chain, in src/main.cyr's order, for svara_local.cyr.
include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "lib/varna.cyr"
include "lib/shabdakosh.cyr"
include "lib/shabda.cyr"
include "src/vendor/bote-core.cyr"
include "src/vendor/majra.cyr"
# 2.12.1: szál's MCP tools bundle, after bote-core and majra as src/main.cyr has it (mcp.cyr registers its groups).
include "src/vendor/szal-mcp.cyr"
include "src/lib/types.cyr"
include "src/lib/reqmem.cyr"
include "src/lib/keep.cyr"   # 2.11.2: for real, as the cache recycles through it
include "src/lib/logging.cyr"
include "src/lib/dlp.cyr"
include "src/lib/ratelimit.cyr"
include "src/lib/auth.cyr"
include "src/lib/http_server.cyr"
include "src/lib/jsonlite.cyr"
include "src/lib/compact.cyr"
include "src/lib/provider_err.cyr"
include "src/lib/catalog.cyr"
include "src/lib/outcome.cyr"
include "src/lib/tentib_local.cyr"
include "src/lib/svara_local.cyr"
include "src/lib/urlparse.cyr"
include "src/lib/mcp.cyr"
include "src/lib/compression.cyr"
include "src/lib/semantic.cyr"
include "src/lib/trace.cyr"
include "src/lib/route.cyr"
include "src/lib/cache.cyr"
include "src/lib/http_client.cyr"
include "src/lib/events.cyr"
include "src/lib/hardware.cyr"
include "src/lib/router.cyr"
include "src/lib/health.cyr"
# main.cyr's global; health.cyr names it.
var _router = 0;
include "src/lib/budget.cyr"
include "src/lib/audit.cyr"
include "src/lib/storage.cyr"
include "src/lib/otlp.cyr"
include "src/lib/provider.cyr"
include "src/lib/retry.cyr"
include "src/lib/reqparse.cyr"
include "src/lib/cfgparse.cyr"
include "src/lib/wq.cyr"
include "src/lib/cli.cyr"
include "src/lib/keyindex.cyr"
include "src/lib/pricing.cyr"
include "src/lib/metadata.cyr"
include "src/lib/models.cyr"
include "src/lib/metrics.cyr"

# 2.9.11: an 8-byte-aligned heap copy of a literal, for the strings a timed loop reads. String literals are packed
# into .rodata back to back with no alignment, and the stdlib strlen (which streq calls twice) walks byte by byte
# until the pointer reaches an 8-byte boundary. So a row that timed a literal depended on everything stored before
# that literal, including the CYRIUS_PKG_VERSION declaration, which cyrius puts first in .rodata: 2.9.10's one byte
# longer version string moved cache_get_hit 119 -> 146 ns and cost_record_local_free 109 -> 136 ns on unchanged
# code. The gateway's hot strings (cache keys, configured URLs, model patterns) are heap strings, and alloc rounds
# every allocation to 8 bytes; these copies are too. Copy outside the timed loop, never inside it.
fn _b_s(lit) {
    var n = strlen(lit);
    var p = alloc(n + 1);
    memcpy(p, lit, n + 1);
    return p;
}

fn main() {
    alloc_init();
    # main's thread-local block, as the gateway installs it at startup (2.12.1: first, since the MCP rows reach the
    # request arena; through 2.12.0 it was installed later, before the provider-refusal row).
    crypto_tls_main_init();

    # The gateway reads time from a coarse ticker (logging.cyr's hoosh_now_ms; 2.5.11): clock_now_ms is a 1.35 us
    # syscall here, which was ~98% of a cache hit and ~96% of a rate-limit check. One reading stands in for the
    # ticker, so the rows that read the clock time the production path, not the syscall.
    _coarse_now_ms = clock_now_ms();
    _coarse_started = 1;

    println("=== hoosh benchmarks ===");
    println("");

    # ── Setup: 20-provider router (matches Rust bench) ────────────
    var routes = alloc(20 * 8);
    var i = 0;
    while (i < 20) {
        # The 18 text providers, as through 2.12.1: since 2.12.2 a svara route is skipped by text selection, so
        # i % PROV_COUNT would hand this row one route fewer to rank.
        var prov = i % PROV_SVARA;
        var r = route_new(prov, i + 1, _b_s("http://localhost"));
        var pats = alloc(8);
        store64(pats, _b_s("llama*"));
        route_set_patterns(r, pats, 1);
        store64(routes + i * 8, r);
        i = i + 1;
    }
    var b_router = router_new(routes, 20, STRAT_PRIORITY);

    # ── Benchmark: route_select_20_providers ──────────────────────
    var b_llama3 = _b_s("llama3");
    var b = bench_new("route_select_20_providers");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        router_select(b_router, b_llama3);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: route_round_robin_10 ───────────────────────────
    var rr_routes = alloc(10 * 8);
    i = 0;
    while (i < 10) {
        var r = route_new(i % PROV_SVARA, 1, _b_s("http://localhost"));     # text providers only (2.12.2)
        store64(rr_routes + i * 8, r);
        i = i + 1;
    }
    var rr_rt = router_new(rr_routes, 10, STRAT_ROUND_ROBIN);
    var b_any = _b_s("anything");

    b = bench_new("route_round_robin_10");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        router_select(rr_rt, b_any);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: pool_reserve_commit_cycle ──────────────────────
    var b_pname = _b_s("bench");
    b = bench_new("pool_reserve_commit");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        var p = pool_new(b_pname, 1000000);
        pool_reserve(p, 500);
        pool_commit(p, 500, 420);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: pool_available ─────────────────────────────────
    var b_pool = pool_new(b_pname, 1000000);
    pool_reserve(b_pool, 50000);

    b = bench_new("pool_available");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        pool_available(b_pool);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # ── Benchmark: cache_get_hit ──────────────────────────────────
    var b_cache = cache_new(10000, 1, 300);
    cache_insert(b_cache, _b_s("prompt-hash-1"), 42);
    var b_hit = _b_s("prompt-hash-1");
    var b_miss = _b_s("nonexistent-key");
    var b_key = _b_s("key");

    b = bench_new("cache_get_hit");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        cache_get(b_cache, b_hit);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: cache_get_miss ─────────────────────────────────
    b = bench_new("cache_get_miss");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        cache_get(b_cache, b_miss);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: cache_insert ───────────────────────────────────
    b = bench_new("cache_insert");
    var ci_cache = cache_new(100000, 1, 300);
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        cache_insert(ci_cache, b_key, i);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: cache_insert_full (2.10.0) ─────────────────────
    # The default 10000-entry cache, full, taking new keys: each insert evicts the least recently used. Through 2.9.26
    # every such insert built map_keys() twice and scanned every entry, about 4 ms and 524 KB; the row above never
    # filled its cache, so it did not see that.
    var cf_cache = cache_new(10000, 1, 300);
    var cf_keys = vec_new();
    i = 0;
    while (i < 12000) {
        var cf_k = _b_s("cache-full-key-00000");
        store8(cf_k + 15, 48 + (i / 10000) % 10);
        store8(cf_k + 16, 48 + (i / 1000) % 10);
        store8(cf_k + 17, 48 + (i / 100) % 10);
        store8(cf_k + 18, 48 + (i / 10) % 10);
        store8(cf_k + 19, 48 + i % 10);
        vec_push(cf_keys, cf_k);
        i = i + 1;
    }
    i = 0;
    while (i < 10000) {
        cache_insert(cf_cache, vec_get(cf_keys, i), i);
        i = i + 1;
    }
    b = bench_new("cache_insert_full");
    bench_batch_start(b);
    i = 10000;
    while (i < 12000) {
        cache_insert(cf_cache, vec_get(cf_keys, i), i);
        i = i + 1;
    }
    bench_batch_stop(b, 2000);
    bench_report(b);

    # ── Benchmark: route_matches_model (pattern match) ────────────
    var pats = alloc(16);
    store64(pats, _b_s("llama*"));
    store64(pats + 8, _b_s("mistral*"));
    var mr = route_new(PROV_OLLAMA, 1, _b_s("http://localhost"));
    var b_model = _b_s("llama3.2:latest");
    route_set_patterns(mr, pats, 2);

    b = bench_new("route_matches_model");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        route_matches_model(mr, b_model);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # ── Benchmark: estimate_tokens (per-provider, per chat request) ─
    b = bench_new("estimate_tokens_per_provider");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        estimate_tokens(0, 4096, chars_per_token_x10(PROV_ANTHROPIC));
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # ── Benchmark: dlp_scan_level on a clean prompt (per-request cost) ─
    # dlp.cyr is off by default; [dlp] enabled turns it on, as here.
    dlp_configure(1, CLASS_PUBLIC);
    var dlp_buf = _b_s("Explain how Rust ownership and borrowing interact with lifetimes, and give a short worked example with a function that returns a reference.");
    var dlp_len = strlen(dlp_buf);
    b = bench_new("dlp_scan_clean_prompt");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        dlp_scan_level(dlp_buf, dlp_len);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: mcp_tools_list (bote dispatch) ─────────────────
    # Full JSON-RPC parse → dispatch → tools/list result serialize, the per-request cost behind GET /v1/tools/list,
    # on the dispatcher mcp_init builds for the gateway (its bote_echo tool). 2.12.1: through mcp_dispatch, the
    # gateway's path: _mcp_lock, and bote's bytes on the request arena, released each iteration as a job would.
    var mcp_disp = mcp_init();
    var b_mlist = _b_s("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    var b_mcall = _b_s("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"bote_echo\",\"arguments\":{\"k\":\"v\"}}}");

    b = bench_new("mcp_tools_list");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        req_arena_begin();
        mcp_dispatch(b_mlist);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: mcp_tools_call (bote dispatch + echo) ──────────
    b = bench_new("mcp_tools_call");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        req_arena_begin();
        mcp_dispatch(b_mcall);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: mcp_szal_math_eval (2.12.1) ────────────────────
    # One szál tool through the gateway's dispatch: `[mcp] tools = ["math"]`, szal_math_eval on "2*512 + 3*4".
    var b_mgroups = alloc(8);
    store64(b_mgroups, _b_s("math"));
    mcp_configure(b_mgroups, 1, 0);
    var b_mmath = _b_s("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"szal_math_eval\",\"arguments\":{\"expression\":\"2*512 + 3*4\"}}}");
    b = bench_new("mcp_szal_math_eval");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        req_arena_begin();
        mcp_dispatch(b_mmath);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: batch_split_4 (POST /v1/batch request parsing) ─
    var barr = _b_s("[{\"model\":\"llama3\",\"messages\":[{\"role\":\"user\",\"content\":\"hello world\"}]},{\"model\":\"llama3\",\"messages\":[{\"role\":\"user\",\"content\":\"second\"}]},{\"model\":\"llama3\",\"messages\":[{\"role\":\"user\",\"content\":\"third\"}]},{\"model\":\"llama3\",\"messages\":[{\"role\":\"user\",\"content\":\"fourth\"}]}]");
    var barr_len = strlen(barr);
    b = bench_new("batch_split_4");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        _batch_split(barr, barr_len);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # ── Benchmark: latency_bucket_find (per-forward histogram cost) ─
    b = bench_new("latency_bucket_find");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        _lat_bucket(i % 12000);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # ── Benchmark: work_queue_push_pop (per-request dispatch cost) ──
    # wq.cyr's ring under its mutex: the accept loop's push, a worker's pop, and the worker's wq_done.
    wq_init();
    b = bench_new("work_queue_push_pop");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        wq_try_push(i + 1);
        wq_pop();
        wq_done();
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # ── Benchmark: cli_parse_serve (2.12.0) ──────────────────────
    # The whole command line through cmdit (cli.cyr), once at startup: the global -c, the verb, serve's handle and
    # its flags. Each parse builds two handles, as main() does.
    var cl_words = vec_new();
    vec_push(cl_words, _b_s("hoosh")); vec_push(cl_words, _b_s("-c")); vec_push(cl_words, _b_s("hoosh.cyml"));
    vec_push(cl_words, _b_s("serve")); vec_push(cl_words, _b_s("--port")); vec_push(cl_words, _b_s("9000"));
    vec_push(cl_words, _b_s("--bind")); vec_push(cl_words, _b_s("0.0.0.0"));
    var cl_argv = alloc(9 * 8);
    i = 0;
    while (i < 8) { store64(cl_argv + i * 8, vec_get(cl_words, i)); i = i + 1; }
    store64(cl_argv + 64, 0);
    var cl_out = alloc(CLI_SIZE);
    b = bench_new("cli_parse_serve");
    bench_batch_start(b);
    i = 0;
    while (i < 2000) {
        cli_parse_argv(8, cl_argv, cl_out);
        i = i + 1;
    }
    bench_batch_stop(b, 2000);
    bench_report(b);

    # ── 2.5.10: per-request cost of the security + accounting paths ──
    # rust-old benched these (hot_path.rs / providers.rs); the port did not, so
    # the four things every single request pays for — auth compare, rate-limit
    # check, cost accounting, audit append — had no numbers at all.
    # The auth rows time stdlib ct_eq_bytes_lens, the compare auth_check runs on each configured token.

    # Benchmark: auth_verify_token — constant-time compare on the hot path.
    # All three tokens are the SAME LENGTH on purpose. ct_eq_bytes_lens
    # short-circuits on a length mismatch — unavoidable and not a secret — so
    # comparing a 25-byte token against a 24-byte one measures that early exit,
    # not the constant-time property. What must not vary is the cost of a
    # same-length token that differs EARLY vs LATE: if the first-byte mismatch
    # is cheaper than the last-byte one, the compare leaks a prefix oracle and
    # an attacker can recover the token byte by byte.
    var _b_tok = _b_s("bearer-secret-token-12345");
    var _b_tok2 = _b_s("bearer-secret-token-12345");
    var _b_late = _b_s("bearer-secret-token-1234X");   # differs in the LAST byte
    var _b_early = _b_s("Xearer-secret-token-12345");  # differs in the FIRST byte
    b = bench_new("auth_verify_token");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        ct_eq_bytes_lens(_b_tok, strlen(_b_tok), _b_tok2, strlen(_b_tok2));
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    b = bench_new("auth_verify_wrong_late");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        ct_eq_bytes_lens(_b_tok, strlen(_b_tok), _b_late, strlen(_b_late));
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    b = bench_new("auth_verify_wrong_early");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        ct_eq_bytes_lens(_b_tok, strlen(_b_tok), _b_early, strlen(_b_early));
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # Benchmark: rate_limit_check — token-bucket refill + take.
    var b_rl = hoosh_ratelimit_new(600);
    b = bench_new("rate_limit_check");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        hoosh_ratelimit_check(b_rl);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # Benchmark: cost_record — pricing lookup + accumulate, per completion.
    cost_reset();
    var b_oai = _b_s("https://api.openai.com");
    var b_gpt = _b_s("gpt-4o");
    var b_local = _b_s("http://localhost:11434");
    var b_llama = _b_s("llama3");
    b = bench_new("cost_record_known_model");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        cost_record(PROV_OPENAI, b_oai, 1000, 500, b_gpt);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # Local providers short-circuit before the model table (2.5.6).
    b = bench_new("cost_record_local_free");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        cost_record(PROV_OLLAMA, b_local, 1000, 500, b_llama);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # 2.9.25: the same two lookups with a live catalog, as a gateway with catalog = "live" routes has one: three
    # routes listing 100 models each, the model the 51st on the third. Through 2.9.24 every lookup scanned the lists
    # linearly (cost_record 22 us, metadata_lookup 20 us here); catalog.cyr indexes each list when it is published.
    var lc_snap = vec_new();
    var lc_r = 0;
    while (lc_r < 3) {
        var lc_rec = catalog_record_new(PROV_OPENAI, _b_s("https://api.openai.com"));
        var lc_es = vec_new();
        var lc_k = 0;
        while (lc_k < 100) {
            var lc_id = _b_s("some-listed-model-name-0000");
            store8(lc_id + 23, 48 + lc_r);
            store8(lc_id + 24, 48 + lc_k / 10);
            store8(lc_id + 25, 48 + lc_k % 10);
            if (lc_r == 2 && lc_k == 50) { lc_id = _b_s("gpt-4o"); }
            vec_push(lc_es, catalog_entry_new(lc_id, CATSRC_LIVE));
            lc_k = lc_k + 1;
        }
        catalog_record_note(lc_rec, 200, lc_es, 1);
        vec_push(lc_snap, lc_rec);
        lc_r = lc_r + 1;
    }
    catalog_publish(lc_snap);
    b = bench_new("cost_record_live_catalog");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        cost_record(PROV_OPENAI, b_oai, 1000, 500, b_gpt);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    var lc_md = alloc(40);
    b = bench_new("metadata_lookup_live_catalog");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        metadata_lookup(b_gpt, lc_md);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);
    catalog_publish(0);

    # 2.10.2: the model listings at 200 entries, the size where a GET kept 413 KB. catalog_body_build is what every
    # GET /v1/models/catalog did through 2.10.1 and one in a change does now; catalog_body_held is every other GET.
    var mc_pat = alloc(8);
    store64(mc_pat, _b_s("claude-*"));
    var mc_base = _b_s("https://api.example");
    var mc_route = route_new(PROV_ANTHROPIC, 1, mc_base);
    route_set_patterns(mc_route, mc_pat, 1);
    var mc_routes = alloc(8);
    store64(mc_routes, mc_route);
    var mc_rt = router_new(mc_routes, 1, STRAT_PRIORITY);
    var mc_es = vec_new();
    var mc_i = 0;
    while (mc_i < 200) {
        var mc_id = _b_s("claude-opus-5-5-20260000");
        store8(mc_id + 21, 48 + mc_i / 100);
        store8(mc_id + 22, 48 + (mc_i / 10) % 10);
        store8(mc_id + 23, 48 + mc_i % 10);
        var mc_e = catalog_entry_new(mc_id, CATSRC_LIVE);
        store64(mc_e + CAT_E_DISPLAY, _b_s("Claude Opus 5.5"));
        store64(mc_e + CAT_E_CTX, 1000000);
        store64(mc_e + CAT_E_MAXOUT, 128000);
        store64(mc_e + CAT_E_VISION, 1);
        store64(mc_e + CAT_E_THINK, CAT_THINK_ADAPTIVE | CAT_THINK_DISABLE);
        store64(mc_e + CAT_E_EFFORT, 31);
        store64(mc_e + CAT_E_KIND, CAT_KIND_CHAT);
        vec_push(mc_es, mc_e);
        mc_i = mc_i + 1;
    }
    var mc_rec = catalog_record_new(PROV_ANTHROPIC, mc_base);
    catalog_record_note(mc_rec, 200, mc_es, 1);
    var mc_snap = vec_new();
    vec_push(mc_snap, mc_rec);
    catalog_publish(mc_snap);
    b = bench_new("catalog_body_build_200");
    bench_batch_start(b);
    i = 0;
    while (i < 100) {
        models_catalog_json(mc_rt);
        i = i + 1;
    }
    bench_batch_stop(b, 100);
    bench_report(b);

    models_catalog_body(mc_rt);
    b = bench_new("catalog_body_held_200");
    bench_batch_start(b);
    i = 0;
    while (i < 1000000) {
        models_catalog_body(mc_rt);
        i = i + 1;
    }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    var mc_arena = arena_allocator_growable(262144);
    b = bench_new("models_list_200_arena");
    bench_batch_start(b);
    i = 0;
    while (i < 1000) {
        reset_via(mc_arena);
        models_list_json_a(mc_arena, mc_rt);
        i = i + 1;
    }
    bench_batch_stop(b, 1000);
    bench_report(b);
    catalog_publish(0);

    # Benchmark: audit_record — one event on a chain: the entry hash (SHA-256), the HMAC signature over it and the
    # previous hash, the entry linked in, and the oldest evicted once the chain holds max_entries (1000 here).
    # Storage write-through is off, as without [[storage]].
    sha256_global_init();
    var b_chain = audit_chain_new(_b_s("audit-key"), 9, 1000);
    var b_aev = _b_s("inference.request");
    var b_alvl = _b_s("info");
    var b_amsg = _b_s("completed");
    var b_aprov = _b_s("openai");
    b = bench_new("audit_record_sign");
    bench_batch_start(b);
    i = 0;
    while (i < 10000) {
        audit_record(b_chain, b_aev, b_alvl, b_amsg, b_aprov, b_gpt);
        i = i + 1;
    }
    bench_batch_stop(b, 10000);
    bench_report(b);

    # Benchmark: event_publish — the bus publish (no subscribers) and the recent-events ring, under its lock.
    events_init();
    var b_topic = _b_s("providers/inference");
    var b_ev = _b_s("{\"event\":\"inference_completed\"}");
    b = bench_new("event_publish_ring");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        event_emit(b_topic, b_ev);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # 2.10.3: a completion's event as provider_forward emits it: built on the stack, copied into its recycled slot.
    var b_evp = _b_s("ollama");
    var b_evm = _b_s("llama3.2:latest");
    b = bench_new("event_completed_ring");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        event_inference_completed(b_evp, b_evm, 120, 42);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # 2.10.2: a provider's refusal, clipped to whole characters: 511 bytes of three-byte UTF-8, the slow branch.
    # provider_err's state is per thread, in the thread-local block main installs first.
    var pe_sb = str_builder_new();
    i = 0;
    while (i < 400) {
        str_builder_add_cstr(pe_sb, _b_s("\xe4\xb8\xad"));
        i = i + 1;
    }
    var pe_s = str_builder_build(pe_sb);
    b = bench_new("provider_err_set_utf8_511b");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        provider_err_set(400, str_data(pe_s), str_len(pe_s));
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # 2.10.3: a request with a traceparent begins hoosh's own context under it (trace.cyr), in the thread's block.
    var tb_req = _b_s("POST /v1/chat/completions HTTP/1.1\r\nHost: h\r\ntraceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\nContent-Type: application/json\r\n\r\n{}");
    var tb_len = strlen(tb_req);
    b = bench_new("trace_begin_child");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        trace_begin(tb_req, tb_len);
        trace_current_or_new();
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    trace_set(0);

    # 2.10.3: what a buffered chat builds in the request arena (reqmem.cyr), each released by the next job's start.
    var ra = req_arena();
    var rb_body = _b_s("{\"model\":\"llama3\",\"messages\":[{\"role\":\"user\",\"content\":\"Explain how ownership and borrowing interact with lifetimes.\"}]}");
    var rb_blen = strlen(rb_body);
    b = bench_new("cache_key_arena");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        req_arena_begin();
        _cache_key_a(ra, b_llama3, rb_body, rb_blen);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var rb_text = _b_s("Ownership gives each value one owner; borrowing lends access without moving it, and lifetimes say for how long.");
    var rb_prov = _b_s("ollama");
    b = bench_new("chat_body_arena");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        req_arena_begin();
        _chat_completion_body_a(ra, b_llama3, rb_text, 42, 17, 0, 0, rb_prov, FIN_STOP);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var rb_msgs = _b_s("[{\"role\":\"system\",\"content\":\"Be brief.\"},{\"role\":\"user\",\"content\":\"Explain how ownership and borrowing interact with lifetimes.\"}]");
    var rb_mlen = strlen(rb_msgs);
    b = bench_new("provider_body_arena");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        req_arena_begin();
        var rb_g = genopts_new_a(ra, 0, 256, 700, GEN_UNSET);
        _build_chat_body_raw_x(ra, b_llama3, rb_msgs, rb_mlen, 0, 0, rb_g, 1, 0, 0);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    # 2.10.3: one streamed token, from the thread's reused chunk buffer (provider_err.cyr), to /dev/null: the build
    # and the three writes of the SSE framing.
    var dn = sys_open(_b_s("/dev/null"), 1, 0);
    var rb_tok = _b_s(" borrowing");
    chat_id_new();
    b = bench_new("sse_chunk_send");
    bench_batch_start(b);
    i = 0;
    while (i < 100000) {
        sse_content_send(dn, b_llama3, rb_tok, 10);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    sys_close(dn);

    # 2.11.0: in-process ternary inference (tentib_local.cyr). The models are trained here through tentib (outside the
    # timing): byte models of the sentences below, C = 16, F = 32, T = 25 and 26. A reply decodes greedily; since
    # 2.11.1 (tentib 1.4.0) each token is one cached decode step until the window slides (reply_8tok: windows 3..10;
    # reply_22tok: 3..24, the longest that does not slide). tentib_load alternates the two files of different T, so
    # each reads, checks and deserializes a 40 KB file and allocates a model (it runs 20 times); a reload of the file
    # serving reads it and compares its SHA-256; load_same_shape alternates two files of one shape, which tentib
    # loads into the same buffers, allocating nothing.
    var tb_alt = _b_s("a second model to alternate");
    var tb_aT = strlen(tb_alt) - 1;
    var tb_atok = t_alloc(tb_aT); var tb_atgt = t_alloc(tb_aT);
    var tba = 0;
    while (tba < tb_aT) {
        store64(tb_atok + tba * 8, load8(tb_alt + tba)); store64(tb_atgt + tba * 8, load8(tb_alt + tba + 1));
        tba = tba + 1;
    }
    var tb_ast = t_alloc(2);
    tx_train(tb_atok, tb_atgt, 256, tb_aT, 16, 32, 20, 2, tb_ast);
    tx_int_init(256, tb_aT, 16, 32); tx_pack_init(256, tb_aT, 16, 32); tx_pack(256, tb_aT, 16, 32);
    var tb_an = tx_pack_serial_bytes();
    var tb_abuf = alloc(tb_an);
    tx_pack_serialize(tb_abuf, tb_an);
    var tb_apath = _b_s("/tmp/hoosh-bcyr-tentib-alt.tpk");
    file_write_all(tb_apath, tb_abuf, tb_an);
    var tb_text = _b_s("the gateway serves ternary");
    var tb_T = strlen(tb_text) - 1;
    var tb_tok = t_alloc(tb_T); var tb_tgt = t_alloc(tb_T);
    var tbi = 0;
    while (tbi < tb_T) {
        store64(tb_tok + tbi * 8, load8(tb_text + tbi)); store64(tb_tgt + tbi * 8, load8(tb_text + tbi + 1));
        tbi = tbi + 1;
    }
    var tb_st = t_alloc(2);
    tx_train(tb_tok, tb_tgt, 256, tb_T, 16, 32, 300, 1, tb_st);
    tx_int_init(256, tb_T, 16, 32); tx_pack_init(256, tb_T, 16, 32); tx_pack(256, tb_T, 16, 32);
    var tb_n = tx_pack_serial_bytes();
    var tb_buf = alloc(tb_n);
    tx_pack_serialize(tb_buf, tb_n);
    var tb_path = _b_s("/tmp/hoosh-bcyr-tentib.tpk");
    file_write_all(tb_path, tb_buf, tb_n);
    var tb_same = _b_s("a ternary model, declared!");          # T = 25, the main model's shape (2.11.1)
    var tb_stok = t_alloc(tb_T); var tb_stgt = t_alloc(tb_T);
    tbi = 0;
    while (tbi < tb_T) {
        store64(tb_stok + tbi * 8, load8(tb_same + tbi)); store64(tb_stgt + tbi * 8, load8(tb_same + tbi + 1));
        tbi = tbi + 1;
    }
    tx_train(tb_stok, tb_stgt, 256, tb_T, 16, 32, 20, 3, tb_st);
    tx_int_init(256, tb_T, 16, 32); tx_pack_init(256, tb_T, 16, 32); tx_pack(256, tb_T, 16, 32);
    tx_pack_serialize(tb_buf, tb_n);
    var tb_spath = _b_s("/tmp/hoosh-bcyr-tentib-same.tpk");
    file_write_all(tb_spath, tb_buf, tb_n);
    tnt_load(tb_path);
    var tb_route = route_new(PROV_TENTIB, 1, tb_path);
    var tb_msgs = _b_s("[{\"role\":\"user\",\"content\":\"the\"}]");
    var tb_mlen = strlen(tb_msgs);
    b = bench_new("tentib_reply_8tok");
    bench_batch_start(b);
    i = 0;
    while (i < 2000) {
        req_arena_begin();
        var tb_g = genopts_new_a(ra, 0, 8, GEN_UNSET, GEN_UNSET);
        tnt_forward(tb_route, b_llama3, 0, tb_msgs, tb_mlen, tb_g);
        i = i + 1;
    }
    bench_batch_stop(b, 2000);
    bench_report(b);
    b = bench_new("tentib_reply_22tok");
    bench_batch_start(b);
    i = 0;
    while (i < 2000) {
        req_arena_begin();
        var tb_g22 = genopts_new_a(ra, 0, 22, GEN_UNSET, GEN_UNSET);
        tnt_forward(tb_route, b_llama3, 0, tb_msgs, tb_mlen, tb_g22);
        i = i + 1;
    }
    bench_batch_stop(b, 2000);
    bench_report(b);
    b = bench_new("tentib_load");
    bench_batch_start(b);
    i = 0;
    while (i < 20) {
        if (i % 2 == 0) { tnt_load(tb_apath); } else { tnt_load(tb_path); }
        i = i + 1;
    }
    bench_batch_stop(b, 20);
    bench_report(b);
    b = bench_new("tentib_reload_same");
    bench_batch_start(b);
    i = 0;
    while (i < 2000) {
        tnt_load(tb_path);
        i = i + 1;
    }
    bench_batch_stop(b, 2000);
    bench_report(b);
    b = bench_new("tentib_load_same_shape");
    bench_batch_start(b);
    i = 0;
    while (i < 200) {
        if (i % 2 == 0) { tnt_load(tb_spath); } else { tnt_load(tb_path); }
        i = i + 1;
    }
    bench_batch_stop(b, 200);
    bench_report(b);
    sys_unlink(tb_path); sys_unlink(tb_apath); sys_unlink(tb_spath);

    # ── 2.12.2: speech (svara_local.cyr) ──────────────────────────
    # A plan: shabda's conversion of one sentence and the layout of its reply. A render: that reply's 2.4 s of
    # 24 kHz audio, phoneme by phoneme, crossfaded and written as 16-bit PCM (to /dev/null).
    spk_init();
    var sp_text = _b_s("The quick brown fox jumps over the lazy dog, and then it runs home.");
    var sp_st = spk_state_new();
    var sp_ps = alloc(8);
    var sp_dn = sys_open("/dev/null", 1, 0);
    spk_plan_a(req_arena_begin(), sp_text, SPK_VOICE_MALE, F64_ONE, sp_ps);
    spk_render_with(sp_st, load64(sp_ps), sp_dn);      # warm the state's buffers
    b = bench_new("speech_plan_sentence");
    bench_batch_start(b);
    i = 0;
    while (i < 200) {
        spk_plan_a(req_arena_begin(), sp_text, SPK_VOICE_MALE, F64_ONE, sp_ps);
        i = i + 1;
    }
    bench_batch_stop(b, 200);
    bench_report(b);
    spk_plan_a(req_arena_begin(), sp_text, SPK_VOICE_MALE, F64_ONE, sp_ps);
    b = bench_new("speech_render_sentence");
    bench_batch_start(b);
    i = 0;
    while (i < 20) {
        spk_render_with(sp_st, load64(sp_ps), sp_dn);
        i = i + 1;
    }
    bench_batch_stop(b, 20);
    bench_report(b);
    sys_close(sp_dn);

    println("");
    println("done");
    return 0;
}

var r = main();
sys_exit(r);
