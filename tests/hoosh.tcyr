    test_group("json_get_missing");

    assert_eq(bayan_json_get_by_cstr(j_pairs, "nonexistent"), 0, "json: missing key returns 0");

    # ================================================================
    # SEMANTIC CACHE — cosine + embedding store + float parsing
    # ================================================================

    # Vectors use realistic magnitudes (real ×10000 embeddings have large
    # norms, so integer-sqrt floor error is negligible; tiny vectors aren't).
    test_group("cosine_similarity");
    # Identical → 1.0 (×1000).
    assert_eq(cosine_x1000(_vec2(3000, 4000), _vec2(3000, 4000), 2), 1000,
      "cosine: identical = 1000");
    # Orthogonal → 0.
    assert_eq(cosine_x1000(_vec2(1000, 0), _vec2(0, 1000), 2), 0,
      "cosine: orthogonal = 0");
    # Opposite → -1.0 (×1000).
    assert_eq(cosine_x1000(_vec2(1000, 0), _vec2(0 - 1000, 0), 2), 0 - 1000,
      "cosine: opposite = -1000");
    # Collinear (same direction, different magnitude) → 1.0.
    assert_eq(cosine_x1000(_vec2(2000, 4000), _vec2(1000, 2000), 2), 1000,
      "cosine: collinear = 1000");
    # Zero vector → 0.
    assert_eq(cosine_x1000(_vec2(0, 0), _vec2(1000, 1000), 2), 0,
      "cosine: zero vector = 0");
    # Integer sqrt.
    assert_eq(_isqrt(25), 5, "isqrt: 25 = 5");
    assert_eq(_isqrt(26), 5, "isqrt: 26 = 5 (floor)");
    assert_eq(_isqrt(0), 0, "isqrt: 0 = 0");
    assert_eq(_isqrt(144), 12, "isqrt: 144 = 12");

    test_group("semantic_store");
    # 2.9.4: semantic.cyr's own store. It ships disabled (the copy defaulted to enabled), so turn it on as
    # [cache] semantic does: threshold 0.85, no model scope, unlimited search.
    semantic_configure(1, 850, 0, 0);
    semantic_insert("key-cat", _vec2(10000, 0), 2);
    semantic_insert("key-dog", _vec2(0, 10000), 2);
    # Query [9000,1000] ≈ 6° from key-cat (cosine ≈ 0.99 > 0.85) → key-cat.
    assert_eq(streq(semantic_find(_vec2(9000, 1000), 2), "key-cat"), 1,
      "semantic: nearest neighbour returned");
    # Query [7071,7071] ≈ 45° from both (cosine ≈ 0.707 < 0.85) → no match.
    assert_eq(semantic_find(_vec2(7071, 7071), 2), 0,
      "semantic: below threshold = no match");
    # Dimension mismatch is skipped (no crash, no match for a 3-vec query).
    var q3 = alloc(24);
    store64(q3, 10000);
    store64(q3 + 8, 0);
    store64(q3 + 16, 0);
    assert_eq(semantic_find(q3, 3), 0, "semantic: dimension mismatch skipped");

    test_group("semantic_model_scope");
    # 2.9.4: semantic.cyr's per-model store, untested until now. An entry only answers a query for the SAME model:
    # two request bodies differing only in "model" embed almost identically, and before the scope a
    # claude-opus-4-1 request was served the gpt-4o-mini answer, labelled X-Hoosh-Cache: SEMANTIC.
    # (8000, 6000) scores 0.80 against key-cat and 0.60 against key-dog, both under 0.85, so only ans-mini can
    # answer a query along it: an unscoped query that returns anything there has crossed the scope.
    semantic_insert_model("ans-mini", _vec2(8000, 6000), 2, "gpt-4o-mini");
    var opus = alloc(32);
    memcpy(opus, "claude-opus-4-1", 16);
    assert_eq(semantic_find_model(_vec2(8000, 6000), 2, opus), 0,
      "semantic: another model's entry never answers");
    var mini = alloc(16);
    memcpy(mini, "gpt-4o-mini", 12);
    assert_streq(semantic_find_model(_vec2(8000, 6000), 2, mini), "ans-mini",
      "semantic: the same model, compared by text, does");
    assert_eq(semantic_find_model(_vec2(0, 10000), 2, 0) != 0, 1,
      "semantic: an unscoped query still finds unscoped entries (key-dog)");
    assert_eq(semantic_find_model(_vec2(8000, 6000), 2, 0), 0,
      "semantic: an unscoped query never returns a model-scoped entry");
    # max_search bounds the scan: with 1, only the first stored entry (key-cat) is considered.
    semantic_configure(1, 850, 0, 1);
    assert_eq(semantic_find(_vec2(0, 10000), 2), 0, "semantic: max_search=1 stops before key-dog");
    semantic_configure(0, 850, 0, 0);
    assert_eq(semantic_find(_vec2(9000, 1000), 2), 0, "semantic: disabled finds nothing");
    assert_eq(semantic_is_enabled(), 0, "semantic: disabled reports 0");
    semantic_configure(1, 850, 0, 0);

    test_group("embedding_parse");
    # Parse an OpenAI-style embeddings response → ×10000 int vector.
    var emb_json = "{\"data\":[{\"embedding\":[0.5,-0.25,1.0,0],\"index\":0}]}";
    var emb_n = alloc(8);
    var emb_buf = alloc(strlen(emb_json) + 1);
    memcpy(emb_buf, emb_json, strlen(emb_json));
    var emb_vec = semantic_parse_embedding(emb_buf, strlen(emb_json), emb_n);
    assert_eq(load64(emb_n), 4, "embedding: parsed 4 dims");
    assert_eq(load64(emb_vec), 5000, "embedding: 0.5 → 5000");
    assert_eq(load64(emb_vec + 8), 0 - 2500, "embedding: -0.25 → -2500");
    assert_eq(load64(emb_vec + 16), 10000, "embedding: 1.0 → 10000");
    assert_eq(load64(emb_vec + 24), 0, "embedding: 0 → 0");
    # Scientific notation is handled.
    var emb_sci = "{\"embedding\":[1.5e-2,-2e1]}";
    var sci_n = alloc(8);
    var sci_buf = alloc(strlen(emb_sci) + 1);
    memcpy(sci_buf, emb_sci, strlen(emb_sci));
    var sci_vec = semantic_parse_embedding(sci_buf, strlen(emb_sci), sci_n);
    assert_eq(load64(sci_n), 2, "embedding: 2 dims (scientific)");
    assert_eq(load64(sci_vec), 150, "embedding: 1.5e-2 → 0.015 → 150");
    assert_eq(load64(sci_vec + 8), 0 - 200000, "embedding: -2e1 → -20 → -200000");
    # 2.9.4: semantic.cyr's own parser. A bare NaN (Python's json.dumps emits one by default) is not an embedding,
    # and the parse stops with 0 dims. The copy this replaced spun on the same byte, allocating, until the heap ran out.
    var emb_nan = "{\"embedding\":[0.5,NaN,1.0]}";
    var nan_n = alloc(8);
    var nan_buf = alloc(strlen(emb_nan) + 1);
    memcpy(nan_buf, emb_nan, strlen(emb_nan));
    semantic_parse_embedding(nan_buf, strlen(emb_nan), nan_n);
    assert_eq(load64(nan_n), 0, "embedding: a NaN component abandons the parse");
    # An absurd exponent is clamped to 40 decades. The copy applied it one decade per loop, ~9e15 iterations.
    var emb_exp = "{\"embedding\":[1e9223372036854775]}";
    var exp_n = alloc(8);
    var exp_buf = alloc(strlen(emb_exp) + 1);
    memcpy(exp_buf, emb_exp, strlen(emb_exp));
    semantic_parse_embedding(exp_buf, strlen(emb_exp), exp_n);
    assert_eq(load64(exp_n), 1, "embedding: a huge exponent is clamped and the parse completes");

    # ================================================================
    # MIDDLEWARE AUTH — constant-time token comparison
    # ================================================================

    test_group("auth_token_verify");

    # Constant-time comparison using ct_eq from sigil
    var auth_tok1 = "bearer-secret-token-12345";
    var auth_tok2 = "bearer-secret-token-12345";
    var auth_tok3 = "bearer-wrong-token-99999";
    assert(ct_eq_bytes_lens(auth_tok1, strlen(auth_tok1), auth_tok2, strlen(auth_tok2)) == 1, "auth: matching tokens");
    assert(ct_eq_bytes_lens(auth_tok1, strlen(auth_tok1), auth_tok3, strlen(auth_tok3)) == 0, "auth: wrong token rejected");

    test_group("auth_empty_token");

    var auth_empty = "";
    assert(ct_eq_bytes_lens(auth_tok1, strlen(auth_tok1), auth_empty, strlen(auth_empty)) == 0, "auth: empty token rejected");

    test_group("auth_length_mismatch");

    var auth_short = "bearer";
    assert(ct_eq_bytes_lens(auth_tok1, strlen(auth_tok1), auth_short, strlen(auth_short)) == 0, "auth: length mismatch rejected");

    # ── Logging level mapping (sakshi) ────────────────────────────
    test_group("logging_levels");
    assert(hlog_level_from_str("fatal") == SK_FATAL, "log level: fatal");
    assert(hlog_level_from_str("error") == SK_ERROR, "log level: error");
    assert(hlog_level_from_str("warn") == SK_WARN, "log level: warn");
    assert(hlog_level_from_str("info") == SK_INFO, "log level: info");
    assert(hlog_level_from_str("debug") == SK_DEBUG, "log level: debug");
    assert(hlog_level_from_str("trace") == SK_TRACE, "log level: trace");
    assert(hlog_level_from_str("bogus") == 0 - 1, "log level: unknown rejected");
    sakshi_set_level(SK_WARN);
    assert(sakshi_get_level() == SK_WARN, "log level: set/get round-trip");
    sakshi_set_level(SK_INFO);

    # ── Hardware data files (ai-hwaccel cost/model endpoints) ──────
    # load_models scans for top-level `{...}` objects, so models.json
    # MUST be a top-level JSON array — the `{"models":[...]}` wrapper
    # only yields the first model. Guard that shape + presence.
    test_group("hardware_data_files");
    var mbuf = alloc(40000);
    var mn = file_read_all("data/models.json", mbuf, 40000);
    assert(mn > 0, "data/models.json present and non-empty");
    var mi = 0;
    while (mi < mn) {
        var wc = load8(mbuf + mi);
        if (wc != 32 && wc != 9 && wc != 10 && wc != 13) { break; }
        mi = mi + 1;
    }
    assert(load8(mbuf + mi) == 91, "models.json is a top-level JSON array");
    var cbuf = alloc(40000);
    var cn = file_read_all("data/cloud_pricing.json", cbuf, 40000);
    assert(cn > 0, "data/cloud_pricing.json present and non-empty");

    # ── Remote transport (https:// forward path) ──────────────────
    test_group("remote_transport");
    var rt_local = route_new(PROV_OLLAMA, 1, "http://localhost:11434");
    var rt_remote = route_new(PROV_OPENAI, 1, "https://api.openai.com");
    assert_eq(route_is_remote(rt_local), 0, "http://localhost is not remote");
    assert_eq(route_is_remote(rt_remote), 1, "https://api.openai.com is remote");
    assert_eq(route_is_remote(route_new(PROV_OPENAI, 1, 0)), 0, "a route without a base URL is not remote");
    assert_streq(_provider_path(rt_local), "/api/chat",
      "ollama path = /api/chat");
    assert_streq(_provider_path(rt_remote), "/v1/chat/completions",
      "non-ollama path = /v1/chat/completions");
    assert_streq(_provider_url("https://api.openai.com", "/v1/chat/completions"),
      "https://api.openai.com/v1/chat/completions", "url join base+path");
    assert_streq(_bearer_value("sk-test123"), "Bearer sk-test123",
      "bearer header value");

    # OpenAI usage-object token extraction
    var usage = "{\"usage\":{\"prompt_tokens\":42,\"completion_tokens\":17,\"total_tokens\":59}}";
    var ulen = strlen(usage);
    var ubuf = alloc(ulen + 1);
    memcpy(ubuf, usage, ulen);
    var utok = extract_openai_tokens(ubuf, ulen);
    assert_eq(utok / 0x100000000, 42, "openai prompt_tokens extracted");
    assert_eq(utok % 0x100000000, 17, "openai completion_tokens extracted");
    var u_empty = extract_openai_tokens(ubuf, 5);
    assert_eq(u_empty, 0, "openai tokens: too-short body returns 0");

    # Anthropic routing + response shaping
    var rt_anthropic = route_new(PROV_ANTHROPIC, 1, "https://api.anthropic.com");
    assert_eq(route_is_remote(rt_anthropic), 1, "anthropic is remote");
    assert_streq(_provider_path(rt_anthropic), "/v1/messages",
      "anthropic path = /v1/messages");

    var amsg = "{\"id\":\"msg_1\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Hi there\"}],\"usage\":{\"input_tokens\":11,\"output_tokens\":4}}";
    var alen = strlen(amsg);
    var abuf = alloc(alen + 1);
    memcpy(abuf, amsg, alen);
    var atext = anthropic_extract_text(abuf, alen);
    assert_streq(atext, "Hi there", "anthropic content[].text extracted");
    var atok = extract_anthropic_tokens(abuf, alen);
    assert_eq(atok / 0x100000000, 11, "anthropic input_tokens extracted");
    assert_eq(atok % 0x100000000, 4, "anthropic output_tokens extracted");

    # Anthropic system-message hoist: role:"system" turns lift to top-level
    # "system"; the rest pass through unchanged.
    var hm1 = "[{\"role\":\"system\",\"content\":\"Be brief\"},{\"role\":\"user\",\"content\":\"hi\"}]";
    var hb1 = _build_anthropic_body("claude", hm1, strlen(hm1), 0, 0, 0, 0);
    assert_streq(hb1,
      "{\"model\":\"claude\",\"max_tokens\":4096,\"system\":\"Be brief\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}",
      "anthropic hoist: system lifted, user kept");

    # No system turn → no "system" field, messages pass straight through.
    var hm2 = "[{\"role\":\"user\",\"content\":\"hi\"}]";
    var hb2 = _build_anthropic_body("claude", hm2, strlen(hm2), 0, 0, 0, 0);
    assert_streq(hb2,
      "{\"model\":\"claude\",\"max_tokens\":4096,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}",
      "anthropic hoist: no system, passthrough");

    # Multiple system turns join with \n in declaration order.
    var hm3 = "[{\"role\":\"system\",\"content\":\"A\"},{\"role\":\"system\",\"content\":\"B\"},{\"role\":\"user\",\"content\":\"hi\"}]";
    var hb3 = _build_anthropic_body("claude", hm3, strlen(hm3), 0, 0, 0, 0);
    assert_streq(hb3,
      "{\"model\":\"claude\",\"max_tokens\":4096,\"system\":\"A\\nB\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}",
      "anthropic hoist: two system turns joined with newline");

    # Tool-continuation translation (regression guard for the 2.4.12 fix): an
    # OpenAI assistant `tool_calls` message + a `role:"tool"` result become
    # Anthropic `tool_use` / `tool_result` content blocks — the `arguments` STRING
    # is unescaped into the `input` OBJECT, `content:null` drops, and the plain
    # user turn passes through. Before 2.4.12 these were emitted verbatim, which
    # Anthropic rejects (400) — surfaced as a misclassified 502.
    var tm1 = "[{\"role\":\"user\",\"content\":\"read probe.txt\"},{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"fs_read\",\"arguments\":\"{\\\"path\\\":\\\"probe.txt\\\"}\"}}]},{\"role\":\"tool\",\"tool_call_id\":\"call_1\",\"content\":\"hello\"}]";
    var tb1 = _build_anthropic_body("claude", tm1, strlen(tm1), 0, 0, 0, 0);
    assert_streq(tb1,
      "{\"model\":\"claude\",\"max_tokens\":4096,\"messages\":[{\"role\":\"user\",\"content\":\"read probe.txt\"},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"call_1\",\"name\":\"fs_read\",\"input\":{\"path\":\"probe.txt\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"call_1\",\"content\":\"hello\"}]}]}",
      "anthropic tool-continuation: tool_calls->tool_use (args unescaped), role:tool->tool_result");

    # Assistant text preamble + tool_call: the non-empty `content` becomes a text
    # block before the tool_use; an empty-object `arguments` stays {}.
    var tm2 = "[{\"role\":\"assistant\",\"content\":\"Let me check\",\"tool_calls\":[{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"ping\",\"arguments\":\"{}\"}}]}]";
    var tb2 = _build_anthropic_body("claude", tm2, strlen(tm2), 0, 0, 0, 0);
    assert_streq(tb2,
      "{\"model\":\"claude\",\"max_tokens\":4096,\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Let me check\"},{\"type\":\"tool_use\",\"id\":\"c2\",\"name\":\"ping\",\"input\":{}}]}]}",
      "anthropic tool-continuation: assistant text preamble + tool_use, empty args -> {}");

    # Gemini shaping: OpenAI messages -> contents (assistant->model), system ->
    # systemInstruction; URL carries model + key query param.
    var gm1 = "[{\"role\":\"system\",\"content\":\"Be brief\"},{\"role\":\"user\",\"content\":\"hi\"},{\"role\":\"assistant\",\"content\":\"yo\"}]";
    var gb1 = _build_gemini_body(gm1, strlen(gm1), 0, 0);
    assert_streq(gb1,
      "{\"systemInstruction\":{\"parts\":[{\"text\":\"Be brief\"}]},\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"hi\"}]},{\"role\":\"model\",\"parts\":[{\"text\":\"yo\"}]}]}",
      "gemini shaping: system->systemInstruction, assistant->model");

    var gm2 = "[{\"role\":\"user\",\"content\":\"hi\"}]";
    var gb2 = _build_gemini_body(gm2, strlen(gm2), 0, 0);
    assert_streq(gb2,
      "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"hi\"}]}]}",
      "gemini shaping: no system, single user turn");

    assert_streq(
      _gemini_url("https://generativelanguage.googleapis.com", "gemini-2.0-flash", "k123"),
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=k123",
      "gemini url: model-scoped generateContent + key query param");

    var gresp = "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"Hello\"}],\"role\":\"model\"}}],\"usageMetadata\":{\"promptTokenCount\":7,\"candidatesTokenCount\":3,\"totalTokenCount\":10}}";
    var glen = strlen(gresp);
    var gbuf = alloc(glen + 1);
    memcpy(gbuf, gresp, glen);
    assert_streq(gemini_extract_text(gbuf, glen), "Hello", "gemini text extracted");
    var gtok = extract_gemini_tokens(gbuf, glen);
    assert_eq(gtok / 0x100000000, 7, "gemini promptTokenCount extracted");
    assert_eq(gtok % 0x100000000, 3, "gemini candidatesTokenCount extracted");

    # Incremental streaming: request shaping for the SSE path.
    var sm1 = "[{\"role\":\"system\",\"content\":\"Be brief\"},{\"role\":\"user\",\"content\":\"hi\"}]";
    var sb1 = _build_anthropic_body_x("claude", sm1, strlen(sm1), 1, 0, 0, 0, 0);
    assert_streq(sb1,
      "{\"model\":\"claude\",\"max_tokens\":4096,\"stream\":true,\"system\":\"Be brief\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}",
      "anthropic stream body: stream:true flag set");

    assert_streq(
      _gemini_url_stream("https://generativelanguage.googleapis.com", "gemini-2.0-flash", "k123"),
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:streamGenerateContent?alt=sse&key=k123",
      "gemini stream url: streamGenerateContent + alt=sse + key");

    # SSE delta extraction reuses the per-provider extractors on event data.
    var oai_delta = "{\"choices\":[{\"delta\":{\"content\":\"Hi\"}}]}";
    var od_len = strlen(oai_delta);
    var od_buf = alloc(od_len + 1);
    memcpy(od_buf, oai_delta, od_len);
    assert_streq(ollama_extract_text(od_buf, od_len), "Hi",
      "openai SSE delta: content extracted");

    var ant_delta = "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Hi\"}}";
    var ad_len = strlen(ant_delta);
    var ad_buf = alloc(ad_len + 1);
    memcpy(ad_buf, ant_delta, ad_len);
    assert_streq(anthropic_extract_text(ad_buf, ad_len), "Hi",
      "anthropic SSE delta: text_delta extracted (type:text_delta not matched)");

    # Pretty-printed JSON (OpenAI + Gemini REST responses indent and put a
    # space after the colon: `"content": "ok"`). The old compact-only needles
    # (`"content":"`) missed these, so non-streaming OpenAI/Gemini silently
    # returned empty text + 0 tokens. Extractors must tolerate whitespace
    # around the colon. Regression guard for the 2.2.0 live-verification bug.
    var pp_oai = "{\n  \"choices\": [\n    {\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"ok\"\n      }\n    }\n  ],\n  \"usage\": {\n    \"prompt_tokens\": 14,\n    \"completion_tokens\": 1\n  }\n}";
    var ppo_len = strlen(pp_oai);
    var ppo_buf = alloc(ppo_len + 1);
    memcpy(ppo_buf, pp_oai, ppo_len);
    assert_streq(ollama_extract_text(ppo_buf, ppo_len), "ok",
      "openai pretty-printed: content extracted past whitespace");
    var ppo_tok = extract_openai_tokens(ppo_buf, ppo_len);
    assert_eq(ppo_tok / 0x100000000, 14, "openai pretty-printed: prompt_tokens");
    assert_eq(ppo_tok % 0x100000000, 1, "openai pretty-printed: completion_tokens");

    # Anthropic content[].text where "text" also appears as a *value*
    # ("type":"text") before the real key — the key-vs-value check must skip
    # the value occurrence and extract from the real "text": field.
    var pp_ant = "{\n  \"content\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"hi\"\n    }\n  ],\n  \"usage\": { \"input_tokens\": 5, \"output_tokens\": 2 }\n}";
    var ppa_len = strlen(pp_ant);
    var ppa_buf = alloc(ppa_len + 1);
    memcpy(ppa_buf, pp_ant, ppa_len);
    assert_streq(anthropic_extract_text(ppa_buf, ppa_len), "hi",
      "anthropic pretty-printed: text key extracted, type:text value skipped");
    var ppa_tok = extract_anthropic_tokens(ppa_buf, ppa_len);
    assert_eq(ppa_tok / 0x100000000, 5, "anthropic pretty-printed: input_tokens");
    assert_eq(ppa_tok % 0x100000000, 2, "anthropic pretty-printed: output_tokens");

    # Gemini pretty-printed candidates/usageMetadata (real shape from the live
    # gemini-2.5-flash response that exposed the bug).
    var pp_gem = "{\n  \"candidates\": [\n    {\n      \"content\": {\n        \"parts\": [ { \"text\": \"yo\" } ],\n        \"role\": \"model\"\n      }\n    }\n  ],\n  \"usageMetadata\": {\n    \"promptTokenCount\": 2,\n    \"candidatesTokenCount\": 9\n  }\n}";
    var ppg_len = strlen(pp_gem);
    var ppg_buf = alloc(ppg_len + 1);
    memcpy(ppg_buf, pp_gem, ppg_len);
    assert_streq(gemini_extract_text(ppg_buf, ppg_len), "yo",
      "gemini pretty-printed: parts[].text extracted");
    var ppg_tok = extract_gemini_tokens(ppg_buf, ppg_len);
    assert_eq(ppg_tok / 0x100000000, 2, "gemini pretty-printed: promptTokenCount");
    assert_eq(ppg_tok % 0x100000000, 9, "gemini pretty-printed: candidatesTokenCount");

    # ── Per-provider token estimation (compact.cyr) ───────────────
    # Ratio table (x10) mirrors ProviderTokenCounter::for_provider.
    assert_eq(chars_per_token_x10(PROV_OPENAI), 38, "openai ratio 3.8");
    assert_eq(chars_per_token_x10(PROV_ANTHROPIC), 35, "anthropic ratio 3.5");
    assert_eq(chars_per_token_x10(PROV_OLLAMA), 37, "ollama ratio 3.7");
    assert_eq(chars_per_token_x10(PROV_DEEPSEEK), 38, "deepseek tracks openai");
    assert_eq(chars_per_token_x10(PROV_SYNAPSE), 40, "synapse conservative 4.0");
    assert_eq(chars_per_token_x10(PROV_GOOGLE), 40, "google default 4.0");
    # estimate_tokens: 100 chars at each ratio (floor division).
    assert_eq(estimate_tokens(0, 100, chars_per_token_x10(PROV_OPENAI)), 26,
      "100 chars / 3.8 = 26 tokens (openai)");
    assert_eq(estimate_tokens(0, 100, chars_per_token_x10(PROV_ANTHROPIC)), 28,
      "100 chars / 3.5 = 28 tokens (anthropic, denser)");
    assert_eq(estimate_tokens(0, 100, chars_per_token_x10(PROV_OLLAMA)), 27,
      "100 chars / 3.7 = 27 tokens (local)");
    assert_eq(estimate_tokens(0, 100, chars_per_token_x10(PROV_SYNAPSE)), 25,
      "100 chars / 4.0 = 25 tokens (default)");
    # Provider-aware estimate: denser tokenizer yields a higher count for the
    # same text, so anthropic > openai > default for equal input.
    var ant_est = estimate_tokens(0, 1000, chars_per_token_x10(PROV_ANTHROPIC));
    var oai_est = estimate_tokens(0, 1000, chars_per_token_x10(PROV_OPENAI));
    var def_est = estimate_tokens(0, 1000, chars_per_token_x10(PROV_SYNAPSE));
    assert_eq(ant_est > oai_est, 1, "anthropic estimates higher than openai");
    assert_eq(oai_est > def_est, 1, "openai estimates higher than default");
    # Zero/invalid ratio falls back to the 4.0 default.
    assert_eq(estimate_tokens(0, 100, 0), 25, "zero ratio falls back to 4.0");

    # ── Provider lifecycle: route lookup by provider ──────────────
    # 2.9.21: router.cyr's own router_find_provider. handlers.cyr's _router_find_provider read main.cyr's _router, so
    # the tests ran a copy over a bare array, which skipped router_new's priority sort.
    var lc_r1 = route_new(PROV_OPENAI, 1, "https://api.openai.com");
    var lc_r2 = route_new(PROV_OLLAMA, 2, "http://localhost:11434");
    var lc_r3 = route_new(PROV_SYNAPSE, 3, "http://localhost:5000");
    var lc_r4 = route_new(PROV_OLLAMA, 4, "http://backup:11434");
    var lc_routes = alloc(32);
    store64(lc_routes, lc_r4);   # listed first, but priority 4: router_new sorts it last
    store64(lc_routes + 8, lc_r1);
    store64(lc_routes + 16, lc_r2);
    store64(lc_routes + 24, lc_r3);
    var lc_rt = router_new(lc_routes, 4, STRAT_PRIORITY);
    assert_eq(router_find_provider(lc_rt, PROV_OLLAMA), lc_r2,
      "lifecycle: finds the higher-priority ollama route for pull/delete");
    assert_eq(router_find_provider(lc_rt, PROV_SYNAPSE), lc_r3,
      "lifecycle: finds synapse route for training/sync");
    assert_eq(router_find_provider(lc_rt, PROV_OPENAI), lc_r1, "lifecycle: the top route itself is found");
    assert_eq(router_find_provider(lc_rt, PROV_ANTHROPIC), 0,
      "lifecycle: missing provider returns 0 (404)");
    # Disabled routes are skipped.
    route_set_enabled(lc_r2, 0);
    assert_eq(router_find_provider(lc_rt, PROV_OLLAMA), lc_r4,
      "lifecycle: a disabled ollama route is skipped for the next one");
    route_set_enabled(lc_r4, 0);
    assert_eq(router_find_provider(lc_rt, PROV_OLLAMA), 0,
      "lifecycle: no enabled ollama route returns 0");
    assert_eq(router_find_provider(router_new(alloc(8), 0, STRAT_PRIORITY), PROV_OLLAMA), 0,
      "lifecycle: an empty router returns 0");

    # ── http_client: generic method header (GET/POST/DELETE) ──────
    var hdr_buf = alloc(2048);
    var hdr_len = _build_req_header(hdr_buf, "DELETE", "/api/delete",
      "localhost", 19, 2048);
    assert_eq(memeq(hdr_buf, "DELETE /api/delete HTTP/1.0", 27), 1,
      "req header: DELETE method + path line");
    assert_eq(memeq(hdr_buf + hdr_len - 4, "\r\n\r\n", 4), 1,
      "req header: terminates with blank line");
    var ghdr = alloc(2048);
    _build_req_header(ghdr, "GET", "/v1/training/job-1", "localhost", 0, 2048);
    assert_eq(memeq(ghdr, "GET /v1/training/job-1 HTTP/1.0", 31), 1,
      "req header: GET method + path line");
    # 2.6.6: the literal is 30 bytes; both builders copied 29 and then wrote CR
    # over the trailing `n`, so every plaintext provider request advertised
    # `application/jso`. vLLM / llama-cpp-python / LocalAI / LM Studio all 422
    # on that.
    assert_eq(str_contains(str_from_buf(ghdr, strlen(ghdr)),
        str_from("Content-Type: application/json\r\n")), 1,
      "req header: full Content-Type media type, not truncated");
    # 2.6.6: a path that cannot fit the caller's buffer is refused rather than
    # written past it — job_id reaches this from a client request body.
    var toolong = alloc(4096);
    var tl_i = 0;
    while (tl_i < 4000) { store8(toolong + tl_i, 97); tl_i = tl_i + 1; }
    store8(toolong + 4000, 0);
    var obuf = alloc(2048);
    assert_eq(_build_req_header(obuf, "GET", toolong, "localhost", 0, 2048), 0 - 1,
      "req header: over-capacity path is refused, not overflowed");

    # ── 2.9.8: http_client.cyr for real — headers, loopback round trips ──
    test_group("http_client");
    # The traceparent header carries THIS thread's trace id (the one the request came in with), not a fresh
    # one per call. The copy this replaced never wrote the header, so dropping it could not fail a test.
    var hc_tp = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
    trace_set(hc_tp);
    var hc_tail = _t_cat("traceparent: ", hc_tp);
    var hc_buf = alloc(2048);
    var hc_len = _build_req_header(hc_buf, "DELETE", "/api/delete", "localhost", 19, 2048);
    assert_eq(_t_has(hc_buf, hc_len, "\r\nContent-Length: 19\r\n"), 1, "req header: Content-Length is the body length");
    assert_eq(_t_has(hc_buf, hc_len, "\r\nHost: localhost\r\n"), 1, "req header: Host line");
    assert_eq(memeq(hc_buf + hc_len - strlen(hc_tail) - 4, hc_tail, strlen(hc_tail)), 1,
      "req header: traceparent is the thread's current trace id, last before the blank line");
    var hc_pbuf = alloc(2048);
    var hc_plen = _build_post_header(hc_pbuf, "/api/chat", "127.0.0.1", 42, 2048);
    assert_eq(memeq(hc_pbuf, "POST /api/chat HTTP/1.0\r\nHost: 127.0.0.1\r\n", 42), 1,
      "post header: request line + Host");
    assert_eq(_t_has(hc_pbuf, hc_plen, "\r\nContent-Type: application/json\r\nConnection: close\r\n"), 1,
      "post header: full media type, Connection: close");
    assert_eq(_t_has(hc_pbuf, hc_plen, "\r\nContent-Length: 42\r\n"), 1, "post header: Content-Length");
    assert_eq(memeq(hc_pbuf + hc_plen - strlen(hc_tail) - 4, hc_tail, strlen(hc_tail)), 1,
      "post header: traceparent, then the blank line");
    assert_eq(memeq(hc_pbuf + hc_plen - 4, "\r\n\r\n", 4), 1, "post header: ends with the blank line");
    # The capacity check must count every byte the builder writes, the traceparent included: sweep every cap
    # and require -1 or a header that stayed inside it.
    assert_eq(_t_hdr_overruns(0), 0, "req header: no cap from 0 to 400 lets it write past the buffer");
    assert_eq(_t_hdr_overruns(1), 0, "post header: no cap from 0 to 400 lets it write past the buffer");
    var hc_small = alloc(512);
    assert_eq(_build_req_header(hc_small, "GET", "/p", "h", 7, 400) > 0, 1, "req header: a roomy cap succeeds");
    assert_eq(_build_post_header(hc_small, "/p", "h", 7, 400) > 0, 1, "post header: a roomy cap succeeds");

    # host_addr: network-order IPv4 for sockaddr_in, with no DNS lookup for the local and literal cases.
    assert_eq(host_addr(0), 0x0100007F, "host_addr: no host -> loopback");
    assert_eq(host_addr("localhost"), 0x0100007F, "host_addr: localhost -> 127.0.0.1");
    assert_eq(host_addr("10.1.2.3"), 0x0302010A, "host_addr: a dotted quad is parsed, not resolved");
    assert_eq(host_addr("127.0.0.2"), 0x0200007F, "host_addr: a loopback literal other than .1 keeps its address");

    # stream_skip_headers reads one byte at a time and stops right after the blank line, so the body stays
    # in the fd for the SSE reader.
    var hc_h = "HTTP/1.1 200 OK\r\nX: y\r\n\r\n";
    var hc_resp = _t_cat(hc_h, "data: one\n\n");
    assert_eq(_t_skip_pipe(hc_resp, 512), strlen(hc_h), "skip headers: offset of the body");
    assert_eq(_t_skip_pipe(hc_resp, strlen(hc_h) + 1), strlen(hc_h), "skip headers: a buffer one byte over fits");
    assert_eq(_t_skip_pipe(hc_resp, strlen(hc_h)), 0 - 1, "skip headers: a buffer the header fills is refused");
    assert_eq(_t_skip_pipe("HTTP/1.1 200 OK\r\nX: y\r\n", 512), 0 - 1,
      "skip headers: EOF before the blank line is -1");

    # http_post_stream over loopback, single-threaded: the connection waits in the listen backlog, so the
    # test accepts after the client has written, reads what went on the wire, then answers.
    var hc_port = alloc(8);
    var hc_lfd = _t_listen(hc_port);
    assert_eq(hc_lfd >= 0, 1, "loopback: listener up");
    var hc_base = _t_base_url(load64(hc_port));
    var hc_body = "{\"model\":\"llama3\",\"stream\":true}";
    var hc_sfd = http_post_stream(hc_base, "/api/chat", hc_body, strlen(hc_body));
    assert_eq(hc_sfd >= 0, 1, "post stream: connected, returns the fd");
    var hc_ct, hc_cfd = sock_accept(hc_lfd);
    assert_eq(is_ok(hc_ct), 1, "post stream: server accepted the connection");
    var hc_req = alloc(4096);
    var hc_rlen = _t_read_req(hc_cfd, hc_req, 4096, strlen(hc_body));
    assert_eq(memeq(hc_req, "POST /api/chat HTTP/1.0\r\nHost: 127.0.0.1\r\n", 42), 1,
      "post stream: request line + Host on the wire");
    assert_eq(_t_has(hc_req, hc_rlen, _t_line("\r\nContent-Length: ", strlen(hc_body), "\r\n")), 1,
      "post stream: Content-Length matches the body");
    assert_eq(_t_has(hc_req, hc_rlen, hc_tail), 1, "post stream: traceparent on the wire");
    assert_eq(_t_hdr_end(hc_req, hc_rlen) + strlen(hc_body), hc_rlen, "post stream: the body follows the headers");
    assert_eq(memeq(hc_req + hc_rlen - strlen(hc_body), hc_body, strlen(hc_body)), 1, "post stream: body bytes");
    sys_write(hc_cfd, hc_resp, strlen(hc_resp));
    sys_close(hc_cfd);
    var hc_sbuf = alloc(512);
    assert_eq(stream_skip_headers(hc_sfd, hc_sbuf, 512), strlen(hc_h), "post stream: response headers skipped");
    var hc_n = sys_read(hc_sfd, hc_sbuf, 511);
    assert_eq(hc_n, 11, "post stream: the SSE body is left to read");
    assert_eq(memeq(hc_sbuf, "data: one\n\n", 11), 1, "post stream: SSE body bytes");
    sys_close(hc_sfd);

    # http_req_local blocks until the reply, so a one-shot server thread answers it.
    var hc_r = _t_req_roundtrip(hc_lfd, hc_base, "POST", "/api/chat", hc_body,
      "HTTP/1.0 200 OK\r\nContent-Type: application/json\r\n\r\n{\"ok\":true}");
    assert_eq(hc_r != 0, 1, "req local: POST round trip parsed");
    assert_eq(load64(hc_r), 200, "req local: status 200");
    assert_eq(load64(hc_r + 16), 11, "req local: body length");
    assert_eq(memeq(load64(hc_r + 8), "{\"ok\":true}", 11), 1, "req local: body bytes");
    assert_eq(memeq(_t_srv_req, "POST /api/chat HTTP/1.0\r\n", 25), 1, "req local: POST request line on the wire");
    assert_eq(memeq(_t_srv_req + _t_srv_req_len - strlen(hc_body), hc_body, strlen(hc_body)), 1,
      "req local: body on the wire");
    # 2.10.0: the header and response buffers are this thread's scratch block, allocated once, not 130 KB a request.
    var hc_scr = _local_http_scratch();
    assert_eq(hc_scr != 0 && hc_scr == _local_http_scratch(), 1, "scratch: one block per thread");
    assert_eq(load64(hc_r + 8) >= hc_scr + LH_BUF && load64(hc_r + 8) < hc_scr + LH_BUF + HTTP_RESP_CAP, 1,
      "scratch: the response body is in it");
    _t_srv_prebuf = alloc(4096);
    _t_srv_lfd = hc_lfd;
    _t_srv_reply = "HTTP/1.0 200 OK\r\n\r\n{\"second\":2}";
    _t_srv_body_len = 0;
    var hc_th2 = thread_create(&_t_serve_once_prebuf, 0);
    var hc_u0 = alloc_used();
    var hc_r2 = http_req_local("GET", hc_base, "/again", 0, 0);
    var hc_du = alloc_used() - hc_u0;
    thread_join(hc_th2);
    assert_lt(hc_du, 1024, "scratch: a local request allocates under 1 KiB (it took 130 KB)");
    assert_eq(load64(hc_r2 + 16), 12, "scratch: the second response's length");
    assert_eq(memeq(load64(hc_r2 + 8), "{\"second\":2}", 12), 1, "scratch: the second body, in the reused buffer");
    var hc_oth = thread_create(&_t_other_scratch, 0);
    thread_join(hc_oth);
    assert_eq(_t_other_scr != 0 && _t_other_scr != hc_scr, 1, "scratch: another thread gets its own block");
    # http_post_stream's request head is the scratch block's too. Its own listener: the connection stays queued
    # unaccepted, and the shared one is accepted by the tests that follow.
    var hc_pport = alloc(8);
    var hc_plfd = _t_listen(hc_pport);
    var hc_pu0 = alloc_used();
    var hc_pfd = http_post_stream(_t_base_url(load64(hc_pport)), "/api/chat", "{}", 2);
    var hc_pdu = alloc_used() - hc_pu0;
    sys_close(hc_pfd);
    sys_close(hc_plfd);
    assert_eq(hc_pfd >= 0, 1, "scratch: the stream request was sent");
    assert_lt(hc_pdu, 1024, "scratch: starting a local stream allocates under 1 KiB (its head took 2 KiB)");
    var hc_ss = stream_scratch();
    assert_eq(hc_ss != 0 && hc_ss == stream_scratch(), 1, "scratch: one stream block per thread");
    assert_eq(SS_HDR + 4096 == SS_READ && SS_READ + 4096 == SS_LINE && SS_LINE + 65536 == SS_SIZE, 1,
      "scratch: the stream block's head, read and line regions do not overlap");
    hc_r = _t_req_roundtrip(hc_lfd, hc_base, "GET", "/health", 0, "HTTP/1.0 503 Service Unavailable\r\n\r\n");
    assert_eq(hc_r != 0, 1, "req local: GET round trip parsed");
    assert_eq(load64(hc_r), 503, "req local: upstream status passed through");
    assert_eq(memeq(_t_srv_req, "GET /health HTTP/1.0\r\n", 22), 1, "req local: GET request line");
    assert_eq(_t_has(_t_srv_req, _t_srv_req_len, "\r\nContent-Length: 0\r\n"), 1, "req local: GET sends length 0");
    assert_eq(_t_hdr_end(_t_srv_req, _t_srv_req_len), _t_srv_req_len, "req local: GET sends no body");
    assert_eq(_t_req_roundtrip(hc_lfd, hc_base, "GET", "/health", 0, ""), 0,
      "req local: a backend that closes without answering is 0");
    # A reply that reaches HTTP_RESP_CAP was cut off mid-body, so it is refused rather than parsed. 31 bytes
    # fit under a 32-byte cap; 32 bytes reach it.
    HTTP_RESP_CAP = 32;
    hc_r = _t_req_roundtrip(hc_lfd, hc_base, "GET", "/x", 0, "HTTP/1.0 200 OK\r\n\r\n0123456789ab");
    assert_eq(hc_r != 0, 1, "req local: a reply one byte under the cap is parsed");
    assert_eq(load64(hc_r + 16), 12, "req local: ...with its whole body");
    assert_eq(_t_req_roundtrip(hc_lfd, hc_base, "GET", "/x", 0, "HTTP/1.0 200 OK\r\n\r\n0123456789abc"), 0,
      "req local: a reply that fills the cap is refused as truncated");
    HTTP_RESP_CAP = 131072;
    sys_close(hc_lfd);
    # A port nobody listens on: connect is refused, and both entry points report failure.
    assert_eq(http_req_local("GET", hc_base, "/health", 0, 0), 0, "req local: refused connection is 0");
    assert_eq(http_post_stream(hc_base, "/api/chat", hc_body, strlen(hc_body)), 0 - 1,
      "post stream: refused connection is -1");
    trace_set(0);

    # ── 2.9.8: events.cyr for real — the majra bus and the recent-events ring ──
    test_group("events");
    # Nothing in the suite has called events_init yet: every builder is a no-op and the ring is empty.
    assert_eq(events_total_published(), 0, "events: nothing published before init");
    event_rate_limited("ollama");
    assert_eq(events_total_published(), 0, "events: a builder before init publishes nothing");
    assert_eq(streq(_t_events_recent(), "{\"events\":[]}"), 1, "events: recent is empty before init");
    events_init();
    event_inference_completed("openai", "gpt-4o", 120, 42);
    assert_eq(events_total_published(), 1, "events: one publish counted by the majra bus");
    events_init();
    assert_eq(events_total_published(), 1, "events: a second init keeps the bus and its count");
    var ev_one = _t_cat("{\"events\":[{\"event\":\"inference_completed\",\"provider\":\"openai\",",
      "\"model\":\"gpt-4o\",\"latency_ms\":120,\"tokens\":42}]}");
    assert_eq(streq(_t_events_recent(), ev_one), 1, "events: recent holds the completed event");
    # Free-form fields (model, error, base_url) are JSON-escaped; a quote must not end the string.
    event_inference_failed("ollama", "m\"x", "bad \"q\"");
    event_health_changed("ollama", "http://h:1/\"", 1);
    event_health_changed("vllm", "http://v:2", 0);
    event_rate_limited("groq");
    var ev_body = _t_events_recent();
    assert_eq(_t_has(ev_body, strlen(ev_body),
        "{\"event\":\"inference_failed\",\"provider\":\"ollama\",\"model\":\"m\\\"x\",\"error\":\"bad \\\"q\\\"\"}"),
      1, "events: failed event escapes model and error");
    assert_eq(_t_has(ev_body, strlen(ev_body),
        "{\"event\":\"health_changed\",\"provider\":\"ollama\",\"base_url\":\"http://h:1/\\\"\",\"healthy\":true}"),
      1, "events: health up, base_url escaped");
    assert_eq(_t_has(ev_body, strlen(ev_body),
        "{\"event\":\"health_changed\",\"provider\":\"vllm\",\"base_url\":\"http://v:2\",\"healthy\":false}"),
      1, "events: health down");
    assert_eq(_t_has(ev_body, strlen(ev_body), "{\"event\":\"rate_limited\",\"provider\":\"groq\"}]}"), 1,
      "events: newest event last");
    assert_eq(events_total_published(), 5, "events: every builder published once");
    # The ring keeps the newest EVENT_RING_MAX, oldest first, once it wraps.
    var ev_i = 0;
    while (ev_i < 200) {
        event_emit("providers/inference", _t_line("{\"n\":", ev_i, "}"));
        ev_i = ev_i + 1;
    }
    ev_body = _t_events_recent();
    assert_eq(events_total_published(), 205, "events: the bus counts past the ring size");
    assert_eq(_t_count(ev_body, "{\"n\":"), EVENT_RING_MAX, "events: the ring holds EVENT_RING_MAX entries");
    assert_eq(memeq(ev_body, "{\"events\":[{\"n\":72},{\"n\":73},", 29), 1, "events: oldest kept entry first");
    assert_eq(_t_has(ev_body, strlen(ev_body), "{\"n\":198},{\"n\":199}]}"), 1, "events: newest entry last");
    assert_eq(_t_count(ev_body, "\"event\":"), 0, "events: the five early events were overwritten");

    # ── DLP scanner: PII/secret detection + classification ────────
    test_group("dlp_scanner");
    # The real dlp.cyr defaults to DISABLED — config turns it on. The mirror
    # this replaced hard-coded it on, so these assertions used to exercise a
    # scanner that could never short-circuit. Enable it explicitly.
    dlp_configure(1, CLASS_PUBLIC);
    # Restricted patterns
    assert_eq(_dlp_test("SSN: 123-45-6789"), CLASS_RESTRICTED, "dlp: ssn");
    assert_eq(_dlp_test("Card: 4111 1111 1111 1111"), CLASS_RESTRICTED,
      "dlp: credit card (spaced)");
    assert_eq(_dlp_test("Card: 4111111111111111"), CLASS_RESTRICTED,
      "dlp: credit card (no sep)");
    assert_eq(_dlp_test("Key: AKIAIOSFODNN7EXAMPLE"), CLASS_RESTRICTED,
      "dlp: aws access key");
    assert_eq(_dlp_test("Token: ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij"),
      CLASS_RESTRICTED, "dlp: github token");
    assert_eq(_dlp_test("use sk-abcdefghij0123456789ABCD here"),
      CLASS_RESTRICTED, "dlp: api key sk- prefix");
    assert_eq(_dlp_test("api_key=abcdefghij0123456789ABCD"),
      CLASS_RESTRICTED, "dlp: api_key= prefix");
    # Confidential
    assert_eq(_dlp_test("Call 555-123-4567 now"), CLASS_CONFIDENTIAL,
      "dlp: us phone");
    # Internal
    assert_eq(_dlp_test("Contact user@example.com please"), CLASS_INTERNAL,
      "dlp: email");
    assert_eq(_dlp_test("Server at 192.168.1.1 listening"), CLASS_INTERNAL,
      "dlp: ipv4");
    # Highest level wins (email Internal + SSN Restricted)
    assert_eq(_dlp_test("user@test.com SSN: 123-45-6789"), CLASS_RESTRICTED,
      "dlp: highest level wins");
    # Clean text + empty -> default (Public)
    assert_eq(_dlp_test("Explain Rust ownership in one sentence."), CLASS_PUBLIC,
      "dlp: clean text is public");
    assert_eq(_dlp_test(""), CLASS_PUBLIC, "dlp: empty is public");
    # No false positive: a long digit run is not a 16-digit card
    assert_eq(_dlp_test("order 12345678901234567890 shipped"), CLASS_PUBLIC,
      "dlp: 20-digit run is not a credit card");
    # No false positive: leading-dot domain is not an email
    assert_eq(_dlp_test("reach me at x@.com"), CLASS_PUBLIC,
      "dlp: empty domain label is not an email");
    # Classification ordering holds
    assert_eq(CLASS_PUBLIC < CLASS_INTERNAL, 1, "dlp: public < internal");
    assert_eq(CLASS_INTERNAL < CLASS_CONFIDENTIAL, 1, "dlp: internal < confidential");
    assert_eq(CLASS_CONFIDENTIAL < CLASS_RESTRICTED, 1, "dlp: confidential < restricted");
    # Disabled scanner returns the default level regardless of content
    dlp_configure(0, CLASS_PUBLIC);
    assert_eq(_dlp_test("SSN: 123-45-6789"), CLASS_PUBLIC,
      "dlp: disabled returns default");
    dlp_configure(1, CLASS_PUBLIC);
    _dlp_enabled = 1;

    # ── Response cache key (exact-key) ────────────────────────────
    test_group("cache_key");
    var rq = "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}";
    assert_eq(streq(_ckey("gpt-4o-mini", rq), _ckey("gpt-4o-mini", rq)), 1,
      "cache key: identical (model,body) is deterministic");
    assert_eq(streq(_ckey("gpt-4o-mini", rq), _ckey("gpt-4o", rq)), 0,
      "cache key: different model differs");
    var rq2 = "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"bye\"}]}";
    assert_eq(streq(_ckey("gpt-4o-mini", rq), _ckey("gpt-4o-mini", rq2)), 0,
      "cache key: different body differs");
    assert_eq(strlen(_ckey("gpt-4o-mini", rq)), 64, "cache key: sha256 hex is 64 chars");
    # 2.9.16: the real key leads with the caller's identity (auth.cyr sets it per request from the matched
    # token), so one caller's cached answer is never served to another. The copy here left it out.
    var ck_anon = _ckey("gpt-4o-mini", rq);
    thread_local_set(AUTH_IDENT_SLOT, 1);
    var ck_a = _ckey("gpt-4o-mini", rq);
    assert_eq(streq(ck_a, _ckey("gpt-4o-mini", rq)), 1, "cache key: same caller, same key");
    thread_local_set(AUTH_IDENT_SLOT, 2);
    assert_eq(streq(ck_a, _ckey("gpt-4o-mini", rq)), 0, "cache key: another caller, another key");
    thread_local_set(AUTH_IDENT_SLOT, 0);
    assert_eq(streq(ck_anon, ck_a), 0, "cache key: an authenticated caller does not share the anonymous entry");
    assert_eq(streq(ck_anon, _ckey("gpt-4o-mini", rq)), 1, "cache key: identity 0 is the anonymous key again");

    # ── Cache warming: canonical body + key match ─────────────────
    test_group("cache_warming");
    var wb = _warming_body("gpt-4o-mini", "hi");
    var wb_expect = "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}";
    assert_eq(streq(str_cstr(wb), wb_expect), 1, "warming: canonical body shape");
    # The warmed entry's key must equal the key of a client POSTing that body —
    # otherwise warming populates an entry nothing ever hits.
    var wkey = _cache_key("gpt-4o-mini", str_cstr(wb), str_len(wb));
    assert_eq(streq(wkey, _ckey("gpt-4o-mini", wb_expect)), 1,
      "warming: warmed key matches client request key");

    # ── Prompt compression: whitespace collapse in JSON values ────
    test_group("compression");
    # 2.9.4: compression.cyr's own switch ([cache] compress / the per-request opt-in reads it).
    assert_eq(compression_is_enabled(), 0, "compression: off by default");
    compression_configure(1);
    assert_eq(compression_is_enabled(), 1, "compression: configure turns it on");
    compression_configure(0);
    assert_eq(compression_is_enabled(), 0, "compression: and off again");
    assert_eq(streq(_compress("{\"content\":\"hello  world\"}"),
        "{\"content\":\"hello world\"}"), 1, "compress: collapse runs in content");
    assert_eq(streq(_compress("{\"content\":\"  foo  bar  \"}"),
        "{\"content\":\"foo bar\"}"), 1, "compress: trim leading/trailing in content");
    # \n and \t escapes inside a value collapse to a single space.
    assert_eq(streq(_compress("{\"content\":\"no\\nnewlines\\there\"}"),
        "{\"content\":\"no newlines here\"}"), 1, "compress: collapse \\n \\t escapes");
    # Keys and structure preserved; only the value collapses.
    assert_eq(streq(_compress("{\"role\":\"user\",\"content\":\"a   b\"}"),
        "{\"role\":\"user\",\"content\":\"a b\"}"), 1, "compress: keys/structure preserved");
    # Escaped quotes inside a value are preserved (not whitespace).
    assert_eq(streq(_compress("{\"content\":\"say  \\\"hi\\\"\"}"),
        "{\"content\":\"say \\\"hi\\\"\"}"), 1, "compress: escaped quotes preserved");
    # Clean content is unchanged.
    assert_eq(streq(_compress("{\"content\":\"already clean\"}"),
        "{\"content\":\"already clean\"}"), 1, "compress: clean content unchanged");

    # ── Per-token pricing + cost estimation ───────────────────────
    test_group("pricing");
    # gpt-4o-mini: 1000 in (0.15) + 500 out (0.6) = 150 + 300 = 450 µ$.
    assert_eq(estimate_cost_micro("gpt-4o-mini", PROV_OPENAI, 1000, 500), 450,
      "pricing: gpt-4o-mini exact 1000/500 = 450 µ$");
    # Prefix match: claude-sonnet-4-20250514 → claude-sonnet-4 (3.0/15.0).
    assert_eq(estimate_cost_micro("claude-sonnet-4-20250514", PROV_ANTHROPIC, 1000, 1000),
      18000, "pricing: prefix match claude-sonnet-4 1000/1000 = 18000 µ$");
    # Unknown model → provider fallback (OpenAI 2.5/10.0).
    assert_eq(estimate_cost_micro("gpt-9000", PROV_OPENAI, 1000, 0), 2500,
      "pricing: unknown openai model falls back to 2.5/M");
    # Local providers are free.
    assert_eq(estimate_cost_micro("llama3", PROV_OLLAMA, 1000, 1000), 0,
      "pricing: local provider is zero-cost");
    # Exact haiku at 1M input = $0.80 = 800000 µ$.
    # 2.8.0: claude-3.5-haiku was never an Anthropic id (and Haiku 3.5 retired 2026-02-19); the row is gone.
    assert_eq(estimate_cost_micro("claude-haiku-4-5", PROV_ANTHROPIC, 1000000, 0),
      1000000, "pricing: 1M tokens claude-haiku-4-5 input = 1000000 µ$ ($1.00/M)");
    # Cheaper model ranks below a pricier one (recommend ordering).
    var c_mini = estimate_cost_micro("gpt-4o-mini", PROV_OPENAI, 1000, 500);
    var c_4o = estimate_cost_micro("gpt-4o", PROV_OPENAI, 1000, 500);
    assert_eq(c_mini < c_4o, 1, "pricing: gpt-4o-mini cheaper than gpt-4o");

    # ── Cost optimizer: capability metadata + classification ──────
    test_group("cost_optimizer");
    # classify_complexity
    assert_eq(classify_complexity(500, 0, 0), TIER_ECONOMY, "classify: small text = economy");
    assert_eq(classify_complexity(500, 0, 1), TIER_STANDARD, "classify: vision = standard");
    assert_eq(classify_complexity(3000, 1, 0), TIER_STANDARD, "classify: tools+large = standard");
    assert_eq(classify_complexity(500, 1, 0), TIER_ECONOMY, "classify: tools+small = economy");
    assert_eq(classify_complexity(15000, 0, 0), TIER_STANDARD, "classify: large input = standard");
    # metadata lookup: exact, prefix, unknown
    var md = alloc(40);
    assert_eq(metadata_lookup("gpt-4o-mini", md), 1, "meta: gpt-4o-mini found");
    assert_eq(load64(md + 8), TIER_ECONOMY, "meta: gpt-4o-mini tier economy");
    assert_eq(load64(md + 16), 1, "meta: gpt-4o-mini has vision");
    assert_eq(metadata_lookup("claude-sonnet-4-20250514", md), 1, "meta: prefix match");
    assert_eq(load64(md + 8), TIER_STANDARD, "meta: claude-sonnet-4 tier standard");
    assert_eq(metadata_lookup("totally-unknown-model", md), 0, "meta: unknown not found");
    # meets_requirements
    metadata_lookup("llama-3.1-8b", md);  # economy, no vision, no tools, 128k
    assert_eq(meets_requirements(md, TIER_ECONOMY, 0, 0, 0, 1000), 1,
      "meets: economy text ok");
    assert_eq(meets_requirements(md, TIER_ECONOMY, 1, 0, 0, 1000), 0,
      "meets: vision required but model has none");
    assert_eq(meets_requirements(md, TIER_ECONOMY, 0, 1, 0, 1000), 0,
      "meets: tools required but model has none");
    assert_eq(meets_requirements(md, TIER_ECONOMY, 0, 0, 0, 200000), 0,
      "meets: exceeds context window");
    metadata_lookup("gpt-4o-mini", md);  # economy, vision, tools
    assert_eq(meets_requirements(md, TIER_STANDARD, 0, 0, 0, 1000), 0,
      "meets: economy model fails standard-tier requirement");

    # ── Tool calling: extract the request's tools array ───────────
    test_group("tool_calling");
    assert_eq(streq(_etools("{\"model\":\"m\",\"tools\":[{\"type\":\"function\"}]}"),
        "[{\"type\":\"function\"}]"), 1, "tools: extracted span");
    # Nested arrays inside a tool (e.g. an enum) are balanced correctly.
    assert_eq(streq(_etools("{\"tools\":[{\"enum\":[1,2,3]}],\"x\":1}"),
        "[{\"enum\":[1,2,3]}]"), 1, "tools: nested arrays balanced");
    # A `]` inside a string value doesn't end the array early.
    assert_eq(streq(_etools("{\"tools\":[{\"d\":\"a]b\"}]}"),
        "[{\"d\":\"a]b\"}]"), 1, "tools: bracket in string ignored");
    # Absent / empty tools → 0.
    assert_eq(_etools("{\"model\":\"m\",\"messages\":[]}"), 0, "tools: absent → 0");
    assert_eq(_etools("{\"tools\":[]}"), 0, "tools: empty array → 0");
    # 2.9.16: only the TOP-LEVEL "tools" counts. The copy here matched the key anywhere, such as inside a
    # message's content.
    assert_eq(_etools("{\"messages\":[{\"role\":\"user\",\"content\":{\"tools\":[1]}}]}"), 0,
      "tools: a nested tools key is not the request's tools");
    # 2.9.16: with whitespace inside too. src forwarded "tools":[] from 2.6.9 to 2.9.15; the copy here kept the rule.
    assert_eq(_etools("{\"tools\": [ \n ], \"model\":\"m\"}"), 0, "tools: whitespace-only array → 0");
    assert_eq(streq(_etools("{\"tools\":[ 1 ]}"), "[ 1 ]"), 1, "tools: one element is kept");

    # Outbound conversion: OpenAI tools → Anthropic (input_schema) / Gemini.
    # NB: "function" appears as both the "type" value and the real object key.
    var oai_tools = "[{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\"d\",\"parameters\":{\"type\":\"object\"}}}]";
    assert_eq(streq(_conv(oai_tools, "input_schema"),
        "[{\"name\":\"get_weather\",\"description\":\"d\",\"input_schema\":{\"type\":\"object\"}}]"),
      1, "tools: OpenAI → Anthropic input_schema");
    assert_eq(streq(_conv(oai_tools, "parameters"),
        "[{\"name\":\"get_weather\",\"description\":\"d\",\"parameters\":{\"type\":\"object\"}}]"),
      1, "tools: OpenAI → Gemini parameters");
    # Inbound: Anthropic tool_use blocks → OpenAI tool_calls (input stringified).
    var ant_resp = "{\"content\":[{\"type\":\"text\",\"text\":\"hi\"},{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"get_weather\",\"input\":{\"city\":\"Paris\"}}]}";
    assert_eq(streq(_antc(ant_resp),
        "[{\"id\":\"toolu_1\",\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\"}}]"),
      1, "tools: Anthropic tool_use → OpenAI tool_calls");
    # No tool_use blocks → 0.
    assert_eq(_antc("{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}"), 0,
      "tools: Anthropic no tool_use → 0");

    # ── 2.6.1: Ollama native tool_calls → OpenAI tool_calls ───────
    # Ollama nests {"function":{"index":N,"name":…,"arguments":{…}}}: `arguments` is a JSON
    # OBJECT (the spec says a JSON-encoded STRING) and `index` is not an OpenAI field. Forwarded
    # raw, that hands clients an object where a string is promised — thoth read it as a string,
    # got nothing, and dropped every argument. Payload below is captured verbatim from
    # qwen3.5:9b through hoosh.
    var oll = "{\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_it284wqj\",\"function\":{\"index\":0,\"name\":\"read_file\",\"arguments\":{\"path\":\"VERSION\"}}}]}}";
    assert_eq(streq(_ollc(oll),
        "[{\"id\":\"call_it284wqj\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"VERSION\\\"}\"}}]"),
      1, "tools: Ollama object arguments → encoded string, type:function added, index dropped");
    # Empty arguments object (nemotron-3-nano:4b does this) → "{}", not a dropped call.
    var oll_empty = "{\"message\":{\"tool_calls\":[{\"id\":\"call_3q9\",\"function\":{\"index\":0,\"name\":\"list_dir\",\"arguments\":{}}}]}}";
    assert_eq(streq(_ollc(oll_empty),
        "[{\"id\":\"call_3q9\",\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"arguments\":\"{}\"}}]"),
      1, "tools: Ollama empty arguments → \"{}\"");
    # Older builds omit `id` → synthesise one (mirrors the Gemini converter).
    var oll_noid = "{\"message\":{\"tool_calls\":[{\"function\":{\"name\":\"ping\",\"arguments\":{}}}]}}";
    assert_eq(streq(_ollc(oll_noid),
        "[{\"id\":\"call_0\",\"type\":\"function\",\"function\":{\"name\":\"ping\",\"arguments\":\"{}\"}}]"),
      1, "tools: Ollama missing id → synthesised call_0");
    # Already-encoded string arguments pass through verbatim — escaping them again would
    # double-encode (\\\" becoming \\\\\\\") and the client would parse a string, not an object.
    var oll_str = "{\"message\":{\"tool_calls\":[{\"id\":\"c9\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"VERSION\\\"}\"}}]}}";
    assert_eq(streq(_ollc(oll_str),
        "[{\"id\":\"c9\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"VERSION\\\"}\"}}]"),
      1, "tools: Ollama already-encoded string arguments pass through, not double-escaped");
    # Two calls in one round keep their order and both get converted.
    var oll_two = "{\"message\":{\"tool_calls\":[{\"id\":\"a\",\"function\":{\"name\":\"f\",\"arguments\":{\"x\":1}}},{\"id\":\"b\",\"function\":{\"name\":\"g\",\"arguments\":{\"y\":2}}}]}}";
    assert_eq(streq(_ollc(oll_two),
        "[{\"id\":\"a\",\"type\":\"function\",\"function\":{\"name\":\"f\",\"arguments\":\"{\\\"x\\\":1}\"}},{\"id\":\"b\",\"type\":\"function\",\"function\":{\"name\":\"g\",\"arguments\":\"{\\\"y\\\":2}\"}}]"),
      1, "tools: Ollama multiple calls converted in order");
    # A plain content-only chunk carries no calls → 0, so the streaming reader emits nothing.
    assert_eq(_ollc("{\"message\":{\"role\":\"assistant\",\"content\":\"hello\"},\"done\":false}"), 0,
      "tools: Ollama content-only chunk → 0");

    # ── 2.6.1: the OUTBOUND mirror — tool-continuation → Ollama shape ──
    # The client echoes back the assistant turn hoosh gave it, whose `arguments` is now a JSON
    # STRING. Ollama's /api/chat rejects that with "Value looks like object, but can't find
    # closing '}' symbol", so round 2 returns nothing and the agentic loop never closes.
    var cont = "[{\"role\":\"user\",\"content\":\"ls\"},{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"arguments\":\"{\\\"path\\\":\\\".\\\"}\"}}]},{\"role\":\"tool\",\"content\":\"README.md\"}]";
    assert_eq(streq(_ollm(cont),
        "[{\"role\":\"user\",\"content\":\"ls\"},{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"arguments\":{\"path\":\".\"}}}]},{\"role\":\"tool\",\"content\":\"README.md\"}]"),
      1, "continuation: arguments STRING unescaped to OBJECT; user + tool turns verbatim");
    # Nothing to translate → 0, so the caller forwards the raw span untouched (no re-serialisation
    # of ordinary conversations, and no chance of mangling one).
    assert_eq(_ollm("[{\"role\":\"user\",\"content\":\"hi\"}]"), 0,
      "continuation: no tool_calls → 0 (raw span forwarded)");
    # Empty arguments string → "{}" rather than an invalid bare value.
    var cont_empty = "[{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"ping\",\"arguments\":\"\"}}]}]";
    assert_eq(streq(_ollm(cont_empty),
        "[{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"ping\",\"arguments\":{}}}]}]"),
      1, "continuation: empty arguments string → {}");
    # Already an object (a client that never round-tripped through hoosh) → passed through as-is.
    var cont_obj = "[{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c3\",\"type\":\"function\",\"function\":{\"name\":\"f\",\"arguments\":{\"x\":1}}}]}]";
    assert_eq(streq(_ollm(cont_obj),
        "[{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c3\",\"type\":\"function\",\"function\":{\"name\":\"f\",\"arguments\":{\"x\":1}}}]}]"),
      1, "continuation: object arguments pass through unchanged");

    # ── Stale tool-pair prune (compression) ───────────────────────
    test_group("tool_prune");
    # 5 assistant tool-call turns (c1..c5) + their tool results, bracketed by
    # user turns. Keep 3 → drop c1,c2 (calls + matching results).
    var conv = "[{\"role\":\"user\",\"content\":\"q\"},{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"c1\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c1\",\"content\":\"r1\"},{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"c2\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c2\",\"content\":\"r2\"},{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"c3\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c3\",\"content\":\"r3\"},{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"c4\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c4\",\"content\":\"r4\"},{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"c5\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c5\",\"content\":\"r5\"},{\"role\":\"user\",\"content\":\"final\"}]";
    var pr = _prune(conv);
    var prl = strlen(pr);
    assert_eq(_cmp_substr(pr, prl, "\"c1\"", 4) < 0, 1, "prune: stale c1 call+result dropped");
    assert_eq(_cmp_substr(pr, prl, "\"c2\"", 4) < 0, 1, "prune: stale c2 call+result dropped");
    assert_eq(_cmp_substr(pr, prl, "\"c3\"", 4) >= 0, 1, "prune: recent c3 kept");
    assert_eq(_cmp_substr(pr, prl, "\"c5\"", 4) >= 0, 1, "prune: recent c5 kept");
    assert_eq(_cmp_substr(pr, prl, "final", 5) >= 0, 1, "prune: last user kept");
    assert_eq(_cmp_substr(pr, prl, "\"q\"", 3) >= 0, 1, "prune: first user kept");
    # 3 or fewer tool turns → unchanged.
    var conv2 = "[{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"c1\"}]},{\"role\":\"tool\",\"tool_call_id\":\"c1\",\"content\":\"r\"}]";
    var pr2 = _prune(conv2);
    assert_eq(_cmp_substr(pr2, strlen(pr2), "\"c1\"", 4) >= 0, 1, "prune: <=3 turns unchanged");
    # 2.9.4: the scans are compression.cyr's own. A string ending in an escaped backslash closes at its quote;
    # the copy this replaced read the quote as escaped (`\"`) and ran on past the object.
    var cesc = "{\"content\":\"dir C:\\\\\"},{\"role\":\"user\"}";   # {"content":"dir C:\\"},{"role":"user"}
    assert_eq(_cmp_span_end(cesc, strlen(cesc), 0), 22,
      "prune scan: an escaped backslash before the quote ends the string");
    var cfv = "{\"content\":\"C:\\\\\",\"role\":\"tool\"}";             # {"content":"C:\\","role":"tool"}
    var cfr = _cmp_str_field(cfv, strlen(cfv), "content", 7);
    assert_eq(load64(cfr + 8), 4, "prune field: a value ending in an escaped backslash is 4 bytes");
    var cfrole = _cmp_str_field(cfv, strlen(cfv), "role", 4);
    assert_eq(load64(cfrole + 8), 4, "prune field: the next field is still found");
    assert_eq(memeq(load64(cfrole), "tool", 4), 1, "prune field: and reads as tool");

    # ── MCP tool server (bote) ────────────────────────────────────
    # Exercises the real bote-core registry/dispatcher/codec that
    # src/lib/mcp.cyr drives behind /v1/tools/list + /v1/tools/call.
    test_group("mcp_tools");
    # mcp_init is src/lib/mcp.cyr's own: the registry and dispatcher the gateway serves.
    var mcp_disp = mcp_init();
    var mcp_reg = dispatcher_registry(mcp_disp);
    assert_eq(registry_len(mcp_reg), 1, "mcp: registry holds one tool");
    assert_eq(registry_contains(mcp_reg, "bote_echo"), 1, "mcp: registry contains bote_echo");
    # 2.9.2: a definition bote refuses is reported (0, and a WARN), not silently dropped.
    var mcp_bad = tool_def_new("bad name!", "a name bote refuses", schema_new("object", vec_new(), vec_new()));
    assert_eq(mcp_register_tool(mcp_disp, mcp_bad, &_hoosh_tool_echo), 0, "mcp: a refused tool reports 0");
    var mcp_arr = schema_new("array", vec_new(), vec_new());
    var mcp_nos = tool_def_new("no_schema_type", "an inputSchema that is not an object", mcp_arr);
    assert_eq(mcp_register_tool(mcp_disp, mcp_nos, &_hoosh_tool_echo), 0, "mcp: a non-object inputSchema is refused");
    assert_eq(registry_len(mcp_reg), 1, "mcp: refused tools are not registered");
    var mcp_ok = tool_def_new("hoosh_test_tool", "a valid second tool", schema_new("object", vec_new(), vec_new()));
    assert_eq(mcp_register_tool(mcp_disp, mcp_ok, &_hoosh_tool_echo), 1, "mcp: a valid tool reports 1");
    assert_eq(registry_len(mcp_reg), 2, "mcp: and is registered");

    # tools/list — the request src/lib/mcp.cyr synthesizes for GET.
    var mcp_lst = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", mcp_disp, 0);
    var mcp_ll = strlen(mcp_lst);
    assert_eq(_cmp_substr(mcp_lst, mcp_ll, "bote_echo", 9) >= 0, 1, "mcp: tools/list lists bote_echo");
    assert_eq(_cmp_substr(mcp_lst, mcp_ll, "\"result\"", 8) >= 0, 1, "mcp: tools/list is a JSON-RPC result");

    # tools/call — echo round-trips the arguments as text content.
    var mcp_call = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"bote_echo\",\"arguments\":{\"k\":\"v\"}}}", mcp_disp, 0);
    var mcp_cl = strlen(mcp_call);
    assert_eq(_cmp_substr(mcp_call, mcp_cl, "\"content\"", 9) >= 0, 1, "mcp: tools/call returns content");
    assert_eq(_cmp_substr(mcp_call, mcp_cl, "isError", 7) >= 0, 1, "mcp: tools/call result has isError");
    assert_eq(_cmp_substr(mcp_call, mcp_cl, "\"id\":2", 6) >= 0, 1, "mcp: tools/call echoes request id");

    # Unknown tool → JSON-RPC error, no crash.
    var mcp_miss = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"nope\",\"arguments\":{}}}", mcp_disp, 0);
    assert_eq(_cmp_substr(mcp_miss, strlen(mcp_miss), "\"error\"", 7) >= 0, 1, "mcp: unknown tool yields error");

    # ── Batch request parsing (POST /v1/batch) ────────────────────
    test_group("batch");
    # Body with nested array + a string value containing } and ] — the splitter
    # must treat those as inside-string, not structural.
    var bbody = "{\"meta\":1,\"requests\":[{\"a\":1},{\"b\":[2,3]},{\"c\":\"}]x\"}]}";
    var barr = _batch_extract_requests(bbody, strlen(bbody));
    assert_eq(barr != 0, 1, "batch: requests array located");
    var bitems = _batch_split(load64(barr), load64(barr + 8));
    assert_eq(vec_len(bitems), 3, "batch: split yields 3 items");
    # Item 0 = {"a":1}
    var b0 = vec_get(bitems, 0);
    assert_eq(load8(load64(b0)), 123, "batch: item0 starts with {");
    assert_eq(load8(load64(b0) + load64(b0 + 8) - 1), 125, "batch: item0 ends with }");
    # Item 1 carries the nested array intact.
    var b1 = vec_get(bitems, 1);
    assert_eq(_cmp_substr(load64(b1), load64(b1 + 8), "[2,3]", 5) >= 0, 1, "batch: item1 keeps nested array");
    # Item 2's string value (with } and ]) survives splitting.
    var b2 = vec_get(bitems, 2);
    assert_eq(_cmp_substr(load64(b2), load64(b2 + 8), "}]x", 3) >= 0, 1, "batch: item2 string brackets intact");
    # No "requests" key → 0.
    var bnone = "{\"model\":\"x\"}";
    assert_eq(_batch_extract_requests(bnone, strlen(bnone)), 0, "batch: missing requests → 0");
    # Empty array → 0 items.
    var bempty = _batch_split("[]", 2);
    assert_eq(vec_len(bempty), 0, "batch: empty array → 0 items");

    # ── Async batch (mode detection + status names) ───────────────
    test_group("batch_async");
    var ba1 = "{\"async\":true,\"requests\":[]}";
    assert_eq(_batch_is_async(ba1, strlen(ba1)), 1, "async: compact true detected");
    var ba2 = "{\"async\": true, \"requests\":[]}";
    assert_eq(_batch_is_async(ba2, strlen(ba2)), 1, "async: spaced true detected");
    var ba3 = "{\"async\":false,\"requests\":[]}";
    assert_eq(_batch_is_async(ba3, strlen(ba3)), 0, "async: false → sync");
    var ba4 = "{\"requests\":[]}";
    assert_eq(_batch_is_async(ba4, strlen(ba4)), 0, "async: absent → sync");
    assert_streq(_batch_status_name(0), "queued", "async: status 0=queued");
    assert_streq(_batch_status_name(1), "running", "async: status 1=running");
    assert_streq(_batch_status_name(2), "completed", "async: status 2=completed");
    assert_streq(_batch_status_name(3), "cancelled", "async: status 3=cancelled");
    # 2.9.17: the real names, and BATCH_FAILED (2.6.7), which the copy here did not know and called "cancelled".
    assert_streq(_batch_status_name(BATCH_FAILED), "failed", "async: a batch that could not start is failed");
    assert_eq(BATCH_QUEUED == 0 && BATCH_RUNNING == 1 && BATCH_COMPLETED == 2 && BATCH_CANCELLED == 3, 1,
      "async: the status values the names above assume");
    # 2.9.17: only the TOP-LEVEL "async" counts (the scan used to take the first one anywhere).
    var ba5 = "{\"requests\":[{\"model\":\"m\",\"async\":true}]}";
    assert_eq(_batch_is_async(ba5, strlen(ba5)), 0, "async: an item's own async does not make the batch async");
    var ba6 = "{\"requests\":[{\"async\":false}],\"async\":true}";
    assert_eq(_batch_is_async(ba6, strlen(ba6)), 1, "async: a nested false does not hide the top-level true");
    # The same for "requests": whitespace before the colon is fine, and a nested key is not the batch.
    var br1 = "{\"requests\" : [{\"model\":\"m\"}]}";
    var br1a = _batch_extract_requests(br1, strlen(br1));
    assert_eq(br1a != 0 && load64(br1a + 8) == 15, 1, "batch: a space before the colon is fine");
    var br2 = "{\"meta\":{\"requests\":[1]},\"requests\":[{\"model\":\"a\"},{\"model\":\"b\"}]}";
    var br2a = _batch_extract_requests(br2, strlen(br2));
    assert_eq(vec_len(_batch_split(load64(br2a), load64(br2a + 8))), 2,
      "batch: a nested requests key is not the batch");
    # "requests" must be an array: anything else is no batch, not a span to split.
    var br3 = "{\"requests\":\"[{}]\"}";
    assert_eq(_batch_extract_requests(br3, strlen(br3)), 0, "batch: a string named requests is not the batch");
    var br4 = "{\"requests\":{\"a\":[1]}}";
    assert_eq(_batch_extract_requests(br4, strlen(br4)), 0, "batch: an object named requests is not the batch");

    # ── Observability: latency buckets + traceparent extraction ───
    test_group("observability");
    # 2.9.5: metrics.cyr's own histogram. Each sample lands in the first bucket whose bound it does not exceed
    # (le 5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000 ms), the 12th slot is the overflow.
    metrics_latency_init();
    var lp = PROV_GROQ;                      # a provider no other test records against
    metrics_record_latency(lp, 3);
    metrics_record_latency(lp, 5);
    metrics_record_latency(lp, 50);
    metrics_record_latency(lp, 51);
    metrics_record_latency(lp, 20000);
    assert_eq(_t_lat_slot(lp, 0), 2, "lat: 3 and 5 ms -> bucket 0 (le 5)");
    assert_eq(_t_lat_slot(lp, 3), 1, "lat: 50ms -> bucket 3 (le 50)");
    assert_eq(_t_lat_slot(lp, 4), 1, "lat: 51ms -> bucket 4 (le 100)");
    assert_eq(_t_lat_slot(lp, 11), 1, "lat: 20s -> overflow bucket 11");
    assert_eq(load64(_lat_count + lp * 8), 5, "lat: five samples counted");
    assert_eq(load64(_lat_sum + lp * 8), 3 + 5 + 50 + 51 + 20000, "lat: and summed");
    metrics_record_latency(0 - 1, 7);
    metrics_record_latency(PROV_COUNT, 7);
    assert_eq(load64(_lat_count + lp * 8), 5, "lat: an out-of-range provider records nothing");
    # The Prometheus exposition: cumulative buckets, +Inf, sum and count, labelled by provider.
    var lsb = str_builder_new();
    metrics_emit_latency(lsb);
    var lexp = str_builder_build(lsb);
    assert_eq(str_contains(lexp, str_from("# TYPE hoosh_provider_latency_ms histogram")), 1,
      "lat: a histogram TYPE line");
    var lname = provider_name(lp);
    var lb5 = str_builder_new();
    str_builder_add_cstr(lb5, "hoosh_provider_latency_ms_bucket{provider=\"");
    str_builder_add_cstr(lb5, lname);
    str_builder_add_cstr(lb5, "\",le=\"5\"} 2\n");
    assert_eq(str_contains(lexp, str_builder_build(lb5)), 1, "lat: le=5 holds 2");
    var lb100 = str_builder_new();
    str_builder_add_cstr(lb100, "hoosh_provider_latency_ms_bucket{provider=\"");
    str_builder_add_cstr(lb100, lname);
    str_builder_add_cstr(lb100, "\",le=\"100\"} 4\n");
    assert_eq(str_contains(lexp, str_builder_build(lb100)), 1, "lat: le=100 is cumulative (4)");
    var linf = str_builder_new();
    str_builder_add_cstr(linf, "hoosh_provider_latency_ms_bucket{provider=\"");
    str_builder_add_cstr(linf, lname);
    str_builder_add_cstr(linf, "\",le=\"+Inf\"} 5\n");
    assert_eq(str_contains(lexp, str_builder_build(linf)), 1, "lat: +Inf counts every sample (5)");
    # 2.9.24: the bucket search, lifted into _lat_bucket so the bench times it. A latency equal to a bound lands in
    # that bucket; one past the last bound (10000 ms) is the overflow slot.
    assert_eq(_lat_bucket(0), 0, "lat: 0 ms is the first bucket");
    assert_eq(_lat_bucket(5), 0, "lat: 5 ms is still the first bucket (le=5)");
    assert_eq(_lat_bucket(6), 1, "lat: 6 ms is the second");
    assert_eq(_lat_bucket(10000), NLAT_BUCKETS - 1, "lat: 10000 ms is the last finite bucket");
    assert_eq(_lat_bucket(10001), NLAT_BUCKETS, "lat: past it is the overflow slot");
    # Request and token counters.
    metrics_reset();
    metrics_record(10, 4);
    metrics_record(5, 1);
    assert_eq(_met_requests, 2, "metrics: requests counted");
    assert_eq(_met_prompt_tokens, 15, "metrics: prompt tokens summed");
    assert_eq(_met_comp_tokens, 5, "metrics: completion tokens summed");
    metrics_reset();
    assert_eq(_met_requests + _met_prompt_tokens + _met_comp_tokens, 0, "metrics: reset zeroes all three");
    # 2.6.8: the value must be a well-formed W3C traceparent —
    # 00-<32 hex>-<16 hex>-<2 hex>, exactly 55 bytes. The OTLP span builder
    # slices it at FIXED offsets, so a short value made it read ~50 bytes past
    # a tiny allocation and emit them unescaped into the span batch. These
    # assertions previously blessed `00-abc-def-01` and `00-XY-ZW-01` as valid.
    var tgood = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
    var treq = "POST /x HTTP/1.1\r\nHost: h\r\ntraceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\nContent-Type: application/json\r\n\r\nbody";
    var tval = trace_extract(treq, strlen(treq));
    assert_eq(tval != 0, 1, "trace: well-formed header located");
    assert_eq(strlen(tval), 55, "trace: value is exactly the 55-byte header value");
    assert_streq(tval, tgood, "trace: value extracted verbatim");
    var tnone = "POST /x HTTP/1.1\r\nHost: h\r\n\r\nbody";
    assert_eq(trace_extract(tnone, strlen(tnone)), 0, "trace: absent → 0");
    # Case-insensitive header NAME, with a valid value.
    var tcase = "GET / HTTP/1.1\r\nTraceParent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\n\r\n";
    assert_eq(trace_extract(tcase, strlen(tcase)) != 0, 1, "trace: case-insensitive header name");
    # Malformed values are rejected so a fresh id is generated instead.
    var tshort = "GET / HTTP/1.1\r\ntraceparent: x\r\n\r\n";
    assert_eq(trace_extract(tshort, strlen(tshort)), 0, "trace: one-byte value rejected");
    var told = "GET / HTTP/1.1\r\ntraceparent: 00-abc-def-01\r\n\r\n";
    assert_eq(trace_extract(told, strlen(told)), 0, "trace: short malformed value rejected");
    var tnonhex = "GET / HTTP/1.1\r\ntraceparent: 00-4bf92f3577b34da6a3ce929d0e0e47ZZ-00f067aa0ba902b7-01\r\n\r\n";
    assert_eq(trace_extract(tnonhex, strlen(tnonhex)), 0, "trace: non-hex value rejected");
    var tsep = "GET / HTTP/1.1\r\ntraceparent: 00_4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\n\r\n";
    assert_eq(trace_extract(tsep, strlen(tsep)), 0, "trace: wrong separator rejected");
    # 2.9.5: trace.cyr's own generator. A fresh id has the W3C shape the extractor demands, so it round-trips, and
    # two ids are never equal (clock + atomic counter).
    var tg1 = trace_generate();
    var tg2 = trace_generate();
    assert_eq(strlen(tg1), 55, "trace: a generated id is 55 bytes");
    assert_eq(memeq(tg1, "00-", 3), 1, "trace: version 00");
    assert_eq(memeq(tg1 + 52, "-01", 3), 1, "trace: sampled flag 01");
    assert_eq(streq(tg1, tg2), 0, "trace: two generated ids differ");
    var tgh = str_builder_new();
    str_builder_add_cstr(tgh, "GET / HTTP/1.1\r\ntraceparent: ");
    str_builder_add_cstr(tgh, tg1);
    str_builder_add_cstr(tgh, "\r\n\r\n");
    var tgs = str_builder_build(tgh);
    assert_streq(trace_extract(str_data(tgs), str_len(tgs)), tg1, "trace: a generated id passes extraction");
    # The thread-local current id: set, read back, and generated once when unset.
    trace_set(tgood);
    assert_streq(trace_current_or_new(), tgood, "trace: the current id is the one set");
    trace_set(0);
    var tc1 = trace_current_or_new();
    assert_eq(strlen(tc1), 55, "trace: unset -> a fresh id");
    assert_streq(trace_current_or_new(), tc1, "trace: and the same id until reset");
    trace_set(0);

    # OTLP path extraction + int-attribute JSON (OTLP/JSON encodes ints as strings).
    var ourl = "http://localhost:4318/v1/traces";
    var opath = _otlp_path(ourl);
    assert_streq(opath, "/v1/traces", "otlp: path extracted from endpoint URL");
    var ohost = "http://collector:4317";
    assert_streq(_otlp_path(ohost), "/v1/traces", "otlp: default path when none in URL");
    var osb = str_builder_new();
    _otlp_attr_int(osb, "latency_ms", 50);
    var oattr = str_data(str_builder_build(osb));
    assert_streq(oattr, "{\"key\":\"latency_ms\",\"value\":{\"intValue\":\"50\"}}", "otlp: int attr is a JSON string value");
    # 2.9.14: OTLP endpoint scheme detection runs on the real _otlp_is_https (otlp_spans group).

    # ── 2.9.14: otlp.cyr for real — the span ring and the batch document ──
    test_group("otlp_spans");
    # Disabled (no endpoint, the default): enqueueing is a no-op.
    assert_eq(otlp_enqueue_inference_span("ollama", "llama3", 10, 5, 1), 0, "otlp: disabled, a no-op");
    assert_eq(_otlp_count, 0, "otlp: disabled, nothing enqueued");
    assert_eq(_otlp_is_https(), 0, "otlp: no endpoint is not https");
    # The ring as otlp_init sets it up, without its exporter thread (which would POST to a collector).
    _otlp_endpoint = "http://localhost:4318/v1/traces";
    assert_eq(_otlp_is_https(), 0, "otlp: an http endpoint is posted directly");
    _otlp_spans = alloc(OTLP_RING_MAX * 8);
    var os_i = 0;
    while (os_i < OTLP_RING_MAX) { store64(_otlp_spans + os_i * 8, 0); os_i = os_i + 1; }
    _otlp_lock = mutex_new();
    trace_set("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01");
    otlp_enqueue_inference_span("ollama", "m\"x", 250, 42, 1);
    otlp_enqueue_inference_span("vllm", "llama3", 0, 0, 0);
    assert_eq(_otlp_count, 2, "otlp: two spans in the ring");
    var os1 = load64(_otlp_spans);
    var os2 = load64(_otlp_spans + 8);
    var os1l = strlen(os1);
    assert_eq(memeq(os1, "{\"traceId\":\"0af7651916cd43dd8448eb211c80319c\",\"spanId\":\"b7ad6b7169203331\",", 74), 1,
      "otlp: trace and span ids from the current traceparent");
    assert_eq(_t_has(os1, os1l, "\"name\":\"inference\",\"kind\":3,"), 1, "otlp: an inference span, kind CLIENT");
    assert_eq(_t_has(os1, os1l, "{\"key\":\"provider\",\"value\":{\"stringValue\":\"ollama\"}}"), 1, "otlp: provider");
    assert_eq(_t_has(os1, os1l, "{\"key\":\"model\",\"value\":{\"stringValue\":\"m\\\"x\"}}"), 1,
      "otlp: model escaped");
    assert_eq(_t_has(os1, os1l, "{\"key\":\"latency_ms\",\"value\":{\"intValue\":\"250\"}}"), 1,
      "otlp: latency as an OTLP/JSON int string");
    assert_eq(_t_has(os1, os1l, "{\"key\":\"tokens\",\"value\":{\"intValue\":\"42\"}}"), 1, "otlp: tokens");
    assert_eq(_t_has(os1, os1l, "\"status\":{\"code\":1}}"), 1, "otlp: ok is status 1");
    assert_eq(_t_has(os2, strlen(os2), "\"status\":{\"code\":2}}"), 1, "otlp: a failure is status 2");
    assert_eq(_t_json_qint(os1, "endTimeUnixNano") - _t_json_qint(os1, "startTimeUnixNano"), 250000000,
      "otlp: the span starts latency_ms before it ends");
    var os_fr = alloc(16);
    store64(os_fr, os1);
    store64(os_fr + 8, os2);
    var os_doc = str_data(_otlp_build_batch(os_fr, 2));
    var os_head = _t_cat("{\"resourceSpans\":[{\"resource\":{\"attributes\":[{\"key\":\"service.name\",",
      "\"value\":{\"stringValue\":\"hoosh\"}}]},");
    os_head = _t_cat(os_head, "\"scopeSpans\":[{\"scope\":{\"name\":\"hoosh\"},\"spans\":[");
    var os_want = _t_cat(_t_cat(_t_cat(os_head, os1), ","), _t_cat(os2, "]}]}]}"));
    assert_streq(os_doc, os_want, "otlp: the batch wraps the spans in one ResourceSpans document");
    # The ring keeps the newest OTLP_RING_MAX: the head wraps.
    os_i = 0;
    while (os_i < 300) { otlp_enqueue_inference_span("ollama", "llama3", 1, 1, 1); os_i = os_i + 1; }
    assert_eq(_otlp_count, 302, "otlp: every span counted");
    assert_eq(load64(_otlp_spans + ((_otlp_head - 1) % OTLP_RING_MAX) * 8) != os2, 1, "otlp: the ring wrapped");
    _otlp_endpoint = "https://collector.example:4318/v1/traces";
    assert_eq(_otlp_is_https(), 1, "otlp: an https endpoint goes through a pool worker");
    # A reload that drops otlp_endpoint stops enqueueing, though the ring stays allocated.
    _otlp_endpoint = 0;
    otlp_enqueue_inference_span("ollama", "llama3", 1, 1, 1);
    assert_eq(_otlp_count, 302, "otlp: endpoint cleared, nothing more enqueued");
    _otlp_spans = 0;
    _otlp_count = 0;
    _otlp_head = 0;
    trace_set(0);

    # ── 2.9.14: provider.cyr for real — the points where the test file's copies had drifted ──
    test_group("provider_real");
    # Token counts pack prompt high, completion low, each clamped to 0..2^32-1.
    assert_eq(_pack_tokens(3, 4), 3 * 0x100000000 + 4, "provider: prompt high, completion low");
    assert_eq(_pack_tokens(0 - 5, 7), 7, "provider: a negative count packs as 0");
    assert_eq(_pack_tokens(1, 0x100000005) % 0x100000000, 0xFFFFFFFF, "provider: a count past 32 bits saturates");
    # Gemini bills thinking as output (thoughtsTokenCount, outside candidatesTokenCount); the copy dropped it.
    var gth = "{\"usageMetadata\":{\"promptTokenCount\":12,\"candidatesTokenCount\":30,\"thoughtsTokenCount\":50}}";
    var gtt = extract_gemini_tokens(gth, strlen(gth));
    assert_eq(gtt / 0x100000000, 12, "provider: Gemini prompt tokens");
    assert_eq(gtt % 0x100000000, 80, "provider: Gemini thinking tokens billed as output");
    # A backslash consumes the next byte, so an escaped backslash right before a quote does not hide the string's
    # end. The copy checked only the byte before each quote and ran past `"a\\"` here.
    var jse = "{\"s\":\"a\\\\\"} tail";
    assert_eq(_json_span_end(jse, strlen(jse), 0), 11, "provider: an escaped backslash before a quote ends the string");
    # ...and an escaped quote does not end it: the `}` inside "x\"}" is string content.
    var jse2 = "{\"s\":\"x\\\"}\"} tail";
    assert_eq(_json_span_end(jse2, strlen(jse2), 0), 12, "provider: an escaped quote does not end the string");
    # The Anthropic body takes max_tokens from the request (the copy hard-coded 4096) and converts OpenAI tools.
    var ab_msgs = "[{\"role\":\"user\",\"content\":\"hi\"}]";
    var ab_tools = "[{\"type\":\"function\",\"function\":{\"name\":\"get_w\",\"parameters\":{\"type\":\"object\"}}}]";
    var ab = _build_anthropic_body("claude-sonnet-4", ab_msgs, strlen(ab_msgs), ab_tools, strlen(ab_tools),
      genopts_new(0, 1000, GEN_UNSET, GEN_UNSET), 0);
    assert_eq(_t_has(ab, strlen(ab), "\"max_tokens\":1000"), 1, "provider: Anthropic max_tokens from the request");
    assert_eq(_t_has(ab, strlen(ab), "\"tools\":[{\"name\":\"get_w\""), 1,
      "provider: OpenAI tools become Anthropic tools");
    assert_eq(_t_has(ab, strlen(ab), "\"input_schema\":{\"type\":\"object\"}"), 1,
      "provider: parameters become input_schema");
    var gb = _build_gemini_body(ab_msgs, strlen(ab_msgs), ab_tools, strlen(ab_tools));
    assert_eq(_t_has(gb, strlen(gb), "\"tools\":[{\"functionDeclarations\":[{\"name\":\"get_w\""), 1,
      "provider: OpenAI tools become Gemini functionDeclarations");

    # ── Worker-pool work queue: wq.cyr's real ring (2.9.20) ─────────
    test_group("pool");
    # A 4-slot ring, so the wrap and the full case come quickly. WQ_MAX is restored below.
    WQ_MAX = 4;
    wq_init();
    assert_eq(wq_pop(), 0, "wq: empty pop → 0");
    assert_eq(wq_outstanding(), 0, "wq: nothing outstanding at start");
    assert_eq(wq_try_push(101), 1, "wq: push into an empty ring");
    wq_push(102);
    wq_push(103);
    assert_eq(wq_outstanding(), 3, "wq: three queued");
    assert_eq(wq_pop(), 101, "wq: FIFO order (1)");
    assert_eq(wq_pop(), 102, "wq: FIFO order (2)");
    # Popped jobs stay outstanding until wq_done: the shutdown drain waits on queued + in flight.
    assert_eq(wq_outstanding(), 3, "wq: popped jobs still outstanding");
    wq_done();
    wq_done();
    assert_eq(wq_outstanding(), 1, "wq: wq_done ends a popped job");
    # Wrap-around: head advanced, push past the physical end.
    wq_push(104);
    wq_push(105);
    wq_push(106);
    assert_eq(wq_try_push(107), 0, "wq: full ring refuses wq_try_push");
    assert_eq(wq_outstanding(), 4, "wq: a refused push queues nothing");
    assert_eq(wq_pop(), 103, "wq: FIFO across wrap (3)");
    assert_eq(wq_pop(), 104, "wq: FIFO across wrap (4)");
    assert_eq(wq_pop(), 105, "wq: FIFO across wrap (5)");
    assert_eq(wq_pop(), 106, "wq: FIFO across wrap (6)");
    assert_eq(wq_pop(), 0, "wq: drained → 0");
    assert_eq(wq_outstanding(), 4, "wq: drained, four still in flight");
    var wqd = 0;
    while (wqd < 4) {
        wq_done();
        wqd = wqd + 1;
    }
    assert_eq(wq_outstanding(), 0, "wq: all done");
    # wq_push on a full ring waits instead of dropping the job, and goes through once a pop makes room.
    wq_push(1);
    wq_push(2);
    wq_push(3);
    wq_push(4);
    _t_wq_pushed = 0;
    var wq_th = thread_create(&_t_wq_pusher, 5);
    sleep_ms(30);
    assert_eq(atomic_load(&_t_wq_pushed), 0, "wq: wq_push waits on a full ring");
    assert_eq(wq_pop(), 1, "wq: pop makes room");
    thread_join(wq_th);
    assert_eq(atomic_load(&_t_wq_pushed), 1, "wq: the waiting push went through");
    assert_eq(wq_pop(), 2, "wq: order kept after backpressure (2)");
    assert_eq(wq_pop(), 3, "wq: order kept after backpressure (3)");
    assert_eq(wq_pop(), 4, "wq: order kept after backpressure (4)");
    assert_eq(wq_pop(), 5, "wq: the waited job is last");
    # wq_init starts the ring empty again, whatever was queued or in flight.
    wq_push(6);
    wq_init();
    assert_eq(wq_outstanding(), 0, "wq: wq_init clears queued and in-flight counts");
    assert_eq(wq_pop(), 0, "wq: wq_init leaves nothing to pop");
    # 2.10.1: a serial thread backend. thread_create runs a body inline there, so a forever-loop never returned, and hoosh never
    # reached sock_accept on AGNOS. This binary has real threads, so the backend's flag is what is flipped.
    var sv_tc = THREADS_CONCURRENT;
    wq_push(41);
    assert_eq(wq_serial_turn(&_t_wq_job), 0, "serial: with real workers the accept loop runs nothing");
    assert_eq(wq_outstanding(), 1, "serial: ...and the job stays for them");
    THREADS_CONCURRENT = 0;
    assert_eq(wq_serial_turn(&_t_wq_job), 1, "serial: with no workers the accept loop runs the job");
    assert_eq(_t_wq_ran, 41, "serial: ...that job");
    assert_eq(wq_outstanding(), 0, "serial: ...and it is finished, not left in flight");
    assert_eq(wq_serial_turn(&_t_wq_job), 0, "serial: an empty queue runs nothing");
    # The starters whose body never ends. Each would hang this test, inline, were it not guarded.
    var sv_cs = _coarse_started;
    _coarse_started = 0;
    coarse_clock_start();
    assert_eq(_coarse_started, 0, "serial: no coarse clock ticker");
    assert(hoosh_now_ms() > 0, "serial: ...so hoosh_now_ms reads the real clock");
    _coarse_started = sv_cs;
    var sv_hw = _hw_refresh_s;
    _hw_refresh_s = 1;
    assert_eq(hw_refresh_start(), 0, "serial: no hardware re-detection thread");
    _hw_refresh_s = sv_hw;
    var sv_hi = _health_interval_s;
    var sv_hs = _health_started;
    _health_interval_s = 1;
    _health_started = 0;
    health_start();
    assert_eq(_health_started, 1, "serial: the one health sweep runs, and no probe thread follows it");
    _health_interval_s = sv_hi;
    _health_started = sv_hs;
    THREADS_CONCURRENT = sv_tc;
    # 2.9.26: /v1/queue/status's body is the queue's real depth (it was a constant).
    assert_streq(to_cstr(wq_status_json()), "{\"queued\":0,\"pending\":0,\"processing\":0}", "status: an empty queue");
    wq_push(7);
    wq_push(8);
    wq_push(9);
    wq_pop();
    assert_streq(to_cstr(wq_status_json()), "{\"queued\":2,\"pending\":2,\"processing\":1}",
      "status: two waiting, one being served");
    wq_done();
    wq_pop();
    wq_done();
    wq_pop();
    wq_done();
    assert_streq(to_cstr(wq_status_json()), "{\"queued\":0,\"pending\":0,\"processing\":0}", "status: drained");
    WQ_MAX = 8192;
    # Job layouts, as job_process in pool.cyr reads them.
    var jc = _job_conn(42);
    assert_eq(load64(jc), JOB_CONN, "job: conn type");
    assert_eq(load64(jc + 8), 42, "job: conn fd at +8");
    var jb = job_batch_item(1000, 17, 2000, 3000, 4000, 6000);
    assert_eq(load64(jb), JOB_BATCH_ITEM, "job: batch item type");
    assert_eq(load64(jb + 8), 1000, "job: batch request pointer at +8");
    assert_eq(load64(jb + 16), 17, "job: batch request length at +16");
    assert_eq(load64(jb + 24), 2000, "job: batch result slot at +24");
    assert_eq(load64(jb + 32), 3000, "job: batch completed counter at +32");
    assert_eq(load64(jb + 40), 4000, "job: batch failed counter at +40");
    assert_eq(load64(jb + 48), 6000, "job: batch inbound trace context at +48");
    var jo = job_otlp_export(5000, 9);
    assert_eq(load64(jo), JOB_OTLP_EXPORT, "job: otlp export type");
    assert_eq(load64(jo + 8), 5000, "job: otlp document at +8");
    assert_eq(load64(jo + 16), 9, "job: otlp document length at +16");
    assert_eq(JOB_CONN != JOB_BATCH_ITEM && JOB_BATCH_ITEM != JOB_OTLP_EXPORT && JOB_OTLP_EXPORT != JOB_CONN, 1,
      "job: the three types are distinct");

    # ── Hardware: requirement-string → REQ_* enum ────────────────
    test_group("hardware");
    assert_eq(_hoosh_req_from_str("none"), 0, "req: none → REQ_NONE");
    assert_eq(_hoosh_req_from_str("gpu"), 1, "req: gpu → REQ_GPU");
    assert_eq(_hoosh_req_from_str("tpu"), 2, "req: tpu → REQ_TPU");
    assert_eq(_hoosh_req_from_str("gpu-or-tpu"), 5, "req: gpu-or-tpu → REQ_GPU_OR_TPU");
    assert_eq(_hoosh_req_from_str("any-accelerator"), 6, "req: any-accelerator → REQ_ANY_ACCELERATOR");
    assert_eq(_hoosh_req_from_str("quantum"), 0 - 1, "req: unknown → -1");

    # ── Routing strategy config + lowest-latency pick (2.4.5) ────
    test_group("routing_strategy");
    assert_eq(strategy_from_str("priority"), 0, "strat: priority → 0");
    assert_eq(strategy_from_str("round-robin"), 1, "strat: round-robin → 1");
    assert_eq(strategy_from_str("lowest-latency"), 2, "strat: lowest-latency → 2");
    assert_eq(strategy_from_str("direct"), 3, "strat: direct → 3");
    assert_eq(strategy_from_str("bogus"), 0, "strat: unknown → priority");
    # 2.9.18: the real names, and the alias spellings config files use.
    assert_eq(strategy_from_str("roundrobin"), STRAT_ROUND_ROBIN, "strat: roundrobin is round-robin");
    assert_eq(strategy_from_str("lowest_latency"), STRAT_LOWEST_LATENCY, "strat: lowest_latency is lowest-latency");
    # Lowest-latency, on the real router (2.9.9). A route with no latency recorded counts as LAT_UNMEASURED_MS:
    # it is tried while every measured route is slower, and loses to one measured faster. The copy this replaced
    # ranked it 0 ms, and since a failed forward records no latency, a route that never succeeded won every pick.
    assert_streq(route_base_url(_t_ll_pick2(80, 0 - 1)), "http://ll-b", "ll: unmeasured is tried over a slow route");
    assert_streq(route_base_url(_t_ll_pick2(15, 0 - 1)), "http://ll-a", "ll: a fast measured route beats unmeasured");
    assert_streq(route_base_url(_t_ll_pick2(LAT_UNMEASURED_MS, 0 - 1)), "http://ll-a",
      "ll: a tie keeps priority order");
    assert_streq(route_base_url(_t_ll_pick2(80, 40)), "http://ll-b", "ll: both measured, the lower wins");
    assert_streq(route_base_url(_t_ll_pick2(15, 40)), "http://ll-a", "ll: ...either way round");

    # ── v2.5.1 parity closeout: bind / body cap / multi-token auth ──
    test_group("config_str_array");
    # `tokens = ["a", "b", "c"]` must yield THREE tokens. Before 2.5.1 the raw
    # scalar was pushed as one, so no configured key ever matched.
    # 2.9.23: the reader takes the section's pairs and the key, and reads an array with bayan's own parser.
    var csa_out = alloc(32 * 8);
    var csa_n = _t_strs("[auth]\ntokens = [\"alpha-key-111\", \"beta-key-222\", \"gamma-key-333\"]\n", "auth", "tokens",
      csa_out, 32);
    assert_eq(csa_n, 3, "str_array: three elements parsed");
    assert_streq(load64(csa_out), "alpha-key-111", "str_array: first element");
    assert_streq(load64(csa_out + 8), "beta-key-222", "str_array: second element");
    assert_streq(load64(csa_out + 16), "gamma-key-333", "str_array: third element");
    # A scalar stays a single element (single-token configs keep working).
    assert_eq(_t_strs("[auth]\ntokens = \"solo-token\"\n", "auth", "tokens", csa_out, 32), 1,
      "str_array: a string scalar is one element");
    assert_streq(load64(csa_out), "solo-token", "str_array: scalar value");
    # Empty array → zero elements (and must not write past `out`); an absent key → 0.
    assert_eq(_t_strs("[auth]\ntokens = []\n", "auth", "tokens", csa_out, 32), 0, "str_array: empty array → 0");
    assert_eq(_t_strs("[auth]\nother = 1\n", "auth", "tokens", csa_out, 32), 0, "str_array: absent key → 0");
    # Bound is enforced — the old inline models parser had 8 slots and NO
    # check, so a 9th pattern wrote past the allocation.
    var csa_many = "[auth]\ntokens = [\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\",\"i\",\"j\"]\n";
    assert_eq(_t_strs(csa_many, "auth", "tokens", csa_out, 4), 4, "str_array: honors max bound");
    # 2.9.23: quotes are tracked. Through 2.9.22 a `,` `]` or `"` inside a string ended the element.
    assert_eq(_t_strs("[auth]\ntokens = [\"abc,def\", \"x]y\"]\n", "auth", "tokens", csa_out, 32), 2,
      "str_array: a comma or bracket inside a string stays in it");
    assert_streq(load64(csa_out), "abc,def", "str_array: abc,def is one element");
    assert_streq(load64(csa_out + 8), "x]y", "str_array: x]y is one element");
    var csa_esc = "[[providers]]\nmodels = [\"we\\\"ird\", \"tab\\there\"]\n";
    assert_eq(_t_strs(csa_esc, "providers", "models", csa_out, 32), 2, "str_array: escaped quotes end no string");
    assert_streq(load64(csa_out), "we\"ird", "str_array: a basic string's \\\" is decoded");
    assert_streq(load64(csa_out + 8), "tab\there", "str_array: and its \\t");
    assert_eq(_t_strs("[[providers]]\nmodels = ['C:\\path', \" lead\"]\n", "providers", "models", csa_out, 32), 2,
      "str_array: literal and spaced strings");
    assert_streq(load64(csa_out), "C:\\path", "str_array: a literal string loses its quotes, keeps its backslash");
    assert_streq(load64(csa_out + 8), " lead", "str_array: a leading space inside quotes is kept");
    # A multi-line array with comments: the comment and the line breaks are not elements.
    var csa_ml = "[auth]\ntokens = [\n  \"secret-1\",  # alice\n  \"secret-2\",  # bob\n]\n";
    assert_eq(_t_strs(csa_ml, "auth", "tokens", csa_out, 32), 2, "str_array: a commented multi-line array is two");
    assert_streq(load64(csa_out + 8), "secret-2", "str_array: its second element");
    # A scalar is read whole, even with a comma or a leading bracket in it.
    assert_eq(_t_strs("[auth]\ntokens = \"a,b\"\n", "auth", "tokens", csa_out, 32), 1, "str_array: scalar a,b is one");
    assert_eq(_t_strs("[auth]\ntokens = \"[x\"\n", "auth", "tokens", csa_out, 32), 1, "str_array: scalar [x is one");
    assert_streq(load64(csa_out), "[x", "str_array: and keeps its bracket");
    # Empty elements, and one holding a NUL (a C string would cut it short), are skipped.
    assert_eq(_t_strs("[auth]\ntokens = [\"\", \"ab\\u0000cd\", \"ok\"]\n", "auth", "tokens", csa_out, 32), 1,
      "str_array: empty and NUL-holding elements skipped");
    assert_streq(load64(csa_out), "ok", "str_array: the rest kept");
    # The point of it: through 2.9.22 `tokens = ["abc,def"]` made "abc" a token of its own. The real auth_check
    # on what the reader returns:
    var csa_tn = _t_strs("[auth]\ntokens = [\"abc,def\"]\n", "auth", "tokens", csa_out, 32);
    var csa_toks = vec_new();
    var csa_i = 0;
    while (csa_i < csa_tn) {
        vec_push(csa_toks, load64(csa_out + csa_i * 8));
        csa_i = csa_i + 1;
    }
    var csa_r1 = _t_bearer_req("abc,def");
    assert_eq(auth_check(csa_r1, strlen(csa_r1), csa_toks), 1, "str_array: the whole token authenticates");
    var csa_r2 = _t_bearer_req("abc");
    assert_eq(auth_check(csa_r2, strlen(csa_r2), csa_toks), 0, "str_array: a piece of it does not");
    var csa_r3 = _t_bearer_req("def");
    assert_eq(auth_check(csa_r3, strlen(csa_r3), csa_toks), 0, "str_array: nor the other piece");

    test_group("req_content_length");
    var rcl1 = "POST /v1/chat/completions HTTP/1.1\r\nContent-Length: 4096\r\n\r\nbody";
    assert_eq(req_content_length(rcl1, strlen(rcl1)), 4096, "content-length: parsed");
    # Header names are case-insensitive on the wire.
    var rcl2 = "POST / HTTP/1.1\r\ncontent-length: 17\r\n\r\nx";
    assert_eq(req_content_length(rcl2, strlen(rcl2)), 17, "content-length: lowercase accepted");
    # Absent header → 0 (treated as no declared body).
    var rcl3 = "GET /v1/models HTTP/1.1\r\nHost: x\r\n\r\n";
    assert_eq(req_content_length(rcl3, strlen(rcl3)), 0, "content-length: absent → 0");
    # A body containing the literal header text must NOT spoof the value — the
    # scan stops at the CRLFCRLF that ends the header block.
    var rcl4 = "POST / HTTP/1.1\r\nHost: x\r\n\r\n{\"s\":\"content-length: 999\"}";
    assert_eq(req_content_length(rcl4, strlen(rcl4)), 0, "content-length: body cannot spoof");
    # 2.6.7: the name must START a header line. The match used to fire at any
    # byte offset, so the request URI or an earlier header VALUE carrying the
    # literal won on first-match — a Referer was enough to make a small valid
    # request answer 413.
    var rcl5 = "GET /x?q=content-length:%209999 HTTP/1.1\r\nHost: x\r\nContent-Length: 12\r\n\r\nhello world!";
    assert_eq(req_content_length(rcl5, strlen(rcl5)), 12,
      "content-length: a literal in the URI does not win over the real header");
    var rcl6 = "POST / HTTP/1.1\r\nReferer: http://a/content-length: 9999\r\nContent-Length: 5\r\n\r\nhello";
    assert_eq(req_content_length(rcl6, strlen(rcl6)), 5,
      "content-length: a literal in another header value does not win");
    # 2.6.7: an absurd digit run wrapped i64 and could land on a small or
    # negative value that passed the MAX_REQUEST_BODY check. Now refused.
    var rcl7 = "POST / HTTP/1.1\r\nContent-Length: 99999999999999999999999999\r\n\r\nx";
    assert_eq(req_content_length(rcl7, strlen(rcl7)), 0 - 1,
      "content-length: over-long digit run is refused");
    var rcl8 = "POST / HTTP/1.1\r\nContent-Length: abc\r\n\r\nx";
    assert_eq(req_content_length(rcl8, strlen(rcl8)), 0 - 1,
      "content-length: non-numeric value is refused");

    test_group("bind_addr_str");
    # Packed network-byte-order IPv4, octets LSB-first.
    assert_streq(bind_addr_str(0x0100007F), "127.0.0.1", "bind: loopback default");
    assert_streq(bind_addr_str(0), "0.0.0.0", "bind: INADDR_ANY");
    assert_streq(bind_addr_str(0xBA01A8C0), "192.168.1.186", "bind: LAN address");

    # ── v2.5.2 request-path fidelity: sampling params + validation ──
    test_group("req_num_milli");
    # Sampling params are raw-scanned, NOT json_get: OpenAI clients place them
    # after the nested `messages` array, which the flat json_parse cannot reach.
    # That blind spot is why max_tokens silently fell back to 2048 pre-2.5.2.
    var rn1 = "{\"model\":\"m\",\"messages\":[{\"role\":\"user\"}],\"temperature\":0.7}";
    assert_eq(_req_num_milli(rn1, strlen(rn1), "\"temperature\"", 13), 700,
      "num: 0.7 after messages -> 700");
    var rn2 = "{\"max_tokens\":1234,\"messages\":[]}";
    assert_eq(_req_num_milli(rn2, strlen(rn2), "\"max_tokens\"", 12), 1234000,
      "num: integer 1234 -> 1234000");
    # 0 must parse as 0, NOT be confused with absent — a client asking for
    # temperature 0 wants determinism and must not silently get the default.
    var rn3 = "{\"temperature\":0}";
    assert_eq(_req_num_milli(rn3, strlen(rn3), "\"temperature\"", 13), 0,
      "num: explicit 0 is a value, not unset");
    var rn4 = "{\"model\":\"m\"}";
    assert_eq(_req_num_milli(rn4, strlen(rn4), "\"temperature\"", 13), GEN_UNSET,
      "num: absent -> GEN_UNSET");
    var rn5 = "{\"top_p\": 0.95}";
    assert_eq(_req_num_milli(rn5, strlen(rn5), "\"top_p\"", 7), 950,
      "num: space after colon tolerated");
    var rn6 = "{\"temperature\":-0.5}";
    assert_eq(_req_num_milli(rn6, strlen(rn6), "\"temperature\"", 13), 0 - 500,
      "num: negative preserved for range validation");
    var rn7 = "{\"temperature\":2}";
    assert_eq(_req_num_milli(rn7, strlen(rn7), "\"temperature\"", 13), 2000,
      "num: 2 -> 2000 (range boundary)");
    # 2.9.16: only a top-level field counts. A tool schema's "max_tokens" property, which precedes the request's
    # own in OpenAI clients, is not the request's limit. The copy here matched it.
    var rn8 = "{\"tools\":[{\"parameters\":{\"max_tokens\":5}}],\"max_tokens\":300}";
    assert_eq(_req_num_milli(rn8, strlen(rn8), "\"max_tokens\"", 12), 300000, "num: a nested key is skipped");
    var rn9 = "{\"tools\":[{\"parameters\":{\"max_tokens\":5}}]}";
    assert_eq(_req_num_milli(rn9, strlen(rn9), "\"max_tokens\"", 12), GEN_UNSET, "num: only a nested key is absent");
    # A value with no digits is unset, not 0: `null` from a client that serializes every field, or a quoted number.
    var rn10 = "{\"temperature\":null}";
    assert_eq(_req_num_milli(rn10, strlen(rn10), "\"temperature\"", 13), GEN_UNSET, "num: null is unset, not 0");
    var rn11 = "{\"temperature\":\"0.5\"}";
    assert_eq(_req_num_milli(rn11, strlen(rn11), "\"temperature\"", 13), GEN_UNSET, "num: a quoted number is unset");

    test_group("milli_render");
    # Scaled ints render back to the wire form a client would have sent.
    assert_streq(_t_milli_str(700), "0.7", "milli: 700 -> 0.7");
    assert_streq(_t_milli_str(950), "0.95", "milli: 950 -> 0.95");
    assert_streq(_t_milli_str(50), "0.05", "milli: 50 -> 0.05");
    assert_streq(_t_milli_str(5), "0.005", "milli: 5 -> 0.005");
    assert_streq(_t_milli_str(0), "0", "milli: 0 -> 0");
    assert_streq(_t_milli_str(1000), "1", "milli: 1000 -> 1");
    assert_streq(_t_milli_str(1500), "1.5", "milli: 1500 -> 1.5");
    assert_streq(_t_milli_str(2000), "2", "milli: 2000 -> 2");

    test_group("json_array_count");
    var ac1 = "[{\"role\":\"user\",\"content\":\"hi\"},{\"role\":\"assistant\",\"content\":\"yo\"}]";
    assert_eq(_json_array_count(ac1, strlen(ac1)), 2, "count: two messages");
    assert_eq(_json_array_count("[]", 2), 0, "count: empty array -> 0");
    # Braces inside a string value must not inflate the count.
    var ac2 = "[{\"content\":\"a{b}c\"}]";
    assert_eq(_json_array_count(ac2, strlen(ac2)), 1, "count: braces in string ignored");
    # A nested object belongs to its parent message, not a new element.
    var ac3 = "[{\"content\":\"x\",\"meta\":{\"a\":1}}]";
    assert_eq(_json_array_count(ac3, strlen(ac3)), 1, "count: nested object not counted");
    # Closing braces inside a string must not end an element early either: without the string skip, "}}" here
    # drops the depth below 0 and the second message goes uncounted.
    var ac4 = "[{\"content\":\"}}\"},{\"content\":\"x\"}]";
    assert_eq(_json_array_count(ac4, strlen(ac4)), 2, "count: closing braces in a string do not end the element");
    assert_eq(256 > 256, 0, "count: 256 messages allowed");
    assert_eq(257 > 256, 1, "count: 257 messages rejected");

    test_group("requires_post");
    # Body-taking routes are POST-only; a GET used to reach the handler with an empty body and answer a confusing 400
    # instead of 405. 2.9.21: reqparse.cyr's own _requires_post, over its whole list (the copy kept 4 of the 19).
    var rpv = vec_new();
    vec_push(rpv, "/v1/chat/completions");
    vec_push(rpv, "/v1/embeddings");
    vec_push(rpv, "/v1/batch");
    vec_push(rpv, "/v1/tokens/check");
    vec_push(rpv, "/v1/tokens/reserve");
    vec_push(rpv, "/v1/tokens/report");
    vec_push(rpv, "/v1/hardware/placement");
    vec_push(rpv, "/v1/hardware/cost");
    vec_push(rpv, "/v1/hardware/training-estimate");
    vec_push(rpv, "/v1/hardware/model-format");
    vec_push(rpv, "/v1/hardware/requirement-match");
    vec_push(rpv, "/v1/hardware/simulate");
    vec_push(rpv, "/v1/models/pull");
    vec_push(rpv, "/v1/models/delete");
    vec_push(rpv, "/v1/training/status");
    vec_push(rpv, "/v1/cost/estimate");
    vec_push(rpv, "/v1/cost/recommend");
    vec_push(rpv, "/v1/tools/call");
    vec_push(rpv, "/v1/models/refresh");
    var rpi = 0;
    while (rpi < vec_len(rpv)) {
        assert_eq(_requires_post(vec_get(rpv, rpi)), 1, _t_cat("post: POST-only: ", vec_get(rpv, rpi)));
        rpi = rpi + 1;
    }
    # GET routes stay permissive on purpose — gating them would break clients
    # that POST today and gain nothing.
    assert_eq(_requires_post("/v1/models"), 0, "post: models unenforced");
    assert_eq(_requires_post("/v1/health"), 0, "post: health unenforced");
    assert_eq(_requires_post("/metrics"), 0, "post: metrics unenforced");
    # So are the POST routes that take no body, and /v1/hardware/models answers both verbs.
    assert_eq(_requires_post("/v1/costs/reset"), 0, "post: costs/reset takes no body, unenforced");
    assert_eq(_requires_post("/v1/admin/reload"), 0, "post: admin/reload takes no body, unenforced");
    assert_eq(_requires_post("/v1/catalog/sync"), 0, "post: catalog/sync takes no body, unenforced");
    assert_eq(_requires_post("/v1/hardware/models"), 0, "post: hardware/models answers GET and POST");
    # Exact paths only.
    assert_eq(_requires_post("/v1/chat/completions/"), 0, "post: a trailing slash is another path");
    assert_eq(_requires_post("/v1/batch/abc"), 0, "post: batch progress (GET /v1/batch/{id}) unenforced");

    # ── v2.5.3 provider correctness ──
    test_group("status_retryable");
    # rust-old gated backoff on is_retryable; the port retried everything and
    # spent the full ~30 s schedule proving a 400 was still a 400.
    assert_eq(status_retryable(400), 0, "retry: 400 permanent");
    assert_eq(status_retryable(401), 0, "retry: 401 permanent");
    assert_eq(status_retryable(403), 0, "retry: 403 permanent");
    assert_eq(status_retryable(404), 0, "retry: 404 permanent");
    assert_eq(status_retryable(422), 0, "retry: 422 permanent");
    # 408/429 are the two 4xx worth another attempt.
    assert_eq(status_retryable(408), 1, "retry: 408 retryable");
    assert_eq(status_retryable(429), 1, "retry: 429 retryable");
    assert_eq(status_retryable(500), 1, "retry: 500 retryable");
    assert_eq(status_retryable(502), 1, "retry: 502 retryable");
    assert_eq(status_retryable(503), 1, "retry: 503 retryable");

    test_group("groq_base_url");
    # Groq's OpenAI-compatible surface is under /openai — without the prefix
    # every request builds .../v1/chat/completions and 404s.
    assert_streq(provider_default_url(10), "https://api.groq.com/openai", "groq: /openai prefix present");
    # Concatenation with the chat path must yield Groq's real endpoint.
    var gsb = str_builder_new();
    str_builder_add_cstr(gsb, provider_default_url(10));
    str_builder_add_cstr(gsb, "/v1/chat/completions");
    assert_streq(str_cstr(str_builder_build(gsb)),
      "https://api.groq.com/openai/v1/chat/completions", "groq: full URL correct");
    # OpenRouter's existing /api prefix must be unaffected.
    assert_streq(provider_default_url(12), "https://openrouter.ai/api", "groq fix: openrouter untouched");

    test_group("ollama_native_sampling");
    # Ollama's /api/chat ignores top-level temperature/max_tokens — it reads
    # options.{temperature,top_p,num_predict}. Emitting the OpenAI shape for an
    # ollama route silently dropped every sampling param.
    assert_streq(_t_sampling_str(512, 700, 900, 1),
      ",\"options\":{\"temperature\":0.7,\"top_p\":0.9,\"num_predict\":512}",
      "ollama: nested options with num_predict");
    assert_streq(_t_sampling_str(512, 700, 900, 0),
      ",\"max_tokens\":512,\"temperature\":0.7,\"top_p\":0.9",
      "openai-compat: flat top-level fields");
    # Partial sets must not emit a dangling comma inside options.
    assert_streq(_t_sampling_str(0, 700, GEN_UNSET, 1),
      ",\"options\":{\"temperature\":0.7}", "ollama: temperature only");
    assert_streq(_t_sampling_str(256, GEN_UNSET, GEN_UNSET, 1),
      ",\"options\":{\"num_predict\":256}", "ollama: num_predict only");
    # Nothing set -> nothing emitted, so the body stays byte-identical to a
    # pre-2.5.2 request.
    assert_streq(_t_sampling_str(0, GEN_UNSET, GEN_UNSET, 1), "",
      "ollama: no params -> no options object");
    assert_streq(_t_sampling_str(0, GEN_UNSET, GEN_UNSET, 0), "",
      "openai-compat: no params -> nothing emitted");
    # temperature 0 must still emit for Ollama.
    assert_streq(_t_sampling_str(0, 0, GEN_UNSET, 1),
      ",\"options\":{\"temperature\":0}", "ollama: temperature 0 emitted");

    # ── v2.5.4 cache expiry ──
    test_group("cache_ttl_expiry");
    # `[cache] ttl_secs = 300` shipped in hoosh.cyml since the port with nothing
    # reading it, so a cached response was served as a hit FOREVER. 2.9.7: the
    # REAL cache.cyr, with time injected through the coarse clock (_t_at), so no sleeps.
    var x_tc = cache_new(100, 1, 3);          # 3 s TTL
    _t_ins_at(x_tc, "k", 42, 1000);
    assert_eq(_t_get_at(x_tc, "k", 1500), 42, "ttl: fresh entry hits");
    assert_eq(load64(x_tc + CACHE_HITS), 1, "ttl: hit counted");
    # Just under the deadline is still live; at/after it is gone.
    assert_eq(_t_get_at(x_tc, "k", 3999), 42, "ttl: 2999ms old still live");
    assert_eq(_t_get_at(x_tc, "k", 4000), 0, "ttl: exactly at TTL expires");
    # Expiry counts BOTH ways — an eviction (it left the cache) and a miss (the
    # caller got nothing). rust-old's accounting; the two answer different
    # questions, and hit_rate stays honest only if the miss is recorded.
    assert_eq(load64(x_tc + CACHE_EVICTIONS), 1, "ttl: expiry counted as eviction");
    assert_eq(load64(x_tc + CACHE_MISSES), 1, "ttl: expiry counted as miss");
    assert_eq(cache_len(x_tc), 0, "ttl: expired entry removed from the map");
    # A re-insert after expiry starts a fresh lifetime.
    _t_ins_at(x_tc, "k", 99, 5000);
    assert_eq(_t_get_at(x_tc, "k", 5500), 99, "ttl: re-inserted entry live again");

    test_group("cache_ttl_disabled");
    # ttl_secs = 0 means never expire — the pre-2.5.4 behavior, now explicit.
    var x_tz = cache_new(100, 1, 0);
    _t_ins_at(x_tz, "k", 7, 1000);
    assert_eq(_t_get_at(x_tz, "k", 999999999), 7, "ttl 0: entry never expires");
    assert_eq(load64(x_tz + CACHE_EVICTIONS), 0, "ttl 0: no evictions");
    # A read must NOT extend the lifetime: TTL measures age from insert, not
    # from last access (that stamp is the separate LRU key).
    var x_tr = cache_new(100, 1, 3);
    _t_ins_at(x_tr, "k", 1, 1000);
    _t_get_at(x_tr, "k", 2000);               # touch — moves last_access only
    _t_get_at(x_tr, "k", 3000);               # touch again
    assert_eq(_t_get_at(x_tr, "k", 4000), 0, "ttl: reads do not extend lifetime");

    test_group("cache_evict_expired_sweep");
    var x_ts = cache_new(100, 1, 3);
    _t_ins_at(x_ts, "old1", 1, 1000);
    _t_ins_at(x_ts, "old2", 2, 1000);
    _t_ins_at(x_ts, "new1", 3, 6000);
    assert_eq(cache_len(x_ts), 3, "sweep: three entries stored");
    assert_eq(_t_sweep_at(x_ts, 7000), 2, "sweep: two expired removed");
    assert_eq(cache_len(x_ts), 1, "sweep: the fresh entry survives");
    assert_eq(load64(x_ts + CACHE_EVICTIONS), 2, "sweep: evictions credited");
    # A sweep with nothing expired is a no-op.
    assert_eq(_t_sweep_at(x_ts, 7001), 0, "sweep: idempotent");
    # TTL off -> the sweep does nothing at all.
    var x_tn = cache_new(100, 1, 0);
    _t_ins_at(x_tn, "a", 1, 1000);
    assert_eq(_t_sweep_at(x_tn, 999999999), 0, "sweep: no-op when TTL off");

    test_group("cache_capacity_prefers_expired");
    # At capacity, expired entries are reclaimed BEFORE evicting a live one —
    # otherwise a usable response is thrown away while corpses hold slots.
    var x_tp = cache_new(2, 1, 3);
    _t_ins_at(x_tp, "stale", 1, 1000);
    _t_ins_at(x_tp, "live", 2, 6000);
    _t_ins_at(x_tp, "new", 3, 6500);       # at capacity: "stale" is expired
    assert_eq(cache_len(x_tp), 2, "capacity: still two entries");
    assert_eq(_t_get_at(x_tp, "live", 6600), 2, "capacity: live entry retained");
    assert_eq(_t_get_at(x_tp, "new", 6600), 3, "capacity: new entry stored");
    # 2.9.7: the case plain LRU gets wrong. x expires but was READ after y was stored, so y is the least recently
    # used; only the expired sweep keeps the live y. (In the case above the expired entry was also the LRU one, so
    # skipping the sweep changed nothing and no test noticed.)
    var x_tq = cache_new(2, 1, 3);
    _t_ins_at(x_tq, "x", 1, 1000);
    _t_ins_at(x_tq, "y", 2, 2000);
    _t_get_at(x_tq, "x", 2500);               # x still live, read after y was stored
    _t_ins_at(x_tq, "z", 3, 4100);            # full: x has expired (age 3100), y is live (age 2100)
    assert_eq(_t_get_at(x_tq, "y", 4200), 2, "capacity: the live entry survives though it is the LRU one");
    assert_eq(_t_get_at(x_tq, "z", 4200), 3, "capacity: and the new entry is stored");

    test_group("cache_o1_eviction");
    # 2.10.0: two lists in each entry, by access (LRU) and by creation (TTL), so a full cache evicts in O(1) and
    # allocates nothing beyond the new entry. Through 2.9.26 every insert into a full cache built map_keys() twice
    # and scanned every entry: 524 KB and 4 ms an insert at the default 10000 entries.
    var x_l = cache_new(3, 1, 0);
    _t_ins_at(x_l, "a", 1, 1000);
    _t_ins_at(x_l, "b", 2, 1001);
    _t_ins_at(x_l, "c", 3, 1002);
    _t_get_at(x_l, "a", 1003);                # a is now the most recent: b is the LRU
    _t_ins_at(x_l, "d", 4, 1004);
    assert_eq(_t_get_at(x_l, "b", 1005), 0, "lru: the least recently used (b) is evicted");
    _t_get_at(x_l, "c", 1006);                # order now c, d, a: a is the LRU
    _t_ins_at(x_l, "e", 5, 1007);
    assert_eq(_t_get_at(x_l, "a", 1008), 0, "lru: then a, read before c was");
    assert_eq(_t_get_at(x_l, "c", 1009) + _t_get_at(x_l, "d", 1009) + _t_get_at(x_l, "e", 1009), 12,
      "lru: c, d and e remain");
    assert_eq(cache_evictions(x_l), 2, "lru: two evictions");
    # Inserting a key that is already there replaces its entry and evicts nothing, even at capacity.
    var x_rp = cache_new(2, 1, 0);
    _t_ins_at(x_rp, "x", 1, 1000);
    _t_ins_at(x_rp, "y", 2, 1001);
    _t_ins_at(x_rp, "x", 3, 1002);
    assert_eq(cache_len(x_rp), 2, "replace: still two entries");
    assert_eq(cache_evictions(x_rp), 0, "replace: nothing evicted");
    assert_eq(_t_get_at(x_rp, "x", 1003), 3, "replace: the new value");
    assert_eq(_t_get_at(x_rp, "y", 1003), 2, "replace: the other entry kept");
    _t_get_at(x_rp, "x", 1004);               # x is now the most recent: y is the LRU
    _t_ins_at(x_rp, "z", 4, 1005);
    assert_eq(_t_get_at(x_rp, "x", 1006), 3, "replace: listed once, so a later eviction spares it");
    assert_eq(_t_get_at(x_rp, "y", 1006), 0, "replace: and takes y, the LRU");
    # An evicted entry leaves the semantic index too (semantic_find would otherwise keep returning its key).
    var x_sem_was = _sem_enabled;
    _sem_enabled = 1;
    var x_sem = cache_new(1, 1, 0);
    var x_sem_n0 = semantic_count();
    var x_sem_v = alloc(16);
    _t_ins_at(x_sem, "sk1", 1, 1000);
    semantic_insert("sk1", x_sem_v, 2);
    assert_eq(semantic_count(), x_sem_n0 + 1, "semantic: the key is indexed");
    _t_ins_at(x_sem, "sk2", 2, 1001);         # evicts sk1
    assert_eq(semantic_count(), x_sem_n0, "semantic: evicting the entry drops its embedding");
    _sem_enabled = x_sem_was;
    # An expired entry read from the middle of the lists is unlinked cleanly: the sweep and LRU eviction that follow
    # still see consistent lists.
    var x_md = cache_new(3, 1, 3);
    _t_ins_at(x_md, "p", 1, 1000);
    _t_ins_at(x_md, "q", 2, 2000);
    _t_ins_at(x_md, "r", 3, 3000);
    assert_eq(_t_get_at(x_md, "q", 5100), 0, "middle: q has expired (age 3100) and is dropped on read");
    assert_eq(_t_sweep_at(x_md, 5100), 1, "middle: the sweep then takes p, the oldest, and stops at r");
    assert_eq(cache_len(x_md), 1, "middle: r alone remains");
    _t_ins_at(x_md, "s", 4, 5200);
    _t_ins_at(x_md, "t", 5, 5300);
    _t_ins_at(x_md, "u", 6, 5400);            # full (r, s, t): r is the LRU and has not expired
    assert_eq(_t_get_at(x_md, "r", 5500), 0, "middle: LRU eviction takes r");
    assert_eq(_t_get_at(x_md, "s", 5500) + _t_get_at(x_md, "t", 5500) + _t_get_at(x_md, "u", 5500), 15,
      "middle: s, t and u remain");
    # A full cache takes only the new entry per insert.
    var x_full = cache_new(1000, 1, 300);
    var xk = vec_new();
    var xi = 0;
    while (xi < 2000) {
        vec_push(xk, _t_line("prompt-", xi, ""));
        xi = xi + 1;
    }
    xi = 0;
    while (xi < 1000) {
        _t_ins_at(x_full, vec_get(xk, xi), xi + 1, 1000 + xi);
        xi = xi + 1;
    }
    var xu0 = alloc_used();
    while (xi < 2000) {
        _t_ins_at(x_full, vec_get(xk, xi), xi + 1, 1000 + xi);
        xi = xi + 1;
    }
    assert_lt((alloc_used() - xu0) / 1000, 256, "full: an insert takes under 256 bytes (it took 33 KB at 1000)");
    assert_eq(cache_len(x_full), 1000, "full: still 1000 entries");
    assert_eq(cache_evictions(x_full), 1000, "full: one eviction per insert");
    assert_eq(_t_get_at(x_full, vec_get(xk, 999), 3000), 0, "full: the oldest thousand are gone");
    assert_eq(_t_get_at(x_full, vec_get(xk, 1999), 3000), 2000, "full: the newest is there");
    _t_clock_real();

    test_group("route_real");
    # 2.9.7: route.cyr's own records. A new route is healthy until probed (refusing traffic before the first probe
    # would make startup an outage), asks its provider for a live catalog except OpenRouter (a marketplace of
    # hundreds) and Whisper, and has no output cap, rate limiter or TLS policy until config sets them.
    var rr = route_new(PROV_ANTHROPIC, 1, "https://api.anthropic.com");
    assert_eq(route_healthy(rr), 1, "route: healthy until probed");
    assert_eq(load64(route_health(rr) + HEALTH_FAILS), 0, "route: no failures yet");
    assert_eq(route_catalog_live(rr), 1, "route: live catalog by default");
    assert_eq(route_catalog_live(route_new(PROV_OPENROUTER, 1, "https://openrouter.ai/api")), 0,
      "route: OpenRouter defaults to the static catalog");
    assert_eq(route_catalog_live(route_new(PROV_WHISPER, 1, "http://localhost:9000")), 0,
      "route: Whisper defaults to the static catalog");
    assert_eq(route_max_tokens_limit(rr) + route_rate_limiter(rr) + route_tls_policy(rr), 0,
      "route: no cap, limiter or policy until configured");
    route_set_max_tokens_limit(rr, 4096);
    assert_eq(route_max_tokens_limit(rr), 4096, "route: output cap set");
    route_set_rate_limit(rr, 60);
    assert_eq(route_rate_limiter(rr) != 0, 1, "route: a positive rpm attaches a limiter");
    # An empty pattern matches nothing (src skips it); the copy this replaced matched it against an empty model.
    var rpat = alloc(16);
    store64(rpat, "");
    store64(rpat + 8, "claude-*");
    route_set_patterns(rr, rpat, 2);
    assert_eq(route_matches_model(rr, ""), 0, "route: an empty pattern matches nothing");
    assert_eq(route_matches_model(rr, "claude-haiku-4-5"), 1, "route: the prefix pattern still matches");

    test_group("cache_lru_eviction");
    # 2.9.7: with nothing expired, a full cache evicts the least recently USED entry: a read refreshes recency
    # (it does not extend the TTL). Untested until the real module was included.
    var x_lru = cache_new(3, 1, 0);
    _t_ins_at(x_lru, "a", 1, 1000);
    _t_ins_at(x_lru, "b", 2, 2000);
    _t_ins_at(x_lru, "c", 3, 3000);
    _t_get_at(x_lru, "a", 4000);              # a is now the most recently used
    _t_ins_at(x_lru, "d", 4, 5000);           # full: b (last used at 2000) goes
    assert_eq(cache_len(x_lru), 3, "lru: still three entries");
    assert_eq(_t_get_at(x_lru, "b", 5100), 0, "lru: the least recently used entry was evicted");
    assert_eq(_t_get_at(x_lru, "a", 5100), 1, "lru: a read kept a alive");
    assert_eq(_t_get_at(x_lru, "d", 5100), 4, "lru: the new entry is stored");
    assert_eq(cache_evictions(x_lru), 1, "lru: one eviction counted");
    _t_clock_real();

    test_group("semantic_remove");
    # An expired response must take its embedding with it, or semantic_find
    # keeps returning a key that resolves to nothing. 2.9.4: semantic.cyr's own
    # semantic_remove, which matches the key by CONTENT. The copy this replaced
    # compared pointers, the bug that kept the real expired-on-read path dead.
    semantic_configure(1, 850, 0, 0);
    var sc0 = semantic_count();
    semantic_insert("sr-11", _vec2(10000, 0), 2);
    semantic_insert("sr-22", _vec2(0, 10000), 2);
    semantic_insert("sr-33", _vec2(7071, 7071), 2);
    assert_eq(semantic_count(), sc0 + 3, "sem_remove: three entries stored");
    var sk22 = alloc(8);
    memcpy(sk22, "sr-22", 6);                 # a different pointer, the same text (the cache passes a fresh sha256 hex)
    assert_eq(semantic_remove(sk22), 1, "sem_remove: middle entry removed by its text");
    assert_eq(semantic_count(), sc0 + 2, "sem_remove: length shrank");
    # Order of the survivors is preserved by the compaction.
    assert_streq(load64(vec_get(_sem_entries, sc0)), "sr-11", "sem_remove: first survivor kept");
    assert_streq(load64(vec_get(_sem_entries, sc0 + 1)), "sr-33", "sem_remove: tail shifted down");
    assert_eq(semantic_remove("sr-999"), 0, "sem_remove: absent key is a no-op");
    assert_eq(semantic_count(), sc0 + 2, "sem_remove: no-op leaves length alone");
    _sem_entries = 0;
    assert_eq(semantic_remove("sr-11"), 0, "sem_remove: empty store safe");

    # ── v2.5.5 health & failover — health.cyr for real since 2.9.10 ──
    test_group("health_circuit_breaker");
    # health_start creates the record lock even with probing off (interval 0), and then starts no prober.
    health_configure(0);
    assert_eq(health_start(), 0, "health: start with probing off");
    assert_eq(_health_lock != 0 && _health_started == 0, 1, "health: lock created, no prober thread");
    # A route starts healthy: refusing traffic before the first probe would make every startup a guaranteed outage.
    var hcr = route_new(PROV_OLLAMA, 1, "http://hc-1");
    var hh = route_health(hcr);
    assert_eq(_t_health_ok(hh), 1, "health: starts optimistic");
    # One or two failures must NOT depool: a single blip is not an outage.
    assert_eq(_t_hrec(hcr, 0), 0, "health: 1 failure, no flip");
    assert_eq(_t_health_ok(hh), 1, "health: still healthy after 1");
    assert_eq(_t_hrec(hcr, 0), 0, "health: 2 failures, no flip");
    assert_eq(_t_health_ok(hh), 1, "health: still healthy after 2");
    # The third consecutive failure trips it and publishes exactly one health-changed event.
    assert_eq(_t_hrec(hcr, 0), 1, "health: 3rd failure flips, one event");
    assert_eq(route_healthy(hcr), 0, "health: now unhealthy, as router_select reads it");
    assert_eq(_t_health_fails(hh), 3, "health: failure count tracked");
    assert_streq(load64(hh + HEALTH_ERR), "probe failed", "health: the error recorded");
    var hc_ev = _t_events_recent();
    assert_eq(_t_has(hc_ev, strlen(hc_ev),
        "{\"event\":\"health_changed\",\"provider\":\"ollama\",\"base_url\":\"http://hc-1\",\"healthy\":false}]}"),
      1, "health: the event names the route, healthy false");
    # Further failures keep it down but must NOT re-fire the event.
    assert_eq(_t_hrec(hcr, 0), 0, "health: no repeat transition");
    assert_eq(_t_health_fails(hh), 4, "health: failures keep counting");
    # A single success recovers immediately and resets the counter and the error.
    var hc_t0 = clock_now_ms();
    assert_eq(_t_hrec(hcr, 1), 1, "health: success flips back, one event");
    assert_eq(_t_health_ok(hh) == 1 && _t_health_fails(hh) == 0, 1, "health: recovered, count reset");
    assert_eq(load64(hh + HEALTH_ERR), 0, "health: error cleared");
    assert_eq(load64(hh + HEALTH_CHECKED) >= hc_t0 && load64(hh + HEALTH_CHECKED) <= clock_now_ms(), 1,
      "health: last check stamped with the clock");
    hc_ev = _t_events_recent();
    assert_eq(_t_has(hc_ev, strlen(hc_ev), "\"base_url\":\"http://hc-1\",\"healthy\":true}]}"), 1,
      "health: the recovery event says healthy true");
    assert_eq(_t_hrec(hcr, 1), 0, "health: a repeat success publishes nothing");

    test_group("health_failures_must_be_consecutive");
    # Two failures, a success, then two more must NOT trip: the counter resets, so an intermittent backend is not
    # depooled by cumulative noise.
    var hi2r = route_new(PROV_VLLM, 1, "http://hc-2");
    var hi2 = route_health(hi2r);
    _t_hrec(hi2r, 0);
    _t_hrec(hi2r, 0);
    _t_hrec(hi2r, 1);
    assert_eq(_t_health_fails(hi2), 0, "health: success clears the run");
    _t_hrec(hi2r, 0);
    _t_hrec(hi2r, 0);
    assert_eq(_t_health_ok(hi2), 1, "health: 2+2 split does not trip");
    # The boundary is the real UNHEALTHY_THRESHOLD: one short stays up, reaching it goes down.
    var hb_r = route_new(PROV_LLAMACPP, 1, "http://hc-3");
    var hb_i = 0;
    while (hb_i < UNHEALTHY_THRESHOLD - 1) { _t_hrec(hb_r, 0); hb_i = hb_i + 1; }
    assert_eq(route_healthy(hb_r), 1, "health: threshold - 1 failures, still healthy");
    assert_eq(_t_hrec(hb_r, 0), 1, "health: the threshold-th failure flips");
    # Trip, recover, trip again: every transition is one event.
    hb_i = 0;
    var hb_ev = 0;
    hb_ev = hb_ev + _t_hrec(hb_r, 1);
    while (hb_i < UNHEALTHY_THRESHOLD) { hb_ev = hb_ev + _t_hrec(hb_r, 0); hb_i = hb_i + 1; }
    assert_eq(hb_ev, 2, "health: recover then trip again, two events");
    assert_eq(_t_health_fails(route_health(hb_r)), UNHEALTHY_THRESHOLD, "health: the second run counted from 0");
    # Routes are independent: tripping one leaves another alone.
    assert_eq(route_healthy(hi2r), 1, "health: another route is unaffected");
    # A route without a health record is left alone and reads healthy.
    var hn_r = route_new(PROV_OLLAMA, 1, "http://hc-4");
    store64(hn_r + ROUTE_HEALTH, 0);
    assert_eq(_t_hrec(hn_r, 0) == 0 && route_healthy(hn_r) == 1, 1, "health: no record, no change");


    # ── 2.9.15: retry.cyr for real — the backoff schedule and the retry loop over loopback ──
    test_group("retry_delay");
    var rdc = retry_config_default();
    assert_eq(retry_max(rdc) == 3 && retry_base(rdc) == 500 && retry_cap(rdc) == 30000 && retry_jitter(rdc) == 50, 1,
      "retry: defaults 3 retries, 500 ms base, 30 s cap, 50% jitter");
    # Without jitter the delay doubles from the base and stops at the cap.
    var rdn = retry_config_new_x(3, 100, 1000, 0);
    assert_eq(retry_delay_ms(rdn, 0), 100, "retry: attempt 0 waits the base");
    assert_eq(retry_delay_ms(rdn, 1), 200, "retry: attempt 1 doubles it");
    assert_eq(retry_delay_ms(rdn, 3), 800, "retry: attempt 3 is 8x");
    assert_eq(retry_delay_ms(rdn, 4), 1000, "retry: attempt 4 meets the cap");
    assert_eq(retry_delay_ms(rdn, 70), 1000, "retry: a high attempt stays at the cap (no overflow)");
    assert_eq(retry_delay_ms(retry_config_new_x(3, 5000, 1000, 0), 0), 1000, "retry: a base above the cap is capped");
    # Jitter adds 0..50% of the delay, so retries that failed together do not fire together.
    var rdj = retry_config_new_x(3, 100, 1000, 50);
    var rj_min = 1000000;
    var rj_max = 0;
    var rj_first = retry_delay_ms(rdj, 0);
    var rj_varied = 0;
    var rj_i = 0;
    while (rj_i < 300) {
        var rjd = retry_delay_ms(rdj, 0);
        if (rjd < rj_min) { rj_min = rjd; }
        if (rjd > rj_max) { rj_max = rjd; }
        if (rjd != rj_first) { rj_varied = 1; }
        rj_i = rj_i + 1;
    }
    assert_eq(rj_min >= 100 && rj_max <= 150, 1, "retry: jitter stays within delay..delay + 50%");
    assert_eq(rj_varied, 1, "retry: jitter varies");

    test_group("retry_forward");
    # Through the real provider_forward, against a loopback Ollama that counts requests. The I/O timeout drops to
    # 5 s, so an attempt that waited on a silent backend fails the suite in seconds, not minutes.
    HTTP_IO_TIMEOUT_S = 5;
    var rf_port = alloc(8);
    var rf_lfd = _t_listen(rf_port);
    var rf_p = load64(rf_port);
    var rf_saved_router = _router;
    var rf_routes = alloc(8);
    store64(rf_routes, route_new(PROV_OLLAMA, 1, _t_base_url(rf_p)));
    _router = router_new(rf_routes, 1, STRAT_PRIORITY);
    var rf_ok = _t_cat("HTTP/1.0 200 OK\r\n\r\n{\"message\":{\"role\":\"assistant\",\"content\":\"hi there\"},",
      "\"prompt_eval_count\":3,\"eval_count\":4,\"done\":true}");
    var rf = _t_retry_run(rf_lfd, rf_p, rf_ok, 2);
    assert_eq(rf != 0 && _t_ms_count == 1, 1, "retry: a success returns on the first attempt");
    assert_streq(load64(rf), "hi there", "retry: ...with the provider's text");
    assert_eq(load64(rf + 16) == 3 && load64(rf + 24) == 4, 1, "retry: ...and its token counts");
    assert_eq(_t_retry_run(rf_lfd, rf_p, "HTTP/1.0 500 Internal Server Error\r\n\r\n{}", 2), 0,
      "retry: a 5xx fails in the end");
    assert_eq(_t_ms_count, 3, "retry: ...after the first attempt and max_retries (2) more");
    _t_retry_run(rf_lfd, rf_p, "HTTP/1.0 429 Too Many Requests\r\n\r\n{}", 2);
    assert_eq(_t_ms_count, 3, "retry: a 429 is retried too");
    assert_eq(_t_retry_run(rf_lfd, rf_p, "HTTP/1.0 400 Bad Request\r\n\r\n{\"error\":\"bad\"}", 2), 0,
      "retry: a 4xx fails");
    assert_eq(_t_ms_count, 1, "retry: ...at once: a permanent error is not retried");
    _t_retry_run(rf_lfd, rf_p, "HTTP/1.0 503 Service Unavailable\r\n\r\n{}", 0);
    assert_eq(_t_ms_count, 1, "retry: max_retries 0 means one attempt");
    # The streaming path returns the backend fd once a connection is made, and -1 when every attempt fails.
    var rfs_th = _t_ms_start(rf_lfd, "HTTP/1.0 200 OK\r\n\r\n");
    var rfs_route = route_new(PROV_OLLAMA, 1, _t_base_url(rf_p));
    var rfs_msgs = "[{\"role\":\"user\",\"content\":\"hi\"}]";
    var rf_cfg = retry_config_new_x(2, 1, 4, 0);
    var rfs_fd = retry_forward_stream(rf_cfg, rfs_route, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    assert_eq(rfs_fd >= 0, 1, "retry stream: a connection returns the backend fd");
    var rfs_buf = alloc(64);
    sys_read(rfs_fd, rfs_buf, 63);
    sys_close(rfs_fd);
    _t_ms_stop_wait(rfs_th, rf_p);
    assert_eq(_t_ms_count, 1, "retry stream: one attempt when the first connects");
    # max_retries 0 still makes the one attempt.
    rfs_th = _t_ms_start(rf_lfd, "HTTP/1.0 200 OK\r\n\r\n");
    var rf_cfg0 = retry_config_new_x(0, 1, 4, 0);
    rfs_fd = retry_forward_stream(rf_cfg0, rfs_route, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    assert_eq(rfs_fd >= 0, 1, "retry stream: max_retries 0 means one attempt, not none");
    sys_read(rfs_fd, rfs_buf, 63);
    sys_close(rfs_fd);
    _t_ms_stop_wait(rfs_th, rf_p);
    # 2.10.2: a permanent refusal ends a stream's retries, as retry_forward's above, and keeps what the provider said.
    rfs_th = _t_ms_start(rf_lfd, "HTTP/1.0 404 Not Found\r\n\r\n{\"error\":\"model 'x' not found\"}");
    rfs_fd = retry_forward_stream(rf_cfg, rfs_route, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    _t_ms_stop_wait(rfs_th, rf_p);
    assert_eq(rfs_fd, 0 - 1, "retry stream: a 404 fails");
    assert_eq(_t_ms_count, 1, "retry stream: ...at once: a permanent error is not retried");
    assert_eq(provider_last_error_status(), 404, "retry stream: the provider's status is kept");
    var rfs_cm = provider_err_client_msg();
    assert_eq(_t_has(rfs_cm, strlen(rfs_cm), "not found"), 1, "retry stream: and its words");
    rfs_th = _t_ms_start(rf_lfd, "HTTP/1.0 404 Not Found\r\n\r\n{}");
    var rfs_direct = provider_forward_stream(rfs_route, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    _t_ms_stop_wait(rfs_th, rf_p);
    assert_eq(rfs_direct, FWD_PERMANENT, "stream: provider_forward_stream says permanent, as provider_forward does");
    rfs_th = _t_ms_start(rf_lfd, "HTTP/1.0 500 Internal Server Error\r\n\r\n{}");
    assert_eq(retry_forward_stream(rf_cfg, rfs_route, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0), 0 - 1,
      "retry stream: a 5xx fails in the end");
    _t_ms_stop_wait(rfs_th, rf_p);
    assert_eq(_t_ms_count, 3, "retry stream: ...after the first attempt and max_retries (2) more");
    rfs_th = _t_ms_start(rf_lfd, "HTTP/1.0 429 Too Many Requests\r\n\r\n{}");
    retry_forward_stream(rf_cfg, rfs_route, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    _t_ms_stop_wait(rfs_th, rf_p);
    assert_eq(_t_ms_count, 3, "retry stream: a 429 is retried too");
    sys_close(rf_lfd);
    var rfs_dead = route_new(PROV_OLLAMA, 1, _t_base_url(rf_p));
    # 2.10.2: the error state is per thread, and a worker's last refusal must not answer for the next request.
    provider_err_set(404, "another client's model is not found", 35);
    var rfs_dead_fd = retry_forward_stream(rf_cfg, rfs_dead, "llama3", rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    assert_eq(rfs_dead_fd, 0 - 1, "retry stream: -1 when every attempt is refused");
    assert_eq(provider_last_error_status(), 0, "stream: a failure to connect leaves no status from an earlier request");
    assert_streq(provider_err_client_msg(), "provider backend unreachable", "stream: and is reported as what it is");
    var rf_dead_r = retry_forward(rf_cfg, rfs_dead, "llama3", 0, rfs_msgs, strlen(rfs_msgs), 0, 0, 0);
    assert_eq(rf_dead_r, 0, "retry: 0 when every attempt is refused");
    _router = rf_saved_router;
    HTTP_IO_TIMEOUT_S = 300;

    test_group("health_status_str");
    # Disabled outranks unhealthy: an operator-disabled route is not a fault.
    var hs_r = route_new(PROV_OLLAMA, 1, "http://hs-1");
    assert_streq(health_status_str(hs_r), "healthy", "status: enabled + up");
    store64(route_health(hs_r) + HEALTH_OK, 0);
    assert_streq(health_status_str(hs_r), "unhealthy", "status: enabled + down");
    route_set_enabled(hs_r, 0);
    assert_streq(health_status_str(hs_r), "disabled", "status: disabled outranks down");
    store64(route_health(hs_r) + HEALTH_OK, 1);
    assert_streq(health_status_str(hs_r), "disabled", "status: disabled outranks up");

    test_group("health_probe_path");
    # Ollama serves its native API; everything OpenAI-compatible answers /v1/models.
    assert_streq(_health_probe_path(route_new(PROV_OLLAMA, 1, "http://p")), "/api/tags", "probe: ollama native path");
    assert_streq(_health_probe_path(route_new(PROV_LMSTUDIO, 1, "http://p")), "/v1/models",
      "probe: openai-compat path");
    assert_streq(_health_probe_path(route_new(PROV_ANTHROPIC, 1, "https://p")), "/v1/models", "probe: default path");

    test_group("health_probe");
    # Local routes get a real GET on their liveness path; 2xx and 3xx count as serving.
    var hp_port = alloc(8);
    var hp_lfd = _t_listen(hp_port);
    var hp_base = _t_base_url(load64(hp_port));
    var hp_ol = route_new(PROV_OLLAMA, 1, hp_base);
    var hp_vl = route_new(PROV_VLLM, 1, hp_base);
    assert_eq(_t_probe_rt(hp_lfd, hp_ol, "HTTP/1.0 200 OK\r\n\r\n{}"), 1, "probe: local 200 is up");
    assert_eq(memeq(_t_srv_req, "GET /api/tags HTTP/1.0\r\n", 24), 1, "probe: ollama gets GET /api/tags");
    assert_eq(_t_probe_rt(hp_lfd, hp_vl, "HTTP/1.0 301 Moved\r\n\r\n"), 1, "probe: a 3xx is up");
    assert_eq(memeq(_t_srv_req, "GET /v1/models HTTP/1.0\r\n", 25), 1, "probe: vllm gets GET /v1/models");
    assert_eq(_t_probe_rt(hp_lfd, hp_vl, "HTTP/1.0 404 Not Found\r\n\r\n"), 0, "probe: a 404 is down");
    assert_eq(_t_probe_rt(hp_lfd, hp_vl, "HTTP/1.0 503 Unavailable\r\n\r\n"), 0, "probe: a 503 is down");
    assert_eq(_t_probe_rt(hp_lfd, hp_vl, ""), 0, "probe: no answer is down");
    # Remote routes get a bare TCP connect: no request, no TLS, no billed API call. The listener's backlog
    # completes the handshake without an accept. The I/O timeout drops to 2 s meanwhile, so a probe that wrongly
    # sent a request and waited for the answer fails in seconds rather than hanging the suite for 300.
    HTTP_IO_TIMEOUT_S = 2;
    var hp_rbase = _t_cat("https://127.0.0.1:", _t_line("", load64(hp_port), ""));
    var hp_rem = route_new(PROV_OPENAI, 1, hp_rbase);
    assert_eq(route_is_remote(hp_rem), 1, "probe: an https route is remote");
    assert_eq(health_probe(hp_rem), 1, "probe: remote reachable by connect");
    # health_sweep folds a probe into each enabled route's record; nothing to sweep without a router.
    assert_eq(health_sweep(), 0, "sweep: no router, nothing done");
    var hp_dead = route_new(PROV_LLAMACPP, 2, "http://127.0.0.1:1");
    var hp_off = route_new(PROV_LOCALAI, 3, "http://127.0.0.1:1");
    route_set_enabled(hp_off, 0);
    var hp_rs = alloc(24);
    store64(hp_rs, hp_rem);
    store64(hp_rs + 8, hp_dead);
    store64(hp_rs + 16, hp_off);
    _router = router_new(hp_rs, 3, STRAT_PRIORITY);
    var hp_i = 0;
    while (hp_i < UNHEALTHY_THRESHOLD) { health_sweep(); hp_i = hp_i + 1; }
    assert_eq(route_healthy(hp_dead), 0, "sweep: a dead local backend is depooled after the threshold");
    assert_eq(route_healthy(hp_rem) == 1 && _t_health_fails(route_health(hp_rem)) == 0, 1,
      "sweep: the reachable remote stays healthy");
    assert_eq(_t_health_fails(route_health(hp_off)), 0, "sweep: a disabled route is not probed");
    _router = 0;
    sys_close(hp_lfd);
    # Nothing listening: both kinds of probe report down.
    assert_eq(health_probe(hp_rem), 0, "probe: remote with nothing listening is down");
    assert_eq(health_probe(hp_ol), 0, "probe: local with nothing listening is down");
    assert_eq(health_probe(route_new(PROV_OLLAMA, 1, 0)), 0, "probe: a route without a base URL is down");
    HTTP_IO_TIMEOUT_S = 300;

    # ── v2.5.6 cost accounting ──
    test_group("cost_local_is_free_first");
    # The local check must come BEFORE the model-name table. The table is keyed
    # by model NAME, and hosted-model names are routinely served locally — the
    # production lookup checked local only in its FALLBACK, so `llama-3.3-70b`
    # on Ollama matched the Groq row and billed real money for tokens generated
    # on your own GPU. Exactly the realistic cases were mispriced.
    assert_eq(estimate_cost_micro("gpt-4o", PROV_OPENAI, 1000, 500), 7500,
      "cost: remote gpt-4o priced");
    assert_eq(estimate_cost_micro("gpt-4o", PROV_LMSTUDIO, 1000, 500), 0,
      "cost: same model name served locally is free");
    assert_eq(estimate_cost_micro("claude-opus-4", PROV_OLLAMA, 1000, 500), 0,
      "cost: table-matching name on ollama is free");
    assert_eq(estimate_cost_micro("anything", PROV_LLAMACPP, 9999, 9999), 0,
      "cost: unknown model on llamacpp is free");

    test_group("cost_tracker_accumulate");
    cost_reset();
    cost_record(PROV_OPENAI, "https://api.openai.com", 1000, 500, "gpt-4o");
    cost_record(PROV_OPENAI, "https://api.openai.com", 2000, 1000, "gpt-4o");
    assert_eq(cost_record_count(), 1, "cost: same provider+url is one record");
    var c0 = cost_record_at(0);
    assert_eq(load64(c0 + 16), 3000, "cost: input tokens accumulate");
    assert_eq(load64(c0 + 24), 1500, "cost: output tokens accumulate");
    assert_eq(load64(c0 + 40), 2, "cost: request count accumulates");
    assert_eq(load64(c0 + 32), 22500, "cost: spend accumulates");

    test_group("cost_tracker_keying");
    # Same provider TYPE at a different base_url is a separate record — two
    # OpenAI-compatible endpoints are two bills.
    cost_record(PROV_OPENAI, "https://other.example.com", 1000, 0, "gpt-4o");
    assert_eq(cost_record_count(), 2, "cost: different base_url is a new record");
    # A different provider is likewise separate.
    cost_record(PROV_ANTHROPIC, "https://api.anthropic.com", 1000, 500, "claude-opus-4");
    assert_eq(cost_record_count(), 3, "cost: different provider is a new record");
    # The grand total is the sum across records.
    assert_eq(cost_total_micro(), 22500 + 2500 + 52500, "cost: total sums all records");
    # A local route contributes records but no spend.
    cost_record(PROV_OLLAMA, "http://localhost:11434", 5000, 5000, "llama3");
    assert_eq(cost_record_count(), 4, "cost: local route still tracked");
    assert_eq(cost_total_micro(), 22500 + 2500 + 52500, "cost: local adds no spend");
    assert_eq(load64(cost_record_at(3) + 16), 5000, "cost: local tokens still counted");

    # ── v2.5.7 config-reader closeout ──
    test_group("context_token_limit");
    # The compaction budget derives from the MODEL's context window x threshold. The old `est_tokens * 2` keyed off
    # the requested OUTPUT size, which says nothing about how much input the model accepts, so a 200k-context model
    # was compacted as hard as an 8k one. The real context_token_limit (compact.cyr) since 2.9.12; this group did
    # the multiplication itself before.
    context_configure(1, 80, 0 - 1);
    assert_eq(context_token_limit(200000), 160000, "context: 200k window at 0.8");
    assert_eq(context_token_limit(8192), 6553, "context: 8k window at 0.8");
    assert_eq(context_token_limit(0), 0, "context: an unknown window gives no limit");
    context_configure(1, 50, 0 - 1);
    assert_eq(context_token_limit(128000), 64000, "context: threshold is configurable");
    context_configure(1, 80, 0 - 1);

    test_group("cli_flag_parsing");
    # `hoosh serve --port 9000 --bind 0.0.0.0`
    var fa = vec_new();
    vec_push(fa, "hoosh"); vec_push(fa, "serve");
    vec_push(fa, "--port"); vec_push(fa, "9000");
    vec_push(fa, "--bind"); vec_push(fa, "0.0.0.0");
    assert_streq(cli_flag_val(fa, "--port", "-p"), "9000", "flag: --port value");
    assert_streq(cli_flag_val(fa, "--bind", 0), "0.0.0.0", "flag: --bind value");
    assert_eq(cli_flag_val(fa, "--config", "-c"), 0, "flag: absent flag -> 0");
    # Short form.
    var fs = vec_new();
    vec_push(fs, "hoosh"); vec_push(fs, "serve"); vec_push(fs, "-p"); vec_push(fs, "8080");
    assert_streq(cli_flag_val(fs, "--port", "-p"), "8080", "flag: short -p value");
    # --name=value form.
    var fe = vec_new();
    vec_push(fe, "hoosh"); vec_push(fe, "serve"); vec_push(fe, "--port=7000");
    assert_streq(cli_flag_val(fe, "--port", "-p"), "7000", "flag: --port=value form");
    # A flag at the very end with no value must not read past argv.
    var ft = vec_new();
    vec_push(ft, "hoosh"); vec_push(ft, "serve"); vec_push(ft, "--port");
    assert_eq(cli_flag_val(ft, "--port", "-p"), 0, "flag: dangling flag -> 0");
    # A longer flag that starts with the name is another flag, not `--port=...`.
    var fl = vec_new();
    vec_push(fl, "hoosh"); vec_push(fl, "serve"); vec_push(fl, "--portal"); vec_push(fl, "x");
    assert_eq(cli_flag_val(fl, "--port", "-p"), 0, "flag: --portal is not --port");

    test_group("cli_positionals");
    # `hoosh infer --server URL --stream MODEL PROMPT` — positionals must skip
    # both the flag AND its value, but --stream takes no value.
    var pa = vec_new();
    vec_push(pa, "hoosh"); vec_push(pa, "infer");
    vec_push(pa, "--server"); vec_push(pa, "http://h:8088");
    vec_push(pa, "--stream");
    vec_push(pa, "llama3"); vec_push(pa, "hello world");
    assert_streq(cli_positional(pa, 0), "llama3", "pos: model after flags");
    assert_streq(cli_positional(pa, 1), "hello world", "pos: prompt after flags");
    assert_eq(cli_positional(pa, 2), 0, "pos: third positional absent");
    assert_streq(cli_flag_val(pa, "--server", 0), "http://h:8088", "pos: --server still parsed");
    # A bare positional port keeps working (`hoosh serve 8088`, pre-2.5.8 form).
    var pb = vec_new();
    vec_push(pb, "hoosh"); vec_push(pb, "serve"); vec_push(pb, "8088");
    assert_streq(cli_positional(pb, 0), "8088", "pos: bare positional port");
    # --name=value must NOT swallow the next argument as its value.
    var pc = vec_new();
    vec_push(pc, "hoosh"); vec_push(pc, "infer"); vec_push(pc, "--server=http://h");
    vec_push(pc, "m"); vec_push(pc, "p");
    assert_streq(cli_positional(pc, 0), "m", "pos: --name=value does not eat a positional");
    assert_streq(cli_positional(pc, 1), "p", "pos: second positional intact");
    # 2.9.19: cli_flag_set (no copy existed) and cli_args, which hands main.cyr's wrappers the process's argv.
    assert_eq(cli_flag_set(pa, "--stream"), 1, "flag set: a valueless flag is seen");
    assert_eq(cli_flag_set(pa, "--json"), 0, "flag set: an absent one is not");
    assert_eq(cli_flag_set(pb, "serve"), 1, "flag set: matches any argument after the program name");
    var pd = vec_new();
    vec_push(pd, "--stream");
    assert_eq(cli_flag_set(pd, "--stream"), 0, "flag set: argument 0 is the program, never a flag");
    args_init();   # as main() does at startup; argc()/argv() read nothing before it
    var pargs = cli_args();
    assert_eq(vec_len(pargs) >= 1 && vec_len(pargs) == argc(), 1, "cli_args: one element per argument");
    assert_streq(vec_get(pargs, 0), argv(0), "cli_args: element 0 is the program");
    assert_eq(cli_args(), pargs, "cli_args: built once");

    test_group("hardware_disabled_backends");
    # disabled_backends clears one bit per named backend; everything else keeps probing. Every backend ai-hwaccel
    # has is enabled by default, and every one is reachable by its name. (The copy this replaced counted 17
    # backends; ai-hwaccel has 18 since agnos-gpu.)
    var hbk = 0;
    var hb_ok = 0;
    while (hbk < AIHW_BACKEND_COUNT) {
        if (builder_is_enabled(builder_all(), hbk) == 1 && _hw_backend_from_name(backend_name(hbk)) == hbk) {
            hb_ok = hb_ok + 1;
        }
        hbk = hbk + 1;
    }
    assert_eq(hb_ok, AIHW_BACKEND_COUNT, "hw: every backend enabled by default and found by name");
    assert_eq(_hw_backend_from_name("quantum"), 0 - 1, "hw: an unknown name maps to no backend");
    var hnames = alloc(24);
    store64(hnames, "cuda");
    store64(hnames + 8, "vulkan");
    store64(hnames + 16, "quantum");
    var hmask = hardware_configure_backends(hnames, 3);
    assert_eq(builder_is_enabled(hmask, BACKEND_CUDA), 0, "hw: cuda disabled");
    assert_eq(builder_is_enabled(hmask, BACKEND_VULKAN), 0, "hw: vulkan disabled");
    assert_eq(builder_is_enabled(hmask, BACKEND_ROCM), 1, "hw: rocm untouched");
    assert_eq(builder_is_enabled(hmask, BACKEND_APPLE), 1, "hw: apple untouched");
    assert_eq(hmask, builder_all() - (1 << BACKEND_CUDA) - (1 << BACKEND_VULKAN),
      "hw: exactly two bits cleared; the unknown name is ignored");
    assert_eq(_hw_builder_mask, hmask, "hw: detection uses the configured mask");
    # Naming a backend twice disables it, it does not toggle it back on.
    store64(hnames + 8, "cuda");
    hmask = hardware_configure_backends(hnames, 2);
    assert_eq(builder_is_enabled(hmask, BACKEND_CUDA), 0, "hw: disable is idempotent");
    _hw_builder_mask = 0 - 1;

    test_group("hardware_unknown_sentinel");
    # ai-hwaccel reports -1 for "the driver did not tell us". Subtracting that
    # from a VRAM total ADDS a byte, and emitting it as JSON makes a consumer
    # graph a spike at minus one. Unknown must read as 0 for arithmetic and
    # null on the wire.
    var s9_known = profile_cuda(0, 25769803776);
    profile_set_mem_used(s9_known, 180809728);
    var s9_unknown = profile_cuda(1, 25769803776);
    var s9_devs = vec_new();
    vec_push(s9_devs, profile_cpu(68719476736));
    vec_push(s9_devs, s9_known);
    vec_push(s9_devs, s9_unknown);
    assert_eq(profile_mem_used(s9_unknown), 0 - 1, "sentinel: ai-hwaccel's unknown is -1");
    _hw_registry = registry_from_profiles(s9_devs);
    assert_eq(hw_available_vram(), 51539607552 - 180809728, "sentinel: -1 contributes 0, not -1");
    var s9_tel = _t_hw_json(1);
    assert_eq(_t_has(s9_tel, strlen(s9_tel), "\"memory_used_bytes\":180809728,"), 1, "sentinel: a known value is sent");
    assert_eq(_t_has(s9_tel, strlen(s9_tel), "\"memory_used_bytes\":null,"), 1,
      "sentinel: unknown is null on the wire");
    assert_eq(_t_has(s9_tel, strlen(s9_tel), "-1"), 0, "sentinel: no -1 anywhere in the telemetry");
    _hw_registry = 0;

    test_group("hardware_simulate_fits");
    # `fits` is an ACCELERATOR question. Folding system RAM into the total made a 70B model "fit" a box with
    # 7.5 GB of VRAM and 64 GB of RAM. Through the real POST /v1/hardware/simulate writer (2.9.9).
    var s9_need70 = reg_estimate_memory(70000000000, QUANT_INT4);
    assert_eq(s9_need70, 42000000000, "sim: 70B at INT4 needs 42 GB, overhead included");
    var s9_box = vec_new();
    vec_push(s9_box, profile_cpu(64165371904));
    vec_push(s9_box, profile_cuda(0, 7516192768));
    _hw_registry = registry_from_profiles(s9_box);
    var s9_add = vec_new();
    vec_push(s9_add, 25769803776);
    vec_push(s9_add, 25769803776);
    var s9_sb = str_builder_new();
    hw_simulate_json(s9_sb, 70000000000, QUANT_INT4, 0, s9_add);
    var s9_js = str_data(str_builder_build(s9_sb));
    var s9_cut = _t_find(s9_js, "\"simulated\":");
    assert_eq(s9_cut > 0, 1, "sim: original, then simulated");
    var s9_sim = s9_js + s9_cut;
    assert_eq(_t_json_int(s9_js, "accelerator_memory_bytes"), 7516192768, "sim: original accelerator memory");
    assert_eq(_t_json_int(s9_js, "system_memory_bytes"), 64165371904, "sim: system RAM reported apart");
    assert_eq(_t_has(s9_js, s9_cut, "\"fits\":false"), 1, "sim: 70B does not fit 7.5 GB of VRAM, RAM or not");
    assert_eq(_t_json_int(s9_js, "shards_required"), 0, "sim: no shards for what does not fit");
    assert_eq(_t_json_int(s9_sim, "accelerator_count"), 3, "sim: two cards added to the one");
    assert_eq(_t_has(s9_sim, strlen(s9_sim), "\"fits\":true"), 1, "sim: fits after adding two 24 GiB cards");
    assert_eq(_t_json_int(s9_sim, "shards_required"), 2, "sim: on the two new cards, not all three");
    assert_eq(_t_json_int(s9_js, "added_devices"), 2, "sim: added_devices echoed");
    # remove_count drains accelerators, never the CPU.
    s9_sb = str_builder_new();
    hw_simulate_json(s9_sb, 70000000000, QUANT_INT4, 1, vec_new());
    s9_js = str_data(str_builder_build(s9_sb));
    s9_sim = s9_js + _t_find(s9_js, "\"simulated\":");
    assert_eq(_t_json_int(s9_sim, "device_count"), 1, "sim: removing one leaves the CPU");
    assert_eq(_t_json_int(s9_sim, "accelerator_count"), 0, "sim: ...and no accelerator");
    assert_eq(_t_json_int(s9_sim, "system_memory_bytes"), 64165371904, "sim: the CPU's RAM is still counted");
    _hw_registry = 0;

    test_group("hardware_simulate_shards");
    # Shards are counted LARGEST-FIRST: a planner packs the biggest cards, so counting in registry order overstated
    # the span (4 devices when the two new 24 GiB cards alone suffice). The real _sim_shards since 2.9.9; the inline
    # copy here predated the shared-RAM pool.
    var s9_sv = vec_new();
    vec_push(s9_sv, _t_prof(0, 1, 3221225472, 0));     # 3 GiB
    vec_push(s9_sv, _t_prof(0, 1, 4294967296, 0));     # 4 GiB
    vec_push(s9_sv, _t_prof(0, 1, 25769803776, 0));    # 24 GiB
    vec_push(s9_sv, _t_prof(0, 1, 25769803776, 0));    # 24 GiB
    assert_eq(_sim_shards(s9_sv, s9_need70, 0), 2, "sim: 70B spans the two 24GiB cards, not all four");
    assert_eq(3221225472 + 4294967296 + 25769803776 < s9_need70, 1, "sim: registry order would need all four");
    assert_eq(_sim_shards(s9_sv, 25769803776, 0), 1, "sim: one card's worth packs onto one card");
    assert_eq(_sim_shards(s9_sv, 59055800320, 0), 4, "sim: exactly the total takes every card");
    assert_eq(_sim_shards(s9_sv, 59055800321, 0), 0, "sim: one byte over the total does not pack");

    test_group("hardware_simulate_shared_memory");
    # 2.6.12: _sim_snapshot counts shared system RAM once, like ai-hwaccel's
    # reg_total_accel_memory. A 48 GiB Apple M5 Pro reports the CPU, the Metal GPU
    # and the Neural Engine, and all three are the same RAM. The per-device sum
    # made that 52 GiB of accelerator memory.
    var shg = 1073741824;
    var sha = vec_new();
    vec_push(sha, _t_prof(1, 1, 48 * shg, 48 * shg));   # CPU
    vec_push(sha, _t_prof(0, 1, 48 * shg, 48 * shg));   # Metal GPU
    vec_push(sha, _t_prof(0, 1, 4 * shg, 4 * shg));     # Neural Engine
    assert_eq(_t_sim_total(sha, 0), 48 * shg, "sim shared: Apple accelerators hold the 48 GiB once");
    assert_eq(_t_sim_total(sha, 0), _t_reg_accel(sha),
      "sim shared: Apple total matches reg_total_accel_memory");
    assert_eq(_t_sim_total(sha, 1), 48 * shg, "sim shared: system RAM counted once");
    # The old sum said 52 GiB, so a 50 GiB model "fit".
    var sh_need50 = 50 * shg;
    assert_eq(sh_need50 <= 48 * shg + 4 * shg, 1, "sim shared: the per-device sum said 50 GiB fits");
    assert_eq(sh_need50 <= _t_sim_total(sha, 0), 0, "sim shared: 50 GiB does not fit 48 GiB of RAM");
    assert_eq(_sim_shards(sha, 40 * shg, _t_sim_pool(sha)), 1, "sim shared: 40 GiB packs onto the GPU");
    assert_eq(_sim_shards(sha, sh_need50, _t_sim_pool(sha)), 0, "sim shared: 50 GiB does not pack");

    # Intel Core Ultra laptop with an 8 GiB NVIDIA card. The Vulkan iGPU's 16 GiB
    # heap and the NPU's 2 GiB are both system RAM; the card's memory is its own.
    var shl = vec_new();
    vec_push(shl, _t_prof(1, 1, 32 * shg, 32 * shg));   # CPU
    vec_push(shl, _t_prof(0, 1, 8 * shg, 0));           # CUDA card
    vec_push(shl, _t_prof(0, 1, 16 * shg, 16 * shg));   # Vulkan iGPU
    vec_push(shl, _t_prof(0, 1, 2 * shg, 2 * shg));     # Intel NPU
    assert_eq(_t_sim_total(shl, 0), 24 * shg, "sim shared: dedicated 8 GiB + the 16 GiB pool once");
    assert_eq(_t_sim_total(shl, 0), _t_reg_accel(shl),
      "sim shared: laptop total matches reg_total_accel_memory");
    assert_eq(_t_sim_total(shl, 1), 32 * shg, "sim shared: laptop system RAM");

    # GH200: 96 GiB of HBM plus the Grace CPU's 480 GiB, which is marked shared.
    var shh = vec_new();
    vec_push(shh, _t_prof(1, 1, 480 * shg, 480 * shg));
    vec_push(shh, _t_prof(0, 1, 576 * shg, 480 * shg));
    assert_eq(_t_sim_total(shh, 0), 576 * shg, "sim shared: GH200 keeps HBM + Grace memory");
    assert_eq(_t_sim_total(shh, 0), _t_reg_accel(shh), "sim shared: GH200 matches");

    # Discrete cards share nothing, so the total is the plain sum it always was.
    var shd = vec_new();
    vec_push(shd, _t_prof(1, 1, 64 * shg, 64 * shg));
    vec_push(shd, _t_prof(0, 1, 3 * shg, 0));
    vec_push(shd, _t_prof(0, 1, 4 * shg, 0));
    vec_push(shd, _t_prof(0, 1, 24 * shg, 0));
    vec_push(shd, _t_prof(0, 1, 24 * shg, 0));
    assert_eq(_t_sim_total(shd, 0), 55 * shg, "sim shared: discrete-only total is the plain sum");
    assert_eq(_t_sim_total(shd, 0), _t_reg_accel(shd), "sim shared: discrete matches");
    assert_eq(_sim_shards(shd, s9_need70, 0), 2, "sim shared: 70B still spans the two 24 GiB cards");

    # Unavailable profiles are skipped, as ai-hwaccel's totals skip them. An 80 GiB
    # card that cannot run anything is not capacity.
    var shu = vec_new();
    vec_push(shu, _t_prof(1, 1, 64 * shg, 64 * shg));
    vec_push(shu, _t_prof(0, 1, 8 * shg, 0));
    vec_push(shu, _t_prof(0, 0, 80 * shg, 0));
    assert_eq(_t_sim_total(shu, 0), 8 * shg, "sim shared: unavailable card adds nothing");
    assert_eq(_t_sim_total(shu, 0), _t_reg_accel(shu), "sim shared: unavailable matches");
    assert_eq(_sim_shards(shu, 9 * shg, _t_sim_pool(shu)), 0, "sim shared: unavailable card not packed");

    # The clamp: shared_mem above memory_bytes counts as all of it, below 0 as none.
    assert_eq(_sim_shared_part(_t_prof(0, 1, 8 * shg, 20 * shg)), 8 * shg, "sim shared: part clamps to memory");
    assert_eq(_sim_shared_part(_t_prof(0, 1, 4 * shg, 0 - 5)), 0, "sim shared: negative part floors at 0");
    var shc = vec_new();
    vec_push(shc, _t_prof(0, 1, 8 * shg, 20 * shg));
    vec_push(shc, _t_prof(0, 1, 4 * shg, 0 - 5));
    assert_eq(_t_sim_total(shc, 0), _t_reg_accel(shc), "sim shared: clamped totals match");

    # _sim_shards spends the pool once. Two hypothetical 2 GiB cards on the Apple
    # box make 52 GiB, and a 52 GiB model needs the GPU and both cards. The old
    # loop took the GPU (48) and then the Neural Engine (4), RAM the GPU already
    # covers, and reported 2.
    var sha2 = vec_new();
    vec_push(sha2, _t_prof(1, 1, 48 * shg, 48 * shg));
    vec_push(sha2, _t_prof(0, 1, 48 * shg, 48 * shg));
    vec_push(sha2, _t_prof(0, 1, 4 * shg, 4 * shg));
    vec_push(sha2, _t_prof(0, 1, 2 * shg, 0));   # added cards share nothing
    vec_push(sha2, _t_prof(0, 1, 2 * shg, 0));
    var sh_t2 = _t_sim_total(sha2, 0);
    assert_eq(sh_t2, 52 * shg, "sim shared: Apple + two 2 GiB cards = 52 GiB");
    assert_eq(_sim_shards(sha2, 52 * shg, _t_sim_pool(sha2)), 3, "sim shared: 52 GiB spans GPU + both cards");
    assert_eq(48 * shg + 4 * shg >= 52 * shg, 1, "sim shared: the old loop 'held' it on GPU + NE");
    # With both on one accounting, `fits` and packing agree at the boundary.
    assert_eq(_sim_shards(sha2, sh_t2, _t_sim_pool(sha2)) > 0, 1, "sim shared: need == total packs");
    assert_eq(_sim_shards(sha2, sh_t2 + 1, _t_sim_pool(sha2)), 0, "sim shared: one byte over does not");
    assert_eq(_sim_shards(shl, 24 * shg, _t_sim_pool(shl)), 2, "sim shared: laptop total packs iGPU + card");
    # _t_sim_pool is the pool _sim_snapshot computes for itself: the snapshot's own shards_required agrees.
    assert_eq(_t_json_int(_t_sim_json(sha, 70000000000, QUANT_INT4), "shards_required"), 1,
      "sim shared: the snapshot packs 70B INT4 onto the Apple GPU");
    assert_eq(_sim_shards(sha, s9_need70, _t_sim_pool(sha)), 1, "sim shared: ...as _sim_shards over the pool does");
    assert_eq(_t_json_int(_t_sim_json(shl, 30000000000, QUANT_INT4), "shards_required"), 2,
      "sim shared: the snapshot packs 18 GB onto the laptop's iGPU + card");
    assert_eq(_sim_shards(shl, reg_estimate_memory(30000000000, QUANT_INT4), _t_sim_pool(shl)), 2,
      "sim shared: ...as _sim_shards over the pool does");

    # Why _sim_profiles pins an added card's shared_mem to 0: marked shared, a
    # 24 GiB card would fold into the 48 GiB pool and add nothing.
    var sha3 = vec_new();
    vec_push(sha3, _t_prof(0, 1, 48 * shg, 48 * shg));
    vec_push(sha3, _t_prof(0, 1, 24 * shg, 0));
    assert_eq(_t_sim_total(sha3, 0), 72 * shg, "sim shared: an added card adds its memory");
    profile_set_shared_mem(vec_get(sha3, 1), 24 * shg);
    assert_eq(_t_sim_total(sha3, 0), 48 * shg, "sim shared: a shared added card would vanish");

    test_group("hardware_whole_number_inputs");
    # 2.6.13: _hw_whole_bounded and _hw_json_whole replace str_to_int and the raw
    # digit loop for model_params, model_params_m and add_devices' memory_bytes.
    var wc = SIM_MAX_DEVICE_BYTES;
    assert_eq(_t_whole("25769803776", wc), 25769803776, "whole: a 24 GiB card parses");
    assert_eq(_t_whole("72057594037927936", wc), wc, "whole: the cap itself is accepted");
    assert_eq(_t_whole("72057594037927937", wc), 0 - 2, "whole: one past the cap is out of range");
    assert_eq(_t_whole("9223372036854775807", wc), 0 - 2, "whole: i64 max is out of range");
    assert_eq(_t_whole("18446744073709551615", wc), 0 - 2, "whole: 2^64-1 is out of range");
    assert_eq(_t_whole("99999999999999999999999999", wc), 0 - 2, "whole: 26 digits never wrap");
    # The old arithmetic: 2^64-1 became -1, which passed the `v == 0` check, and
    # str_to_int turned 2^64+1 into 1.
    assert_eq(_t_naive_digits("18446744073709551615"), 0 - 1, "whole: the old loop made 2^64-1 into -1");
    assert_eq(_t_naive_digits("18446744073709551617"), 1, "whole: str_to_int made 2^64+1 into 1");
    # The check runs before the multiply, so even a cap of i64 max cannot wrap.
    var wmax = 9223372036854775807;
    assert_eq(_t_whole("9223372036854775807", wmax), wmax, "whole: i64 max under an i64 cap");
    assert_eq(_t_whole("9223372036854775808", wmax), 0 - 2, "whole: one past i64 max is refused");
    # Not whole numbers: signs, exponents, real fractions, junk, nothing.
    assert_eq(_t_whole("-5", wc), 0 - 1, "whole: a sign is refused");
    assert_eq(_t_whole("7e9", wc), 0 - 1, "whole: an exponent is refused");
    assert_eq(_t_naive_digits("7e9"), 79, "whole: str_to_int read 7e9 as 79");
    assert_eq(_t_whole("7.5", wc), 0 - 1, "whole: a real fraction is refused");
    assert_eq(_t_whole("7.", wc), 0 - 1, "whole: a bare point is refused");
    assert_eq(_t_whole("12abc", wc), 0 - 1, "whole: trailing junk is refused");
    assert_eq(_t_whole("", wc), 0 - 1, "whole: no digits is refused");
    # A zero fraction is the same whole number. Python's json.dumps writes 7e9 as
    # 7000000000.0, which str_to_int read as 7e10.
    assert_eq(_t_whole("7000000000.0", wc), 7000000000, "whole: 7000000000.0 is 7e9");
    assert_eq(_t_naive_digits("7000000000.0"), 70000000000, "whole: str_to_int read it as 7e10");
    assert_eq(_t_whole("24000000000.000", wc), 24000000000, "whole: any run of zeros");
    # json_get values: blanks trimmed; absent, empty and null read as 0.
    assert_eq(_hw_json_whole(str_from(" 7000000000\r"), wc), 7000000000, "whole: CR after a bare value");
    assert_eq(_hw_json_whole(str_from("7000000000\t"), wc), 7000000000, "whole: tab after a bare value");
    assert_eq(_hw_json_whole(str_from("null"), wc), 0, "whole: null is not given");
    assert_eq(_hw_json_whole(str_from("  "), wc), 0, "whole: blank is not given");
    assert_eq(_hw_json_whole(0, wc), 0, "whole: absent is not given");
    assert_eq(_hw_json_whole(str_from("\"7\""), wc), 0 - 1, "whole: stray quotes are refused");
    # handle_hw_simulate's add_devices sizes take the whole number, so 1.5e9 is refused rather than read as a 1 byte
    # card. 2.9.22: reqparse.cyr's own _hw_add_devices over whole bodies (a copy of its token loop stood here).
    var adv = vec_new();
    var adb = "{\"model_params\":7,\"add_devices\":[{\"memory_bytes\": 25769803776},{\"memory_bytes\":24000000000.0}]}";
    assert_eq(_hw_add_devices(adb, strlen(adb), adv), 2, "devices: two sizes read");
    assert_eq(vec_get(adv, 0), 25769803776, "devices: a space after the colon is skipped; the token ends at }");
    assert_eq(vec_get(adv, 1), 24000000000, "devices: 24000000000.0 is 24 GB");
    var adc = "{\"add_devices\":[{\"memory_bytes\":1000,\"name\":\"a\"}]}";
    assert_eq(_hw_add_devices(adc, strlen(adc), vec_new()), 1, "devices: the token ends at a comma");
    var ad15 = "{\"add_devices\":[{\"memory_bytes\":1.5e9}]}";
    assert_eq(_hw_add_devices(ad15, strlen(ad15), vec_new()), 0 - 1, "devices: 1.5e9 is refused");
    var adq = "{\"add_devices\":[{\"memory_bytes\":\"24\"}]}";
    assert_eq(_hw_add_devices(adq, strlen(adq), vec_new()), 0 - 1, "devices: a quoted size is refused");
    var adbig = "{\"add_devices\":[{\"memory_bytes\":72057594037927937}]}";
    assert_eq(_hw_add_devices(adbig, strlen(adbig), vec_new()), 0 - 2, "devices: one past SIM_MAX_DEVICE_BYTES");
    var adz = "{\"add_devices\":[{\"memory_bytes\":8},{\"memory_bytes\":0}]}";
    assert_eq(_hw_add_devices(adz, strlen(adz), vec_new()), 0 - 3, "devices: a 0-byte device is refused");
    assert_eq(_hw_add_devices("{\"model_params\":7}", 18, vec_new()), 0, "devices: no add_devices, none added");
    var ad64 = str_builder_new();
    str_builder_add_cstr(ad64, "{\"add_devices\":[");
    var adi = 0;
    while (adi < 65) {
        if (adi > 0) { str_builder_add_cstr(ad64, ","); }
        str_builder_add_cstr(ad64, "{\"memory_bytes\":1024}");
        adi = adi + 1;
    }
    str_builder_add_cstr(ad64, "]}");
    var ad65s = str_builder_build(ad64);
    assert_eq(_hw_add_devices(str_data(ad65s), str_len(ad65s), vec_new()), 0 - 4, "devices: 65 is one too many");
    var ad64v = vec_new();
    assert_eq(_hw_add_devices(str_data(ad65s), str_len(ad65s) - 24, ad64v), 64, "devices: 64 is the limit");

    test_group("hardware_planner_caps");
    # SIM_MAX_DEVICE_BYTES: 64 added cards at the cap total 2^62, which leaves 2^62
    # of headroom for the detected devices before the snapshot totals could wrap.
    assert_eq(64 * SIM_MAX_DEVICE_BYTES, 4611686018427387904, "caps: 64 cards at the cap = 2^62");
    assert_eq(64 * SIM_MAX_DEVICE_BYTES + 4611686018427387903 > 0, 1, "caps: + 2^62-1 more does not wrap");
    # The old failure: two 9e18 cards parsed but summed to a negative total.
    assert_eq(9000000000000000000 + 9000000000000000000 < 0, 1, "caps: two 9e18 cards wrapped negative");
    # HW_MAX_MODEL_PARAMS, against ai-hwaccel's real estimators (2.9.9; the copies here were older versions). At the
    # cap the estimates are exact.
    assert_eq(reg_estimate_memory(HW_MAX_MODEL_PARAMS, QUANT_NONE), 480000000000000, "caps: fp32 estimate at the cap");
    var tcap = estimate_training_memory(HW_MAX_MODEL_PARAMS / 1000000, TRAIN_DPO, TARGET_GPU);
    assert_eq(est_total_x1000(tcap), 1956150000, "caps: training's largest total at the cap, GiB x1000");
    assert_eq(_t_train_bytes(HW_MAX_MODEL_PARAMS / 1000000), 2100400069017600, "caps: ...in bytes");
    # The placement estimate no longer wraps past the cap: ai-hwaccel saturates it. 3e18 at FP16 used to go negative.
    assert_eq(reg_estimate_memory(3000000000000000000, QUANT_FP16), 7200000000000000000, "caps: 3e18 fp16 is exact");
    assert_eq(reg_estimate_memory(9000000000000000000, QUANT_NONE), HW_I64_MAX, "caps: past i64 it saturates");
    # Training still wraps, but far past the cap: GPU DPO/RLHF totals 10.5x its base (the AdamW optimizer alone is
    # 7x), and the bytes stay exact to about 4.4e11 M params, over 4000 times the cap.
    assert_eq(_t_train_bytes(400000000000) > 0, 1, "caps: training bytes exact at 4e11 M params");
    assert_eq(_t_train_bytes(500000000000) < 0, 1, "caps: training bytes wrap by 5e11 M params");
    assert_eq(est_total_x1000(estimate_training_memory(9000000000000000, TRAIN_DPO, TARGET_GPU)) < 0, 1,
      "caps: 9e15 M params wraps the training base");

    test_group("hardware_requirement_snapshot");
    # 2.9.21: hardware.cyr's own hw_requirement_find, over real registries (a copy scanned a vec of device kinds).
    var rq_cpu = profile_cpu(68719476736);
    var rq_gpu0 = profile_cuda(0, 25769803776);
    var rq_gpu1 = profile_cuda(1, 85899345920);
    var rq_tpu = profile_tpu(0, 4, TPU_V5E);
    var rqd = vec_new();
    vec_push(rqd, rq_cpu);
    vec_push(rqd, rq_gpu0);
    vec_push(rqd, rq_gpu1);
    vec_push(rqd, rq_tpu);
    var rqa = registry_from_profiles(rqd);
    assert_eq(hw_requirement_find(rqa, REQ_GPU, 1), rq_gpu0, "req: the first GPU satisfies gpu");
    assert_eq(hw_requirement_find(rqa, REQ_NONE, 1), rq_cpu, "req: none is met by the first device, the CPU");
    assert_eq(hw_requirement_find(rqa, REQ_TPU, 4), rq_tpu, "req: a 4-chip TPU meets tpu with min_chips 4");
    assert_eq(hw_requirement_find(rqa, REQ_TPU, 8), 0, "req: but not min_chips 8");
    assert_eq(hw_requirement_find(rqa, REQ_GAUDI, 1), 0, "req: no Gaudi, no match");
    assert_eq(hw_requirement_find(0, REQ_NONE, 1), 0, "req: no registry (not detected), no match");
    # An unavailable device is passed over for the next one that qualifies.
    profile_set_available(rq_gpu0, 0);
    assert_eq(hw_requirement_find(rqa, REQ_GPU, 1), rq_gpu1, "req: an unavailable GPU is skipped");
    profile_set_available(rq_gpu0, 1);
    # 2.6.13: the scan reads only the registry it is handed. A refresh swaps _hw_registry mid-request, and through
    # 2.6.12 the count and the profiles came from separate loads of it, so a smaller registry swapped in between
    # made vec_get index past its end and exit the worker. Here _hw_registry is a one-CPU registry for the call.
    var rq_saved = _hw_registry;
    var rqc = vec_new();
    vec_push(rqc, profile_cpu(68719476736));
    _hw_registry = registry_from_profiles(rqc);
    assert_eq(hw_requirement_find(rqa, REQ_GPU, 1), rq_gpu0, "req snapshot: answers from the registry it was given");
    assert_eq(hw_requirement_find(rqa, REQ_TPU, 1), rq_tpu, "req snapshot: and scans all of it");
    _hw_registry = rq_saved;

    # ── 2.7.0: the rest of rust-old ──
    test_group("rustold_config_cli");
    # [[providers]] rate_limit_rpm is rust-old's (and ADR 004's) key; it used to be
    # ignored, so a carried-over config ran with no limit. rate_limit wins if both.
    # 2.9.18: the real _config_rate_limit_str, on a real [[providers]] block (a copy chose between two numbers).
    assert_streq(to_cstr(_config_rate_limit_str(_t_pp("[[providers]]\nrate_limit_rpm = 60\n"))), "60",
      "cfg: rate_limit_rpm alone is read");
    var rl_both = _t_pp("[[providers]]\nrate_limit = 600\nrate_limit_rpm = 60\n");
    assert_streq(to_cstr(_config_rate_limit_str(rl_both)), "600", "cfg: rate_limit wins over rate_limit_rpm");
    var rl_none = _t_pp("[[providers]]\ntype = \"openai\"\n");
    assert_eq(_config_rate_limit_str(rl_none), 0, "cfg: neither set means no limit");
    # `hoosh infer -m llama3 "hi"` is rust-old's form; -m used to swallow the model.
    var ia = alloc(16);
    var iv = vec_new();
    vec_push(iv, "hoosh"); vec_push(iv, "infer"); vec_push(iv, "-m"); vec_push(iv, "llama3"); vec_push(iv, "hi");
    assert_eq(cli_positional(iv, 1), 0, "infer: before 2.7.0 -m left no prompt");
    cli_infer_args(iv, ia);
    assert_streq(load64(ia), "llama3", "infer: -m names the model");
    assert_streq(load64(ia + 8), "hi", "infer: prompt is the positional");
    var iv2 = vec_new();
    vec_push(iv2, "hoosh"); vec_push(iv2, "infer"); vec_push(iv2, "--model=qwen3"); vec_push(iv2, "yo");
    cli_infer_args(iv2, ia);
    assert_streq(load64(ia), "qwen3", "infer: --model=value form");
    assert_streq(load64(ia + 8), "yo", "infer: prompt after --model=value");
    var iv3 = vec_new();
    vec_push(iv3, "hoosh"); vec_push(iv3, "infer"); vec_push(iv3, "--stream"); vec_push(iv3, "phi3"); vec_push(iv3, "q");
    cli_infer_args(iv3, ia);
    assert_streq(load64(ia), "phi3", "infer: positional form unchanged");
    assert_streq(load64(ia + 8), "q", "infer: positional prompt unchanged");

    test_group("rustold_health_metrics");
    # /v1/health carries version and providers_configured (rust-old's conformance
    # tests required both); degraded keeps its 503 and providers_down.
    # 2.9.21: health.cyr's own health_body and health_verdict (the body was a copy).
    var hb = to_cstr(health_body(1, "2.7.0", 4));
    assert_streq(hb, "{\"status\":\"ok\",\"version\":\"2.7.0\",\"providers_configured\":4}", "health: ok body");
    var hd = to_cstr(health_body(0, "2.7.0", 4));
    assert_streq(hd, "{\"status\":\"degraded\",\"providers_down\":1,\"version\":\"2.7.0\",\"providers_configured\":4}",
      "health: degraded body keeps providers_down and adds version");
    # The verdict is the top-priority route's health (router_new sorts by priority); no routes is healthy.
    var hv1 = route_new(PROV_OLLAMA, 2, "http://localhost:11434");
    var hv2 = route_new(PROV_OPENAI, 1, "https://api.openai.com");
    var hvr = alloc(16);
    store64(hvr, hv1);
    store64(hvr + 8, hv2);
    var hvrt = router_new(hvr, 2, STRAT_PRIORITY);
    assert_eq(health_verdict(hvrt), 1, "health: ok while the top route is healthy");
    store64(route_health(hv1) + HEALTH_OK, 0);
    assert_eq(health_verdict(hvrt), 1, "health: a lower-priority route down does not degrade it");
    store64(route_health(hv2) + HEALTH_OK, 0);
    assert_eq(health_verdict(hvrt), 0, "health: the top-priority route down degrades it");
    assert_eq(health_verdict(router_new(alloc(8), 0, STRAT_PRIORITY)), 1, "health: no routes is healthy");
    # /metrics: 2.9.21 checks metrics.cyr's own metrics_render (a copy of its token block stood here). First the
    # checker: the 2.6 token block declared hoosh_tokens_total and emitted other names.
    var m26 = _t_cat("# HELP hoosh_tokens_total Total tokens processed\n# TYPE hoosh_tokens_total counter\n",
      "hoosh_tokens_prompt_total 10\nhoosh_tokens_completion_total 20\n");
    assert_eq(_t_prom_declared(m26), 0, "metrics: 2.6 samples were undeclared");
    assert_eq(_t_prom_declared("# TYPE h histogram\nh_bucket{le=\"1\"} 1\nh_sum 1\nh_count 1\n"), 1,
      "metrics: a histogram's _bucket, _sum and _count samples are its own");
    assert_eq(_t_prom_declared("# TYPE c counter\nc_count 1\n"), 0, "metrics: a counter has no _count sample");
    metrics_reset();
    metrics_record(10, 20);
    var tb = to_cstr(metrics_render());
    assert_eq(_t_prom_declared(tb), 1, "metrics: every sample in the real body is declared");
    assert_eq(str_contains(str_from(tb), str_from("hoosh_tokens_total{type=\"prompt\"} 10\n")), 1,
      "metrics: rust-old's labelled prompt series");
    assert_eq(str_contains(str_from(tb), str_from("hoosh_tokens_total{type=\"completion\"} 20\n")), 1,
      "metrics: rust-old's labelled completion series");
    assert_eq(str_contains(str_from(tb), str_from("\nhoosh_tokens_prompt_total 10\n")), 1,
      "metrics: the 2.x prompt series is still there");
    assert_eq(str_contains(str_from(tb), str_from("\nhoosh_tokens_completion_total 20\n")), 1,
      "metrics: the 2.x completion series is still there");
    assert_eq(memeq(tb, "# HELP hoosh_requests_total ", 28), 1, "metrics: the body opens with the request counter");
    assert_eq(str_contains(str_from(tb), str_from("\nhoosh_requests_total 1\n")), 1, "metrics: one request counted");
    assert_eq(str_contains(str_from(tb), str_from("# TYPE hoosh_provider_latency_ms histogram\n")), 1,
      "metrics: the latency histogram recorded above is in it");
    assert_eq(str_contains(str_from(tb), str_from("\nhoosh_events_published_total ")), 1,
      "metrics: and the event bus counter closes it");
    metrics_reset();

    test_group("rustold_completion_id");
    # Every completion used to be "chatcmpl-hoosh" with no `created`. These run
    # against provider_err.cyr itself (chat_id_new, chat_id, chat_created,
    # sb_add_chat_head, chat_rehead; _chat_id_buf, _chat_hex underneath).
    chat_id_new();
    var cid = alloc(40);
    memcpy(cid, chat_id(), 34);
    assert_eq(memeq(cid, "chatcmpl-", 9), 1, "id: chatcmpl- prefix");
    assert_eq(strlen(cid), 33, "id: prefix + 24 hex digits");
    var hexok = 1;
    var hxi = 9;
    while (hxi < 33) {
        var hc = load8(cid + hxi);
        if ((hc < 48 || hc > 57) && (hc < 97 || hc > 102)) { hexok = 0; }
        hxi = hxi + 1;
    }
    assert_eq(hexok, 1, "id: lowercase hex");
    chat_id_new();
    assert_eq(streq(cid, chat_id()), 0, "id: each completion gets a new one");
    assert_eq(chat_created() > 1704067200, 1, "id: created is a unix timestamp (rust-old's bound)");
    var chb = str_builder_new();
    sb_add_chat_head(chb, "chat.completion");
    var chead = to_cstr(str_builder_build(chb));
    assert_eq(memeq(chead, "{\"id\":\"chatcmpl-", 16), 1, "id: head starts with the id");
    assert_eq(str_contains(str_from(chead), str_from("\",\"object\":\"chat.completion\",\"created\":")), 1,
      "id: head carries object and created");
    # A stream's chunks share the id until the next completion starts.
    var cb2 = str_builder_new();
    sb_add_chat_head(cb2, "chat.completion.chunk");
    assert_eq(str_contains(str_from(to_cstr(str_builder_build(cb2))), str_from(chat_id())), 1,
      "id: a chunk carries the current id");
    assert_eq(str_contains(str_from(upstream_error_sse_body("m", 500, "x")), str_from(chat_id())), 1,
      "id: the upstream error frame carries it too");
    # A cache hit replays the stored envelope with a fresh head.
    var cenv = "{\"id\":\"chatcmpl-aaaa\",\"object\":\"chat.completion\",\"created\":5,\"model\":\"m\",\"choices\":[]}";
    var rh = chat_rehead(cenv);
    assert_eq(str_contains(str_from(rh), str_from("chatcmpl-aaaa")), 0, "rehead: old id replaced");
    assert_eq(str_contains(str_from(rh), str_from("\"created\":5,")), 0, "rehead: old created replaced");
    assert_eq(str_contains(str_from(rh), str_from(",\"model\":\"m\",\"choices\":[]}")), 1, "rehead: body kept");
    assert_eq(str_contains(str_from(rh), str_from(chat_id())), 1, "rehead: carries the new id");
    var cother = "{\"object\":\"list\"}";
    assert_eq(chat_rehead(cother), cother, "rehead: other shapes pass through");

    test_group("rustold_embeddings");
    # Ollama gets /api/embed with the caller's `input` (string or array), and its
    # {"embeddings":[[...]]} answer comes back as OpenAI's list.
    # 2.9.22: jsonlite.cyr's own _json_raw_value and provider.cyr's own _ollama_embed_to_openai (they were copies).
    var eb = "{\"model\":\"nomic\",\"input\":[\"a, b\",\"c\"],\"encoding_format\":\"float\"}";
    var esp = alloc(16);
    assert_eq(_json_raw_value(eb, strlen(eb), "input", 5, esp), 1, "embed: array input found");
    assert_eq(load64(esp + 8), 12, "embed: whole array, commas in strings included");
    var eb2 = "{\"model\":\"nomic\", \"input\": \"one \\\"q\\\" line\"}";
    assert_eq(_json_raw_value(eb2, strlen(eb2), "input", 5, esp), 1, "embed: string input found");
    assert_eq(load64(esp + 8), 16, "embed: the string's span runs past its escaped quotes to its own close");
    assert_eq(memeq(load64(esp), "\"one \\\"q\\\" line\"", 16), 1, "embed: escaped quotes kept");
    var eb3 = "{\"model\":\"nomic\"}";
    assert_eq(_json_raw_value(eb3, strlen(eb3), "input", 5, esp), 0, "embed: missing input");
    var eb4 = "{\"input\":{\"a\":[1,{\"b\":\"}\"}]},\"model\":\"m\"}";
    assert_eq(_json_raw_value(eb4, strlen(eb4), "input", 5, esp), 1, "embed: an object value is found");
    assert_eq(load64(esp + 8), 19, "embed: the object's span ends at its own close, not a brace in a string");
    var eb5 = "{\"input\":\"unterminated}";
    assert_eq(_json_raw_value(eb5, strlen(eb5), "input", 5, esp), 0, "embed: an unterminated string is not a value");
    var eb6 = "{\"input\":42}";
    assert_eq(_json_raw_value(eb6, strlen(eb6), "input", 5, esp), 0, "embed: a number is not a raw value here");
    var oresp = "{\"model\":\"nomic\",\"embeddings\":[[0.1,-0.2],[0.3,0.4]],\"prompt_eval_count\":7}";
    var orb = alloc(strlen(oresp) + 1);
    memcpy(orb, oresp, strlen(oresp) + 1);
    var onorm = to_cstr(_ollama_embed_to_openai("nomic", orb, strlen(oresp)));
    assert_streq(onorm,
      "{\"object\":\"list\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":[0.1,-0.2]},{\"object\":\"embedding\",\"index\":1,\"embedding\":[0.3,0.4]}],\"model\":\"nomic\",\"usage\":{\"prompt_tokens\":7,\"total_tokens\":7}}",
      "embed: Ollama answer normalized");
    var obad = "{\"embedding\":[0.1]}";
    var obb = alloc(strlen(obad) + 1);
    memcpy(obb, obad, strlen(obad) + 1);
    assert_eq(_ollama_embed_to_openai("nomic", obb, strlen(obad)), 0, "embed: legacy shape is not an answer");
    var oobj = _t_cat("{\"embeddings\":{\"a\":[1]}}", "");
    assert_eq(_ollama_embed_to_openai("nomic", oobj, strlen(oobj)), 0, "embed: embeddings must be an array");
    var oneg = _t_cat("{\"embeddings\":[[1]],\"prompt_eval_count\":-3}", "");
    var onegn = to_cstr(_ollama_embed_to_openai("nomic", oneg, strlen(oneg)));
    assert_eq(_t_has(onegn, strlen(onegn), "\"usage\":{\"prompt_tokens\":0,"), 1, "embed: a negative count reads as 0");
    var onc = _t_cat("{\"embeddings\":[[1]]}", "");
    var oncn = to_cstr(_ollama_embed_to_openai("nomic", onc, strlen(onc)));
    assert_eq(_t_has(oncn, strlen(oncn), "\"usage\":{\"prompt_tokens\":0,\"total_tokens\":0}"), 1,
      "embed: no prompt_eval_count reads as 0 tokens");

    test_group("jsonlite_readers");
    # 2.9.22: the two readers under _json_raw_value and the embedding converter, tested directly. Their only
    # references in this file were inside the copies this release removed.
    var jr = _t_cat("{\"prompt_eval_count\":7,\"eval_count\":3}", "");
    assert_eq(_json_extract_int(jr, strlen(jr), "eval_count", 10), 3, "json: a key is quote-anchored, not a suffix");
    assert_eq(_json_extract_int(jr, strlen(jr), "prompt_eval_count", 17), 7, "json: the longer key reads its own");
    var jw = _t_cat("{\"n\" :\n\t 42}", "");
    assert_eq(_json_extract_int(jw, strlen(jw), "n", 1), 42, "json: whitespace around the colon is skipped");
    assert_eq(_json_value_pos(jr, strlen(jr), "missing", 7), 0 - 1, "json: an absent key is -1");
    assert_eq(_json_extract_int(jr, strlen(jr), "missing", 7), 0, "json: and reads as 0");
    var jt = "{\"type\":\"text\",\"text\":\"hi\"}";
    var jtp = _json_value_pos(jt, strlen(jt), "text", 4);
    assert_eq(memeq(jt + jtp, "\"hi\"", 4), 1, "json: a string value equal to the key's name is not the key");

    test_group("rustold_models_list");
    # /v1/models lists model ids a route can serve, once each, owned_by the provider.
    # 2.9.22: models.cyr's own _models_scan, _models_emit, _cat_literal and models_list_json (the first three were
    # copies, and the _models_emit copy did not escape the id).
    var mr = route_new(PROV_OLLAMA, 1, "http://127.0.0.1:11434");
    var mlpats = alloc(16);
    store64(mlpats, "llama*");
    store64(mlpats + 8, "qwen3:8b");
    route_set_patterns(mr, mlpats, 2);
    var tags = "{\"models\":[{\"name\":\"llama3.2:3b\",\"model\":\"llama3.2:3b\"},{\"name\":\"phi3:mini\"},{\"name\":\"llama3.2:3b\"}]}";
    var msb = str_builder_new();
    var mseen = vec_new();
    assert_eq(_models_scan(default_alloc(), msb, mseen, mr, tags, strlen(tags), "name", 4), 3, "models: three names listed");
    assert_eq(vec_len(mseen), 1, "models: unroutable and duplicate ids skipped");
    assert_streq(to_cstr(str_builder_build(msb)), "{\"id\":\"llama3.2:3b\",\"object\":\"model\",\"owned_by\":\"ollama\"}",
      "models: entry shape");
    var mesb = str_builder_new();
    assert_eq(_models_emit(default_alloc(), mesb, vec_new(), "we\"ird\\id", 9, "openai"), 1, "models: an odd id is emitted");
    var mes_want = "{\"id\":\"we\\\"ird\\\\id\",\"object\":\"model\",\"owned_by\":\"openai\"}";
    assert_streq(to_cstr(str_builder_build(mesb)), mes_want, "models: the id is JSON-escaped");
    assert_eq(_cat_literal("qwen3:8b"), 1, "models: a literal pattern is a model id");
    assert_eq(_cat_literal("llama*"), 0, "models: a wildcard pattern is not");
    assert_eq(_cat_literal("qwen?"), 0, "models: nor is one with ?");
    assert_eq(_cat_literal(""), 0, "models: an empty pattern is not");
    # The whole listing: a local Ollama route that answers (its own list), a remote route listed from the table
    # (its literal pattern), and a disabled route (nothing).
    var ml_port = alloc(8);
    var ml_lfd = _t_listen(ml_port);
    assert_eq(ml_lfd > 0, 1, "models: a loopback backend listens");
    var ml_ol = route_new(PROV_OLLAMA, 1, _t_base_url(load64(ml_port)));
    route_set_patterns(ml_ol, mlpats, 2);
    var ml_rp = alloc(8);
    store64(ml_rp, "my-ft-model");
    var ml_oa = route_new(PROV_OPENAI, 2, "https://ft.example");
    route_set_patterns(ml_oa, ml_rp, 1);
    var ml_off = route_new(PROV_OPENAI, 3, "https://other.example");
    var ml_op = alloc(8);
    store64(ml_op, "hidden-model");
    route_set_patterns(ml_off, ml_op, 1);
    route_set_enabled(ml_off, 0);
    var ml_routes = alloc(24);
    store64(ml_routes, ml_ol);
    store64(ml_routes + 8, ml_oa);
    store64(ml_routes + 16, ml_off);
    var ml_rt = router_new(ml_routes, 3, STRAT_PRIORITY);
    _t_srv_lfd = ml_lfd;
    _t_srv_reply = _t_cat("HTTP/1.0 200 OK\r\n\r\n", tags);
    _t_srv_body_len = 0;
    var ml_th = thread_create(&_t_serve_once, 0);
    var ml_body = to_cstr(models_list_json(ml_rt));
    thread_join(ml_th);
    assert_eq(memeq(_t_srv_req, "GET /api/tags ", 14), 1, "models: an Ollama route is asked at /api/tags");
    var ml_want = _t_cat(
      "{\"object\":\"list\",\"data\":[{\"id\":\"llama3.2:3b\",\"object\":\"model\",\"owned_by\":\"ollama\"},",
      "{\"id\":\"my-ft-model\",\"object\":\"model\",\"owned_by\":\"openai\"}]}");
    assert_streq(ml_body, ml_want, "models: the live list, then the remote route's literal; not the disabled route");
    # The same local route when its backend does not answer: its literal pattern, from the table fallback.
    sys_close(ml_lfd);
    var ml_body2 = to_cstr(models_list_json(ml_rt));
    var ml_q = "{\"id\":\"qwen3:8b\",\"object\":\"model\",\"owned_by\":\"ollama\"}";
    assert_eq(_t_has(ml_body2, strlen(ml_body2), ml_q), 1, "models: a silent local backend falls back to its literals");
    assert_eq(_t_has(ml_body2, strlen(ml_body2), "llama3.2:3b"), 0, "models: and not to what it listed before");

    test_group("rustold_catalog");
    # rust-old's catalog entries, found by exact match and longest prefix.
    var cm = alloc(40);
    assert_eq(metadata_lookup("mistral-nemo-2407", cm), 1, "catalog: mistral-nemo found");
    assert_eq(load64(cm), 128000, "catalog: mistral-nemo's own 128k, not mistral's 32k");
    assert_eq(metadata_lookup("o3-2025-04-16", cm), 1, "catalog: o3 found");
    assert_eq(load64(cm + 16), 1, "catalog: o3 (vision) not o3-mini (none)");
    assert_eq(metadata_lookup("o1-mini-2024-09-12", cm), 1, "catalog: o1-mini found");
    assert_eq(load64(cm), 128000, "catalog: o1-mini's 128k, not o1's 200k");
    assert_eq(metadata_lookup("gpt-4.1-mini-2025-04-14", cm), 1, "catalog: gpt-4.1-mini found");
    assert_eq(load64(cm + 8), TIER_ECONOMY, "catalog: gpt-4.1-mini is economy, not gpt-4.1's standard");
    assert_eq(metadata_lookup("gemini-2.5-pro-preview", cm), 1, "catalog: gemini-2.5-pro found");
    assert_eq(load64(cm + 8), TIER_PREMIUM, "catalog: gemini-2.5-pro is premium");
    assert_eq(metadata_lookup("text-embedding-3-small", cm), 1, "catalog: embedding model found");
    assert_eq(load64(cm + 32), 0, "catalog: embedding model takes no system prompt");

    test_group("rustold_keepalive");
    # Local streams send an SSE comment every 15 s of silence and still end after
    # 300 s with nothing from the backend. 2.9.22: http_client.cyr's own sse_idle_next decides each read.
    assert_eq(sse_idle_next(0, 0 - EAGAIN), SSE_KEEPALIVE_S, "keepalive: a timed-out read adds one period");
    assert_eq(sse_idle_next(270, 0 - EAGAIN), 285, "keepalive: silence accumulates");
    assert_eq(sse_idle_next(285, 0 - EAGAIN), 0 - 1, "keepalive: reaching HTTP_IO_TIMEOUT_S ends the stream");
    assert_eq(sse_idle_next(120, 512), 0, "keepalive: data resets the silence");
    assert_eq(sse_idle_next(120, 0), 0 - 1, "keepalive: the backend closing ends the stream");
    assert_eq(sse_idle_next(0, 0 - 104), 0 - 1, "keepalive: a read error other than a timeout ends it");
    var ka = alloc(16);
    var kr = vec_new();
    vec_push(kr, 0 - EAGAIN);
    vec_push(kr, 0 - EAGAIN);
    vec_push(kr, 0 - EAGAIN);
    vec_push(kr, 512);
    vec_push(kr, 0);
    _t_keepalive(kr, ka);
    assert_eq(load64(ka), 3, "keepalive: one comment per quiet 15 s");
    assert_eq(load64(ka + 8), 0, "keepalive: data resets the idle clock");
    var kr2 = vec_new();
    var kz = 0;
    while (kz < 25) { vec_push(kr2, 0 - EAGAIN); kz = kz + 1; }
    _t_keepalive(kr2, ka);
    assert_eq(load64(ka), 19, "keepalive: comments until the idle bound");
    assert_eq(load64(ka + 8), 1, "keepalive: 300 s of silence still ends the stream");
    var kr3 = vec_new();
    kz = 0;
    while (kz < 19) { vec_push(kr3, 0 - EAGAIN); kz = kz + 1; }
    vec_push(kr3, 64);
    kz = 0;
    while (kz < 19) { vec_push(kr3, 0 - EAGAIN); kz = kz + 1; }
    vec_push(kr3, 0);
    _t_keepalive(kr3, ka);
    assert_eq(load64(ka + 8), 0, "keepalive: silence is counted per gap, not in total");
    assert_eq(load64(ka), 38, "keepalive: both gaps kept alive");
    # http_sse_comment (http_server.cyr, the real one) writes the comment frame.
    var kpf = alloc(16);
    sys_pipe(kpf);
    var kprd = load64(kpf) & 0xFFFFFFFF;
    var kpwr = (load64(kpf) >> 32) & 0xFFFFFFFF;
    assert_eq(http_sse_comment(kpwr, "keep-alive"), 0, "keepalive: comment written");
    var kpb = alloc(32);
    assert_eq(sys_read(kprd, kpb, 32), 14, "keepalive: 14 bytes");
    assert_eq(memeq(kpb, ": keep-alive\n\n", 14), 1, "keepalive: an SSE comment line");
    sys_close(kprd);
    sys_close(kpwr);

    test_group("remote_sse_keepalive");
    # 2.9.2: http_sse_idle_keepalive (http_server.cyr, the real one) is sandhi's
    # idle_cb for a remote stream. ctx[0] is the client fd; 1 keeps waiting, 0
    # stops the stream. The gateway ignores SIGPIPE at startup, so a gone client
    # is an EPIPE write; ignore it here too.
    signal_ignore(13);
    var rkf = alloc(16);
    sys_pipe(rkf);
    var rkrd = load64(rkf) & 0xFFFFFFFF;
    var rkwr = (load64(rkf) >> 32) & 0xFFFFFFFF;
    var rkctx = alloc(48);
    store64(rkctx, rkwr);
    assert_eq(http_sse_idle_keepalive(rkctx, 15000), 1, "remote keepalive: a live client keeps the stream");
    var rkb = alloc(32);
    assert_eq(sys_read(rkrd, rkb, 32), 14, "remote keepalive: 14 bytes");
    assert_eq(memeq(rkb, ": keep-alive\n\n", 14), 1, "remote keepalive: the local path's comment line");
    sys_close(rkrd);
    assert_eq(http_sse_idle_keepalive(rkctx, 30000), 0, "remote keepalive: a gone client stops the stream");
    sys_close(rkwr);
    assert_eq(http_sse_idle_keepalive(0, 15000), 0, "remote keepalive: no ctx stops the stream");

    test_group("rustold_hw_numbers");
    # handle_hw_models_post / _hw_model_info and _hw_cloud_alternatives (placement)
    # print rust-old's float fields from ai-hwaccel's fixed-point ones.
    var hsb = str_builder_new();
    _sb_add_milli(hsb, 8030);                 # params_b_x1000
    str_builder_add_cstr(hsb, " ");
    _sb_add_milli(hsb, 4412 * 10);            # headroom x100
    str_builder_add_cstr(hsb, " ");
    _sb_add_milli(hsb, 9832 * 10);            # price x100
    str_builder_add_cstr(hsb, " ");
    _sb_add_milli(hsb, 70000);
    assert_streq(to_cstr(str_builder_build(hsb)), "8.03 44.12 98.32 70", "hw: fixed-point to JSON numbers");

    test_group("rustold_provider_tls");
    # [[providers]] tls_pinned_certs / client_cert / client_key (rust-old
    # config.rs:281-287) become a sandhi TLS policy on the route. Anything that
    # would silently weaken TLS refuses the config instead.
    # 2.9.18: the real _config_tls_policy on real [[providers]] blocks, against real files. sandhi's constructors
    # record the paths and parse nothing until a connection, so empty files do. The copy here reduced sandhi and the
    # file system to flags.
    var tu = "https://api.example.com";
    var tp_dir = _t_line("/tmp/hoosh-tcyr-", sys_getpid(), "-");
    var tp_ca = _t_cat(tp_dir, "ca.pem");
    var tp_c = _t_cat(tp_dir, "c.pem");
    var tp_k = _t_cat(tp_dir, "k.pem");
    file_write_all(tp_ca, "x", 1);
    file_write_all(tp_c, "x", 1);
    file_write_all(tp_k, "x", 1);
    assert_eq(_t_tls(0, 0, 0, tu), 0, "tls: no keys, no policy");
    var tp1 = _t_tls(_t_cat(_t_cat("[\"", tp_ca), "\"]"), 0, 0, tu);
    assert_eq(tp1 > 0 && load64(tp1 + SANDHI_TLS_POLICY_OFF_FLAGS) == SANDHI_TLS_POLICY_CUSTOM_TRUST, 1,
      "tls: one bundle is a trust store");
    var tp2 = _t_tls(_t_cat(_t_cat("\"", tp_ca), "\""), 0, 0, tu);
    assert_eq(tp2 > 0 && load64(tp2 + SANDHI_TLS_POLICY_OFF_FLAGS) == SANDHI_TLS_POLICY_CUSTOM_TRUST, 1,
      "tls: a bare string works too");
    # 2.9.23: a bundle path with a comma is one bundle. Through 2.9.22 it read as two and the config was refused.
    var tp_cm = _t_cat(tp_dir, "ca,1.pem");
    file_write_all(tp_cm, "x", 1);
    var tp5 = _t_tls(_t_cat(_t_cat("[\"", tp_cm), "\"]"), 0, 0, tu);
    assert_eq(tp5 > 0 && load64(tp5 + SANDHI_TLS_POLICY_OFF_FLAGS) == SANDHI_TLS_POLICY_CUSTOM_TRUST, 1,
      "tls: a bundle path with a comma is one bundle");
    sys_unlink(tp_cm);
    assert_eq(_t_tls(_t_cat(_t_cat(_t_cat(_t_cat("[\"", tp_ca), "\", \""), tp_c), "\"]"), 0, 0, tu), 0 - 1,
      "tls: two bundles refused (sandhi keeps one; the other would be dropped)");
    assert_eq(_t_tls("[\"/nonexistent-hoosh/ca.pem\"]", 0, 0, tu), 0 - 1, "tls: missing bundle refused");
    var tp3 = _t_tls(0, tp_c, tp_k, tu);
    assert_eq(tp3 > 0 && load64(tp3 + SANDHI_TLS_POLICY_OFF_FLAGS) == SANDHI_TLS_POLICY_MTLS, 1,
      "tls: cert + key is mTLS");
    var tp4 = _t_tls(_t_cat(_t_cat("\"", tp_ca), "\""), tp_c, tp_k, tu);
    assert_eq(load64(tp4 + SANDHI_TLS_POLICY_OFF_FLAGS), SANDHI_TLS_POLICY_CUSTOM_TRUST | SANDHI_TLS_POLICY_MTLS,
      "tls: trust store and mTLS combine");
    assert_eq(_t_tls(0, tp_c, 0, tu), 0 - 1, "tls: half an mTLS pair refused");
    assert_eq(_t_tls(0, tp_c, "/nonexistent-hoosh/k.pem", tu), 0 - 1, "tls: a missing key file refused");
    assert_eq(_t_tls(_t_cat(_t_cat("\"", tp_ca), "\""), 0, 0, "http://127.0.0.1:11434"), 0,
      "tls: plain-http routes ignore it");
    sys_unlink(tp_ca);
    sys_unlink(tp_c);
    sys_unlink(tp_k);
    # $NAME / ${NAME} expansion keeps secrets out of hoosh.cyml (PATH is set wherever the suite runs).
    assert_streq(_config_expand_env("plain-key"), "plain-key", "env: a plain value passes through");
    assert_streq(_config_expand_env("$PATH"), getenv("PATH"), "env: $NAME expands");
    assert_streq(_config_expand_env("${PATH}"), getenv("PATH"), "env: ${NAME} expands");
    assert_eq(_config_expand_env("$HOOSH_TCYR_SURELY_UNSET_9"), 0, "env: an unset variable is 0 (and warned)");
    assert_eq(_config_expand_env(0), 0, "env: no value, no expansion");
    # Remote streams now carry deadlines; they had none. No total deadline, so a
    # long generation is not cut, unlike the 10-minute total on plain requests.
    # 2.9.14: the real _remote_stream_opts / _remote_http_opts_for, read back through sandhi's getters (this
    # used to check a copy that stored the numbers itself).
    var ro_rt = route_new(PROV_OPENAI, 1, "https://api.openai.com");
    var ro = _remote_stream_opts(ro_rt);
    assert_eq(sandhi_http_options_get_connect_ms(ro), 10000, "stream opts: connect deadline");
    assert_eq(sandhi_http_options_get_read_ms(ro), 300000, "stream opts: 300 s idle bound");
    assert_eq(sandhi_http_options_get_total_ms(ro), 0, "stream opts: no total deadline");
    assert_eq(sandhi_http_options_get_idle_ms(ro), SSE_KEEPALIVE_S * 1000,
      "stream opts: a keep-alive comment when idle");
    assert_eq(sandhi_http_options_get_idle_cb(ro), &http_sse_idle_keepalive, "stream opts: written by the SSE hook");
    var roh = _remote_http_opts_for(ro_rt);
    assert_eq(sandhi_http_options_get_total_ms(roh), 600000, "request opts keep their total deadline");
    assert_eq(sandhi_http_options_bytes(roh), 8388608, "request opts cap the response at 8 MiB");
    assert_eq(sandhi_http_options_get_tls_policy(roh), 0, "request opts: no TLS policy unless the route has one");
    store64(ro_rt + ROUTE_TLS_POLICY, 4242);
    assert_eq(sandhi_http_options_get_tls_policy(_remote_http_opts_for(ro_rt)), 4242,
      "request opts carry the route's policy");
    assert_eq(sandhi_http_options_get_tls_policy(_remote_stream_opts(ro_rt)), 4242, "stream opts carry it too");

    test_group("rustold_semantic_ollama");
    # The semantic cache embeds queries through the same Ollama /api/embed call
    # and normalizer as /v1/embeddings, then semantic_parse_embedding reads it.
    var soe = "{\"model\":\"nomic\",\"embeddings\":[[0.5,-1.25,2]],\"prompt_eval_count\":3}";
    var sob = alloc(strlen(soe) + 1);
    memcpy(sob, soe, strlen(soe) + 1);
    var snorm = to_cstr(_ollama_embed_to_openai("nomic", sob, strlen(soe)));
    var sn = alloc(8);
    var svec = semantic_parse_embedding(snorm, strlen(snorm), sn);
    assert_eq(load64(sn), 3, "semantic: three components from the normalized answer");
    assert_eq(svec != 0, 1, "semantic: a vector came back");
    # The legacy /api/embeddings answer to an `input` body had nothing to parse.
    var sleg = "{\"embedding\":[]}";
    var slb = alloc(strlen(sleg) + 1);
    memcpy(slb, sleg, strlen(sleg) + 1);
    semantic_parse_embedding(slb, strlen(sleg), sn);
    assert_eq(load64(sn), 0, "semantic: the old empty answer gave no vector");

    test_group("hardware_available_vram");
    # Placement compared against TOTAL accelerator memory before 2.5.7, which
    # assumes an idle, exclusively-owned card. Available subtracts what devices
    # report in use, then the configured reserve.
    assert_eq(_t_vram(24000, 0, 0), 24000, "vram: idle card, no reserve");
    assert_eq(_t_vram(24000, 8000, 0), 16000, "vram: in-use subtracted");
    assert_eq(_t_vram(24000, 8000, 4000), 12000, "vram: reserve subtracted too");
    # A reserve larger than what is free floors at 0 rather than going negative
    # and reading as a huge unsigned budget.
    assert_eq(_t_vram(24000, 20000, 8000), 0, "vram: over-reserved floors at 0");
    assert_eq(_t_vram(0, 0, 1000), 0, "vram: no accelerator floors at 0");
    # The case the reserve exists for: fits the card, does not fit what is free.
    var need = 2400;
    assert_eq(need <= 24000, 1, "vram: model fits the card");
    assert_eq(need <= _t_vram(24000, 20000, 2000), 0,
      "vram: same model does NOT fit available -> overcommit prevented");

    # ── 2.9.9: router.cyr for real — health, order, local-only, hardware-aware ──
    test_group("router_health");
    # A depooled route is skipped while a healthy one can serve; the copy this replaced had no health filter.
    var rh1 = route_new(PROV_OLLAMA, 1, "http://rh-1");
    var rh2 = route_new(PROV_LLAMACPP, 2, "http://rh-2");
    var rh3 = route_new(PROV_VLLM, 3, "http://rh-3");
    var rhs = alloc(24);
    store64(rhs, rh1);
    store64(rhs + 8, rh2);
    store64(rhs + 16, rh3);
    var rhrt = router_new(rhs, 3, STRAT_PRIORITY);
    store64(route_health(rh1) + HEALTH_OK, 0);
    assert_eq(router_select(rhrt, "m"), rh2, "health: an unhealthy first choice is skipped");
    # Every candidate down: serve the unfiltered set in priority order rather than 404 every request.
    store64(route_health(rh2) + HEALTH_OK, 0);
    store64(route_health(rh3) + HEALTH_OK, 0);
    assert_eq(router_select(rhrt, "m"), rh1, "health: all down, priority order ignores health");
    # A disabled route stays out even then.
    route_set_enabled(rh1, 0);
    assert_eq(router_select(rhrt, "m"), rh2, "health: all down still skips a disabled route");
    route_set_enabled(rh1, 1);
    # Round robin rotates over the healthy routes only.
    store64(route_health(rh1) + HEALTH_OK, 1);
    store64(route_health(rh3) + HEALTH_OK, 1);
    var rhrr = router_new(rhs, 3, STRAT_ROUND_ROBIN);
    var rh_a = router_select(rhrr, "m");
    var rh_b = router_select(rhrr, "m");
    var rh_c = router_select(rhrr, "m");
    assert_eq(rh_a != rh2 && rh_b != rh2 && rh_c != rh2, 1, "health: round robin never picks the unhealthy route");
    assert_eq(rh_a != rh_b && rh_a == rh_c, 1, "health: round robin alternates the two healthy routes");

    test_group("router_sort");
    # router_new sorts the routes by priority, keeping the given order among equals.
    var rs3 = route_new(PROV_OLLAMA, 3, "http://rs-3");
    var rs1 = route_new(PROV_LLAMACPP, 1, "http://rs-1");
    var rs2 = route_new(PROV_VLLM, 2, "http://rs-2");
    var rs1b = route_new(PROV_LOCALAI, 1, "http://rs-1b");
    var rss = alloc(32);
    store64(rss, rs3);
    store64(rss + 8, rs1);
    store64(rss + 16, rs2);
    store64(rss + 24, rs1b);
    var rsrt = router_new(rss, 4, STRAT_PRIORITY);
    assert_eq(load64(rss) == rs1 && load64(rss + 8) == rs1b, 1, "sort: priority 1 first, in the given order");
    assert_eq(load64(rss + 16) == rs2 && load64(rss + 24) == rs3, 1, "sort: then 2, then 3");
    assert_eq(router_select(rsrt, "m"), rs1, "sort: priority selection takes the lowest number");

    test_group("router_select_local");
    # DLP-confidential content stays on local backends: remote routes are never candidates.
    var rlr = route_new(PROV_OPENAI, 1, "https://rl-remote");
    var rl1 = route_new(PROV_OLLAMA, 2, "http://rl-1");
    var rl2 = route_new(PROV_LLAMACPP, 3, "http://rl-2");
    var rls = alloc(24);
    store64(rls, rlr);
    store64(rls + 8, rl1);
    store64(rls + 16, rl2);
    var rlrt = router_new(rls, 3, STRAT_PRIORITY);
    assert_eq(router_select(rlrt, "m"), rlr, "local: the plain pick is the remote route");
    assert_eq(router_select_local(rlrt, "m"), rl1, "local: the local pick is the first local route");
    route_set_enabled(rl1, 0);
    assert_eq(router_select_local(rlrt, "m"), rl2, "local: a disabled local route is skipped");
    route_set_enabled(rl2, 0);
    assert_eq(router_select_local(rlrt, "m"), 0, "local: no local route, no answer (never the remote)");
    route_set_enabled(rl1, 1);
    route_set_enabled(rl2, 1);
    var rlrr = router_new(rls, 3, STRAT_ROUND_ROBIN);
    var rlx_a = router_select_local(rlrr, "m");
    var rlx_b = router_select_local(rlrr, "m");
    assert_eq(rlx_a != rlx_b && rlx_a != rlr && rlx_b != rlr, 1, "local: round robin over the local routes");

    test_group("router_select_hw");
    # A model that does not fit the free VRAM goes to a remote route when one can serve it.
    var rwl = route_new(PROV_OLLAMA, 1, "http://rw-local");
    var rwr = route_new(PROV_OPENAI, 2, "https://rw-remote");
    var rws = alloc(16);
    store64(rws, rwl);
    store64(rws + 8, rwr);
    var rwrt = router_new(rws, 2, STRAT_PRIORITY);
    assert_eq(router_select_hw(rwrt, "m", 70000000000), rwl, "hw route: no hardware detected, plain priority");
    var rw_devs = vec_new();
    vec_push(rw_devs, profile_cpu(68719476736));
    vec_push(rw_devs, profile_cuda(0, 8589934592));
    _hw_registry = registry_from_profiles(rw_devs);
    assert_eq(router_select_hw(rwrt, "m", 0), rwl, "hw route: unknown model size, plain priority");
    assert_eq(router_select_hw(rwrt, "m", 1000000000), rwl, "hw route: a 1B model fits 8 GiB, stays local");
    assert_eq(router_select_hw(rwrt, "m", 70000000000), rwr, "hw route: 70B does not fit, goes remote");
    # It is the FREE VRAM that counts: a 7 GiB reserve leaves 1 GiB, and the 1B model (2.4 GB) goes remote too.
    hardware_configure(7516192768, 0 - 1, 0 - 1);
    assert_eq(router_select_hw(rwrt, "m", 1000000000), rwr, "hw route: the reserve is honoured");
    hardware_configure(0, 0 - 1, 0 - 1);
    # No healthy remote can serve it: try the local backend rather than refuse.
    store64(route_health(rwr) + HEALTH_OK, 0);
    assert_eq(router_select_hw(rwrt, "m", 70000000000), rwl, "hw route: remote unhealthy, falls back to local");
    store64(route_health(rwr) + HEALTH_OK, 1);
    var rwpat = alloc(8);
    store64(rwpat, "gpt-*");
    route_set_patterns(rwr, rwpat, 1);
    assert_eq(router_select_hw(rwrt, "llama-70b", 70000000000), rwl,
      "hw route: no remote serves this model, falls back to local");
    # Among remotes the strategy still applies.
    var rwr2 = route_new(PROV_ANTHROPIC, 3, "https://rw-remote-2");
    var rwr3 = route_new(PROV_GROQ, 4, "https://rw-remote-3");
    var rws2 = alloc(24);
    store64(rws2, rwl);
    store64(rws2 + 8, rwr2);
    store64(rws2 + 16, rwr3);
    var rwrr = router_new(rws2, 3, STRAT_ROUND_ROBIN);
    var rw_a = router_select_hw(rwrr, "m", 70000000000);
    var rw_b = router_select_hw(rwrr, "m", 70000000000);
    assert_eq(rw_a != rw_b && rw_a != rwl && rw_b != rwl, 1, "hw route: round robin over the remote routes");
    _hw_registry = 0;

    # ── 2.9.9: hardware.cyr for real — no hardware, a synthetic host, refresh, data files ──
    test_group("hardware_real");
    assert_eq(hw_ready(), 0, "hw: not ready before detection");
    assert_eq(hw_device_count(), 0, "hw: no devices before detection");
    assert_eq(hw_suggest_quant(70000000000), QUANT_INT4, "hw: with nothing detected, suggest INT4");
    assert_eq(hw_plan(70000000000, QUANT_INT4), 0, "hw: no plan without hardware");
    assert_eq(hw_available_vram(), 0, "hw: no VRAM without hardware");
    assert_eq(hw_has_fast_interconnect(), 0, "hw: no interconnect without hardware");
    assert_streq(_t_hw_json(0), "{\"detected\":false}", "hw: summary says not detected");
    assert_streq(_t_hw_json(1), "[]", "hw: telemetry is an empty list");
    var hrsb = str_builder_new();
    hw_placement_json(hrsb, 70000000000, 0);
    assert_streq(str_data(str_builder_build(hrsb)), "{\"error\":\"no hardware detected\"}", "hw: placement says why");
    # A host with a 24 GiB card reporting telemetry, a 16 GiB card reporting none, and 64 GiB of RAM.
    var hr_big = profile_cuda(0, 25769803776);
    profile_set_mem_used(hr_big, 8589934592);
    profile_set_mem_free(hr_big, 17179869184);
    profile_set_gpu_util(hr_big, 37);
    profile_set_temp_c(hr_big, 61);
    var hr_devs = vec_new();
    vec_push(hr_devs, profile_cpu(68719476736));
    vec_push(hr_devs, hr_big);
    vec_push(hr_devs, profile_cuda(1, 17179869184));
    _hw_registry = registry_from_profiles(hr_devs);
    assert_eq(hw_ready(), 1, "hw: ready once a registry is in");
    assert_eq(hw_device_count(), 3, "hw: three devices, the CPU included");
    assert_eq(hw_gpu_count(), 2, "hw: two GPUs");
    assert_eq(hw_accel_memory(), 42949672960, "hw: 40 GiB of accelerator memory");
    assert_eq(hw_available_vram(), 42949672960 - 8589934592, "hw: free VRAM is total minus the reported use");
    var hr_sum = _t_hw_json(0);
    var hr_sl = strlen(hr_sum);
    assert_eq(_t_has(hr_sum, hr_sl,
        "{\"detected\":true,\"devices\":3,\"accelerators\":2,\"accel_memory_bytes\":42949672960,"),
      1, "hw: summary counts");
    assert_eq(_t_has(hr_sum, hr_sl,
        "\"best_device\":{\"type\":\"CUDA GPU\",\"family\":\"GPU\",\"memory_bytes\":25769803776}"),
      1, "hw: the best device is the first of the top-ranked kind");
    assert_eq(_t_has(hr_sum, hr_sl,
        "{\"type\":\"CPU\",\"family\":\"CPU\",\"memory_bytes\":68719476736,\"available\":true}"),
      1, "hw: the CPU is listed among the profiles");
    var hr_tel = _t_hw_json(1);
    var hr_tl = strlen(hr_tel);
    assert_eq(_t_has(hr_tel, hr_tl, "\"device\":\"CPU\""), 0, "hw: telemetry leaves out the CPU");
    assert_eq(_t_has(hr_tel, hr_tl,
        "{\"device\":\"CUDA GPU\",\"device_id\":0,\"memory_bytes\":25769803776,\"memory_used_bytes\":8589934592,"),
      1, "hw: telemetry for the reporting card");
    assert_eq(_t_has(hr_tel, hr_tl,
        "\"memory_free_bytes\":17179869184,\"utilization_percent\":37,\"temperature_c\":61}"), 1,
      "hw: ...its free memory, utilization and temperature");
    assert_eq(_t_has(hr_tel, hr_tl,
        "\"memory_used_bytes\":null,\"memory_free_bytes\":null,\"utilization_percent\":null,\"temperature_c\":null}"),
      1, "hw: null for everything the other card did not report");
    # Placement: a 1B model fits what is free and needs no cloud; 70B does not, and gets cloud alternatives.
    hrsb = str_builder_new();
    hw_placement_json(hrsb, 1000000000, 0);
    var hr_pl = str_data(str_builder_build(hrsb));
    assert_eq(_t_has(hr_pl, strlen(hr_pl), "\"fits_available\":true"), 1, "hw: 1B fits the free VRAM");
    assert_eq(_t_has(hr_pl, strlen(hr_pl), "\"cloud_alternatives\":[]}"), 1, "hw: ...so no cloud alternatives");
    assert_eq(_t_json_int(hr_pl, "available_vram_bytes"), 42949672960 - 8589934592, "hw: placement's free VRAM");
    hrsb = str_builder_new();
    hw_placement_json(hrsb, 70000000000, QUANT_FP16);
    hr_pl = str_data(str_builder_build(hrsb));
    assert_eq(_t_has(hr_pl, strlen(hr_pl), "\"quantization\":\"FP16\""), 1, "hw: the asked quantization is kept");
    assert_eq(_t_json_int(hr_pl, "memory_required_bytes"), 168000000000, "hw: 70B at FP16 needs 168 GB");
    assert_eq(_t_has(hr_pl, strlen(hr_pl), "\"fits_single_device\":false"), 1, "hw: not on one card");
    assert_eq(_t_has(hr_pl, strlen(hr_pl), "\"fits_available\":false"), 1, "hw: not in the free VRAM");
    assert_eq(_t_has(hr_pl, strlen(hr_pl), "\"cloud_alternatives\":[{\"name\":"), 1,
      "hw: cloud alternatives listed when it does not fit");
    # An unavailable card is listed as such and is not capacity.
    var hr_dead = profile_cuda(2, 85899345920);
    profile_set_available(hr_dead, 0);
    vec_push(hr_devs, hr_dead);
    _hw_registry = registry_from_profiles(hr_devs);
    assert_eq(hw_accel_memory(), 42949672960, "hw: an unavailable 80 GiB card adds nothing");
    hr_sum = _t_hw_json(0);
    assert_eq(_t_has(hr_sum, strlen(hr_sum), "\"memory_bytes\":85899345920,\"available\":false}"), 1,
      "hw: ...and is listed as unavailable");
    # A refresh inside cache_ttl_secs does not re-probe (detection shells out to nvidia-smi and friends). The lock
    # is the one hw_init creates at startup, before any refresh can run.
    if (_hw_lock == 0) { _hw_lock = mutex_new(); }
    var hr_reg = _hw_registry;
    _hw_last_detect_ms = clock_now_ms();
    assert_eq(hw_refresh(), 0, "hw: a refresh inside the TTL is skipped");
    assert_eq(_hw_registry, hr_reg, "hw: ...and keeps the registry");
    assert_eq(hw_refresh_start(), 0, "hw: no refresh thread when refresh_interval_secs is 0");
    _hw_registry = 0;
    # [hardware] settings: a negative value leaves a setting alone.
    hardware_configure(4096, 30, 60);
    assert_eq(hardware_reserve_bytes() == 4096 && hardware_refresh_interval() == 30 && hardware_cache_ttl() == 60, 1,
      "hw: configure sets all three");
    hardware_configure(0 - 1, 0 - 1, 0 - 1);
    assert_eq(hardware_reserve_bytes() == 4096 && hardware_refresh_interval() == 30 && hardware_cache_ttl() == 60, 1,
      "hw: negative values keep them");
    hardware_configure(0, 0, 300);
    # The data files: found in the working directory, missing (both counted) under a directory without data/.
    assert_eq(hw_check_data_files(), 0, "hw: both data files found from the repo root");
    hardware_configure_data_dir("/nonexistent-hoosh-test-dir");
    assert_eq(hw_check_data_files(), 2, "hw: both reported missing under a directory without data/");
    hardware_configure_data_dir(0);
    assert_eq(hw_check_data_files(), 0, "hw: unsetting data_dir goes back to the working directory");
    # Model size from a name, for routing without a size in the request.
    assert_eq(_hoosh_parse_model_params("llama-70b"), 70000000000, "hw: llama-70b is 70B");
    assert_eq(_hoosh_parse_model_params("Mistral-7B-Instruct"), 7000000000, "hw: an upper-case B");
    assert_eq(_hoosh_parse_model_params("llama3.1:405b"), 405000000000, "hw: 405B after a tag colon");
    assert_eq(_hoosh_parse_model_params("gpt-4o"), 0, "hw: no size in the name is unknown");
    assert_eq(_hoosh_parse_model_params("bert-base"), 0, "hw: a b that starts a word is not a size");
    assert_eq(_hoosh_parse_model_params("model-10000b"), 0, "hw: an implausible size is unknown");

    test_group("compact_system_detect_whitespace");
    # The pre-2.5.7 detector was the compact literal `"role":"system"`. Virtually
    # every JSON encoder emits `"role": "system"` WITH A SPACE (Python's
    # json.dumps does by default), so ordinary client traffic was not detected
    # as having a system message at all — compaction then dropped the system
    # prompt like any other message. Verified live: a 13-message request came
    # back from compaction with 6 messages instead of 7, the system one missing.
    var wsc = "[{\"role\":\"system\",\"content\":\"s\"}]";
    assert_eq(_t_has_system(wsc, strlen(wsc)), 1, "role: compact form detected");
    var wss = "[{\"role\": \"system\", \"content\": \"s\"}]";
    assert_eq(_t_has_system(wss, strlen(wss)), 1, "role: space after colon detected");
    var wsi = "[\n  {\n    \"role\": \"system\",\n    \"content\": \"s\"\n  }\n]";
    assert_eq(_t_has_system(wsi, strlen(wsi)), 1, "role: indented/pretty form detected");
    # A user-only conversation must NOT report a system message.
    var wsu = "[{\"role\": \"user\", \"content\": \"hi\"}]";
    assert_eq(_t_has_system(wsu, strlen(wsu)), 0, "role: user-only has no system");
    # `system` appearing as CONTENT must not be mistaken for a role.
    var wsf = "[{\"role\": \"user\", \"content\": \"system\"}]";
    assert_eq(_t_has_system(wsf, strlen(wsf)), 0, "role: 'system' as content not matched");
    # A longer role starting with the wanted prefix must not match.
    var wsp = "[{\"role\": \"systemx\", \"content\": \"s\"}]";
    assert_eq(_t_has_system(wsp, strlen(wsp)), 0, "role: 'systemx' not matched as system");
    # 2.9.3: a DIFFERENT role of the same length. The closing-quote check alone rejects "user" and
    # "systemx" by length, so without this a matcher that skipped the name compare still passed.
    var wst = "[{\"role\": \"tester\", \"content\": \"s\"}]";
    assert_eq(_t_has_system(wst, strlen(wst)), 0, "role: a same-length role is not system");

    test_group("context_keep_last_floor");
    # The retained tail is floored so compaction cannot strip a conversation to nothing. Through the real
    # compact_messages since 2.9.12 (this group subtracted numbers before). Its character budget never drops below
    # 100, so these messages carry 150 bytes of padding each: at a 1-token budget none fits, and only the floor
    # survives.
    var kf20 = _t_msgs(20, 150);
    var kfr = compact_messages(kf20, strlen(kf20), 1, CHARS_PER_TOKEN_X10);
    var kf_out = load64(kfr);
    var kf_len = load64(kfr + 8);
    assert_eq(_t_count_n(kf_out, kf_len, "\"role\":"), 10, "context: floor keeps the last 10");
    assert_eq(_t_has(kf_out, kf_len, "\"content\":\"m10-") == 1 && _t_has(kf_out, kf_len, "\"content\":\"m9-") == 0,
      1, "context: ...the newest ten, m10 to m19");
    # keep_last 0 still guarantees one non-system message: forwarding only a system prompt is a request the
    # provider cannot answer usefully.
    context_configure(1, 0, 0);
    kfr = compact_messages(kf20, strlen(kf20), 1, CHARS_PER_TOKEN_X10);
    assert_eq(_t_count_n(load64(kfr), load64(kfr + 8), "\"role\":"), 1, "context: keep_last 0 still keeps one");
    assert_eq(_t_has(load64(kfr), load64(kfr + 8), "\"content\":\"m19-"), 1, "context: ...the newest");
    # The 100-character minimum: short messages still fit a 1-token budget, three of them here.
    var kfs20 = _t_msgs(20, 0);
    kfr = compact_messages(kfs20, strlen(kfs20), 1, CHARS_PER_TOKEN_X10);
    assert_eq(_t_count_n(load64(kfr), load64(kfr + 8), "\"role\":"), 3, "context: the budget never drops below 100");
    context_configure(1, 0, 10);
    # A conversation shorter than keep_last is kept whole.
    var kf3 = _t_msgs(3, 150);
    kfr = compact_messages(kf3, strlen(kf3), 1, CHARS_PER_TOKEN_X10);
    assert_eq(_t_count_n(load64(kfr), load64(kfr + 8), "\"role\":"), 3, "context: short conversation kept whole");

    # ── 2.6.8: the local streaming path reads the provider status ──
    test_group("stream_status_line");
    # stream_skip_headers already pulled the whole head into a buffer; the
    # status line was simply discarded, so a 404 was fed into the NDJSON loop
    # and finished as a clean 200 with finish_reason:"stop" and no content,
    # audited as a success.
    var sl200 = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n";
    assert_eq(_stream_status(sl200, strlen(sl200)), 200, "stream: 200 parsed");
    var sl404 = "HTTP/1.1 404 Not Found\r\n\r\n";
    assert_eq(_stream_status(sl404, strlen(sl404)), 404, "stream: 404 parsed");
    var sl500 = "HTTP/1.0 500 Internal Server Error\r\n\r\n";
    assert_eq(_stream_status(sl500, strlen(sl500)), 500, "stream: HTTP/1.0 status parsed");
    var sl429 = "HTTP/1.1 429 Too Many Requests\r\n\r\n";
    assert_eq(_stream_status(sl429, strlen(sl429)), 429, "stream: 429 parsed");
    # Unparseable heads report 0, which the caller treats as a failure rather
    # than assuming success.
    var slbad = "garbage\r\n\r\n";
    assert_eq(_stream_status(slbad, strlen(slbad)), 0, "stream: unparseable head → 0");
    var slshort = "HTTP/1.1 20\r\n\r\n";
    assert_eq(_stream_status(slshort, strlen(slshort)), 0, "stream: truncated code → 0");

    # ── 2.6.8: chunked Transfer-Encoding is refused, not mis-framed ──
    test_group("transfer_encoding");
    var te1 = "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n";
    assert_eq(req_has_transfer_encoding(te1, strlen(te1)), 1, "TE: chunked detected");
    var te2 = "POST / HTTP/1.1\r\nHost: h\r\ntransfer-encoding: Chunked\r\n\r\nx";
    assert_eq(req_has_transfer_encoding(te2, strlen(te2)), 1, "TE: case-insensitive");
    # identity is the no-op coding and needs no special handling.
    var te3 = "POST / HTTP/1.1\r\nTransfer-Encoding: identity\r\nContent-Length: 1\r\n\r\nx";
    assert_eq(req_has_transfer_encoding(te3, strlen(te3)), 0, "TE: identity is not chunked");
    var te4 = "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1\r\n\r\nx";
    assert_eq(req_has_transfer_encoding(te4, strlen(te4)), 0, "TE: absent header");
    # The literal in a BODY must not trip it — the scan stops at the header block.
    var te5 = "POST / HTTP/1.1\r\nHost: h\r\n\r\n{\"s\":\"transfer-encoding: chunked\"}";
    assert_eq(req_has_transfer_encoding(te5, strlen(te5)), 0, "TE: body text does not trip it");

    # ── 2.6.9: the authenticated caller is identified ──
    test_group("auth_identity");
    var idtoks = vec_new();
    vec_push(idtoks, "TENANT-A-KEY");
    vec_push(idtoks, "TENANT-B-KEY");
    var id_ra = "GET /v1/models HTTP/1.1\r\nAuthorization: Bearer TENANT-A-KEY\r\n\r\n";
    assert_eq(auth_check(id_ra, strlen(id_ra), idtoks), 1, "identity: tenant A authenticates");
    assert_eq(auth_identity(), 1, "identity: tenant A is caller 1");
    var id_rb = "GET /v1/models HTTP/1.1\r\nAuthorization: Bearer TENANT-B-KEY\r\n\r\n";
    assert_eq(auth_check(id_rb, strlen(id_rb), idtoks), 1, "identity: tenant B authenticates");
    assert_eq(auth_identity(), 2, "identity: tenant B is a DIFFERENT caller");
    # A rejected request leaves no identity behind for the next one on this
    # worker to inherit.
    var id_rbad = "GET /v1/models HTTP/1.1\r\nAuthorization: Bearer NOPE\r\n\r\n";
    assert_eq(auth_check(id_rbad, strlen(id_rbad), idtoks), 0, "identity: bad token rejected");
    assert_eq(auth_identity(), 0, "identity: rejection clears the identity");
    # Auth disabled means one shared namespace, identity 0.
    var noneToks = vec_new();
    assert_eq(auth_check(id_ra, strlen(id_ra), noneToks), 1, "identity: no tokens configured allows");
    assert_eq(auth_identity(), 0, "identity: unauthenticated deployments use identity 0");

    # ── 2.6.9: top-level parameter scanning is depth-aware ──
    test_group("top_level_key_scan");
    # These parameters were found by scanning the raw body at ANY offset, so an
    # identical key nested inside a tools JSON-Schema — where "temperature",
    # "max_tokens", "stream" and "messages" are ordinary property names — won
    # whenever it appeared first, and a tools array precedes the trailing
    # parameters in every OpenAI client that sends one.
    var tk1 = "{\"model\":\"m\",\"tools\":[{\"function\":{\"parameters\":{\"properties\":{\"max_tokens\":{\"type\":\"integer\"}}}}}],\"max_tokens\":64}";
    var vpos = _top_key_value(tk1, strlen(tk1), "\"max_tokens\"", 12);
    assert_eq(vpos > 0, 1, "topkey: top-level max_tokens located");
    assert_eq(load8(tk1 + vpos), 54, "topkey: and it is the REAL value (6 of 64), not the nested schema");

    # A nested "stream" must not be mistaken for the top-level one.
    var tk2 = "{\"tools\":[{\"properties\":{\"stream\":{\"type\":\"boolean\"}}}],\"stream\":true}";
    var spos = _top_key_value(tk2, strlen(tk2), "\"stream\"", 8);
    assert_eq(spos > 0, 1, "topkey: top-level stream located");
    assert_eq(memeq(tk2 + spos, "true", 4), 1, "topkey: and resolves to true, not the nested schema");

    # A key-shaped substring inside a STRING value is not a key.
    var tk3 = "{\"messages\":[{\"content\":\"talk about \\\"max_tokens\\\" please\"}],\"max_tokens\":7}";
    var mpos = _top_key_value(tk3, strlen(tk3), "\"max_tokens\"", 12);
    assert_eq(load8(tk3 + mpos), 55, "topkey: a key-shaped substring in content is skipped");

    # Absent key reports -1 rather than a false hit.
    var tk4 = "{\"model\":\"m\",\"messages\":[]}";
    assert_eq(_top_key_value(tk4, strlen(tk4), "\"temperature\"", 13), 0 - 1,
      "topkey: absent key → -1");
    # Whitespace between key, colon and value is tolerated.
    var tk5 = "{\"top_p\"  :   0.9}";
    var ppos = _top_key_value(tk5, strlen(tk5), "\"top_p\"", 7);
    assert_eq(load8(tk5 + ppos), 48, "topkey: whitespace around the colon is skipped");
    # Depth 2+ only, with no top-level key, is a miss.
    var tk6 = "{\"tools\":[{\"properties\":{\"temperature\":{\"type\":\"number\"}}}]}";
    assert_eq(_top_key_value(tk6, strlen(tk6), "\"temperature\"", 13), 0 - 1,
      "topkey: a nested-only key is not found at top level");

    # ── 2.6.9: DLP sees through JSON escapes ──
    test_group("dlp_json_escapes");
    dlp_configure(1, CLASS_PUBLIC);
    # The scanner was handed the UNDECODED body while _extract_messages forwards
    # that same span to the provider, which decodes it — so hoosh scanned one
    # string and shipped a different one. Every built-in pattern was defeated by
    # writing the payload with escapes.
    var esc_ssn = "{\"messages\":[{\"content\":\"ssn 123\\u002d45\\u002d6789\"}]}";
    assert_eq(dlp_scan_level(esc_ssn, strlen(esc_ssn)), CLASS_PUBLIC,
      "dlp/json: raw scan is blind to the escaped SSN (documents the old gap)");
    assert_eq(dlp_scan_level_json(esc_ssn, strlen(esc_ssn)), CLASS_RESTRICTED,
      "dlp/json: decoded scan catches the escaped SSN");

    # A fully \u-escaped API key — what an evader writes, and what Python's
    # json.dumps produces for any non-ASCII with ensure_ascii=True.
    var esc_key = "{\"q\":\"\\u0073\\u006b\\u002dabcdefghijklmnopqrstuvwxyz012345\"}";
    assert_eq(dlp_scan_level(esc_key, strlen(esc_key)), CLASS_PUBLIC,
      "dlp/json: raw scan is blind to the escaped api key");
    assert_eq(dlp_scan_level_json(esc_key, strlen(esc_key)), CLASS_RESTRICTED,
      "dlp/json: decoded scan catches the escaped api key");

    # Plain (unescaped) content classifies identically through both entry points.
    var plain_ssn = "{\"messages\":[{\"content\":\"ssn 123-45-6789\"}]}";
    assert_eq(dlp_scan_level_json(plain_ssn, strlen(plain_ssn)), CLASS_RESTRICTED,
      "dlp/json: plain SSN still restricted");
    var clean = "{\"messages\":[{\"content\":\"what is the capital of France\"}]}";
    assert_eq(dlp_scan_level_json(clean, strlen(clean)), CLASS_PUBLIC,
      "dlp/json: clean prompt stays public");
    # An escaped but harmless body must not be promoted.
    var clean_esc = "{\"messages\":[{\"content\":\"caf\\u00e9 \\u2014 nice\"}]}";
    assert_eq(dlp_scan_level_json(clean_esc, strlen(clean_esc)), CLASS_PUBLIC,
      "dlp/json: escaped but clean content stays public");

    # The decoder itself.
    var dlen = alloc(8);
    var d1 = dlp_json_decode("a\\u002db", 8, dlen);
    assert_eq(load64(dlen), 3, "dlp/json: \\u002d decodes to one byte");
    assert_eq(load8(d1 + 1), 45, "dlp/json: and that byte is '-'");
    var d2 = dlp_json_decode("x\\ty\\nz", 7, dlen);
    assert_eq(load64(dlen), 5, "dlp/json: short escapes decode");
    assert_eq(load8(d2 + 1), 9, "dlp/json: \\t is a tab");
    # Non-BMP-safe: a lone surrogate becomes U+FFFD (3 bytes), never raw.
    var d3 = dlp_json_decode("\\ud800", 6, dlen);
    assert_eq(load64(dlen), 3, "dlp/json: lone surrogate becomes U+FFFD");
    # A malformed escape is passed through rather than swallowing input.
    var d4 = dlp_json_decode("a\\uZZZZb", 8, dlen);
    assert_eq(load64(dlen) > 0, 1, "dlp/json: malformed \\u is passed through");
    # Disabled scanner short-circuits both entry points.
    dlp_configure(0, CLASS_PUBLIC);
    assert_eq(dlp_scan_level_json(esc_ssn, strlen(esc_ssn)), CLASS_PUBLIC,
      "dlp/json: disabled returns the default level");
    dlp_configure(1, CLASS_PUBLIC);

    # ── 2.6.8: rate-limiter refill keeps its remainder ──
    test_group("ratelimit_refill_remainder");
    # add = rpm * elapsed_ms * 1000 / 60000 truncates to 0 for a small
    # elapsed_ms, and the old code stamped last_refill = now regardless, so the
    # interval was discarded. _rl_refill runs on EVERY check including rejected
    # ones, so a client polling faster than one token's worth of time never
    # accumulated anything: at the real 5-6 ms tick, rate_limit = 5 granted
    # 0 rpm outright.
    var rl5 = hoosh_ratelimit_new(5);
    store64(rl5 + 8, 0);                       # drain the bucket
    var t_before = hoosh_now_ms() - 5;         # only 5 ms of credit
    store64(rl5 + 16, t_before);
    _rl_refill(rl5);
    assert_eq(load64(rl5 + 16), t_before,
      "ratelimit: a sub-token interval does not advance the clock");
    assert_eq(load64(rl5 + 8), 0, "ratelimit: and grants no token yet");

    # Enough elapsed time for exactly one token at 5 rpm is 12 s.
    var rl5b = hoosh_ratelimit_new(5);
    store64(rl5b + 8, 0);
    store64(rl5b + 16, hoosh_now_ms() - 12000);
    _rl_refill(rl5b);
    assert_eq(load64(rl5b + 8), 1000, "ratelimit: 12 s at 5 rpm grants exactly one token");
    assert_eq(hoosh_ratelimit_check(rl5b), 1, "ratelimit: that token is spendable");

    # The bucket never exceeds its ceiling.
    var rl5c = hoosh_ratelimit_new(5);
    store64(rl5c + 16, hoosh_now_ms() - 600000);
    _rl_refill(rl5c);
    assert_eq(load64(rl5c + 8), 5000, "ratelimit: refill is capped at rpm * 1000");

    # rpm 0 means unlimited and must never be rate limited.
    var rl0 = hoosh_ratelimit_new(0);
    assert_eq(hoosh_ratelimit_check(rl0), 1, "ratelimit: rpm 0 is unlimited");
    assert_eq(hoosh_ratelimit_check(0), 1, "ratelimit: a null limiter allows");

    # ── 2.6.7: api_key detection covers modern key formats ──
    test_group("dlp_apikey_formats");
    # The body used to require 20+ CONSECUTIVE alnum after the prefix, so every
    # current key — which carries internal separators — stopped the run almost
    # immediately and went entirely undetected.
    assert_eq(_dlp_test("key: sk-proj-abcdefghijklmnopqrstuvwxyz1234567890"),
      CLASS_RESTRICTED, "dlp: OpenAI sk-proj- key detected");
    assert_eq(_dlp_test("key: sk-ant-api03-abcdefghijklmnopqrstuvwxyz1234"),
      CLASS_RESTRICTED, "dlp: Anthropic sk-ant-api03- key detected");
    # The legacy consecutive-alnum form still matches.
    assert_eq(_dlp_test("key: sk-abcdefghijklmnopqrstuvwxyz012345"),
      CLASS_RESTRICTED, "dlp: legacy sk- key still detected");
    # Case-folded prefix words.
    assert_eq(_dlp_test("API_KEY=abcdefghijklmnopqrstuvwxyz01"),
      CLASS_RESTRICTED, "dlp: uppercase API_KEY= prefix detected");
    assert_eq(_dlp_test("Api-Key: abcdefghijklmnopqrstuvwxyz01"),
      CLASS_RESTRICTED, "dlp: mixed-case Api-Key: prefix detected");
    # Still no false positive on a short token.
    assert_eq(_dlp_test("sk-short"), CLASS_PUBLIC, "dlp: short sk- token is not a key");

    # ── 2.6.7: budget clamps on client-supplied token counts ──
    test_group("budget_negative_clamp");
    # /v1/tokens/report passes the client's `actual` straight to pool_commit,
    # and str_to_int honours a leading `-`. A negative commit used to ERASE
    # recorded usage, push pool_available above capacity, and persist that.
    var clampb = pool_new("clamp-test", 1000);
    pool_commit(clampb, 0, 400);
    assert_eq(load64(clampb + POOL_USED), 400, "budget: normal commit records usage");
    pool_commit(clampb, 0, 0 - 1000);
    assert_eq(load64(clampb + POOL_USED), 400, "budget: negative commit is ignored, not subtracted");
    assert_eq(pool_available(clampb), 600, "budget: available never exceeds capacity after a negative commit");

    # A negative reservation passed the `available < tokens` test trivially and
    # then DECREASED the outstanding reservation.
    var clampb2 = pool_new("clamp-test-2", 1000);
    assert_eq(pool_reserve(clampb2, 0 - 500), 0, "budget: negative reservation refused");
    assert_eq(load64(clampb2 + POOL_RESERVED), 0, "budget: refused reservation changes nothing");
    assert_eq(pool_reserve(clampb2, 300), 1, "budget: normal reservation still works");
    assert_eq(load64(clampb2 + POOL_RESERVED), 300, "budget: reservation recorded");

    # ── 2.6.7: trailing-backslash escape scanning ──
    test_group("json_escape_scan");
    # All six JSON string scanners decided "is this quote escaped?" from the
    # single preceding byte, which is wrong when that byte is itself an escaped
    # backslash. A value ending in `\\` — a Windows path, LaTeX, a shell
    # continuation, a regex — then swallowed its own closing quote and ran on
    # into the surrounding structure.
    var esc1 = "{\"content\":\"C:\\\\path\\\\\",\"role\":\"assistant\"}";
    var v1 = _json_extract_str(esc1, strlen(esc1), "content", 7);
    assert_eq(streq(v1, "C:\\\\path\\\\"), 1, "escape: value ending in an escaped backslash stops at its own quote");

    # An escaped quote inside the value is still not a terminator.
    var esc2 = "{\"content\":\"say \\\"hi\\\" now\",\"role\":\"assistant\"}";
    var v2 = _json_extract_str(esc2, strlen(esc2), "content", 7);
    assert_eq(streq(v2, "say \\\"hi\\\" now"), 1, "escape: escaped quotes stay inside the value");

    # Plain value, no escapes — unchanged behaviour.
    var esc3 = "{\"content\":\"plain text\"}";
    var v3 = _json_extract_str(esc3, strlen(esc3), "content", 7);
    assert_eq(streq(v3, "plain text"), 1, "escape: unescaped value unchanged");

    # A following field must still be reachable after a backslash-terminated
    # value — the old scanner consumed it.
    var esc_role = _json_extract_str(esc1, strlen(esc1), "role", 4);
    assert_eq(streq(esc_role, "assistant"), 1, "escape: field after a backslash-ending value is still found");

    # _json_obj_end must bound the object correctly with such a value inside.
    var objs = "{\"a\":\"x\\\\\"}{\"b\":\"y\"}";
    assert_eq(_json_obj_end(objs, strlen(objs), 0), 11,
      "escape: object end is not swallowed by a trailing escaped backslash");

    # ── 2.6.7: Authorization header matching ──
    test_group("auth_header_match");
    var atoks = vec_new();
    vec_push(atoks, "SECRET-KEY-1");
    vec_push(atoks, "SECRET-KEY-2");

    var a_ok = "GET /v1/models HTTP/1.1\r\nHost: h\r\nAuthorization: Bearer SECRET-KEY-1\r\n\r\n";
    assert_eq(auth_check(a_ok, strlen(a_ok), atoks), 1, "auth: canonical-case header accepted");

    # HTTP/2 mandates lowercase field names, and hyper/reqwest + undici/fetch
    # send lowercase on HTTP/1.1 too. This used to 401 with a correct token.
    var a_lc = "GET /v1/models HTTP/1.1\r\nhost: h\r\nauthorization: Bearer SECRET-KEY-1\r\n\r\n";
    assert_eq(auth_check(a_lc, strlen(a_lc), atoks), 1, "auth: lowercase header accepted");
    var a_mx = "GET /v1/models HTTP/1.1\r\nAUTHORIZATION: bearer SECRET-KEY-2\r\n\r\n";
    assert_eq(auth_check(a_mx, strlen(a_mx), atoks), 1, "auth: mixed-case header and scheme accepted");

    # A Proxy-Authorization line must not shadow the real header: the old
    # unanchored match fired inside it and then abandoned the scan.
    var a_px = "GET /v1/models HTTP/1.1\r\nProxy-Authorization: Basic Zm9vOmJhcg==\r\nAuthorization: Bearer SECRET-KEY-1\r\n\r\n";
    assert_eq(auth_check(a_px, strlen(a_px), atoks), 1, "auth: Proxy-Authorization does not shadow the real header");

    # A non-Bearer Authorization line must not stop the scan either.
    var a_bs = "GET /v1/models HTTP/1.1\r\nAuthorization: Basic Zm9vOmJhcg==\r\n\r\n";
    assert_eq(auth_check(a_bs, strlen(a_bs), atoks), 0, "auth: Basic scheme alone is rejected");

    var a_bad = "GET /v1/models HTTP/1.1\r\nAuthorization: Bearer WRONG-KEY\r\n\r\n";
    assert_eq(auth_check(a_bad, strlen(a_bad), atoks), 0, "auth: wrong token rejected");
    var a_none = "GET /v1/models HTTP/1.1\r\nHost: h\r\n\r\n";
    assert_eq(auth_check(a_none, strlen(a_none), atoks), 0, "auth: missing header rejected");

    # A token-shaped string in the BODY is not a credential.
    var a_body = "POST /v1/chat HTTP/1.1\r\nHost: h\r\n\r\nAuthorization: Bearer SECRET-KEY-1";
    assert_eq(auth_check(a_body, strlen(a_body), atoks), 0, "auth: body text is not a credential");

    # No configured tokens still means allow-all (unchanged).
    var empty_toks = vec_new();
    assert_eq(auth_check(a_none, strlen(a_none), empty_toks), 1, "auth: no tokens configured allows all");

    # ── 2.6.6: compact_messages boundary scan ──
    test_group("compact_boundary_scan");
    # The scan used to test every byte for `{` + `"role"` with no notion of
    # nesting or string context, and stored into a fixed alloc(1024) — 128
    # slots — with no bound check. handlers.cyr caps an inbound request at
    # MAX_MESSAGES=256 using _json_array_count, which counts only depth-1
    # elements, so the two disagreed: ONE valid message whose content is a
    # nested array of objects carrying a "role" key drove the count into the
    # hundreds and wrote past the table.
    var nest_sb = str_builder_new();
    str_builder_add_cstr(nest_sb, "[{\"role\":\"user\",\"content\":[");
    var ni = 0;
    while (ni < 300) {
        if (ni > 0) { str_builder_add_cstr(nest_sb, ","); }
        str_builder_add_cstr(nest_sb, "{\"role\":\"x\"}");
        ni = ni + 1;
    }
    str_builder_add_cstr(nest_sb, "]}]");
    var nest = to_cstr(str_builder_build(nest_sb));
    var nest_len = strlen(nest);
    # max_tokens 1 forces the compaction path rather than the already-fits
    # early return, so the boundary scan actually runs.
    var nres = compact_messages(nest, nest_len, 1, CHARS_PER_TOKEN_X10);
    assert_neq(nres, 0, "compact: nested role objects do not crash the scan");
    var nout_len = load64(nres + 8);
    assert_eq(nout_len > 0, 1, "compact: nested-role input still produces output");
    # Depth-aware now: the 300 nested objects are part of the single message,
    # so the result keeps that one message rather than slicing it apart.
    var nout = load64(nres);
    assert_eq(load8(nout), 91, "compact: output is still a JSON array");

    # A conversation of 200 real messages is legal (MAX_MESSAGES=256) but
    # exceeded the old 128-slot table outright.
    var many_sb = str_builder_new();
    str_builder_add_cstr(many_sb, "[");
    var cmi = 0;
    while (cmi < 200) {
        if (cmi > 0) { str_builder_add_cstr(many_sb, ","); }
        str_builder_add_cstr(many_sb, "{\"role\":\"user\",\"content\":\"hello there\"}");
        cmi = cmi + 1;
    }
    str_builder_add_cstr(many_sb, "]");
    var many = to_cstr(str_builder_build(many_sb));
    var mres = compact_messages(many, strlen(many), 20, CHARS_PER_TOKEN_X10);
    assert_neq(mres, 0, "compact: 200 real messages do not overflow the table");
    assert_eq(load64(mres + 8) > 0, 1, "compact: 200-message compaction produces output");

    # A `{"role"` sequence inside a STRING value is not a boundary.
    var strq = "[{\"role\":\"user\",\"content\":\"literal {\\\"role\\\": here\"}]";
    var sres = compact_messages(strq, strlen(strq), 1, CHARS_PER_TOKEN_X10);
    assert_neq(sres, 0, "compact: brace-role inside a string value is safe");

    # ── v2.5.10 DLP custom patterns ──
    test_group("dlp_custom_patterns");
    # Case-insensitive LITERAL match, not regex: hoosh has no regex engine, and
    # compiling operator-supplied patterns would put a backtracking matcher fed
    # by config on the request path — a ReDoS surface. Literal is the capability
    # that ports safely.
    var cp = "Project BLUEJAY is confidential";
    assert_eq(_dlp_find_ci(cp, strlen(cp), "bluejay"), 8, "dlp: lowercase pattern matches mixed case");
    assert_eq(_dlp_find_ci(cp, strlen(cp), "BLUEJAY"), 8, "dlp: exact case matches");
    assert_eq(_dlp_find_ci(cp, strlen(cp), "Bluejay"), 8, "dlp: mixed case matches");
    assert_eq(_dlp_find_ci(cp, strlen(cp), "goshawk"), 0 - 1, "dlp: absent pattern -> -1");
    # A pattern longer than the text cannot match and must not read past the end.
    assert_eq(_dlp_find_ci("hi", 2, "much longer pattern"), 0 - 1, "dlp: over-long pattern safe");
    # Empty pattern is rejected rather than matching everything at offset 0.
    assert_eq(_dlp_find_ci(cp, strlen(cp), ""), 0 - 1, "dlp: empty pattern never matches");
    # Match at the very start and the very end.
    assert_eq(_dlp_find_ci("acme-1234", 9, "acme"), 0, "dlp: match at start");
    assert_eq(_dlp_find_ci("id-acme", 7, "acme"), 3, "dlp: match at end");
    # Custom levels raise the classification; the highest of several wins (2.9.3: dlp.cyr's own
    # dlp_custom_add / dlp_custom_level / dlp_custom_hit_name, not a max() helper).
    dlp_custom_clear();
    assert_eq(dlp_custom_add("empty", "", CLASS_RESTRICTED), 0, "dlp: an empty pattern is not added");
    assert_eq(dlp_custom_add("codename", "bluejay", CLASS_CONFIDENTIAL), 1, "dlp: a pattern is added");
    assert_eq(dlp_custom_add("partner", "acme-", CLASS_RESTRICTED), 1, "dlp: a second pattern is added");
    assert_eq(dlp_custom_count(), 2, "dlp: two custom patterns");
    var dcb = "Project BLUEJAY for ACME-7";
    assert_eq(dlp_custom_level(dcb, strlen(dcb)), CLASS_RESTRICTED, "dlp: highest custom level wins");
    assert_eq(dlp_custom_level(cp, strlen(cp)), CLASS_CONFIDENTIAL, "dlp: only the matching pattern counts");
    assert_eq(dlp_custom_level("nothing here", 12), 0 - 1, "dlp: no match -> -1");
    assert_streq(dlp_custom_hit_name(dcb, strlen(dcb)), "codename", "dlp: the first matching rule is named");
    dlp_custom_clear();
    dlp_custom_add("partner", "acme-", CLASS_RESTRICTED);
    dlp_custom_add("codename", "bluejay", CLASS_CONFIDENTIAL);
    assert_eq(dlp_custom_level(dcb, strlen(dcb)), CLASS_RESTRICTED, "dlp: order-independent");
    dlp_custom_clear();
    # A custom pattern can reach restricted, same as a built-in.
    assert_eq(CLASS_RESTRICTED > CLASS_CONFIDENTIAL, 1, "dlp: restricted outranks confidential");

    # ── 2.5.12: the cache signal and the per-response cost ────────
    # Before this, a cache hit was byte-indistinguishable from a fresh
    # inference, so a caching consumer re-billed every hit; and the cost hoosh
    # had already computed never reached the client, forcing consumers to
    # re-implement the pricing table.

    var hit = _t_respond_capture("200", "OK", "{}", "X-Hoosh-Cache: HIT");
    assert_eq(str_contains(hit, str_from("X-Hoosh-Cache: HIT")) , 1,
      "cache: an exact hit is labelled HIT");
    assert_eq(str_contains(hit, str_from("Content-Length: 2")), 1,
      "cache: the extra header does not disturb Content-Length");
    assert_eq(str_contains(hit, str_from("\r\n\r\n")), 1,
      "cache: the header block still terminates with a blank line");

    var sem = _t_respond_capture("200", "OK", "{}", "X-Hoosh-Cache: SEMANTIC");
    assert_eq(str_contains(sem, str_from("X-Hoosh-Cache: SEMANTIC")), 1,
      "cache: a semantic hit is labelled SEMANTIC, distinct from an exact hit");

    var miss = _t_respond_capture("200", "OK", "{}", "X-Hoosh-Cache: MISS");
    assert_eq(str_contains(miss, str_from("X-Hoosh-Cache: MISS")), 1,
      "cache: a real forward is labelled MISS");

    # The pre-2.5.12 entry point must be byte-identical to what it always was —
    # ten call sites still use it.
    var plain = _t_respond_capture("200", "OK", "{}", 0);
    assert_eq(str_contains(plain, str_from("X-Hoosh-Cache")), 0,
      "cache: http_respond with no extra header emits none");
    assert_eq(str_contains(plain, str_from("Content-Type: application/json")), 1,
      "cache: and keeps the standard header set");
    assert_eq(str_len(plain) + strlen("X-Hoosh-Cache: MISS") + 2, str_len(miss),
      "cache: the ONLY difference is that header line plus its CRLF — nothing else in the \
    response changed shape");

    # usage now carries the cost hoosh already computed, in the same integer
    # micro-USD unit estimate_cost_micro returns — no conversion, no rounding.
    # 2.9.21: the real _chat_completion_body (provider_err.cyr), not a copy of its usage block.
    var u = _chat_completion_body("gpt-4o-mini", "hi", 1000, 500, 0, 450, "openai", FIN_STOP);
    assert_eq(str_contains(u, str_from("\"cost_micro_usd\":450")), 1,
      "usage: carries the integer micro-USD cost");
    assert_eq(str_contains(u, str_from("\"provider\":\"openai\"")), 1,
      "usage: and the REAL serving provider, which a model-name guess gets wrong \
    whenever DLP re-routes a confidential request to a local one");
    assert_eq(str_contains(u, str_from("\"total_tokens\":1500")), 1,
      "usage: the pre-existing fields are unchanged");
    # The whole envelope: the head chat_id_new just started, the message, the finish reason, then usage closing
    # both objects.
    var ue = str_builder_new();
    sb_add_chat_head(ue, "chat.completion");
    str_builder_add_cstr(ue, "\"model\":\"gpt-4o-mini\",\"choices\":[{\"index\":0,\"message\":");
    str_builder_add_cstr(ue, "{\"role\":\"assistant\",\"content\":\"hi\"},\"finish_reason\":\"stop\"}],");
    str_builder_add_cstr(ue, "\"usage\":{\"prompt_tokens\":1000,\"completion_tokens\":500,\"total_tokens\":1500,");
    str_builder_add_cstr(ue, "\"cost_micro_usd\":450,\"provider\":\"openai\"}}");
    assert_streq(to_cstr(u), to_cstr(str_builder_build(ue)), "completion: the whole envelope");
    # Tool calls ride in the message and make the finish "tool_calls", unless the reply was cut short.
    var ut = to_cstr(_chat_completion_body("gpt-4o-mini", "", 3, 2, "[{\"id\":\"c1\"}]", 0, 0, FIN_STOP));
    var ut_want = "\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\"}]},\"finish_reason\":\"tool_calls\"";
    assert_eq(_t_has(ut, strlen(ut), ut_want), 1, "completion: tool calls in the message, finish tool_calls");
    var utl = to_cstr(_chat_completion_body("gpt-4o-mini", "", 3, 2, "[{\"id\":\"c1\"}]", 0, 0, FIN_LENGTH));
    assert_eq(_t_has(utl, strlen(utl), "\"finish_reason\":\"length\""), 1,
      "completion: a cut-off reply with tool calls still says length");
    var utn = to_cstr(_chat_completion_body("gpt-4o-mini", "x", 3, 2, 0, 0, 0, FIN_NONE));
    assert_eq(_t_has(utn, strlen(utn), "\"finish_reason\":\"stop\""), 1,
      "completion: no reason from the provider reads as stop");

    # cost_record now RETURNS what it accumulated, so the response body reports
    # the same value rather than a second computation that merely ought to agree.
    cost_reset();
    var cr_returned = cost_record(PROV_OPENAI, "https://api.openai.com",
      1000, 500, "gpt-4o-mini");
    assert_eq(cr_returned, 450, "usage: cost_record returns the micro-USD it just recorded");
    assert_eq(cr_returned, cost_total_micro(),
      "usage: and it equals what landed in the record — same value by construction, so a client \
    summing per-response costs cannot drift from /v1/costs");

    # The figure is exactly what cost_record accumulates — same function, same
    # arguments — so a per-response sum reconciles with /v1/costs.
    assert_eq(estimate_cost_micro("gpt-4o-mini", PROV_OPENAI, 1000, 500), 450,
      "usage: the response cost IS estimate_cost_micro, so it reconciles with /v1/costs");

    # A local provider is free, and that has to survive into the response.
    var ul_cost = estimate_cost_micro("llama3", PROV_OLLAMA, 1000, 1000);
    var ul = _chat_completion_body("llama3", "hi", 1000, 1000, 0, ul_cost, "ollama", FIN_STOP);
    assert_eq(str_contains(ul, str_from("\"cost_micro_usd\":0")), 1,
      "usage: a local model reports zero cost rather than omitting the field");

    # provider is optional in the builder; omitting it must not emit an empty key.
    assert_eq(str_contains(_chat_completion_body("m", "x", 1, 1, 0, 0, 0, FIN_STOP), str_from("provider")), 0,
      "usage: an absent provider omits the field entirely");

    # ================================================================
    # 2.6.5 — the provider's OWN error, kept rather than thrown away
    # ================================================================
    # ⚠ A non-2xx from a provider used to vanish: the body was dropped and one fixed sentence was
    # logged. Downstream, `handle_chat_stream` had already sent 200 OK, so the turn finished with a
    # clean `finish_reason:"stop"` and no content — a well-formed, successful, EMPTY completion. thoth
    # reported "response had neither tool calls nor content" and its operator spent a session believing
    # the model had gone quiet. An error laundered into a success is worse than a crash.
    assert_eq(provider_last_error_status(), 0,
      "provider_err: no error captured yet");
    assert_eq(str_contains(str_from(provider_err_log_line()), str_from("permanent error")), 1,
      "provider_err: with nothing captured, the pre-2.6.5 sentence is still emitted (an alloc failure must not cost the log line)");
    assert_eq(str_contains(str_from(provider_err_client_msg()), str_from("unreachable")), 1,
      "provider_err: and the caller still hears the generic 502 wording");

    # A real provider error: status + the `message` the provider put in its body.
    var pe_msg = "prompt is too long: 213914 tokens > 200000 maximum";
    provider_err_set(400, pe_msg, strlen(pe_msg));
    assert_eq(provider_last_error_status(), 400, "provider_err: the status is kept");
    assert_streq(provider_last_error_msg(), pe_msg, "provider_err: and so is the provider's own wording");
    assert_eq(str_contains(str_from(provider_err_log_line()), str_from("HTTP 400")), 1,
      "provider_err: the log line names the STATUS, not just 'permanent'");
    assert_eq(str_contains(str_from(provider_err_log_line()), str_from("213914 tokens")), 1,
      "provider_err: and carries the reason an operator actually needs");
    # "unreachable" was wrong for the common case — a 4xx means the provider WAS reached and refused.
    assert_eq(str_contains(str_from(provider_err_client_msg()), str_from("unreachable")), 0,
      "provider_err: a refusal is no longer reported to the caller as an unreachable backend");
    assert_eq(str_contains(str_from(provider_err_client_msg()), str_from("HTTP 400")), 1,
      "provider_err: the caller is told which status it was");

    # Untrusted bytes: bounded, and flattened to ONE line so a body full of newlines cannot break the
    # log record it lands in.
    var pe_long = alloc(PROVIDER_ERR_MSG_CAP * 2);
    var pe_i = 0;
    while (pe_i < (PROVIDER_ERR_MSG_CAP * 2 - 1)) { store8(pe_long + pe_i, 65); pe_i = pe_i + 1; }
    store8(pe_long + pe_i, 0);
    provider_err_set(500, pe_long, strlen(pe_long));
    assert_eq(strlen(provider_last_error_msg()), PROVIDER_ERR_MSG_CAP - 1,
      "provider_err: an over-long provider body is bounded, not copied whole");
    var pe_ctl = alloc(16);
    store8(pe_ctl + 0, 97); store8(pe_ctl + 1, 10); store8(pe_ctl + 2, 9); store8(pe_ctl + 3, 98); store8(pe_ctl + 4, 0);
    provider_err_set(429, pe_ctl, 4);
    assert_streq(provider_last_error_msg(), "a  b",
      "provider_err: newlines and tabs become spaces — one error is one log line");

    # provider_err_reset must make a stale error unattributable to a later request.
    provider_err_reset();
    assert_eq(provider_last_error_status(), 0, "provider_err: reset clears the status");
    assert_streq(provider_last_error_msg(), "", "provider_err: and the message");

    # ── the SSE error frame ──────────────────────────────────────
    # The headers are already gone (http_sse_begin sends 200 before the provider is called), so the
    # failure has to be reported IN the stream. finish_reason is "error", not "stop".
    var se = upstream_error_sse_body("claude-opus-5", 400, "prompt is too long");
    assert_eq(str_contains(str_from(se), str_from("\"error\":{\"type\":\"upstream_error\",\"code\":400")), 1,
      "sse error frame: carries an error object with the upstream status");
    assert_eq(str_contains(str_from(se), str_from("\"finish_reason\":\"error\"")), 1,
      "sse error frame: finish_reason is 'error', so a client branching on it is not told 'stop'");
    assert_eq(str_contains(str_from(se), str_from("claude-opus-5")), 1,
      "sse error frame: names the model, like every other chunk");
    # The message is provider-controlled: a bare quote would produce a malformed frame and take out the
    # very client this exists to inform.
    var se_esc = upstream_error_sse_body("m", 401, "bad \"key\" and a \\ slash");
    assert_eq(str_contains(str_from(se_esc), str_from("bad \\\"key\\\" and a \\\\ slash")), 1,
      "sse error frame: quotes and backslashes in the provider's message are JSON-escaped");

    # ── recognising an IN-STREAM provider error ──────────────────
    # ⚠ A provider that has already sent 200 OK cannot change its status either, so it reports a
    # mid-stream failure as an EVENT. hoosh's stream callback looked only for text, thinking and tool
    # deltas, so such a frame extracted to empty everywhere and was skipped — the stream then ended
    # normally and the client received a clean, successful, EMPTY completion. Measured live: a request
    # the non-streaming path answered fine came back from the streaming path with no content and
    # NOTHING in hoosh's own log.
    var ev_err = sandhi_sse_event_new("error", "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}", 0, 0 - 1);
    var d_err = sandhi_sse_event_data(ev_err);
    assert_eq(_sse_is_error_event(ev_err, d_err, strlen(d_err)), 1,
      "sse error detect: Anthropic names the SSE event 'error'");
    assert_streq(_sse_error_message(d_err, strlen(d_err)), "Overloaded",
      "sse error detect: the provider's own wording is what surfaces");

    # OpenAI-compatible backends leave the event unnamed and put the shape in the data frame.
    var ev_oai = sandhi_sse_event_new(0, "{\"type\":\"error\",\"message\":\"context length exceeded\"}", 0, 0 - 1);
    var d_oai = sandhi_sse_event_data(ev_oai);
    assert_eq(_sse_is_error_event(ev_oai, d_oai, strlen(d_oai)), 1,
      "sse error detect: an unnamed frame is recognised structurally, by \"type\":\"error\"");
    assert_streq(_sse_error_message(d_oai, strlen(d_oai)), "context length exceeded",
      "sse error detect: and its message is extracted");

    # ⚠ NO SUBSTRING GUESSING. A model's own prose routinely contains the word "error", and a false
    # positive here aborts a perfectly good stream mid-answer.
    var ev_txt = sandhi_sse_event_new(0, "{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"the error was in your regex\"}}", 0, 0 - 1);
    var d_txt = sandhi_sse_event_data(ev_txt);
    assert_eq(_sse_is_error_event(ev_txt, d_txt, strlen(d_txt)), 0,
      "sse error detect: a content delta whose TEXT says 'error' is NOT an error frame");
    var ev_ping = sandhi_sse_event_new("ping", "{\"type\":\"ping\"}", 0, 0 - 1);
    var d_ping = sandhi_sse_event_data(ev_ping);
    assert_eq(_sse_is_error_event(ev_ping, d_ping, strlen(d_ping)), 0,
      "sse error detect: a keep-alive ping is not an error");

    # A provider that errors without saying why still produces a usable line.
    var ev_bare = sandhi_sse_event_new("error", "{\"type\":\"error\"}", 0, 0 - 1);
    var d_bare = sandhi_sse_event_data(ev_bare);
    assert_eq(_sse_is_error_event(ev_bare, d_bare, strlen(d_bare)), 1, "sse error detect: bare error frame recognised");
    assert_eq(str_contains(str_from(_sse_error_message(d_bare, strlen(d_bare))), str_from("no message")), 1,
      "sse error detect: a message-less error still reports SOMETHING rather than an empty string");

    # 2.8.0 groups (defined above main)
    _t280_catalog_parse_anthropic();
    _t280_catalog_parse_others();
    _t280_catalog_id_and_units();
    _t280_catalog_thinking_plan();
    _t280_catalog_request_options();
    _t280_catalog_snapshot();
    _t280_catalog_emit_entry();
    _t280_catalog_metadata_and_pricing();
    _t280_outcome_finish();
    _t280_outcome_stream_usage();
    _t280_outcome_tool_guard();
    _t280_sse_split_boundary();
    _t280_openai_extras();
    _t280_urlparse();
    _t281_catalog_out_cap();
    _t2925_lookup_index();
    _t2926_request_path();
    _t2102_error_writers();
    _t2102_error_capture();
    _t2102_error_utf8();
    _t2102_response_head();
    _t2102_catalog_kind();
    _t2102_catalog_lend();
    _t2102_catalog_held();
    _t2102_listing_arena();
    _t2103_trace_child();
    _t2103_trace_wire();
    _t2103_trace_jobs();
    _t2103_request_arena();
    _t2103_arena_boundary();
    _t2103_stream_chunks();
    _t2103_event_ring();
    _t211_tentib_local();

    # ── Summary ───────────────────────────────────────────────────
    var total_failures = assert_summary();
    return total_failures;
}

var r = main();
sys_exit(r);
