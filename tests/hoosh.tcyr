# Semantic cache: semantic.cyr's own (2.9.4, included at the top).

# Build an int vector from N values for tests.
fn _vec2(x, y) {
    var v = alloc(16);
    store64(v, x);
    store64(v + 8, y);
    return v;
}

# Extract tools from a cstr body literal, return the span as a cstr (or 0).
fn _etools(s) {
    var n = strlen(s);
    var b = alloc(n + 1);
    memcpy(b, s, n);
    var r = _extract_tools(b, n);
    if (r == 0) { return 0; }
    var p = load64(r);
    var l = load64(r + 8);
    var o = alloc(l + 1);
    memcpy(o, p, l);
    store8(o + l, 0);
    return o;
}

# 2.9.5: one slot of metrics.cyr's OWN latency histogram (not a mirror: it reads the real storage, laid out
# PROV_COUNT x (NLAT_BUCKETS + 1), the last slot per provider being the overflow).
fn _t_lat_slot(prov, b) {
    return load64(_lat_counts + (prov * (NLAT_BUCKETS + 1) + b) * 8);
}

# 2.9.20: wq_push on a thread, for the backpressure test: it returns only once a pop has made room.
var _t_wq_pushed = 0;
fn _t_wq_pusher(job) {
    wq_push(job);
    atomic_store(&_t_wq_pushed, 1);
    return 0;
}

