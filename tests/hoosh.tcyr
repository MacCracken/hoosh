    assert_streq(provider_name(PROV_ONNX), "onnx", "name onnx");

    # ── Router: priority routing ──────────────────────────────────
    test_group("router_priority");

    var pats1 = alloc(8);
    store64(pats1, "llama*");
    var pats2 = alloc(8);
    store64(pats2, "gpt-*");

    var r1 = route_new(PROV_OLLAMA, 1, "http://localhost:11434");
    route_set_patterns(r1, pats1, 1);
    var r2 = route_new(PROV_OPENAI, 2, "https://api.openai.com");
    route_set_patterns(r2, pats2, 1);

    var routes = alloc(16);
    store64(routes, r1);
    store64(routes + 8, r2);

    var rt = router_new(routes, 2, STRAT_PRIORITY);

    var sel = router_select(rt, "llama3");
    assert(sel != 0, "priority: llama3 found");
    assert_eq(route_provider(sel), PROV_OLLAMA, "priority: llama3 -> ollama");

    sel = router_select(rt, "gpt-4o");
    assert(sel != 0, "priority: gpt-4o found");
    assert_eq(route_provider(sel), PROV_OPENAI, "priority: gpt-4o -> openai");

    sel = router_select(rt, "claude-sonnet");
    assert_eq(sel, 0, "priority: claude-sonnet not found");

    # ── Router: wildcard route ────────────────────────────────────
    test_group("router_wildcard");

    var wr = route_new(PROV_OLLAMA, 1, "http://localhost:11434");
    var wroutes = alloc(8);
    store64(wroutes, wr);
    var wrt = router_new(wroutes, 1, STRAT_PRIORITY);
    assert(router_select(wrt, "anything") != 0, "wildcard matches anything");

    # ── Router: disabled route skipped ────────────────────────────
    test_group("router_disabled");

    var dr = route_new(PROV_OLLAMA, 1, "http://localhost:11434");
    route_set_enabled(dr, 0);
    var droutes = alloc(8);
    store64(droutes, dr);
    var drt = router_new(droutes, 1, STRAT_PRIORITY);
    assert_eq(router_select(drt, "llama3"), 0, "disabled route skipped");

    # ── Router: round robin ───────────────────────────────────────
    test_group("router_round_robin");

    var rr1 = route_new(PROV_OLLAMA, 1, "http://ollama");
    var rr2 = route_new(PROV_LLAMACPP, 1, "http://llamacpp");
    var rroutes = alloc(16);
    store64(rroutes, rr1);
    store64(rroutes + 8, rr2);
    var rrrt = router_new(rroutes, 2, STRAT_ROUND_ROBIN);

    var first = route_provider(router_select(rrrt, "llama3"));
    var second = route_provider(router_select(rrrt, "llama3"));
    assert(first != second, "round robin alternates");

    # ── Router: lowest latency ────────────────────────────────────
    test_group("router_lowest_latency");

    var ll1 = route_new(PROV_OLLAMA, 2, "http://ollama");
    var ll2 = route_new(PROV_LLAMACPP, 1, "http://llamacpp");
    var llroutes = alloc(16);
    store64(llroutes, ll1);
    store64(llroutes + 8, ll2);
    var llrt = router_new(llroutes, 2, STRAT_LOWEST_LATENCY);
    router_report_latency(llrt, "http://llamacpp", 500);
    router_report_latency(llrt, "http://ollama", 50);

    sel = router_select(llrt, "any");
    assert_eq(route_provider(sel), PROV_OLLAMA, "lowest latency picks fastest");

    # ── Router: latency EMA ───────────────────────────────────────
    test_group("router_latency_ema");

    var ema_r = route_new(PROV_OLLAMA, 1, "http://localhost");
    var ema_routes = alloc(8);
    store64(ema_routes, ema_r);
    var ema_rt = router_new(ema_routes, 1, STRAT_LOWEST_LATENCY);
    router_report_latency(ema_rt, "http://localhost", 100);
    router_report_latency(ema_rt, "http://localhost", 200);
    # EMA: (100*7 + 200*3)/10 = 130
    var lat_map = load64(ema_rt + ROUTER_LATENCIES);
    assert_eq(map_get(lat_map, "http://localhost"), 130, "latency EMA 130");
    router_report_latency(ema_rt, "http://localhost", 50);
    # EMA: (130*7 + 50*3)/10 = 106
    assert_eq(map_get(lat_map, "http://localhost"), 106, "latency EMA 106");

    # ── Router: exact model match ─────────────────────────────────
    test_group("router_exact_match");

    var expats = alloc(8);
    store64(expats, "llama3.2:latest");
    var exr = route_new(PROV_OLLAMA, 1, "http://localhost:11434");
    route_set_patterns(exr, expats, 1);
    var exroutes = alloc(8);
    store64(exroutes, exr);
    var exrt = router_new(exroutes, 1, STRAT_PRIORITY);
    assert(router_select(exrt, "llama3.2:latest") != 0, "exact match found");
    assert_eq(router_select(exrt, "llama3.2"), 0, "partial exact no match");

    # ── Router: multiple model patterns ───────────────────────────
    test_group("router_multi_patterns");

    var mpats = alloc(16);
    store64(mpats, "llama*");
    store64(mpats + 8, "mistral*");
    var mpr = route_new(PROV_OLLAMA, 1, "http://localhost:11434");
    route_set_patterns(mpr, mpats, 2);
    var mproutes = alloc(8);
    store64(mproutes, mpr);
    var mprt = router_new(mproutes, 1, STRAT_PRIORITY);
    assert(router_select(mprt, "llama3") != 0, "multi: llama3 matches");
    assert(router_select(mprt, "mistral-7b") != 0, "multi: mistral-7b matches");
    assert_eq(router_select(mprt, "gpt-4o"), 0, "multi: gpt-4o no match");

    # ── Token pool basic ──────────────────────────────────────────
    test_group("token_pool");

    var tp = pool_new("test", 1000);
    assert_eq(pool_available(tp), 1000, "pool initial available");
    assert(pool_reserve(tp, 400) == 1, "pool reserve 400");
    assert_eq(pool_available(tp), 600, "pool available after reserve");
    pool_commit(tp, 400, 350);
    assert_eq(pool_used(tp), 350, "pool used after commit");
    assert_eq(pool_reserved(tp), 0, "pool reserved after commit");
    assert_eq(pool_available(tp), 650, "pool available after commit");
    # A completion can use more than was reserved, so used can pass capacity: available floors at 0 rather than
    # going negative (GET /v1/tokens/pools reports it).
    var ovp = pool_new("over", 1000);
    pool_reserve(ovp, 900);
    pool_commit(ovp, 900, 1200);
    assert_eq(pool_used(ovp), 1200, "pool: an overspend is recorded in full");
    assert_eq(pool_available(ovp), 0, "pool: available floors at 0 once used passes capacity");

    # ── Token pool over budget ────────────────────────────────────
    test_group("token_pool_over_budget");

    var op = pool_new("small", 100);
    assert(pool_reserve(op, 200) == 0, "cannot reserve over capacity");
    assert_eq(pool_reserved(op), 0, "a refused reserve takes nothing");

    # ── Token pool release ────────────────────────────────────────
    test_group("token_pool_release");

    var rp = pool_new("release", 1000);
    pool_reserve(rp, 500);
    pool_commit(rp, 500, 0);   # a release is a commit of nothing, as the handlers do it
    assert_eq(pool_reserved(rp), 0, "reserved 0 after release");
    assert_eq(pool_available(rp), 1000, "available restored after release");

    # ── Budget multi-pool ─────────────────────────────────────────
    test_group("budget_multi_pool");

    var bgt = budget_new();
    budget_add_pool(bgt, pool_new("default", 10000));
    budget_add_pool(bgt, pool_new("agent-1", 5000));
    assert(pool_available(budget_get_pool(bgt, "default")) >= 8000, "default can reserve 8k");
    assert(pool_available(budget_get_pool(bgt, "agent-1")) < 8000, "agent-1 cannot reserve 8k");
    assert_eq(budget_get_pool(bgt, "nonexistent"), 0, "nonexistent pool fails");
    assert_eq(budget_reserve(bgt, "nonexistent", 1), 0, "reserving from a nonexistent pool fails");

    # ── Budget reserve + report ───────────────────────────────────
    test_group("budget_reserve_report");

    var bgt2 = budget_new();
    budget_add_pool(bgt2, pool_new("pool", 1000));
    assert(budget_reserve(bgt2, "pool", 500) == 1, "budget reserve 500");
    pool_commit(budget_get_pool(bgt2, "pool"), 500, 420);
    var bp = budget_get_pool(bgt2, "pool");
    assert_eq(pool_used(bp), 420, "budget used 420");
    assert_eq(pool_reserved(bp), 0, "budget reserved 0");

    # ── 2.9.13: storage.cyr for real — persistence round trips through a real patra database ──
    test_group("storage_roundtrip");
    # Off by default: every entry point is a no-op.
    assert_eq(storage_audit_insert(1, 2, "e", "info", "m", 0, 0, "s", "p", "h"), 0,
      "storage: off, a write-through does nothing");
    assert_eq(storage_restore_budgets(budget_new()), 0, "storage: off, nothing restored");
    patra_init();
    var st_path = _t_cat(_t_line("/tmp/hoosh-tcyr-", sys_getpid(), ""), ".db");
    var st_wal = _t_cat(st_path, ".wal");
    sys_unlink(st_path);
    sys_unlink(st_wal);
    _storage = storage_open(st_path);
    assert_eq(_storage != 0, 1, "storage: a database opens");
    # Audit: three entries written through, then a fresh chain restored from disk.
    var st_c = audit_chain_new("k", 1, 100);
    audit_record(st_c, "inference.request", "info", "one", "ollama", "llama3");
    audit_record(st_c, "inference.request", "info", "two", "openai", "gpt-4o");
    audit_record(st_c, "admin.costs_reset", "warn", "three", "admin", "");
    # A provider or model of 0 ("none") is not the same as "": the entry hash adds ":provider" only for a non-zero
    # one. patra has no NULL, and through 2.9.12 a 0 came back from disk as "", so such an entry verified until a
    # restart and failed after it. Its own database, so the counts below stay three.
    var nn_path = _t_cat(st_path, ".none");
    sys_unlink(nn_path);
    var nn_saved = _storage;
    _storage = storage_open(nn_path);
    var nn_c = audit_chain_new("k", 1, 100);
    audit_record(nn_c, "e", "info", "no provider, no model", 0, 0);
    audit_record(nn_c, "e", "info", "empty provider and model", "", "");
    var nn_r = audit_chain_new("k", 1, 100);
    assert_eq(storage_restore_audit(nn_r), 2, "storage: both rows restored");
    assert_eq(audit_verify(nn_r), 1, "storage: an entry without provider or model verifies after a restore");
    assert_eq(load64(load64(nn_r + 24) + 40), 0, "storage: a 0 provider comes back as 0");
    assert_streq(load64(load64(nn_r + 32) + 40), "", "storage: an empty provider comes back empty");
    patra_close(_storage);
    _storage = nn_saved;
    sys_unlink(nn_path);
    sys_unlink(_t_cat(nn_path, ".wal"));
    var st_r = audit_chain_new("k", 1, 100);
    assert_eq(storage_restore_audit(st_r), 3, "storage: three audit rows restored");
    assert_eq(audit_count(st_r), 3, "storage: the restored chain holds them");
    assert_eq(audit_verify(st_r), 1, "storage: the restored chain verifies");
    assert_eq(load64(st_r + 56), 4, "storage: new records continue at id 4");
    assert_streq(load64(st_r + 16), load64(st_c + 16), "storage: the restored last hash is the one written");
    audit_record(st_r, "inference.request", "info", "four", "ollama", "llama3");
    assert_eq(audit_verify(st_r), 1, "storage: a record after a restore extends the chain");
    # 2.9.13: a chain with a smaller max_entries keeps only the newest rows, and still verifies.
    var st_small = audit_chain_new("k", 1, 2);
    assert_eq(storage_restore_audit(st_small), 4, "storage: all four rows read");
    assert_eq(audit_count(st_small), 2, "storage: trimmed to max_entries");
    assert_streq(load64(load64(st_small + 24) + 32), "three", "storage: the newest two kept");
    assert_eq(audit_verify(st_small), 1, "storage: the trimmed chain verifies");
    # Budgets: a commit writes the pool's used count, one row per pool; a fresh budget restores it.
    var st_b = budget_new();
    var st_p = pool_new("team", 10000);
    budget_add_pool(st_b, st_p);
    pool_reserve(st_p, 500);
    pool_commit(st_p, 500, 420);
    pool_reserve(st_p, 100);
    pool_commit(st_p, 100, 80);
    var st_b2 = budget_new();
    var st_p2 = pool_new("team", 10000);
    budget_add_pool(st_b2, st_p2);
    assert_eq(storage_restore_budgets(st_b2), 1, "storage: one budget row per pool");
    assert_eq(pool_used(st_p2), 500, "storage: the restored pool's used count");
    patra_close(_storage);
    _storage = 0;
    sys_unlink(st_path);
    sys_unlink(st_wal);

    # ── Cache basic ───────────────────────────────────────────────
    test_group("cache");

    var ca = cache_new(1000, 1, 0);
    cache_insert(ca, "key1", 42);
    assert_eq(cache_get(ca, "key1"), 42, "cache get hit");
    assert_eq(cache_get(ca, "missing"), 0, "cache get miss");
    assert_eq(cache_hits(ca), 1, "cache 1 hit");
    assert_eq(cache_misses(ca), 1, "cache 1 miss");

    # ── Cache disabled ────────────────────────────────────────────
    test_group("cache_disabled");

    var cd = cache_new(1000, 0, 0);
    cache_insert(cd, "key", 99);
    assert_eq(cache_get(cd, "key"), 0, "disabled cache returns 0");

    # ── Cache clear ───────────────────────────────────────────────
    test_group("cache_clear");

    var cc = cache_new(1000, 1, 0);
    cache_insert(cc, "a", 1);
    cache_insert(cc, "b", 2);
    assert_eq(cache_len(cc), 2, "cache len 2");
    # 2.9.7: a cache_clear assertion stood here; that function existed only in this file (src has none).

    # ── Cost tracker: local free ──────────────────────────────────
    test_group("cost_tracker");

    assert_eq(estimate_cost_micro("anything", PROV_OLLAMA, 1000, 500), 0, "local provider free");
    assert_eq(estimate_cost_micro("anything", PROV_LLAMACPP, 1000, 500), 0, "llamacpp free");
    assert_eq(estimate_cost_micro("anything", PROV_SYNAPSE, 1000, 500), 0, "synapse free");

    # ── Cost tracker: known model pricing ─────────────────────────
    test_group("cost_pricing");

    # gpt-4o: $2.5M input, $10M output → for 1M tokens input only = $2.50 = 2500000 microdollars
    var gpt_cost = estimate_cost_micro("gpt-4o", PROV_OPENAI, 1000000, 0);
    assert_eq(gpt_cost, 2500000, "gpt-4o 1M input = $2.50");

    # ── Cost tracker: prefix match ────────────────────────────────
    test_group("cost_prefix");

    var sonnet_cost = estimate_cost_micro("claude-sonnet-4-20250514", PROV_ANTHROPIC, 1000000, 0);
    assert_eq(sonnet_cost, 3000000, "claude-sonnet-4 prefix match = $3.00");

    # ── Cost tracker: accumulation ────────────────────────────────
    test_group("cost_accumulation");

    # 2.9.3: pricing.cyr's own tracker (it replaced a mirror keyed by provider NAME, the keying 2.5.6 dropped).
    # Record: provider(0) base_url(8) in(16) out(24) cost_micro(32) reqs(40).
    cost_reset();
    cost_record(PROV_OPENAI, "https://api.openai.com", 100, 50, "gpt-4o");
    cost_record(PROV_OPENAI, "https://api.openai.com", 100, 50, "gpt-4o");
    assert_eq(cost_record_count(), 1, "openai record exists");
    var rec = cost_record_at(0);
    assert_eq(load64(rec + 40), 2, "2 requests accumulated");
    assert_eq(load64(rec + 16), 200, "200 input tokens");
    assert_eq(load64(rec + 24), 100, "100 output tokens");

    # ── Cost tracker: separate providers ──────────────────────────
    test_group("cost_separate_providers");

    cost_reset();
    cost_record(PROV_OPENAI, "https://api.openai.com", 100, 50, "gpt-4o");
    cost_record(PROV_ANTHROPIC, "https://api.anthropic.com", 100, 50, "claude-sonnet-4");
    assert_eq(cost_record_count(), 2, "openai and anthropic are separate records");
    assert_eq(load64(cost_record_at(0)), PROV_OPENAI, "openai record");
    assert_eq(load64(cost_record_at(1)), PROV_ANTHROPIC, "anthropic record");

    # ── Queue: priority ordering ──────────────────────────────────
    test_group("queue_priority");

    var q = queue_new();
    queue_enqueue(q, "llama3", "default", "req-1", PRI_NORMAL);
    queue_enqueue(q, "gpt-4o", "default", "req-2", PRI_CRITICAL);

    var item = queue_dequeue(q);
    assert(item != 0, "dequeue item 1");
    assert_streq(load64(item + QITEM_ID), "req-2", "critical first");

    item = queue_dequeue(q);
    assert(item != 0, "dequeue item 2");
    assert_streq(load64(item + QITEM_ID), "req-1", "normal second");

    # ── Queue: empty returns 0 ────────────────────────────────────
    test_group("queue_empty");

    var eq = queue_new();
    assert_eq(queue_dequeue(eq), 0, "empty queue returns 0");
    assert(queue_is_empty(eq) == 1, "queue is empty");

    # ── Queue: len tracking ───────────────────────────────────────
    test_group("queue_len");

    var lq = queue_new();
    assert_eq(queue_len(lq), 0, "initial len 0");
    queue_enqueue(lq, "m", "p", "r1", PRI_NORMAL);
    assert_eq(queue_len(lq), 1, "len 1 after enqueue");
    queue_enqueue(lq, "m", "p", "r2", PRI_HIGH);
    assert_eq(queue_len(lq), 2, "len 2");
    queue_dequeue(lq);
    assert_eq(queue_len(lq), 1, "len 1 after dequeue");
    queue_dequeue(lq);
    assert_eq(queue_len(lq), 0, "len 0 after drain");

    # ── Queue: all 5 tiers ────────────────────────────────────────
    test_group("queue_all_tiers");

    var tq = queue_new();
    queue_enqueue(tq, "m", "p", "normal", PRI_NORMAL);
    queue_enqueue(tq, "m", "p", "background", PRI_BACKGROUND);
    queue_enqueue(tq, "m", "p", "critical", PRI_CRITICAL);
    queue_enqueue(tq, "m", "p", "low", PRI_LOW);
    queue_enqueue(tq, "m", "p", "high", PRI_HIGH);

    assert_eq(queue_len(tq), 5, "5 items queued");
    assert_streq(load64(queue_dequeue(tq) + QITEM_ID), "critical", "tier: critical first");
    assert_streq(load64(queue_dequeue(tq) + QITEM_ID), "high", "tier: high second");
    assert_streq(load64(queue_dequeue(tq) + QITEM_ID), "normal", "tier: normal third");
    assert_streq(load64(queue_dequeue(tq) + QITEM_ID), "low", "tier: low fourth");
    assert_streq(load64(queue_dequeue(tq) + QITEM_ID), "background", "tier: background last");
    assert(queue_is_empty(tq) == 1, "queue empty after drain");

    # ── Queue: same priority FIFO ─────────────────────────────────
    test_group("queue_fifo");

    var fq = queue_new();
    queue_enqueue(fq, "m", "p", "first", PRI_NORMAL);
    queue_enqueue(fq, "m", "p", "second", PRI_NORMAL);
    queue_enqueue(fq, "m", "p", "third", PRI_NORMAL);
    assert_streq(load64(queue_dequeue(fq) + QITEM_ID), "first", "fifo: first");
    assert_streq(load64(queue_dequeue(fq) + QITEM_ID), "second", "fifo: second");
    assert_streq(load64(queue_dequeue(fq) + QITEM_ID), "third", "fifo: third");

    # ================================================================
    # ROUTER EXTRAS �� direct routing, cost tracker reset
    # ================================================================

    test_group("router_direct");

    var dir1 = route_new(PROV_OLLAMA, 1, "http://localhost");
    var dir2 = route_new(PROV_LLAMACPP, 2, "http://localhost2");
    var dir_routes = alloc(16);
    store64(dir_routes, dir1);
    store64(dir_routes + 8, dir2);
    var dir_rt = router_new(dir_routes, 2, STRAT_DIRECT);
    sel = router_select(dir_rt, "any-model");
    assert_eq(route_provider(sel), PROV_OLLAMA, "direct picks first");

    test_group("cost_tracker_reset");

    cost_reset();
    cost_record(PROV_OPENAI, "https://api.openai.com", 100, 50, "gpt-4o");
    assert_eq(cost_record_count(), 1, "pre-reset: record exists");
    assert(cost_total_micro() > 0, "pre-reset: spend recorded");
    cost_reset();
    assert_eq(cost_record_count(), 0, "post-reset: empty");
    assert_eq(cost_total_micro(), 0, "post-reset: no spend");

    # ================================================================
    # CACHE EXTRAS — stats tracking, eviction counting
    # ================================================================

    test_group("cache_stats_initial");

    var cs = cache_new(1000, 1, 0);
    assert_eq(cache_hits(cs), 0, "initial: 0 hits");
    assert_eq(cache_misses(cs), 0, "initial: 0 misses");
    assert_eq(cache_evictions(cs), 0, "initial: 0 evictions");

    test_group("cache_stats_hit_miss");

    var cs2 = cache_new(1000, 1, 0);
    cache_insert(cs2, "key", 42);
    cache_get(cs2, "key");      # hit
    cache_get(cs2, "missing");  # miss
    cache_get(cs2, "key");      # hit
    assert_eq(cache_hits(cs2), 2, "stats: 2 hits");
    assert_eq(cache_misses(cs2), 1, "stats: 1 miss");

    test_group("cache_eviction_at_capacity");

    var cs3 = cache_new(3, 1, 0);
    cache_insert(cs3, "a", 1);
    cache_insert(cs3, "b", 2);
    cache_insert(cs3, "c", 3);
    # 4th insert evicts (2.9.7: the real cache evicts; the copy only counted)
    cache_insert(cs3, "d", 4);
    assert_gte(cache_evictions(cs3), 1, "eviction counted at capacity");
    assert_eq(cache_len(cs3), 3, "eviction: capacity is held at 3");

    # ================================================================
    # AUDIT CHAIN — audit.cyr for real since 2.9.12 (HMAC-SHA256 linked entries, tamper detection)
    # ================================================================
    # Entry: id 0, ts 8, event 16, level 24, message 32, provider 40, model 48, sig 56, prev 64, hash 72, next 80.
    # Chain: key 0, key_len 8, last_hash 16, head 24, tail 32, count 40, max 48, next_id 56, anchor 64.

    test_group("audit_chain");
    sha256_global_init();
    var ach = audit_chain_new("test-signing-key", 16, 100);
    var ae1 = audit_record(ach, "inference.request", "info", "Request to llama3", "ollama", "llama3");
    var ae2 = audit_record(ach, "inference.response", "info", "Response from llama3", 0, 0);
    assert_eq(audit_count(ach), 2, "audit: 2 entries");
    assert_eq(audit_verify(ach), 1, "audit: chain verifies");
    assert_eq(load64(ae1) == 1 && load64(ae2) == 2, 1, "audit: ids count up from 1");
    assert_streq(load64(ae1 + 64), GENESIS_HASH, "audit: the first entry links to GENESIS");
    assert_streq(load64(ae2 + 64), load64(ae1 + 72), "audit: the second links to the first's hash");
    assert_streq(load64(ae1 + 72),
      _audit_entry_hash(1, load64(ae1 + 8), "inference.request", "info", "Request to llama3", "ollama", "llama3"),
      "audit: the hash covers id, time, event, level, message, provider and model");
    assert_eq(strlen(load64(ae1 + 56)), 64, "audit: the signature is 64 hex characters");
    assert(streq(load64(ae1 + 72), load64(ae2 + 72)) != 1, "audit: entry hashes unique");

    test_group("audit_tamper");
    # Each kind of tampering fails verification; undoing it verifies again.
    store64(ae1 + 32, "TAMPERED");
    assert_eq(audit_verify(ach), 0, "audit: a changed message is caught");
    store64(ae1 + 32, "Request to llama3");
    assert_eq(audit_verify(ach), 1, "audit: restored, it verifies");
    store64(ae1 + 48, "gpt-4o");
    assert_eq(audit_verify(ach), 0, "audit: a changed model is caught, the hash covers it");
    store64(ae1 + 48, "llama3");
    var ac_prev2 = load64(ae2 + 64);
    store64(ae2 + 64, "deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef");
    assert_eq(audit_verify(ach), 0, "audit: a broken prev link is caught");
    store64(ae2 + 64, ac_prev2);
    var ac_sig1 = load64(ae1 + 56);
    store64(ae1 + 56, load64(ae2 + 56));
    assert_eq(audit_verify(ach), 0, "audit: a swapped signature is caught");
    store64(ae1 + 56, ac_sig1);
    store64(ach, "other-signing-key");
    store64(ach + 8, 17);
    assert_eq(audit_verify(ach), 0, "audit: another key does not verify");
    store64(ach, "test-signing-key");
    store64(ach + 8, 16);
    assert_eq(audit_verify(ach), 1, "audit: everything restored, it verifies");

    test_group("audit_excision_detected");
    # The check that matters and that production LACKED until 2.5.7: removing a record entirely. Every surviving
    # entry is byte-identical, so its own hash and HMAC still verify; only the linkage breaks. A verifier that
    # checks entries but not links reports a clean chain over doctored evidence. Through 2.9.11 this group checked
    # an inline copy of the chain, which is how a verifier without the link check once passed its tests.
    var ae3 = audit_record(ach, "inference.request", "info", "third", 0, 0);
    assert_eq(audit_verify(ach), 1, "audit: intact chain verifies");
    store64(ae1 + 80, ae3);
    assert_eq(audit_verify(ach), 0, "audit: excised middle entry detected");
    store64(ae1 + 80, ae2);
    assert_eq(audit_verify(ach), 1, "audit: relinked, it verifies");

    test_group("audit_eviction");
    # 2.9.12: a chain at max_entries evicts its oldest entry and keeps verifying. It used to demand GENESIS of the
    # first entry forever, so past max_entries (default 10000) GET /v1/audit reported "valid":false, the same
    # answer as tampering. The evicted entry's hash is now the anchor the first entry must link to.
    var aev = audit_chain_new("k", 1, 2);
    var av1 = audit_record(aev, "e", "info", "one", 0, 0);
    var av2 = audit_record(aev, "e", "info", "two", 0, 0);
    assert_streq(load64(aev + 64), GENESIS_HASH, "audit: the anchor starts at GENESIS");
    var av3 = audit_record(aev, "e", "info", "three", 0, 0);
    assert_eq(audit_count(aev), 2, "audit: held at max_entries");
    assert_eq(load64(aev + 24), av2, "audit: the oldest entry was evicted");
    assert_streq(load64(aev + 64), load64(av1 + 72), "audit: the anchor is the evicted entry's hash");
    assert_eq(audit_verify(aev), 1, "audit: an evicted chain still verifies");
    var ajs = str_builder_new();
    audit_json(aev, ajs, 50);
    var ajs_s = str_data(str_builder_build(ajs));
    assert_eq(_t_has(ajs_s, strlen(ajs_s), "{\"count\":2,\"valid\":true,"), 1, "audit: /v1/audit says valid");
    # Removing the front entry is still caught: the next one does not link to the anchor.
    store64(aev + 24, av3);
    assert_eq(audit_verify(aev), 0, "audit: an entry removed at the front is caught");
    store64(aev + 24, av2);
    audit_record(aev, "e", "info", "four", 0, 0);
    assert_eq(audit_verify(aev), 1, "audit: it keeps verifying as it rotates");

    # ================================================================
    # CONFIG PARSING — TOML sections for server, providers, cache
    # ================================================================

    test_group("config_parse_minimal");

    var cfg_src = str_from("[[server]]\nbind = \"127.0.0.1\"\nport = \"8088\"\n");
    var cfg_sections = toml_parse(cfg_src);
    assert(cfg_sections != 0, "config: parsed minimal toml");

    # Find [server] section
    var cfg_srv = bayan_toml_get_sections_by_cstr(cfg_sections, "server");
    assert(vec_len(cfg_srv) > 0, "config: server section found");

    test_group("config_defaults");

    # Verify default values (toml_get returns str, use str_eq_cstr)
    var cfg_pairs = toml_section_pairs(vec_get(cfg_srv, 0));
    var cfg_bind = bayan_toml_get_by_cstr(cfg_pairs, "bind");
    assert(str_eq_cstr(cfg_bind, "127.0.0.1") == 1, "config: default bind");
    var cfg_port = bayan_toml_get_by_cstr(cfg_pairs, "port");
    assert(str_eq_cstr(cfg_port, "8088") == 1, "config: default port");

    test_group("config_provider_section");

    var cfg2_src = str_from("[[server]]\nbind = \"0.0.0.0\"\nport = \"8088\"\n\n[[providers]]\ntype = \"ollama\"\nbase_url = \"http://localhost:11434\"\npriority = \"1\"\n");
    var cfg2_secs = toml_parse(cfg2_src);
    var cfg2_provs = bayan_toml_get_sections_by_cstr(cfg2_secs, "providers");
    assert(vec_len(cfg2_provs) > 0, "config: providers section found");
    var cfg2_pairs = toml_section_pairs(vec_get(cfg2_provs, 0));
    var cfg2_ptype = bayan_toml_get_by_cstr(cfg2_pairs, "type");
    assert(str_eq_cstr(cfg2_ptype, "ollama") == 1, "config: provider type=ollama");
    var cfg2_purl = bayan_toml_get_by_cstr(cfg2_pairs, "base_url");
    assert(str_eq_cstr(cfg2_purl, "http://localhost:11434") == 1, "config: provider base_url");

    test_group("config_cache_section");

    var cfg3_src = str_from("[[cache]]\nenabled = \"true\"\nmax_entries = \"10000\"\nttl_secs = \"3600\"\n");
    var cfg3_secs = toml_parse(cfg3_src);
    var cfg3_cache = bayan_toml_get_sections_by_cstr(cfg3_secs, "cache");
    assert(vec_len(cfg3_cache) > 0, "config: cache section found");
    var cfg3_pairs = toml_section_pairs(vec_get(cfg3_cache, 0));
    var cfg3_enabled = bayan_toml_get_by_cstr(cfg3_pairs, "enabled");
    assert(str_eq_cstr(cfg3_enabled, "true") == 1, "config: cache enabled=true");
    var cfg3_max = bayan_toml_get_by_cstr(cfg3_pairs, "max_entries");
    assert(str_eq_cstr(cfg3_max, "10000") == 1, "config: cache max=10000");

    # ================================================================
    # JSON — parse/build for inference request/response types
    # ================================================================

    test_group("json_parse_basic");

    var j_src = str_from("{\"model\":\"llama3\",\"prompt\":\"hello\",\"temperature\":\"0.7\"}");
    var j_pairs = json_parse(j_src);
    assert(j_pairs != 0, "json: parsed basic object");
    var j_model = bayan_json_get_by_cstr(j_pairs, "model");
    assert(str_eq_cstr(j_model, "llama3") == 1, "json: model=llama3");
    var j_prompt = bayan_json_get_by_cstr(j_pairs, "prompt");
    assert(str_eq_cstr(j_prompt, "hello") == 1, "json: prompt=hello");

    test_group("json_build");

    var j_out_pairs = vec_new();
    vec_push(j_out_pairs, json_pair_new(str_from("model"), str_from("gpt-4o")));
    vec_push(j_out_pairs, json_pair_new(str_from("status"), str_from("ok")));
    var j_out = json_build(j_out_pairs);
    assert(j_out != 0, "json: built output");
