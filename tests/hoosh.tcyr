# ================================================================
# Provider route — heap-allocated struct
# Layout: provider(8) priority(8) patterns_ptr(8) patterns_count(8)
#         enabled(8) base_url(8) api_key(8) rate_limit_rpm(8)
# Total: 64 bytes
# ================================================================

fn _ckey(model, body) {
    return _cache_key(model, body, strlen(body));
}

# Whitespace compression: compression.cyr's own (2.9.4, included at the top).
# Compress a cstr JSON literal, return the collapsed cstr (compress_ws_json returns (ptr, len); ptr is a cstr).
fn _compress(s) {
    var n = strlen(s);
    var b = alloc(n + 1);
    memcpy(b, s, n);
    store8(b + n, 0);
    return load64(compress_ws_json(b, n));
}

