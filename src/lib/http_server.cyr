# http_server.cyr — HTTP response helpers, request parsing, CRLF handling

# CRLF as a process-lifetime constant. 2.5.11: this used to alloc(3) on every
# call and it is called several times per response, against an arena that never
# frees — a few bytes each time, but per request forever.
var _CRLF = 0;

fn make_crlf() {
    if (_CRLF == 0) {
        var buf = alloc(3);
        store8(buf, 13);
        store8(buf + 1, 10);
        store8(buf + 2, 0);
        _CRLF = buf;
    }
    return _CRLF;
}

fn to_cstr(s) {
    if (s == 0) { return ""; }
    var len = str_len(s);
    var buf = alloc(len + 1);
    memcpy(buf, str_data(s), len);
    store8(buf + len, 0);
    return buf;
}

# `s` written at p, as much of it as fits before `end`. Returns the new p.
fn _head_add(p, end, s) {
    var n = strlen(s);
    if (n > end - p) { n = end - p; }
    memcpy(p, s, n);
    return p + n;
}

# `v` in decimal at p, or none of it when it does not fit before `end`. Returns the new p.
fn _head_add_int(p, end, v) {
    var t[24];
    var n = fmt_int_buf(v, &t);
    if (n > end - p) { return p; }
    memcpy(p, &t, n);
    return p + n;
}

# Respond with one optional extra header line.
#
# `extra_hdr` is a NUL-terminated `Name: value` cstr with no CRLF of its own, or
# 0 for none. Added in 2.5.12 to carry `X-Hoosh-Cache`; kept as a separate entry
# point so the ten existing `http_respond` call sites are untouched.
#
# 2.10.2: the head is written on this stack. A builder and two copies kept 792 bytes per response on the heap that
# never frees (ADR 013), whatever the handler had done. Every part of a head is a short constant but the length, so
# 512 bytes is room to spare; a part that did not fit would be cut, not written past the end.
fn http_respond_h(cfd, status, status_text, body, body_len, extra_hdr) {
    var cr = make_crlf();
    var head[512];
    var end = &head + 512;
    var p = _head_add(&head, end, "HTTP/1.1 ");
    p = _head_add(p, end, status);
    p = _head_add(p, end, " ");
    p = _head_add(p, end, status_text);
    p = _head_add(p, end, cr);
    p = _head_add(p, end, "Content-Type: application/json");
    p = _head_add(p, end, cr);
    p = _head_add(p, end, "Access-Control-Allow-Origin: *");
    p = _head_add(p, end, cr);
    p = _head_add(p, end, "Connection: close");
    p = _head_add(p, end, cr);
    p = _head_add(p, end, "Content-Length: ");
    p = _head_add_int(p, end, body_len);
    p = _head_add(p, end, cr);
    if (extra_hdr != 0) {
        p = _head_add(p, end, extra_hdr);
        p = _head_add(p, end, cr);
    }
    p = _head_add(p, end, cr);
    sys_write(cfd, &head, p - &head);
    sys_write(cfd, body, body_len);
    return 0;
}

# Respond with the standard header set. The pre-2.5.12 entry point.
fn http_respond(cfd, status, status_text, body, body_len) {
    return http_respond_h(cfd, status, status_text, body, body_len, 0);
}

# Send SSE stream header (no Content-Length, chunked)
# 2.10.3: written on this stack, as http_respond_h's head is. It is a constant, and through 2.10.2 it was built and
# copied twice per stream on the heap that never frees: 760 bytes kept.
fn http_sse_begin(cfd) {
    var head[256];
    var end = &head + 256;
    var p = _head_add(&head, end, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n");
    p = _head_add(p, end, "Cache-Control: no-cache\r\nAccess-Control-Allow-Origin: *\r\n");
    p = _head_add(p, end, "Connection: keep-alive\r\n\r\n");
    sys_write(cfd, &head, p - &head);
    return 0;
}

# Send one SSE data event. Returns 0 normally, -1 once the peer is gone.
#
# 2.5.11: the return value is new, and callers must honor it. 2.4.13 installed
# the SIGPIPE guard so a disconnected client stopped KILLING the gateway, and
# recorded what remained (resolved here in 2.5.11): with the signal ignored,
# writes to a dead socket just
# return EPIPE and the stream loop kept going — hoosh would pull the entire
# remaining response from the provider and write it into a closed socket. That
# burns a worker and real provider tokens for a client that already left, and an
# unauthenticated caller can trigger it in a loop.
fn http_sse_event(cfd, data, data_len) {
    if (sys_write(cfd, "data: ", 6) < 0) { return 0 - 1; }
    if (sys_write(cfd, data, data_len) < 0) { return 0 - 1; }
    if (sys_write(cfd, "\n\n", 2) < 0) { return 0 - 1; }
    return 0;
}

# Send SSE [DONE] marker
# An SSE comment line (": <text>\n\n"). Clients ignore it; it keeps idle
# proxies from closing a quiet stream (2.7.0). -1 when the client is gone.
var SSE_KEEPALIVE_S = 15;
fn http_sse_comment(cfd, text) {
    if (sys_write(cfd, ": ", 2) < 0) { return 0 - 1; }
    if (sys_write(cfd, text, strlen(text)) < 0) { return 0 - 1; }
    if (sys_write(cfd, "\n\n", 2) < 0) { return 0 - 1; }
    return 0;
}

# Remote-stream keep-alive (2.9.2). sandhi calls this after every idle_ms of
# upstream silence (sandhi_http_options_idle_ms / _idle_cb, sandhi 1.10.5+) with
# the stream callback's ctx, whose first word is the client fd (handlers.cyr's
# remote SSE ctx). It sends the comment the local path sends. Returns 1 to keep
# waiting, or 0 to stop the stream when the client is gone. read_ms still bounds
# the longest silence the stream accepts.
fn http_sse_idle_keepalive(ctx, silent_ms) {
    if (ctx == 0) { return 0; }
    if (http_sse_comment(load64(ctx), "keep-alive") < 0) { return 0; }
    return 1;
}

fn http_sse_done(cfd) {
    sys_write(cfd, "data: [DONE]\n\n", 14);
    return 0;
}

fn http_ok(cfd, body, body_len) {
    return http_respond(cfd, "200", "OK", body, body_len);
}

fn http_json_ok(cfd, json_str) {
    var data = str_data(json_str);
    var len = str_len(json_str);
    return http_ok(cfd, data, len);
}

fn http_not_found(cfd) {
    var body = "{\"error\":{\"message\":\"not found\",\"type\":\"invalid_request_error\"}}";
    return http_respond(cfd, "404", "Not Found", body, strlen(body));
}

# 2.10.2: the three writers of hoosh's error envelope (these two and _resp_err) escape `msg`. They pasted it between
# quotes, and for an upstream failure it holds a provider's bytes: a `"` in it ended the JSON string early, so the
# client could not read the answer, and a provider could write keys into hoosh's `error` object. A batch answer embeds
# each item's body as it stands, so one such item spoiled the items around it.
fn http_bad_request(cfd, msg) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"error\":{\"message\":\"");
    sb_add_json_escaped(sb, msg);
    str_builder_add_cstr(sb, "\",\"type\":\"invalid_request_error\"}}");
    var body = str_builder_build(sb);
    var bd = to_cstr(body);
    return http_respond(cfd, "400", "Bad Request", bd, str_len(body));
}

fn http_method_not_allowed(cfd, allow) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"error\":{\"message\":\"method not allowed, use ");
    str_builder_add_cstr(sb, allow);
    str_builder_add_cstr(sb, "\",\"type\":\"invalid_request_error\"}}");
    var body = str_builder_build(sb);
    return http_respond(cfd, "405", "Method Not Allowed", to_cstr(body), str_len(body));
}

fn http_payload_too_large(cfd) {
    var body = "{\"error\":{\"message\":\"request body too large\",\"type\":\"invalid_request_error\"}}";
    return http_respond(cfd, "413", "Payload Too Large", body, strlen(body));
}

fn http_error(cfd, status, status_text, msg) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"error\":{\"message\":\"");
    sb_add_json_escaped(sb, msg);
    str_builder_add_cstr(sb, "\",\"type\":\"server_error\"}}");
    var body = str_builder_build(sb);
    var bd = to_cstr(body);
    return http_respond(cfd, status, status_text, bd, str_len(body));
}

# ── Deferred response descriptor ──────────────
# A response that _chat_produce *returns* instead of writing to a socket,
# so a batch worker can collect the body off the accept thread. Layout
# (32 bytes): status cstr(+0), status_text cstr(+8), body cstr(+16),
# body_len(+24). _resp_write replays it through http_respond.
# 2.10.2: here from handlers.cyr, beside the bodies it mirrors, so the tests run _resp_err.
fn _resp_new(status, status_text, body_cstr, body_len) {
    return _resp_new_a(default_alloc(), status, status_text, body_cstr, body_len);
}

# 2.10.3: in `a`, the request arena on the chat path (reqmem.cyr). A descriptor that outlives the job (a batch
# item's) goes through _resp_keep.
fn _resp_new_a(a, status, status_text, body_cstr, body_len) {
    var r = alloc_via(a, 40);
    store64(r, status);
    store64(r + 8, status_text);
    store64(r + 16, body_cstr);
    store64(r + 24, body_len);
    store64(r + 32, 0);
    return r;
}

# 2.10.3: a descriptor and its body in process memory, for a keeper (ADR 013's boundary): a batch item's answer is
# read after the thread's next job has reset the request arena. Status, status text and the header are constants.
fn _resp_keep(r) {
    if (r == 0) { return 0; }
    var k = alloc(40);
    if (k == 0) { return 0; }
    store64(k, load64(r));
    store64(k + 8, load64(r + 8));
    store64(k + 16, mem_keep(load64(r + 16), load64(r + 24)));
    store64(k + 24, load64(r + 24));
    store64(k + 32, load64(r + 32));
    return k;
}

# Attach one extra response header — a `Name: value` cstr, no CRLF.
#
# 2.5.12: used for `X-Hoosh-Cache`, so a client can tell a cache hit from a
# fresh inference. Before this the two were byte-indistinguishable, which meant
# a caching consumer double-counted spend on every hit.
fn _resp_set_header(r, hdr) {
    store64(r + 32, hdr);
    return r;
}

# Error-response descriptor mirroring http_error / http_bad_request bodies.
fn _resp_err(status, status_text, msg, etype) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"error\":{\"message\":\"");
    sb_add_json_escaped(sb, msg);
    str_builder_add_cstr(sb, "\",\"type\":\"");
    str_builder_add_cstr(sb, etype);
    str_builder_add_cstr(sb, "\"}}");
    var b = str_builder_build(sb);
    return _resp_new(status, status_text, to_cstr(b), str_len(b));
}

fn _resp_write(cfd, r) {
    return http_respond_h(cfd, load64(r), load64(r + 8), load64(r + 16), load64(r + 24),
      load64(r + 32));
}

fn http_parse_path(buf, len) {
    var i = 0;
    while (i < len && load8(buf + i) != 32) { i = i + 1; }
    i = i + 1;
    if (i >= len) { return 0; }
    var start = i;
    while (i < len && load8(buf + i) != 32 && load8(buf + i) != 10 && load8(buf + i) != 13) {
        i = i + 1;
    }
    var path = alloc(i - start + 1);
    memcpy(path, buf + start, i - start);
    store8(path + i - start, 0);
    return path;
}

fn http_parse_method(buf, len) {
    if (memeq(buf, "GET", 3) == 1) { return "GET"; }
    if (memeq(buf, "POST", 4) == 1) { return "POST"; }
    if (memeq(buf, "OPTIONS", 7) == 1) { return "OPTIONS"; }
    return "UNKNOWN";
}

fn req_parse_body(buf, len) {
    var i = 0;
    while (i < len - 3) {
        var b0 = load8(buf + i) == 13;
        var b1 = load8(buf + i + 1) == 10;
        var b2 = load8(buf + i + 2) == 13;
        var b3 = load8(buf + i + 3) == 10;
        if (b0 && b1 && b2 && b3) {
            return buf + i + 4;
        }
        i = i + 1;
    }
    return 0;
}

fn req_body_len(buf, total_len) {
    var body = req_parse_body(buf, total_len);
    if (body == 0) { return 0; }
    return total_len - (body - buf);
}

# ASCII case-insensitive compare of `n` bytes. HTTP header names are
# case-insensitive and clients send both "Content-Length" and "content-length".
fn _hdr_ci_eq(a, b, n) {
    var i = 0;
    while (i < n) {
        var ca = load8(a + i) & 0xFF;
        var cb = load8(b + i) & 0xFF;
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Declared body length from the request headers, or 0 when absent/malformed.
# Scans only the header block (returns at the CRLFCRLF) so a body that happens
# to contain the literal "content-length:" cannot spoof the value.
# True when a Transfer-Encoding header is present with anything other than
# `identity`. Anchored to a line start and bounded to the header block, the
# same way req_content_length is.
fn req_has_transfer_encoding(buf, len) {
    var i = 0;
    while (i + 18 <= len) {
        if (load8(buf + i) == 13 && i + 3 < len) {
            if (load8(buf + i + 1) == 10 && load8(buf + i + 2) == 13 && load8(buf + i + 3) == 10) {
                return 0;
            }
        }
        var line_start = 0;
        if (i == 0) { line_start = 1; }
        if (i > 0) { if (load8(buf + i - 1) == 10) { line_start = 1; } }
        if (line_start == 1 && _hdr_ci_eq(buf + i, "transfer-encoding:", 18) == 1) {
            var j = i + 18;
            while (j < len && (load8(buf + j) == 32 || load8(buf + j) == 9)) { j = j + 1; }
            # `identity` is the no-op coding and needs no special handling.
            if (j + 8 <= len && _hdr_ci_eq(buf + j, "identity", 8) == 1) { return 0; }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn req_content_length(buf, len) {
    var i = 0;
    while (i < len - 3) {
        if (load8(buf + i) == 13 && load8(buf + i + 1) == 10) {
            if (load8(buf + i + 2) == 13 && load8(buf + i + 3) == 10) { return 0; }
        }
        # The name must start a header line. Without this the match fired at
        # ANY byte offset, so the request URI or an earlier header VALUE
        # carrying the literal "content-length:" won on first-match — a
        # Referer or X-Forwarded-Uri was enough to make a small valid request
        # answer 413.
        var line_start = 0;
        if (i == 0) { line_start = 1; }
        if (i > 0) { if (load8(buf + i - 1) == 10) { line_start = 1; } }
        if (line_start == 1 && i + 15 < len && _hdr_ci_eq(buf + i, "content-length:", 15) == 1) {
            var j = i + 15;
            while (j < len && load8(buf + j) == 32) { j = j + 1; }
            var v = 0;
            var digits = 0;
            while (j < len) {
                var c = load8(buf + j) & 0xFF;
                if (c < 48 || c > 57) { break; }
                # Uncapped, `v = v * 10 + d` wraps i64 and can land on a small
                # or negative value that passes the MAX_REQUEST_BODY check.
                # Anything past the cap is refused outright.
                if (digits > 18) { return 0 - 1; }
                v = v * 10 + (c - 48);
                if (v < 0) { return 0 - 1; }
                digits = digits + 1;
                j = j + 1;
            }
            if (digits == 0) { return 0 - 1; }
            return v;
        }
        i = i + 1;
    }
    return 0;
}
