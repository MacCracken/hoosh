# pool.cyr — the unified worker pool (v2.4.0 multi-threaded accept loop).
#
# The accept loop (main thread) only accepts connections and enqueues them as
# jobs; a fixed pool of WORKER_COUNT threads drains the queue. Batch items are
# the same kind of job (see batch.cyr), so HTTP traffic and batch work share the
# one pool — no separate lane pool, no static split.
#
# Crypto lanes (2.9.1): since sigil 3.13.14 (cyrius 6.7.18) every sigil entry
# point borrows one of SIGIL_CRYPTO_BANKS (64) lanes for the length of the
# operation and gives it back, so ANY thread may hash, sign or speak TLS. Through
# 2.9.0 a thread pinned a bank for life with crypto_bank_set (8 banks: 0 = main,
# 1..7 = workers), which is where WORKER_COUNT <= 7 and the "bankless" helper
# threads came from. crypto_bank_set is a no-op now and is no longer called.
# Main still calls crypto_tls_main_init() before spawning: it installs main's
# thread-local block, so lane lookups skip their slow path. Workers get their
# TLS block from CLONE_SETTLS, so they never call thread_local_init.

var WORKER_COUNT = 7;

# Request read sizing. REQ_READ_CHUNK is the first (and, for almost every
# request, only) recv; MAX_REQUEST_BODY caps the declared Content-Length and
# matches rust-old's axum DefaultBodyLimit(1 MiB). Bodies between the two are
# read into a right-sized buffer — see _handle_conn.
var REQ_READ_CHUNK = 65535;
var MAX_REQUEST_BODY = 1048576;

# The work queue (wq_push / wq_pop / wq_done) and the job constructors are wq.cyr's, included just before this
# file (2.9.20: split out so the tests run the real ring instead of a copy of it).

# Read one full HTTP request off the connection, route it, close. Runs on a
# worker thread.
#
# Body cap (v2.5.1): rust-old enforced axum's DefaultBodyLimit(1 MiB) and
# answered 413. The port had no cap at all — just one 64 KiB recv, which
# SILENTLY TRUNCATED anything bigger (and anything split across TCP segments),
# so a large request surfaced as a malformed-JSON 400 instead of an honest 413
# and a legitimate 100 KiB request could not be served at all. Content-Length is
# checked BEFORE any large allocation, so an oversized request costs one
# response, not a megabyte of the never-freeing arena.
# Per-thread request buffer (2.5.11).
#
# _handle_conn used to alloc(64 KiB) per connection against an arena that NEVER
# FREES, so a long-running gateway's RSS grew by 64 KiB per request served —
# ~230 MB per hour at 1 req/s, and an OOM on any busy deployment. Nothing was
# wrong with the code except that it treated a bump allocator like malloc.
#
# One buffer per thread, allocated on that thread's first request and reused
# forever. Reuse is safe because the buffer's contents do not outlive the call:
# the sync-batch path blocks in its work-stealing barrier inside _handle_conn,
# and the ASYNC batch path deep-copies every item in batch_submit (batch.cyr
# :174-178) precisely so its slices own their bytes. Verify that copy still
# exists before assuming this is safe.
#
# Slot 2 — slot 1 is the traceparent (trace.cyr). Slots 0-15 are the fixed ones;
# thread_local_alloc (sigil's lane slot, sandhi, patra) hands out 16 and up.
var REQBUF_SLOT = 2;

# Whole-phase deadline for an ACCEPTED client socket, in seconds. Mirrors the
# outbound HTTP_IO_TIMEOUT_S bound on provider sockets. Generous enough for a
# slow uploader, short enough that a silent connection cannot hold a worker.
var CLIENT_IO_TIMEOUT_S = 30;

fn _req_buf() {
    var b = thread_local_get(REQBUF_SLOT);
    if (b == 0) {
        b = alloc(REQ_READ_CHUNK + 1);
        thread_local_set(REQBUF_SLOT, b);
    }
    return b;
}

fn _handle_conn(cfd) {
    # Bound every blocking phase on the ACCEPTED socket. Only outbound sockets
    # had deadlines; a client that connects and then goes silent parked a
    # worker in sock_recv forever, and this runs BEFORE auth_check, so seven
    # such connections wedged the gateway unauthenticated. The send timeout
    # covers the mirror case: an SSE client that stops reading.
    sock_set_recv_timeout(cfd, CLIENT_IO_TIMEOUT_S, 0);
    sock_set_send_timeout(cfd, CLIENT_IO_TIMEOUT_S, 0);
    var req_buf = _req_buf();
    var recv_r_t, recv_r_v = sock_recv(cfd, req_buf, REQ_READ_CHUNK);
    if (is_err_result(recv_r_t) == 1) { sock_close(cfd); return 0; }
    var req_len = recv_r_v;
    if (req_len > 0) {
        store8(req_buf + req_len, 0);

        # Transfer-Encoding is not implemented. With no Content-Length the
        # drain below never runs, so the handler received chunk-size lines,
        # CRLFs and the terminator as the body: short bodies "worked" by
        # accident because the JSON parser skips to the first `{`, while the
        # framing bytes polluted the cache key, and any body spanning more than
        # one segment was silently TRUNCATED — so the prompt forwarded and
        # billed was a cut-off prefix. Reachable via `curl -T`, undici streams,
        # or an HTTP/2-terminating proxy. Refuse explicitly rather than
        # mis-framing; full chunked decoding can come later.
        if (req_has_transfer_encoding(req_buf, req_len) == 1) {
            http_error(cfd, "501", "Not Implemented",
              "chunked Transfer-Encoding is not supported; send Content-Length");
            sock_close(cfd);
            return 0;
        }
        var clen = req_content_length(req_buf, req_len);
        # -1 means the Content-Length header was present but malformed (no
        # digits, or a run long enough to wrap i64). Refuse rather than
        # proceeding with an unknown body length.
        if (clen < 0) {
            http_bad_request(cfd, "malformed Content-Length");
            sock_close(cfd);
            return 0;
        }
        if (clen > MAX_REQUEST_BODY) {
            http_payload_too_large(cfd);
            sock_close(cfd);
            return 0;
        }

        # Drain the rest of a body that arrived across several segments. Grow
        # only when the declared length genuinely exceeds the first chunk.
        var body = req_parse_body(req_buf, req_len);
        if (body != 0 && clen > 0) {
            var want = (body - req_buf) + clen;
            if (want > req_len) {
                if (want > REQ_READ_CHUNK) {
                    # Client-chosen size on a pre-auth path against a
                    # never-freeing arena: refuse rather than memcpy into a
                    # null on exhaustion.
                    var big = alloc(want + 1);
                    if (big == 0) {
                        http_error(cfd, "503", "Service Unavailable", "request buffer unavailable");
                        sock_close(cfd);
                        return 0;
                    }
                    memcpy(big, req_buf, req_len);
                    req_buf = big;
                }
                while (req_len < want) {
                    var more_t, more_v = sock_recv(cfd, req_buf + req_len, want - req_len);
                    if (is_err_result(more_t) == 1) { break; }
                    var n = more_v;
                    if (n <= 0) { break; }
                    req_len = req_len + n;
                }
                store8(req_buf + req_len, 0);
            }
        }

        var method = http_parse_method(req_buf, req_len);
        var path = http_parse_path(req_buf, req_len);
        if (path != 0) {
            http_route(cfd, method, path, req_buf, req_len);
        } else {
            http_bad_request(cfd, "malformed request");
        }
    }
    sock_close(cfd);
    return 0;
}

# Process one job (a connection, or a batch item). Used by the worker loop and by
# the sync-batch work-stealing barrier.
fn job_process(job) {
    if (load64(job) == JOB_CONN) {
        _handle_conn(load64(job + 8));
        return 0;
    }
    if (load64(job) == JOB_OTLP_EXPORT) {
        # On a worker: TLS to a remote OTLP collector.
        _otlp_post(load64(job + 8), load64(job + 16));
        return 0;
    }
    if (load64(job) == JOB_CATALOG_REFRESH) {
        # 2.8.0: the model catalog's provider lists are HTTPS; they are fetched here, on a pool worker.
        catalog_refresh_all();
        return 0;
    }
    # JOB_BATCH_ITEM — produce the response, store it, then bump the failure +
    # completion counters (completion LAST so the slot is visible to the barrier).
    var d = _chat_produce(load64(job + 8), load64(job + 16));
    store64(load64(job + 24), d);
    var failed_ctr = load64(job + 40);
    if (failed_ctr != 0) {
        if (d == 0) { _batch_atomic_add(failed_ctr, 1); }
        else { if (atoi(load64(d)) != 200) { _batch_atomic_add(failed_ctr, 1); } }
    }
    _batch_atomic_add(load64(job + 32), 1);
    return 0;
}

# Worker thread: drain the queue forever. arg is the worker's index
# (1..WORKER_COUNT); through 2.9.0 it was the sigil bank this thread pinned.
fn _pool_worker(arg) {
    while (1 == 1) {
        var job = wq_pop();
        if (job == 0) {
            sleep_ms(1);
        } else {
            # wq_pop already counted this job as in-flight. The shutdown drain
            # waits on queued + in-flight: a request that has already been popped
            # is invisible to the queue depth, so draining on depth alone
            # returned instantly and cut live requests off mid-answer.
            job_process(job);
            wq_done();
        }
    }
    return 0;
}

# Spawn the worker pool. Call after crypto_tls_main_init() (main's TLS block installed).
fn pool_start() {
    # Workers run the full request chain (was the 8 MB main stack; batch workers
    # already proved the chat path fits the 64 KB default). Give solid headroom
    # for deeper/other handlers — 7 × 1 MB is negligible.
    # THREAD_STACK_SIZE is a Linux/posix knob (lib/thread.cyr) absent on agnos —
    # guard the set-out there (agnos thread_create uses its own stack model).
    #ifndef CYRIUS_TARGET_AGNOS
    THREAD_STACK_SIZE = 1048576;
    #endif
    wq_init();
    var i = 1;
    while (i <= WORKER_COUNT) {
        thread_create(&_pool_worker, i);
        i = i + 1;
    }
    return 0;
}
