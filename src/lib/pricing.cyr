    _pricing_add(arr, 72, "mistral-small-2603", 150, 600);
    _pricing_add(arr, 73, "mistral-small-latest", 150, 600);
    _pricing_add(arr, 74, "codestral-2508", 300, 900);
    _pricing_add(arr, 75, "ministral-14b-2512", 200, 200);
    _pricing_add(arr, 76, "openai/gpt-oss-120b", 150, 600);
