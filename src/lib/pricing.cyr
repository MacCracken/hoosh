    _pricing_add(arr, 44, "gemini-3.8-flash", 750, 3750);
    _pricing_add(arr, 45, "gemini-3.7-flash", 750, 3750);
    _pricing_add(arr, 46, "gemini-3.6-flash", 750, 3750);
