# pricing.cyr — per-token LLM API pricing + cost estimation.
#
# Port of the PRICING table + lookup_pricing from rust-old/src/cost/mod.rs.
# (NOT data/cloud_pricing.json — that is cloud GPU $/hour for hardware planning.)
#
# Cyrius has no floats here, so prices are carried scaled by 1000: a price of
# $3.00 per million tokens is stored as 3000. Cost is computed in micro-USD
# (1e-6 USD): cost_micro = tokens * price_scaled / 1000  (since micro-USD =
# tokens * dollars-per-million = tokens * price_scaled/1000).

var _pricing_tbl = 0;
var _pricing_n = 0;

# Entry: key(0) in(8) out(16) long_threshold(24) long_in(32) long_out(40) — 48 bytes. A long-context tier
# (2.8.0) applies when a request's input exceeds long_threshold tokens; 0 = the model has one flat rate.
fn _pricing_add(arr, idx, key, in_s, out_s) {
    var e = arr + idx * 48;
    store64(e, key);
    store64(e + 8, in_s);
    store64(e + 16, out_s);
    store64(e + 24, 0);
    store64(e + 32, 0);
    store64(e + 40, 0);
    return 0;
}

fn _pricing_tier(arr, idx, threshold, in_s, out_s) {
    var e = arr + idx * 48;
    store64(e + 24, threshold);
    store64(e + 32, in_s);
    store64(e + 40, out_s);
    return 0;
}

var _PRICING_CAP = 81;

# Built-in pricing table (model id -> input/output $/M x1000). Built once.
fn _pricing_init() {
    if (_pricing_tbl != 0) { return 0; }
    var arr = alloc(_PRICING_CAP * 48);
    # Anthropic — 2.8.0, Anthropic's published first-party rates (cached 2026-10-06). The 2.7.1 table had one
    # `claude-opus-4` row at $15/$75, which the longest-prefix match applied to EVERY Opus 4.x: Opus 4.5-4.8 cost
    # $5/$25 and were billed at three times that. Claude 5.x models matched no row and fell to the provider
    # default ($3/$15), so Haiku 5.5 was billed thirty times its rate and Fable 5.1 a third of it. Each family now
    # has its own row; `claude-opus-4` / `claude-sonnet-4` remain only for the dated 4.0 ids.
    _pricing_add(arr, 0, "claude-fable-5-1", 10000, 50000);
    _pricing_add(arr, 1, "claude-fable-5", 10000, 50000);
    _pricing_add(arr, 2, "claude-mythos-5-1", 10000, 50000);
    _pricing_add(arr, 3, "claude-mythos-5", 10000, 50000);
    _pricing_add(arr, 4, "claude-opus-5-5", 4000, 20000);
    _pricing_add(arr, 5, "claude-opus-5", 5000, 25000);
    _pricing_add(arr, 6, "claude-opus-4-8", 5000, 25000);
    _pricing_add(arr, 7, "claude-opus-4-7", 5000, 25000);
    _pricing_add(arr, 8, "claude-opus-4-6", 5000, 25000);
    _pricing_add(arr, 9, "claude-opus-4-5", 5000, 25000);
    _pricing_add(arr, 10, "claude-opus-4-1", 15000, 75000);
    _pricing_add(arr, 11, "claude-opus-4", 15000, 75000);
    _pricing_add(arr, 12, "claude-sonnet-5-5", 2000, 10000);
    _pricing_add(arr, 13, "claude-sonnet-5", 2000, 10000);
    _pricing_add(arr, 14, "claude-sonnet-4-6", 3000, 15000);
    _pricing_add(arr, 15, "claude-sonnet-4-5", 3000, 15000);
    _pricing_add(arr, 16, "claude-sonnet-4", 3000, 15000);
    # Haiku 5.5 is priced by prompt length: $0.10/$0.50 up to 100K input tokens, $0.50/$2.50 above.
    _pricing_add(arr, 17, "claude-haiku-5-5", 100, 500);
    _pricing_tier(arr, 17, 100000, 500, 2500);
    _pricing_add(arr, 18, "claude-haiku-4-5", 1000, 5000);
    # Non-Anthropic rates, 2.8.0: each provider's official pricing page, read 2026-10-09 (USD per million tokens,
    # standard tier, no cache or batch discount). [[models]] in hoosh.cyml overrides any of them, and a provider that
    # publishes per-model prices in its list (OpenRouter) is priced by its own. Notes per provider:
    #   OpenAI   prompts over 272K bill the whole request at 2x input / 1.5x output (6.x, 5.6.x, 5.5, 5.4)
    #   Google   Pro prompts over 200K use the higher tier; the 3.6-3.8 Flash rates double on 2027-01-01
    #   xAI      prompts of 200K or more use the higher tier; retired grok-3 / grok-4-fast ids bill at grok-4.3 rates
    #   DeepSeek peak-hour cache-miss rates (off-peak is half)
    #   Mistral  Large 4 is a public preview at a sale price
    _pricing_add(arr, 19, "gpt-6-astra", 10000, 50000);
    _pricing_tier(arr, 19, 272000, 20000, 75000);
    _pricing_add(arr, 20, "gpt-6.1-sol", 2000, 10000);
    _pricing_tier(arr, 20, 272000, 4000, 15000);
    _pricing_add(arr, 21, "gpt-6-sol", 2000, 10000);
    _pricing_tier(arr, 21, 272000, 4000, 15000);
    _pricing_add(arr, 22, "gpt-6-luna", 100, 500);
    _pricing_tier(arr, 22, 272000, 200, 750);
    _pricing_add(arr, 23, "gpt-5.6-sol", 4000, 20000);
    _pricing_tier(arr, 23, 272000, 8000, 30000);
    _pricing_add(arr, 24, "gpt-5.6-terra", 2000, 12000);
    _pricing_tier(arr, 24, 272000, 4000, 18000);
    _pricing_add(arr, 25, "gpt-5.6-luna", 200, 1200);
    _pricing_tier(arr, 25, 272000, 400, 1800);
    _pricing_add(arr, 26, "gpt-5.6", 4000, 20000);
    _pricing_tier(arr, 26, 272000, 8000, 30000);
    _pricing_add(arr, 27, "gpt-5.5", 5000, 30000);
    _pricing_tier(arr, 27, 272000, 10000, 45000);
    _pricing_add(arr, 28, "gpt-5.4", 2500, 15000);
    _pricing_tier(arr, 28, 272000, 5000, 22500);
    _pricing_add(arr, 29, "gpt-5.4-mini", 750, 4500);
    _pricing_add(arr, 30, "gpt-5.4-nano", 200, 1250);
    _pricing_add(arr, 31, "gpt-5.2", 1750, 14000);
