    _pricing_add(arr, 37, "gpt-4.1-nano", 100, 400);
    _pricing_add(arr, 38, "gpt-4o", 2500, 10000);
    _pricing_add(arr, 39, "gpt-4o-mini", 150, 600);
    _pricing_add(arr, 40, "o3", 2000, 8000);
    _pricing_add(arr, 41, "o4-mini", 1100, 4400);
    _pricing_add(arr, 42, "o3-mini", 1100, 4400);
