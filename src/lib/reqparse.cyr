# reqparse.cyr — the pure helpers handlers.cyr uses to read a request (2.9.16, split from handlers.cyr).
#
# They take bytes and return values: no socket, no global state, no lock. That let the test suite include them
# for real instead of keeping copies, several of which had drifted (2.9.16 CHANGELOG). handlers.cyr itself needs
# the whole server and cannot be included in the tests.
#   - request body fields: _req_reasoning_effort, _req_num_milli, _extract_tools, _json_array_count;
#   - the response cache's key and the warming body: _cache_key, _warming_body;
#   - the hardware endpoints' inputs: _hoosh_req_from_str, _hw_blank, _hw_num_byte, _hw_whole_bounded,
#     _hw_json_whole, and add_devices' sizes, _hw_add_devices (2.9.22);
#   - POST /v1/batch's body and status names (2.9.17, from batch.cyr): _batch_extract_requests, _batch_split,
#     _batch_is_async, _batch_status_name and the BATCH_* status values;
#   - which paths are POST-only (2.9.21, from main.cyr): _requires_post.
# Requires: jsonlite.cyr (_top_key_value), catalog.cyr (catalog_req_effort), auth.cyr (auth_identity),
# http_server.cyr (to_cstr), types.cyr (GEN_UNSET), sigil (sha256_hex), ai-hwaccel (REQ_*).

# 2.5.0: the OpenAI `reasoning_effort` -> a thinking EFFORT LEVEL. 2.8.0: the scan lives in catalog.cyr
# (catalog_req_effort, tested for real) and knows the words current models take — xhigh and max for Claude 4.7 and
# later, minimal and none for OpenAI's reasoning models; before it, "xhigh" silently meant "no thinking".
fn _req_reasoning_effort(body_ptr, body_len) {
    var w = alloc(8);
    return catalog_req_effort(body_ptr, body_len, w);
}

# Raw-scan a top-level numeric field -> its value x1000, or GEN_UNSET when
# absent. Raw scan (not json_get) for the SAME reason as _req_reasoning_effort:
# OpenAI clients place these keys AFTER the nested `messages` array, which the
# flat json_parse cannot reach — which is why the pre-2.5.2
# json_get("max_tokens") silently fell back to the 2048 budget default on real
# client traffic. `key` includes its quotes but not the colon, as _top_key_value
# takes it: "\"top_p\"" (until 2.9.16 this said the colon was included, from
# before the 2.6.9 depth-aware lookup).
# Fractions beyond 3 decimals are truncated; a leading '-' is preserved so
# out-of-range negatives reach validation rather than being silently dropped.

fn _req_num_milli(body_ptr, body_len, key, keylen) {
    var j = _top_key_value(body_ptr, body_len, key, keylen);
    if (j < 0) { return GEN_UNSET; }
    var neg = 0;
    if (j < body_len && load8(body_ptr + j) == 45) {
        neg = 1;
        j = j + 1;
    }
    var ip = 0;
    var digits = 0;
    while (j < body_len) {
        var c = load8(body_ptr + j) & 0xFF;
        if (c < 48 || c > 57) { break; }
        ip = ip * 10 + (c - 48);
        digits = digits + 1;
        j = j + 1;
    }
    if (digits == 0) { return GEN_UNSET; }
    var frac = 0;
    var scale = 100;
    if (j < body_len && load8(body_ptr + j) == 46) {
        j = j + 1;
        while (j < body_len && scale > 0) {
            var fc = load8(body_ptr + j) & 0xFF;
            if (fc < 48 || fc > 57) { break; }
            frac = frac + (fc - 48) * scale;
            scale = scale / 10;
            j = j + 1;
        }
    }
    var v = ip * 1000 + frac;
    if (neg == 1) { return 0 - v; }
    return v;
}

# Extract the raw "tools":[...] array span (ptr,len) from a request body, or 0.
# Balanced-bracket scan with JSON string handling (mirrors _extract_messages).
fn _extract_tools(body_ptr, body_len) {
    # Depth-aware, same reason as _extract_messages.
    var j = _top_key_value(body_ptr, body_len, "\"tools\"", 7);
    if (j < 0) { return 0; }
    if (j >= body_len) { return 0; }
    if (load8(body_ptr + j) != 91) { return 0; }
    var depth = 1;
    var ts = j;
    j = j + 1;
    while (j < body_len && depth > 0) {
        var ch = load8(body_ptr + j);
        if (ch == 91) { depth = depth + 1; }
        if (ch == 93) { depth = depth - 1; }
        if (ch == 34) {
            j = j + 1;
            while (j < body_len) {
                if (load8(body_ptr + j) == 34) { break; }
                if (load8(body_ptr + j) == 92) { j = j + 1; }
                j = j + 1;
            }
        }
        j = j + 1;
    }
    var tlen = j - ts;
    # 2.9.16: an empty array is no tools. 2.6.9's depth-aware rewrite dropped the old `len <= 2` check, so a
    # request carrying "tools": [] (some SDKs send one when no tools are set) was forwarded with "tools":[], which
    # OpenAI's API rejects (minimum length 1). The test file's copy kept the check, so its test stayed green.
    var k = ts + 1;
    var empty = 1;
    while (k < ts + tlen - 1) {
        var kc = load8(body_ptr + k);
        if (kc != 32 && kc != 9 && kc != 10 && kc != 13) { empty = 0; }
        k = k + 1;
    }
    if (empty == 1) { return 0; }
    var result = alloc(16);
    if (result == 0) { return 0; }
    store64(result, body_ptr + ts);
    store64(result + 8, tlen);
    return result;
}

# Count elements in a raw JSON array span — objects at depth 1, string-aware.
# Used to enforce the message-count bound.
fn _json_array_count(ptr, len) {
    var n = 0;
    var depth = 0;
    var i = 0;
    while (i < len) {
        var c = load8(ptr + i) & 0xFF;
        if (c == 34) {
            i = i + 1;
            while (i < len) {
                if (load8(ptr + i) == 34) { break; }
                if (load8(ptr + i) == 92) { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if (c == 123 || c == 91) {
            if (depth == 1 && c == 123) { n = n + 1; }
            depth = depth + 1;
        }
        if (c == 125 || c == 93) { depth = depth - 1; }
        i = i + 1;
    }
    return n;
}

# The exact-key response cache's key. Identical requests (same caller, same model, byte-identical body) collide
# to one entry; this is the exact-key LRU cache (the semantic cache handles similarity).
#
# 2.10.3: in `a`, the request arena on the chat path (reqmem.cyr): 64 hex digits and a NUL, hashed from a builder
# with room for the body, so nothing is copied. The cache keeps a copy of its own (_chat_assemble). Through 2.10.2
# this kept a copy of the body, two of the key's text and the digest on the heap: 632 bytes for a short chat.
fn _cache_key_a(a, model, body_ptr, body_len) {
    var sb = sb_room_a(a, body_len + strlen(model) + 32);
    # Caller identity first: without it the cache was shared across every
    # consumer of the gateway, so one tenant's response could be replayed to
    # another for an identical prompt. 0 when auth is not configured, which
    # keeps single-tenant deployments byte-compatible with their existing keys
    # only in the sense that they all share one namespace — the hash changes,
    # so the cache is cold once after upgrade.
    str_builder_add_int(sb, auth_identity());
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\n");
    sb_add_bytes(sb, body_ptr, body_len);    # up to a NUL, as the cstr copy it replaced did
    var digest[32];
    sha256(load64(sb), sb_len(sb), &digest);
    var out = alloc_via(a, 65);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < 32) {
        var b = load8(&digest + i) & 255;
        var hi = b / 16;
        var lo = b % 16;
        if (hi < 10) { store8(out + i * 2, 48 + hi); } else { store8(out + i * 2, 87 + hi); }
        if (lo < 10) { store8(out + i * 2 + 1, 48 + lo); } else { store8(out + i * 2 + 1, 87 + lo); }
        i = i + 1;
    }
    store8(out + 64, 0);
    return out;
}

fn _cache_key(model, body_ptr, body_len) {
    return _cache_key_a(default_alloc(), model, body_ptr, body_len);
}

# Canonical compact body a client must POST to hit a warmed entry:
# {"model":"M","messages":[{"role":"user","content":"P"}]}
fn _warming_body(model, prompt) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"messages\":[{\"role\":\"user\",\"content\":\"");
    str_builder_add_cstr(sb, prompt);
    str_builder_add_cstr(sb, "\"}]}");
    return str_builder_build(sb);
}

# Map a requirement string to the ai-hwaccel REQ_* enum, or -1 if unknown.
fn _hoosh_req_from_str(s) {
    if (streq(s, "none") == 1) { return REQ_NONE; }
    if (streq(s, "gpu") == 1) { return REQ_GPU; }
    if (streq(s, "tpu") == 1) { return REQ_TPU; }
    if (streq(s, "gaudi") == 1) { return REQ_GAUDI; }
    if (streq(s, "aws-neuron") == 1) { return REQ_AWS_NEURON; }
    if (streq(s, "gpu-or-tpu") == 1) { return REQ_GPU_OR_TPU; }
    if (streq(s, "any-accelerator") == 1) { return REQ_ANY_ACCELERATOR; }
    return 0 - 1;
}

# ── Whole-number inputs for the hardware planners (2.6.13) ──
# str_to_int skips every byte that is not a digit and wraps on overflow: "7e9" is
# 79, "7000000000.0" is 70000000000 and "18446744073709551617" is 1. The planners
# multiply what they are given, so a wrapped or huge model_params came back as a
# negative memory requirement with "fits": true.

fn _hw_blank(c) {
    if (c == 32 || c == 9 || c == 13 || c == 10) { return 1; }
    return 0;
}

# A byte that can be part of a JSON number: a digit, a point, an exponent or a sign.
fn _hw_num_byte(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 46 || c == 101 || c == 69 || c == 43 || c == 45) { return 1; }
    return 0;
}

# p[0..len) as a whole number no larger than `cap`. Returns the value, -1 when the
# text is not a whole number (empty, a sign, an exponent, a fraction other than
# zeros, any other byte), or -2 when it is larger than `cap`. The cap is checked
# before each multiply, so the accumulator never wraps. A zero fraction is the same
# whole number: Python's json.dumps writes 7e9 as 7000000000.0.
fn _hw_whole_bounded(p, len, cap) {
    var v = 0;
    var i = 0;
    while (i < len) {
        var d = (load8(p + i) & 0xFF) - 48;
        if (d < 0 || d > 9) { break; }
        if (v > (cap - d) / 10) { return 0 - 2; }
        v = v * 10 + d;
        i = i + 1;
    }
    if (i == 0) { return 0 - 1; }
    if (i < len && load8(p + i) == 46) {
        i = i + 1;
        if (i == len) { return 0 - 1; }
        while (i < len && load8(p + i) == 48) { i = i + 1; }
    }
    if (i < len) { return 0 - 1; }
    return v;
}

# A json_get value (a Str, or 0 when the key is absent) as a whole number in
# [0, cap] by the rules above. Absent, empty and null read as 0, "not given", which
# is what str_to_int made of them. Blanks around the value are trimmed: the flat
# parser ends a bare value at a space or LF, so a trailing CR or tab stays in it.
fn _hw_json_whole(s, cap) {
    if (s == 0) { return 0; }
    var p = str_data(s);
    var len = str_len(s);
    while (len > 0 && _hw_blank(load8(p)) == 1) { p = p + 1; len = len - 1; }
    while (len > 0 && _hw_blank(load8(p + len - 1)) == 1) { len = len - 1; }
    if (len == 0) { return 0; }
    if (len == 4 && memeq(p, "null", 4) == 1) { return 0; }
    return _hw_whole_bounded(p, len, cap);
}

# POST /v1/hardware/simulate's add_devices sizes: every `"memory_bytes":` value in the body, in order, pushed onto
# `out`. A raw scan, because json_parse is flat and cannot reach into the nested objects (the constraint the
# sampling params hit in 2.5.2). 2.6.13: each size is the whole-number token after the key, bounded by
# SIM_MAX_DEVICE_BYTES (hardware.cyr). The old digit loop had no bound, so 18446744073709551615 wrapped to a -1
# byte card, and sizes that fit in i64 still wrapped the totals once summed. It also stopped at the first
# non-digit, so 1.5e9 was a 1 byte card. Moved from handle_hw_simulate in 2.9.22 (the tests had a copy of the
# token loop). Returns the number of sizes, or -1 (a size that is not a positive whole number), -2 (one above
# SIM_MAX_DEVICE_BYTES), -3 (a 0-byte device) or -4 (more than SIM_MAX_DEVICES), at the first bad one.
fn _hw_add_devices(body_ptr, body_len, out) {
    var i = 0;
    while (i + 15 < body_len) {
        if (memeq(body_ptr + i, "\"memory_bytes\":", 15) == 1) {
            var j = i + 15;
            while (j < body_len && load8(body_ptr + j) == 32) { j = j + 1; }
            # The token: digits plus any point, exponent or sign that belong to it.
            var k = j;
            while (k < body_len && _hw_num_byte(load8(body_ptr + k)) == 1) { k = k + 1; }
            var v = _hw_whole_bounded(body_ptr + j, k - j, SIM_MAX_DEVICE_BYTES);
            if (v < 0) { return v; }
            if (v == 0) { return 0 - 3; }
            if (vec_len(out) >= SIM_MAX_DEVICES) { return 0 - 4; }
            vec_push(out, v);
            i = k;
        }
        i = i + 1;
    }
    return vec_len(out);
}

# ── POST /v1/batch (2.9.17, split from batch.cyr) ──
# Status values (stored atomically at BS_STATUS).
var BATCH_QUEUED    = 0;
var BATCH_RUNNING   = 1;
var BATCH_COMPLETED = 2;
var BATCH_CANCELLED = 3;
# 2.6.7: terminal state for a batch whose coordinator thread could not be
# spawned. Without it such a batch sat at BATCH_QUEUED forever — the client
# polled "queued" with null results and _batch_evict_terminal, which skips
# non-terminal batches, could never reclaim the slot.
var BATCH_FAILED    = 4;

# Status name for JSON output.
fn _batch_status_name(s) {
    if (s == BATCH_QUEUED) { return "queued"; }
    if (s == BATCH_RUNNING) { return "running"; }
    if (s == BATCH_COMPLETED) { return "completed"; }
    if (s == BATCH_FAILED) { return "failed"; }
    return "cancelled";
}

# Locate the raw "requests" array (including its surrounding [ ]) in the body.
# Returns alloc(16) [ptr, len] or 0 if absent / not an array. Mirrors
# _extract_messages' depth scan.
# 2.9.17: the top-level "requests" through _top_key_value. The raw scan needed the exact bytes `"requests":` (a
# space before the colon failed) and took the first match anywhere in the body.
fn _batch_extract_requests(body_ptr, body_len) {
    var i = _top_key_value(body_ptr, body_len, "\"requests\"", 10);
    if (i < 0) { return 0; }
    if (i < body_len && load8(body_ptr + i) == 91) {
        var depth = 1;
        var start = i;
        i = i + 1;
        while (i < body_len && depth > 0) {
            var ch = load8(body_ptr + i);
            if (ch == 34) {
                i = i + 1;
                while (i < body_len) {
                    if (load8(body_ptr + i) == 34) { break; }
                    if (load8(body_ptr + i) == 92) { i = i + 1; }
                    i = i + 1;
                }
            } else {
                if (ch == 91) { depth = depth + 1; }
                if (ch == 93) { depth = depth - 1; }
            }
            i = i + 1;
        }
        var out = alloc(16);
        store64(out, body_ptr + start);
        store64(out + 8, i - start);
        return out;
    }
    return 0;
}

# Split the raw array (incl. surrounding [ ]) into top-level object slices.
# Returns a vec of alloc(16) [ptr, len]. String-escape and nesting aware.
fn _batch_split(arr_ptr, arr_len) {
    var items = vec_new();
    var i = 0;
    while (i < arr_len && load8(arr_ptr + i) != 91) { i = i + 1; }
    if (i >= arr_len) { return items; }
    i = i + 1;
    var depth = 0;
    var start = 0 - 1;
    while (i < arr_len) {
        var ch = load8(arr_ptr + i);
        if (ch == 34) {
            i = i + 1;
            while (i < arr_len) {
                var c2 = load8(arr_ptr + i);
                if (c2 == 92) { i = i + 2; } else {
                    if (c2 == 34) { break; }
                    i = i + 1;
                }
            }
            i = i + 1;
        } else {
            if (ch == 123 || ch == 91) {
                if (depth == 0 && start < 0) { start = i; }
                depth = depth + 1;
                i = i + 1;
            } else {
                if (ch == 125 || ch == 93) {
                    depth = depth - 1;
                    i = i + 1;
                    if (depth < 0) { break; }
                    if (depth == 0 && start >= 0) {
                        var slc = alloc(16);
                        store64(slc, arr_ptr + start);
                        store64(slc + 8, i - start);
                        vec_push(items, slc);
                        start = 0 - 1;
                    }
                } else {
                    i = i + 1;
                }
            }
        }
    }
    return items;
}

# True if the request opts into async mode via a top-level "async": true.
# 2.9.17: through _top_key_value, depth- and string-aware. The raw scan took the first "async" anywhere, so a batch
# item carrying "async": true made the whole batch async, and a nested "async": false ahead of the top-level true
# kept it synchronous: the bug 2.6.9 fixed for the chat handlers' keys.
fn _batch_is_async(body, len) {
    var j = _top_key_value(body, len, "\"async\"", 7);
    if (j < 0) { return 0; }
    if (j + 4 <= len && memeq(body + j, "true", 4) == 1) { return 1; }
    return 0;
}

# Paths whose handler parses a request body — these are POST-only; main.cyr's http_route answers 405 to any other
# verb on them. Keep in sync with the POST section of http_route; a route missing here simply keeps the old
# verb-agnostic behavior rather than breaking. /v1/models/refresh takes no body but runs a refresh, so it is here
# too. Moved from main.cyr in 2.9.21: the tests' copy had kept 4 of these 19 paths.
fn _requires_post(path) {
    if (streq(path, "/v1/chat/completions") == 1) { return 1; }
    if (streq(path, "/v1/embeddings") == 1) { return 1; }
    if (streq(path, "/v1/batch") == 1) { return 1; }
    if (streq(path, "/v1/tokens/check") == 1) { return 1; }
    if (streq(path, "/v1/tokens/reserve") == 1) { return 1; }
    if (streq(path, "/v1/tokens/report") == 1) { return 1; }
    if (streq(path, "/v1/hardware/placement") == 1) { return 1; }
    if (streq(path, "/v1/hardware/cost") == 1) { return 1; }
    if (streq(path, "/v1/hardware/training-estimate") == 1) { return 1; }
    if (streq(path, "/v1/hardware/model-format") == 1) { return 1; }
    if (streq(path, "/v1/hardware/requirement-match") == 1) { return 1; }
    if (streq(path, "/v1/hardware/simulate") == 1) { return 1; }
    if (streq(path, "/v1/models/pull") == 1) { return 1; }
    if (streq(path, "/v1/models/delete") == 1) { return 1; }
    if (streq(path, "/v1/training/status") == 1) { return 1; }
    if (streq(path, "/v1/cost/estimate") == 1) { return 1; }
    if (streq(path, "/v1/cost/recommend") == 1) { return 1; }
    if (streq(path, "/v1/tools/call") == 1) { return 1; }
    if (streq(path, "/v1/models/refresh") == 1) { return 1; }
    return 0;
}
