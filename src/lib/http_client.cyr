# http_client.cyr — HTTP POST client for forwarding to provider backends
# Uses raw TCP sockets with proper CRLF byte construction

# Socket deadlines for the local (plaintext) provider path, matching rust-old:
# connect_timeout(10s) from client.rs:127 and the 300 s request timeout from
# provider/mod.rs:26. Before 2.5.3 there were none — a backend that accepted a
# connection and then went silent pinned a worker thread forever.
var HTTP_CONNECT_TIMEOUT_MS = 10000;
var HTTP_IO_TIMEOUT_S = 300;
# Response buffer cap. The allocation is CAP+1 so a NUL terminator written by
# a caller at the end of a full buffer stays inside it.
var HTTP_RESP_CAP = 131072;

# ── Per-thread scratch for the local client and local streams (2.10.0) ──
# Through 2.9.26 every local request took a 2 KiB header buffer and a 128 KiB + 1 response buffer from the arena that
# never frees, and every local stream took 4 + 4 + 64 KiB more: 139 KB a buffered request and 79 KB a stream
# through an Ollama route, measured over 3000 requests with unique prompts. Each thread now allocates each block
# once and reuses it. The contract: a local response (the parsed struct's body points into the buffer) lives until
# the SAME thread's next http_req_local, and a stream's buffers until its next stream. Every caller reads the body
# (extracting text, copying ids, or writing it to the client) before it makes another local request; a provider's
# error body is copied by provider_err_set. Slots 1..6 are taken (trace, request buffer, provider error, auth
# identity, completion id, remote arena); 16 and up are the stdlib's.
# 2.11.2 (ADR 013): the parsed response record is the block's too, so its lifetime is the body's, and a request takes
# the host and the Content-Length digits on the stack. Through 2.11.1 a local request kept 80 bytes on the heap: the
# host's copy, a 32-byte digit buffer and the 32-byte record.
var LOCAL_HTTP_SLOT = 7;
var LH_RESP = 0;         # the parsed response record, 32 bytes (lib/http.cyr's _http_parse_into), 64 reserved
var LH_HDR = 64;         # the request header, 2048 bytes
var LH_BUF = 2112;       # the response, HTTP_RESP_CAP + 1 bytes

fn _local_http_scratch() {
    var b = thread_local_get(LOCAL_HTTP_SLOT);
    if (b == 0) {
        b = alloc(LH_BUF + HTTP_RESP_CAP + 1);
        if (b == 0) { return 0; }
        thread_local_set(LOCAL_HTTP_SLOT, b);
    }
    return b;
}

# A local stream's buffers: the backend's response head (4096), each read (4096) and the line being assembled
# (65536). provider.cyr reads the head, then handle_chat_stream reads the body; the two never overlap.
var STREAM_SCRATCH_SLOT = 8;
var SS_HDR = 0;
var SS_READ = 4096;
var SS_LINE = 8192;
var SS_SIZE = 8192 + 65536;

fn stream_scratch() {
    var b = thread_local_get(STREAM_SCRATCH_SLOT);
    if (b == 0) {
        b = alloc(SS_SIZE);
        if (b == 0) { return 0; }
        thread_local_set(STREAM_SCRATCH_SLOT, b);
    }
    return b;
}

# A local stream's silence after one backend read (2.7.0 keep-alive). `idle_s` is the silence so far, `n` what
# sys_read returned on a socket whose read times out every SSE_KEEPALIVE_S (http_server.cyr). A timeout (-EAGAIN)
# adds SSE_KEEPALIVE_S, and the caller sends an SSE comment so a proxy's idle timeout does not cut the stream; data
# resets the silence to 0. Returns the new silence, or -1 when the stream should end: the backend closed or failed,
# or HTTP_IO_TIMEOUT_S passed with nothing from it. handle_chat_stream's local loop; the tests had a copy of it
# through 2.9.21.
fn sse_idle_next(idle_s, n) {
    if (n == 0 - EAGAIN) {
        var idle = idle_s + SSE_KEEPALIVE_S;
        if (idle >= HTTP_IO_TIMEOUT_S) { return 0 - 1; }
        return idle;
    }
    if (n <= 0) { return 0 - 1; }
    return 0;
}

# Generic request header for an arbitrary method (GET/POST/DELETE/...).
# method must be a cstr like "POST" or "DELETE"; a single space follows it.
# Returns the header length, or -1 if it would not fit in `cap` bytes.
# `path` reaches here from a request handler and can carry client-supplied
# text, so the fixed 2048-byte buffer needs a real bound, not an assumption.
fn _build_req_header(buf, method, path, host, body_len, cap) {
    var _tp0 = trace_current_or_new();
    var need = strlen(method) + 1 + strlen(path) + 9 + 2
    + 6 + strlen(host) + 2
    + 30 + 2 + 17 + 2
    + 16 + 32 + 2
    + 13 + strlen(_tp0) + 2
    + 2 + 1;
    if (need > cap) { return 0 - 1; }
    var pos = 0;
    memcpy(buf + pos, method, strlen(method)); pos = pos + strlen(method);
    store8(buf + pos, 32); pos = pos + 1;
    memcpy(buf + pos, path, strlen(path)); pos = pos + strlen(path);
    memcpy(buf + pos, " HTTP/1.0", 9); pos = pos + 9;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Host: ", 6); pos = pos + 6;
    memcpy(buf + pos, host, strlen(host)); pos = pos + strlen(host);
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Content-Type: application/json", 30); pos = pos + 30;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Connection: close", 17); pos = pos + 17;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Content-Length: ", 16); pos = pos + 16;
    var cl_buf[32];
    var cl_len = fmt_int_buf(body_len, &cl_buf);
    memcpy(buf + pos, &cl_buf, cl_len); pos = pos + cl_len;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    var _tpl = strlen(_tp0);
    memcpy(buf + pos, "traceparent: ", 13); pos = pos + 13;
    memcpy(buf + pos, _tp0, _tpl); pos = pos + _tpl;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    return pos;
}

# Same capacity contract as _build_req_header.
fn _build_post_header(buf, path, host, body_len, cap) {
    var _tp1 = trace_current_or_new();
    var need = 5 + strlen(path) + 9 + 2
    + 6 + strlen(host) + 2
    + 30 + 2 + 17 + 2
    + 16 + 32 + 2
    + 13 + strlen(_tp1) + 2
    + 2 + 1;
    if (need > cap) { return 0 - 1; }
    var pos = 0;
    memcpy(buf + pos, "POST ", 5); pos = pos + 5;
    memcpy(buf + pos, path, strlen(path)); pos = pos + strlen(path);
    memcpy(buf + pos, " HTTP/1.0", 9); pos = pos + 9;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Host: ", 6); pos = pos + 6;
    memcpy(buf + pos, host, strlen(host)); pos = pos + strlen(host);
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Content-Type: application/json", 30); pos = pos + 30;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Connection: close", 17); pos = pos + 17;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    memcpy(buf + pos, "Content-Length: ", 16); pos = pos + 16;
    var cl_buf[32];
    var cl_len = fmt_int_buf(body_len, &cl_buf);
    memcpy(buf + pos, &cl_buf, cl_len); pos = pos + cl_len;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    var _tpl1 = strlen(_tp1);
    memcpy(buf + pos, "traceparent: ", 13); pos = pos + 13;
    memcpy(buf + pos, _tp1, _tpl1); pos = pos + _tpl1;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    store8(buf + pos, 13); store8(buf + pos + 1, 10); pos = pos + 2;
    return pos;
}

# HTTP request to the http:// backend named by base_url, with an arbitrary
# method (GET/POST/DELETE). Connects to the URL's host:port — NOT a hardcoded
# localhost — so LAN/remote http backends (e.g. an Ollama box at 192.168.x.y)
# are reachable. body may be 0 with body_len 0 for bodyless methods. Returns
# the parsed response (status, body, length: http_status / http_body /
# http_body_len), in this thread's scratch block like its body, or 0.
fn http_req_local(method, base_url, path, body, body_len) {
    var _sr_t, _sr_v = tcp_socket();
    if (is_ok(_sr_t) == 0) { return 0; }
    var fd = _sr_v;
    var hbuf[256];
    var host = url_host_in(base_url, &hbuf, 256);
    # 2.5.3: bounded connect + read/write. rust-old had connect_timeout(10s) and
    # a 300 s request timeout (client.rs:127, provider/mod.rs:26); the port had
    # NEITHER, so a wedged local backend parked a worker inside connect() or
    # read() indefinitely — and with only 7 workers, seven such calls hang the
    # whole gateway.
    if (net_connect_nb(fd, host_addr(host), url_port(base_url), HTTP_CONNECT_TIMEOUT_MS) != 0) {
        sock_close(fd);
        return 0;
    }
    sock_set_recv_timeout(fd, HTTP_IO_TIMEOUT_S, 0);
    sock_set_send_timeout(fd, HTTP_IO_TIMEOUT_S, 0);
    var scr = _local_http_scratch();
    if (scr == 0) { sock_close(fd); return 0; }
    var hdr = scr + LH_HDR;
    var hlen = _build_req_header(hdr, method, path, host, body_len, 2048);
    if (hlen < 0) { sock_close(fd); return 0; }
    sys_write(fd, hdr, hlen);
    if (body_len > 0) { sys_write(fd, body, body_len); }
    # One byte of headroom: the read cap stays at HTTP_RESP_CAP, but
    # jsonlite's extractors do `store8(body + len, 0)` on the returned span,
    # which lands one past the allocation when a provider fills the buffer
    # exactly — into the shared bump arena at the offset the next alloc on any
    # of 7 workers is about to receive.
    var rbuf = scr + LH_BUF;
    var total = 0;
    var n = 1;
    while (n > 0 && total < HTTP_RESP_CAP) {
        n = sys_read(fd, rbuf + total, HTTP_RESP_CAP - total);
        if (n > 0) { total = total + n; }
    }
    sys_close(fd);
    if (total == 0) { return 0; }
    # A response that reached the cap was truncated mid-body; parsing it yields
    # silent garbage, so refuse it instead.
    if (total >= HTTP_RESP_CAP) { return 0; }
    store8(rbuf + total, 0);
    return _http_parse_into(scr + LH_RESP, rbuf, total);
}

# HTTP POST to the http:// backend named by base_url. Returns
# http_req_local's response or 0.
fn http_post_local(base_url, path, body, body_len) {
    return http_req_local("POST", base_url, path, body, body_len);
}

# HTTP POST that returns the open fd for streaming reads.
# Caller must skip HTTP headers then read chunks.
# Returns fd (>= 0) or -1 on failure.
fn http_post_stream(base_url, path, body, body_len) {
    var _sr_t, _sr_v = tcp_socket();
    if (is_ok(_sr_t) == 0) { return 0 - 1; }
    var fd = _sr_v;
    var hbuf[256];
    var host = url_host_in(base_url, &hbuf, 256);
    if (net_connect_nb(fd, host_addr(host), url_port(base_url), HTTP_CONNECT_TIMEOUT_MS) != 0) {
        sock_close(fd);
        return 0 - 1;
    }
    # The read timeout is the whole-stream idle bound, not a per-token one: an
    # SSE stream legitimately pauses between tokens, so this only fires when the
    # backend has genuinely stopped talking.
    sock_set_recv_timeout(fd, HTTP_IO_TIMEOUT_S, 0);
    sock_set_send_timeout(fd, HTTP_IO_TIMEOUT_S, 0);
    var scr = _local_http_scratch();
    if (scr == 0) { sock_close(fd); return 0 - 1; }
    var hdr = scr + LH_HDR;
    var hlen = _build_post_header(hdr, path, host, body_len, 2048);
    if (hlen < 0) { sock_close(fd); return 0 - 1; }
    sys_write(fd, hdr, hlen);
    sys_write(fd, body, body_len);
    return fd;
}

# Skip HTTP response headers on a streaming fd.
# Returns offset into buf where body starts, or -1.
fn stream_skip_headers(fd, buf, buf_sz) {
    var total = 0;
    while (total < buf_sz - 1) {
        var n = sys_read(fd, buf + total, 1);
        if (n <= 0) { return 0 - 1; }
        total = total + 1;
        if (total >= 4) {
            var b0 = load8(buf + total - 4) == 13;
            var b1 = load8(buf + total - 3) == 10;
            var b2 = load8(buf + total - 2) == 13;
            var b3 = load8(buf + total - 1) == 10;
            if (b0 && b1 && b2 && b3) {
                return total;
            }
        }
    }
    return 0 - 1;
}

# Extract port number from URL like "http://localhost:11434"
# url_port / url_host moved to urlparse.cyr (2.8.0), scheme-aware and tested for real.

# Resolve a host cstr to a network-byte-order IPv4 address for sockaddr_in:
# "localhost" -> 127.0.0.1; a dotted-quad literal is parsed directly; any other
# name is resolved via sandhi's DNS. On any miss, fall back to loopback (the
# historical hardcoded target) so a misconfigured host fails cleanly as
# "backend unreachable" rather than dereferencing garbage. The DNS leg only
# runs for non-literal hostnames — bare-IP backends (the common local case)
# never touch it.
fn host_addr(host) {
    if (host == 0) { return 0x0100007F; }
    if (strlen(host) == 9 && memeq(host, "localhost", 9) == 1) { return 0x0100007F; }
    var lit = sandhi_net_parse_ipv4(host);
    if (lit != 0 - 1) { return lit; }
    var dns = sandhi_resolve_ipv4(host);
    if (dns != 0 - 1 && dns != 0) { return dns; }
    return 0x0100007F;
}
