# hoosh/lib/provider_err — the provider's OWN error, kept rather than thrown away (2.6.5).
#
# ⚠ WHY THIS FILE EXISTS. A non-2xx from a provider used to vanish. `provider_forward` returned
# `FWD_PERMANENT` (or 0) and logged one fixed sentence — `provider: permanent error, not retrying` — and
# the response body, where every provider puts the reason, was dropped on the floor. Downstream that
# produced the worst possible shape: `handle_chat_stream` had already sent `200 OK` headers, its buffered
# fallback then also failed, and the handler finished with a clean `finish_reason:"stop"` frame. The
# client received a well-formed, successful, EMPTY completion.
#
# Measured against a live stack: thoth reported *"response had neither tool calls nor content"* and its
# operator spent a long session believing the model had gone quiet, while hoosh's own log knew only that
# something had been permanent. **An error laundered into a success is worse than a crash**, because
# nothing downstream can tell that it happened.
#
# SEPARATE MODULE, not a block inside provider.cyr, for one reason: provider.cyr reaches `_router`, which
# is a global defined in main.cyr, so it cannot be included by the test binary. This surface is pure
# string handling over untrusted provider bytes — exactly the thing that must be tested against the real
# implementation rather than a mirror — so it lives where a test can reach it.

var PROVIDER_ERR_MSG_CAP = 512;

# ── Completion id and created (2.7.0) ──
# Every chat.completion carried the same id, "chatcmpl-hoosh", and no `created`.
# rust-old gave each completion chatcmpl-<uuid> and a unix timestamp; its OpenAI
# conformance tests required both, and clients key on the id. They live here
# because this is the OpenAI-envelope module the test binary can include.
#
# One id per completion, held per thread so every chunk of a stream carries the
# same one. Thread-local slot 5 points at a 48-byte buffer allocated once per
# thread and reused, so a request allocates nothing for it (hoosh never frees):
#   0: "chatcmpl-" + 24 hex digits + NUL (34 bytes)   40: created, unix seconds
var CHAT_ID_SLOT = 5;
var CHAT_ID_CREATED = 40;

fn _chat_id_buf() {
    var b = thread_local_get(CHAT_ID_SLOT);
    if (b == 0) {
        b = alloc(48);
        if (b == 0) { return 0; }
        memcpy(b, "chatcmpl-hoosh", 15);
        store64(b + CHAT_ID_CREATED, 0);
        thread_local_set(CHAT_ID_SLOT, b);
    }
    return b;
}

# Lowercase hex of the low 4 bits of n.
fn _chat_hex(n) {
    if (n < 10) { return 48 + n; }
    return 87 + n;
}

# Start a new completion on this thread: 96 random bits for the id, and the time.
# If getrandom fails, the clock and a counter still keep ids distinct.
var _chat_id_counter = 0;
fn chat_id_new() {
    var b = _chat_id_buf();
    if (b == 0) { return 0; }
    var r[16];
    if (sys_getrandom(&r, 12, 0) != 12) {
        var old = load64(&_chat_id_counter);
        while (atomic_cas(&_chat_id_counter, old, old + 1) == 0) { old = load64(&_chat_id_counter); }
        store64(&r, clock_now_ns());
        store64(&r + 8, old + 1);
    }
    memcpy(b, "chatcmpl-", 9);
    var i = 0;
    while (i < 12) {
        var bv = load8(&r + i) & 0xFF;
        store8(b + 9 + i * 2, _chat_hex(bv >> 4));
        store8(b + 10 + i * 2, _chat_hex(bv & 15));
        i = i + 1;
    }
    store8(b + 33, 0);
    store64(b + CHAT_ID_CREATED, clock_epoch_secs());
    return b;
}

# This thread's current completion id ("chatcmpl-hoosh" before the first one).
fn chat_id() {
    var b = _chat_id_buf();
    if (b == 0) { return "chatcmpl-hoosh"; }
    return b;
}

# The current completion's created time; now, if none has been started.
fn chat_created() {
    var b = _chat_id_buf();
    if (b == 0) { return clock_epoch_secs(); }
    var t = load64(b + CHAT_ID_CREATED);
    if (t == 0) { return clock_epoch_secs(); }
    return t;
}

# `{"id":"<id>","object":"<kind>","created":<t>,` — the head of every
# chat.completion and chat.completion.chunk.
fn sb_add_chat_head(sb, kind) {
    str_builder_add_cstr(sb, "{\"id\":\"");
    str_builder_add_cstr(sb, chat_id());
    str_builder_add_cstr(sb, "\",\"object\":\"");
    str_builder_add_cstr(sb, kind);
    str_builder_add_cstr(sb, "\",\"created\":");
    str_builder_add_int(sb, chat_created());
    str_builder_add_cstr(sb, ",");
    return 0;
}

# A cached chat.completion with a fresh head. The cache stores whole envelopes,
# so a hit used to replay the first response's id and created time; a client
# that dedupes by id would drop it. Returns the envelope unchanged if it does
# not start with the head sb_add_chat_head writes.
fn chat_rehead(env) {
    if (env == 0) { return env; }
    if (memeq(env, "{\"id\":\"", 7) == 0) { return env; }
    var n = strlen(env);
    var i = 7;
    var key = "\"created\":";
    while (i + 10 <= n && memeq(env + i, key, 10) == 0) {
        if (i > 96) { return env; }
        i = i + 1;
    }
    if (i + 10 > n) { return env; }
    i = i + 10;
    while (i < n && load8(env + i) >= 48 && load8(env + i) <= 57) { i = i + 1; }
    if (i >= n || load8(env + i) != 44) { return env; }
    i = i + 1;
    chat_id_new();
    var sb = str_builder_new();
    sb_add_chat_head(sb, "chat.completion");
    str_builder_add_cstr(sb, env + i);
    return to_cstr(str_builder_build(sb));
}

# PER-THREAD state (2.6.8). These four slots used to be process globals, which
# was wrong from the moment the v2.4.0 worker pool landed: provider_err_reset()
# and provider_err_set() run inside provider_forward, which every caller invokes
# with _chat_lock RELEASED, while readers take _chat_lock — a lock that protects
# nothing against writers holding nothing. Two concrete failures: another
# worker's reset wiped a captured error before its owner read it, silently
# regressing every diagnostic this file exists to provide back to "provider
# backend unreachable"; and one client could be answered with another client's
# provider error text. The message buffer was also truncated before being
# re-terminated, so a concurrent strlen could splice new bytes onto a stale tail.
#
# Thread-local slot 3 (1 = trace, 2 = request buffer). Layout, 32 bytes:
#   0: status   8: msg cstr   16: log line cstr   24: client msg cstr
var PROVIDER_ERR_SLOT = 3;
var PE_STATUS = 0;
var PE_MSG = 8;
var PE_LINE = 16;
var PE_CMSG = 24;

fn _pe() {
    var e = thread_local_get(PROVIDER_ERR_SLOT);
    if (e == 0) {
        e = alloc(32);
        if (e == 0) { return 0; }
        store64(e + PE_STATUS, 0);
        store64(e + PE_MSG, 0);
        store64(e + PE_LINE, 0);
        store64(e + PE_CMSG, 0);
        thread_local_set(PROVIDER_ERR_SLOT, e);
    }
    return e;
}

# provider_last_error_status: the status of the most recent provider failure, or 0 if the most recent
# attempt did not fail. ONE slot, overwritten per attempt (a retry's later answer is the one that
# matters) and reset at the top of provider_forward, so a stale error can never be attributed to a
# later request.
fn provider_last_error_status() {
    var e = _pe();
    if (e == 0) { return 0; }
    return load64(e + PE_STATUS);
}

fn provider_last_error_msg() {
    var e = _pe();
    if (e == 0) { return ""; }
    var m = load64(e + PE_MSG);
    if (m == 0) { return ""; }
    return m;
}

fn provider_err_reset() {
    var e = _pe();
    if (e == 0) { return 0; }
    store64(e + PE_STATUS, 0);
    var m = load64(e + PE_MSG);
    if (m != 0) { store8(m, 0); }
    return 0;
}

# provider_err_set: remember `status` and a bounded, single-LINE copy of msg[0..len).
#
# The bytes come from a provider, so they are untrusted in both length and content: an unbounded copy is
# a heap write and an embedded newline would break the log record this ends up in. Control bytes become
# spaces rather than being dropped, so a clipped HTML error page still reads as text.
fn provider_err_set(status, msg, len) {
    var e = _pe();
    if (e == 0) { return 0; }
    store64(e + PE_STATUS, status);
    var buf = load64(e + PE_MSG);
    if (buf == 0) {
        buf = alloc(PROVIDER_ERR_MSG_CAP);
        if (buf == 0) { return 0; }
        store64(e + PE_MSG, buf);
    }
    store8(buf, 0);
    if (msg == 0 || len <= 0) { return 0; }
    var n = len;
    if (n > (PROVIDER_ERR_MSG_CAP - 1)) { n = PROVIDER_ERR_MSG_CAP - 1; }
    var i = 0;
    while (i < n) {
        var c = load8(msg + i) & 255;
        if (c < 32 || c == 127) { c = 32; }
        store8(buf + i, c);
        i = i + 1;
    }
    store8(buf + n, 0);
    return 0;
}

# provider_err_log_line: `provider: HTTP <status>, not retrying - <message>`, or the pre-2.6.5 sentence
# when nothing was captured — an allocation failure must not also cost the line that says something
# went wrong.
fn provider_err_log_line() {
    var e = _pe();
    if (e == 0) { return "provider: permanent error, not retrying"; }
    var st = load64(e + PE_STATUS);
    if (st == 0) { return "provider: permanent error, not retrying"; }
    var m = load64(e + PE_MSG);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "provider: HTTP ");
    str_builder_add_int(sb, st);
    str_builder_add_cstr(sb, ", not retrying");
    if (m != 0) {
        if (strlen(m) > 0) {
            str_builder_add_cstr(sb, " - ");
            str_builder_add_cstr(sb, m);
        }
    }
    var line = to_cstr(str_builder_build(sb));
    store64(e + PE_LINE, line);
    return line;
}

# provider_err_client_msg: the same fact worded for the CALLER rather than the log. Kept separate so the
# client-facing string can never accidentally grow log-only detail. "unreachable" was the old wording and
# it was wrong for the common case: a 400 or a 404 means the provider WAS reached and refused — a
# different problem with a different fix, and telling an operator their backend is down when it answered
# instantly sends them to the wrong place.
fn provider_err_client_msg() {
    var e = _pe();
    if (e == 0) { return "provider backend unreachable"; }
    var st = load64(e + PE_STATUS);
    if (st == 0) { return "provider backend unreachable"; }
    var m = load64(e + PE_MSG);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "upstream provider returned HTTP ");
    str_builder_add_int(sb, st);
    if (m != 0) {
        if (strlen(m) > 0) {
            str_builder_add_cstr(sb, ": ");
            str_builder_add_cstr(sb, m);
        }
    }
    var cmsg = to_cstr(str_builder_build(sb));
    store64(e + PE_CMSG, cmsg);
    return cmsg;
}

# sb_add_json_escaped: append `s` as the body of a JSON string. The message came from a provider, so a
# quote or a control byte in it would otherwise produce a malformed frame and take out the very client
# this whole file exists to inform.
fn sb_add_json_escaped(sb, s) {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i) & 255;
        if (c == 34) { str_builder_add_cstr(sb, "\\\""); }
        elif (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
        elif (c < 32) { str_builder_putc(sb, 32); }
        else { str_builder_putc(sb, c); }
        i = i + 1;
    }
    return 0;
}

# upstream_error_sse_body: the chunk that tells a STREAMING client the turn failed.
#
# ⚠ THE HEADERS ARE ALREADY GONE. `http_sse_begin` sends `200 OK` before the provider is ever called, so
# by the time a provider error arrives there is no status left to change — and the handler's only move
# used to be the stop frame, i.e. a clean `finish_reason:"stop"` with no content. Every client reads that
# as "the model chose to say nothing", which is a lie about whose fault it is.
#
# So the failure is reported IN the stream, as an `error` object. This is the shape OpenAI itself uses
# for a mid-stream failure, so an OpenAI-compatible client already knows how to read it, and a client
# that ignores unknown fields is no worse off than it was. `finish_reason` is `"error"` rather than
# `"stop"` for clients that branch on that alone.
fn upstream_error_sse_body(model, status, message) {
    var sb = str_builder_new();
    sb_add_chat_head(sb, "chat.completion.chunk");
    str_builder_add_cstr(sb, "\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"error\":{\"type\":\"upstream_error\",\"code\":");
    str_builder_add_int(sb, status);
    str_builder_add_cstr(sb, ",\"message\":\"");
    sb_add_json_escaped(sb, message);
    str_builder_add_cstr(sb, "\"},\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"error\"}]}");
    return to_cstr(str_builder_build(sb));
}

# _sse_is_error_event: 1 when this frame is the provider reporting a failure rather than content.
#
# Two precise tests, no substring guessing — a model's own prose routinely contains the word "error", and
# a false positive here would abort a perfectly good stream. Anthropic names the SSE event `error`;
# OpenAI-compatible backends keep the event unnamed and put `"type":"error"` (or an `error` object) in
# the data frame, which `_json_obj_str_field` finds structurally.
fn _sse_is_error_event(ev, data, dlen) {
    var nm = sandhi_sse_event_name(ev);
    if (nm != 0) { if (streq(nm, "error") == 1) { return 1; } }
    var tf = _json_obj_str_field(data, dlen, "type", 4);
    if (tf != 0) {
        if (load64(tf + 8) == 5) { if (memeq(load64(tf), "error", 5) == 1) { return 1; } }
    }
    return 0;
}

# _sse_error_message: the provider's own wording out of an error frame, or a plain fallback. Both
# families nest it as `error.message`, and `_json_extract_str` finds the first `"message"` field at any
# depth, which is exactly that.
fn _sse_error_message(data, dlen) {
    var m = _json_extract_str(data, dlen, "message", 7);
    if (strlen(m) > 0) { return m; }
    return "the provider reported an error mid-stream but gave no message";
}

# Status code from an HTTP response head: `HTTP/1.1 <code> <reason>`.
# Returns 0 when the line is not parseable, which the caller treats as a
# failure rather than assuming success.
fn _stream_status(buf, len) {
    var i = 0;
    while (i < len && load8(buf + i) != 32) { i = i + 1; }
    while (i < len && load8(buf + i) == 32) { i = i + 1; }
    var v = 0;
    var digits = 0;
    while (i < len && digits < 3) {
        var c = load8(buf + i) & 255;
        if (c < 48 || c > 57) { i = len; }
        else {
            v = v * 10 + (c - 48);
            digits = digits + 1;
            i = i + 1;
        }
    }
    if (digits != 3) { return 0; }
    return v;
}
