# otlp_export.cyr — the I/O half of the OTLP span export (2.9.14 split from otlp.cyr).
#
# POSTs the batches otlp.cyr builds: a local http:// collector over a raw socket from
# the exporter thread, an https:// one through the work queue so a pool worker does
# the TLS. Requires: otlp.cyr (the ring, _otlp_batch_into, _otlp_is_https), lib/atomic,
# pool.cyr (wq_push, job_otlp_export), provider.cyr (_remote_arena), urlparse.cyr,
# http_client.cyr (host_addr), sandhi.

# POST an OTLP/JSON body to the collector. Best-effort, ignores the response.
# https:// → sandhi (DNS + TLS); this path only ever runs on a pool worker
# (the exporter thread routes https POSTs through the queue). Local http:// →
# raw socket (the exporter posts these directly).
# 2.11.2 (ADR 013): an https POST's headers are in its job's request arena, and a local one's head and the read
# buffer are on the exporter thread's stack; through 2.11.1 each POST kept them on the heap.
fn _otlp_post(body, blen) {
    if (_otlp_is_https() == 1) {
        var a = req_arena();
        var h = sandhi_headers_new_a(a);
        sandhi_headers_add_a(a, h, "Content-Type", "application/json");
        # 2.9.3: in the worker's scratch arena (provider.cyr _remote_arena): the response is ignored, and
        # through 2.9.2 each export kept its connection, TLS state and receive buffer on the heap for good.
        sandhi_http_post_a(_remote_arena(), _otlp_endpoint, h, body, blen);
        return 0;
    }
    var path = _otlp_path(_otlp_endpoint);
    var _sr_t, _sr_v = tcp_socket();
    if (is_ok(_sr_t) == 0) { return 0; }
    var fd = _sr_v;
    var hbuf[256];                         # 2.11.2: the host on the stack (ADR 013), not a heap copy per export
    var _cr_t, _cr_v = sock_connect(fd, host_addr(url_host_in(_otlp_endpoint, &hbuf, 256)), url_port(_otlp_endpoint));
    if (is_ok(_cr_t) == 0) { sock_close(fd); return 0; }
    var hh[24];
    var hbuf2[512];
    var hdr = sb_on(&hh, &hbuf2, 512);
    str_builder_add_cstr(hdr, "POST ");
    str_builder_add_cstr(hdr, path);
    str_builder_add_cstr(hdr, " HTTP/1.0\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: ");
    str_builder_add_int(hdr, blen);
    str_builder_add_cstr(hdr, "\r\nConnection: close\r\n\r\n");
    var hl = sb_len(hdr);
    sys_write(fd, sb_cstr(hdr), hl);
    sys_write(fd, body, blen);
    var rbuf[512];
    var n = 1;
    while (n > 0) { n = sys_read(fd, &rbuf, 512); }
    sys_close(fd);
    return 0;
}

# 2.11.2: one https export at a time. The exporter builds every batch into one buffer, so it waits for a worker to
# finish posting the last one before it builds the next; spans that arrive meanwhile wait in the ring, which keeps
# its newest OTLP_RING_MAX. The job record is reused too (job_otlp_export's, allocated once).
var _otlp_inflight = 0;   # 1 while a worker holds the batch buffer (atomic: set here, cleared by the worker)
var _otlp_jrec = 0;

# A worker's JOB_OTLP_EXPORT (pool.cyr job_process): post the batch, then hand the buffer back to the exporter.
fn otlp_export_job(job) {
    _otlp_post(load64(job + 8), load64(job + 16));
    atomic_store(&_otlp_inflight, 0);
    return 0;
}

# Background exporter: drain the ring + POST every OTLP_BATCH_MS.
fn _otlp_exporter_thread(arg) {
    var doc = alloc(24);
    if (doc == 0) { return 0; }
    memset(doc, 0, 24);
    while (1 == 1) {
        sleep_ms(OTLP_BATCH_MS);
        while (atomic_load(&_otlp_inflight) == 1) { sleep_ms(10); }
        mutex_lock(_otlp_lock);
        var n = _otlp_count;
        if (n > OTLP_RING_MAX) { n = OTLP_RING_MAX; }
        if (n > 0) { _otlp_batch_into(doc, n); }
        _otlp_count = 0;
        mutex_unlock(_otlp_lock);
        if (n > 0) {
            # Route an https POST through the work queue so a worker does the TLS.
            # Through 2.9.0 that was required: TLS needed a sigil crypto bank, which
            # this exporter thread did not own. Since sigil 3.13.14 any thread can
            # (pool.cyr); the routing is unchanged. Local http is posted directly.
            if (_otlp_is_https() == 1) {
                if (_otlp_jrec == 0) {
                    _otlp_jrec = job_otlp_export(load64(doc), load64(doc + 16));
                } else {
                    store64(_otlp_jrec + 8, load64(doc));
                    store64(_otlp_jrec + 16, load64(doc + 16));
                }
                if (_otlp_jrec != 0) {
                    atomic_store(&_otlp_inflight, 1);
                    wq_push(_otlp_jrec);
                }
            } else {
                _otlp_post(load64(doc), load64(doc + 16));
            }
        }
    }
    return 0;
}

fn otlp_init() {
    if (_otlp_endpoint == 0) { return 0; }
    if (THREADS_CONCURRENT == 0) { return 0; }   # wq.cyr: the exporter would never return, so spans are not exported
    if (_otlp_started == 1) { return 0; }
    if (otlp_ring_init() != 0) { return 0; }
    _otlp_started = 1;
    thread_create(&_otlp_exporter_thread, 0);
    return 0;
}
