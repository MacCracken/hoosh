# ratelimit.cyr — per-provider sliding window rate limiter
#
# NOTE: named hoosh_ratelimit_* deliberately. The vendored majra distlib
# (src/vendor/majra.cyr) exports its own ratelimit_new/ratelimit_check with
# DIFFERENT arities, and hoosh included later, so hoosh silently won every build
# with a "duplicate fn (last definition wins)" warning. It happened to be
# harmless — majra never calls its own — but a shadow that resolves by include
# order is a trap, and the warning masked any real one. Prefixed to collide with
# nothing.
# Uses a simple token bucket: tokens refill at rpm/60 per second.
#
# Limiter layout (32 bytes per entry):
#   0: rpm_limit (i64)     — max requests per minute (0 = unlimited)
#   8: tokens (i64)        — current available tokens (x1000 fixed-point)
#  16: last_refill_ms (i64) — last refill timestamp
#  24: (reserved)

var RL_SIZE = 32;

fn hoosh_ratelimit_new(rpm) {
    var rl = alloc(RL_SIZE);
    store64(rl, rpm);
    store64(rl + 8, rpm * 1000);
    store64(rl + 16, hoosh_now_ms());
    return rl;
}

fn rl_rpm(rl) { return load64(rl); }

# Refill tokens based on elapsed time
fn _rl_refill(rl) {
    var now = hoosh_now_ms();
    var last = load64(rl + 16);
    var elapsed_ms = now - last;
    if (elapsed_ms <= 0) { return 0; }
    var rpm = load64(rl);
    if (rpm == 0) { return 0; }
    # tokens_to_add = rpm * elapsed_ms / 60000 (x1000 fixed-point)
    var add = rpm * elapsed_ms * 1000 / 60000;
    var cur = load64(rl + 8);
    var max_tokens = rpm * 1000;
    cur = cur + add;
    if (cur > max_tokens) { cur = max_tokens; }
    store64(rl + 8, cur);
    # Advance the clock only by the elapsed time this actually converted into
    # tokens, so the truncated remainder is not thrown away.
    #
    # `add` truncates to 0 for a small elapsed_ms, and stamping `now`
    # regardless discarded that interval permanently. Because _rl_refill runs
    # on EVERY check — including rejected ones — a client polling faster than
    # one token's worth of time never accumulated anything. Against the real
    # 5-6 ms tick that made rate_limit = 5 grant 0 rpm outright (total
    # starvation) and 10 grant roughly 3. Free tiers of 5-10 RPM are common,
    # and one tenant polling a shared route drove it to 0 for everyone else.
    var used_ms = add * 60000 / (rpm * 1000);
    if (used_ms > elapsed_ms) { used_ms = elapsed_ms; }
    store64(rl + 16, last + used_ms);
    return 0;
}

# Try to consume one request token. Returns 1 if allowed, 0 if rate limited.
fn hoosh_ratelimit_check(rl) {
    if (rl == 0) { return 1; }
    var rpm = load64(rl);
    if (rpm == 0) { return 1; }
    _rl_refill(rl);
    var cur = load64(rl + 8);
    if (cur >= 1000) {
        store64(rl + 8, cur - 1000);
        return 1;
    }
    return 0;
}
