# cfgparse.cyr — config.cyr's self-contained helpers (2.9.18, split from config.cyr).
#
# config.cyr's load_config reaches nearly every module, so the test suite could not include it and kept copies
# of these. They need only bayan's TOML getters, the environment, the file system and sandhi's TLS policy
# constructors (which record paths and parse nothing until a connection):
#   - strategy_from_str, _config_expand_env ("$NAME" / "${NAME}"), _config_str_array, bind_addr_str;
#   - _config_tls_policy, a provider block's TLS policy (or 0, or -1 to refuse the config);
#   - _config_rate_limit_str, a provider block's rate limit text.
# Requires: types.cyr (STRAT_*), logging.cyr, http_server.cyr (to_cstr), bayan (TOML), sandhi (TLS policy).

# Routing strategy from [server] strategy (default priority). Maps the four
# implemented strategies; an unknown value falls back to priority.
fn strategy_from_str(s) {
    if (streq(s, "round-robin") == 1 || streq(s, "roundrobin") == 1) { return STRAT_ROUND_ROBIN; }
    if (streq(s, "lowest-latency") == 1 || streq(s, "lowest_latency") == 1) { return STRAT_LOWEST_LATENCY; }
    if (streq(s, "direct") == 1) { return STRAT_DIRECT; }
    return STRAT_PRIORITY;
}

# Expand a config value: "$NAME" -> getenv("NAME"), so secrets (API keys)
# live in the environment, not in hoosh.cyml. Returns 0 if the env var is
# unset; passes non-"$" values through unchanged.
fn _config_expand_env(value) {
    if (value == 0) { return 0; }
    if (load8(value) != 36) { return value; }
    var name = value + 1;
    # Accept ${NAME} as well as $NAME. `load8(value) == 36` was already true
    # for the braced form, so getenv("{NAME}") simply missed and the value was
    # dropped with no diagnostic.
    var n = strlen(name);
    if (n > 2 && load8(name) == 123 && load8(name + n - 1) == 125) {
        var inner = alloc(n - 1);
        if (inner == 0) { return 0; }
        memcpy(inner, name + 1, n - 2);
        store8(inner + n - 2, 0);
        name = inner;
    }
    var got = getenv(name);
    if (got == 0) {
        # An unset variable used to be dropped silently: the route kept
        # ROUTE_API_KEY = 0, _provider_headers skipped the auth block, and the
        # request went upstream with NO credential — surfacing as a provider
        # 401 the operator naturally blamed on the provider.
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "config: environment variable is not set: ");
        str_builder_add_cstr(sb, name);
        var msg = to_cstr(str_builder_build(sb));
        hlog_warn(msg);
    }
    return got;
}

# Bounds for the TOML string arrays below. The old inline `models` parser
# allocated 8 slots and never checked, so a 9th pattern wrote past the end.
var MAX_MODEL_PATTERNS = 32;
var MAX_AUTH_TOKENS = 32;
var MAX_DISABLED_BACKENDS = 32;

# The strings of TOML key `key` in the section `pairs`, as up to `max` freshly allocated cstrs at `out`; returns
# the count, 0 when the key is absent. An array (`["a", "b"]`) gives its elements, read by bayan's own array
# parser: quotes are tracked, so a `,` or `]` inside a string stays in it; a basic string's escapes are decoded and
# a literal string ('...') is kept verbatim; comments and the whitespace between elements are skipped. Any other
# value (`x = "solo"`) is one element, so single-value configs keep working. Empty elements are skipped, and so is
# one holding a NUL byte (`\u0000`): a C string would cut it short, and a token "abc\u0000def" must not become
# "abc".
#
# 2.9.23: through 2.9.22 this took the value's raw text and split it on `,` `]` `"` and spaces itself, with no
# notion of a quote. A token "abc,def" loaded as two tokens, each of which authenticated; `"we\"ird"` became
# `we\` and `ird`; a `# comment` inside a multi-line array, and the line breaks between its elements, became
# elements; literal strings kept their quotes; escapes were never decoded. It reads `[auth] tokens`, model
# patterns, `tls_pinned_certs` and `[hardware] disabled_backends`.
fn _config_str_array(pairs, key, out, max) {
    var pr = bayan_toml_get_pair_by_cstr(pairs, key);
    if (pr == 0) { return 0; }
    var v = bayan_toml_pair_value(pr);
    if (v == 0) { return 0; }
    var els = 0;
    if (bayan_toml_pair_is_array(pr) == true) {
        els = bayan_toml_array_parse(v);
        if (els == 0) { return 0; }
    } else {
        els = vec_new();
        vec_push(els, v);
    }
    var count = 0;
    var i = 0;
    while (i < vec_len(els) && count < max) {
        var e = vec_get(els, i);
        var n = str_len(e);
        var p = str_data(e);
        var j = 0;
        while (j < n && load8(p + j) != 0) { j = j + 1; }
        if (j < n) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "config: an element of `");
            str_builder_add_cstr(sb, key);
            str_builder_add_cstr(sb, "` holds a NUL byte; skipped");
            hlog_warn(to_cstr(str_builder_build(sb)));
        } elif (n > 0) {
            var c = alloc(n + 1);
            memcpy(c, p, n);
            store8(c + n, 0);
            store64(out + count * 8, c);
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

# Dotted-quad text for a packed network-byte-order IPv4 (0x0100007F ->
# "127.0.0.1"), for the startup banner. Octets are LSB-first.
fn bind_addr_str(addr) {
    var sb = str_builder_new();
    str_builder_add_int(sb, addr & 0xFF);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, (addr >> 8) & 0xFF);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, (addr >> 16) & 0xFF);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, (addr >> 24) & 0xFF);
    return to_cstr(str_builder_build(sb));
}

# Per-provider TLS policy (2.7.0): rust-old's tls_pinned_certs / client_cert /
# client_key (config.rs:281-287). tls_pinned_certs were PEM files trusted as the
# ONLY roots for that provider (reqwest tls_certs_only), which is sandhi's trust
# store; the client pair is sandhi mTLS. sandhi takes one trust bundle, so the
# certificates go in one PEM file. Returns the policy, 0 for none, or -1 when the
# block would silently weaken TLS (several bundles, a missing file, half an mTLS
# pair), which fails the config load rather than falling back to the system roots.
fn _config_tls_policy(pp, purl) {
    var pins = bayan_toml_get_by_cstr(pp, "tls_pinned_certs");
    var ccert = bayan_toml_get_by_cstr(pp, "client_cert");
    var ckey = bayan_toml_get_by_cstr(pp, "client_key");
    if (pins == 0 && ccert == 0 && ckey == 0) { return 0; }
    if (memeq(purl, "https", 5) == 0) {
        hlog_warn("config: tls_pinned_certs / client_cert / client_key apply to https providers; ignored");
        return 0;
    }
    var pol = 0;
    if (pins != 0) {
        var arr = alloc(8 * 8);
        var n = _config_str_array(pp, "tls_pinned_certs", arr, 8);
        if (n > 1) {
            hlog_error("config: tls_pinned_certs takes one PEM bundle; put the certificates in one file");
            return 0 - 1;
        }
        if (n == 1) {
            var bundle = load64(arr);
            if (file_exists(bundle) == 0) {
                hlog_error("config: tls_pinned_certs bundle not found");
                return 0 - 1;
            }
            pol = sandhi_tls_policy_new_trust_store(bundle);
            if (pol == 0) { return 0 - 1; }
        }
    }
    if (ccert != 0 || ckey != 0) {
        if (ccert == 0 || ckey == 0) {
            hlog_error("config: client_cert and client_key must be set together");
            return 0 - 1;
        }
        var cc = to_cstr(ccert);
        var ck = to_cstr(ckey);
        if (file_exists(cc) == 0 || file_exists(ck) == 0) {
            hlog_error("config: client_cert or client_key file not found");
            return 0 - 1;
        }
        var m = sandhi_tls_policy_new_mtls(cc, ck);
        if (m == 0) { return 0 - 1; }
        pol = sandhi_tls_policy_combine(pol, m);
    }
    if (pol != 0 && sandhi_tls_policy_enforcement_available() == 0) {
        hlog_warn("config: TLS policy set but this build cannot enforce it; the route will fail closed");
    }
    return pol;
}

# A provider block's rate limit (RPM) text, or 0. 2.7.0: rust-old's key, `rate_limit_rpm`, is
# accepted too; ADR 004 documents it, and a config carried over from rust-old used to run with no
# limit at all. `rate_limit` wins if both. (2.9.18: lifted out of load_config's provider loop.)
fn _config_rate_limit_str(pp) {
    var rpm_str = bayan_toml_get_by_cstr(pp, "rate_limit");
    if (rpm_str == 0) { rpm_str = bayan_toml_get_by_cstr(pp, "rate_limit_rpm"); }
    return rpm_str;
}
