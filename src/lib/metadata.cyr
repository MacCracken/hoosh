    _meta_add(arr, 33, "gpt-5-nano", 400000, TIER_ECONOMY, 1, 1, 1, 0);
    _meta_add(arr, 34, "gpt-4.1", 1047576, TIER_STANDARD, 1, 1, 1, 1);
