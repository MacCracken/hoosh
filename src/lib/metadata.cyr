    _meta_add(arr, 19, "gpt-6-astra", 1050000, TIER_PREMIUM, 1, 0, 1, 1);
    _meta_add(arr, 20, "gpt-6.1-sol", 1050000, TIER_STANDARD, 1, 0, 1, 1);
