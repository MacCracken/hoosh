    _meta_add(arr, 16, "claude-sonnet-4", 200000, TIER_STANDARD, 1, 1, 1, 0);
    _meta_add(arr, 17, "claude-haiku-5-5", 1000000, TIER_ECONOMY, 1, 1, 1, 1);
    _meta_add(arr, 18, "claude-haiku-4-5", 200000, TIER_ECONOMY, 1, 1, 1, 1);
    # Non-Anthropic rows, 2.8.0: each provider's official model and pricing pages, read 2026-10-09. listed = 0 for
    # anything shut down or with an announced shutdown (kept, so old traffic still finds its context window), and
