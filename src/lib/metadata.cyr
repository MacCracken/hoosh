    _meta_add(arr, 43, "o1-mini", 128000, TIER_REASONING, 0, 1, 1, 0);
    # Google. The 3.6-3.8 Flash prices are introductory (pricing.cyr); 2.5 is limited to prior users; 2.0 is shut down.
