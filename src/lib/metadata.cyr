    _meta_tbl = arr;
    _meta_n = _META_CAP;
    return 0;
}

# Number of rows in the compiled table (after lazy init).
fn metadata_count() { _meta_init(); return _meta_n; }

# The model-id key (cstr) of row i, 0 <= i < metadata_count().
fn metadata_key(i) { _meta_init(); return load64(_meta_tbl + i * 56); }

# 1 when row i is an id worth offering (not a family prefix, not retired) — the static catalog's filter (2.8.0).
fn metadata_listed(i) { _meta_init(); return load64(_meta_tbl + i * 56 + 48); }

# Copy entry e's fields into out: ctx(0) tier(8) vision(16) tools(24) sys(32).
fn _meta_copy(e, out) {
    store64(out, load64(e + 8));
    store64(out + 8, load64(e + 16));
    store64(out + 16, load64(e + 24));
    store64(out + 24, load64(e + 32));
    store64(out + 32, load64(e + 40));
    return 0;
}

# The compiled table alone: exact, then longest prefix. Returns 1 if found.
fn _meta_table_lookup(model, out) {
    _meta_init();
    var ml = strlen(model);
    var i = 0;
    while (i < _meta_n) {
        var e = _meta_tbl + i * 56;
        if (streq(model, load64(e)) == 1) {
            _meta_copy(e, out);
            return 1;
        }
        i = i + 1;
    }
    var best = 0 - 1;
    var best_len = 0;
    i = 0;
    while (i < _meta_n) {
        var e = _meta_tbl + i * 56;
        var key = load64(e);
        var kl = strlen(key);
        if (kl <= ml) {
            if (memeq(model, key, kl) == 1) {
                if (kl > best_len) {
                    best_len = kl;
                    best = i;
                }
            }
        }
        i = i + 1;
    }
    if (best >= 0) {
        _meta_copy(_meta_tbl + best * 56, out);
        return 1;
    }
    return 0;
}

# Fold a catalog entry's known fields over `out` (2.8.0): a known context window and vision bit win; an unknown
# one leaves what the table said. A model only the provider knows gets STANDARD, tools and system on — every
# chat model a provider lists today takes both.
fn _meta_from_entry(e, out, have) {
    if (have == 0) {
        store64(out, 0);
        store64(out + 8, TIER_STANDARD);
        store64(out + 16, 0);
        store64(out + 24, 1);
        store64(out + 32, 1);
    }
    if (cat_e_ctx(e) > 0) { store64(out, cat_e_ctx(e)); }
    if (cat_e_vision(e) >= 0) { store64(out + 16, cat_e_vision(e)); }
    if (cat_e_tier(e) >= 0) { store64(out + 8, cat_e_tier(e)); }
    if (have == 0 && load64(out) <= 0) { return 0; }   # no context window anywhere: not usable metadata
    return 1;
}

# Look up model metadata into out (ctx,tier,vision,tools,sys). 2.8.0 order: the compiled table (exact, then
# longest prefix) for the tier, then what the provider's live list says (its real context window — Claude 4.6 and
# later are 1M, a figure the 2.7.1 table had as 200K for every Claude), then the operator's [[models]] block,
# which wins. Returns 1 if found, 0 if unknown.
fn metadata_lookup(model, out) {
    var have = _meta_table_lookup(model, out);
    var live = catalog_find_any(model);
    if (live != 0) { have = _meta_from_entry(live, out, have) | have; }
    var cfg = catalog_config_find(model);
    if (cfg != 0) { have = _meta_from_entry(cfg, out, have) | have; }
    return have;
}

# Minimum tier a request needs (mirrors CostOptimizer::classify_complexity).
fn classify_complexity(in_tok, uses_tools, has_vision) {
    if (has_vision == 1) { return TIER_STANDARD; }
    if (uses_tools == 1 && in_tok > 2000) { return TIER_STANDARD; }
    if (in_tok > 10000) { return TIER_STANDARD; }
    return TIER_ECONOMY;
}

# Does a model's metadata (out from metadata_lookup) satisfy the request?
fn meets_requirements(meta, min_tier, has_vision, uses_tools, has_system, total_tokens) {
    var ctx = load64(meta);
    var tier = load64(meta + 8);
    var vision = load64(meta + 16);
    var tools = load64(meta + 24);
    var sys = load64(meta + 32);
    if (tier < min_tier) { return 0; }
    if (has_vision == 1 && vision == 0) { return 0; }
    if (uses_tools == 1 && tools == 0) { return 0; }
    if (has_system == 1 && sys == 0) { return 0; }
    if (total_tokens > ctx) { return 0; }
    return 1;
}

fn tier_name(tier) {
    if (tier == TIER_REASONING) { return "reasoning"; }
    if (tier == TIER_PREMIUM) { return "premium"; }
    if (tier == TIER_STANDARD) { return "standard"; }
    return "economy";
}
