# metadata.cyr — model capability metadata + complexity classification.
#
# Port of the parts of rust-old/src/provider/metadata.rs + cost/optimizer.rs the
# cost optimizer needs to pick the cheapest *capable* model: per-model tier,
# context window, and vision/tools/system-prompt support, plus
# classify_complexity / meets_requirements. Covers the priced models (the ones
# /v1/cost/recommend can rank); unknown models have no metadata and are skipped.

# Tier ordering doubles as tier_rank (Economy < Standard < Premium < Reasoning).
enum ModelTier {
    TIER_ECONOMY   = 0;
    TIER_STANDARD  = 1;
    TIER_PREMIUM   = 2;
    TIER_REASONING = 3;
}

var _meta_tbl = 0;
var _meta_n = 0;

# Entry: key(0) ctx(8) tier(16) vision(24) tools(32) sys(40) listed(48) — 56 bytes.
#
# `listed` (2.8.0) separates the ids a provider actually serves from the FAMILY PREFIXES this table also needs for
# its longest-prefix match: `claude-opus-4` is how a dated `claude-opus-4-20250514` finds Opus 4.0's row, but it
# is not a model id, and 2.7.1's catalog offered it (and `claude-sonnet-4`) to clients as one. A row with
# listed = 0 still answers lookups; it is never offered by the static catalog.
fn _meta_add(arr, idx, key, ctx, tier, vision, tools, sys, listed) {
    var e = arr + idx * 56;
    store64(e, key);
    store64(e + 8, ctx);
    store64(e + 16, tier);
    store64(e + 24, vision);
    store64(e + 32, tools);
    store64(e + 40, sys);
    store64(e + 48, listed);
    return 0;
}

# Catalog size. Lookup is exact-match then LONGEST-PREFIX, so a general key
# ("llama3") and a specific one ("llama3.1") can coexist — the specific entry
# wins for the models that carry its prefix.
var _META_CAP = 107;

fn _meta_init() {
    if (_meta_tbl != 0) { return 0; }
    var arr = alloc(_META_CAP * 56);
    # Anthropic — 2.8.0, from the Models API itself (GET /v1/models, 2026-10-09: max_input_tokens and the
    # capability tree per model). The 2.7.1 rows were `claude-opus-4`, `claude-sonnet-4`, `claude-3.5-haiku` (never an
    # id), `claude-3-5-haiku`, `claude-3-5-sonnet` and `claude-3-haiku` (all retired). The live catalog
    # (catalog.cyr) is what a gateway lists now; these rows are the fallback when a route cannot be asked, and the
    # tier the cost optimizer ranks by. Mythos is offered to Project Glasswing accounts only, so it is known but not
    # listed; a Glasswing key sees it in the live list.
    _meta_add(arr, 0, "claude-fable-5-1", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 1, "claude-fable-5", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 2, "claude-mythos-5-1", 1000000, TIER_PREMIUM, 1, 1, 1, 0);
    _meta_add(arr, 3, "claude-mythos-5", 1000000, TIER_PREMIUM, 1, 1, 1, 0);
    _meta_add(arr, 4, "claude-opus-5-5", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 5, "claude-opus-5", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 6, "claude-opus-4-8", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 7, "claude-opus-4-7", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 8, "claude-opus-4-6", 1000000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 9, "claude-opus-4-5", 200000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 10, "claude-opus-4-1", 200000, TIER_PREMIUM, 1, 1, 1, 0);
    _meta_add(arr, 11, "claude-opus-4", 200000, TIER_PREMIUM, 1, 1, 1, 0);
    _meta_add(arr, 12, "claude-sonnet-5-5", 1000000, TIER_STANDARD, 1, 1, 1, 1);
    _meta_add(arr, 13, "claude-sonnet-5", 1000000, TIER_STANDARD, 1, 1, 1, 1);
    _meta_add(arr, 14, "claude-sonnet-4-6", 1000000, TIER_STANDARD, 1, 1, 1, 1);
