    # xAI. grok-3 and the grok-4-fast family were retired 2026-05-15 and still resolve (billed at grok-4.3 rates).
    _meta_add(arr, 55, "grok-4.7", 500000, TIER_PREMIUM, 1, 1, 1, 1);
    _meta_add(arr, 56, "grok-4.6", 500000, TIER_PREMIUM, 1, 1, 1, 1);
