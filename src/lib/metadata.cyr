    _meta_add(arr, 98, "qwen2.5-coder", 32768, TIER_ECONOMY, 0, 0, 1, 1);
    # Exact rows for rust-old ids whose family prefix above has another tier.
    _meta_add(arr, 99, "mixtral-8x7b", 32768, TIER_ECONOMY, 0, 0, 1, 0);
    _meta_add(arr, 100, "gemma-2-27b", 8192, TIER_STANDARD, 0, 0, 1, 0);
