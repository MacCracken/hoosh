    _meta_add(arr, 61, "grok-3", 131072, TIER_STANDARD, 0, 1, 1, 0);
    # DeepSeek. deepseek-chat / deepseek-reasoner were discontinued 2026-07-24.
    _meta_add(arr, 62, "deepseek-flash", 1000000, TIER_ECONOMY, 1, 1, 1, 1);
