# handlers.cyr — HTTP endpoint handlers for the hoosh API
# Requires: types.cyr, route.cyr, router.cyr, budget.cyr, cache.cyr,
#           metrics.cyr, auth.cyr, http_server.cyr, http_client.cyr,
#           provider.cyr, hardware.cyr

# Globals shared with main
var _audit_entries = 1;

# GET /v1/health
fn handle_health(cfd) {
    var routes = load64(_router + ROUTER_ROUTES);
    var count = load64(_router + ROUTER_COUNT);
    var healthy = 1;
    if (count > 0) {
        # Serve from the background prober's state instead of connecting here.
        # This endpoint is deliberately exempt from the auth gate and is not
        # rate limited, and the inline socket was a bare blocking connect(2)
        # with no deadline (and a possible DNS resolve), so an unauthenticated
        # caller could park a worker per request. 2.5.5 fixed exactly this in
        # handle_health_providers; handle_health was left behind.
        var r = load64(routes);
        if (route_healthy(r) == 0) { healthy = 0; }
    }
    # 2.7.0: version and providers_configured, as rust-old reported (its
    # conformance tests required both).
    var sb = str_builder_new();
    if (healthy == 1) {
        str_builder_add_cstr(sb, "{\"status\":\"ok\"");
    } else {
        str_builder_add_cstr(sb, "{\"status\":\"degraded\",\"providers_down\":1");
    }
    str_builder_add_cstr(sb, ",\"version\":\"");
    str_builder_add_cstr(sb, HOOSH_VERSION);
    str_builder_add_cstr(sb, "\",\"providers_configured\":");
    str_builder_add_int(sb, count);
    str_builder_add_cstr(sb, "}");
    var body = str_builder_build(sb);
    if (healthy == 1) { return http_json_ok(cfd, body); }
    return http_respond(cfd, "503", "Service Unavailable", to_cstr(body), str_len(body));
}

# ── POST /v1/embeddings (2.7.0) ──
# rust-old routed embeddings like chat: the route that matches the requested
# model (404 when none does), local or remote, and it normalized Ollama's answer
# to the OpenAI envelope. The port sent every request to the first LOCAL route
# whatever the model, and for Ollama it posted the OpenAI body to the legacy
# /api/embeddings, which reads `prompt`, not `input`, and answers in its own
# shape. Now: routed by model; Ollama gets /api/embed with {model, input}, which
# takes a string or an array; other OpenAI-compatible backends, local or remote
# (with their auth), get the body unchanged at /v1/embeddings.

# Span of the raw JSON value of `"<key>"` at the top of an object: a string, an
# array or an object. out: ptr(8) len(8). Returns 1, or 0 when absent/malformed.
fn _json_raw_value(body, len, key, keylen, out) {
    var s = _json_value_pos(body, len, key, keylen);
    if (s < 0 || s >= len) { return 0; }
    var c = load8(body + s);
    var e = 0 - 1;
    if (c == 91 || c == 123) {
        e = _json_span_end(body, len, s);
    } elif (c == 34) {
        var i = s + 1;
        while (i < len) {
            if (load8(body + i) == 34) { break; }
            if (load8(body + i) == 92) { i = i + 1; }
            i = i + 1;
        }
        if (i < len) { e = i + 1; }
    }
    if (e <= s || e > len) { return 0; }
    store64(out, body + s);
    store64(out + 8, e - s);
    return 1;
}

# Ollama's /api/embed answer, {"embeddings":[[...],...],"prompt_eval_count":N},
# as an OpenAI {"object":"list","data":[{"object":"embedding","index":i,...}]}.
# Returns 0 when the answer has no embeddings array.
fn _ollama_embed_to_openai(model, rb, rl) {
    var span = alloc(16);
    if (_json_raw_value(rb, rl, "embeddings", 10, span) == 0) { return 0; }
    var p = load64(span);
    var n = load64(span + 8);
    if (load8(p) != 91) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"object\":\"list\",\"data\":[");
    var idx = 0;
    var i = 1;
    while (i < n) {
        var c = load8(p + i);
        if (c == 91) {
            var e = _json_span_end(p, n, i);
            if (e <= i) { return 0; }
            if (idx > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"object\":\"embedding\",\"index\":");
            str_builder_add_int(sb, idx);
            str_builder_add_cstr(sb, ",\"embedding\":");
            _sb_add_span(sb, p + i, e - i);
            str_builder_add_cstr(sb, "}");
            idx = idx + 1;
            i = e;
        } else {
            i = i + 1;
        }
    }
    var ptok = _json_extract_int(rb, rl, "prompt_eval_count", 17);
    if (ptok < 0) { ptok = 0; }
    str_builder_add_cstr(sb, "],\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"usage\":{\"prompt_tokens\":");
    str_builder_add_int(sb, ptok);
    str_builder_add_cstr(sb, ",\"total_tokens\":");
    str_builder_add_int(sb, ptok);
    str_builder_add_cstr(sb, "}}");
    return str_builder_build(sb);
}

fn handle_embeddings(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var mf = _json_obj_str_field(body_ptr, body_len, "model", 5);
    if (mf == 0 || load64(mf + 8) == 0) { return http_bad_request(cfd, "model field is required"); }
    var model = alloc(load64(mf + 8) + 1);
    memcpy(model, load64(mf), load64(mf + 8));
    store8(model + load64(mf + 8), 0);
    var input = alloc(16);
    if (_json_raw_value(body_ptr, body_len, "input", 5, input) == 0) {
        return http_bad_request(cfd, "input is required (a string or an array of strings)");
    }
    var route = router_select(_router, model);
    if (route == 0) {
        var nsb = str_builder_new();
        str_builder_add_cstr(nsb, "No provider configured for model '");
        _json_escape_into(nsb, model, strlen(model));
        str_builder_add_cstr(nsb, "'");
        return http_error(cfd, "404", "Not Found", to_cstr(str_builder_build(nsb)));
    }
    # Same DLP policy as /v1/chat/completions: RESTRICTED is refused, and
    # CONFIDENTIAL may only go to a local provider.
    if (dlp_is_enabled() == 1) {
        var lvl = dlp_scan_level_json(body_ptr, body_len);
        if (lvl == CLASS_RESTRICTED) {
            hlog_warn("dlp: restricted content blocked (embeddings)");
            return http_error(cfd, "403", "Forbidden", "request blocked: restricted content detected");
        }
        if (lvl == CLASS_CONFIDENTIAL && provider_is_local(route_provider(route)) == 0) {
            var lr = router_select_local(_router, model);
            if (lr == 0) {
                return http_error(cfd, "403", "Forbidden",
                  "request blocked: confidential content requires a local provider");
            }
            route = lr;
        }
    }
    var prov = route_provider(route);
    if (prov == PROV_ANTHROPIC || prov == PROV_GOOGLE) {
        var usb = str_builder_new();
        str_builder_add_cstr(usb, "provider '");
        str_builder_add_cstr(usb, provider_name(prov));
        str_builder_add_cstr(usb, "' does not serve /v1/embeddings");
        return http_bad_request(cfd, to_cstr(str_builder_build(usb)));
    }
    var erl = route_rate_limiter(route);
    if (erl != 0 && hoosh_ratelimit_check(erl) == 0) {
        return http_error(cfd, "429", "Too Many Requests", "rate limit exceeded");
    }
    var base = route_base_url(route);
    var st = 0;
    var rb = 0;
    var rl = 0;
    if (route_is_remote(route) == 1) {
        var sresp = sandhi_http_post_opts(_provider_url(base, "/v1/embeddings"), _provider_headers(route),
          body_ptr, body_len, _remote_http_opts());
        if (sresp != 0 && sandhi_http_err_kind(sresp) == SANDHI_OK) {
            st = sandhi_http_status(sresp);
            rb = sandhi_http_body(sresp);
            rl = sandhi_http_body_len(sresp);
        }
    } else {
        var resp = 0;
        if (prov == PROV_OLLAMA) {
            var osb = str_builder_new();
            str_builder_add_cstr(osb, "{\"model\":\"");
            _json_escape_into(osb, model, strlen(model));
            str_builder_add_cstr(osb, "\",\"input\":");
            _sb_add_span(osb, load64(input), load64(input + 8));
            str_builder_add_cstr(osb, "}");
            var ob = str_builder_build(osb);
            resp = http_post_local(base, "/api/embed", to_cstr(ob), str_len(ob));
        } else {
            resp = http_post_local(base, "/v1/embeddings", body_ptr, body_len);
        }
        if (resp != 0) {
            st = http_status(resp);
            rb = http_body(resp);
            rl = http_body_len(resp);
        }
    }
    if (st >= 200 && st < 300 && rb != 0) {
        metrics_record(0, 0);
        if (prov == PROV_OLLAMA && route_is_remote(route) == 0) {
            var norm = _ollama_embed_to_openai(model, rb, rl);
            if (norm == 0) {
                return http_error(cfd, "502", "Bad Gateway", "embeddings backend returned no embeddings");
            }
            return http_json_ok(cfd, norm);
        }
        return http_ok(cfd, rb, rl);
    }
    if (st != 0 && rb != 0) {
        _provider_err_capture(st, rb, rl);
        hlog_warn(provider_err_log_line());
        return http_error(cfd, "502", "Bad Gateway", provider_err_client_msg());
    }
    hlog_error("embeddings: no backend produced a usable response");
    return http_error(cfd, "502", "Bad Gateway", "embeddings backend unavailable");
}

# ── GET /v1/models (2.7.0) ──
# Concrete model ids, each owned_by the provider that would serve it. This used
# to list one entry per route with the PROVIDER NAME as the id ("ollama"), so an
# OpenAI client's model picker offered models that do not exist. rust-old asked
# each provider for its models. Local backends are asked live (Ollama's
# /api/tags, everyone else's /v1/models); remote routes, and a local one that
# does not answer, list the catalogue models and literal patterns they match, so
# /v1/models makes no remote call. Only ids a route actually matches are listed.

# Append one {"id","object":"model","owned_by"} entry unless `id` is already in
# `seen`. id[0..len) need not be NUL-terminated.
fn _models_emit(sb, seen, id, len, owner) {
    var n = vec_len(seen);
    var i = 0;
    while (i < n) {
        var s = vec_get(seen, i);
        if (strlen(s) == len && memeq(s, id, len) == 1) { return 0; }
        i = i + 1;
    }
    var c = alloc(len + 1);
    memcpy(c, id, len);
    store8(c + len, 0);
    vec_push(seen, c);
    if (n > 0) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "{\"id\":\"");
    _json_escape_into(sb, c, len);
    str_builder_add_cstr(sb, "\",\"object\":\"model\",\"owned_by\":\"");
    str_builder_add_cstr(sb, owner);
    str_builder_add_cstr(sb, "\"}");
    return 1;
}

# Every string value of `"<key>"` in a model listing that route `r` matches.
# Returns how many ids the listing held (matched or not), so 0 means "no answer".
fn _models_scan(sb, seen, r, body, len, key, keylen) {
    var found = 0;
    var pos = 0;
    while (pos < len) {
        var p = _json_value_pos(body + pos, len - pos, key, keylen);
        if (p < 0) { break; }
        var s = pos + p;
        if (load8(body + s) != 34) { pos = s + 1; continue; }
        var e = s + 1;
        while (e < len && load8(body + e) != 34) {
            if (load8(body + e) == 92) { e = e + 1; }
            e = e + 1;
        }
        if (e >= len) { break; }
        found = found + 1;
        var id = alloc(e - s);
        memcpy(id, body + s + 1, e - s - 1);
        store8(id + e - s - 1, 0);
        if (route_matches_model(r, id) == 1) {
            _models_emit(sb, seen, id, e - s - 1, provider_name(route_provider(r)));
        }
        pos = e + 1;
    }
    return found;
}

# A local backend's own model list. Returns 0 when it did not answer.
fn _models_live_local(sb, seen, r) {
    if (route_healthy(r) == 0) { return 0; }
    var path = "/v1/models";
    var key = "id";
    if (route_provider(r) == PROV_OLLAMA) { path = "/api/tags"; key = "name"; }
    var resp = http_req_local("GET", route_base_url(r), path, 0, 0);
    if (resp == 0) { return 0; }
    if (http_status(resp) < 200 || http_status(resp) >= 300) { return 0; }
    return _models_scan(sb, seen, r, http_body(resp), http_body_len(resp), key, strlen(key));
}

# Catalogue models that route `r` would serve, plus its literal (wildcard-free)
# patterns.
fn _models_from_catalog(sb, seen, r) {
    var owner = provider_name(route_provider(r));
    var n = metadata_count();
    var i = 0;
    while (i < n) {
        var k = metadata_key(i);
        if (route_matches_model(r, k) == 1) { _models_emit(sb, seen, k, strlen(k), owner); }
        i = i + 1;
    }
    var pats = load64(r + ROUTE_PATTERNS);
    var pn = load64(r + ROUTE_PATTERNS_N);
    var j = 0;
    while (j < pn) {
        var pat = load64(pats + j * 8);
        var literal = 1;
        var q = 0;
        while (load8(pat + q) != 0) {
            if (load8(pat + q) == 42 || load8(pat + q) == 63) { literal = 0; }
            q = q + 1;
        }
        if (literal == 1 && q > 0) { _models_emit(sb, seen, pat, q, owner); }
        j = j + 1;
    }
    return 0;
}

fn handle_models(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"object\":\"list\",\"data\":[");
    var seen = vec_new();
    var routes = load64(_router + ROUTER_ROUTES);
    var count = load64(_router + ROUTER_COUNT);
    var i = 0;
    while (i < count) {
        var r = load64(routes + i * 8);
        if (route_enabled(r) == 1) {
            var got = 0;
            if (route_is_remote(r) == 0) { got = _models_live_local(sb, seen, r); }
            if (got == 0) { _models_from_catalog(sb, seen, r); }
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# Provider of the first ENABLED route whose patterns match `model`, or -1 if no
# configured route can serve it. The pricing catalog (metadata.cyr) is global, but
# the catalog endpoint must only advertise models THIS gateway can actually route.
fn _catalog_provider_for(model) {
    var routes = load64(_router + ROUTER_ROUTES);
    var count = load64(_router + ROUTER_COUNT);
    var i = 0;
    while (i < count) {
        var r = load64(routes + i * 8);
        if (route_enabled(r) == 1) {
            if (route_matches_model(r, model) == 1) { return route_provider(r); }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# GET /v1/models/catalog — concrete, switchable model ids (not provider names, and
# not glob patterns) from the pricing catalog, each tagged with the provider that
# would route it as `owned_by`. Only models an ENABLED route actually matches are
# listed, so the catalog reflects what THIS gateway can serve. Shape mirrors
# /v1/models so the same client parser works:
#   {"object":"list","data":[{"id":"claude-sonnet-4","object":"model","owned_by":"anthropic"},...]}
# Clients drill down per provider by filtering on owned_by.
fn handle_models_catalog(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"object\":\"list\",\"data\":[");
    var n = metadata_count();
    var first = 1;
    var i = 0;
    while (i < n) {
        var key = metadata_key(i);
        var prov = _catalog_provider_for(key);
        if (prov != (0 - 1)) {
            if (first == 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"id\":\"");
            str_builder_add_cstr(sb, key);
            str_builder_add_cstr(sb, "\",\"object\":\"model\",\"owned_by\":\"");
            str_builder_add_cstr(sb, provider_name(prov));
            str_builder_add_cstr(sb, "\"}");
            first = 0;
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# Find the first enabled route for a provider type, or 0 if none.
fn _router_find_provider(prov) {
    var routes = load64(_router + ROUTER_ROUTES);
    var count = load64(_router + ROUTER_COUNT);
    var i = 0;
    while (i < count) {
        var r = load64(routes + i * 8);
        if (route_enabled(r) == 1) {
            if (route_provider(r) == prov) { return r; }
        }
        i = i + 1;
    }
    return 0;
}

# GET /api/tags — native Ollama-compatible model listing.
# Emits each enabled route's model patterns in Ollama's tags shape so Ollama
# clients pointed at the gateway can enumerate available models.
fn handle_ollama_tags(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"models\":[");
    var routes = load64(_router + ROUTER_ROUTES);
    var count = load64(_router + ROUTER_COUNT);
    var first = 1;
    var i = 0;
    while (i < count) {
        var r = load64(routes + i * 8);
        if (route_enabled(r) == 1) {
            var pats = load64(r + ROUTE_PATTERNS);
            var pn = load64(r + ROUTE_PATTERNS_N);
            var j = 0;
            while (j < pn) {
                var pat = load64(pats + j * 8);
                if (strlen(pat) > 0) {
                    if (first == 0) { str_builder_add_cstr(sb, ","); }
                    str_builder_add_cstr(sb, "{\"name\":\"");
                    str_builder_add_cstr(sb, pat);
                    str_builder_add_cstr(sb, "\",\"model\":\"");
                    str_builder_add_cstr(sb, pat);
                    str_builder_add_cstr(sb,
                      "\",\"modified_at\":\"\",\"size\":0,\"digest\":\"\",");
                    str_builder_add_cstr(sb, "\"details\":{\"family\":\"");
                    str_builder_add_cstr(sb, provider_name(route_provider(r)));
                    str_builder_add_cstr(sb, "\"}}");
                    first = 0;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# Build a {"name":"<model>"} body cstr for Ollama pull/delete. Returns a
# 16-byte (ptr,len) struct.
fn _build_name_body(model_cstr) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"");
    str_builder_add_cstr(sb, model_cstr);
    str_builder_add_cstr(sb, "\"}");
    var s = str_builder_build(sb);
    var r = alloc(16);
    store64(r, to_cstr(s));
    store64(r + 8, str_len(s));
    return r;
}

# Forward a provider lifecycle response (or a gateway error) to the client.
fn _lifecycle_reply(cfd, resp, what) {
    if (resp == 0) {
        hlog_error("lifecycle: backend unreachable");
        return http_error(cfd, "502", "Bad Gateway", what);
    }
    if (http_status(resp) >= 200) {
        if (http_status(resp) < 300) {
            return http_ok(cfd, http_body(resp), http_body_len(resp));
        }
    }
    hlog_warn("lifecycle: backend returned error status");
    return http_error(cfd, "502", "Bad Gateway", what);
}

# POST /v1/models/pull {"model":"..."} — Ollama pull_model.
fn handle_model_pull(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty request body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var model = json_get(pairs, str_from("model"));
    if (model == 0) { return http_bad_request(cfd, "missing model"); }
    var model_cstr = to_cstr(model);
    if (strlen(model_cstr) == 0) { return http_bad_request(cfd, "empty model"); }
    var route = _router_find_provider(PROV_OLLAMA);
    if (route == 0) {
        return http_error(cfd, "404", "Not Found", "no ollama provider configured");
    }
    var fb = _build_name_body(model_cstr);
    var resp = http_req_local("POST", route_base_url(route), "/api/pull",
      load64(fb), load64(fb + 8));
    return _lifecycle_reply(cfd, resp, "ollama pull failed");
}

# POST /v1/models/delete {"model":"..."} — Ollama delete_model.
fn handle_model_delete(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty request body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var model = json_get(pairs, str_from("model"));
    if (model == 0) { return http_bad_request(cfd, "missing model"); }
    var model_cstr = to_cstr(model);
    if (strlen(model_cstr) == 0) { return http_bad_request(cfd, "empty model"); }
    var route = _router_find_provider(PROV_OLLAMA);
    if (route == 0) {
        return http_error(cfd, "404", "Not Found", "no ollama provider configured");
    }
    var fb = _build_name_body(model_cstr);
    var resp = http_req_local("DELETE", route_base_url(route), "/api/delete",
      load64(fb), load64(fb + 8));
    return _lifecycle_reply(cfd, resp, "ollama delete failed");
}

# POST /v1/training/status {"job_id":"..."} — Synapse training_status.
fn handle_synapse_training(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty request body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var job = json_get(pairs, str_from("job_id"));
    if (job == 0) { return http_bad_request(cfd, "missing job_id"); }
    var job_cstr = to_cstr(job);
    var job_n = strlen(job_cstr);
    if (job_n == 0) { return http_bad_request(cfd, "empty job_id"); }
    # job_id is concatenated into an outbound request path. Bounding the length
    # and the alphabet in one check closes the fixed-header overflow, CRLF
    # injection into the request line, and path traversal via / ? # .. — the
    # only prior validation was "not empty", against a 1 MiB body limit.
    if (job_n > 128) { return http_bad_request(cfd, "job_id too long"); }
    var jci = 0;
    while (jci < job_n) {
        var jc = load8(job_cstr + jci);
        var ok_ch = 0;
        if (jc >= 48 && jc <= 57) { ok_ch = 1; }
        if (jc >= 65 && jc <= 90) { ok_ch = 1; }
        if (jc >= 97 && jc <= 122) { ok_ch = 1; }
        if (jc == 45 || jc == 46 || jc == 95) { ok_ch = 1; }
        if (ok_ch == 0) { return http_bad_request(cfd, "invalid job_id"); }
        jci = jci + 1;
    }
    var route = _router_find_provider(PROV_SYNAPSE);
    if (route == 0) {
        return http_error(cfd, "404", "Not Found", "no synapse provider configured");
    }
    var psb = str_builder_new();
    str_builder_add_cstr(psb, "/v1/training/");
    str_builder_add_cstr(psb, job_cstr);
    var path = to_cstr(str_builder_build(psb));
    var resp = http_req_local("GET", route_base_url(route), path, 0, 0);
    return _lifecycle_reply(cfd, resp, "synapse training status failed");
}

# POST /v1/catalog/sync — Synapse sync_catalog.
fn handle_synapse_sync(cfd) {
    var route = _router_find_provider(PROV_SYNAPSE);
    if (route == 0) {
        return http_error(cfd, "404", "Not Found", "no synapse provider configured");
    }
    var resp = http_req_local("POST", route_base_url(route), "/v1/catalog/sync", 0, 0);
    return _lifecycle_reply(cfd, resp, "synapse catalog sync failed");
}

# ── Cache warming ──
# Pre-populate the response cache at startup with operator-configured prompts so
# common requests are instant before traffic arrives. The single-threaded
# runtime has no background task, so this runs synchronously at startup. Each
# entry is a 16-byte (model_cstr, prompt_cstr).

fn warming_add(model, prompt) {
    if (_warming == 0) { _warming = vec_new(); }
    var e = alloc(16);
    store64(e, model);
    store64(e + 8, prompt);
    vec_push(_warming, e);
    return 0;
}

# Canonical compact body a client must POST to hit a warmed entry:
# {"model":"M","messages":[{"role":"user","content":"P"}]}
fn _warming_body(model, prompt) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"messages\":[{\"role\":\"user\",\"content\":\"");
    str_builder_add_cstr(sb, prompt);
    str_builder_add_cstr(sb, "\"}]}");
    return str_builder_build(sb);
}

# Warm the cache from configured prompts. Returns the count warmed. Skips when
# the cache is disabled, the model has no route, or the key is already cached.
fn warming_run() {
    if (_warming == 0) { return 0; }
    if (_cache == 0) { return 0; }
    if (load64(_cache + CACHE_ENABLED) == 0) { return 0; }
    var n = vec_len(_warming);
    if (n == 0) { return 0; }
    var warmed = 0;
    var i = 0;
    while (i < n) {
        var e = vec_get(_warming, i);
        var model = load64(e);
        var prompt = load64(e + 8);
        var route = router_select(_router, model);
        if (route != 0) {
            var body = _warming_body(model, prompt);
            var key = _cache_key(model, to_cstr(body), str_len(body));
            if (cache_get(_cache, key) == 0) {
                var result = retry_forward(_retry_cfg, route, model, prompt, 0, 0, 0, 0, 0);
                if (result != 0) {
                    # 2.5.12: price the warmed entry too, so a hit on it is
                    # indistinguishable from a hit on a normally-served one.
                    var wprov = route_provider(route);
                    var wptok = load64(result + 16);
                    var wctok = load64(result + 24);
                    var env = _chat_completion_body(model, load64(result), wptok, wctok, 0,
                      estimate_cost_micro(model, wprov, wptok, wctok), provider_name(wprov));
                    cache_insert(_cache, key, to_cstr(env));
                    warmed = warmed + 1;
                }
            }
        }
        i = i + 1;
    }
    var lsb = str_builder_new();
    str_builder_add_cstr(lsb, "cache warming: ");
    str_builder_add_int(lsb, warmed);
    str_builder_add_cstr(lsb, "/");
    str_builder_add_int(lsb, n);
    str_builder_add_cstr(lsb, " entries cached");
    hlog_info(to_cstr(str_builder_build(lsb)));
    return warmed;
}

# GET /v1/cache/stats
fn handle_cache_stats(cfd) {
    # _chat_lock: map_count over the entries map races the chat path's
    # cache_insert/evict (map_set/map_delete → rehash) on the pool workers
    # (v2.4.0). Snapshot the four values under the lock, then build unlocked.
    mutex_lock(_chat_lock);
    # 2.5.4: sweep expired entries before reporting, so `entries` reflects what
    # is actually servable rather than counting corpses the TTL has already
    # retired. Bounded by the map size and this path is not hot.
    cache_evict_expired(_cache);
    var entries = map_count(load64(_cache + CACHE_ENTRIES));
    var hits = load64(_cache + CACHE_HITS);
    var misses = load64(_cache + CACHE_MISSES);
    var evictions = load64(_cache + CACHE_EVICTIONS);
    var max_entries = cache_max_entries(_cache);
    var enabled = cache_enabled(_cache);
    var ttl_ms = cache_ttl_ms(_cache);
    mutex_unlock(_chat_lock);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"entries\":");
    str_builder_add_int(sb, entries);
    str_builder_add_cstr(sb, ",\"max_entries\":");
    str_builder_add_int(sb, max_entries);
    str_builder_add_cstr(sb, ",\"hits\":");
    str_builder_add_int(sb, hits);
    str_builder_add_cstr(sb, ",\"misses\":");
    str_builder_add_int(sb, misses);
    str_builder_add_cstr(sb, ",\"evictions\":");
    str_builder_add_int(sb, evictions);
    # hit_rate as a 0..1 fraction, x1000-scaled internally then rendered — the
    # same no-floats trick the sampling params use.
    str_builder_add_cstr(sb, ",\"hit_rate\":");
    var total = hits + misses;
    var rate = 0;
    if (total > 0) { rate = hits * 1000 / total; }
    _sb_add_milli(sb, rate);
    str_builder_add_cstr(sb, ",\"ttl_secs\":");
    str_builder_add_int(sb, ttl_ms / 1000);
    str_builder_add_cstr(sb, ",\"enabled\":");
    if (enabled == 1) {
        str_builder_add_cstr(sb, "true");
    } else {
        str_builder_add_cstr(sb, "false");
    }
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/tokens/pools
fn handle_token_pools(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"pools\":[");
    # _chat_lock: map_keys/map_get over _budget races a concurrent reload's
    # budget_add_pool (map_set → rehash) and pool-field writes from chat/token
    # reserve/commit on the pool workers (v2.4.0). Hold it for the snapshot.
    mutex_lock(_chat_lock);
    var keys = map_keys(_budget);
    var first = 1;
    var i = 0;
    while (i < vec_len(keys)) {
        var name = vec_get(keys, i);
        var p = map_get(_budget, name);
        if (first == 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"name\":\"");
        str_builder_add_cstr(sb, name);
        str_builder_add_cstr(sb, "\",\"capacity\":");
        str_builder_add_int(sb, load64(p + POOL_CAPACITY));
        str_builder_add_cstr(sb, ",\"used\":");
        str_builder_add_int(sb, load64(p + POOL_USED));
        str_builder_add_cstr(sb, ",\"available\":");
        str_builder_add_int(sb, pool_available(p));
        str_builder_add_cstr(sb, "}");
        first = 0;
        i = i + 1;
    }
    mutex_unlock(_chat_lock);
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/costs
#
# 2.5.6: `records` carries ACCUMULATED per-provider spend (rust-old's
# ProviderCostRecord, cost/mod.rs:116-127). It replaces the old `providers`
# array, which listed the configured routes with no cost attached — the endpoint
# could report how many tokens hoosh had processed in total, but not what any
# one provider had cost. Records are keyed by (provider, base_url) and survive
# an /v1/admin/reload.
fn handle_costs(cfd) {
    # _chat_lock: the record vec is appended to by _chat_assemble on the pool
    # workers, so snapshot under the lock rather than iterating a vec that can
    # grow (and reallocate) mid-read.
    mutex_lock(_chat_lock);
    var n = cost_record_count();
    var total_micro = cost_total_micro();
    var snap = alloc(n * 8 + 8);
    var si = 0;
    while (si < n) {
        store64(snap + si * 8, cost_record_at(si));
        si = si + 1;
    }
    mutex_unlock(_chat_lock);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"total_requests\":");
    str_builder_add_int(sb, _met_requests);
    str_builder_add_cstr(sb, ",\"total_prompt_tokens\":");
    str_builder_add_int(sb, _met_prompt_tokens);
    str_builder_add_cstr(sb, ",\"total_completion_tokens\":");
    str_builder_add_int(sb, _met_comp_tokens);
    str_builder_add_cstr(sb, ",\"total_cost_micro_usd\":");
    str_builder_add_int(sb, total_micro);
    str_builder_add_cstr(sb, ",\"total_cost_usd\":\"");
    pricing_append_usd(sb, total_micro);
    str_builder_add_cstr(sb, "\",\"records\":[");
    var first = 1;
    var ci = 0;
    while (ci < n) {
        var rec = load64(snap + ci * 8);
        var prov = load64(rec);
        if (first == 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"provider\":\"");
        str_builder_add_cstr(sb, provider_name(prov));
        str_builder_add_cstr(sb, "\",\"base_url\":\"");
        str_builder_add_cstr(sb, load64(rec + 8));
        str_builder_add_cstr(sb, "\",\"is_local\":");
        if (provider_is_local(prov) == 1) {
            str_builder_add_cstr(sb, "true");
        } else {
            str_builder_add_cstr(sb, "false");
        }
        str_builder_add_cstr(sb, ",\"total_input_tokens\":");
        str_builder_add_int(sb, load64(rec + 16));
        str_builder_add_cstr(sb, ",\"total_output_tokens\":");
        str_builder_add_int(sb, load64(rec + 24));
        str_builder_add_cstr(sb, ",\"request_count\":");
        str_builder_add_int(sb, load64(rec + 40));
        str_builder_add_cstr(sb, ",\"total_cost_micro_usd\":");
        str_builder_add_int(sb, load64(rec + 32));
        str_builder_add_cstr(sb, ",\"total_cost_usd\":\"");
        pricing_append_usd(sb, load64(rec + 32));
        str_builder_add_cstr(sb, "\"}");
        first = 0;
        ci = ci + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# POST /v1/cost/estimate {model, input_tokens, output_tokens} — per-token cost.
fn handle_cost_estimate(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty request body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var model = json_get(pairs, str_from("model"));
    if (model == 0) { return http_bad_request(cfd, "missing model"); }
    var model_cstr = to_cstr(model);
    var in_tok = 0;
    var it = json_get(pairs, str_from("input_tokens"));
    if (it != 0) { in_tok = str_to_int(it); }
    var out_tok = 0;
    var ot = json_get(pairs, str_from("output_tokens"));
    if (ot != 0) { out_tok = str_to_int(ot); }
    # Provider of the route that serves this model (drives fallback pricing).
    var prov = PROV_OPENAI;
    var route = router_select(_router, model_cstr);
    if (route != 0) { prov = route_provider(route); }
    var micro = estimate_cost_micro(model_cstr, prov, in_tok, out_tok);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model\":\"");
    str_builder_add_cstr(sb, model_cstr);
    str_builder_add_cstr(sb, "\",\"input_tokens\":");
    str_builder_add_int(sb, in_tok);
    str_builder_add_cstr(sb, ",\"output_tokens\":");
    str_builder_add_int(sb, out_tok);
    str_builder_add_cstr(sb, ",\"estimated_cost_micro_usd\":");
    str_builder_add_int(sb, micro);
    str_builder_add_cstr(sb, ",\"estimated_cost_usd\":\"");
    pricing_append_usd(sb, micro);
    str_builder_add_cstr(sb, "\"}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# Parse a JSON boolean field (true → 1, absent/false → 0).
fn _req_bool(pairs, key) {
    var v = json_get(pairs, str_from(key));
    if (v == 0) { return 0; }
    if (str_eq_cstr(v, "true") == 1) { return 1; }
    return 0;
}

# POST /v1/cost/recommend — cheapest *capable* model for a request profile.
# Body: {input_tokens, max_output_tokens, uses_tools, has_vision,
# has_system_prompt}. Classifies the request's minimum tier, then among the
# configured exact (non-wildcard) model routes keeps only those whose metadata
# satisfies tier/modality/tool/system/context requirements, and returns the
# cheapest by estimated cost. Models without metadata (or wildcard-only routes)
# are skipped. Mirrors CostOptimizer::recommend.
fn handle_cost_recommend(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty request body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var in_tok = 0;
    var it = json_get(pairs, str_from("input_tokens"));
    if (it != 0) { in_tok = str_to_int(it); }
    var out_tok = 0;
    var ot = json_get(pairs, str_from("max_output_tokens"));
    if (ot != 0) { out_tok = str_to_int(ot); }
    var uses_tools = _req_bool(pairs, "uses_tools");
    var has_vision = _req_bool(pairs, "has_vision");
    var has_system = _req_bool(pairs, "has_system_prompt");
    var min_tier = classify_complexity(in_tok, uses_tools, has_vision);
    var total_tokens = in_tok + out_tok;

    var routes = load64(_router + ROUTER_ROUTES);
    var count = load64(_router + ROUTER_COUNT);
    var best_model = 0;
    var best_prov = 0;
    var best_tier = 0;
    var best_cost = 0x7FFFFFFFFFFFFFFF;
    var meta = alloc(40);
    var i = 0;
    while (i < count) {
        var r = load64(routes + i * 8);
        if (route_enabled(r) == 1) {
            var pats = load64(r + ROUTE_PATTERNS);
            var pn = load64(r + ROUTE_PATTERNS_N);
            var j = 0;
            while (j < pn) {
                var pat = load64(pats + j * 8);
                var pl = strlen(pat);
                if (pl > 0 && load8(pat + pl - 1) != 42) {
                    if (metadata_lookup(pat, meta) == 1) {
                        if (meets_requirements(meta, min_tier, has_vision,
                            uses_tools, has_system, total_tokens) == 1) {
                            var c = estimate_cost_micro(pat, route_provider(r),
                              in_tok, out_tok);
                            if (c < best_cost) {
                                best_cost = c;
                                best_model = pat;
                                best_prov = route_provider(r);
                                best_tier = load64(meta + 8);
                            }
                        }
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    if (best_model == 0) {
        return http_error(cfd, "404", "Not Found",
          "no capable exact-model route for this request profile");
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model\":\"");
    str_builder_add_cstr(sb, best_model);
    str_builder_add_cstr(sb, "\",\"provider\":\"");
    str_builder_add_cstr(sb, provider_name(best_prov));
    str_builder_add_cstr(sb, "\",\"tier\":\"");
    str_builder_add_cstr(sb, tier_name(best_tier));
    str_builder_add_cstr(sb, "\",\"required_tier\":\"");
    str_builder_add_cstr(sb, tier_name(min_tier));
    str_builder_add_cstr(sb, "\",\"estimated_cost_micro_usd\":");
    str_builder_add_int(sb, best_cost);
    str_builder_add_cstr(sb, ",\"estimated_cost_usd\":\"");
    pricing_append_usd(sb, best_cost);
    str_builder_add_cstr(sb, "\"}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/health/providers
#
# 2.5.5: reports the state the background prober maintains instead of running N
# blocking TCP connects inline. The old version probed on every poll, so a
# monitoring system scraping this endpoint tied up a pool worker for as long as
# the slowest backend took to answer — and the result was thrown away, since
# nothing but this handler ever read it. Disabled routes are listed too, with
# status "disabled" (rust-old's ProviderHealth.enabled).
fn handle_health_providers(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"providers\":[");
    var routes = load64(_router + ROUTER_ROUTES);
    var rcount = load64(_router + ROUTER_COUNT);
    var first = 1;
    var hi = 0;
    while (hi < rcount) {
        var r = load64(routes + hi * 8);
        var h = route_health(r);
        if (first == 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"provider\":\"");
        str_builder_add_cstr(sb, provider_name(route_provider(r)));
        str_builder_add_cstr(sb, "\",\"base_url\":\"");
        str_builder_add_cstr(sb, route_base_url(r));
        str_builder_add_cstr(sb, "\",\"status\":\"");
        str_builder_add_cstr(sb, health_status_str(r));
        str_builder_add_cstr(sb, "\",\"enabled\":");
        if (route_enabled(r) == 1) {
            str_builder_add_cstr(sb, "true");
        } else {
            str_builder_add_cstr(sb, "false");
        }
        str_builder_add_cstr(sb, ",\"healthy\":");
        if (route_healthy(r) == 1) {
            str_builder_add_cstr(sb, "true");
        } else {
            str_builder_add_cstr(sb, "false");
        }
        str_builder_add_cstr(sb, ",\"consecutive_failures\":");
        if (h != 0) {
            str_builder_add_int(sb, load64(h + HEALTH_FAILS));
        } else {
            str_builder_add_int(sb, 0);
        }
        str_builder_add_cstr(sb, ",\"last_check_ms\":");
        if (h != 0) {
            str_builder_add_int(sb, load64(h + HEALTH_CHECKED));
        } else {
            str_builder_add_int(sb, 0);
        }
        str_builder_add_cstr(sb, "}");
        first = 0;
        hi = hi + 1;
    }
    str_builder_add_cstr(sb, "],\"check_interval_secs\":");
    str_builder_add_int(sb, health_interval());
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# POST /v1/tokens/check
fn handle_tokens_check(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var pool_name = json_get(pairs, str_from("pool"));
    var tokens_str = json_get(pairs, str_from("tokens"));
    if (pool_name == 0) { return http_bad_request(cfd, "missing 'pool'"); }
    var pname = to_cstr(pool_name);
    var tokens = 0;
    if (tokens_str != 0) { tokens = str_to_int(tokens_str); }
    # _chat_lock guards the shared budget — concurrent with chat reserve/commit
    # and other token handlers on the pool workers (v2.4.0).
    mutex_lock(_chat_lock);
    var p = budget_get_pool(_budget, pname);
    var avail = 0;
    if (p != 0) { avail = pool_available(p); }
    mutex_unlock(_chat_lock);
    if (p == 0) { return http_error(cfd, "404", "Not Found", "token pool not found"); }
    var allowed = 0;
    if (avail >= tokens) { allowed = 1; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"allowed\":");
    if (allowed == 1) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    str_builder_add_cstr(sb, ",\"available\":");
    str_builder_add_int(sb, avail);
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# POST /v1/tokens/reserve
fn handle_tokens_reserve(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var pool_name = json_get(pairs, str_from("pool"));
    var tokens_str = json_get(pairs, str_from("tokens"));
    if (pool_name == 0) { return http_bad_request(cfd, "missing 'pool'"); }
    var pname = to_cstr(pool_name);
    var tokens = 0;
    if (tokens_str != 0) { tokens = str_to_int(tokens_str); }
    mutex_lock(_chat_lock);
    var reserved = budget_reserve(_budget, pname, tokens);
    var p = budget_get_pool(_budget, pname);
    var avail = 0;
    if (p != 0) { avail = pool_available(p); }
    mutex_unlock(_chat_lock);
    if (p == 0) { return http_error(cfd, "404", "Not Found", "token pool not found"); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"reserved\":");
    if (reserved == 1) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    str_builder_add_cstr(sb, ",\"available\":");
    str_builder_add_int(sb, avail);
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# POST /v1/tokens/report
fn handle_tokens_report(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var pool_name = json_get(pairs, str_from("pool"));
    var reserved_str = json_get(pairs, str_from("reserved"));
    var actual_str = json_get(pairs, str_from("actual"));
    if (pool_name == 0) { return http_bad_request(cfd, "missing 'pool'"); }
    var pname = to_cstr(pool_name);
    var reserved = 0;
    var actual = 0;
    if (reserved_str != 0) { reserved = str_to_int(reserved_str); }
    if (actual_str != 0) { actual = str_to_int(actual_str); }
    mutex_lock(_chat_lock);
    var p = budget_get_pool(_budget, pname);
    var used = 0;
    var avail = 0;
    if (p != 0) {
        pool_commit(p, reserved, actual);
        used = load64(p + POOL_USED);
        avail = pool_available(p);
    }
    mutex_unlock(_chat_lock);
    if (p == 0) { return http_error(cfd, "404", "Not Found", "token pool not found"); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"used\":");
    str_builder_add_int(sb, used);
    str_builder_add_cstr(sb, ",\"available\":");
    str_builder_add_int(sb, avail);
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/audit
fn handle_audit(cfd) {
    if (_audit_chain == 0) {
        return http_error(cfd, "404", "Not Found",
          "audit logging not enabled");
    }
    var sb = str_builder_new();
    audit_json(_audit_chain, sb, 50);
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/health/heartbeat
fn handle_heartbeat(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"nodes\":[");
    var routes = load64(_router + ROUTER_ROUTES);
    var rcount = load64(_router + ROUTER_COUNT);
    var first = 1;
    var hi = 0;
    while (hi < rcount) {
        var r = load64(routes + hi * 8);
        if (route_enabled(r) == 1) {
            if (first == 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"id\":\"");
            str_builder_add_cstr(sb, provider_name(route_provider(r)));
            str_builder_add_cstr(sb, ":");
            str_builder_add_cstr(sb, route_base_url(r));
            str_builder_add_cstr(sb, "\",\"status\":\"online\"}");
            first = 0;
        }
        hi = hi + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/queue/status
fn handle_queue_status(cfd) {
    var body = "{\"pending\":0,\"processing\":0}";
    return http_ok(cfd, body, strlen(body));
}

# GET /v1/hardware
fn handle_hardware(cfd) {
    var sb = str_builder_new();
    hw_summary_json(sb);
    return http_json_ok(cfd, str_builder_build(sb));
}

# ── Whole-number inputs for the hardware planners (2.6.13) ──
# str_to_int skips every byte that is not a digit and wraps on overflow: "7e9" is
# 79, "7000000000.0" is 70000000000 and "18446744073709551617" is 1. The planners
# multiply what they are given, so a wrapped or huge model_params came back as a
# negative memory requirement with "fits": true.

fn _hw_blank(c) {
    if (c == 32 || c == 9 || c == 13 || c == 10) { return 1; }
    return 0;
}

# A byte that can be part of a JSON number: a digit, a point, an exponent or a sign.
fn _hw_num_byte(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 46 || c == 101 || c == 69 || c == 43 || c == 45) { return 1; }
    return 0;
}

# p[0..len) as a whole number no larger than `cap`. Returns the value, -1 when the
# text is not a whole number (empty, a sign, an exponent, a fraction other than
# zeros, any other byte), or -2 when it is larger than `cap`. The cap is checked
# before each multiply, so the accumulator never wraps. A zero fraction is the same
# whole number: Python's json.dumps writes 7e9 as 7000000000.0.
fn _hw_whole_bounded(p, len, cap) {
    var v = 0;
    var i = 0;
    while (i < len) {
        var d = (load8(p + i) & 0xFF) - 48;
        if (d < 0 || d > 9) { break; }
        if (v > (cap - d) / 10) { return 0 - 2; }
        v = v * 10 + d;
        i = i + 1;
    }
    if (i == 0) { return 0 - 1; }
    if (i < len && load8(p + i) == 46) {
        i = i + 1;
        if (i == len) { return 0 - 1; }
        while (i < len && load8(p + i) == 48) { i = i + 1; }
    }
    if (i < len) { return 0 - 1; }
    return v;
}

# A json_get value (a Str, or 0 when the key is absent) as a whole number in
# [0, cap] by the rules above. Absent, empty and null read as 0, "not given", which
# is what str_to_int made of them. Blanks around the value are trimmed: the flat
# parser ends a bare value at a space or LF, so a trailing CR or tab stays in it.
fn _hw_json_whole(s, cap) {
    if (s == 0) { return 0; }
    var p = str_data(s);
    var len = str_len(s);
    while (len > 0 && _hw_blank(load8(p)) == 1) { p = p + 1; len = len - 1; }
    while (len > 0 && _hw_blank(load8(p + len - 1)) == 1) { len = len - 1; }
    if (len == 0) { return 0; }
    if (len == 4 && memeq(p, "null", 4) == 1) { return 0; }
    return _hw_whole_bounded(p, len, cap);
}

# 400 "<field> out of range (max <cap>)", worded from the cap so the two agree.
fn _hw_out_of_range(cfd, field, cap) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, field);
    str_builder_add_cstr(sb, " out of range (max ");
    str_builder_add_int(sb, cap);
    str_builder_add_cstr(sb, ")");
    return http_bad_request(cfd, to_cstr(str_builder_build(sb)));
}

# POST /v1/hardware/placement
# POST /v1/hardware/simulate (2.5.9)
# {model_params, quantization?, remove_count?, add_devices:[{memory_bytes}]}
# rust-old handlers.rs:1099-1183. Validation mirrors it: model_params must be
# positive, at most 64 added devices, and every added device needs a non-zero
# size — a 0-byte device would otherwise silently contribute nothing and make
# the simulation quietly wrong rather than obviously rejected.
fn handle_hw_simulate(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }

    var mp = _hw_json_whole(json_get(pairs, str_from("model_params")), HW_MAX_MODEL_PARAMS);
    if (mp == 0 - 2) { return _hw_out_of_range(cfd, "model_params", HW_MAX_MODEL_PARAMS); }
    if (mp == 0 - 1) { return http_bad_request(cfd, "model_params must be a positive whole number"); }
    if (mp == 0) {
        return http_bad_request(cfd, "model_params must be greater than 0");
    }

    var quant = 0;
    var q_str = json_get(pairs, str_from("quantization"));
    if (q_str != 0) { quant = quant_from_str(to_cstr(q_str)); }
    if (quant == 0) { quant = hw_suggest_quant(mp); }

    var rm = 0;
    var rm_str = json_get(pairs, str_from("remove_count"));
    if (rm_str != 0) { rm = str_to_int(rm_str); }
    if (rm < 0) { return http_bad_request(cfd, "remove_count must not be negative"); }

    # add_devices is a raw array scan: json_parse is flat and cannot reach into
    # the nested objects (same constraint the sampling params hit in 2.5.2).
    # 2.6.13: each size is the whole number token after the key, bounded by
    # SIM_MAX_DEVICE_BYTES. The old digit loop had no bound, so 18446744073709551615
    # wrapped to a -1 byte card, and sizes that fit in i64 still wrapped the totals
    # once summed. It also stopped at the first non-digit, so 1.5e9 was a 1 byte card.
    var add_mem = vec_new();
    var i = 0;
    while (i + 15 < body_len) {
        if (memeq(body_ptr + i, "\"memory_bytes\":", 15) == 1) {
            var j = i + 15;
            while (j < body_len && load8(body_ptr + j) == 32) { j = j + 1; }
            # The token: digits plus any point, exponent or sign that belong to it.
            var k = j;
            while (k < body_len && _hw_num_byte(load8(body_ptr + k)) == 1) { k = k + 1; }
            var v = _hw_whole_bounded(body_ptr + j, k - j, SIM_MAX_DEVICE_BYTES);
            if (v == 0 - 2) {
                return _hw_out_of_range(cfd, "device memory_bytes", SIM_MAX_DEVICE_BYTES);
            }
            if (v == 0 - 1) {
                return http_bad_request(cfd, "device memory_bytes must be a positive whole number");
            }
            if (v == 0) {
                return http_bad_request(cfd, "device memory_bytes must be greater than 0");
            }
            if (vec_len(add_mem) >= SIM_MAX_DEVICES) {
                return http_bad_request(cfd, "add_devices limited to 64 entries");
            }
            vec_push(add_mem, v);
            i = k;
        }
        i = i + 1;
    }

    var sb = str_builder_new();
    hw_simulate_json(sb, mp, quant, rm, add_mem);
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/hardware/telemetry (2.5.9) — live per-device utilization/memory/temp
# plus interconnect topology. With [hardware] refresh_interval_secs set these
# track the machine over time instead of being frozen at startup.
fn handle_hw_telemetry(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"devices\":");
    hw_telemetry_json(sb);
    str_builder_add_cstr(sb, ",\"has_fast_interconnect\":");
    if (hw_has_fast_interconnect() == 1) {
        str_builder_add_cstr(sb, "true");
    } else {
        str_builder_add_cstr(sb, "false");
    }
    str_builder_add_cstr(sb, ",\"max_interconnect_gbps_x1000\":");
    str_builder_add_int(sb, hw_max_interconnect_bw_x1000());
    str_builder_add_cstr(sb, ",\"system_io\":");
    var sio = hw_system_io();
    if (sio != 0) {
        system_io_to_json(sb, sio);
    } else {
        str_builder_add_cstr(sb, "null");
    }
    str_builder_add_cstr(sb, ",\"available_vram_bytes\":");
    str_builder_add_int(sb, hw_available_vram());
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

fn handle_hw_placement(cfd, body_ptr, body_len) {
    if (body_len == 0) {
        return http_bad_request(cfd, "empty body");
    }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) {
        return http_bad_request(cfd, "invalid JSON");
    }
    # 2.6.13: a model_params that is present must be a whole number within
    # HW_MAX_MODEL_PARAMS. 3e18 used to wrap the memory estimate negative and
    # answer fits_single_device: true. Absent, null or 0 still means "not given".
    var model_params = _hw_json_whole(json_get(pairs, str_from("model_params")), HW_MAX_MODEL_PARAMS);
    if (model_params == 0 - 2) { return _hw_out_of_range(cfd, "model_params", HW_MAX_MODEL_PARAMS); }
    if (model_params == 0 - 1) {
        return http_bad_request(cfd, "model_params must be a positive whole number");
    }
    # Also try extracting from model name
    if (model_params == 0) {
        var mn = json_get(pairs, str_from("model"));
        if (mn != 0) {
            model_params = _hoosh_parse_model_params(to_cstr(mn));
        }
    }
    if (model_params == 0) { model_params = 7000000000; }
    var quant = 0;
    var q_str = json_get(pairs, str_from("quantization"));
    if (q_str != 0) {
        var qs = to_cstr(q_str);
        if (streq(qs, "fp16") == 1) { quant = QUANT_FP16; }
        if (streq(qs, "bf16") == 1) { quant = QUANT_BF16; }
        if (streq(qs, "int8") == 1) { quant = QUANT_INT8; }
        if (streq(qs, "int4") == 1) { quant = QUANT_INT4; }
    }
    var sb = str_builder_new();
    hw_placement_json(sb, model_params, quant);
    return http_json_ok(cfd, str_builder_build(sb));
}

# POST /v1/hardware/model-format — detect a model's container format from the
# RAW model bytes in the request body (send the file or at least its header; the
# detector reads magic/metadata). No filesystem access (safer than a path arg).
# Returns ai-hwaccel's ModelMetadata JSON {format, param_count, dtype, ...}.
fn handle_hw_model_format(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body (send raw model bytes)"); }
    var m = detect_format_from_bytes(body_ptr, body_len);
    if (m == 0) { return http_bad_request(cfd, "unrecognized model format"); }
    return http_json_ok(cfd, model_meta_to_json(m));
}

# Map a requirement string to the ai-hwaccel REQ_* enum, or -1 if unknown.
fn _hoosh_req_from_str(s) {
    if (streq(s, "none") == 1) { return REQ_NONE; }
    if (streq(s, "gpu") == 1) { return REQ_GPU; }
    if (streq(s, "tpu") == 1) { return REQ_TPU; }
    if (streq(s, "gaudi") == 1) { return REQ_GAUDI; }
    if (streq(s, "aws-neuron") == 1) { return REQ_AWS_NEURON; }
    if (streq(s, "gpu-or-tpu") == 1) { return REQ_GPU_OR_TPU; }
    if (streq(s, "any-accelerator") == 1) { return REQ_ANY_ACCELERATOR; }
    return 0 - 1;
}

# POST /v1/hardware/requirement-match — does the detected hardware satisfy a
# scheduler requirement? Body {requirement: "gpu"|"tpu"|..., min_chips?: N}.
# No lock: the scan reads one snapshot of the registry (below). hw_refresh swaps
# in a new registry rather than editing the current one.
fn handle_hw_requirement_match(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var req_str = json_get(pairs, str_from("requirement"));
    if (req_str == 0) { return http_bad_request(cfd, "missing 'requirement'"); }
    var req = _hoosh_req_from_str(to_cstr(req_str));
    if (req < 0) { return http_bad_request(cfd, "unknown requirement"); }
    var min_chips = 1;
    var mc_str = json_get(pairs, str_from("min_chips"));
    if (mc_str != 0) { min_chips = str_to_int(mc_str); }
    var hit = 0;
    # 2.6.13: one load of the registry for the count and every profile. Since
    # 2.5.7 [hardware] refresh_interval_secs lets hw_refresh swap _hw_registry
    # mid-request. With the count and the profiles on separate loads, a refresh
    # that found fewer devices made vec_get call _vec_die(), which exits only the
    # calling worker: the client hung, and sock_close and wq_done never ran.
    # hw_summary_json has the same fix. The bump allocator never frees, so the
    # snapshot stays valid after a swap.
    var reg = _hw_registry;
    if (reg != 0) {
        var np = reg_num_profiles(reg);
        var i = 0;
        while (i < np && hit == 0) {
            var p = reg_get_profile(reg, i);
            if (requirement_satisfied(req, min_chips, p) == 1) { hit = p; }
            i = i + 1;
        }
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"requirement\":\"");
    str_builder_add_cstr(sb, requirement_name(req));
    str_builder_add_cstr(sb, "\",\"min_chips\":");
    str_builder_add_int(sb, min_chips);
    str_builder_add_cstr(sb, ",\"satisfied\":");
    if (hit != 0) { str_builder_add_cstr(sb, "true"); } else { str_builder_add_cstr(sb, "false"); }
    if (hit != 0) {
        str_builder_add_cstr(sb, ",\"device\":\"");
        str_builder_add_cstr(sb, accel_name(profile_accel_type(hit)));
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/hardware/models
fn handle_hw_models(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"models\":[");
    # Check common model sizes
    var sizes = alloc(48);
    store64(sizes, 1000000000);
    store64(sizes + 8, 3000000000);
    store64(sizes + 16, 7000000000);
    store64(sizes + 24, 13000000000);
    store64(sizes + 32, 70000000000);
    store64(sizes + 40, 405000000000);
    var names = alloc(48);
    store64(names, "1B");
    store64(names + 8, "3B");
    store64(names + 16, "7B");
    store64(names + 24, "13B");
    store64(names + 32, "70B");
    store64(names + 40, "405B");
    var first = 1;
    var i = 0;
    while (i < 6) {
        var params = load64(sizes + i * 8);
        var quant = hw_suggest_quant(params);
        var needed = reg_estimate_memory(params, quant);
        var fits = 0;
        var best = hw_best_device();
        if (best != 0) {
            if (needed <= profile_memory_bytes(best)) {
                fits = 1;
            }
        }
        if (first == 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"size\":\"");
        str_builder_add_cstr(sb, load64(names + i * 8));
        str_builder_add_cstr(sb, "\",\"quant\":\"");
        str_builder_add_cstr(sb, quant_name(quant));
        str_builder_add_cstr(sb, "\",\"memory_bytes\":");
        str_builder_add_int(sb, needed);
        str_builder_add_cstr(sb, ",\"fits\":");
        if (fits == 1) {
            str_builder_add_cstr(sb, "true}");
        } else {
            str_builder_add_cstr(sb, "false}");
        }
        first = 0;
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# One catalogue model as rust-old's CompatibleModelInfo.
fn _hw_model_info(sb, m, quant, total) {
    str_builder_add_cstr(sb, "{\"name\":\"");
    str_builder_add_cstr(sb, model_name(m));
    str_builder_add_cstr(sb, "\",\"family\":\"");
    str_builder_add_cstr(sb, model_family(m));
    str_builder_add_cstr(sb, "\",\"params_billions\":");
    _sb_add_milli(sb, model_params_b_x1000(m));
    str_builder_add_cstr(sb, ",\"memory_required_bytes\":");
    str_builder_add_int(sb, model_memory_bytes(m, quant));
    str_builder_add_cstr(sb, ",\"headroom_pct\":");
    _sb_add_milli(sb, model_headroom_x100(m, quant, total) * 10);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# POST /v1/hardware/models {model?, quantization?} (2.7.0) — rust-old's form of
# this route. With `model`, whether that catalogue model runs on the detected
# accelerators (404 when the catalogue has no such model); without it, every
# catalogue model that does. `quantization` defaults to what the hardware would
# pick for a 7B model, as rust-old did. GET keeps the fixed size table above.
fn handle_hw_models_post(cfd, body_ptr, body_len) {
    var name = 0;
    var quant = 0 - 1;   # unset; QUANT_NONE (fp32) is 0
    if (body_len > 0) {
        var pairs = json_parse(str_new(body_ptr, body_len));
        if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
        var mn = json_get(pairs, str_from("model"));
        if (mn != 0 && str_len(mn) > 0) { name = to_cstr(mn); }
        var q_str = json_get(pairs, str_from("quantization"));
        if (q_str != 0) {
            quant = quant_from_str(to_cstr(q_str));
            if (quant < 0) { return http_bad_request(cfd, "invalid quantization (fp32/fp16/bf16/int8/int4)"); }
        }
    }
    if (quant < 0) { quant = hw_suggest_quant(7000000000); }
    var total = hw_accel_memory();
    var models = load_models();
    var sb = str_builder_new();
    if (name != 0) {
        var m = find_model(models, name);
        if (m == 0) { return http_error(cfd, "404", "Not Found", "model not found in catalogue"); }
        str_builder_add_cstr(sb, "{\"model\":");
        _hw_model_info(sb, m, quant, total);
        str_builder_add_cstr(sb, ",\"can_run\":");
        if (model_can_run(m, quant, total) == 1 && total > 0) {
            str_builder_add_cstr(sb, "true");
        } else {
            str_builder_add_cstr(sb, "false");
        }
    } else {
        str_builder_add_cstr(sb, "{\"compatible\":[");
        var compat = compatible_models(models, quant, total);
        var i = 0;
        while (i < vec_len(compat)) {
            if (i > 0) { str_builder_add_cstr(sb, ","); }
            _hw_model_info(sb, vec_get(compat, i), quant, total);
            i = i + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, ",\"quantization\":\"");
    str_builder_add_cstr(sb, quant_name(quant));
    str_builder_add_cstr(sb, "\",\"total_vram_bytes\":");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# POST /v1/hardware/cost — cloud instance $ recommendations for a model
# size + quantization (ai-hwaccel cost.cyr; reads data/cloud_pricing.json,
# degrades to empty recommendations if that file is absent).
fn handle_hw_cost(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var mn = json_get(pairs, str_from("model"));
    if (mn == 0) { return http_bad_request(cfd, "missing 'model' (e.g. \"70b\")"); }
    var quant = QUANT_INT8;
    var q_str = json_get(pairs, str_from("quantization"));
    if (q_str != 0) {
        quant = quant_from_str(to_cstr(q_str));
        if (quant < 0) { return http_bad_request(cfd, "invalid quantization (fp32/fp16/bf16/int8/int4)"); }
    }
    return http_json_ok(cfd, cost_to_json(to_cstr(mn), quant));
}

# POST /v1/hardware/training-estimate — training memory breakdown for a
# model size + method + target (ai-hwaccel training.cyr; pure compute).
fn handle_hw_training(cfd, body_ptr, body_len) {
    if (body_len == 0) { return http_bad_request(cfd, "empty body"); }
    var pairs = json_parse(str_new(body_ptr, body_len));
    if (pairs == 0) { return http_bad_request(cfd, "invalid JSON"); }
    var params_m = 0;
    var mn = json_get(pairs, str_from("model"));
    if (mn != 0) { params_m = _hoosh_parse_model_params(to_cstr(mn)) / 1000000; }
    # 2.6.13: model_params_m is bounded like model_params, in millions. 9e15 used
    # to wrap the estimate, and the response reported negative GiB figures.
    var mp = json_get(pairs, str_from("model_params_m"));
    if (mp != 0) {
        var cap_m = HW_MAX_MODEL_PARAMS / 1000000;
        params_m = _hw_json_whole(mp, cap_m);
        if (params_m == 0 - 2) { return _hw_out_of_range(cfd, "model_params_m", cap_m); }
        if (params_m == 0 - 1) {
            return http_bad_request(cfd, "model_params_m must be a positive whole number");
        }
    }
    if (params_m == 0) { return http_bad_request(cfd, "missing 'model' (e.g. \"7b\") or 'model_params_m'"); }
    var method = TRAIN_LORA;
    var meth_s = json_get(pairs, str_from("method"));
    if (meth_s != 0) {
        method = training_method_from_str(to_cstr(meth_s));
        if (method < 0) {
            var emsg = "invalid 'method' (full/lora/qlora-4bit/qlora-8bit/prefix/dpo/rlhf/distillation)";
            return http_bad_request(cfd, emsg);
        }
    }
    var target = TARGET_GPU;
    var tname = "gpu";
    var tgt_s = json_get(pairs, str_from("target"));
    if (tgt_s != 0) {
        var ts = to_cstr(tgt_s);
        if (streq(ts, "gpu") == 1) { target = TARGET_GPU; tname = "gpu"; }
        elif (streq(ts, "tpu") == 1) { target = TARGET_TPU; tname = "tpu"; }
        elif (streq(ts, "gaudi") == 1) { target = TARGET_GAUDI; tname = "gaudi"; }
        else { return http_bad_request(cfd, "invalid target (gpu/tpu/gaudi)"); }
    }
    var e = estimate_training_memory(params_m, method, target);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model_params_millions\":");
    str_builder_add_int(sb, params_m);
    str_builder_add_cstr(sb, ",\"method\":\"");
    str_builder_add_cstr(sb, training_method_name(method));
    str_builder_add_cstr(sb, "\",\"target\":\"");
    str_builder_add_cstr(sb, tname);
    str_builder_add_cstr(sb, "\",\"estimate\":");
    training_to_json(sb, e);
    str_builder_add_cstr(sb, "}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /v1/hardware/compatible-models — catalogue models that fit the
# detected accelerator memory at int8 (ai-hwaccel model.cyr; reads
# data/models.json, degrades to empty list if that file is absent).
fn handle_hw_compatible(cfd) {
    var quant = QUANT_INT8;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"quantization\":\"int8\",\"models\":[");
    var models = load_models();
    if (hw_ready() == 1) {
        if (vec_len(models) > 0) {
            var avail = hw_accel_memory();
            var compat = compatible_with_registry(models, _hw_registry, quant);
            var first = 1;
            var i = 0;
            while (i < vec_len(compat)) {
                var m = vec_get(compat, i);
                if (first == 0) { str_builder_add_cstr(sb, ","); }
                str_builder_add_cstr(sb, "{\"name\":\"");
                str_builder_add_cstr(sb, model_name(m));
                str_builder_add_cstr(sb, "\",\"family\":\"");
                str_builder_add_cstr(sb, model_family(m));
                str_builder_add_cstr(sb, "\",\"params_b\":");
                str_builder_add_int(sb, model_params_b_x1000(m) / 1000);
                str_builder_add_cstr(sb, ",\"headroom_pct\":");
                str_builder_add_int(sb, model_headroom_x100(m, quant, avail) / 100);
                str_builder_add_cstr(sb, "}");
                first = 0;
                i = i + 1;
            }
        }
    }
    str_builder_add_cstr(sb, "]}");
    return http_json_ok(cfd, str_builder_build(sb));
}

# GET /metrics
fn handle_metrics(cfd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "# HELP hoosh_requests_total Total inference requests\n");
    str_builder_add_cstr(sb, "# TYPE hoosh_requests_total counter\n");
    str_builder_add_cstr(sb, "hoosh_requests_total ");
    str_builder_add_int(sb, _met_requests);
    # 2.7.0: hoosh_tokens_total carries its samples, split by a `type` label as
    # rust-old emitted them. The family used to be declared with no samples of
    # its own, and the numbers went out as hoosh_tokens_prompt_total and
    # hoosh_tokens_completion_total, undeclared. Those two stay, now declared, so
    # 2.x dashboards keep working.
    str_builder_add_cstr(sb, "\n# HELP hoosh_tokens_total Total tokens processed\n");
    str_builder_add_cstr(sb, "# TYPE hoosh_tokens_total counter\n");
    str_builder_add_cstr(sb, "hoosh_tokens_total{type=\"prompt\"} ");
    str_builder_add_int(sb, _met_prompt_tokens);
    str_builder_add_cstr(sb, "\nhoosh_tokens_total{type=\"completion\"} ");
    str_builder_add_int(sb, _met_comp_tokens);
    str_builder_add_cstr(sb, "\n# HELP hoosh_tokens_prompt_total Prompt tokens processed\n");
    str_builder_add_cstr(sb, "# TYPE hoosh_tokens_prompt_total counter\n");
    str_builder_add_cstr(sb, "hoosh_tokens_prompt_total ");
    str_builder_add_int(sb, _met_prompt_tokens);
    str_builder_add_cstr(sb, "\n# HELP hoosh_tokens_completion_total Completion tokens processed\n");
    str_builder_add_cstr(sb, "# TYPE hoosh_tokens_completion_total counter\n");
    str_builder_add_cstr(sb, "hoosh_tokens_completion_total ");
    str_builder_add_int(sb, _met_comp_tokens);
    str_builder_add_cstr(sb, "\n# HELP hoosh_providers_configured ");
    str_builder_add_cstr(sb, "Number of configured providers\n");
    str_builder_add_cstr(sb, "# TYPE hoosh_providers_configured gauge\n");
    str_builder_add_cstr(sb, "hoosh_providers_configured ");
    str_builder_add_int(sb, _met_providers);
    str_builder_add_cstr(sb, "\n");
    metrics_emit_latency(sb);
    str_builder_add_cstr(sb, "# HELP hoosh_events_published_total Provider events published to the bus\n");
    str_builder_add_cstr(sb, "# TYPE hoosh_events_published_total counter\n");
    str_builder_add_cstr(sb, "hoosh_events_published_total ");
    str_builder_add_int(sb, events_total_published());
    str_builder_add_cstr(sb, "\n");
    var body = str_builder_build(sb);
    var bd = to_cstr(body);
    var cr = make_crlf();
    var hdr = str_builder_new();
    str_builder_add_cstr(hdr, "HTTP/1.1 200 OK");
    str_builder_add_cstr(hdr, cr);
    str_builder_add_cstr(hdr, "Content-Type: text/plain; charset=utf-8");
    str_builder_add_cstr(hdr, cr);
    str_builder_add_cstr(hdr, "Content-Length: ");
    str_builder_add_int(hdr, str_len(body));
    str_builder_add_cstr(hdr, cr);
    str_builder_add_cstr(hdr, cr);
    var hdr_s = str_builder_build(hdr);
    sys_write(cfd, to_cstr(hdr_s), str_len(hdr_s));
    sys_write(cfd, bd, str_len(body));
    return 0;
}

# Validate chat request fields. Returns 0 if valid, error string if not.
fn _validate_chat(pairs, body_ptr, body_len) {
    var model = json_get(pairs, str_from("model"));
    if (model == 0) { return "model field is required"; }
    var mc = to_cstr(model);
    var mlen = strlen(mc);
    if (mlen == 0) { return "model field is required"; }
    if (mlen > 256) { return "invalid model name"; }
    # Check for control chars in model name
    var vi = 0;
    while (vi < mlen) {
        var vc = load8(mc + vi);
        if (vc < 32) { return "invalid model name"; }
        vi = vi + 1;
    }
    # Check messages array exists
    var has_messages = 0;
    if (_top_key_value(body_ptr, body_len, "\"messages\"", 10) >= 0) { has_messages = 1; }
    var has_prompt = 0;
    if (json_get(pairs, str_from("prompt")) != 0) { has_prompt = 1; }
    if (has_messages == 0) {
        if (has_prompt == 0) { return "messages array is required"; }
    }
    return 0;
}

# Raw-scan a top-level numeric field -> its value x1000, or GEN_UNSET when
# absent. Raw scan (not json_get) for the SAME reason as _req_reasoning_effort:
# OpenAI clients place these keys AFTER the nested `messages` array, which the
# flat json_parse cannot reach — which is why the pre-2.5.2
# json_get("max_tokens") silently fell back to the 2048 budget default on real
# client traffic. `key` must include the quotes and colon: "\"top_p\":".
# Fractions beyond 3 decimals are truncated; a leading '-' is preserved so
# out-of-range negatives reach validation rather than being silently dropped.

fn _req_num_milli(body_ptr, body_len, key, keylen) {
    var j = _top_key_value(body_ptr, body_len, key, keylen);
    if (j < 0) { return GEN_UNSET; }
    var neg = 0;
    if (j < body_len && load8(body_ptr + j) == 45) {
        neg = 1;
        j = j + 1;
    }
    var ip = 0;
    var digits = 0;
    while (j < body_len) {
        var c = load8(body_ptr + j) & 0xFF;
        if (c < 48 || c > 57) { break; }
        ip = ip * 10 + (c - 48);
        digits = digits + 1;
        j = j + 1;
    }
    if (digits == 0) { return GEN_UNSET; }
    var frac = 0;
    var scale = 100;
    if (j < body_len && load8(body_ptr + j) == 46) {
        j = j + 1;
        while (j < body_len && scale > 0) {
            var fc = load8(body_ptr + j) & 0xFF;
            if (fc < 48 || fc > 57) { break; }
            frac = frac + (fc - 48) * scale;
            scale = scale / 10;
            j = j + 1;
        }
    }
    var v = ip * 1000 + frac;
    if (neg == 1) { return 0 - v; }
    return v;
}

# Upper bound on messages in one chat request (rust-old: handlers.rs).
var MAX_MESSAGES = 256;

# "temperature must be between 0.0 and 2.0, got 3.5" — the offending value is
# echoed so a client can see what it actually sent.
fn _range_err(field, milli, lo, hi) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, field);
    str_builder_add_cstr(sb, " must be between ");
    str_builder_add_cstr(sb, lo);
    str_builder_add_cstr(sb, " and ");
    str_builder_add_cstr(sb, hi);
    str_builder_add_cstr(sb, ", got ");
    if (milli < 0) {
        str_builder_add_cstr(sb, "-");
        _sb_add_milli(sb, 0 - milli);
    } else {
        _sb_add_milli(sb, milli);
    }
    return to_cstr(str_builder_build(sb));
}

# "Token pool 'staging' does not exist"
fn _pool_err(name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Token pool '");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "' does not exist");
    return to_cstr(str_builder_build(sb));
}

# "Too many messages: 300 (max 256)"
fn _count_err(label, got, max) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, label);
    str_builder_add_cstr(sb, ": ");
    str_builder_add_int(sb, got);
    str_builder_add_cstr(sb, " (max ");
    str_builder_add_int(sb, max);
    str_builder_add_cstr(sb, ")");
    return to_cstr(str_builder_build(sb));
}

# Count elements in a raw JSON array span — objects at depth 1, string-aware.
# Used to enforce the message-count bound.
fn _json_array_count(ptr, len) {
    var n = 0;
    var depth = 0;
    var i = 0;
    while (i < len) {
        var c = load8(ptr + i) & 0xFF;
        if (c == 34) {
            i = i + 1;
            while (i < len) {
                if (load8(ptr + i) == 34) { break; }
                if (load8(ptr + i) == 92) { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if (c == 123 || c == 91) {
            if (depth == 1 && c == 123) { n = n + 1; }
            depth = depth + 1;
        }
        if (c == 125 || c == 93) { depth = depth - 1; }
        i = i + 1;
    }
    return n;
}

# Check if request has "stream":true
fn _req_is_stream(body_ptr, body_len) {
    var j = _top_key_value(body_ptr, body_len, "\"stream\"", 8);
    if (j < 0) { return 0; }
    if (j + 4 <= body_len && memeq(body_ptr + j, "true", 4) == 1) { return 1; }
    return 0;
}

# 2.5.0: the OpenAI `reasoning_effort` -> an Anthropic thinking EFFORT LEVEL (1=low, 2=medium, 3=high, 0=none), fed
# to the adaptive `output_config.effort`. A RAW byte scan (like _req_is_stream), NOT json_get: clients put
# reasoning_effort AFTER the nested `messages` array, which the flat json_parse can't reach. Matches
# `"reasoning_effort":"low|medium|high"` (optional space) with a closing quote.
fn _req_reasoning_effort(body_ptr, body_len) {
    var j = _top_key_value(body_ptr, body_len, "\"reasoning_effort\"", 18);
    if (j < 0) { return 0; }
    if (j >= body_len || load8(body_ptr + j) != 34) { return 0; }
    var p = body_ptr + j + 1;
    var rem = body_len - j - 1;
    if (rem > 3 && memeq(p, "low", 3) == 1 && load8(p + 3) == 34) { return 1; }
    if (rem > 6 && memeq(p, "medium", 6) == 1 && load8(p + 6) == 34) { return 2; }
    if (rem > 4 && memeq(p, "high", 4) == 1 && load8(p + 4) == 34) { return 3; }
    return 0;
}

# Extract raw "messages" array from request body
# Extract the raw "tools":[...] array span (ptr,len) from a request body, or 0.
# Balanced-bracket scan with JSON string handling (mirrors _extract_messages).
fn _extract_tools(body_ptr, body_len) {
    # Depth-aware, same reason as _extract_messages.
    var j = _top_key_value(body_ptr, body_len, "\"tools\"", 7);
    if (j < 0) { return 0; }
    if (j >= body_len) { return 0; }
    if (load8(body_ptr + j) != 91) { return 0; }
    var depth = 1;
    var ts = j;
    j = j + 1;
    while (j < body_len && depth > 0) {
        var ch = load8(body_ptr + j);
        if (ch == 91) { depth = depth + 1; }
        if (ch == 93) { depth = depth - 1; }
        if (ch == 34) {
            j = j + 1;
            while (j < body_len) {
                if (load8(body_ptr + j) == 34) { break; }
                if (load8(body_ptr + j) == 92) { j = j + 1; }
                j = j + 1;
            }
        }
        j = j + 1;
    }
    var tlen = j - ts;
    var result = alloc(16);
    if (result == 0) { return 0; }
    store64(result, body_ptr + ts);
    store64(result + 8, tlen);
    return result;
}

fn _extract_messages(body_ptr, body_len) {
    # Depth-aware: an identical "messages" key nested inside a tools schema used
    # to win whenever it appeared first, so the validator saw a messages array,
    # the request passed, and this returned the NESTED span — forwarding a
    # schema fragment as the conversation.
    var mi = _top_key_value(body_ptr, body_len, "\"messages\"", 10);
    if (mi < 0) { return 0; }
    if (mi >= body_len) { return 0; }
    if (load8(body_ptr + mi) != 91) { return 0; }
    var depth = 1;
    var ms = mi;
    mi = mi + 1;
    while (mi < body_len && depth > 0) {
        var ch = load8(body_ptr + mi);
        if (ch == 91) { depth = depth + 1; }
        if (ch == 93) { depth = depth - 1; }
        if (ch == 34) {
            mi = mi + 1;
            while (mi < body_len) {
                if (load8(body_ptr + mi) == 34) { break; }
                if (load8(body_ptr + mi) == 92) { mi = mi + 1; }
                mi = mi + 1;
            }
        }
        mi = mi + 1;
    }
    # Return packed: ptr * 0x100000000 + len
    var mlen = mi - ms;
    var result = alloc(16);
    if (result == 0) { return 0; }
    store64(result, body_ptr + ms);
    store64(result + 8, mlen);
    return result;
}

# Stream one SSE chunk wrapping a content token
fn _sse_chunk(cfd, model, content, content_len) {
    var sb = str_builder_new();
    sb_add_chat_head(sb, "chat.completion.chunk");
    str_builder_add_cstr(sb, "\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"choices\":[{\"index\":0,");
    str_builder_add_cstr(sb, "\"delta\":{\"content\":\"");
    # Add content (already escaped from provider)
    var cs = str_builder_build(sb);
    var prefix = to_cstr(cs);
    var plen = strlen(prefix);
    var suffix = "\"},\"finish_reason\":null}]}";
    var slen = strlen(suffix);
    var total = plen + content_len + slen;
    var buf = alloc(total + 1);
    memcpy(buf, prefix, plen);
    memcpy(buf + plen, content, content_len);
    memcpy(buf + plen + content_len, suffix, slen);
    store8(buf + total, 0);
    # Propagate a dead peer so the caller can stop pulling from the provider.
    return http_sse_event(cfd, buf, total);
}

# Stream one SSE chunk carrying an extended-thinking delta (2.5.0) as `delta.reasoning_content` — the de-facto
# OpenAI-compat field for a model's reasoning stream (DeepSeek/others use it), kept SEPARATE from `delta.content`
# so a client can fold the reasoning apart from the answer. Byte-for-byte `_sse_chunk` but for the delta key.
fn _sse_reasoning_chunk(cfd, model, content, content_len) {
    var sb = str_builder_new();
    sb_add_chat_head(sb, "chat.completion.chunk");
    str_builder_add_cstr(sb, "\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"choices\":[{\"index\":0,");
    str_builder_add_cstr(sb, "\"delta\":{\"reasoning_content\":\"");
    var cs = str_builder_build(sb);
    var prefix = to_cstr(cs);
    var plen = strlen(prefix);
    var suffix = "\"},\"finish_reason\":null}]}";
    var slen = strlen(suffix);
    var total = plen + content_len + slen;
    var buf = alloc(total + 1);
    memcpy(buf, prefix, plen);
    memcpy(buf + plen, content, content_len);
    memcpy(buf + plen + content_len, suffix, slen);
    store8(buf + total, 0);
    # Propagate a dead peer so the caller can stop pulling from the provider.
    return http_sse_event(cfd, buf, total);
}

# Stream one SSE chunk wrapping a tool_calls delta (passed through verbatim).
fn _sse_tool_chunk(cfd, model, tool_calls) {
    var sb = str_builder_new();
    sb_add_chat_head(sb, "chat.completion.chunk");
    str_builder_add_cstr(sb, "\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"choices\":[{\"index\":0,");
    str_builder_add_cstr(sb, "\"delta\":{\"tool_calls\":");
    str_builder_add_cstr(sb, tool_calls);
    str_builder_add_cstr(sb, "},\"finish_reason\":null}]}");
    var s = str_builder_build(sb);
    var d = to_cstr(s);
    return http_sse_event(cfd, d, str_len(s));
}

# _sse_error_chunk: send the upstream-error frame built by provider_err.cyr. The BODY lives there (and
# is unit-tested there); this is only the send, which needs a socket.
fn _sse_error_chunk(cfd, model, status, message) {
    var d = upstream_error_sse_body(model, status, message);
    return http_sse_event(cfd, d, strlen(d));
}

# Send the final SSE stop chunk
fn _sse_stop(cfd, model) {
    var sb = str_builder_new();
    sb_add_chat_head(sb, "chat.completion.chunk");
    str_builder_add_cstr(sb, "\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"choices\":[{\"index\":0,");
    str_builder_add_cstr(sb, "\"delta\":{},");
    str_builder_add_cstr(sb, "\"finish_reason\":\"stop\"}]}");
    var s = str_builder_build(sb);
    var d = to_cstr(s);
    http_sse_event(cfd, d, str_len(s));
    http_sse_done(cfd);
    return 0;
}

# SSE event callback for incremental remote streaming (sandhi_http_stream
# contract: return nonzero to continue, 0 to stop). ctx layout:
#   cfd(8) model(8) provider(8) emitted(8).
# Each event's data is the provider's SSE payload; the per-provider extractor
# (already used on the non-streaming path) pulls the delta text out of it.
# Convert an Anthropic streaming event into an OpenAI tool_call delta and emit
# it. `content_block_start` (tool_use) carries the id+name; `input_json_delta`
# carries incremental `partial_json` argument fragments. Returns 1 if emitted.
fn _emit_anthropic_tool_delta(cfd, model, data, dlen) {
    var is_start = _cmp_substr(data, dlen, "content_block_start", 19) >= 0;
    var is_delta = _cmp_substr(data, dlen, "input_json_delta", 16) >= 0;
    if (is_start == 0 && is_delta == 0) { return 0; }
    var idx = _json_extract_int(data, dlen, "index", 5);
    if (is_start == 1) {
        if (_cmp_substr(data, dlen, "tool_use", 8) < 0) { return 0; }
        var idf = _json_obj_str_field(data, dlen, "id", 2);
        var nmf = _json_obj_str_field(data, dlen, "name", 4);
        if (idf == 0 || nmf == 0) { return 0; }
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "[{\"index\":");
        str_builder_add_int(sb, idx);
        str_builder_add_cstr(sb, ",\"id\":\"");
        str_builder_add(sb, str_new(load64(idf), load64(idf + 8)));
        str_builder_add_cstr(sb, "\",\"type\":\"function\",\"function\":{\"name\":\"");
        str_builder_add(sb, str_new(load64(nmf), load64(nmf + 8)));
        str_builder_add_cstr(sb, "\",\"arguments\":\"\"}}]");
        _sse_tool_chunk(cfd, model, to_cstr(str_builder_build(sb)));
        return 1;
    }
    var pjf = _json_obj_str_field(data, dlen, "partial_json", 12);
    if (pjf == 0) { return 0; }
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "[{\"index\":");
    str_builder_add_int(sb2, idx);
    str_builder_add_cstr(sb2, ",\"function\":{\"arguments\":\"");
    # partial_json is already escaped to fit the event string — emit verbatim.
    str_builder_add(sb2, str_new(load64(pjf), load64(pjf + 8)));
    str_builder_add_cstr(sb2, "\"}}]");
    _sse_tool_chunk(cfd, model, to_cstr(str_builder_build(sb2)));
    return 1;
}

fn _remote_stream_cb(ctx, ev) {
    var data = sandhi_sse_event_data(ev);
    if (data == 0) { return 1; }
    var dlen = strlen(data);
    if (dlen == 0) { return 1; }
    var prov = load64(ctx + 16);
    # OpenAI-compat terminates the stream with a literal `[DONE]` sentinel.
    if (dlen == 6) {
        if (memeq(data, "[DONE]", 6) == 1) { return 0; }
    }
    # ⚠ 2.6.5 — AN IN-STREAM ERROR EVENT WAS SILENTLY DROPPED. A provider that has already sent `200 OK`
    # cannot change its status either, so it reports a mid-stream failure as an EVENT: Anthropic sends
    # `event: error` with `{"type":"error","error":{"type":…,"message":…}}`, and OpenAI-compatible
    # backends put a top-level `"error"` object in a data frame. This callback looked only for text,
    # thinking and tool deltas, so such a frame extracted to empty everywhere and was skipped — the
    # stream then ended normally and the client received a clean, successful, EMPTY completion.
    #
    # That is the same laundering the buffered path did, arriving by a different road, and it is the one
    # that actually bit: measured live, a request the non-streaming path answered fine came back from the
    # streaming path as `finish_reason:"stop"` with no content and NOTHING in hoosh's log. Forward it.
    if (_sse_is_error_event(ev, data, dlen) == 1) {
        var perr = _sse_error_message(data, dlen);
        _sse_error_chunk(load64(ctx), load64(ctx + 8), 0, perr);
        store64(ctx + 32, 1);                     # tell the handler an error was already reported
        hlog_error(perr);
        return 0;                                  # stop pulling: the provider is done talking
    }
    var txt = 0;
    if (prov == PROV_ANTHROPIC) {
        # content_block_delta carries delta.text; other event types have no
        # "text":"..." and extract to empty (skipped below).
        txt = anthropic_extract_text(data, dlen);
        # 2.5.0 extended thinking: a thinking_delta -> emit a `reasoning_content` chunk (separate from the answer
        # content so the client can fold it). Empty on text/signature/message events. Only sent when the request
        # enabled thinking (budget_tokens), so this is inert for a normal turn.
        var think = anthropic_extract_thinking(data, dlen);
        if (strlen(think) > 0) {
            _sse_reasoning_chunk(load64(ctx), load64(ctx + 8), think, strlen(think));
            store64(ctx + 24, load64(ctx + 24) + 1);
        }
    } else {
        if (prov == PROV_GOOGLE) {
            # candidates[].content.parts[].text
            txt = anthropic_extract_text(data, dlen);
        } else {
            # OpenAI-compat delta: choices[].delta.content
            txt = ollama_extract_text(data, dlen);
        }
    }
    if (strlen(txt) > 0) {
        _sse_chunk(load64(ctx), load64(ctx + 8), txt, strlen(txt));
        store64(ctx + 24, load64(ctx + 24) + 1);
    }
    # Tool-call deltas, converted per provider to OpenAI tool_call delta chunks.
    if (prov == PROV_ANTHROPIC) {
        if (_emit_anthropic_tool_delta(load64(ctx), load64(ctx + 8), data, dlen) == 1) {
            store64(ctx + 24, load64(ctx + 24) + 1);
        }
    } else {
        if (prov == PROV_GOOGLE) {
            # Gemini streams complete functionCall parts; reuse the non-stream
            # converter and emit each as one delta.
            var gtc = _gemini_tool_calls(data, dlen);
            if (gtc != 0) {
                _sse_tool_chunk(load64(ctx), load64(ctx + 8), gtc);
                store64(ctx + 24, load64(ctx + 24) + 1);
            }
        } else {
            # OpenAI-compat tool_call deltas pass straight through.
            var tc = _extract_openai_tool_calls(data, dlen);
            if (tc != 0) {
                _sse_tool_chunk(load64(ctx), load64(ctx + 8), tc);
                store64(ctx + 24, load64(ctx + 24) + 1);
            }
        }
    }
    return 1;
}

# Build the streaming request body for a remote provider. Tools are forwarded on
# all three families; their streaming tool deltas are converted in
# _remote_stream_cb.
fn _remote_stream_body(route, model, msg_raw, msg_len, tools_raw, tools_len, gen) {
    var prov = route_provider(route);
    if (prov == PROV_ANTHROPIC) {
        return _build_anthropic_body_x(model, msg_raw, msg_len, 1, tools_raw, tools_len, gen);
    }
    if (prov == PROV_GOOGLE) {
        return _build_gemini_body(msg_raw, msg_len, tools_raw, tools_len);
    }
    return _build_chat_body_raw_stream(model, msg_raw, msg_len, tools_raw, tools_len, gen,
      (prov == PROV_OLLAMA));
}

# Build the streaming request URL for a remote provider.
fn _remote_stream_url(route, model) {
    if (route_provider(route) == PROV_GOOGLE) {
        return _gemini_url_stream(route_base_url(route), model, route_api_key(route));
    }
    return _provider_url(route_base_url(route), _provider_path(route));
}

# Streaming handler: proxy NDJSON/SSE from backend to client
fn handle_chat_stream(cfd, route, model, msg_raw, msg_len, tools_raw, tools_len, gen) {
    # 2.7.0: one id and created time for every chunk of this stream.
    chat_id_new();
    # Remote (TLS) providers: incremental SSE via sandhi_http_stream, decoding
    # each provider's delta events and re-emitting them as OpenAI SSE chunks.
    # If the stream errors before emitting anything, fall back to the buffered
    # non-streaming path (no second http_sse_begin). Local backends stream
    # token-by-token below.
    if (route_is_remote(route) == 1) {
        http_sse_begin(cfd);
        var sbody = _remote_stream_body(route, model, msg_raw, msg_len,
          tools_raw, tools_len, gen);
        var surl = _remote_stream_url(route, model);
        var hdrs = _provider_headers(route);
        var ctx = alloc(40);          # 2.6.5: +32 = "an error frame was already sent to the client"
        store64(ctx, cfd);
        store64(ctx + 8, model);
        store64(ctx + 16, route_provider(route));
        store64(ctx + 24, 0);
        store64(ctx + 32, 0);
        var sres = sandhi_http_stream(
          surl, "POST", hdrs, sbody, strlen(sbody),
          &_remote_stream_cb, ctx);
        var emitted = load64(ctx + 24);
        var err_sent = load64(ctx + 32);          # 2.6.5: the callback already told the client
        var ok = 0;
        if (sres != 0) {
            if (sandhi_stream_err(sres) == SANDHI_OK) {
                var st = sandhi_stream_status(sres);
                if (st >= 200) { if (st < 300) { ok = 1; } }
            }
        }
        if (err_sent == 1) {
            # 2.6.5: the provider reported the failure in-stream and the client already has it. Do not
            # retry into a buffered fallback — the provider has said no, and a second attempt would
            # either repeat the refusal or (worse) succeed and contradict the error already sent.
            metrics_record(0, emitted);
        } elif (ok == 0) {
            # Only safe to fall back when nothing was streamed yet, otherwise
            # the buffered emit would duplicate the partial output.
            if (emitted == 0) {
                var rresult = retry_forward(
                  _retry_cfg, route, model, "hello", msg_raw, msg_len,
                  tools_raw, tools_len, gen);
                if (rresult != 0) {
                    var rtext = load64(rresult);
                    if (strlen(rtext) > 0) {
                        _sse_chunk(cfd, model, rtext, strlen(rtext));
                    }
                    var rtc = load64(rresult + 32);
                    if (rtc != 0) { _sse_tool_chunk(cfd, model, rtc); }
                    metrics_record(0, load64(rresult + 24));
                } else {
                    # 2.6.5: the stream failed AND the buffered fallback failed. Nothing will be sent
                    # after this but the stop frame, so this is the last chance to say why — otherwise
                    # the client receives a clean, empty, successful completion and blames the model.
                    var estatus = provider_last_error_status();
                    var emsg = provider_last_error_msg();
                    if (estatus == 0) { emsg = "the provider could not be reached"; }
                    _sse_error_chunk(cfd, model, estatus, emsg);
                    hlog_error("chat stream: no content produced; reporting upstream error to the client");
                    if (_audit_chain != 0) {
                        mutex_lock(_chat_lock);
                        audit_record(_audit_chain, "inference.error", "error",
                          "streaming inference failed (remote)",
                          provider_name(route_provider(route)), model);
                        mutex_unlock(_chat_lock);
                    }
                    event_inference_failed(provider_name(route_provider(route)), model, "upstream error");
                }
            }
        } else {
            metrics_record(0, emitted);
        }
        if (_audit_chain != 0) {
            # _chat_lock: audit-chain append may race a background batch worker.
            mutex_lock(_chat_lock);
            audit_record(_audit_chain, "inference.stream", "info",
              "streaming inference (remote)",
              provider_name(route_provider(route)), model);
            mutex_unlock(_chat_lock);
        }
        _sse_stop(cfd, model);
        return 0;
    }

    # 2.6.1: forward the caller's tools here too. This branch used to drop them on the floor —
    # the remote branch above has always passed them to _remote_stream_body.
    var bfd = retry_forward_stream(
      _retry_cfg, route, model, msg_raw, msg_len, tools_raw, tools_len, gen);
    if (bfd < 0) {
        return http_error(cfd, "502", "Bad Gateway",
          "provider backend unreachable");
    }

    http_sse_begin(cfd);

    # Read backend response line by line
    var lbuf = alloc(65536);
    var lpos = 0;
    var is_ollama = (route_provider(route) == PROV_OLLAMA);
    var token_count = 0;

    var rbuf = alloc(4096);
    var done = 0;
    # 2.7.0: SSE keep-alive. rust-old sent a comment every 15 s of silence, which
    # keeps a proxy's idle timeout (nginx and most load balancers: 60 s) from
    # cutting a stream while a model loads or thinks before its first token. The
    # backend read now times out every SSE_KEEPALIVE_S; each timeout sends a
    # comment line, which SSE clients ignore, and the silences are summed so the
    # stream still ends after HTTP_IO_TIMEOUT_S with nothing from the backend.
    sock_set_recv_timeout(bfd, SSE_KEEPALIVE_S, 0);
    var idle_s = 0;
    # 2.5.11: `done` is now also set when a chunk write fails, i.e. the client
    # hung up. Before, hoosh drained the WHOLE upstream response into a closed
    # socket — a worker and real provider tokens spent on a request that had
    # already left, and something an unauthenticated caller could do in a loop.
    while (done == 0) {
        var n = sys_read(bfd, rbuf, 4096);
        if (n == 0 - EAGAIN) {
            idle_s = idle_s + SSE_KEEPALIVE_S;
            if (idle_s >= HTTP_IO_TIMEOUT_S) { done = 1; break; }
            if (http_sse_comment(cfd, "keep-alive") < 0) { done = 1; }
            continue;
        }
        if (n <= 0) { done = 1; break; }
        idle_s = 0;
        var ri = 0;
        while (ri < n) {
            var ch = load8(rbuf + ri);
            if (ch == 10) {
                # Complete line in lbuf[0..lpos]
                if (lpos > 0) {
                    store8(lbuf + lpos, 0);
                    if (is_ollama == 1) {
                        # Ollama NDJSON: extract "content"
                        var txt = ollama_extract_text(lbuf, lpos);
                        if (strlen(txt) > 0) {
                            if (_sse_chunk(cfd, model,
                                txt, strlen(txt)) < 0) { done = 1; }
                            token_count = token_count + 1;
                        }
                        # 2.6.1: …and its tool calls. Reading only "content" meant a locally
                        # streamed tool call was parsed off the wire and then thrown away, so
                        # even once tools are forwarded (above) the caller would see an empty
                        # reply instead of the call. Converted out of Ollama's native shape,
                        # exactly as the non-streaming path does.
                        var otc = _ollama_tool_calls(lbuf, lpos);
                        if (otc != 0) {
                            if (_sse_tool_chunk(cfd, model, otc) < 0) { done = 1; }
                        }
                    } else {
                        # OpenAI SSE: lines start with "data: "
                        if (lpos > 6) {
                            if (memeq(lbuf, "data: ", 6) == 1) {
                                var dptr = lbuf + 6;
                                var dlen = lpos - 6;
                                if (memeq(dptr, "[DONE]", 6) == 1) {
                                    done = 1;
                                } else {
                                    var txt = ollama_extract_text(
                                      dptr, dlen);
                                    if (strlen(txt) > 0) {
                                        if (_sse_chunk(cfd, model,
                                            txt, strlen(txt)) < 0) { done = 1; }
                                        token_count = token_count + 1;
                                    }
                                    # 2.6.1: a LOCAL OpenAI-compatible backend streams
                                    # tool_call deltas in the same shape the remote branch
                                    # already decodes; they were dropped here for the same
                                    # reason Ollama's were.
                                    var ltc = _extract_openai_tool_calls(dptr, dlen);
                                    if (ltc != 0) {
                                        if (_sse_tool_chunk(cfd, model,
                                            ltc) < 0) { done = 1; }
                                    }
                                }
                            }
                        }
                    }
                }
                lpos = 0;
            } else {
                if (ch != 13) {
                    if (lpos < 65535) {
                        store8(lbuf + lpos, ch);
                        lpos = lpos + 1;
                    }
                }
            }
            ri = ri + 1;
        }
    }

    _sse_stop(cfd, model);
    sys_close(bfd);
    metrics_record(0, token_count);
    if (_audit_chain != 0) {
        # _chat_lock: audit-chain append may race a background batch worker.
        mutex_lock(_chat_lock);
        audit_record(_audit_chain, "inference.stream",
          "info", "streaming inference", provider_name(route_provider(route)), model);
        mutex_unlock(_chat_lock);
    }
    return 0;
}

# Exact-key response-cache key: sha256-hex over model + the raw request body.
# Identical requests (same model + byte-identical body) collide to one entry;
# this is the exact-key LRU cache (the semantic cache handles similarity).
# Scope for a semantic index entry: caller identity + model. The index matches
# on vector similarity, so the exact cache key's identity does NOT protect it —
# a near-identical prompt from another tenant would still score above the
# threshold. Entries are compared on this string before scoring.
fn _sem_scope(model) {
    var sb = str_builder_new();
    str_builder_add_int(sb, auth_identity());
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, model);
    return to_cstr(str_builder_build(sb));
}

fn _cache_key(model, body_ptr, body_len) {
    var sb = str_builder_new();
    # Caller identity first: without it the cache was shared across every
    # consumer of the gateway, so one tenant's response could be replayed to
    # another for an identical prompt. 0 when auth is not configured, which
    # keeps single-tenant deployments byte-compatible with their existing keys
    # only in the sense that they all share one namespace — the hash changes,
    # so the cache is cold once after upgrade.
    str_builder_add_int(sb, auth_identity());
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\n");
    var bb = alloc(body_len + 1);
    memcpy(bb, body_ptr, body_len);
    store8(bb + body_len, 0);
    str_builder_add_cstr(sb, bb);
    var s = str_builder_build(sb);
    return sha256_hex(to_cstr(s), str_len(s));
}

# Append ptr[0..len) into a str_builder, JSON-escaping it for a string value.
fn _json_escape_into(sb, ptr, len) {
    var i = 0;
    while (i < len) {
        var c = load8(ptr + i);
        if (c == 34) { str_builder_add_byte(sb, 92); str_builder_add_byte(sb, 34); }
        if (c == 92) { str_builder_add_byte(sb, 92); str_builder_add_byte(sb, 92); }
        if (c == 10) { str_builder_add_byte(sb, 92); str_builder_add_byte(sb, 110); }
        if (c == 13) { str_builder_add_byte(sb, 92); str_builder_add_byte(sb, 114); }
        if (c == 9) { str_builder_add_byte(sb, 92); str_builder_add_byte(sb, 116); }
        if (c >= 32 && c != 34 && c != 92) { str_builder_add_byte(sb, c); }
        i = i + 1;
    }
    return 0;
}

# Embed a query (the request body) via the configured embedding model's provider.
# Returns a 16-byte (vec_ptr, n) of ×10000 fixed-point components, or 0 on any
# failure (so the caller degrades gracefully to a normal forward).
fn _embed_query_body(body_ptr, body_len) {
    var model = semantic_model();
    if (model == 0) { return 0; }
    var route = router_select(_router, model);
    if (route == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"input\":\"");
    _json_escape_into(sb, body_ptr, body_len);
    str_builder_add_cstr(sb, "\"}");
    var body = to_cstr(str_builder_build(sb));
    var blen = strlen(body);
    var rb = 0;
    var rbl = 0;
    if (route_is_remote(route) == 1) {
        var url = _provider_url(route_base_url(route), "/v1/embeddings");
        var hdrs = _provider_headers(route);
        # Bounded: this call sits inside _chat_lock (see the semantic-cache
        # note in _chat_prep), so an unbounded embedding round-trip would
        # serialise the whole worker pool behind one hung backend.
        var sresp = sandhi_http_post_opts(url, hdrs, body, blen, _remote_http_opts());
        if (sresp == 0) { return 0; }
        if (sandhi_http_err_kind(sresp) != SANDHI_OK) { return 0; }
        var sst = sandhi_http_status(sresp);
        if (sst < 200 || sst >= 300) { return 0; }
        rbl = sandhi_http_body_len(sresp);
        rb = alloc(rbl + 1);
        memcpy(rb, sandhi_http_body(sresp), rbl);
        store8(rb + rbl, 0);
    } else {
        var base = route_base_url(route);
        var epath = "/v1/embeddings";
        if (route_provider(route) == PROV_OLLAMA) { epath = "/api/embeddings"; }
        var resp = http_post_local(base, epath, body, blen);
        if (resp == 0) { return 0; }
        if (http_status(resp) < 200 || http_status(resp) >= 300) { return 0; }
        rb = http_body(resp);
        rbl = http_body_len(resp);
    }
    var nptr = alloc(8);
    var vec = semantic_parse_embedding(rb, rbl, nptr);
    if (load64(nptr) == 0) { return 0; }
    var r = alloc(16);
    store64(r, vec);
    store64(r + 8, load64(nptr));
    return r;
}

# Build an OpenAI chat.completion response envelope (str). Shared by the live
# chat path and cache warming so a warmed entry is byte-identical to a fresh one.
# Build an OpenAI-compatible chat-completion body.
#
# 2.5.12: `usage` also carries `cost_micro_usd` and `provider`. Both were
# already computed by the time this ran — `cost_record` prices the call with
# `estimate_cost_micro` and the route knows its provider — and neither reached
# the client, so a consumer had to re-implement hoosh's pricing table to report
# a per-request cost, and had to guess the provider from the model name. That
# guess is wrong whenever DLP re-routes a confidential request to a local
# provider: hoosh bills $0 and the consumer prices it as remote.
#
# `cost_micro_usd` is integer micro-USD, the same unit `estimate_cost_micro`
# returns, so a consumer never converts and never rounds. Both fields are
# additive inside the existing `usage` object; an OpenAI-shaped client ignores
# unknown fields. `provider` is the real serving route, not the requested one.
fn _chat_completion_body(model, resp_text, ptok, ctok, tool_calls, cost_micro, provider) {
    var sb = str_builder_new();
    # 2.7.0: a fresh id and created time per completion (see provider_err.cyr).
    chat_id_new();
    sb_add_chat_head(sb, "chat.completion");
    str_builder_add_cstr(sb, "\"model\":\"");
    str_builder_add_cstr(sb, model);
    str_builder_add_cstr(sb, "\",\"choices\":[{\"index\":0,");
    str_builder_add_cstr(sb, "\"message\":{\"role\":\"assistant\",");
    str_builder_add_cstr(sb, "\"content\":\"");
    str_builder_add_cstr(sb, resp_text);
    str_builder_add_cstr(sb, "\"");
    if (tool_calls != 0) {
        str_builder_add_cstr(sb, ",\"tool_calls\":");
        str_builder_add_cstr(sb, tool_calls);
        str_builder_add_cstr(sb, "},\"finish_reason\":\"tool_calls\"}],");
    } else {
        str_builder_add_cstr(sb, "},\"finish_reason\":\"stop\"}],");
    }
    str_builder_add_cstr(sb, "\"usage\":{\"prompt_tokens\":");
    str_builder_add_int(sb, ptok);
    str_builder_add_cstr(sb, ",\"completion_tokens\":");
    str_builder_add_int(sb, ctok);
    str_builder_add_cstr(sb, ",\"total_tokens\":");
    str_builder_add_int(sb, ptok + ctok);
    str_builder_add_cstr(sb, ",\"cost_micro_usd\":");
    str_builder_add_int(sb, cost_micro);
    if (provider != 0) {
        str_builder_add_cstr(sb, ",\"provider\":\"");
        str_builder_add_cstr(sb, provider);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}}");
    return str_builder_build(sb);
}

# POST /v1/chat/completions
# ── Deferred response descriptor ──────────────
# A response that _chat_produce *returns* instead of writing to a socket,
# so a batch worker can collect the body off the accept thread. Layout
# (32 bytes): status cstr(+0), status_text cstr(+8), body cstr(+16),
# body_len(+24). _resp_write replays it through http_respond.
fn _resp_new(status, status_text, body_cstr, body_len) {
    var r = alloc(40);
    store64(r, status);
    store64(r + 8, status_text);
    store64(r + 16, body_cstr);
    store64(r + 24, body_len);
    store64(r + 32, 0);
    return r;
}

# Attach one extra response header — a `Name: value` cstr, no CRLF.
#
# 2.5.12: used for `X-Hoosh-Cache`, so a client can tell a cache hit from a
# fresh inference. Before this the two were byte-indistinguishable, which meant
# a caching consumer double-counted spend on every hit.
fn _resp_set_header(r, hdr) {
    store64(r + 32, hdr);
    return r;
}

# Error-response descriptor mirroring http_error / http_bad_request bodies.
fn _resp_err(status, status_text, msg, etype) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"error\":{\"message\":\"");
    str_builder_add_cstr(sb, msg);
    str_builder_add_cstr(sb, "\",\"type\":\"");
    str_builder_add_cstr(sb, etype);
    str_builder_add_cstr(sb, "\"}}");
    var b = str_builder_build(sb);
    return _resp_new(status, status_text, to_cstr(b), str_len(b));
}

fn _resp_write(cfd, r) {
    return http_respond_h(cfd, load64(r), load64(r + 8), load64(r + 16), load64(r + 24),
      load64(r + 32));
}

# ── Chat request preparation (shared by streaming + non-streaming) ─────
# Runs validation, routing, DLP, response/semantic cache, rate limiting,
# budget reservation, and message extraction/compression/compaction. Returns
# a prep record (alloc 104):
#   +0  kind   0 = terminal (a finished _resp descriptor sits at +8),
#              1 = ready (the request should be forwarded; fields below)
#   +8  route / terminal-descriptor   +16 model_cstr   +24 msg_raw
#   +32 msg_raw_len   +40 tools_raw    +48 tools_len    +56 bpool
#   +64 est_tokens    +72 prompt_cstr  +80 ckey         +88 sem_vec  +96 sem_n
#   +104 thinking_budget (2.5.0)
# Cache lookups are skipped when is_stream != 0 (matches the prior behavior:
# streaming responses are never cache-served).
fn _chat_prep(body_ptr, body_len, is_stream) {
    var out = alloc(112);   # 2.5.0: +104 holds the extended-thinking budget (was alloc(104), fully used through +96)
    store64(out, 0);
    store64(out + 104, 0);   # default: thinking off (set below from reasoning_effort)
    if (body_len == 0) {
        store64(out + 8, _resp_err("400", "Bad Request", "empty request body", "invalid_request_error"));
        return out;
    }
    var body_str = str_new(body_ptr, body_len);
    var pairs = json_parse(body_str);
    if (pairs == 0) {
        store64(out + 8, _resp_err("400", "Bad Request", "invalid JSON", "invalid_request_error"));
        return out;
    }
    var verr = _validate_chat(pairs, body_ptr, body_len);
    if (verr != 0) {
        store64(out + 8, _resp_err("400", "Bad Request", verr, "invalid_request_error"));
        return out;
    }

    # 2.5.2 sampling params. Raw-scanned (see _req_num_milli) because clients
    # put them after `messages`, and range-checked here rather than in
    # _validate_chat, which is defined ahead of the scanners in single-pass
    # order. The error carries the offending value, matching rust-old.
    var g_temp = _req_num_milli(body_ptr, body_len, "\"temperature\"", 13);
    if (g_temp != GEN_UNSET) {
        if (g_temp < 0 || g_temp > 2000) {
            store64(out + 8, _resp_err("400", "Bad Request",
                _range_err("temperature", g_temp, "0.0", "2.0"), "invalid_request_error"));
            return out;
        }
    }
    var g_topp = _req_num_milli(body_ptr, body_len, "\"top_p\"", 7);
    if (g_topp != GEN_UNSET) {
        if (g_topp < 0 || g_topp > 1000) {
            store64(out + 8, _resp_err("400", "Bad Request",
                _range_err("top_p", g_topp, "0.0", "1.0"), "invalid_request_error"));
            return out;
        }
    }
    var g_maxt = _req_num_milli(body_ptr, body_len, "\"max_tokens\"", 12);
    if (g_maxt != GEN_UNSET) {
        g_maxt = g_maxt / 1000;
        if (g_maxt <= 0) {
            store64(out + 8, _resp_err("400", "Bad Request",
                "max_tokens must be greater than 0", "invalid_request_error"));
            return out;
        }
    } else {
        g_maxt = 0;
    }

    # Message-count bounds. An empty array reaches a provider as a malformed
    # request; an unbounded one is a cheap way to make hoosh do expensive work.
    var vmsgs = _extract_messages(body_ptr, body_len);
    if (vmsgs != 0) {
        var vmc = _json_array_count(load64(vmsgs), load64(vmsgs + 8));
        if (vmc == 0) {
            store64(out + 8, _resp_err("400", "Bad Request",
                "messages array is empty", "invalid_request_error"));
            return out;
        }
        if (vmc > MAX_MESSAGES) {
            store64(out + 8, _resp_err("400", "Bad Request",
                _count_err("Too many messages", vmc, MAX_MESSAGES), "invalid_request_error"));
            return out;
        }
    }

    var model = json_get(pairs, str_from("model"));
    var model_cstr = to_cstr(model);
    # 2.5.9: hardware-aware selection. When the model's size can be read from
    # its name and it does not fit the VRAM actually free, prefer a remote
    # provider over a local one that would OOM. Unknown-size models and
    # undetected hardware fall through to plain router_select.
    var route = router_select_hw(_router, model_cstr, _hoosh_parse_model_params(model_cstr));
    if (route == 0) {
        hlog_warn("chat: no provider for requested model");
        store64(out + 8, _resp_err("404", "Not Found", "no provider for model", "server_error"));
        return out;
    }

    # DLP: Restricted -> block; Confidential -> local provider only.
    # Hoisted: the semantic-cache stage below must honour the same
    # classification, and it used to be scoped to this block.
    var dlp_level = CLASS_PUBLIC;
    if (dlp_is_enabled() == 1) {
        dlp_level = dlp_scan_level_json(body_ptr, body_len);
        if (dlp_level == CLASS_RESTRICTED) {
            hlog_warn("dlp: restricted content blocked");
            store64(out + 8, _resp_err("403", "Forbidden",
                "request blocked: restricted content detected", "server_error"));
            return out;
        }
        if (dlp_level == CLASS_CONFIDENTIAL) {
            if (provider_is_local(route_provider(route)) == 0) {
                var lroute = router_select_local(_router, model_cstr);
                if (lroute == 0) {
                    hlog_warn("dlp: confidential content, no local provider");
                    store64(out + 8, _resp_err("403", "Forbidden",
                        "request blocked: confidential content requires a local provider",
                        "server_error"));
                    return out;
                }
                hlog_info("dlp: confidential content routed to a local provider");
                route = lroute;
            }
        }
    }

    # Response cache: exact-key then semantic (non-streaming only). A hit is a
    # terminal 200 carrying the cached body verbatim.
    var ckey = 0;
    var sem_vec = 0;
    var sem_n = 0;
    if (is_stream == 0) {
        ckey = _cache_key(model_cstr, body_ptr, body_len);
        var cached = cache_get(_cache, ckey);
        if (cached != 0) {
            hlog_info("chat: response cache hit");
            cached = chat_rehead(cached);
            store64(out + 8, _resp_set_header(_resp_new("200", "OK", cached, strlen(cached)),
                "X-Hoosh-Cache: HIT"));
            return out;
        }
        # CONFIDENTIAL content must not be embedded remotely. _chat_prep has
        # just re-routed this request to a LOCAL provider a few lines above and
        # logged "dlp: confidential content routed to a local provider" — but
        # _embed_query_body then handed the SAME raw body to a route chosen by
        # a plain router_select, with no locality constraint and the operator's
        # key attached. The shipped hoosh.cyml suggests text-embedding-3-small,
        # i.e. the remote route, so the leaking configuration was the default
        # one, and README advertises "Confidential forced local".
        #
        # Skipping the embedding costs only a semantic-cache lookup for
        # confidential requests; the exact-key cache above still applies.
        if (semantic_is_enabled() == 1 && dlp_level < CLASS_CONFIDENTIAL) {
            var emb = _embed_query_body(body_ptr, body_len);
            if (emb != 0) {
                sem_vec = load64(emb);
                sem_n = load64(emb + 8);
                var skey = semantic_find_model(sem_vec, sem_n, _sem_scope(model_cstr));
                if (skey != 0) {
                    var scached = cache_get(_cache, skey);
                    if (scached != 0) {
                        hlog_info("chat: semantic cache hit");
                        scached = chat_rehead(scached);
                        store64(out + 8,
                          _resp_set_header(_resp_new("200", "OK", scached, strlen(scached)),
                            "X-Hoosh-Cache: SEMANTIC"));
                        return out;
                    }
                }
            }
        }
    }

    # Rate limit
    var rl = route_rate_limiter(route);
    if (hoosh_ratelimit_check(rl) == 0) {
        event_rate_limited(provider_name(route_provider(route)));
        store64(out + 8, _resp_err("429", "Too Many Requests", "provider rate limit exceeded", "server_error"));
        return out;
    }

    # Token budget: reserve before inference
    var pool_name = "default";
    var pool_str = json_get(pairs, str_from("pool"));
    if (pool_str != 0) { pool_name = to_cstr(pool_str); }
    # 2.5.2: per-provider output clamp. A route may cap what any one request can
    # ask for, so an over-limit request is trimmed rather than refused.
    var mt_limit = route_max_tokens_limit(route);
    if (mt_limit > 0 && g_maxt > mt_limit) {
        hlog_warn("chat: max_tokens clamped to the provider limit");
        g_maxt = mt_limit;
    }

    # The budget reservation follows the request's own output cap when it set
    # one. g_maxt comes from the raw scan, so — unlike the pre-2.5.2
    # json_get — it is actually found when the client puts max_tokens after
    # `messages`, which is where OpenAI clients put it.
    var est_tokens = 2048;
    if (g_maxt > 0) { est_tokens = g_maxt; }
    # Include the PROMPT side in the reservation. est_tokens is the client's own
    # output cap, but the charge in _chat_assemble is prompt + completion — so
    # {"max_tokens": 1} was admitted whenever the pool had a single token free
    # and could still be charged a quarter-million prompt tokens, taking the
    # pool far negative in one request. Against the shipped default capacity a
    # single request could exceed the whole cap.
    #
    # chars_per_token_x10 is the same estimator compaction uses a few lines
    # below, so the two agree on what a prompt costs.
    var est_prompt = 0;
    if (body_len > 0) {
        est_prompt = estimate_tokens(body_ptr, body_len, chars_per_token_x10(route_provider(route)));
    }
    est_tokens = est_tokens + est_prompt;

    # 2.5.0 extended thinking + 2.5.2 sampling, carried on the per-request prep
    # struct (out + 104) — hoosh is multi-threaded, so a global would race.
    # Absent/unknown values leave the request byte-identical to before.
    store64(out + 104, genopts_new(
        _req_reasoning_effort(body_ptr, body_len), g_maxt, g_temp, g_topp));
    var bpool = budget_get_pool(_budget, pool_name);
    # 2.5.8: an unknown pool is a 400, not a silent pass. Previously a request
    # naming a pool that does not exist got bpool == 0 and skipped budgeting
    # entirely — so `"pool": "typo"` was a way to bypass the token budget, and a
    # renamed pool silently stopped being enforced instead of failing loudly.
    if (bpool == 0) {
        store64(out + 8, _resp_err("400", "Bad Request",
            _pool_err(pool_name), "invalid_request_error"));
        return out;
    }
    if (pool_available(bpool) < est_tokens) {
        store64(out + 8, _resp_err("429", "Too Many Requests", "token budget exceeded", "server_error"));
        return out;
    }
    pool_reserve(bpool, est_tokens);

    # Extract messages + optional compression + compaction
    var msgs = _extract_messages(body_ptr, body_len);
    var msg_raw = 0;
    var msg_raw_len = 0;
    if (msgs != 0) {
        msg_raw = load64(msgs);
        msg_raw_len = load64(msgs + 8);
        if (msg_raw_len > 0 && compression_is_enabled() == 1) {
            var compressed = compress_ws_json(msg_raw, msg_raw_len);
            msg_raw = load64(compressed);
            msg_raw_len = load64(compressed + 8);
            var pruned = prune_tool_pairs(msg_raw, msg_raw_len);
            msg_raw = load64(pruned);
            msg_raw_len = load64(pruned + 8);
        }
        if (msg_raw_len > 0 && context_is_enabled() == 1) {
            var cpt_x10 = chars_per_token_x10(route_provider(route));
            # 2.5.7: the compaction budget now derives from the MODEL's context
            # window x [context] compaction_threshold, which is what the knob is
            # for. The old `est_tokens * 2` was a heuristic off the requested
            # output size — unrelated to how much input the model can accept, so
            # a large-context model was compacted as aggressively as a small one.
            # Unknown models keep the old heuristic rather than an invented limit.
            var mmeta = alloc(40);
            var token_limit = est_tokens * 2;
            if (metadata_lookup(model_cstr, mmeta) == 1) {
                var derived = context_token_limit(load64(mmeta));
                if (derived > 0) { token_limit = derived; }
            }
            var compacted = compact_messages(msg_raw, msg_raw_len, token_limit, cpt_x10);
            msg_raw = load64(compacted);
            msg_raw_len = load64(compacted + 8);
        }
    }

    var prompt_cstr = "hello";
    if (msg_raw == 0) {
        var prompt_val = json_get(pairs, str_from("prompt"));
        if (prompt_val != 0) { prompt_cstr = to_cstr(prompt_val); }
    }

    var tools = _extract_tools(body_ptr, body_len);
    var tools_raw = 0;
    var tools_len = 0;
    if (tools != 0) {
        tools_raw = load64(tools);
        tools_len = load64(tools + 8);
    }

    store64(out, 1);
    store64(out + 8, route);
    store64(out + 16, model_cstr);
    store64(out + 24, msg_raw);
    store64(out + 32, msg_raw_len);
    store64(out + 40, tools_raw);
    store64(out + 48, tools_len);
    store64(out + 56, bpool);
    store64(out + 64, est_tokens);
    store64(out + 72, prompt_cstr);
    store64(out + 80, ckey);
    store64(out + 88, sem_vec);
    store64(out + 96, sem_n);
    return out;
}

# Global chat bookkeeping lock. Held by batch workers around the shared-state
# sections (prep + assemble) so the network forward in between runs concurrently
# — that overlap is the batching throughput win. Initialized in cmd_serve
# (mutex_new); the single-threaded accept path never contends it because the
# batch handler joins all workers before the accept loop resumes, so workers are
# the only concurrent actors. Uncontended elsewhere.
var _chat_lock = 0;

# Forward a prepared (ready) request to its provider. Pure network I/O +
# response parsing — NO shared chat state is mutated here (metrics_record, the
# one global it touches, is atomic), so this runs unlocked/concurrent.
fn _chat_forward(prep) {
    var route = load64(prep + 8);
    var model_cstr = load64(prep + 16);
    var msg_raw = load64(prep + 24);
    var msg_raw_len = load64(prep + 32);
    var tools_raw = load64(prep + 40);
    var tools_len = load64(prep + 48);
    var prompt_cstr = load64(prep + 72);
    return retry_forward(
      _retry_cfg, route, model_cstr, prompt_cstr, msg_raw, msg_raw_len,
      tools_raw, tools_len, load64(prep + 104));
}

# Build the response descriptor from a forward result. Mutates shared state
# (budget commit, audit append, response/semantic cache insert), so batch
# workers must hold _chat_lock around this call.
fn _chat_assemble(prep, result) {
    var route = load64(prep + 8);
    var model_cstr = load64(prep + 16);
    var bpool = load64(prep + 56);
    var est_tokens = load64(prep + 64);
    var ckey = load64(prep + 80);
    var sem_vec = load64(prep + 88);
    var sem_n = load64(prep + 96);

    if (result == 0) {
        if (bpool != 0) { pool_commit(bpool, est_tokens, 0); }
        # 2.6.5: "unreachable" was wrong for the common case. A 400 or a 404 means the provider was
        # reached and REFUSED — a different problem with a different fix, and telling an operator their
        # backend is down when it answered instantly sends them to the wrong place.
        hlog_error(provider_err_log_line());
        # 2.5.7: failures belong in the audit chain too. Recording only the
        # successes made the chain a record of what worked, which is the less
        # interesting half when reconstructing an incident.
        if (_audit_chain != 0) {
            audit_record(_audit_chain, "inference.error",
              "error", "provider backend unreachable",
              provider_name(route_provider(route)), model_cstr);
        }
        event_inference_failed(provider_name(route_provider(route)), model_cstr, "backend unreachable");
        otlp_enqueue_inference_span(provider_name(route_provider(route)), model_cstr, 0, 0, 0);
        if (provider_last_error_status() > 0) {
            return _resp_err("502", "Bad Gateway", provider_err_client_msg(), "upstream_error");
        }
        return _resp_err("502", "Bad Gateway", "provider backend unreachable", "server_error");
    }

    var resp_text = load64(result);
    var resp_ptok = load64(result + 16);
    var resp_ctok = load64(result + 24);
    var resp_tool_calls = load64(result + 32);

    if (bpool != 0) {
        pool_commit(bpool, est_tokens, resp_ptok + resp_ctok);
    }

    # 2.5.6: accumulate per-provider spend. Runs under _chat_lock (held by every
    # caller of _chat_assemble), which is what makes the shared record vec safe
    # across the pool workers.
    # 2.5.12: cost_record returns what it accumulated, so the figure reported in
    # the response body is the SAME VALUE rather than a second computation that
    # merely ought to agree. A consumer summing per-response costs reconciles
    # with /v1/costs by construction.
    var route_prov = route_provider(route);
    var resp_cost_micro = cost_record(route_prov, route_base_url(route),
      resp_ptok, resp_ctok, model_cstr);

    if (_audit_chain != 0) {
        audit_record(_audit_chain, "inference.request",
          "info", "inference completed",
          provider_name(route_provider(route)), model_cstr);
    }

    var body = _chat_completion_body(model_cstr, resp_text, resp_ptok,
      resp_ctok, resp_tool_calls, resp_cost_micro, provider_name(route_prov));
    var body_cstr = to_cstr(body);
    var body_clen = str_len(body);
    if (ckey != 0) { cache_insert(_cache, ckey, body_cstr); }
    if (ckey != 0 && sem_vec != 0) { semantic_insert_model(ckey, sem_vec, sem_n, _sem_scope(model_cstr)); }
    # MISS: this response was produced by a real forward, not replayed. A later
    # hit on it replays the body verbatim — including this cost — which is why
    # the header, not the body, is what a consumer must bill on.
    return _resp_set_header(_resp_new("200", "OK", body_cstr, body_clen),
      "X-Hoosh-Cache: MISS");
}

# Forward a prepared request and build its descriptor (single-threaded path).
fn _chat_finish(prep) {
    return _chat_assemble(prep, _chat_forward(prep));
}

# Produce a non-streaming chat response descriptor end-to-end, holding
# _chat_lock around the shared-state phases (prep, assemble) and releasing it
# for the network forward. Batch workers call this from their own threads; the
# concurrency lives entirely in the unlocked forward.
fn _chat_produce(body_ptr, body_len) {
    mutex_lock(_chat_lock);
    var prep = _chat_prep(body_ptr, body_len, 0);
    var kind = load64(prep);
    mutex_unlock(_chat_lock);
    if (kind == 0) { return load64(prep + 8); }

    var result = _chat_forward(prep);

    mutex_lock(_chat_lock);
    var desc = _chat_assemble(prep, result);
    mutex_unlock(_chat_lock);
    return desc;
}

# Accept-thread chat handler. Holds _chat_lock around the shared-state phases
# (prep, assemble/commit) exactly like a batch worker, so a /v1/chat/completions
# served on the accept loop is safe while a background async batch's workers run
# concurrently. The network forward / SSE stream runs unlocked. Uncontended when
# no batch is in flight.
fn handle_chat(cfd, body_ptr, body_len) {
    var is_stream = _req_is_stream(body_ptr, body_len);
    mutex_lock(_chat_lock);
    var prep = _chat_prep(body_ptr, body_len, is_stream);
    var kind = load64(prep);
    mutex_unlock(_chat_lock);
    if (kind == 0) {
        return _resp_write(cfd, load64(prep + 8));
    }

    if (is_stream == 1) {
        var route = load64(prep + 8);
        var model_cstr = load64(prep + 16);
        var msg_raw = load64(prep + 24);
        var msg_raw_len = load64(prep + 32);
        var tools_raw = load64(prep + 40);
        var tools_len = load64(prep + 48);
        var bpool = load64(prep + 56);
        var est_tokens = load64(prep + 64);
        if (msg_raw == 0) {
            if (bpool != 0) {
                mutex_lock(_chat_lock);
                pool_commit(bpool, est_tokens, 0);
                mutex_unlock(_chat_lock);
            }
            return http_bad_request(cfd, "streaming requires messages array");
        }
        var sr = handle_chat_stream(
          cfd, route, model_cstr, msg_raw, msg_raw_len, tools_raw, tools_len, load64(prep + 104));
        # Meter the stream. This committed 0, so the reservation was purely
        # transient, POOL_USED never grew, /v1/tokens/pools reported used: 0
        # forever, and cost_record was never reached — the streaming branch does
        # not go through _chat_assemble. Streaming is the default in every real
        # client, so in practice most traffic was entirely unbilled and no
        # budget could ever be exhausted by it.
        #
        # Committing est_tokens converts the reservation this request already
        # made into usage, which is the conservative reading when the provider's
        # own counts are not available on this path. Decoding real usage
        # (OpenAI stream_options.include_usage, Anthropic message_delta.usage)
        # is the follow-up; charging the reservation is strictly better than
        # charging nothing, and never exceeds what admission already approved.
        if (bpool != 0) {
            mutex_lock(_chat_lock);
            pool_commit(bpool, est_tokens, est_tokens);
            mutex_unlock(_chat_lock);
        }
        cost_record(route_provider(route), route_base_url(route), 0, est_tokens, model_cstr);
        metrics_record(0, est_tokens);
        return sr;
    }

    var result = _chat_forward(prep);
    mutex_lock(_chat_lock);
    var desc = _chat_assemble(prep, result);
    mutex_unlock(_chat_lock);
    return _resp_write(cfd, desc);
}
