# wq.cyr — the worker pool's work queue and its job constructors (split out of pool.cyr in 2.9.20).
#
# The accept loop pushes one JOB_CONN per connection, batch.cyr one JOB_BATCH_ITEM per item, the OTLP exporter a
# JOB_OTLP_EXPORT, and catalog_fetch.cyr its own JOB_CATALOG_REFRESH (3); pool.cyr's workers pop them and job_process
# dispatches on the type word. Nothing here touches a socket or a handler, so tests/hoosh.tcyr includes this file
# and runs the real ring: through 2.9.19 it tested a copy of the ring arithmetic, without the lock or wq_done.
#
# Requires: alloc, store64/load64, mutex_new/mutex_lock/mutex_unlock (lib/sync.cyr), sleep_ms (lib/chrono.cyr),
# str_builder (wq_status_json), trace.cyr and reqmem.cyr (job_begin, 2.10.3).

var JOB_CONN = 0;
var JOB_BATCH_ITEM = 1;
var JOB_OTLP_EXPORT = 2;

# ── Work queue: a bounded ring of job pointers + mutex. wq_pop is non-blocking
# (returns 0 when empty) so workers + the sync-batch barrier can work-steal. ──
var WQ_MAX = 8192;
var _wq_ring = 0;
var _wq_head = 0;       # pop cursor
var _wq_count = 0;
var _wq_busy = 0;      # jobs popped and currently being served (2.5.8)
var _wq_lock = 0;

# Outstanding work: still queued PLUS already popped and being served. The
# shutdown drain (2.5.8) waits on this — queue depth alone misses every request
# a worker is currently answering.
fn wq_outstanding() {
    mutex_lock(_wq_lock);
    var n = _wq_count + _wq_busy;
    mutex_unlock(_wq_lock);
    return n;
}

# Size the ring from WQ_MAX and start it empty. pool_start calls this once, before any worker exists.
fn wq_init() {
    _wq_ring = alloc(WQ_MAX * 8);
    _wq_head = 0;
    _wq_count = 0;
    _wq_busy = 0;
    _wq_lock = mutex_new();
    return 0;
}

# Enqueue a job if the ring has room. Returns 1 when queued, 0 when full.
fn wq_try_push(job) {
    mutex_lock(_wq_lock);
    if (_wq_count < WQ_MAX) {
        store64(_wq_ring + ((_wq_head + _wq_count) % WQ_MAX) * 8, job);
        _wq_count = _wq_count + 1;
        mutex_unlock(_wq_lock);
        return 1;
    }
    mutex_unlock(_wq_lock);
    return 0;
}

# Enqueue a job. Backpressure (sleep) when the ring is full — the accept loop
# slows rather than dropping connections.
fn wq_push(job) {
    while (wq_try_push(job) == 0) { sleep_ms(1); }
    return 0;
}

# Non-blocking pop. Returns 0 when empty.
fn wq_pop() {
    mutex_lock(_wq_lock);
    if (_wq_count == 0) {
        mutex_unlock(_wq_lock);
        return 0;
    }
    var job = load64(_wq_ring + (_wq_head % WQ_MAX) * 8);
    _wq_head = (_wq_head + 1) % WQ_MAX;
    _wq_count = _wq_count - 1;
    # Hand off from "queued" to "in flight" under the SAME lock acquisition, so
    # the pair is atomic and the hot path pays no extra lock. wq_done() clears
    # it when the job finishes.
    _wq_busy = _wq_busy + 1;
    mutex_unlock(_wq_lock);
    return job;
}

# Mark a popped job finished. Pairs with the increment inside wq_pop.
fn wq_done() {
    mutex_lock(_wq_lock);
    _wq_busy = _wq_busy - 1;
    mutex_unlock(_wq_lock);
    return 0;
}

# A serial thread backend (THREADS_CONCURRENT = 0, AGNOS today): thread_create runs its body inline, so a body
# that loops forever never returns to its caller, and hoosh, which logs that it is serving before any of this,
# never reached sock_accept. So on such a target no forever-thread starts, no worker exists, and the accept loop
# is the one thread there is: it runs each job itself. Requests are served one at a time, a batch still drains
# through its own work-stealing barrier, and nothing runs on a timer: pool_start says so. `process` is
# job_process, since this file touches no handler. Returns 1 when a job ran, and is a no-op with real workers.
fn wq_serial_turn(process) {
    if (THREADS_CONCURRENT != 0) { return 0; }
    var job = wq_pop();
    if (job == 0) { return 0; }
    fncall1(process, job);
    wq_done();
    return 1;
}

# GET /v1/queue/status's body (2.9.26): the queue's real depth, both counts read under one lock. `queued` is
# rust-old's key and `pending` the port's 2.x key, for the same count: jobs waiting for a worker. `processing` is
# the jobs workers are serving, so the request that asks is one of them. Through 2.9.25 the endpoint answered a
# constant {"pending":0,"processing":0}.
fn wq_status_json() {
    var q = 0;
    var b = 0;
    if (_wq_lock != 0) {
        mutex_lock(_wq_lock);
        q = _wq_count;
        b = _wq_busy;
        mutex_unlock(_wq_lock);
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"queued\":");
    str_builder_add_int(sb, q);
    str_builder_add_cstr(sb, ",\"pending\":");
    str_builder_add_int(sb, q);
    str_builder_add_cstr(sb, ",\"processing\":");
    str_builder_add_int(sb, b);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# ── Job constructors ──
fn _job_conn(cfd) {
    var j = alloc(16);
    store64(j, JOB_CONN);
    store64(j + 8, cfd);
    return j;
}

# A batch item: [type, req_ptr, req_len, result_slot, completed_ctr, failed_ctr, trace_in].
# completed_ctr / failed_ctr are absolute addresses of atomic counters (the batch
# barrier reads completed_ctr; failed_ctr may be 0 to skip failure accounting).
# trace_in (2.10.3) is the submitting request's inbound traceparent, a copy the batch owns
# (trace_inbound_copy), or 0: the item's span is a child of the caller's span, or a root.
fn job_batch_item(req_ptr, req_len, slot, completed_ctr, failed_ctr, trace_in) {
    var j = alloc(56);
    store64(j, JOB_BATCH_ITEM);
    store64(j + 8, req_ptr);
    store64(j + 16, req_len);
    store64(j + 24, slot);
    store64(j + 32, completed_ctr);
    store64(j + 40, failed_ctr);
    store64(j + 48, trace_in);
    return j;
}

# 2.10.3: begin a job's own trace context, before job_process runs it. A worker's slots held its last connection's,
# so through 2.10.2 a batch item, a catalog refresh and an OTLP export went out under some unrelated request's trace.
# A batch item continues the request that submitted it, as a span of its own; every other job begins as a root, and
# a connection's is then begun again by http_route, from its header.
fn job_trace_begin(job) {
    if (load64(job) == JOB_BATCH_ITEM) { return trace_begin_from(load64(job + 48)); }
    return trace_begin_from(0);
}

# 2.10.3: what every job does before job_process runs it: its own trace context, and the thread's request arena
# released (reqmem.cyr). Whatever the thread's last job built there is dead: what it handed a keeper was copied.
# A sync batch's barrier runs jobs on the submitting thread, so the batch handler holds nothing in the arena.
fn job_begin(job) {
    job_trace_begin(job);
    req_arena_begin();
    return 0;
}

# An OTLP/JSON export POST: [type, doc_ptr, doc_len]. The exporter thread
# enqueues this for an https collector so a worker does the TLS (through 2.9.0
# only a worker could; see pool.cyr's header).
fn job_otlp_export(doc_ptr, doc_len) {
    var j = alloc(24);
    store64(j, JOB_OTLP_EXPORT);
    store64(j + 8, doc_ptr);
    store64(j + 16, doc_len);
    return j;
}
