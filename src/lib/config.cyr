# config.cyr — TOML configuration loader for hoosh.cyml
# Requires: types.cyr, route.cyr, router.cyr, budget.cyr, cache.cyr, metrics.cyr, cfgparse.cyr (its
#           self-contained helpers since 2.9.18)
# Reads: [[server]], [[providers]], [[cache]], [[budgets]], [[auth]]

var _route_strategy = 0;   # STRAT_PRIORITY

# One [[models]] block -> a CATSRC_CONFIG catalog entry, or 0 (refused, with a warning). Keys:
#   id = "claude-opus-5-5"          required; the id a client sends
#   input_per_mtok = "4.00"         USD per million input tokens (a string or a bare number)
#   output_per_mtok = "20.00"       both, or neither — a half-priced model is unpriced, never billed $0 on one side
#   context = 1000000               context window (input tokens)
#   max_output = 128000             output ceiling
#   tier = "premium"                economy | standard | premium | reasoning (for /v1/cost/recommend)
#   vision = true
#   tools = false                   whether it takes tools (2.10.2), for the catalog and /v1/cost/recommend
#   kind = "chat"                   chat | embedding | other (2.10.2), for a model nothing else can tell apart
#   reasoning = true                an OpenAI-compatible model that takes reasoning_effort (forwarded only then)
#   listed = false                  known for lookups, not offered by /v1/models/catalog
fn _config_model(mp) {
    var mid = bayan_toml_get_by_cstr(mp, "id");
    if (mid == 0) {
        hlog_warn("config: a [[models]] block has no id — ignored");
        return 0;
    }
    var idc = to_cstr(mid);
    if (catalog_id_ok(idc) == 0) {
        hlog_warn("config: a [[models]] id holds a space, quote, backslash or non-printable byte — ignored");
        return 0;
    }
    var e = catalog_entry_new(idc, CATSRC_CONFIG);
    var ip = bayan_toml_get_by_cstr(mp, "input_per_mtok");
    var op = bayan_toml_get_by_cstr(mp, "output_per_mtok");
    if (ip != 0 && op != 0) {
        var ipv = catalog_usd_per_mtok_scaled(to_cstr(ip));
        var opv = catalog_usd_per_mtok_scaled(to_cstr(op));
        if (ipv >= 0 && opv >= 0) {
            store64(e + CAT_E_IN_PRICE, ipv);
            store64(e + CAT_E_OUT_PRICE, opv);
        } else {
            hlog_warn("config: a [[models]] price is not a plain decimal (USD per million tokens): unpriced");
        }
    } elif (ip != 0 || op != 0) {
        hlog_warn("config: a [[models]] block sets only one of input_per_mtok / output_per_mtok: unpriced");
    }
    var cx = bayan_toml_get_by_cstr(mp, "context");
    if (cx != 0) { store64(e + CAT_E_CTX, str_to_int(cx)); }
    var mo = bayan_toml_get_by_cstr(mp, "max_output");
    if (mo != 0) { store64(e + CAT_E_MAXOUT, str_to_int(mo)); }
    var vi = bayan_toml_get_by_cstr(mp, "vision");
    if (vi != 0) {
        if (str_eq_cstr(vi, "true") == 1) { store64(e + CAT_E_VISION, 1); }
        if (str_eq_cstr(vi, "false") == 1) { store64(e + CAT_E_VISION, 0); }
    }
    var ti = bayan_toml_get_by_cstr(mp, "tier");
    if (ti != 0) {
        if (str_eq_cstr(ti, "economy") == 1) { store64(e + CAT_E_TIER, TIER_ECONOMY); }
        if (str_eq_cstr(ti, "standard") == 1) { store64(e + CAT_E_TIER, TIER_STANDARD); }
        if (str_eq_cstr(ti, "premium") == 1) { store64(e + CAT_E_TIER, TIER_PREMIUM); }
        if (str_eq_cstr(ti, "reasoning") == 1) { store64(e + CAT_E_TIER, TIER_REASONING); }
    }
    var to = bayan_toml_get_by_cstr(mp, "tools");
    if (to != 0) {
        if (str_eq_cstr(to, "true") == 1) { store64(e + CAT_E_TOOLS, 1); }
        if (str_eq_cstr(to, "false") == 1) { store64(e + CAT_E_TOOLS, 0); }
    }
    var ki = bayan_toml_get_by_cstr(mp, "kind");
    if (ki != 0) {
        if (str_eq_cstr(ki, "chat") == 1) { store64(e + CAT_E_KIND, CAT_KIND_CHAT); }
        elif (str_eq_cstr(ki, "embedding") == 1) { store64(e + CAT_E_KIND, CAT_KIND_EMBEDDING); }
        elif (str_eq_cstr(ki, "other") == 1) { store64(e + CAT_E_KIND, CAT_KIND_OTHER); }
        else { hlog_warn("config: a [[models]] kind is not chat, embedding or other: ignored"); }
    }
    var re = bayan_toml_get_by_cstr(mp, "reasoning");
    if (re != 0) {
        if (str_eq_cstr(re, "true") == 1) { store64(e + CAT_E_REASON, 1); }
        if (str_eq_cstr(re, "false") == 1) { store64(e + CAT_E_REASON, 0); }
    }
    var li = bayan_toml_get_by_cstr(mp, "listed");
    if (li != 0) {
        if (str_eq_cstr(li, "false") == 1) { store64(e + CAT_E_LISTED, 0); }
    }
    return e;
}

fn _config_models(msecs) {
    var mv = vec_new();
    var mi = 0;
    while (mi < vec_len(msecs)) {
        var e = _config_model(toml_section_pairs(vec_get(msecs, mi)));
        if (e != 0) { vec_push(mv, e); }
        mi = mi + 1;
    }
    catalog_config_set(mv);
    return 0;
}

fn load_config(path) {
    var sections = toml_parse_file(path);
    if (vec_len(sections) == 0) { return 0; }

    # Parse [[server]] section
    var srv_secs = bayan_toml_get_sections_by_cstr(sections, "server");
    if (vec_len(srv_secs) > 0) {
        var srv = toml_section_pairs(vec_get(srv_secs, 0));
        # bind and port apply at startup only: a reload cannot move the listener. 2.9.13: a reload used to rewrite
        # them anyway, which aimed SIGTERM's wake-up connection at the wrong port (see main.cyr _listen_fd).
        var port_str = bayan_toml_get_by_cstr(srv, "port");
        if (port_str != 0 && _listen_fd < 0) { _http_port = str_to_int(port_str); }
        var strat_str = bayan_toml_get_by_cstr(srv, "strategy");
        if (strat_str != 0) { _route_strategy = strategy_from_str(to_cstr(strat_str)); }
        # Listen address. Was parsed by NO ONE before 2.5.1 — hoosh.cyml shipped
        # `bind = "127.0.0.1"` while main.cyr bound INADDR_ANY, so the gateway
        # listened on every interface regardless of what the config claimed.
        # "0.0.0.0" packs to 0 (INADDR_ANY); host_addr also accepts a hostname.
        var bind_str = bayan_toml_get_by_cstr(srv, "bind");
        if (bind_str != 0 && _listen_fd < 0) { _http_bind = host_addr(to_cstr(bind_str)); }
        # 2.5.5: background health-probe cadence. 0 disables probing, which
        # leaves every route optimistically healthy (pre-2.5.5 behavior).
        var hci_str = bayan_toml_get_by_cstr(srv, "health_check_interval_secs");
        if (hci_str != 0) { health_configure(str_to_int(hci_str)); }
    }

    # Parse [storage] section — opt-in patra persistence (path only)
    var stor_secs = bayan_toml_get_sections_by_cstr(sections, "storage");
    if (vec_len(stor_secs) > 0) {
        var sp = toml_section_pairs(vec_get(stor_secs, 0));
        var path_str = bayan_toml_get_by_cstr(sp, "path");
        if (path_str != 0) { _storage_path = to_cstr(path_str); }
    }

    # Parse [logging] section — sets the sakshi operational log level
    var log_secs = bayan_toml_get_sections_by_cstr(sections, "logging");
    if (vec_len(log_secs) > 0) {
        var lp = toml_section_pairs(vec_get(log_secs, 0));
        var lvl_str = bayan_toml_get_by_cstr(lp, "level");
        if (lvl_str != 0) {
            var lvl = hlog_level_from_str(to_cstr(lvl_str));
            if (lvl >= 0) { sakshi_set_level(lvl); }
        }
    }

    # Parse [telemetry] section — OpenTelemetry OTLP/HTTP+JSON export (off by
    # default; enabled when otlp_endpoint is set).
    var tel_secs = bayan_toml_get_sections_by_cstr(sections, "telemetry");
    if (vec_len(tel_secs) > 0) {
        var tp = toml_section_pairs(vec_get(tel_secs, 0));
        var ep_str = bayan_toml_get_by_cstr(tp, "otlp_endpoint");
        if (ep_str != 0) { _otlp_endpoint = to_cstr(ep_str); }
        var svc_str = bayan_toml_get_by_cstr(tp, "service_name");
        if (svc_str != 0) { _otlp_service = to_cstr(svc_str); }
    }

    # Parse [dlp] section — Data Loss Prevention scanner (off by default).
    var dlp_secs = bayan_toml_get_sections_by_cstr(sections, "dlp");
    if (vec_len(dlp_secs) > 0) {
        var dp = toml_section_pairs(vec_get(dlp_secs, 0));
        var den_str = bayan_toml_get_by_cstr(dp, "enabled");
        var dlvl_str = bayan_toml_get_by_cstr(dp, "default_level");
        var den = 0;
        if (den_str != 0) {
            if (str_eq_cstr(den_str, "true") == 1) { den = 1; }
        }
        var dlvl = CLASS_PUBLIC;
        if (dlvl_str != 0) {
            var parsed = dlp_class_from_str(to_cstr(dlvl_str));
            if (parsed >= 0) { dlvl = parsed; }
        }
        dlp_configure(den, dlvl);
    }

    # Parse [[dlp_pattern]] sections (2.5.10) — caller-supplied patterns beyond
    # the eight built-ins: name + literal pattern + classification level.
    dlp_custom_clear();
    var dpat_secs = bayan_toml_get_sections_by_cstr(sections, "dlp_pattern");
    var dpi = 0;
    while (dpi < vec_len(dpat_secs)) {
        var dpp = toml_section_pairs(vec_get(dpat_secs, dpi));
        var dp_name = bayan_toml_get_by_cstr(dpp, "name");
        var dp_pat = bayan_toml_get_by_cstr(dpp, "pattern");
        var dp_lvl_str = bayan_toml_get_by_cstr(dpp, "level");
        if (dp_pat != 0) {
            var dp_lvl = CLASS_CONFIDENTIAL;
            if (dp_lvl_str != 0) {
                var parsed_l = dlp_class_from_str(to_cstr(dp_lvl_str));
                if (parsed_l >= 0) { dp_lvl = parsed_l; }
            }
            var dp_nm = "custom";
            if (dp_name != 0) { dp_nm = to_cstr(dp_name); }
            dlp_custom_add(dp_nm, to_cstr(dp_pat), dp_lvl);
        }
        dpi = dpi + 1;
    }

    # Parse [semantic_cache] section — embedding-similarity cache (off by default).
    var sem_secs = bayan_toml_get_sections_by_cstr(sections, "semantic_cache");
    if (vec_len(sem_secs) > 0) {
        var sp = toml_section_pairs(vec_get(sem_secs, 0));
        var sen_str = bayan_toml_get_by_cstr(sp, "enabled");
        var sen = 0;
        if (sen_str != 0) {
            if (str_eq_cstr(sen_str, "true") == 1) { sen = 1; }
        }
        var sthr = 850;
        var sthr_str = bayan_toml_get_by_cstr(sp, "threshold");
        if (sthr_str != 0) {
            var ts = to_cstr(sthr_str);
            var fr = _sem_parse_num(ts, 0, strlen(ts));
            sthr = load64(fr) / 10;
        }
        var smodel = 0;
        var smodel_str = bayan_toml_get_by_cstr(sp, "embedding_model");
        if (smodel_str != 0) { smodel = to_cstr(smodel_str); }
        var smax = 0;
        var smax_str = bayan_toml_get_by_cstr(sp, "max_search");
        if (smax_str != 0) { smax = str_to_int(smax_str); }
        semantic_configure(sen, sthr, smodel, smax);
    }

    # Parse [compression] section — prompt whitespace compression (off by default).
    var comp_secs = bayan_toml_get_sections_by_cstr(sections, "compression");
    if (vec_len(comp_secs) > 0) {
        var cmp = toml_section_pairs(vec_get(comp_secs, 0));
        var cmp_en_str = bayan_toml_get_by_cstr(cmp, "enabled");
        var cmp_en = 0;
        if (cmp_en_str != 0) {
            if (str_eq_cstr(cmp_en_str, "true") == 1) { cmp_en = 1; }
        }
        compression_configure(cmp_en);
    }

    # Parse [[warming]] sections — cache warming prompts (model + prompt).
    var warm_secs = bayan_toml_get_sections_by_cstr(sections, "warming");
    var wi = 0;
    while (wi < vec_len(warm_secs)) {
        var wp = toml_section_pairs(vec_get(warm_secs, wi));
        var wmodel = bayan_toml_get_by_cstr(wp, "model");
        var wprompt = bayan_toml_get_by_cstr(wp, "prompt");
        if (wmodel != 0 && wprompt != 0) {
            warming_add(to_cstr(wmodel), to_cstr(wprompt));
        }
        wi = wi + 1;
    }

    # Parse [[cache]] section
    var cache_secs = bayan_toml_get_sections_by_cstr(sections, "cache");
    if (vec_len(cache_secs) > 0) {
        var cache_p = toml_section_pairs(vec_get(cache_secs, 0));
        var max_str = bayan_toml_get_by_cstr(cache_p, "max_entries");
        var enabled_str = bayan_toml_get_by_cstr(cache_p, "enabled");
        var max_e = 10000;
        var enabled = 1;
        if (max_str != 0) { max_e = str_to_int(max_str); }
        if (enabled_str != 0) {
            if (str_eq_cstr(enabled_str, "false") == 1) { enabled = 0; }
        }
        # 2.5.4: ttl_secs is finally READ. hoosh.cyml has shipped `ttl_secs =
        # 300` since the port while nothing parsed it, so cached responses never
        # expired. 0 (or a negative) disables expiry explicitly.
        var ttl_secs = 300;
        var ttl_str = bayan_toml_get_by_cstr(cache_p, "ttl_secs");
        if (ttl_str != 0) { ttl_secs = str_to_int(ttl_str); }
        _cache = cache_new(max_e, enabled, ttl_secs);
    }

    # Parse [[providers]] sections
    var prov_secs = bayan_toml_get_sections_by_cstr(sections, "providers");
    var route_count = vec_len(prov_secs);
    var tentib_loaded = 0;      # 2.11.0: tentib holds one model per process: the first route whose model loads serves
    if (route_count > 0) {
        var routes = alloc(route_count * 8);
        var ri = 0;
        while (ri < route_count) {
            var pp = toml_section_pairs(vec_get(prov_secs, ri));
            var ptype_str = bayan_toml_get_by_cstr(pp, "type");
            var purl_str = bayan_toml_get_by_cstr(pp, "base_url");
            var ppri_str = bayan_toml_get_by_cstr(pp, "priority");

            var ptype = PROV_OLLAMA;
            if (ptype_str != 0) { ptype = provider_parse(to_cstr(ptype_str)); }
            var purl = provider_default_url(ptype);
            if (purl_str != 0) { purl = to_cstr(purl_str); }
            var ppri = 1;
            if (ppri_str != 0) { ppri = str_to_int(ppri_str); }

            var route = route_new(ptype, ppri, purl);

            # 2.5.5: `enabled = false` takes a route out of selection without
            # deleting it (rust-old config.rs:272). route_enabled was already
            # honored by the router; nothing ever set it from config.
            var pen_str = bayan_toml_get_by_cstr(pp, "enabled");
            if (pen_str != 0) {
                if (str_eq_cstr(pen_str, "false") == 1) { route_set_enabled(route, 0); }
            }

            # Parse API key — "$NAME" expands from the environment so the
            # secret stays out of hoosh.cyml.
            var apikey_str = bayan_toml_get_by_cstr(pp, "api_key");
            if (apikey_str != 0) {
                var apikey = _config_expand_env(to_cstr(apikey_str));
                if (apikey != 0) {
                    store64(route + ROUTE_API_KEY, apikey);
                }
            }

            # Parse rate limit (RPM): cfgparse.cyr's _config_rate_limit_str (2.9.18).
            var rpm_str = _config_rate_limit_str(pp);
            if (rpm_str != 0) {
                route_set_rate_limit(route, str_to_int(rpm_str));
            }

            var tpol = _config_tls_policy(pp, purl);
            if (tpol < 0) { return 0; }
            store64(route + ROUTE_TLS_POLICY, tpol);

            # Per-provider output cap (2.5.2) — a request asking for more
            # max_tokens than this is clamped down to it, with a warn log.
            var mtl_str = bayan_toml_get_by_cstr(pp, "max_tokens_limit");
            if (mtl_str != 0) {
                route_set_max_tokens_limit(route, str_to_int(mtl_str));
            }

            # 2.8.0: catalog = "live" (ask the provider for its models) | "static" (offer the compiled table's).
            var pcat_str = bayan_toml_get_by_cstr(pp, "catalog");
            if (pcat_str != 0) {
                if (str_eq_cstr(pcat_str, "static") == 1) { route_set_catalog_live(route, 0); }
                elif (str_eq_cstr(pcat_str, "live") == 1) { route_set_catalog_live(route, 1); }
                else { hlog_warn("config: [[providers]] catalog must be \"live\" or \"static\" (default kept)"); }
            }

            # 2.11.0: a tentib route serves a packed ternary model in this process (tentib_local.cyr, ADR 014).
            # `model_file` names it; it is read here, at startup and on every reload, and loaded when it is not the
            # model already serving. A route whose model does not load is disabled, and so is every tentib route
            # after the first that loaded, with the reason in the log.
            if (ptype == PROV_TENTIB) {
                route_set_catalog_live(route, 0);        # no provider to ask: its patterns are its list
                var mf_str = bayan_toml_get_by_cstr(pp, "model_file");
                if (mf_str == 0) {
                    hlog_error("config: a tentib provider needs model_file; route disabled");
                    route_set_enabled(route, 0);
                } elif (tentib_loaded == 1) {
                    hlog_error("config: only one tentib provider can be served per process; route disabled");
                    route_set_enabled(route, 0);
                } else {
                    var mf = to_cstr(mf_str);
                    store64(route + ROUTE_BASE_URL, mf);
                    var trc = tnt_load(mf);
                    if (trc == 0) {
                        tentib_loaded = 1;
                        # A model of a new shape keeps its memory for the life of the process; one of the shape
                        # serving reuses that model's (ADR 014). Say which, how much, and whether the file declares
                        # the byte vocabulary or it is assumed. Two lines: the logger cuts a line at 256 bytes, and
                        # the path's length is the operator's.
                        var lsb = str_builder_new();
                        str_builder_add_cstr(lsb, "config: tentib model loaded: ");
                        str_builder_add_cstr(lsb, mf);
                        hlog_info(to_cstr(str_builder_build(lsb)));
                        var msb = str_builder_new();
                        str_builder_add_cstr(msb, "config: tentib model: context ");
                        str_builder_add_int(msb, tnt_context());
                        if (tnt_vocab_declared() == 1) {
                            str_builder_add_cstr(msb, " tokens, byte vocabulary declared, ");
                        } else {
                            str_builder_add_cstr(msb, " tokens, byte vocabulary assumed, ");
                        }
                        str_builder_add_int(msb, tnt_model_bytes());
                        if (tnt_load_reused() == 1) {
                            str_builder_add_cstr(msb, " bytes of model memory (the replaced model's, reused)");
                        } else {
                            str_builder_add_cstr(msb, " bytes of model memory (new)");
                        }
                        hlog_info(to_cstr(str_builder_build(msb)));
                    } elif (trc == TNT_UNCHANGED()) {
                        tentib_loaded = 1;
                        hlog_info("config: tentib model unchanged, not reloaded");
                    } else {
                        var esb = str_builder_new();
                        str_builder_add_cstr(esb, "config: tentib model_file ");
                        str_builder_add_cstr(esb, mf);
                        str_builder_add_cstr(esb, ": ");
                        str_builder_add_cstr(esb, tnt_status_text(trc));
                        str_builder_add_cstr(esb, "; route disabled");
                        hlog_error(to_cstr(str_builder_build(esb)));
                        route_set_enabled(route, 0);
                    }
                }
            }

            # Parse model patterns — TOML array: ["llama*", "mistral*"]
            var models_str = bayan_toml_get_by_cstr(pp, "models");
            if (models_str != 0) {
                var pats = alloc(MAX_MODEL_PATTERNS * 8);
                var pat_count = _config_str_array(pp, "models", pats, MAX_MODEL_PATTERNS);
                if (pat_count > 0) {
                    route_set_patterns(route, pats, pat_count);
                }
            }

            store64(routes + ri * 8, route);
            ri = ri + 1;
        }
        _router = router_new(routes, route_count, _route_strategy);
        _met_providers = route_count;
    }

    # Parse [catalog] (2.8.0) — how often the live model catalog asks the providers again. 0 = only at startup,
    # on a reload and on POST /v1/models/refresh.
    var cats_secs = bayan_toml_get_sections_by_cstr(sections, "catalog");
    if (vec_len(cats_secs) > 0) {
        var catp = toml_section_pairs(vec_get(cats_secs, 0));
        var crs_str = bayan_toml_get_by_cstr(catp, "refresh_secs");
        if (crs_str != 0) { catalog_configure(str_to_int(crs_str)); }
    }

    # Parse [[models]] (2.8.0) — the operator's own word on a model: its price, context window and tier, and
    # whether the catalog offers it. Replaced whole on every load, so a block deleted before a reload is gone.
    _config_models(bayan_toml_get_sections_by_cstr(sections, "models"));

    # Parse [[budgets]] sections
    var bud_secs = bayan_toml_get_sections_by_cstr(sections, "budgets");
    var bi = 0;
    while (bi < vec_len(bud_secs)) {
        var bp = toml_section_pairs(vec_get(bud_secs, bi));
        var bname = bayan_toml_get_by_cstr(bp, "name");
        var bcap_str = bayan_toml_get_by_cstr(bp, "capacity");
        if (bname != 0) {
            if (bcap_str != 0) {
                budget_add_pool(_budget, pool_new(to_cstr(bname), str_to_int(bcap_str)));
            }
        }
        bi = bi + 1;
    }

    # Parse [[retry]] section
    var retry_secs = bayan_toml_get_sections_by_cstr(sections, "retry");
    if (vec_len(retry_secs) > 0) {
        var rp = toml_section_pairs(vec_get(retry_secs, 0));
        var mr_str = bayan_toml_get_by_cstr(rp, "max_retries");
        var bd_str = bayan_toml_get_by_cstr(rp, "base_delay_ms");
        var md_str = bayan_toml_get_by_cstr(rp, "max_delay_ms");
        var mr = 3;
        var bd = 500;
        var md = 30000;
        if (mr_str != 0) { mr = str_to_int(mr_str); }
        if (bd_str != 0) { bd = str_to_int(bd_str); }
        if (md_str != 0) { md = str_to_int(md_str); }
        # 2.5.7: jitter_factor, written as a fraction ("0.5") and carried x100.
        var jf = 50;
        var jf_str = bayan_toml_get_by_cstr(rp, "jitter_factor");
        if (jf_str != 0) {
            var js = to_cstr(jf_str);
            var jr = _sem_parse_num(js, 0, strlen(js));
            jf = load64(jr) / 100;
            if (jf < 0) { jf = 0; }
        }
        _retry_cfg = retry_config_new_x(mr, bd, md, jf);
    }

    # Parse [hardware] section (2.5.7). Detection has already run by the time
    # config is parsed on the reload path, so disabled_backends takes effect at
    # the next hw_init/hw_refresh.
    var hw_secs = bayan_toml_get_sections_by_cstr(sections, "hardware");
    # 2.9.2: data_dir — where ai-hwaccel finds data/cloud_pricing.json and
    # data/models.json. Applied on every load, so an absent key (or a removed one,
    # on reload) means $AI_HWACCEL_DATA_DIR, then the working directory.
    var hw_data_dir = 0;
    if (vec_len(hw_secs) > 0) {
        var hdp = toml_section_pairs(vec_get(hw_secs, 0));
        var dd_str = bayan_toml_get_by_cstr(hdp, "data_dir");
        if (dd_str != 0) {
            if (str_len(dd_str) > 0) { hw_data_dir = to_cstr(dd_str); }
        }
    }
    hardware_configure_data_dir(hw_data_dir);
    if (vec_len(hw_secs) > 0) {
        var hp = toml_section_pairs(vec_get(hw_secs, 0));
        var vr = 0 - 1;
        var vr_str = bayan_toml_get_by_cstr(hp, "vram_reserve_bytes");
        if (vr_str != 0) { vr = str_to_int(vr_str); }
        var ri = 0 - 1;
        var ri_str = bayan_toml_get_by_cstr(hp, "refresh_interval_secs");
        if (ri_str != 0) { ri = str_to_int(ri_str); }
        var ct = 0 - 1;
        var ct_str = bayan_toml_get_by_cstr(hp, "cache_ttl_secs");
        if (ct_str != 0) { ct = str_to_int(ct_str); }
        hardware_configure(vr, ri, ct);
        var db_str = bayan_toml_get_by_cstr(hp, "disabled_backends");
        if (db_str != 0) {
            var dbs = alloc(MAX_DISABLED_BACKENDS * 8);
            var dbn = _config_str_array(hp, "disabled_backends", dbs, MAX_DISABLED_BACKENDS);
            hardware_configure_backends(dbs, dbn);
        }
    }

    # Parse [context] section — compaction knobs (2.5.7).
    var ctx_secs = bayan_toml_get_sections_by_cstr(sections, "context");
    if (vec_len(ctx_secs) > 0) {
        var cp = toml_section_pairs(vec_get(ctx_secs, 0));
        var cen = 1;
        var cen_str = bayan_toml_get_by_cstr(cp, "enabled");
        if (cen_str != 0) {
            if (str_eq_cstr(cen_str, "false") == 1) { cen = 0; }
        }
        var cthr = 80;
        var cthr_str = bayan_toml_get_by_cstr(cp, "compaction_threshold");
        if (cthr_str != 0) {
            var ts2 = to_cstr(cthr_str);
            var tr2 = _sem_parse_num(ts2, 0, strlen(ts2));
            cthr = load64(tr2) / 100;
        }
        var ckeep = 10;
        var ckeep_str = bayan_toml_get_by_cstr(cp, "keep_last_messages");
        if (ckeep_str != 0) { ckeep = str_to_int(ckeep_str); }
        context_configure(cen, cthr, ckeep);
    }

    # Parse [audit] section — the HMAC chain (2.5.7). Off by default, matching
    # rust-old. The signing key is "$NAME"-expandable so it stays out of the
    # config file; when unset, a random per-process key is generated.
    var aud_secs = bayan_toml_get_sections_by_cstr(sections, "audit");
    if (vec_len(aud_secs) > 0) {
        var ap = toml_section_pairs(vec_get(aud_secs, 0));
        var aen = 0;
        var aen_str = bayan_toml_get_by_cstr(ap, "enabled");
        if (aen_str != 0) {
            if (str_eq_cstr(aen_str, "true") == 1) { aen = 1; }
        }
        var amax = 10000;
        var amax_str = bayan_toml_get_by_cstr(ap, "max_entries");
        if (amax_str != 0) { amax = str_to_int(amax_str); }
        var akey = 0;
        var akey_str = bayan_toml_get_by_cstr(ap, "signing_key");
        if (akey_str != 0) { akey = _config_expand_env(to_cstr(akey_str)); }
        audit_configure(aen, akey, amax);
    }

    # Parse [[auth]] section. `tokens` is a LIST — rust-old took
    # `tokens = ["a", "b"]` (config.rs:166); the port used to push the raw
    # scalar, so only a single-token deployment worked and key rotation /
    # per-consumer keys were inexpressible. auth_check already loops the vec.
    var auth_secs = bayan_toml_get_sections_by_cstr(sections, "auth");
    if (vec_len(auth_secs) > 0) {
        var auth_p = toml_section_pairs(vec_get(auth_secs, 0));
        var tok_str = bayan_toml_get_by_cstr(auth_p, "tokens");
        if (tok_str != 0) {
            # Rebuild, do not append: load_config is a live reload entry point
            # (POST /v1/admin/reload and SIGHUP), and appending made the token
            # set union-only for the process lifetime — a revoked or rotated
            # key kept authenticating while the reload reported success.
            # Rebuilt only when the section is present: clearing unconditionally
            # would make a deleted [auth] section fail OPEN (auth.cyr allows all
            # on an empty vec).
            _auth_tokens = vec_new();
            var toks = alloc(MAX_AUTH_TOKENS * 8);
            var tcount = _config_str_array(auth_p, "tokens", toks, MAX_AUTH_TOKENS);
            var tj = 0;
            while (tj < tcount) {
                vec_push(_auth_tokens, load64(toks + tj * 8));
                tj = tj + 1;
            }
        }
    }

    # [mcp] tools (2.12.1): the szál tool groups /v1/tools/* serves (mcp.cyr). Read after [[auth]], since a group that
    # reaches the host needs bearer tokens. Absent or empty: none, bote_echo only, as through 2.12.0; so a reload that
    # drops the section turns them off.
    var mcp_secs = bayan_toml_get_sections_by_cstr(sections, "mcp");
    var mgroups = alloc(MCP_G_COUNT * 8);
    var mcount = 0;
    if (vec_len(mcp_secs) > 0) {
        var mcp_p = toml_section_pairs(vec_get(mcp_secs, 0));
        mcount = _config_str_array(mcp_p, "tools", mgroups, MCP_G_COUNT);
    }
    var mmask = mcp_configure(mgroups, mcount, vec_len(_auth_tokens) > 0);
    if (mmask != 0) { _config_log_mcp(mmask); }

    return 1;
}

# Log the szál tool groups a load enabled.
fn _config_log_mcp(mask) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "config: MCP tool groups:");
    var g = 0;
    while (g < MCP_G_COUNT) {
        if ((mask & (1 << g)) != 0) {
            str_builder_add_cstr(sb, " ");
            str_builder_add_cstr(sb, mcp_group_name(g));
        }
        g = g + 1;
    }
    hlog_info(str_data(str_builder_build(sb)));
    return 0;
}
