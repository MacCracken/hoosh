# --- mcp_bundle.cyr ---

# szal-mcp — szal's 54 MCP tools, bundled for a consumer that already owns a bote dispatcher.
#
# This comment is the first module of `[lib.mcp]` (cyrius.cyml), so it heads dist/szal-mcp.cyr, the
# file a consumer vendors. Regenerate the bundle with `cyrius distlib mcp`; CI refuses a stale one.
#
# WHAT IS INSIDE: only szal's own modules that szal_all_tools() reaches — error, state, uuid, md5,
# step, condition, flow, mcp, mcp_pool and the 15 mcp_tools_* groups. No bote-core, majra,
# ai-hwaccel or stdlib: the consumer supplies those, and already has them.
#
# INCLUDE, IN THIS ORDER, BEFORE THIS FILE:
#   1. the stdlib leaves named in dist/szal-mcp.deps (`cyrius deps` reads that sidecar; a raw-include
#      consumer includes each lib/<leaf>.cyr itself) — szal 2.3.3 builds and tests against the cyrius
#      6.7.18 snapshot. It cannot compile below cyrius 6.6.13: every JSON field read is
#      bayan_json_v_obj_get_by_cstr, which bayan added at 1.5.10. From bayan 1.11.1 (cyrius 6.7.18)
#      a JSON document with a duplicate object key or a malformed number (`01`) does not parse; a
#      tool given such arguments returns `invalid arguments: <reason> at byte <n>` (szal 2.3.1+;
#      ADR 0003, parity-notes §25) — 2.3.0 and older ran on their defaults instead;
#   2. bote-core (its dist/bote-core.cyr, the [lib.core] cut) — szal 2.3.3 builds and tests against
#      3.8.15, which needs cyrius >= 6.7.13 and `lib/sakshi.cyr` in scope (bote-core's own requires
#      block omits it). szal needs bote-core >= 3.1.3, where bote's error tags became BOTE_ERR_*.
#      From bote 3.4.8 the dispatcher checks each argument against the tool's schema (types, enums,
#      bounds) before the handler runs, and audits an `isError` result as a failure. Use >= 3.8.6:
#      from it bote refuses a request that names a key twice (-32600) before dispatch; through 3.8.5
#      it read the FIRST of the two and handed the handler both;
#   3. majra (its dist/majra.cyr) — szal 2.3.3 builds and tests against 2.13.0, and calls only
#      ratelimit_new / ratelimit_check. Below 2.7.0 majra keyed its buckets on the caller's key
#      POINTER, so szal's per-request keys got a fresh bucket every call and nothing was ever
#      rate-limited;
#   ai-hwaccel is NOT needed: the tool closure never reaches engine_hardware. step.cyr declares
#   REQ_NONE = 0 itself, which is ai-hwaccel's own symbol at the same value when both are in scope.
#
# TARGETS: Linux x86_64, and agnos (`cyrius build --agnos`, from szal 2.3.3; through 2.3.2 the bundle
# did not compile there). On agnos szal_exec starts programs through the kernel's spawn API (PATH, or
# /bin when unset; no working directory), szal_which looks the name up itself, szal_system_info says
# "agnos" with cpus 0, and every tool that takes a path is refused — the cyrius 6.7.18 agnos peer has
# no getcwd, so there is no working directory to confine to (parity-notes §26).
#
# REGISTER (all return what bote returns; see src/mcp.cyr):
#   szal_register_into(d)             add the 54 tools to YOUR dispatcher, under your own audit and
#                                     event sinks; 0 on success, else a BoteError
#   szal_all_tools()                  the 54 (ToolDef, handler) pairs — szal_tool_def_of /
#                                     szal_tool_handler_of — to register some other way
#   szal_register_tools()             a fresh szal-owned dispatcher (Rust's register_tools)
#   szal_register_tools_with(a, e)    the same with audit / event sinks (Rust's register_tools_with)
#
# THE TOOLS ACT ON THE HOST. File tools are confined to the process working directory
# (szal_validate_path); szal_exec runs a program without a shell and refuses `/` and `..` in its
# name; git refs may not start with `-`; szal_http refuses non-http(s) schemes, loopback, link-local
# metadata and RFC 1918 addresses; HTTP, DNS and port checks are rate-limited per host.
#
# NAMES: szal owns every symbol here, and the renames that let it sit next to upstream majra and
# bote-core unmodified (szal_step_result_new, szal_uuid_generate, szal_condition_*,
# SZAL_TRIGGER_*, ...). Before vendoring a new szal-mcp, run szal's
# `scripts/scan-collisions.sh --check --consumer <your compile set>` against it.
#
# SIDECAR SEED (2.2.1) — the one include below names io as the leaf the O_WRONLY / file_open use in
# mcp_tools_file needs. O_WRONLY is declared by lib/io.cyr AND the syscalls peers, and cyrius
# 6.6.20's distlib credited such a name in filesystem-listing order, so without this seed CI could
# derive the sidecar in a different order from a local run and fail the drift check. cyrius 6.7.7
# fixed that upstream (the snapshot is sorted); the seed stays because it is the honest leaf and
# keeps the sidecar the same on any distlib. io brings syscalls and result with it.
include "lib/io.cyr"

# --- error.cyr ---

# error.cyr — szal error codes + last-error detail buffer
#
# Ports rust-old/src/error.rs (SzalError, a thiserror enum). Rust's rich per-variant
# fields (step/reason/timeout_ms/attempts) flatten to: an integer code (this enum) plus a
# formatted detail Str held in a process-global last-error buffer. On threaded engine paths
# carry the detail in the per-step result struct instead — this buffer is last-error-wins
# and NOT thread-safe (matches the majra src/error.cyr pattern).
#
# Usage: include "src/error.cyr"
# Requires: lib/str.cyr (Str), lib/result.cyr (Err), lib/alloc.cyr (alloc_init before szal_err).
# Naming: every symbol is szal_-prefixed — vendored majra defines bare set_err_msg/err_name
# (port-plan §3.3); the szal_ prefix keeps both surfaces collision-free.

# SzalError variants as integer codes. SZAL_ERR_NONE=0 is the "no error" sentinel (Rust's enum
# is always-an-error; SZAL_ERR_NONE is the Cyrius convention for absence). The Rust hardware/majra
# feature-gated variants are always present here (port-plan feature strategy: no #ifdef).
enum SzalErr {
    SZAL_ERR_NONE = 0;
    SZAL_ERR_STEP_FAILED = 1;
    SZAL_ERR_STEP_TIMEOUT = 2;
    SZAL_ERR_FLOW_INVALID = 3;
    SZAL_ERR_RETRY_EXHAUSTED = 4;
    SZAL_ERR_ROLLBACK_FAILED = 5;
    SZAL_ERR_CYCLE = 6;
    SZAL_ERR_MIGRATION = 7;
    SZAL_ERR_HW_UNAVAILABLE = 8;
    SZAL_ERR_QUEUE = 9;
    SZAL_ERR_OTHER = 10;
}

# Detail buffer capacity (bytes). Used for the length clamp in szal_err_set_detail.
enum SzalErrBuf { SZAL_ERR_MSG_CAP = 512; }

# Process-global last-error detail. STATIC data section — shared across all calls, not
# thread-safe (see header). _szal_err_msg_len is the live byte length (<= cap).
#
# Size is a LITERAL, kept in sync with SZAL_ERR_MSG_CAP by hand. cycc resolves an enum-constant
# array size through FINDVAR and only honours table indices < 1024 (`parse_decl.cyr` "array size
# identifier must be an enum constant"), so the enum form fails once the preceding includes have
# declared >1024 globals — which is include-order dependent and grew past the cap with the 6.5.2
# stdlib. A literal is index-independent, so this no longer constrains include order.
var _szal_err_msg_buf[512];
var _szal_err_msg_len = 0;

# Map an error code to its snake_case name (cstr). Port-introduced convenience — Rust used
# thiserror Display; the rich interpolated text lives in the detail buffer instead.
fn szal_err_name(code) {
    if (code == SZAL_ERR_NONE) { return "none"; }
    if (code == SZAL_ERR_STEP_FAILED) { return "step_failed"; }
    if (code == SZAL_ERR_STEP_TIMEOUT) { return "step_timeout"; }
    if (code == SZAL_ERR_FLOW_INVALID) { return "flow_invalid"; }
    if (code == SZAL_ERR_RETRY_EXHAUSTED) { return "retry_exhausted"; }
    if (code == SZAL_ERR_ROLLBACK_FAILED) { return "rollback_failed"; }
    if (code == SZAL_ERR_CYCLE) { return "cycle_detected"; }
    if (code == SZAL_ERR_MIGRATION) { return "migration_failed"; }
    if (code == SZAL_ERR_HW_UNAVAILABLE) { return "hardware_unavailable"; }
    if (code == SZAL_ERR_QUEUE) { return "queue_error"; }
    if (code == SZAL_ERR_OTHER) { return "other"; }
    return "unknown";
}

# Set the last-error detail message from a Str (copies up to SZAL_ERR_MSG_CAP bytes). Returns 0.
fn szal_set_err_msg(msg) {
    var len = str_len(msg);
    if (len > SZAL_ERR_MSG_CAP) {
        len = SZAL_ERR_MSG_CAP;
    }
    var src = str_data(msg);
    var i = 0;
    while (i < len) {
        store8(&_szal_err_msg_buf + i, load8(src + i));
        i = i + 1;
    }
    _szal_err_msg_len = len;
    return 0;
}

# Get the current last-error detail as a Str (length-bounded; not NUL-terminated).
fn szal_get_err_msg() {
    return str_new(&_szal_err_msg_buf, _szal_err_msg_len);
}

# Clear the last-error detail. Returns 0.
fn szal_clear_err_msg() {
    _szal_err_msg_len = 0;
    return 0;
}

# Set the detail message and return Err(code). Requires alloc_init() + lib/result.cyr.
fn szal_err(code, msg) {
    szal_set_err_msg(msg);
    return Err(code);
}

# --- state.cyr ---

# state.cyr — szal WorkflowState finite-state machine
#
# Ports rust-old/src/state.rs (WorkflowState enum + is_terminal/valid_transition/Display).
# Pure FSM: no heap identity, so WorkflowState is a plain integer enum (i64), not a heap blob.
# The transition table and terminal set match the Rust oracle EXACTLY.
#
# Usage: include "src/state.cyr"
# Requires: lib/str.cyr only if callers use str_eq_cstr against state_name (this module returns
# cstr names and takes/returns integers — stdlib-only, no szal-module deps).
# Naming: enum constants are STATE_-prefixed and the fns are state_-prefixed to stay collision-
# free with vendored majra/bote (port-plan §3.3).
#
# Byte layout: none. A WorkflowState value IS the enum integer (0..7); it is passed and stored
# directly as an i64. There is no allocation and no accessor layer.

# Workflow execution state. Variant order matches rust-old/src/state.rs (Created=0 .. Cancelled=7).
# Rust exposes TWO distinct text forms and the port mirrors BOTH:
#   - Display (snake_case, e.g. "rolling_back"): state_name / state_from_name — used for logging,
#     topics, and human-facing text (mirrors the Display impl, state.rs 67-80).
#   - serde (PascalCase variant identifier, e.g. "RollingBack"): state_json_name / state_from_json
#     — the JSON wire form. The Rust enum derives Serialize/Deserialize with NO #[serde(rename_all)],
#     so serde_json emits the bare variant identifier (PascalCase). This is what ExecutionRecord
#     round-trips on disk (storage, M2); it is NOT the Display form. Conflating the two breaks
#     serde round-trip parity.
enum WorkflowState {
    STATE_CREATED = 0;
    STATE_RUNNING = 1;
    STATE_PAUSED = 2;
    STATE_COMPLETED = 3;
    STATE_FAILED = 4;
    STATE_ROLLING_BACK = 5;
    STATE_ROLLED_BACK = 6;
    STATE_CANCELLED = 7;
}

# True if the state is fully terminal (no outgoing transitions). Terminal set is exactly
# {Completed, RolledBack, Cancelled} — Failed is NOT terminal (it can go to RollingBack).
# Returns 1 (terminal) or 0 (not terminal). Mirrors WorkflowState::is_terminal.
fn state_is_terminal(s) {
    if (s == STATE_COMPLETED) { return 1; }
    if (s == STATE_ROLLED_BACK) { return 1; }
    if (s == STATE_CANCELLED) { return 1; }
    return 0;
}

# True if `from -> to` is a legal transition. Edge list mirrors WorkflowState::valid_transition
# EXACTLY: Created->Running; Running->{Paused,Completed,Failed,Cancelled,RollingBack};
# Paused->{Running,Cancelled}; Failed->RollingBack; RollingBack->{RolledBack,Failed}.
# Every other pair (including all terminal-state origins and self-loops) is invalid.
# Returns 1 (valid) or 0 (invalid).
fn state_valid_transition(from, to) {
    if (from == STATE_CREATED) {
        if (to == STATE_RUNNING) { return 1; }
        return 0;
    }
    if (from == STATE_RUNNING) {
        if (to == STATE_PAUSED) { return 1; }
        if (to == STATE_COMPLETED) { return 1; }
        if (to == STATE_FAILED) { return 1; }
        if (to == STATE_CANCELLED) { return 1; }
        if (to == STATE_ROLLING_BACK) { return 1; }
        return 0;
    }
    if (from == STATE_PAUSED) {
        if (to == STATE_RUNNING) { return 1; }
        if (to == STATE_CANCELLED) { return 1; }
        return 0;
    }
    if (from == STATE_FAILED) {
        if (to == STATE_ROLLING_BACK) { return 1; }
        return 0;
    }
    if (from == STATE_ROLLING_BACK) {
        if (to == STATE_ROLLED_BACK) { return 1; }
        if (to == STATE_FAILED) { return 1; }
        return 0;
    }
    return 0;
}

# Snake_case name (cstr) for a state, matching WorkflowState's Display impl in state.rs.
# Unknown values map to "unknown" (the Rust enum is closed; this is the Cyrius out-of-range guard).
fn state_name(s) {
    if (s == STATE_CREATED) { return "created"; }
    if (s == STATE_RUNNING) { return "running"; }
    if (s == STATE_PAUSED) { return "paused"; }
    if (s == STATE_COMPLETED) { return "completed"; }
    if (s == STATE_FAILED) { return "failed"; }
    if (s == STATE_ROLLING_BACK) { return "rolling_back"; }
    if (s == STATE_ROLLED_BACK) { return "rolled_back"; }
    if (s == STATE_CANCELLED) { return "cancelled"; }
    return "unknown";
}

# Parse a snake_case name (cstr) back to a WorkflowState integer. Inverse of state_name (the
# Display form). Returns the matching STATE_* value, or (0 - 1) for an unrecognized name (Rust
# would error; the port signals the bad input with the (0 - 1) sentinel).
fn state_from_name(name) {
    if (streq(name, "created")) { return STATE_CREATED; }
    if (streq(name, "running")) { return STATE_RUNNING; }
    if (streq(name, "paused")) { return STATE_PAUSED; }
    if (streq(name, "completed")) { return STATE_COMPLETED; }
    if (streq(name, "failed")) { return STATE_FAILED; }
    if (streq(name, "rolling_back")) { return STATE_ROLLING_BACK; }
    if (streq(name, "rolled_back")) { return STATE_ROLLED_BACK; }
    if (streq(name, "cancelled")) { return STATE_CANCELLED; }
    return (0 - 1);
}

# PascalCase serde identifier (cstr) for a state — the form serde_json emits for the Rust
# WorkflowState enum (Serialize derive with no #[serde(rename_all)] → bare variant identifier).
# This is the JSON wire form, distinct from state_name's Display snake_case. Unknown values map
# to "Unknown" (out-of-range guard; the Rust enum is closed).
fn state_json_name(s) {
    if (s == STATE_CREATED) { return "Created"; }
    if (s == STATE_RUNNING) { return "Running"; }
    if (s == STATE_PAUSED) { return "Paused"; }
    if (s == STATE_COMPLETED) { return "Completed"; }
    if (s == STATE_FAILED) { return "Failed"; }
    if (s == STATE_ROLLING_BACK) { return "RollingBack"; }
    if (s == STATE_ROLLED_BACK) { return "RolledBack"; }
    if (s == STATE_CANCELLED) { return "Cancelled"; }
    return "Unknown";
}

# Parse a PascalCase serde identifier (cstr) back to a WorkflowState integer. Inverse of
# state_json_name; this is the serde Deserialize form (serde_json::from_str). Mirrors the Rust
# serde round-trip exactly. Returns the matching STATE_* value, or (0 - 1) for an unrecognized
# name (Rust would error; the port signals the bad input with the (0 - 1) sentinel).
fn state_from_json(name) {
    if (streq(name, "Created")) { return STATE_CREATED; }
    if (streq(name, "Running")) { return STATE_RUNNING; }
    if (streq(name, "Paused")) { return STATE_PAUSED; }
    if (streq(name, "Completed")) { return STATE_COMPLETED; }
    if (streq(name, "Failed")) { return STATE_FAILED; }
    if (streq(name, "RollingBack")) { return STATE_ROLLING_BACK; }
    if (streq(name, "RolledBack")) { return STATE_ROLLED_BACK; }
    if (streq(name, "Cancelled")) { return STATE_CANCELLED; }
    return (0 - 1);
}

# --- uuid.cyr ---

# uuid.cyr — RFC-4122 v4 UUID generation, formatting, and parsing
#
# Ports the `uuid` crate surface used by rust-old (step.rs StepId, flow.rs FlowId,
# storage.rs id parsing, mcp/tools/encoding_tools.rs UuidGen): Uuid::new_v4() for ids,
# .to_string() (lowercase hyphenated 8-4-4-4-12), and Uuid::parse_str(). The Rust crate
# stored a 128-bit value; here a UUID is TWO i64 halves (hi, lo) carried via multi-return
# (matching majra src/envelope.cyr's uuid_generate / id_hi / id_lo split).
#
# Usage: include "src/uuid.cyr"
# Requires: lib/str.cyr (Str), lib/alloc.cyr (alloc/alloc_init for per-call buffers),
#   lib/syscalls.cyr (sys_getrandom).
# Naming: every symbol is uuid_-prefixed (port-plan §3.3 domain prefix); no collision with
#   vendored majra's bare uuid_generate because szal modules are compiled standalone here.
#
# BYTE LAYOUT / ENDIANNESS (the round-trip contract):
#   A UUID is the 16 bytes b[0..15]. The canonical RFC-4122 string reads those bytes
#   left-to-right as hex: b[0] is the first two hex chars, b[15] the last two.
#   We pack BIG-ENDIAN into the two halves so emission is a straight nibble walk:
#     hi = b[0]<<56 | b[1]<<48 | ... | b[7]      (b[0] is the most-significant byte of hi)
#     lo = b[8]<<56 | b[9]<<48 | ... | b[15]     (b[8] is the most-significant byte of lo)
#   Group boundaries in "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx":
#     b[0..3]=group1, b[4..5]=group2, b[6..7]=group3, b[8..9]=group4, b[10..15]=group5.
#   Version nibble (must be '4') is the HIGH nibble of b[6] = bits 8..11 of hi's low word,
#   i.e. nibble index 12 from the top of hi. Variant nibble (8/9/a/b) is the HIGH nibble
#   of b[8] = the top nibble of lo.

# getrandom flag for the default blocking CSPRNG read (lib/random.cyr GRND_NONBLOCK etc.).
enum UuidRand { UUID_GRND_BLOCK = 0; }

# Buffer / sentinel sizes. UUID_STR_CAP = 36 chars + 1 NUL. Enum constants so they are legal
# as alloc sizes and comparisons without negative/arith literals.
enum UuidSz {
    UUID_BYTES = 16;
    UUID_STR_LEN = 36;
    UUID_STR_CAP = 37;
}

# _uuid_hex_nibble(n) -> the lowercase-hex ASCII byte for nibble n (0..15). 0..9 -> '0'..'9',
# 10..15 -> 'a'..'f'. Internal (underscore) so no doc comment required.
fn _uuid_hex_nibble(n) {
    if (n < 10) {
        return 48 + n;
    }
    return 97 + (n - 10);
}

# _uuid_unhex(c) -> nibble value 0..15 for an ASCII hex byte (upper or lower case), or
# (0 - 1) for a non-hex byte. Internal.
fn _uuid_unhex(c) {
    if ((c >= 48) && (c <= 57)) {
        return c - 48;
    }
    if ((c >= 97) && (c <= 102)) {
        return (c - 97) + 10;
    }
    if ((c >= 65) && (c <= 70)) {
        return (c - 65) + 10;
    }
    return (0 - 1);
}

# Generate a random RFC-4122 v4 UUID. Fills 16 bytes from the kernel CSPRNG, then patches
# b[6] = (b[6] & 0x0F) | 0x40 (version 4) and b[8] = (b[8] & 0x3F) | 0x80 (variant 10xx).
# Returns TWO values (hi, lo) big-endian packed (see header). Consume with: var hi, lo = ...
# On CSPRNG failure (negative return) the bytes are left zeroed except for the version/variant
# patch (so the result is still a structurally valid v4 nil-ish UUID rather than garbage).
# szal-prefixed since 2.2.0: majra owns uuid_generate (a different implementation).
fn szal_uuid_generate() {
    var buf = alloc(UUID_BYTES);
    if (buf == 0) {
        return (0, 0);
    }
    var i = 0;
    while (i < UUID_BYTES) {
        store8(buf + i, 0);
        i = i + 1;
    }
    sys_getrandom(buf, UUID_BYTES, UUID_GRND_BLOCK);
    # version 4: high nibble of byte 6 -> 0x4
    var b6 = load8(buf + 6);
    store8(buf + 6, (b6 & 0x0F) | 0x40);
    # variant 10xx: top two bits of byte 8 -> 0x80
    var b8 = load8(buf + 8);
    store8(buf + 8, (b8 & 0x3F) | 0x80);
    # pack big-endian
    var hi = 0;
    var lo = 0;
    i = 0;
    while (i < 8) {
        hi = (hi << 8) | load8(buf + i);
        lo = (lo << 8) | load8(buf + 8 + i);
        i = i + 1;
    }
    return (hi, lo);
}

# _uuid_byte_at(hi, lo, idx) -> byte idx (0..15) of the big-endian-packed UUID. Internal.
fn _uuid_byte_at(hi, lo, idx) {
    if (idx < 8) {
        var sh1 = (7 - idx) * 8;
        return (hi >> sh1) & 0xFF;
    }
    var sh2 = (7 - (idx - 8)) * 8;
    return (lo >> sh2) & 0xFF;
}

# Format (hi, lo) as a NUL-terminated lowercase hyphenated RFC-4122 cstr
# "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx". Per-call buffer via alloc(37); returns the cstr,
# or 0 on OOM. Round-trips with uuid_parse. (Rust: Uuid::to_string().)
fn uuid_to_cstr(hi, lo) {
    var out = alloc(UUID_STR_CAP);
    if (out == 0) {
        return 0;
    }
    var pos = 0;
    var idx = 0;
    while (idx < UUID_BYTES) {
        if ((idx == 4) || (idx == 6) || (idx == 8) || (idx == 10)) {
            store8(out + pos, 45);
            pos = pos + 1;
        }
        var byte = _uuid_byte_at(hi, lo, idx);
        store8(out + pos, _uuid_hex_nibble((byte >> 4) & 0x0F));
        pos = pos + 1;
        store8(out + pos, _uuid_hex_nibble(byte & 0x0F));
        pos = pos + 1;
        idx = idx + 1;
    }
    store8(out + pos, 0);
    return out;
}

# Format (hi, lo) as a Str (heap fat pointer) via uuid_to_cstr + str_from. Convenience for
# callers working in Str internally; returns the empty Str on OOM.
fn uuid_to_str(hi, lo) {
    var c = uuid_to_cstr(hi, lo);
    if (c == 0) {
        return str_from("");
    }
    return str_from(c);
}

# Parse a hyphenated RFC-4122 cstr into (hi, lo). Accepts exactly the
# "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" form (36 chars, hyphens at indices 8/13/18/23,
# 32 hex digits, upper or lower case). On ANY malformed input returns the SENTINEL
# (hi, lo) = ((0 - 1), (0 - 1)) i.e. (0xFFFF.., 0xFFFF..) — callers test with uuid_parse_ok.
# (Rust: Uuid::parse_str(); the Err arm in storage.rs/step_tools.rs maps to this sentinel.)
fn uuid_parse(s) {
    if (s == 0) {
        return ((0 - 1), (0 - 1));
    }
    # verify length is exactly 36 (scan for NUL)
    var len = 0;
    while (load8(s + len) != 0) {
        len = len + 1;
        if (len > UUID_STR_LEN) {
            return ((0 - 1), (0 - 1));
        }
    }
    if (len != UUID_STR_LEN) {
        return ((0 - 1), (0 - 1));
    }
    var hi = 0;
    var lo = 0;
    var nib_count = 0;
    var i = 0;
    while (i < UUID_STR_LEN) {
        var c = load8(s + i);
        if ((i == 8) || (i == 13) || (i == 18) || (i == 23)) {
            if (c != 45) {
                return ((0 - 1), (0 - 1));
            }
        } else {
            var v = _uuid_unhex(c);
            if (v < 0) {
                return ((0 - 1), (0 - 1));
            }
            if (nib_count < 16) {
                hi = (hi << 4) | v;
            } else {
                lo = (lo << 4) | v;
            }
            nib_count = nib_count + 1;
        }
        i = i + 1;
    }
    return (hi, lo);
}

# uuid_parse_ok(hi, lo) -> 1 if (hi, lo) is NOT the parse sentinel, else 0. Use after
# uuid_parse to branch on success (the Ok/Err split from Rust's Uuid::parse_str()).
fn uuid_parse_ok(hi, lo) {
    if ((hi == (0 - 1)) && (lo == (0 - 1))) {
        return 0;
    }
    return 1;
}

# --- md5.cyr ---

# md5.cyr — RFC 1321 MD5 message digest
#
# Ports the `md5` crate usage in rust-old/src/mcp/tools/hash_tools.rs (the szal_md5 MCP tool:
# `md5::Md5::digest(input.as_bytes())` then lowercase hex). No MD5 module exists in Cyrius, so
# this is a hand-port of RFC 1321; structure modeled on lib/sha1.cyr (init/update/finalize +
# hex). Unlike SHA-1, MD5 uses LITTLE-ENDIAN word handling.
#
# WARNING: MD5 is NOT a trust primitive. Collision attacks are practical. Use only for
# checksums / content addressing (matching the Rust tool's "for checksums, not security"
# description) — never for signatures, password hashing, or anything needing collision
# resistance.
#
# Public API
# ----------
#   fn md5(data, len, out16)
#     Hashes `data[0..len)` with RFC 1321 MD5 and writes 16 raw digest bytes to `out16`
#     (caller-allocated). Digest bytes are little-endian per RFC 1321 §3.5.
#   fn md5_hex(data, len) -> cstr
#     Returns 32 lowercase hex chars (NUL-terminated cstr) of the MD5 digest, in a per-call
#     alloc(33) buffer. Returns 0 on OOM.
#
# Usage: include "src/md5.cyr"
# Requires: lib/alloc.cyr (alloc + alloc_init before md5/md5_hex), lib/string.cyr (memset/memcpy).
# Naming: md5_ / _md5_ prefixed to stay collision-free with vendored surfaces.

# RFC 1321 §3.4 — per-round left-rotate amounts (s table), 4 rounds x 4 distinct shifts.
# Indexed 0..63 by operation number.
var _md5_s_init = 0;
var _md5_s[64];

# RFC 1321 §3.4 — the 64 additive constants K[i] = floor(abs(sin(i+1)) * 2^32).
# Each slot is one 32-bit value (held in the low word of a native i64 slot, 8 bytes apart):
# 64 slots * 8 bytes = 512 bytes. `var buf[N]` needs a literal/enum-constant size.
#
# The size is a LITERAL, not the `MD5_K_BYTES` enum constant below, deliberately: cycc resolves an
# enum-constant array size through FINDVAR, which only honours table indices < 1024
# (`parse_decl.cyr` "array size identifier must be an enum constant"). Whether this declaration
# lands under that cap depends on how many globals the preceding includes declared — so with the
# 6.5.2 stdlib (sigil/bayan grew substantially) the enum form started failing in the smaller
# per-module test suites. A literal is index-independent. The enum is kept as the documented name.
enum Md5KLayout { MD5_K_BYTES = 512; }
var _md5_k_init = 0;
var _md5_k[512];

# Lazily populate the s (shift) and K (sine) tables. Idempotent; safe to call every digest.
fn _md5_tables_init(): i64 {
    if (_md5_s_init != 0) { return 0; }

    # Round 1 shifts: 7,12,17,22 repeated 4 times (ops 0..15).
    var i = 0;
    while (i < 16) {
        store8(&_md5_s + i + 0, 7);
        store8(&_md5_s + i + 1, 12);
        store8(&_md5_s + i + 2, 17);
        store8(&_md5_s + i + 3, 22);
        i = i + 4;
    }
    # Round 2 shifts: 5,9,14,20 (ops 16..31).
    i = 16;
    while (i < 32) {
        store8(&_md5_s + i + 0, 5);
        store8(&_md5_s + i + 1, 9);
        store8(&_md5_s + i + 2, 14);
        store8(&_md5_s + i + 3, 20);
        i = i + 4;
    }
    # Round 3 shifts: 4,11,16,23 (ops 32..47).
    i = 32;
    while (i < 48) {
        store8(&_md5_s + i + 0, 4);
        store8(&_md5_s + i + 1, 11);
        store8(&_md5_s + i + 2, 16);
        store8(&_md5_s + i + 3, 23);
        i = i + 4;
    }
    # Round 4 shifts: 6,10,15,21 (ops 48..63).
    i = 48;
    while (i < 64) {
        store8(&_md5_s + i + 0, 6);
        store8(&_md5_s + i + 1, 10);
        store8(&_md5_s + i + 2, 15);
        store8(&_md5_s + i + 3, 21);
        i = i + 4;
    }

    # RFC 1321 §3.4 — the 64 K constants (precomputed sine table).
    store64(&_md5_k + 0 * 8, 0xD76AA478);
    store64(&_md5_k + 1 * 8, 0xE8C7B756);
    store64(&_md5_k + 2 * 8, 0x242070DB);
    store64(&_md5_k + 3 * 8, 0xC1BDCEEE);
    store64(&_md5_k + 4 * 8, 0xF57C0FAF);
    store64(&_md5_k + 5 * 8, 0x4787C62A);
    store64(&_md5_k + 6 * 8, 0xA8304613);
    store64(&_md5_k + 7 * 8, 0xFD469501);
    store64(&_md5_k + 8 * 8, 0x698098D8);
    store64(&_md5_k + 9 * 8, 0x8B44F7AF);
    store64(&_md5_k + 10 * 8, 0xFFFF5BB1);
    store64(&_md5_k + 11 * 8, 0x895CD7BE);
    store64(&_md5_k + 12 * 8, 0x6B901122);
    store64(&_md5_k + 13 * 8, 0xFD987193);
    store64(&_md5_k + 14 * 8, 0xA679438E);
    store64(&_md5_k + 15 * 8, 0x49B40821);
    store64(&_md5_k + 16 * 8, 0xF61E2562);
    store64(&_md5_k + 17 * 8, 0xC040B340);
    store64(&_md5_k + 18 * 8, 0x265E5A51);
    store64(&_md5_k + 19 * 8, 0xE9B6C7AA);
    store64(&_md5_k + 20 * 8, 0xD62F105D);
    store64(&_md5_k + 21 * 8, 0x02441453);
    store64(&_md5_k + 22 * 8, 0xD8A1E681);
    store64(&_md5_k + 23 * 8, 0xE7D3FBC8);
    store64(&_md5_k + 24 * 8, 0x21E1CDE6);
    store64(&_md5_k + 25 * 8, 0xC33707D6);
    store64(&_md5_k + 26 * 8, 0xF4D50D87);
    store64(&_md5_k + 27 * 8, 0x455A14ED);
    store64(&_md5_k + 28 * 8, 0xA9E3E905);
    store64(&_md5_k + 29 * 8, 0xFCEFA3F8);
    store64(&_md5_k + 30 * 8, 0x676F02D9);
    store64(&_md5_k + 31 * 8, 0x8D2A4C8A);
    store64(&_md5_k + 32 * 8, 0xFFFA3942);
    store64(&_md5_k + 33 * 8, 0x8771F681);
    store64(&_md5_k + 34 * 8, 0x6D9D6122);
    store64(&_md5_k + 35 * 8, 0xFDE5380C);
    store64(&_md5_k + 36 * 8, 0xA4BEEA44);
    store64(&_md5_k + 37 * 8, 0x4BDECFA9);
    store64(&_md5_k + 38 * 8, 0xF6BB4B60);
    store64(&_md5_k + 39 * 8, 0xBEBFBC70);
    store64(&_md5_k + 40 * 8, 0x289B7EC6);
    store64(&_md5_k + 41 * 8, 0xEAA127FA);
    store64(&_md5_k + 42 * 8, 0xD4EF3085);
    store64(&_md5_k + 43 * 8, 0x04881D05);
    store64(&_md5_k + 44 * 8, 0xD9D4D039);
    store64(&_md5_k + 45 * 8, 0xE6DB99E5);
    store64(&_md5_k + 46 * 8, 0x1FA27CF8);
    store64(&_md5_k + 47 * 8, 0xC4AC5665);
    store64(&_md5_k + 48 * 8, 0xF4292244);
    store64(&_md5_k + 49 * 8, 0x432AFF97);
    store64(&_md5_k + 50 * 8, 0xAB9423A7);
    store64(&_md5_k + 51 * 8, 0xFC93A039);
    store64(&_md5_k + 52 * 8, 0x655B59C3);
    store64(&_md5_k + 53 * 8, 0x8F0CCC92);
    store64(&_md5_k + 54 * 8, 0xFFEFF47D);
    store64(&_md5_k + 55 * 8, 0x85845DD1);
    store64(&_md5_k + 56 * 8, 0x6FA87E4F);
    store64(&_md5_k + 57 * 8, 0xFE2CE6E0);
    store64(&_md5_k + 58 * 8, 0xA3014314);
    store64(&_md5_k + 59 * 8, 0x4E0811A1);
    store64(&_md5_k + 60 * 8, 0xF7537E82);
    store64(&_md5_k + 61 * 8, 0xBD3AF235);
    store64(&_md5_k + 62 * 8, 0x2AD7D2BB);
    store64(&_md5_k + 63 * 8, 0xEB86D391);

    _md5_s_init = 1;
    return 0;
}

# 32-bit left-rotate. `>>` is logical (zero-fill) in Cyrius, which is what a rotate needs;
# operands are masked to 32 bits so the result fits a u32.
fn _md5_rotl32(x, n): i64 {
    x = x & 0xFFFFFFFF;
    return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF;
}

# Compute the RFC 1321 MD5 digest of `data[0..len)`. Writes 16 little-endian digest bytes to
# `out16` (caller-allocated). Returns 0, or returns 1 on OOM (no bytes written).
# NOT collision-resistant — see module header.
fn md5(data, len, out16): i64 {
    _md5_tables_init();

    # RFC 1321 §3.3 — initial state A,B,C,D (stored little-endian on the wire, but held as
    # plain 32-bit values here).
    var a0 = 0x67452301;
    var b0 = 0xEFCDAB89;
    var c0 = 0x98BADCFE;
    var d0 = 0x10325476;

    # RFC 1321 §3.1 — padding: append 0x80, zero-pad so length is congruent to 56 (mod 64),
    # then append the 64-bit LITTLE-ENDIAN message length in bits.
    var msg_len = len + 1 + 8;
    var pad_len = 64 - (msg_len % 64);
    if (pad_len == 64) { pad_len = 0; }
    var total = len + 1 + pad_len + 8;
    var buf = alloc(total);
    if (buf == 0) { return 1; }
    memset(buf, 0, total);
    memcpy(buf, data, len);
    store8(buf + len, 0x80);
    var bit_len = len * 8;
    # Little-endian 64-bit bit length in the final 8 bytes.
    store8(buf + total - 8, bit_len & 0xFF);
    store8(buf + total - 7, (bit_len >> 8) & 0xFF);
    store8(buf + total - 6, (bit_len >> 16) & 0xFF);
    store8(buf + total - 5, (bit_len >> 24) & 0xFF);
    store8(buf + total - 4, (bit_len >> 32) & 0xFF);
    store8(buf + total - 3, (bit_len >> 40) & 0xFF);
    store8(buf + total - 2, (bit_len >> 48) & 0xFF);
    store8(buf + total - 1, (bit_len >> 56) & 0xFF);

    # Message words M[0..15] for the current block; each slot is 8 bytes apart to use native
    # 64-bit load/store (32-bit value in the low word).
    var m = alloc(16 * 8);
    if (m == 0) { return 1; }

    var chunk_off = 0;
    while (chunk_off < total) {
        # RFC 1321 §3.4 — decode the 16 LITTLE-ENDIAN 32-bit words of this block.
        var i = 0;
        while (i < 16) {
            var b0w = load8(buf + chunk_off + i * 4);
            var b1w = load8(buf + chunk_off + i * 4 + 1);
            var b2w = load8(buf + chunk_off + i * 4 + 2);
            var b3w = load8(buf + chunk_off + i * 4 + 3);
            store64(m + i * 8, b0w | (b1w << 8) | (b2w << 16) | (b3w << 24));
            i = i + 1;
        }

        var a = a0;
        var b = b0;
        var c = c0;
        var d = d0;

        # RFC 1321 §3.4 — 64 operations across 4 rounds. f and the message index g are
        # selected per round; the s/K tables are common.
        i = 0;
        while (i < 64) {
            var f = 0;
            var g = 0;
            if (i < 16) {
                f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
                g = i;
            } elif (i < 32) {
                f = (d & b) | ((d ^ 0xFFFFFFFF) & c);
                g = (5 * i + 1) % 16;
            } elif (i < 48) {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 0xFFFFFFFF));
                g = (7 * i) % 16;
            }
            f = f & 0xFFFFFFFF;
            var sum = (f + a + load64(&_md5_k + i * 8) + load64(m + g * 8)) & 0xFFFFFFFF;
            var rot = _md5_rotl32(sum, load8(&_md5_s + i));
            a = d;
            d = c;
            c = b;
            b = (b + rot) & 0xFFFFFFFF;
            i = i + 1;
        }

        a0 = (a0 + a) & 0xFFFFFFFF;
        b0 = (b0 + b) & 0xFFFFFFFF;
        c0 = (c0 + c) & 0xFFFFFFFF;
        d0 = (d0 + d) & 0xFFFFFFFF;
        chunk_off = chunk_off + 64;
    }

    # RFC 1321 §3.5 — output digest little-endian, A then B then C then D.
    store8(out16 + 0,   a0 & 0xFF);
    store8(out16 + 1,  (a0 >> 8) & 0xFF);
    store8(out16 + 2,  (a0 >> 16) & 0xFF);
    store8(out16 + 3,  (a0 >> 24) & 0xFF);
    store8(out16 + 4,   b0 & 0xFF);
    store8(out16 + 5,  (b0 >> 8) & 0xFF);
    store8(out16 + 6,  (b0 >> 16) & 0xFF);
    store8(out16 + 7,  (b0 >> 24) & 0xFF);
    store8(out16 + 8,   c0 & 0xFF);
    store8(out16 + 9,  (c0 >> 8) & 0xFF);
    store8(out16 + 10, (c0 >> 16) & 0xFF);
    store8(out16 + 11, (c0 >> 24) & 0xFF);
    store8(out16 + 12,  d0 & 0xFF);
    store8(out16 + 13, (d0 >> 8) & 0xFF);
    store8(out16 + 14, (d0 >> 16) & 0xFF);
    store8(out16 + 15, (d0 >> 24) & 0xFF);
    return 0;
}

# Lowercase hex digit (0..15) -> ASCII byte. '0'..'9' = 48..57, 'a'..'f' = 97..102.
fn _md5_hex_digit(v): i64 {
    if (v < 10) { return 48 + v; }
    return 97 + (v - 10);
}

# Compute MD5 of `data[0..len)` and return 32 lowercase hex chars as a NUL-terminated cstr.
# Allocated per-call (alloc(33)); returns 0 on OOM. Matches the Rust szal_md5 tool's hex output.
fn md5_hex(data, len): i64 {
    var digest = alloc(16);
    if (digest == 0) { return 0; }
    var rc = md5(data, len, digest);
    if (rc != 0) { return 0; }
    var out = alloc(33);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < 16) {
        var byte = load8(digest + i);
        store8(out + i * 2, _md5_hex_digit((byte >> 4) & 0xF));
        store8(out + i * 2 + 1, _md5_hex_digit(byte & 0xF));
        i = i + 1;
    }
    store8(out + 32, 0);
    return out;
}

# --- step.cyr ---

# step.cyr — workflow step definitions, builders, backoff, status, results
#
# Ports rust-old/src/step.rs (StepDef + builder pattern, BackoffStrategy, TriggerMode,
# StepStatus, StepResult, serde (de)serialization). StepDef is a heap blob with an enum of
# byte-offset layout constants and accessor fns (the majra heap-struct idiom). All ids are
# UUIDs carried as two i64 halves (hi, lo) matching src/uuid.cyr.
#
# Usage: include "src/step.cyr"
# Requires: lib/str.cyr (Str + builder), lib/vec.cyr, lib/alloc.cyr (alloc_init before any
#   constructor), lib/bayan.cyr (json_v config + step_to_json/from_json), src/uuid.cyr
#   (szal_uuid_generate/uuid_to_str/uuid_parse). lib/io must be in scope before lib/bayan.
# Naming: public symbols are step_/STATUS_/BACKOFF_-prefixed, and the names majra ALSO owns are
#   szal-prefixed (SzalStepStatus, SzalTriggerMode, SZAL_TRIGGER_*, szal_step_result_new) so szal and
#   its consumers can vendor upstream majra unmodified. Internal helpers use the _ prefix.

# BackoffStrategy — retry-delay growth. Values are declaration order (0/1/2). The serde wire
# name (step.rs derives Serialize with NO rename_all) is the PascalCase variant name, emitted
# by _backoff_name. Default (serde + StepDef::new) is Fixed. (step.rs lines 35-45.)
enum BackoffStrategy {
    BACKOFF_FIXED = 0;
    BACKOFF_LINEAR = 1;
    BACKOFF_EXPONENTIAL = 2;
}

# TriggerMode — DAG dependency resolution mode. Values are declaration order. The serde wire
# name is the PascalCase variant name. Default (serde + StepDef::new) is All. (step.rs 24-32.)
# szal-prefixed since 2.2.0 (SzalTriggerMode / SZAL_TRIGGER_*): vendored majra declares its own
# TriggerMode with TRIGGER_ALL / TRIGGER_ANY, and one flat namespace cannot hold both.
enum SzalTriggerMode {
    SZAL_TRIGGER_ALL = 0;
    SZAL_TRIGGER_ANY = 1;
}

# StepStatus — the 6 step execution states. Values are declaration order. NOTE: step.rs has
# TWO distinct string forms: the Display impl emits snake_case (step_status_display) while the
# serde Serialize impl emits the PascalCase variant name (step_status_serde_name). StepResult
# JSON carries the serde (PascalCase) form. (step.rs 73-93.) The TYPE is SzalStepStatus because
# majra declares a StepStatus of its own; the STATUS_* members collide with nothing.
enum SzalStepStatus {
    STATUS_PENDING = 0;
    STATUS_RUNNING = 1;
    STATUS_COMPLETED = 2;
    STATUS_FAILED = 3;
    STATUS_SKIPPED = 4;
    STATUS_ROLLED_BACK = 5;
}

# Hardware requirement default: REQ_NONE = 0, deliberately the SAME symbol and value as
# ai-hwaccel's (engine_hardware.cyr checks a step's requirement against ai-hwaccel's REQ_* table).
# Declared here as well so step.cyr builds without ai-hwaccel — dist/szal-mcp.cyr's tool closure
# never reaches engine_hardware. scripts/scan-collisions.sh allow-lists the pair only while the
# two values are equal.
enum StepHw { REQ_NONE = 0; }

# i64 max sentinel for saturating backoff math (Rust uses u64::MAX; Cyrius i64 clamps to
# i64::MAX — see docs/development/parity-notes.md §2 for the divergence). 0x7FFF... is 2^63-1.
#
# ⚠ Needs cyrius >= 6.5.36. cycc 6.5.31-6.5.35 sign-extended enum constants from bit 62, folding
# this one to -1 — and because Cyrius `>`/`>=` are signed, every `timeout_ms >= STEP_I64_MAX` /
# `elapsed > timeout` comparison took the wrong branch (steps ran untimed, flows "timed out" at
# once). szal 2.1.1-2.1.2 carried it as a `var` to dodge that; 2.2.0 restored the enum once the
# pin moved past the fix. tests/szal_step.tcyr asserts the value directly, so a regressed compiler
# fails a test instead of inverting the engine. History:
# docs/development/issues/archive/2026-08-26-cycc-enum-bit62-sign-extension.md.
enum StepSat { STEP_I64_MAX = 0x7FFFFFFFFFFFFFFF; }

# Map a BackoffStrategy to its serde/Debug PascalCase name (cstr). Mirrors step.rs derive(
# Serialize) on the enum (no rename_all). Unknown -> "Fixed" (the default).
fn step_backoff_name(b) {
    if (b == BACKOFF_FIXED) { return "Fixed"; }
    if (b == BACKOFF_LINEAR) { return "Linear"; }
    if (b == BACKOFF_EXPONENTIAL) { return "Exponential"; }
    return "Fixed";
}

# Parse a BackoffStrategy from its serde PascalCase name (Str). Unknown/missing -> BACKOFF_FIXED
# (serde #[default] parity). Used by step_from_json.
fn step_backoff_from_name(s) {
    if (s == 0) { return BACKOFF_FIXED; }
    if (str_eq_cstr(s, "Linear") == 1) { return BACKOFF_LINEAR; }
    if (str_eq_cstr(s, "Exponential") == 1) { return BACKOFF_EXPONENTIAL; }
    return BACKOFF_FIXED;
}

# Map a TriggerMode to its serde/Debug PascalCase name (cstr). Unknown -> "All" (the default).
fn step_trigger_name(t) {
    if (t == SZAL_TRIGGER_ALL) { return "All"; }
    if (t == SZAL_TRIGGER_ANY) { return "Any"; }
    return "All";
}

# Parse a TriggerMode from its serde PascalCase name (Str). Unknown/missing -> SZAL_TRIGGER_ALL
# (serde #[default] parity). Used by step_from_json.
fn step_trigger_from_name(s) {
    if (s == 0) { return SZAL_TRIGGER_ALL; }
    if (str_eq_cstr(s, "Any") == 1) { return SZAL_TRIGGER_ANY; }
    return SZAL_TRIGGER_ALL;
}

# Map a StepStatus to its Display (snake_case) string (cstr). Mirrors the std::fmt::Display
# impl in step.rs lines 82-93 (RolledBack -> "rolled_back"). Unknown -> "pending".
fn step_status_display(s) {
    if (s == STATUS_PENDING) { return "pending"; }
    if (s == STATUS_RUNNING) { return "running"; }
    if (s == STATUS_COMPLETED) { return "completed"; }
    if (s == STATUS_FAILED) { return "failed"; }
    if (s == STATUS_SKIPPED) { return "skipped"; }
    if (s == STATUS_ROLLED_BACK) { return "rolled_back"; }
    return "pending";
}

# Map a StepStatus to its serde/Debug (PascalCase) name (cstr). This is what StepResult JSON
# carries (derive(Serialize), no rename_all). Unknown -> "Pending".
fn step_status_serde_name(s) {
    if (s == STATUS_PENDING) { return "Pending"; }
    if (s == STATUS_RUNNING) { return "Running"; }
    if (s == STATUS_COMPLETED) { return "Completed"; }
    if (s == STATUS_FAILED) { return "Failed"; }
    if (s == STATUS_SKIPPED) { return "Skipped"; }
    if (s == STATUS_ROLLED_BACK) { return "RolledBack"; }
    return "Pending";
}

# Parse a StepStatus from its serde PascalCase name (Str). Unknown/missing -> STATUS_PENDING.
fn step_status_from_name(s) {
    if (s == 0) { return STATUS_PENDING; }
    if (str_eq_cstr(s, "Running") == 1) { return STATUS_RUNNING; }
    if (str_eq_cstr(s, "Completed") == 1) { return STATUS_COMPLETED; }
    if (str_eq_cstr(s, "Failed") == 1) { return STATUS_FAILED; }
    if (str_eq_cstr(s, "Skipped") == 1) { return STATUS_SKIPPED; }
    if (str_eq_cstr(s, "RolledBack") == 1) { return STATUS_ROLLED_BACK; }
    return STATUS_PENDING;
}

# backoff_delay_ms(strategy, base_delay_ms, attempt) — the per-attempt retry delay (attempt is
# 1-indexed). Mirrors BackoffStrategy::delay_ms (step.rs 51-60) with SATURATING math:
#   Fixed       -> base
#   Linear      -> base * attempt              (saturating)
#   Exponential -> base * 2^(attempt-1)         (saturating; shift overflow clamps to MAX)
# Cyrius i64 saturation clamps to i64::MAX (Rust clamps to u64::MAX) — see docs/development/parity-notes.md §2.
fn step_backoff_delay_ms(strategy, base_delay_ms, attempt) {
    if (strategy == BACKOFF_FIXED) {
        return base_delay_ms;
    }
    if (strategy == BACKOFF_LINEAR) {
        return _step_sat_mul(base_delay_ms, attempt);
    }
    # Exponential: factor = 2^(attempt-1), with checked_shl semantics. attempt is 1-indexed;
    # attempt.saturating_sub(1) is the shift amount. A shift >= 63 overflows i64, so clamp the
    # factor to STEP_I64_MAX (Rust's checked_shl returns None -> unwrap_or(u64::MAX)).
    var shift = attempt - 1;
    if (attempt == 0) { shift = 0; }
    if (shift >= 63) {
        return _step_sat_mul(base_delay_ms, STEP_I64_MAX);
    }
    var factor = 1 << shift;
    return _step_sat_mul(base_delay_ms, factor);
}

# Saturating i64 multiply clamping positive overflow to STEP_I64_MAX. Both operands are
# non-negative in every backoff call (base_delay_ms, attempt, 2^k are all >= 0); a negative
# operand would mean corrupt input, in which case we still avoid wrap by clamping. Internal.
fn _step_sat_mul(a, b) {
    if (b == 0) { return 0; }
    if (a == 0) { return 0; }
    var r = a * b;
    # Divide-back overflow check (both operands non-negative -> positive product expected).
    if (r / b != a) {
        return STEP_I64_MAX;
    }
    if (r < 0) {
        return STEP_I64_MAX;
    }
    return r;
}

# StepDef — heap blob. Mirrors the Rust struct (step.rs 113-151). Optional fields hold a Str
# pointer (or json_v* for config) when present and 0 (Rust None) when absent. The id is two
# i64 halves matching src/uuid.cyr. depends_on / sub_steps are vec pointers (always allocated,
# possibly empty). hardware is a plain i64 (REQ_NONE default; ai-hwaccel constants land at M2).
#
# Byte layout (120 bytes):
#   +0    id_hi          (i64, uuid hi half)
#   +8    id_lo          (i64, uuid lo half)
#   +16   name           (Str ptr)
#   +24   description    (Str ptr)
#   +32   timeout_ms     (i64, default 30000)
#   +40   max_retries    (i64, default 0)
#   +48   retry_delay_ms (i64, default 1000)
#   +56   backoff        (i64 BackoffStrategy, default BACKOFF_FIXED)
#   +64   rollbackable   (i64 1/0, default 0)
#   +72   step_type      (Str ptr, 0 = None)
#   +80   config         (json_v* , 0 = None)
#   +88   condition      (Str ptr, 0 = None)
#   +96   depends_on     (vec of dep-blob ptrs {hi@0, lo@8})
#   +104  trigger_mode   (i64 SzalTriggerMode, default SZAL_TRIGGER_ALL)
#   +112  sub_steps      (vec of StepDef ptrs)
#   +120  hardware       (i64, REQ_NONE default; ai-hwaccel REQ_* constants at M2)
enum StepDefL {
    STEPDEF_SIZE = 128;
    SD_ID_HI = 0;
    SD_ID_LO = 8;
    SD_NAME = 16;
    SD_DESCRIPTION = 24;
    SD_TIMEOUT_MS = 32;
    SD_MAX_RETRIES = 40;
    SD_RETRY_DELAY_MS = 48;
    SD_BACKOFF = 56;
    SD_ROLLBACKABLE = 64;
    SD_STEP_TYPE = 72;
    SD_CONFIG = 80;
    SD_CONDITION = 88;
    SD_DEPENDS_ON = 96;
    SD_TRIGGER_MODE = 104;
    SD_SUB_STEPS = 112;
    SD_HARDWARE = 120;
}

# A dependency id is a 16-byte blob {hi@0, lo@8} (a StepId/Uuid). depends_on is a vec of these.
enum StepDepL { DEP_SIZE = 16; DEP_HI = 0; DEP_LO = 8; }

# --- StepDef accessors ---

# Get the step id high half (i64).
fn step_id_hi(s) { return load64(s + SD_ID_HI); }

# Get the step id low half (i64).
fn step_id_lo(s) { return load64(s + SD_ID_LO); }

# Get the step name (Str ptr).
fn step_name(s) { return load64(s + SD_NAME); }

# Get the step description (Str ptr).
fn step_description(s) { return load64(s + SD_DESCRIPTION); }

# Get the timeout in milliseconds (i64).
fn step_timeout_ms(s) { return load64(s + SD_TIMEOUT_MS); }

# Get the max retry attempts (i64).
fn step_max_retries(s) { return load64(s + SD_MAX_RETRIES); }

# Get the retry delay in milliseconds (i64).
fn step_retry_delay_ms(s) { return load64(s + SD_RETRY_DELAY_MS); }

# Get the backoff strategy (BackoffStrategy enum value).
fn step_backoff(s) { return load64(s + SD_BACKOFF); }

# Is this step rollbackable? 1/0.
fn step_rollbackable(s) { return load64(s + SD_ROLLBACKABLE); }

# Get the step_type (Str ptr, 0 = None).
fn step_step_type(s) { return load64(s + SD_STEP_TYPE); }

# Get the config (json_v* , 0 = None).
fn step_config(s) { return load64(s + SD_CONFIG); }

# Get the condition expression (Str ptr, 0 = None).
fn step_condition(s) { return load64(s + SD_CONDITION); }

# Get the depends_on vec (vec of 16-byte dep blobs {hi, lo}).
fn step_depends_on(s) { return load64(s + SD_DEPENDS_ON); }

# Get the number of dependencies.
fn step_depends_on_len(s) { return vec_len(load64(s + SD_DEPENDS_ON)); }

# Get the i-th dependency id high half.
fn step_depends_on_hi(s, i) { return load64(vec_get(load64(s + SD_DEPENDS_ON), i) + DEP_HI); }

# Get the i-th dependency id low half.
fn step_depends_on_lo(s, i) { return load64(vec_get(load64(s + SD_DEPENDS_ON), i) + DEP_LO); }

# Get the trigger mode (SzalTriggerMode enum value).
fn step_trigger_mode(s) { return load64(s + SD_TRIGGER_MODE); }

# Get the sub_steps vec (vec of StepDef ptrs).
fn step_sub_steps(s) { return load64(s + SD_SUB_STEPS); }

# Get the number of sub-steps.
fn step_sub_steps_len(s) { return vec_len(load64(s + SD_SUB_STEPS)); }

# Get the i-th sub-step (StepDef ptr).
fn step_sub_step_at(s, i) { return vec_get(load64(s + SD_SUB_STEPS), i); }

# Get the hardware requirement (i64, REQ_NONE default).
fn step_hardware(s) { return load64(s + SD_HARDWARE); }

# --- Builders ---

# Allocate a fresh StepDef with the given name (Str) and step.rs defaults: a freshly generated
# v4 UUID id, empty description, timeout_ms 30000, max_retries 0, retry_delay_ms 1000, backoff
# Fixed, rollbackable false, all optionals None, empty depends_on/sub_steps, trigger_mode All,
# hardware REQ_NONE. Mirrors StepDef::new (step.rs 155-174). Returns 0 on OOM.
fn step_new(name) {
    var s = alloc(STEPDEF_SIZE);
    if (s == 0) { return 0; }
    var hi, lo = szal_uuid_generate();
    store64(s + SD_ID_HI, hi);
    store64(s + SD_ID_LO, lo);
    store64(s + SD_NAME, name);
    store64(s + SD_DESCRIPTION, str_from(""));
    store64(s + SD_TIMEOUT_MS, 30000);
    store64(s + SD_MAX_RETRIES, 0);
    store64(s + SD_RETRY_DELAY_MS, 1000);
    store64(s + SD_BACKOFF, BACKOFF_FIXED);
    store64(s + SD_ROLLBACKABLE, 0);
    store64(s + SD_STEP_TYPE, 0);
    store64(s + SD_CONFIG, 0);
    store64(s + SD_CONDITION, 0);
    store64(s + SD_DEPENDS_ON, vec_new());
    store64(s + SD_TRIGGER_MODE, SZAL_TRIGGER_ALL);
    store64(s + SD_SUB_STEPS, vec_new());
    store64(s + SD_HARDWARE, REQ_NONE);
    return s;
}

# Set timeout_ms (mirrors with_timeout). Mutates and returns s. (step.rs 177-180.)
fn step_with_timeout(s, ms) {
    if (s == 0) { return 0; }
    store64(s + SD_TIMEOUT_MS, ms);
    return s;
}

# Set max_retries + retry_delay_ms (mirrors with_retries). Returns s. (step.rs 183-187.)
fn step_with_retries(s, max, delay_ms) {
    if (s == 0) { return 0; }
    store64(s + SD_MAX_RETRIES, max);
    store64(s + SD_RETRY_DELAY_MS, delay_ms);
    return s;
}

# Set the backoff strategy (mirrors with_backoff). Returns s. (step.rs 190-193.)
fn step_with_backoff(s, strategy) {
    if (s == 0) { return 0; }
    store64(s + SD_BACKOFF, strategy);
    return s;
}

# Mark the step rollbackable (mirrors with_rollback). Returns s. (step.rs 196-199.)
fn step_with_rollback(s) {
    if (s == 0) { return 0; }
    store64(s + SD_ROLLBACKABLE, 1);
    return s;
}

# Append a dependency id (mirrors depends_on). hi/lo are the StepId halves. Returns s.
# (step.rs 202-205.)
fn step_depends_on_add(s, hi, lo) {
    if (s == 0) { return 0; }
    var dep = alloc(DEP_SIZE);
    if (dep == 0) { return s; }
    store64(dep + DEP_HI, hi);
    store64(dep + DEP_LO, lo);
    vec_push(load64(s + SD_DEPENDS_ON), dep);
    return s;
}

# Set the step_type (mirrors with_step_type). step_type is a Str. Returns s. (step.rs 208-211.)
fn step_with_step_type(s, step_type) {
    if (s == 0) { return 0; }
    store64(s + SD_STEP_TYPE, step_type);
    return s;
}

# Set the config json_v (mirrors with_config). config is a json_v*. Returns s. (step.rs 214-217.)
fn step_with_config(s, config) {
    if (s == 0) { return 0; }
    store64(s + SD_CONFIG, config);
    return s;
}

# Set the condition expression (mirrors with_condition). expr is a Str. Returns s.
# (step.rs 220-223.)
fn step_with_condition(s, expr) {
    if (s == 0) { return 0; }
    store64(s + SD_CONDITION, expr);
    return s;
}

# Set the trigger mode (mirrors with_trigger_mode). Returns s. (step.rs 226-229.)
fn step_with_trigger_mode(s, mode) {
    if (s == 0) { return 0; }
    store64(s + SD_TRIGGER_MODE, mode);
    return s;
}

# Append a sub-step (mirrors with_sub_step). step is a StepDef*. Returns s. (step.rs 232-235.)
fn step_with_sub_step(s, sub) {
    if (s == 0) { return 0; }
    vec_push(load64(s + SD_SUB_STEPS), sub);
    return s;
}

# Set the hardware requirement (mirrors with_hardware). req is an i64 REQ_* value. Returns s.
# (step.rs 240-243.)
fn step_with_hardware(s, req) {
    if (s == 0) { return 0; }
    store64(s + SD_HARDWARE, req);
    return s;
}

# StepResult — heap blob. Mirrors the Rust struct (step.rs 247-255). step_id is two i64 halves;
# output is a json_v* (never None in Rust — defaults to Value::Null); error is a Str/0 (None).
#
# Byte layout (56 bytes):
#   +0   step_id_hi  (i64)
#   +8   step_id_lo  (i64)
#   +16  status      (i64 SzalStepStatus)
#   +24  output      (json_v*, Value::Null if no output)
#   +32  duration_ms (i64)
#   +40  attempts    (i64)
#   +48  error       (Str ptr, 0 = None)
enum StepResultL {
    STEPRESULT_SIZE = 56;
    SR_ID_HI = 0;
    SR_ID_LO = 8;
    SR_STATUS = 16;
    SR_OUTPUT = 24;
    SR_DURATION_MS = 32;
    SR_ATTEMPTS = 40;
    SR_ERROR = 48;
}

# Get the StepResult step id high half.
fn step_result_id_hi(r) { return load64(r + SR_ID_HI); }

# Get the StepResult step id low half.
fn step_result_id_lo(r) { return load64(r + SR_ID_LO); }

# Get the StepResult status (SzalStepStatus enum value).
fn step_result_status(r) { return load64(r + SR_STATUS); }

# Get the StepResult output (json_v*).
fn step_result_output(r) { return load64(r + SR_OUTPUT); }

# Get the StepResult duration_ms (i64).
fn step_result_duration_ms(r) { return load64(r + SR_DURATION_MS); }

# Get the StepResult attempts (i64).
fn step_result_attempts(r) { return load64(r + SR_ATTEMPTS); }

# Get the StepResult error message (Str ptr, 0 = None).
fn step_result_error(r) { return load64(r + SR_ERROR); }

# Allocate a StepResult. hi/lo are the StepId halves, status is a StepStatus, output is a
# json_v* (pass bayan_json_v_null() for "no output"), error is a Str/0. Returns 0 on OOM.
# szal-prefixed since 2.2.0: majra owns a 3-argument step_result_new.
fn szal_step_result_new(hi, lo, status, output, duration_ms, attempts) {
    var r = alloc(STEPRESULT_SIZE);
    if (r == 0) { return 0; }
    store64(r + SR_ID_HI, hi);
    store64(r + SR_ID_LO, lo);
    store64(r + SR_STATUS, status);
    store64(r + SR_OUTPUT, output);
    store64(r + SR_DURATION_MS, duration_ms);
    store64(r + SR_ATTEMPTS, attempts);
    store64(r + SR_ERROR, 0);
    return r;
}

# Set the error message (Str) on a StepResult. Returns r.
fn step_result_set_error(r, error) {
    if (r == 0) { return 0; }
    store64(r + SR_ERROR, error);
    return r;
}

# --- JSON (de)serialization ---

# Append "key":<json-value> into a json object value `obj`. key is a cstr; the value uses
# bayan json_v constructors. Internal helpers keep step_to_json readable.

# Build the id Str ("xxxxxxxx-...") for a step's id halves. Internal.
fn _step_id_str(hi, lo) {
    return uuid_to_str(hi, lo);
}

# Serialize a StepDef to a JSON object Str. Field set + order matches the Rust serde Serialize
# of StepDef: id, name, description, timeout_ms, max_retries, retry_delay_ms, backoff,
# rollbackable, step_type (skip if None), config (skip if None), condition (skip if None),
# depends_on, trigger_mode, sub_steps (skip if empty), hardware. id is the UUID string; backoff/
# trigger_mode/status are the PascalCase variant names; depends_on is an array of UUID strings;
# sub_steps is an array of nested StepDef objects (recursive). (step.rs derive(Serialize) +
# the #[serde(skip_serializing_if)] attributes on lines 129/132/136/145.)
fn step_to_json(s) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("id"),
      bayan_json_v_str_new(_step_id_str(step_id_hi(s), step_id_lo(s))));
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(step_name(s)));
    bayan_json_v_obj_set(o, str_from("description"),
      bayan_json_v_str_new(step_description(s)));
    bayan_json_v_obj_set(o, str_from("timeout_ms"),
      bayan_json_v_int_new(step_timeout_ms(s)));
    bayan_json_v_obj_set(o, str_from("max_retries"),
      bayan_json_v_int_new(step_max_retries(s)));
    bayan_json_v_obj_set(o, str_from("retry_delay_ms"),
      bayan_json_v_int_new(step_retry_delay_ms(s)));
    bayan_json_v_obj_set(o, str_from("backoff"),
      bayan_json_v_str_new(str_from(step_backoff_name(step_backoff(s)))));
    bayan_json_v_obj_set(o, str_from("rollbackable"),
      bayan_json_v_bool_new(step_rollbackable(s)));
    # step_type: skip_serializing_if = Option::is_none
    if (step_step_type(s) != 0) {
        bayan_json_v_obj_set(o, str_from("step_type"),
          bayan_json_v_str_new(step_step_type(s)));
    }
    # config: skip_serializing_if = Option::is_none
    if (step_config(s) != 0) {
        bayan_json_v_obj_set(o, str_from("config"), step_config(s));
    }
    # condition: skip_serializing_if = Option::is_none
    if (step_condition(s) != 0) {
        bayan_json_v_obj_set(o, str_from("condition"),
          bayan_json_v_str_new(step_condition(s)));
    }
    var deps = bayan_json_v_arr_new();
    var n = step_depends_on_len(s);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(deps,
          bayan_json_v_str_new(_step_id_str(step_depends_on_hi(s, i),
              step_depends_on_lo(s, i))));
        i = i + 1;
    }
    bayan_json_v_obj_set(o, str_from("depends_on"), deps);
    bayan_json_v_obj_set(o, str_from("trigger_mode"),
      bayan_json_v_str_new(str_from(step_trigger_name(step_trigger_mode(s)))));
    # sub_steps: skip_serializing_if = Vec::is_empty
    var subn = step_sub_steps_len(s);
    if (subn != 0) {
        var subs = bayan_json_v_arr_new();
        var j = 0;
        while (j < subn) {
            bayan_json_v_arr_push(subs,
              bayan_json_v_parse(step_to_json(step_sub_step_at(s, j))));
            j = j + 1;
        }
        bayan_json_v_obj_set(o, str_from("sub_steps"), subs);
    }
    bayan_json_v_obj_set(o, str_from("hardware"),
      bayan_json_v_int_new(step_hardware(s)));
    return bayan_json_v_build(o);
}

# Build a StepDef from a parsed json_v object with serde-default semantics: every optional /
# #[serde(default)] field falls back to the StepDef::new default rather than aborting. id parses
# from the UUID string (malformed -> a fresh generated id, matching the spirit of always having
# a valid StepId; documented in docs/development/parity-notes.md §3). Internal — step_from_json wraps the Str entry.
fn _step_from_v(o) {
    if (o == 0) { return 0; }
    var name_v = bayan_json_v_obj_get_by_cstr(o, "name");
    var name = str_from("");
    if (bayan_json_v_is_str(name_v) == 1) { name = bayan_json_v_str(name_v); }
    var s = step_new(name);
    if (s == 0) { return 0; }
    # id (parse the UUID string; malformed -> keep the fresh generated id)
    var id_v = bayan_json_v_obj_get_by_cstr(o, "id");
    if (bayan_json_v_is_str(id_v) == 1) {
        var hi, lo = uuid_parse(str_cstr(bayan_json_v_str(id_v)));
        if (uuid_parse_ok(hi, lo) == 1) {
            store64(s + SD_ID_HI, hi);
            store64(s + SD_ID_LO, lo);
        }
    }
    # description (default "")
    var desc_v = bayan_json_v_obj_get_by_cstr(o, "description");
    if (bayan_json_v_is_str(desc_v) == 1) {
        store64(s + SD_DESCRIPTION, bayan_json_v_str(desc_v));
    }
    # timeout_ms / max_retries / retry_delay_ms (defaults already set by step_new)
    var to_v = bayan_json_v_obj_get_by_cstr(o, "timeout_ms");
    if (bayan_json_v_is_int(to_v) == 1) {
        store64(s + SD_TIMEOUT_MS, bayan_json_v_int(to_v));
    }
    var mr_v = bayan_json_v_obj_get_by_cstr(o, "max_retries");
    if (bayan_json_v_is_int(mr_v) == 1) {
        store64(s + SD_MAX_RETRIES, bayan_json_v_int(mr_v));
    }
    var rd_v = bayan_json_v_obj_get_by_cstr(o, "retry_delay_ms");
    if (bayan_json_v_is_int(rd_v) == 1) {
        store64(s + SD_RETRY_DELAY_MS, bayan_json_v_int(rd_v));
    }
    # backoff (#[serde(default)] -> Fixed when missing/unknown)
    var bk_v = bayan_json_v_obj_get_by_cstr(o, "backoff");
    if (bayan_json_v_is_str(bk_v) == 1) {
        store64(s + SD_BACKOFF, step_backoff_from_name(bayan_json_v_str(bk_v)));
    }
    # rollbackable (default false)
    var rb_v = bayan_json_v_obj_get_by_cstr(o, "rollbackable");
    if (bayan_json_v_is_bool(rb_v) == 1) {
        store64(s + SD_ROLLBACKABLE, bayan_json_v_bool(rb_v));
    }
    # step_type (Option -> None when missing)
    var st_v = bayan_json_v_obj_get_by_cstr(o, "step_type");
    if (bayan_json_v_is_str(st_v) == 1) {
        store64(s + SD_STEP_TYPE, bayan_json_v_str(st_v));
    }
    # config (Option -> None when missing; keep the json_v subtree as-is)
    var cf_v = bayan_json_v_obj_get_by_cstr(o, "config");
    if (cf_v != 0) {
        store64(s + SD_CONFIG, cf_v);
    }
    # condition (Option -> None when missing)
    var cn_v = bayan_json_v_obj_get_by_cstr(o, "condition");
    if (bayan_json_v_is_str(cn_v) == 1) {
        store64(s + SD_CONDITION, bayan_json_v_str(cn_v));
    }
    # depends_on (array of UUID strings; default empty)
    var dep_v = bayan_json_v_obj_get_by_cstr(o, "depends_on");
    if (bayan_json_v_is_arr(dep_v) == 1) {
        var dn = bayan_json_v_arr_len(dep_v);
        var i = 0;
        while (i < dn) {
            var el = bayan_json_v_arr_get(dep_v, i);
            if (bayan_json_v_is_str(el) == 1) {
                var dh, dl = uuid_parse(str_cstr(bayan_json_v_str(el)));
                if (uuid_parse_ok(dh, dl) == 1) {
                    step_depends_on_add(s, dh, dl);
                }
            }
            i = i + 1;
        }
    }
    # trigger_mode (#[serde(default)] -> All when missing/unknown)
    var tm_v = bayan_json_v_obj_get_by_cstr(o, "trigger_mode");
    if (bayan_json_v_is_str(tm_v) == 1) {
        store64(s + SD_TRIGGER_MODE, step_trigger_from_name(bayan_json_v_str(tm_v)));
    }
    # sub_steps (#[serde(default)] -> empty when missing; recursive)
    var ss_v = bayan_json_v_obj_get_by_cstr(o, "sub_steps");
    if (bayan_json_v_is_arr(ss_v) == 1) {
        var sn = bayan_json_v_arr_len(ss_v);
        var j = 0;
        while (j < sn) {
            var sub = _step_from_v(bayan_json_v_arr_get(ss_v, j));
            if (sub != 0) { step_with_sub_step(s, sub); }
            j = j + 1;
        }
    }
    # hardware (#[serde(default)] -> REQ_NONE when missing)
    var hw_v = bayan_json_v_obj_get_by_cstr(o, "hardware");
    if (bayan_json_v_is_int(hw_v) == 1) {
        store64(s + SD_HARDWARE, bayan_json_v_int(hw_v));
    }
    return s;
}

# Deserialize a StepDef from a JSON object Str with serde-default semantics (missing backoff/
# trigger_mode/sub_steps/optionals default rather than fail). Returns 0 on parse failure.
fn step_from_json(json) {
    var o = bayan_json_v_parse(json);
    if (o == 0) { return 0; }
    return _step_from_v(o);
}

# Serialize a StepResult to a JSON object Str. Field set + order matches the Rust serde
# Serialize of StepResult: step_id (UUID string), status (PascalCase variant name), output
# (json_v subtree, null if absent), duration_ms, attempts, error (null when None). (step.rs
# 247-255 derive(Serialize) — StepResult has no skip attributes, so error serializes as null.)
fn step_result_to_json(r) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("step_id"),
      bayan_json_v_str_new(_step_id_str(step_result_id_hi(r), step_result_id_lo(r))));
    bayan_json_v_obj_set(o, str_from("status"),
      bayan_json_v_str_new(str_from(step_status_serde_name(step_result_status(r)))));
    var out = step_result_output(r);
    if (out == 0) { out = bayan_json_v_null(); }
    bayan_json_v_obj_set(o, str_from("output"), out);
    bayan_json_v_obj_set(o, str_from("duration_ms"),
      bayan_json_v_int_new(step_result_duration_ms(r)));
    bayan_json_v_obj_set(o, str_from("attempts"),
      bayan_json_v_int_new(step_result_attempts(r)));
    var err = step_result_error(r);
    if (err == 0) {
        bayan_json_v_obj_set(o, str_from("error"), bayan_json_v_null());
    } else {
        bayan_json_v_obj_set(o, str_from("error"), bayan_json_v_str_new(err));
    }
    return bayan_json_v_build(o);
}

# Build a StepResult from a parsed json_v object. Mirrors the StepResult serde Deserialize
# (step.rs 247-255): step_id (UUID string), status (PascalCase serde name), output (json_v
# subtree, Null when absent), duration_ms, attempts, error (Option<String>, None when null/
# absent). Uses the port-wide lenient-deserializer convention (shared with _step_from_v /
# _flow_from_v): every Rust-required field falls back to a default on missing/malformed input
# rather than erroring — missing/malformed id -> fresh StepId, missing status -> Pending,
# missing output -> Null, missing duration/attempts -> 0. Unobservable for real round-trips
# (step_result_to_json always emits every field); see docs/development/parity-notes.md §3.
# Internal; step_result_from_json wraps the Str entry. Returns 0 on OOM.
fn _step_result_from_v(o) {
    if (o == 0) { return 0; }
    # step_id (UUID string; missing/malformed -> fresh generated id)
    var hi, lo = szal_uuid_generate();
    var id_v = bayan_json_v_obj_get_by_cstr(o, "step_id");
    if (bayan_json_v_is_str(id_v) == 1) {
        var phi, plo = uuid_parse(str_cstr(bayan_json_v_str(id_v)));
        if (uuid_parse_ok(phi, plo) == 1) { hi = phi; lo = plo; }
    }
    # status (PascalCase serde name; missing/unknown -> Pending, per step_status_from_name)
    var status = STATUS_PENDING;
    var st_v = bayan_json_v_obj_get_by_cstr(o, "status");
    if (bayan_json_v_is_str(st_v) == 1) {
        status = step_status_from_name(bayan_json_v_str(st_v));
    }
    # output (json_v subtree; missing -> Null, mirroring step_result_to_json's null default)
    var out = bayan_json_v_obj_get_by_cstr(o, "output");
    if (out == 0) { out = bayan_json_v_null(); }
    # duration_ms / attempts (default 0)
    var dur = 0;
    var dur_v = bayan_json_v_obj_get_by_cstr(o, "duration_ms");
    if (bayan_json_v_is_int(dur_v) == 1) { dur = bayan_json_v_int(dur_v); }
    var att = 0;
    var att_v = bayan_json_v_obj_get_by_cstr(o, "attempts");
    if (bayan_json_v_is_int(att_v) == 1) { att = bayan_json_v_int(att_v); }
    var r = szal_step_result_new(hi, lo, status, out, dur, att);
    if (r == 0) { return 0; }
    # error (Option<String>; null/absent -> None)
    var err_v = bayan_json_v_obj_get_by_cstr(o, "error");
    if (bayan_json_v_is_str(err_v) == 1) {
        step_result_set_error(r, bayan_json_v_str(err_v));
    }
    return r;
}

# Deserialize a StepResult from a JSON object Str. Inverse of step_result_to_json. Returns 0 on
# parse failure / OOM.
fn step_result_from_json(json) {
    var o = bayan_json_v_parse(json);
    if (o == 0) { return 0; }
    return _step_result_from_v(o);
}

# --- condition.cyr ---

# condition.cyr — workflow step condition DSL: tokenizer, parser, evaluator, cache, templates
#
# Ports rust-old/src/condition.rs (the condition expression evaluator). Evaluates predicate
# expressions against a JSON context (bayan json_v tree) built from step results.
#
# Grammar (low -> high precedence):
#   expr     = or_expr
#   or_expr  = and_expr ("||" and_expr)*
#   and_expr = cmp_expr ("&&" cmp_expr)*
#   cmp_expr = value (("==" | "!=" | ">" | ">=" | "<" | "<=") value)?
#   value    = "!" value | path | string_lit | number_lit | bool_lit | "(" expr ")"
#   path     = ident ("." ident)*
#   ident    = [a-zA-Z_][a-zA-Z0-9_-]*
#   string_lit = "'" [^']* "'"
#   number_lit = [0-9]+ ("." [0-9]+)?
#   bool_lit = "true" | "false"
#
# Usage: include "src/condition.cyr"
# Requires: lib/str.cyr (Str + builder), lib/vec.cyr, lib/hashmap.cyr (map_new cstr keys),
#   lib/alloc.cyr (alloc_init before any constructor), lib/result.cyr (Ok/Err + helpers),
#   lib/bayan.cyr (json_v tree; lib/io must precede lib/bayan), src/error.cyr (SzalErr),
#   src/uuid.cyr + src/step.cyr (StepResult/StepDef accessors for build_step_context).
# Naming: every public symbol is cond_/tok_/expr_/compiled_/cache_-prefixed; internals use _.
#
# Error model: Rust returned Result<_, String> with rich messages. Here a parse/compile error is
# Err(SZAL_ERR_FLOW_INVALID) with the human message in the szal global last-error buffer (szal_err).
# This is the engine-wide flatten (port-plan §1.6); the message text matches Rust verbatim where
# a fixed string, and is formatted with str_builder where Rust interpolated.

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------

# Token kinds. The Rust Token enum variants flatten to these integer kinds. A token is a heap
# blob {kind@0, payload@8}: for TOK_PATH / TOK_STRING the payload is a Str ptr; for TOK_NUMBER
# the payload is an f64 bit pattern; for TOK_BOOL the payload is 1/0; for operators the payload
# is unused (0).
enum CondTok {
    TOK_PATH = 0;
    TOK_STRING = 1;
    TOK_NUMBER = 2;
    TOK_BOOL = 3;
    TOK_EQ = 4;
    TOK_NEQ = 5;
    TOK_GT = 6;
    TOK_GTE = 7;
    TOK_LT = 8;
    TOK_LTE = 9;
    TOK_NOT = 10;
    TOK_AND = 11;
    TOK_OR = 12;
    TOK_LPAREN = 13;
    TOK_RPAREN = 14;
}

# Token byte layout (16 bytes): kind@0, payload@8.
enum CondTokL { TOKEN_SIZE = 16; TK_KIND = 0; TK_PAYLOAD = 8; }

# Allocate a token blob with the given kind and payload. Returns 0 on OOM. Internal.
fn _tok_new(kind, payload) {
    var t = alloc(TOKEN_SIZE);
    if (t == 0) { return 0; }
    store64(t + TK_KIND, kind);
    store64(t + TK_PAYLOAD, payload);
    return t;
}

# Get a token's kind (CondTok value).
fn tok_kind(t) { return load64(t + TK_KIND); }

# Get a token's payload (Str ptr / f64 bits / bool / 0 depending on kind).
fn tok_payload(t) { return load64(t + TK_PAYLOAD); }

# ---------------------------------------------------------------------------
# Tokenizer
# ---------------------------------------------------------------------------

# True if byte b is ASCII whitespace (space, tab, LF, CR, FF, VT) — Rust is_ascii_whitespace.
fn _cond_is_ws(b) {
    if (b == 32) { return 1; }
    if (b == 9) { return 1; }
    if (b == 10) { return 1; }
    if (b == 13) { return 1; }
    if (b == 12) { return 1; }
    if (b == 11) { return 1; }
    return 0;
}

# True if byte b is an ASCII digit '0'..'9'.
fn _cond_is_digit(b) {
    if ((b >= 48) && (b <= 57)) { return 1; }
    return 0;
}

# True if byte b is ASCII alphabetic A-Z / a-z.
fn _cond_is_alpha(b) {
    if ((b >= 65) && (b <= 90)) { return 1; }
    if ((b >= 97) && (b <= 122)) { return 1; }
    return 0;
}

# True if byte b is alphanumeric (Rust is_ascii_alphanumeric).
fn _cond_is_alnum(b) {
    if (_cond_is_alpha(b) == 1) { return 1; }
    if (_cond_is_digit(b) == 1) { return 1; }
    return 0;
}

# True if byte b < 128 (Rust is_ascii).
fn _cond_is_ascii(b) {
    if ((b >= 0) && (b < 128)) { return 1; }
    return 0;
}

# Emit a two-hex-digit lowercase byte (e.g. 0x0a) into a str_builder. Internal — used to mirror
# Rust's `unexpected byte 0x{b:02x}` message for non-ASCII bytes.
fn _cond_emit_hex2(sb, b) {
    var hi = (b >> 4) & 15;
    var lo = b & 15;
    if (hi < 10) { str_builder_add_byte(sb, 48 + hi); }
    else { str_builder_add_byte(sb, 87 + hi); }
    if (lo < 10) { str_builder_add_byte(sb, 48 + lo); }
    else { str_builder_add_byte(sb, 87 + lo); }
    return 0;
}

# Parse the digits-with-optional-fraction byte range [start, end) into an f64 bit pattern. The
# tokenizer guarantees the range matches [0-9]+ ("." [0-9]+)? (no sign, no exponent), so a plain
# integer-part + fractional-part f64 accumulation matches Rust's f64 parse for this grammar.
# Uses only the f64 arithmetic builtins (no math.cyr dependency). Internal.
fn _cond_parse_num(bytes, start, end) {
    var result = f64_from(0);
    var ten = f64_from(10);
    var i = start;
    while (i < end) {
        var c = load8(bytes + i);
        if (c == 46) {
            i = i + 1;
            var scale = f64_from(1);
            while (i < end) {
                var fc = load8(bytes + i);
                scale = f64_div(scale, ten);
                result = f64_add(result, f64_mul(f64_from(fc - 48), scale));
                i = i + 1;
            }
            return result;
        }
        result = f64_add(f64_mul(result, ten), f64_from(c - 48));
        i = i + 1;
    }
    return result;
}

# Tokenize an input Str into a vec of token blobs. On success returns Ok(vec). On a lexical error
# returns Err(SZAL_ERR_FLOW_INVALID) with the message set in the szal last-error buffer (matching the
# Rust error strings: "unterminated string literal", "invalid number '...': ...",
# "unexpected character '...'", "unexpected byte 0x..").
fn _cond_tokenize(input) {
    var tokens = vec_new();
    var bytes = str_data(input);
    var len = str_len(input);
    var i = 0;
    while (i < len) {
        var b = load8(bytes + i);
        # Whitespace
        if (_cond_is_ws(b) == 1) {
            i = i + 1;
            continue;
        }
        # Two-char operators
        if (i + 1 < len) {
            var b2 = load8(bytes + i + 1);
            if ((b == 61) && (b2 == 61)) { vec_push(tokens, _tok_new(TOK_EQ, 0)); i = i + 2; continue; }
            if ((b == 33) && (b2 == 61)) { vec_push(tokens, _tok_new(TOK_NEQ, 0)); i = i + 2; continue; }
            if ((b == 62) && (b2 == 61)) { vec_push(tokens, _tok_new(TOK_GTE, 0)); i = i + 2; continue; }
            if ((b == 60) && (b2 == 61)) { vec_push(tokens, _tok_new(TOK_LTE, 0)); i = i + 2; continue; }
            if ((b == 38) && (b2 == 38)) { vec_push(tokens, _tok_new(TOK_AND, 0)); i = i + 2; continue; }
            if ((b == 124) && (b2 == 124)) { vec_push(tokens, _tok_new(TOK_OR, 0)); i = i + 2; continue; }
        }
        # Single-char operators: >, <, !
        if (b == 62) { vec_push(tokens, _tok_new(TOK_GT, 0)); i = i + 1; continue; }
        if (b == 60) { vec_push(tokens, _tok_new(TOK_LT, 0)); i = i + 1; continue; }
        if (b == 33) { vec_push(tokens, _tok_new(TOK_NOT, 0)); i = i + 1; continue; }
        # Parentheses
        if (b == 40) { vec_push(tokens, _tok_new(TOK_LPAREN, 0)); i = i + 1; continue; }
        if (b == 41) { vec_push(tokens, _tok_new(TOK_RPAREN, 0)); i = i + 1; continue; }
        # String literal (single-quoted)
        if (b == 39) {
            i = i + 1;
            var start = i;
            while ((i < len) && (load8(bytes + i) != 39)) {
                i = i + 1;
            }
            if (i >= len) {
                return szal_err(SZAL_ERR_FLOW_INVALID, str_from("unterminated string literal"));
            }
            var s = str_new(bytes + start, i - start);
            vec_push(tokens, _tok_new(TOK_STRING, s));
            i = i + 1;
            continue;
        }
        # Number literal
        if (_cond_is_digit(b) == 1) {
            var nstart = i;
            while ((i < len) && (_cond_is_digit(load8(bytes + i)) == 1)) {
                i = i + 1;
            }
            if ((i < len) && (load8(bytes + i) == 46) && (i + 1 < len)
              && (_cond_is_digit(load8(bytes + i + 1)) == 1)) {
                i = i + 1;
                while ((i < len) && (_cond_is_digit(load8(bytes + i)) == 1)) {
                    i = i + 1;
                }
            }
            var fbits = _cond_parse_num(bytes, nstart, i);
            vec_push(tokens, _tok_new(TOK_NUMBER, fbits));
            continue;
        }
        # Identifier / path / bool literal
        if ((_cond_is_alpha(b) == 1) || (b == 95)) {
            var wstart = i;
            while (i < len) {
                var wb = load8(bytes + i);
                if ((_cond_is_alnum(wb) == 1) || (wb == 95) || (wb == 45) || (wb == 46)) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            var word = str_new(bytes + wstart, i - wstart);
            if (str_eq_cstr(word, "true") == 1) {
                vec_push(tokens, _tok_new(TOK_BOOL, 1));
            } elif (str_eq_cstr(word, "false") == 1) {
                vec_push(tokens, _tok_new(TOK_BOOL, 0));
            } else {
                vec_push(tokens, _tok_new(TOK_PATH, word));
            }
            continue;
        }
        # Unexpected byte
        if (_cond_is_ascii(b) == 1) {
            var sbc = str_builder_new();
            str_builder_add_cstr(sbc, "unexpected character '");
            str_builder_add_byte(sbc, b);
            str_builder_add_cstr(sbc, "'");
            return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sbc));
        }
        var sbx = str_builder_new();
        str_builder_add_cstr(sbx, "unexpected byte 0x");
        _cond_emit_hex2(sbx, b);
        return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sbx));
    }
    return Ok(tokens);
}

# ---------------------------------------------------------------------------
# AST
# ---------------------------------------------------------------------------

# Expr kinds. The Rust Expr enum flattens to these integer kinds. An Expr is a heap blob
# {kind@0, a@8, b@16}: for EXPR_LITERAL a = json_v ptr; for EXPR_PATH a = Str ptr (the path);
# for binary ops a/b = child Expr ptrs; for EXPR_NOT a = the single child Expr ptr.
enum CondExpr {
    EXPR_LITERAL = 0;
    EXPR_PATH = 1;
    EXPR_EQ = 2;
    EXPR_NEQ = 3;
    EXPR_GT = 4;
    EXPR_GTE = 5;
    EXPR_LT = 6;
    EXPR_LTE = 7;
    EXPR_NOT = 8;
    EXPR_AND = 9;
    EXPR_OR = 10;
}

# Expr byte layout (24 bytes): kind@0, a@8, b@16.
enum CondExprL { EXPR_SIZE = 24; EX_KIND = 0; EX_A = 8; EX_B = 16; }

# Allocate an Expr blob. Returns 0 on OOM. Internal.
fn _expr_new(kind, a, b) {
    var e = alloc(EXPR_SIZE);
    if (e == 0) { return 0; }
    store64(e + EX_KIND, kind);
    store64(e + EX_A, a);
    store64(e + EX_B, b);
    return e;
}

# Get an Expr's kind (CondExpr value).
fn expr_kind(e) { return load64(e + EX_KIND); }

# Get an Expr's first child / payload (json_v / Str / Expr ptr depending on kind).
fn expr_a(e) { return load64(e + EX_A); }

# Get an Expr's second child (Expr ptr; only meaningful for binary ops).
fn expr_b(e) { return load64(e + EX_B); }

# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------

# Parser state — a heap blob {tokens@0 (vec), pos@8}. Mirrors the Rust Parser struct.
enum CondParserL { PARSER_SIZE = 16; PS_TOKENS = 0; PS_POS = 8; }

# Allocate a parser over a token vec. Internal.
fn _parser_new(tokens) {
    var p = alloc(PARSER_SIZE);
    if (p == 0) { return 0; }
    store64(p + PS_TOKENS, tokens);
    store64(p + PS_POS, 0);
    return p;
}

# Peek at the current token, or 0 if at end. Internal.
fn _parser_peek(p) {
    var tokens = load64(p + PS_TOKENS);
    var pos = load64(p + PS_POS);
    if (pos < vec_len(tokens)) {
        return vec_get(tokens, pos);
    }
    return 0;
}

# Return the kind of the current token, or (0 - 1) if at end. Internal.
fn _parser_peek_kind(p) {
    var t = _parser_peek(p);
    if (t == 0) { return (0 - 1); }
    return tok_kind(t);
}

# Advance past the current token, returning it (or 0 if at end). Internal.
fn _parser_advance(p) {
    var tokens = load64(p + PS_TOKENS);
    var pos = load64(p + PS_POS);
    if (pos < vec_len(tokens)) {
        var t = vec_get(tokens, pos);
        store64(p + PS_POS, pos + 1);
        return t;
    }
    return 0;
}

# parse_or — lowest precedence. Returns Ok(Expr) or Err. Internal.
fn _parse_or(p) {
    var left = _parse_and(p)?;
    while (_parser_peek_kind(p) == TOK_OR) {
        _parser_advance(p);
        var right = _parse_and(p)?;
        left = _expr_new(EXPR_OR, left, right);
    }
    return Ok(left);
}

# parse_and — binds tighter than OR. Returns Ok(Expr) or Err. Internal.
fn _parse_and(p) {
    var left = _parse_cmp(p)?;
    while (_parser_peek_kind(p) == TOK_AND) {
        _parser_advance(p);
        var right = _parse_cmp(p)?;
        left = _expr_new(EXPR_AND, left, right);
    }
    return Ok(left);
}

# parse_cmp — a single optional comparison between two values. Returns Ok(Expr) or Err. Internal.
fn _parse_cmp(p) {
    var left = _parse_value(p)?;
    var k = _parser_peek_kind(p);
    if (k == TOK_EQ) {
        _parser_advance(p);
        var r = _parse_value(p)?;
        return Ok(_expr_new(EXPR_EQ, left, r));
    }
    if (k == TOK_NEQ) {
        _parser_advance(p);
        var r2 = _parse_value(p)?;
        return Ok(_expr_new(EXPR_NEQ, left, r2));
    }
    if (k == TOK_GT) {
        _parser_advance(p);
        var r3 = _parse_value(p)?;
        return Ok(_expr_new(EXPR_GT, left, r3));
    }
    if (k == TOK_GTE) {
        _parser_advance(p);
        var r4 = _parse_value(p)?;
        return Ok(_expr_new(EXPR_GTE, left, r4));
    }
    if (k == TOK_LT) {
        _parser_advance(p);
        var r5 = _parse_value(p)?;
        return Ok(_expr_new(EXPR_LT, left, r5));
    }
    if (k == TOK_LTE) {
        _parser_advance(p);
        var r6 = _parse_value(p)?;
        return Ok(_expr_new(EXPR_LTE, left, r6));
    }
    return Ok(left);
}

# parse_value — unary not, literals, paths, parens. Returns Ok(Expr) or Err. Internal.
fn _parse_value(p) {
    # Prefix `!` (not)
    if (_parser_peek_kind(p) == TOK_NOT) {
        _parser_advance(p);
        var inner = _parse_value(p)?;
        return Ok(_expr_new(EXPR_NOT, inner, 0));
    }
    var t = _parser_peek(p);
    if (t == 0) {
        return szal_err(SZAL_ERR_FLOW_INVALID, str_from("unexpected end of expression"));
    }
    var k = tok_kind(t);
    if (k == TOK_STRING) {
        _parser_advance(p);
        return Ok(_expr_new(EXPR_LITERAL, bayan_json_v_str_new(tok_payload(t)), 0));
    }
    if (k == TOK_NUMBER) {
        _parser_advance(p);
        return Ok(_expr_new(EXPR_LITERAL, bayan_json_v_float_new(tok_payload(t)), 0));
    }
    if (k == TOK_BOOL) {
        _parser_advance(p);
        return Ok(_expr_new(EXPR_LITERAL, bayan_json_v_bool_new(tok_payload(t)), 0));
    }
    if (k == TOK_PATH) {
        _parser_advance(p);
        return Ok(_expr_new(EXPR_PATH, tok_payload(t), 0));
    }
    if (k == TOK_LPAREN) {
        _parser_advance(p);
        var e = _parse_or(p)?;
        var nxt = _parser_advance(p);
        if ((nxt != 0) && (tok_kind(nxt) == TOK_RPAREN)) {
            return Ok(e);
        }
        return szal_err(SZAL_ERR_FLOW_INVALID, str_from("expected ')'"));
    }
    # Unexpected token. Rust prints "unexpected token: <Debug>"; we name the kind.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "unexpected token: ");
    str_builder_add_cstr(sb, _cond_tok_name(k));
    return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sb));
}

# Map a token kind to a human name for error messages (port-introduced; Rust used {tok:?}).
fn _cond_tok_name(k) {
    if (k == TOK_PATH) { return "path"; }
    if (k == TOK_STRING) { return "string"; }
    if (k == TOK_NUMBER) { return "number"; }
    if (k == TOK_BOOL) { return "bool"; }
    if (k == TOK_EQ) { return "=="; }
    if (k == TOK_NEQ) { return "!="; }
    if (k == TOK_GT) { return ">"; }
    if (k == TOK_GTE) { return ">="; }
    if (k == TOK_LT) { return "<"; }
    if (k == TOK_LTE) { return "<="; }
    if (k == TOK_NOT) { return "!"; }
    if (k == TOK_AND) { return "&&"; }
    if (k == TOK_OR) { return "||"; }
    if (k == TOK_LPAREN) { return "("; }
    if (k == TOK_RPAREN) { return ")"; }
    return "?";
}

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------

# resolve_path(path, context) -> json_v. Walks the JSON tree segment by segment splitting on
# '.'. Returns a JSON null value (a fresh JTAG_NULL) if any segment is missing or a segment
# walks into a non-object. Mirrors Rust resolve_path (returns &Value::Null on miss).
fn cond_resolve_path(path, context) {
    var current = context;
    var data = str_data(path);
    var len = str_len(path);
    var seg_start = 0;
    var i = 0;
    while (i <= len) {
        if ((i == len) || (load8(data + i) == 46)) {
            # segment is [seg_start, i)
            var seg = str_new(data + seg_start, i - seg_start);
            var nxt = bayan_json_v_obj_get_by_cstr(current, str_cstr(seg));
            if (nxt == 0) {
                return bayan_json_v_null();
            }
            current = nxt;
            seg_start = i + 1;
        }
        i = i + 1;
    }
    return current;
}

# Compare two json_v values for equality. Same-type comparisons use structural equality; numbers
# compare numerically as f64 (see docs/development/parity-notes.md §5). Cross-type comparisons return 0. Mirrors Rust
# values_equal. Internal.
fn _cond_values_equal(a, b) {
    if (bayan_json_v_is_str(a) == 1) {
        if (bayan_json_v_is_str(b) == 1) {
            return str_eq(bayan_json_v_str(a), bayan_json_v_str(b));
        }
        return 0;
    }
    if (_cond_is_number(a) == 1) {
        if (_cond_is_number(b) == 1) {
            return f64_eq(bayan_json_v_float(a), bayan_json_v_float(b));
        }
        return 0;
    }
    if (bayan_json_v_is_bool(a) == 1) {
        if (bayan_json_v_is_bool(b) == 1) {
            if (bayan_json_v_bool(a) == bayan_json_v_bool(b)) { return 1; }
            return 0;
        }
        return 0;
    }
    if (bayan_json_v_is_null(a) == 1) {
        if (bayan_json_v_is_null(b) == 1) { return 1; }
        return 0;
    }
    return 0;
}

# True if v is a JSON number (int or float tag). Internal.
fn _cond_is_number(v) {
    if (bayan_json_v_is_int(v) == 1) { return 1; }
    if (bayan_json_v_is_float(v) == 1) { return 1; }
    return 0;
}

# Compare two json_v values for ordering. Returns (0 - 2) for "incomparable" (Rust None), else
# (0 - 1)/0/1 for Less/Equal/Greater. Numbers compare numerically; strings lexicographically.
# Cross-type returns incomparable. Mirrors Rust values_compare. Internal.
fn _cond_values_compare(a, b) {
    if ((_cond_is_number(a) == 1) && (_cond_is_number(b) == 1)) {
        var af = bayan_json_v_float(a);
        var bf = bayan_json_v_float(b);
        if (f64_lt(af, bf) == 1) { return (0 - 1); }
        if (f64_gt(af, bf) == 1) { return 1; }
        if (f64_eq(af, bf) == 1) { return 0; }
        return (0 - 2);
    }
    if ((bayan_json_v_is_str(a) == 1) && (bayan_json_v_is_str(b) == 1)) {
        return _cond_str_cmp(bayan_json_v_str(a), bayan_json_v_str(b));
    }
    return (0 - 2);
}

# Lexicographic byte comparison of two Strs: (0 - 1)/0/1. Mirrors Rust str Ord (byte order).
# Internal.
fn _cond_str_cmp(a, b) {
    var ad = str_data(a);
    var al = str_len(a);
    var bd = str_data(b);
    var bl = str_len(b);
    var n = al;
    if (bl < n) { n = bl; }
    var i = 0;
    while (i < n) {
        var ca = load8(ad + i);
        var cb = load8(bd + i);
        if (ca < cb) { return (0 - 1); }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (al < bl) { return (0 - 1); }
    if (al > bl) { return 1; }
    return 0;
}

# Determine the truthiness of a json_v value. Mirrors Rust is_truthy: bool -> itself; null ->
# false; string -> non-empty; number -> != 0.0; array -> non-empty; object -> non-empty.
fn cond_is_truthy(v) {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_bool(v) == 1) { return bayan_json_v_bool(v); }
    if (bayan_json_v_is_null(v) == 1) { return 0; }
    if (bayan_json_v_is_str(v) == 1) {
        if (str_len(bayan_json_v_str(v)) > 0) { return 1; }
        return 0;
    }
    if (_cond_is_number(v) == 1) {
        if (f64_eq(bayan_json_v_float(v), f64_from(0)) == 1) { return 0; }
        return 1;
    }
    if (bayan_json_v_is_arr(v) == 1) {
        if (bayan_json_v_arr_len(v) > 0) { return 1; }
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 1) {
        if (bayan_json_v_obj_len(v) > 0) { return 1; }
        return 0;
    }
    return 0;
}

# Evaluate an Expr against a json_v context, returning a json_v value (never errors — Rust's
# eval_expr is infallible once the AST is built). Mirrors Rust eval_expr. Internal.
fn _cond_eval(e, context) {
    var k = expr_kind(e);
    if (k == EXPR_LITERAL) {
        return expr_a(e);
    }
    if (k == EXPR_PATH) {
        return cond_resolve_path(expr_a(e), context);
    }
    if (k == EXPR_EQ) {
        var l = _cond_eval(expr_a(e), context);
        var r = _cond_eval(expr_b(e), context);
        return bayan_json_v_bool_new(_cond_values_equal(l, r));
    }
    if (k == EXPR_NEQ) {
        var l2 = _cond_eval(expr_a(e), context);
        var r2 = _cond_eval(expr_b(e), context);
        if (_cond_values_equal(l2, r2) == 1) { return bayan_json_v_bool_new(0); }
        return bayan_json_v_bool_new(1);
    }
    if (k == EXPR_GT) {
        var lg = _cond_eval(expr_a(e), context);
        var rg = _cond_eval(expr_b(e), context);
        if (_cond_values_compare(lg, rg) == 1) { return bayan_json_v_bool_new(1); }
        return bayan_json_v_bool_new(0);
    }
    if (k == EXPR_GTE) {
        var lge = _cond_eval(expr_a(e), context);
        var rge = _cond_eval(expr_b(e), context);
        var cge = _cond_values_compare(lge, rge);
        if ((cge == 1) || (cge == 0)) { return bayan_json_v_bool_new(1); }
        return bayan_json_v_bool_new(0);
    }
    if (k == EXPR_LT) {
        var lt = _cond_eval(expr_a(e), context);
        var rt = _cond_eval(expr_b(e), context);
        if (_cond_values_compare(lt, rt) == (0 - 1)) { return bayan_json_v_bool_new(1); }
        return bayan_json_v_bool_new(0);
    }
    if (k == EXPR_LTE) {
        var lle = _cond_eval(expr_a(e), context);
        var rle = _cond_eval(expr_b(e), context);
        var cle = _cond_values_compare(lle, rle);
        if ((cle == (0 - 1)) || (cle == 0)) { return bayan_json_v_bool_new(1); }
        return bayan_json_v_bool_new(0);
    }
    if (k == EXPR_NOT) {
        var v = _cond_eval(expr_a(e), context);
        if (cond_is_truthy(v) == 1) { return bayan_json_v_bool_new(0); }
        return bayan_json_v_bool_new(1);
    }
    if (k == EXPR_AND) {
        if (cond_is_truthy(_cond_eval(expr_a(e), context)) == 0) {
            return bayan_json_v_bool_new(0);
        }
        return bayan_json_v_bool_new(cond_is_truthy(_cond_eval(expr_b(e), context)));
    }
    if (k == EXPR_OR) {
        if (cond_is_truthy(_cond_eval(expr_a(e), context)) == 1) {
            return bayan_json_v_bool_new(1);
        }
        return bayan_json_v_bool_new(cond_is_truthy(_cond_eval(expr_b(e), context)));
    }
    return bayan_json_v_null();
}

# ---------------------------------------------------------------------------
# Compilation
# ---------------------------------------------------------------------------

# CompiledCondition — heap blob {source@0 (Str), ast@8 (Expr ptr)}. Mirrors the Rust struct.
enum CondCompiledL { SZAL_CONDITION_SIZE = 16; SZAL_CC_SOURCE = 0; SZAL_CC_AST = 8; }

# Get the compiled condition's (trimmed) source Str.
fn szal_condition_source(c) { return load64(c + SZAL_CC_SOURCE); }

# Get the compiled condition's AST Expr ptr.
fn szal_condition_ast(c) { return load64(c + SZAL_CC_AST); }

# Compile a condition expression (Str) into a reusable CompiledCondition. An empty or
# whitespace-only expression compiles to a vacuously-true literal with an empty source. Returns
# Err(SZAL_ERR_FLOW_INVALID) (message in the szal last-error buffer) on a malformed expression or
# trailing tokens. Mirrors Rust CompiledCondition::compile.
fn szal_condition_compile(expr) {
    var trimmed = str_trim(expr);
    if (str_len(trimmed) == 0) {
        var c0 = alloc(SZAL_CONDITION_SIZE);
        if (c0 == 0) { return szal_err(SZAL_ERR_OTHER, str_from("out of memory")); }
        store64(c0 + SZAL_CC_SOURCE, str_from(""));
        store64(c0 + SZAL_CC_AST, _expr_new(EXPR_LITERAL, bayan_json_v_bool_new(1), 0));
        return Ok(c0);
    }
    var tokens = _cond_tokenize(trimmed)?;
    var p = _parser_new(tokens);
    var ast = _parse_or(p)?;
    var pos = load64(p + PS_POS);
    if (pos < vec_len(tokens)) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "unexpected trailing token: ");
        str_builder_add_cstr(sb, _cond_tok_name(tok_kind(vec_get(tokens, pos))));
        return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sb));
    }
    var c = alloc(SZAL_CONDITION_SIZE);
    if (c == 0) { return szal_err(SZAL_ERR_OTHER, str_from("out of memory")); }
    store64(c + SZAL_CC_SOURCE, trimmed);
    store64(c + SZAL_CC_AST, ast);
    return Ok(c);
}

# Evaluate a compiled condition against a json_v context. Returns Ok(1)/Ok(0). Never errors once
# compiled. Mirrors Rust CompiledCondition::evaluate.
fn szal_condition_evaluate(c, context) {
    return Ok(cond_is_truthy(_cond_eval(szal_condition_ast(c), context)));
}

# Evaluate a condition expression (Str) against a json_v context. Compiles then evaluates. An
# empty expression is vacuously true. Returns Ok(1)/Ok(0) or Err. Mirrors Rust evaluate().
fn cond_evaluate(expr, context) {
    var c = szal_condition_compile(expr)?;
    return szal_condition_evaluate(c, context);
}

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# A cache entry — heap blob {is_err@0, payload@8}: is_err 0 -> payload is a CompiledCondition;
# is_err 1 -> payload is the error message Str. Mirrors Rust Arc<Result<CompiledCondition,String>>.
enum CondCacheEntryL { SZAL_COND_CACHE_ENTRY_SIZE = 16; SZAL_CE_IS_ERR = 0; SZAL_CE_PAYLOAD = 8; }

# ConditionCache — heap blob {map@0}. The map is cstr-keyed (map_new) by ORIGINAL (untrimmed)
# expression, matching Rust which keyed by `expr.to_owned()`. Caches both successful compilations
# and parse errors. NOTE: single-threaded for M1 — must be mutex-guarded once engine threads
# share it (Rust used RwLock; see todo).
enum CondCacheL { SZAL_COND_CACHE_SIZE = 8; SZAL_COND_CACHE_MAP = 0; }

# Create an empty condition cache. Returns 0 on OOM. Mirrors ConditionCache::new.
fn szal_condition_cache_new() {
    var c = alloc(SZAL_COND_CACHE_SIZE);
    if (c == 0) { return 0; }
    store64(c + SZAL_COND_CACHE_MAP, map_new());
    return c;
}

# Get (or compile + cache) the entry for expr (Str). Returns a cache-entry blob. Internal.
fn _cache_compiled(cache, expr) {
    var m = load64(cache + SZAL_COND_CACHE_MAP);
    var key = str_cstr(expr);
    var hit = map_get(m, key);
    if (hit != 0) {
        return hit;
    }
    var entry = alloc(SZAL_COND_CACHE_ENTRY_SIZE);
    if (entry == 0) { return 0; }
    var r_t, r_v = szal_condition_compile(expr);
    if (is_err_result(r_t) == 1) {
        store64(entry + SZAL_CE_IS_ERR, 1);
        store64(entry + SZAL_CE_PAYLOAD, szal_get_err_msg());
    } else {
        store64(entry + SZAL_CE_IS_ERR, 0);
        store64(entry + SZAL_CE_PAYLOAD, result_unwrap(r_t, r_v));
    }
    map_set(m, key, entry);
    return entry;
}

# Evaluate expr (Str) against a json_v context using the cache, compiling + caching on first use.
# Returns Ok(1)/Ok(0) or re-raises the cached Err (re-setting the last-error buffer from the
# cached message). Mirrors Rust ConditionCache::evaluate.
fn szal_condition_cache_evaluate(cache, expr, context) {
    var entry = _cache_compiled(cache, expr);
    if (entry == 0) { return szal_err(SZAL_ERR_OTHER, str_from("out of memory")); }
    if (load64(entry + SZAL_CE_IS_ERR) == 1) {
        return szal_err(SZAL_ERR_FLOW_INVALID, load64(entry + SZAL_CE_PAYLOAD));
    }
    return szal_condition_evaluate(load64(entry + SZAL_CE_PAYLOAD), context);
}

# Number of distinct expressions cached. Mirrors ConditionCache::len.
fn szal_condition_cache_len(cache) {
    return map_count(load64(cache + SZAL_COND_CACHE_MAP));
}

# Whether the cache is empty (1/0). Mirrors ConditionCache::is_empty.
fn szal_condition_cache_is_empty(cache) {
    if (szal_condition_cache_len(cache) == 0) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# Template rendering
# ---------------------------------------------------------------------------

# Render a template Str by resolving {{dot.path}} placeholders against a json_v context. Missing
# paths -> empty string; a string value -> its raw content; any other JSON value -> its JSON
# serialization. Literal text (including non-ASCII bytes) is copied verbatim. Mirrors Rust
# render_template.
fn cond_render_template(template, context) {
    var sb = str_builder_new();
    var bytes = str_data(template);
    var len = str_len(template);
    var i = 0;
    while (i < len) {
        if ((i + 1 < len) && (load8(bytes + i) == 123) && (load8(bytes + i + 1) == 123)) {
            # find closing }} starting at i+2
            var end = _cond_find_close(bytes, i + 2, len);
            if (end != (0 - 1)) {
                # path is bytes[i+2 .. end], trimmed
                var raw = str_new(bytes + i + 2, end - (i + 2));
                var path = str_trim(raw);
                var resolved = cond_resolve_path(path, context);
                if (bayan_json_v_is_null(resolved) == 1) {
                    # missing path -> empty (append nothing)
                } elif (bayan_json_v_is_str(resolved) == 1) {
                    str_builder_add(sb, bayan_json_v_str(resolved));
                } else {
                    str_builder_add(sb, bayan_json_v_build(resolved));
                }
                i = end + 2;
                continue;
            }
        }
        str_builder_add_byte(sb, load8(bytes + i));
        i = i + 1;
    }
    return str_builder_build(sb);
}

# Find the byte offset of the next "}}" at or after `from`, scanning up to `len`. Returns the
# offset of the first '}' of the pair, or (0 - 1) if not found. Internal.
fn _cond_find_close(bytes, from, len) {
    var i = from;
    while (i + 1 < len) {
        if ((load8(bytes + i) == 125) && (load8(bytes + i + 1) == 125)) {
            return i;
        }
        i = i + 1;
    }
    return (0 - 1);
}

# ---------------------------------------------------------------------------
# Step context builder
# ---------------------------------------------------------------------------

# Build a step-result context json_v for condition evaluation, shaped:
#   { "steps": { "<name>": { "status": "<display>", "output": <value>, "error": <str|null> } } }
# Maps each StepResult's step_id back to its name via the StepDef slice; results referencing an
# unknown step id are skipped. `results` and `steps` are vecs of StepResult / StepDef ptrs.
# status is the Display (snake_case) form (matches Rust result.status.to_string()). Mirrors Rust
# build_step_context.
fn cond_build_step_context(results, steps) {
    var steps_obj = bayan_json_v_obj_new();
    var nres = vec_len(results);
    var i = 0;
    while (i < nres) {
        var r = vec_get(results, i);
        var name = _cond_name_for_id(steps, step_result_id_hi(r), step_result_id_lo(r));
        if (name != 0) {
            var entry = bayan_json_v_obj_new();
            bayan_json_v_obj_set(entry, str_from("status"),
              bayan_json_v_str_new(str_from(step_status_display(step_result_status(r)))));
            var out = step_result_output(r);
            if (out == 0) { out = bayan_json_v_null(); }
            bayan_json_v_obj_set(entry, str_from("output"), out);
            var err = step_result_error(r);
            if (err == 0) {
                bayan_json_v_obj_set(entry, str_from("error"), bayan_json_v_null());
            } else {
                bayan_json_v_obj_set(entry, str_from("error"), bayan_json_v_str_new(err));
            }
            bayan_json_v_obj_set(steps_obj, str_clone(name), entry);
        }
        i = i + 1;
    }
    var root = bayan_json_v_obj_new();
    bayan_json_v_obj_set(root, str_from("steps"), steps_obj);
    return root;
}

# Find the StepDef name (Str) matching the given id halves in the steps vec, or 0 if none.
# Internal — mirrors the id_to_name HashMap lookup in Rust build_step_context.
fn _cond_name_for_id(steps, hi, lo) {
    var n = vec_len(steps);
    var i = 0;
    while (i < n) {
        var s = vec_get(steps, i);
        if ((step_id_hi(s) == hi) && (step_id_lo(s) == lo)) {
            return step_name(s);
        }
        i = i + 1;
    }
    return 0;
}

# --- flow.cyr ---

# flow.cyr — flow definitions: how steps are wired together
#
# Ports rust-old/src/flow.rs (FlowDef + builders, FlowMode, validate / cycle check,
# serde (de)serialization). FlowDef is a heap blob with an enum of byte-offset layout
# constants and accessor fns (the majra heap-struct idiom). The flow id is a UUID carried
# as two i64 halves (hi, lo) matching src/uuid.cyr; steps is a vec of StepDef* (src/step.cyr).
#
# Usage: include "src/flow.cyr"
# Requires: lib/str.cyr (Str + builder), lib/vec.cyr, lib/hashmap.cyr, lib/alloc.cyr
#   (alloc_init before any constructor), lib/result.cyr (Ok/Err), lib/bayan.cyr (json_v +
#   flow_to_json/from_json; lib/io must be in scope before lib/bayan), src/error.cyr
#   (SzalErr + szal_err), src/uuid.cyr (szal_uuid_generate/uuid_to_str/uuid_parse), src/step.cyr
#   (StepDef accessors + step_to_json/step_from_json).
# Naming: every public symbol is flow_/FlowMode-prefixed; no bare names that collide with
#   vendored majra/bote. Internal helpers use the _ prefix.

# FlowMode — execution mode for a flow. Values are declaration order (0/1/2/3), matching the
# Rust enum order (flow.rs 34-43). NOTE flow.rs has TWO distinct string forms: the Display
# impl emits lowercase (flow_mode_display: "sequential"/"parallel"/"dag"/"hierarchical") while
# the serde Serialize impl (derive, no rename_all) emits the PascalCase variant name
# (flow_mode_serde_name: "Sequential"/...). FlowDef JSON carries the serde (PascalCase) form;
# the lowercase Display form is what InvalidFlow error messages interpolate. (flow.rs 45-54.)
enum FlowMode {
    FLOW_SEQUENTIAL = 0;
    FLOW_PARALLEL = 1;
    FLOW_DAG = 2;
    FLOW_HIERARCHICAL = 3;
}

# Map a FlowMode to its Display (lowercase) string (cstr). Mirrors the std::fmt::Display impl
# (flow.rs 45-54). Used in InvalidFlow detail messages. Unknown -> "sequential".
fn flow_mode_display(m) {
    if (m == FLOW_SEQUENTIAL) { return "sequential"; }
    if (m == FLOW_PARALLEL) { return "parallel"; }
    if (m == FLOW_DAG) { return "dag"; }
    if (m == FLOW_HIERARCHICAL) { return "hierarchical"; }
    return "sequential";
}

# Map a FlowMode to its serde/Debug (PascalCase) name (cstr). This is what FlowDef JSON carries
# (derive(Serialize), no rename_all). Unknown -> "Sequential".
fn flow_mode_serde_name(m) {
    if (m == FLOW_SEQUENTIAL) { return "Sequential"; }
    if (m == FLOW_PARALLEL) { return "Parallel"; }
    if (m == FLOW_DAG) { return "Dag"; }
    if (m == FLOW_HIERARCHICAL) { return "Hierarchical"; }
    return "Sequential";
}

# Parse a FlowMode from its serde PascalCase name (Str). Unknown/missing -> FLOW_SEQUENTIAL
# (serde would error on an unknown variant; for serde-default parity on a malformed/missing
# field we fall back to the first declared variant). Used by flow_from_json.
fn flow_mode_from_name(s) {
    if (s == 0) { return FLOW_SEQUENTIAL; }
    if (str_eq_cstr(s, "Parallel") == 1) { return FLOW_PARALLEL; }
    if (str_eq_cstr(s, "Dag") == 1) { return FLOW_DAG; }
    if (str_eq_cstr(s, "Hierarchical") == 1) { return FLOW_HIERARCHICAL; }
    return FLOW_SEQUENTIAL;
}

# The default flow definition version (1) for flows lacking an explicit one. Mirrors
# default_flow_version (flow.rs 90-92): flows serialized before versioning deserialize to 1.
fn flow_default_version() {
    return 1;
}

# FlowDef — heap blob. Mirrors the Rust struct (flow.rs 68-85). id is two i64 UUID halves;
# name/description are Str ptrs; mode is a FlowMode enum value; steps is a vec of StepDef*;
# rollback_on_failure is 1/0; timeout_ms holds the Option<u64> as a present-flag + value pair
# (Rust None -> flag 0; Some(ms) -> flag 1 + the ms); version defaults to 1.
#
# Byte layout (72 bytes):
#   +0    id_hi              (i64, uuid hi half)
#   +8    id_lo              (i64, uuid lo half)
#   +16   name               (Str ptr)
#   +24   description        (Str ptr)
#   +32   mode               (i64 FlowMode, default FLOW_SEQUENTIAL via flow_new arg)
#   +40   steps              (vec of StepDef ptrs)
#   +48   rollback_on_failure(i64 1/0, default 0)
#   +56   timeout_present    (i64 1/0; 0 = None, 1 = Some — Option<u64> flag)
#   +64   timeout_ms         (i64, the Some value; meaningless when timeout_present == 0)
#   +72   version            (i64 u32, default 1)
enum FlowDefL {
    FLOWDEF_SIZE = 80;
    FD_ID_HI = 0;
    FD_ID_LO = 8;
    FD_NAME = 16;
    FD_DESCRIPTION = 24;
    FD_MODE = 32;
    FD_STEPS = 40;
    FD_ROLLBACK = 48;
    FD_TIMEOUT_PRESENT = 56;
    FD_TIMEOUT_MS = 64;
    FD_VERSION = 72;
}

# --- FlowDef accessors ---

# Get the flow id high half (i64).
fn flow_id_hi(f) { return load64(f + FD_ID_HI); }

# Get the flow id low half (i64).
fn flow_id_lo(f) { return load64(f + FD_ID_LO); }

# Get the flow name (Str ptr).
fn flow_name(f) { return load64(f + FD_NAME); }

# Get the flow description (Str ptr).
fn flow_description(f) { return load64(f + FD_DESCRIPTION); }

# Get the flow mode (FlowMode enum value).
fn flow_mode(f) { return load64(f + FD_MODE); }

# Get the steps vec (vec of StepDef ptrs).
fn flow_steps(f) { return load64(f + FD_STEPS); }

# Get the number of steps.
fn flow_steps_len(f) { return vec_len(load64(f + FD_STEPS)); }

# Get the i-th step (StepDef ptr).
fn flow_step_at(f, i) { return vec_get(load64(f + FD_STEPS), i); }

# Whether to rollback completed steps on failure (1/0).
fn flow_rollback_on_failure(f) { return load64(f + FD_ROLLBACK); }

# Is the timeout set (Option::is_some)? 1/0.
fn flow_timeout_present(f) { return load64(f + FD_TIMEOUT_PRESENT); }

# Get the timeout in milliseconds (i64; only meaningful when flow_timeout_present == 1).
fn flow_timeout_ms(f) { return load64(f + FD_TIMEOUT_MS); }

# Get the definition version (i64; default 1).
fn flow_version(f) { return load64(f + FD_VERSION); }

# --- Builders ---

# Allocate a fresh FlowDef with the given name (Str) and mode (FlowMode) and flow.rs defaults:
# a freshly generated v4 UUID id, empty description, empty steps, rollback_on_failure false,
# timeout_ms None, version 1. Mirrors FlowDef::new (flow.rs 95-107). Returns 0 on OOM.
fn flow_new(name, mode) {
    var f = alloc(FLOWDEF_SIZE);
    if (f == 0) { return 0; }
    var hi, lo = szal_uuid_generate();
    store64(f + FD_ID_HI, hi);
    store64(f + FD_ID_LO, lo);
    store64(f + FD_NAME, name);
    store64(f + FD_DESCRIPTION, str_from(""));
    store64(f + FD_MODE, mode);
    store64(f + FD_STEPS, vec_new());
    store64(f + FD_ROLLBACK, 0);
    store64(f + FD_TIMEOUT_PRESENT, 0);
    store64(f + FD_TIMEOUT_MS, 0);
    store64(f + FD_VERSION, flow_default_version());
    return f;
}

# Append a step (mirrors add_step, flow.rs 109-111). step is a StepDef*. Returns f.
fn flow_add_step(f, step) {
    if (f == 0) { return 0; }
    vec_push(load64(f + FD_STEPS), step);
    return f;
}

# Set the definition version (mirrors with_version, flow.rs 114-118). Returns f.
fn flow_with_version(f, version) {
    if (f == 0) { return 0; }
    store64(f + FD_VERSION, version);
    return f;
}

# Mark the flow as rollback-on-failure (mirrors with_rollback, flow.rs 120-124). Returns f.
fn flow_with_rollback(f) {
    if (f == 0) { return 0; }
    store64(f + FD_ROLLBACK, 1);
    return f;
}

# Set the total flow timeout in ms (mirrors with_timeout, flow.rs 126-130). Sets the Option to
# Some(ms). Returns f.
fn flow_with_timeout(f, ms) {
    if (f == 0) { return 0; }
    store64(f + FD_TIMEOUT_PRESENT, 1);
    store64(f + FD_TIMEOUT_MS, ms);
    return f;
}

# --- Validation ---

# Validate the flow. Mirrors FlowDef::validate (flow.rs 133-155). Returns Ok(0) on success or
# Err(code) (with the detail set in the szal last-error buffer) on the first violation, in the
# SAME ORDER as Rust:
#   1. Dag      -> _flow_check_cycles (cycle check + non-existent-dep check).
#      non-Dag  -> any step with a non-empty depends_on is invalid.
#   2. Hierarchical -> _flow_validate_hierarchical (recursive: no depends_on anywhere).
#   3. any step with trigger_mode Any AND empty depends_on is invalid.
fn flow_validate(f) {
    if (f == 0) {
        return szal_err(SZAL_ERR_FLOW_INVALID, str_from("flow is null"));
    }
    var mode = flow_mode(f);
    if (mode == FLOW_DAG) {
        _flow_check_cycles(f)?;
    } elif (_flow_any_step_has_deps(f) == 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "steps have dependencies but flow mode is ");
        str_builder_add_cstr(sb, flow_mode_display(mode));
        str_builder_add_cstr(sb, " (use dag mode for dependencies)");
        return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sb));
    }
    if (mode == FLOW_HIERARCHICAL) {
        _flow_validate_hierarchical(flow_steps(f))?;
    }
    # Reject TriggerMode::Any with no dependencies
    var n = flow_steps_len(f);
    var i = 0;
    while (i < n) {
        var step = flow_step_at(f, i);
        if ((step_trigger_mode(step) == SZAL_TRIGGER_ANY) && (step_depends_on_len(step) == 0)) {
            var sb2 = str_builder_new();
            str_builder_add_cstr(sb2, "step '");
            str_builder_add(sb2, step_name(step));
            str_builder_add_cstr(sb2, "' has trigger_mode Any but no dependencies");
            return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sb2));
        }
        i = i + 1;
    }
    return Ok(0);
}

# _flow_any_step_has_deps(f) -> 1 if ANY top-level step has a non-empty depends_on, else 0.
# Mirrors the `self.steps.iter().any(|s| !s.depends_on.is_empty())` guard (flow.rs 136). Internal.
fn _flow_any_step_has_deps(f) {
    var n = flow_steps_len(f);
    var i = 0;
    while (i < n) {
        if (step_depends_on_len(flow_step_at(f, i)) != 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# _flow_validate_hierarchical(steps) -> Ok(0) or Err. Recursively rejects any step (at any depth
# in the sub_steps tree) that has a non-empty depends_on. Mirrors validate_hierarchical
# (flow.rs 157-168). steps is a vec of StepDef*. Internal.
fn _flow_validate_hierarchical(steps) {
    var n = vec_len(steps);
    var i = 0;
    while (i < n) {
        var step = vec_get(steps, i);
        if (step_depends_on_len(step) != 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "step '");
            str_builder_add(sb, step_name(step));
            str_builder_add_cstr(sb, "' has depends_on in hierarchical mode (use sub_steps for nesting)");
            return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sb));
        }
        _flow_validate_hierarchical(step_sub_steps(step))?;
        i = i + 1;
    }
    return Ok(0);
}

# _flow_check_cycles(f) -> Ok(0) or Err. Mirrors check_cycles (flow.rs 170-220): a DFS three-
# color cycle check over the depends_on edges, then a check that every depends_on target
# references a known step. On a cycle: Err(SZAL_ERR_CYCLE) with the FLOW NAME as the detail
# (CycleDetected(self.name)). On an unknown dep: Err(SZAL_ERR_FLOW_INVALID) with the per-step msg.
#
# UUIDs are 128-bit (two i64 halves); we index steps by a 32-char hex UUID-string key in cstr-
# keyed hashmaps (id_set / visited / in_stack) and resolve a node's neighbor list (depends_on)
# via the same key. This mirrors Rust's HashSet<Uuid>/HashMap<Uuid, &Vec<Uuid>> with a string
# key as the i64-collapse-safe identity (a raw hi^lo i64 could collide; the 36-char string is
# the exact identity uuid_to_str round-trips). Internal.
fn _flow_check_cycles(f) {
    var n = flow_steps_len(f);
    # id_set : set of all step-id keys -> the step's own index (value unused, presence is the set).
    var id_set = map_new();
    # deps_map : step-id key -> the StepDef* (to read its depends_on neighbor list in dfs).
    var deps_map = map_new();
    var i = 0;
    while (i < n) {
        var step = flow_step_at(f, i);
        var key = str_cstr(uuid_to_str(step_id_hi(step), step_id_lo(step)));
        map_set(id_set, key, 1);
        map_set(deps_map, key, step);
        i = i + 1;
    }
    var visited = map_new();
    var in_stack = map_new();
    var i2 = 0;
    while (i2 < n) {
        var step2 = flow_step_at(f, i2);
        var key2 = str_cstr(uuid_to_str(step_id_hi(step2), step_id_lo(step2)));
        if (map_has(visited, key2) == 0) {
            if (_flow_dfs(key2, deps_map, visited, in_stack) == 1) {
                return szal_err(SZAL_ERR_CYCLE, flow_name(f));
            }
        }
        i2 = i2 + 1;
    }
    # Check for references to non-existent steps (flow.rs 207-217).
    var i3 = 0;
    while (i3 < n) {
        var step3 = flow_step_at(f, i3);
        var dn = step_depends_on_len(step3);
        var j = 0;
        while (j < dn) {
            var dkey = str_cstr(uuid_to_str(step_depends_on_hi(step3, j),
                step_depends_on_lo(step3, j)));
            if (map_has(id_set, dkey) == 0) {
                var sb = str_builder_new();
                str_builder_add_cstr(sb, "step '");
                str_builder_add(sb, step_name(step3));
                str_builder_add_cstr(sb, "' depends on non-existent step");
                return szal_err(SZAL_ERR_FLOW_INVALID, str_builder_build(sb));
            }
            j = j + 1;
        }
        i3 = i3 + 1;
    }
    return Ok(0);
}

# _flow_dfs(node_key, deps_map, visited, in_stack) -> 1 if a back-edge (cycle) is found from
# node_key, else 0. Mirrors the inner dfs (flow.rs 178-199): mark visited + in_stack, recurse
# into each neighbor (the node's depends_on targets); a neighbor already in_stack is a cycle.
# node_key is a cstr UUID-string key; deps_map maps it to the StepDef*. Internal.
fn _flow_dfs(node_key, deps_map, visited, in_stack) {
    map_set(visited, node_key, 1);
    map_set(in_stack, node_key, 1);
    var step = map_get(deps_map, node_key);
    if (step != 0) {
        var dn = step_depends_on_len(step);
        var k = 0;
        while (k < dn) {
            var nkey = str_cstr(uuid_to_str(step_depends_on_hi(step, k),
                step_depends_on_lo(step, k)));
            if (map_has(visited, nkey) == 0) {
                if (_flow_dfs(nkey, deps_map, visited, in_stack) == 1) {
                    return 1;
                }
            } elif (map_has(in_stack, nkey) == 1) {
                return 1;
            }
            k = k + 1;
        }
    }
    map_delete(in_stack, node_key);
    return 0;
}

# --- JSON (de)serialization ---

# Serialize a FlowDef to a JSON object Str. Field set + order matches the Rust serde Serialize
# of FlowDef (flow.rs 68-85, derive(Serialize), no skip attributes): id (UUID string), name,
# description, mode (PascalCase variant name), steps (array of StepDef objects), rollback_on_
# failure, timeout_ms (null when None), version. (version has #[serde(default)] but is still
# serialized.)
fn flow_to_json(f) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("id"),
      bayan_json_v_str_new(uuid_to_str(flow_id_hi(f), flow_id_lo(f))));
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(flow_name(f)));
    bayan_json_v_obj_set(o, str_from("description"),
      bayan_json_v_str_new(flow_description(f)));
    bayan_json_v_obj_set(o, str_from("mode"),
      bayan_json_v_str_new(str_from(flow_mode_serde_name(flow_mode(f)))));
    var steps = bayan_json_v_arr_new();
    var n = flow_steps_len(f);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(steps, bayan_json_v_parse(step_to_json(flow_step_at(f, i))));
        i = i + 1;
    }
    bayan_json_v_obj_set(o, str_from("steps"), steps);
    bayan_json_v_obj_set(o, str_from("rollback_on_failure"),
      bayan_json_v_bool_new(flow_rollback_on_failure(f)));
    if (flow_timeout_present(f) == 1) {
        bayan_json_v_obj_set(o, str_from("timeout_ms"),
          bayan_json_v_int_new(flow_timeout_ms(f)));
    } else {
        bayan_json_v_obj_set(o, str_from("timeout_ms"), bayan_json_v_null());
    }
    bayan_json_v_obj_set(o, str_from("version"),
      bayan_json_v_int_new(flow_version(f)));
    return bayan_json_v_build(o);
}

# Build a FlowDef from a parsed json_v object with serde-default semantics: a missing version
# field falls back to 1 (flow.rs #[serde(default = "default_flow_version")]); name/description
# default to ""; mode defaults to Sequential; steps default to empty; rollback default false;
# timeout_ms null/missing -> None. id parses from the UUID string (malformed -> a fresh id,
# matching step_from_json). Internal — flow_from_json wraps the Str entry.
fn _flow_from_v(o) {
    if (o == 0) { return 0; }
    var name_v = bayan_json_v_obj_get_by_cstr(o, "name");
    var name = str_from("");
    if (bayan_json_v_is_str(name_v) == 1) { name = bayan_json_v_str(name_v); }
    var mode_v = bayan_json_v_obj_get_by_cstr(o, "mode");
    var mode = FLOW_SEQUENTIAL;
    if (bayan_json_v_is_str(mode_v) == 1) {
        mode = flow_mode_from_name(bayan_json_v_str(mode_v));
    }
    var f = flow_new(name, mode);
    if (f == 0) { return 0; }
    # id (parse the UUID string; malformed -> keep the fresh generated id)
    var id_v = bayan_json_v_obj_get_by_cstr(o, "id");
    if (bayan_json_v_is_str(id_v) == 1) {
        var hi, lo = uuid_parse(str_cstr(bayan_json_v_str(id_v)));
        if (uuid_parse_ok(hi, lo) == 1) {
            store64(f + FD_ID_HI, hi);
            store64(f + FD_ID_LO, lo);
        }
    }
    # description (default "")
    var desc_v = bayan_json_v_obj_get_by_cstr(o, "description");
    if (bayan_json_v_is_str(desc_v) == 1) {
        store64(f + FD_DESCRIPTION, bayan_json_v_str(desc_v));
    }
    # steps (default empty; array of StepDef objects)
    var steps_v = bayan_json_v_obj_get_by_cstr(o, "steps");
    if (bayan_json_v_is_arr(steps_v) == 1) {
        var sn = bayan_json_v_arr_len(steps_v);
        var i = 0;
        while (i < sn) {
            var sub = _step_from_v(bayan_json_v_arr_get(steps_v, i));
            if (sub != 0) { flow_add_step(f, sub); }
            i = i + 1;
        }
    }
    # rollback_on_failure (default false)
    var rb_v = bayan_json_v_obj_get_by_cstr(o, "rollback_on_failure");
    if (bayan_json_v_is_bool(rb_v) == 1) {
        store64(f + FD_ROLLBACK, bayan_json_v_bool(rb_v));
    }
    # timeout_ms (Option<u64> -> None when missing/null)
    var to_v = bayan_json_v_obj_get_by_cstr(o, "timeout_ms");
    if (bayan_json_v_is_int(to_v) == 1) {
        store64(f + FD_TIMEOUT_PRESENT, 1);
        store64(f + FD_TIMEOUT_MS, bayan_json_v_int(to_v));
    }
    # version (#[serde(default = "default_flow_version")] -> 1 when missing)
    var ver_v = bayan_json_v_obj_get_by_cstr(o, "version");
    if (bayan_json_v_is_int(ver_v) == 1) {
        store64(f + FD_VERSION, bayan_json_v_int(ver_v));
    }
    return f;
}

# Deserialize a FlowDef from a JSON object Str with serde-default semantics (missing version ->
# 1, missing optionals default rather than fail). Returns 0 on parse failure. Mirrors
# serde_json::from_str::<FlowDef>.
fn flow_from_json(json) {
    var o = bayan_json_v_parse(json);
    if (o == 0) { return 0; }
    return _flow_from_v(o);
}

# --- mcp.cyr ---

# mcp.cyr — MCP tool infrastructure: result helpers, error codes, szal_validate_path, registration
#
# Ports rust-old/src/mcp/mod.rs (port-plan §4 row 24). szal implements MCP *tools*; bote owns the
# protocol/dispatch/transport. This module is the glue: response builders, the structured error-code
# taxonomy, the **szal_validate_path security boundary**, a ToolDef helper, and the dispatcher-
# registration machinery over bote-core. The 54 tools themselves live in src/mcp_tools_*.cyr and are
# aggregated by the szal_all_tools() that the final tools file defines (kept out of here so the
# single-pass include order has no forward ref).
#
# Handler ABI (bote dispatcher): a tool handler is `fn(args_cstr, claims) -> result_cstr` — it takes
# the request arguments + caller claims and returns a JSON result string. The szal_result_* builders
# below produce exactly that string. (Rust returns `serde_json::Value`; the Cyrius handlers return
# the serialized Str — no async/block_on bridge needed since handlers are synchronous.)
#
# SECURITY — szal_validate_path: Rust uses `tokio::fs::canonicalize` (resolves symlinks + `..`). Cyrius has
# no fs canonicalize, so this is a **lexical** normalizer (component-walk resolving `.`/`..`) + CWD
# confinement (port-plan §4 row 24). It rejects absolute paths outside cwd and `..` escapes — the
# exact traversal cases the Rust tests assert. Symlink resolution is NOT performed (the roadmap
# "validate_path symlink semantics" open question; lexical is the 2.0.0 choice). Every file tool MUST
# route through this before touching the filesystem.
#
# Naming: bote owns bare `registry_*`/`dispatcher_*`, and daimon owns `mcp_*` (roadmap consumer
# contract), so EVERY public symbol here is szal-prefixed: szal_result_*, szal_validate_path,
# szal_mcp_err_*, szal_tool_*, szal_register_*, SZAL_MCP_* codes. Through 2.1.2 these were the bare
# Rust names (result_ok, validate_path, register_tools, mcp_tool_def, MCP_VALIDATION, ...) — fine
# inside szal, a collision waiting for the first consumer to link the tools. Helpers use _.
#
# Usage: include "src/mcp.cyr" (after src/vendor/bote-core.cyr + lib/bayan + lib/str + lib/result).
# Requires: src/vendor/bote-core.cyr (tool_registry_new/dispatcher_*/tool_def_new/schema_new),
#   lib/bayan.cyr (json_v build), lib/str.cyr, lib/vec.cyr, lib/result.cyr (Ok/Err),
#   lib/syscalls.cyr (raw getcwd), src/error.cyr is NOT needed (MCP codes are their own taxonomy).

# ── McpErrorCode — structured error taxonomy (mod.rs 104-138) ───────────────
# Permanent: Validation/NotFound/PermissionDenied. Transient (retryable): Timeout/IoError/Internal.
enum McpErrorCode {
    SZAL_MCP_VALIDATION = 0;
    SZAL_MCP_NOT_FOUND = 1;
    SZAL_MCP_PERMISSION_DENIED = 2;
    SZAL_MCP_TIMEOUT = 3;
    SZAL_MCP_IO_ERROR = 4;
    SZAL_MCP_INTERNAL = 5;
}

# The wire string for an McpErrorCode (mirrors McpErrorCode::as_str).
fn szal_mcp_err_name(code) {
    if (code == SZAL_MCP_VALIDATION) { return "validation"; }
    if (code == SZAL_MCP_NOT_FOUND) { return "not_found"; }
    if (code == SZAL_MCP_PERMISSION_DENIED) { return "permission_denied"; }
    if (code == SZAL_MCP_TIMEOUT) { return "timeout"; }
    if (code == SZAL_MCP_IO_ERROR) { return "io_error"; }
    if (code == SZAL_MCP_INTERNAL) { return "internal"; }
    return "internal";
}

# 1 if the code is transient/retryable (Timeout/IoError/Internal). Mirrors McpErrorCode::is_retryable.
fn szal_mcp_err_retryable(code) {
    if (code == SZAL_MCP_TIMEOUT) { return 1; }
    if (code == SZAL_MCP_IO_ERROR) { return 1; }
    if (code == SZAL_MCP_INTERNAL) { return 1; }
    return 0;
}

# --- Result builders ---
# Each returns a JSON object Str: {"content":[{"type":"text","text":<text>}],"isError":<bool>}.

# Build the inner content array [{"type":"text","text":text}] (text is a Str). Internal.
fn _mcp_content(text) {
    var arr = bayan_json_v_arr_new();
    var item = bayan_json_v_obj_new();
    bayan_json_v_obj_set(item, str_from("type"), bayan_json_v_str_new(str_from("text")));
    bayan_json_v_obj_set(item, str_from("text"), bayan_json_v_str_new(text));
    bayan_json_v_arr_push(arr, item);
    return arr;
}

# A successful MCP tool response carrying `text` (a Str). Mirrors result_ok.
fn szal_result_ok(text) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("content"), _mcp_content(text));
    bayan_json_v_obj_set(o, str_from("isError"), bayan_json_v_bool_new(0));
    var s = bayan_json_v_build(o);
    return s;
}

# A successful response whose text is `value` (a json_v) pretty-printed once. Mirrors result_ok_json.
fn szal_result_ok_json(value) {
    var text = bayan_json_v_build_pretty(value, 2);
    return szal_result_ok(text);
}

# An error MCP tool response carrying message `msg` (a Str). Mirrors result_error.
fn szal_result_error(msg) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("content"), _mcp_content(msg));
    bayan_json_v_obj_set(o, str_from("isError"), bayan_json_v_bool_new(1));
    var s = bayan_json_v_build(o);
    return s;
}

# An error response with a structured error code: adds "_meta":{"error_code","retryable"}. `code` is
# an McpErrorCode, `msg` a Str. Mirrors result_error_typed.
fn szal_result_error_typed(code, msg) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("content"), _mcp_content(msg));
    bayan_json_v_obj_set(o, str_from("isError"), bayan_json_v_bool_new(1));
    var meta = bayan_json_v_obj_new();
    bayan_json_v_obj_set(meta, str_from("error_code"), bayan_json_v_str_new(str_from(szal_mcp_err_name(code))));
    bayan_json_v_obj_set(meta, str_from("retryable"), bayan_json_v_bool_new(szal_mcp_err_retryable(code)));
    bayan_json_v_obj_set(o, str_from("_meta"), meta);
    var s = bayan_json_v_build(o);
    return s;
}

# --- Tool arguments ---
#
# Every handler that reads arguments parses them with szal_args_parse and, on 0, returns
# szal_args_error(args) at once. bote always hands a handler an object (`{}` when `arguments` is
# absent; anything else is a protocol error), so a 0 here means JSON bote's reader accepted and the
# stdlib's bayan refuses: since bayan 1.11.1 (cyrius 6.7.18) a duplicate object key or a malformed
# number (`01`). Before 2.3.1 handlers read such arguments as `{}`, so a tool with optional
# arguments silently ran on its defaults. Rust (serde_json) keeps a duplicate's LAST value; szal
# refuses instead, because bote's schema check reads the FIRST, and acting on any other value would
# act on arguments nobody checked (ADR 0003, parity-notes §25).

# Parse a tool's arguments (a JSON object cstr) into a json_v, or 0 if bayan refuses them.
fn szal_args_parse(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# The Validation error for arguments szal_args_parse refused, naming bayan's reason and byte.
fn szal_args_error(args) {
    # Re-parse into a state of our own: bayan_json_last_error is shared by every thread, and bote may
    # run handlers on worker threads, so the reason is read from this call's state only.
    var ps = alloc(bayan_json_parse_state_size());
    var mb = str_builder_new();
    str_builder_add_cstr(mb, "invalid arguments");
    if (ps != 0) {
        var s = str_from(args);
        var v = bayan_json_v_parse_ctx_str(ps, s);
        if (v == 0) {
            str_builder_add_cstr(mb, ": ");
            str_builder_add_cstr(mb, bayan_json_state_error(ps));
            str_builder_add_cstr(mb, " at byte ");
            str_builder_add_int(mb, bayan_json_state_error_pos(ps));
        }
    }
    var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(mb));
    return str_data(e);
}

# --- szal_validate_path: the filesystem security boundary ---

# Current working directory as a cstr (kernel NUL-terminates), or 0 on failure. Linux getcwd
# (SYS_GETCWD: 79 on x86_64). agnos: always 0 — the cyrius 6.7.18 agnos peer has no getcwd (agnos
# 1.57.18 added getcwd#113), so szal_validate_path refuses every path there, fail-closed, rather than
# confine to a guessed root. (Through 2.3.2 this was a raw syscall(79), blk_info#79 on agnos.)
fn _mcp_getcwd() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var buf = alloc(4096);
    if (buf == 0) { return 0; }
    var n = syscall(SYS_GETCWD, buf, 4096);
    if (n <= 0) { return 0; }
    return buf;
    #endif
}

# Lexically normalize an absolute path Str: split on '/', drop ""/"." components, pop on ".."
# (bounded at root), rejoin "/"-prefixed. No symlink resolution (see module header). Internal.
fn _mcp_normalize(abs) {
    var parts = str_split(abs, 47);
    var comps = vec_new();
    var n = vec_len(parts);
    var i = 0;
    while (i < n) {
        var p = vec_get(parts, i);
        if (str_len(p) == 0) {
            i = i;
        } elif (str_eq_cstr(p, ".") == 1) {
            i = i;
        } elif (str_eq_cstr(p, "..") == 1) {
            if (vec_len(comps) > 0) { vec_pop(comps); }
        } else {
            vec_push(comps, p);
        }
        i = i + 1;
    }
    var m = vec_len(comps);
    var sb = str_builder_new();
    if (m == 0) {
        str_builder_add_cstr(sb, "/");
        var root = str_builder_build(sb);
        return root;
    }
    var k = 0;
    while (k < m) {
        str_builder_add_byte(sb, 47);
        str_builder_add(sb, vec_get(comps, k));
        k = k + 1;
    }
    var out = str_builder_build(sb);
    return out;
}

# Validate that `path` (a Str) resolves under the current working directory. Returns Ok(normalized
# absolute path Str) or Err(message Str). Rejects absolute paths outside cwd and `..` escapes.
# Mirrors validate_path (mod.rs 156-193), lexically (no fs canonicalize in Cyrius).
fn szal_validate_path(path) {
    var cwdc = _mcp_getcwd();
    if (cwdc == 0) { return Err(str_from("failed to get cwd")); }
    var cwd = str_from(cwdc);

    # Build the absolute candidate: absolute path as-is, else cwd + "/" + path.
    var is_abs = 0;
    if (str_len(path) > 0) {
        if (load8(str_data(path)) == 47) { is_abs = 1; }
    }
    var abs = path;
    if (is_abs == 0) {
        var ab = str_builder_new();
        str_builder_add(ab, cwd);
        str_builder_add_byte(ab, 47);
        str_builder_add(ab, path);
        abs = str_builder_build(ab);
    }

    var norm = _mcp_normalize(abs);
    # Confinement: normalized == cwd, or normalized starts with cwd + "/".
    if (str_eq(norm, cwd) == 1) { return Ok(norm); }
    var pb = str_builder_new();
    str_builder_add(pb, cwd);
    str_builder_add_byte(pb, 47);
    var prefix = str_builder_build(pb);
    if (str_starts_with(norm, prefix) == 1) { return Ok(norm); }

    var eb = str_builder_new();
    str_builder_add_cstr(eb, "path '");
    str_builder_add(eb, path);
    str_builder_add_cstr(eb, "' is outside working directory");
    var emsg = str_builder_build(eb);
    return Err(emsg);
}

# --- ToolDef helper + Tool pair + registration ---

# Build a bote ToolDef (object schema). name/description are cstrs; properties is a vec of
# schema_prop_new(key_cstr, raw_json_value_cstr) pairs; required is a vec of cstr names. Mirrors
# the Rust tool_def helper (adapted to bote's native cstr/schema_prop shape — port-plan §3.2).
fn szal_tool_def(name, description, properties, required) {
    return tool_def_new(name, description, schema_new("object", properties, required));
}

# A Tool = a (ToolDef, handler_fp) pair (port-plan §4 row 24's "Tool = (def_fn, call_fn) pair").
enum McpToolL {
    SZAL_TOOL_SIZE = 16;
    SZAL_TOOL_DEF_OFF = 0;
    SZAL_TOOL_HANDLER_OFF = 8;
}

# Build a Tool from a bote ToolDef + a handler fn pointer (fn(args_cstr, claims) -> result_cstr).
fn szal_tool_new(def, handler) {
    var t = alloc(SZAL_TOOL_SIZE);
    if (t == 0) { return 0; }
    store64(t + SZAL_TOOL_DEF_OFF, def);
    store64(t + SZAL_TOOL_HANDLER_OFF, handler);
    return t;
}

# Get the bote ToolDef of a Tool pair.
fn szal_tool_def_of(t) { return load64(t + SZAL_TOOL_DEF_OFF); }
# Get the handler fn pointer of a Tool pair.
fn szal_tool_handler_of(t) { return load64(t + SZAL_TOOL_HANDLER_OFF); }

# Registration comes in two shapes:
#   * a FRESH dispatcher that szal builds — szal_register_tool_vec[_with] here, and the all-tools
#     szal_register_tools[_with] in mcp_tools_net.cyr (Rust's register_tools[_with]);
#   * a consumer's EXISTING dispatcher — szal_register_tool_vec_into here, szal_register_into in
#     mcp_tools_net.cyr. The consumer keeps its own registry, tools, audit chain and event bus.

# Register a vec of Tool pairs into a fresh bote dispatcher, with optional audit/event sinks (0 =
# None). Mirrors register_tools_with (mod.rs 47-82): build a registry, register every ToolDef, make
# the dispatcher, attach sinks, then wire each handler. Returns the ready dispatcher.
fn szal_register_tool_vec_with(tools, audit, events) {
    var reg = tool_registry_new();
    var n = vec_len(tools);
    var i = 0;
    while (i < n) {
        registry_register(reg, szal_tool_def_of(vec_get(tools, i)));
        i = i + 1;
    }
    var d = dispatcher_new(reg);
    if (audit != 0) { dispatcher_set_audit(d, audit); }
    if (events != 0) { dispatcher_set_events(d, events); }
    i = 0;
    while (i < n) {
        var t = vec_get(tools, i);
        dispatcher_handle(d, tool_def_name(szal_tool_def_of(t)), szal_tool_handler_of(t));
        i = i + 1;
    }
    return d;
}

# Register `tools` with no audit/event sinks. Mirrors register_tools (the no-sink convenience).
# The 54-tool aggregator (szal_all_tools and friends) lives in the final mcp_tools_* file so this
# module has no forward reference to the not-yet-included tool builders.
fn szal_register_tool_vec(tools) {
    return szal_register_tool_vec_with(tools, 0, 0);
}

# Add a vec of Tool pairs to an EXISTING bote dispatcher `d` — one a consumer already built, with
# its own tools, audit sink and event sink. Each tool goes through bote's dispatcher_register_tool,
# so the dispatcher's own registry gets the ToolDef, its handler map gets the fn pointer, and its
# event sink hears TOPIC_TOOL_REGISTERED; nothing szal-owned is left behind. A name the dispatcher
# already holds is replaced (bote's registry semantics). Returns 0, or the first BoteError bote
# reports (it validates every name). `d` must be a live dispatcher (dispatcher_new) — like bote's
# own dispatcher_* API, this does not null-check it. It also must not name a bote enum constant:
# dist/szal-mcp.cyr is compile-checked by `cyrius distlib` WITHOUT bote-core in scope, where an
# undefined fn is downgraded but an undefined constant is fatal.
fn szal_register_tool_vec_into(d, tools) {
    var n = vec_len(tools);
    var i = 0;
    while (i < n) {
        var t = vec_get(tools, i);
        var err = dispatcher_register_tool(d, szal_tool_def_of(t), szal_tool_handler_of(t));
        if (err != 0) { return err; }
        i = i + 1;
    }
    return 0;
}

# --- mcp_pool.cyr ---

# mcp_pool.cyr — ports mcp/pool.rs (NetworkPool: per-category rate limiting / backpressure).
#
# Three independent token-bucket rate limiters (HTTP / DNS / port scan) guard the network tools
# against abuse. Rust uses `majra::ratelimit::RateLimiter` at f64 rates; the vendored majra ABI is
# fixed-point (rate × 1000), so RateLimiter::new(10.0, 50) -> ratelimit_new(10000, 50). Defaults
# (pool.rs 29-35): HTTP 10/s burst 50, DNS 100/s burst 200, Port 50/s burst 100.
#
# Keys are cstr (NUL-terminated): majra's ratelimit_check buckets per-key via a cstr-content-keyed
# `map_new`, so the same host shares a bucket across calls and distinct hosts are independent
# (pool.rs separate_hosts_have_independent_limits). check_* return 1 (allowed) / 0 (rejected).
#
# Usage: include AFTER src/vendor/majra.cyr (ratelimit_new/ratelimit_check) + lib/alloc.cyr.
# Requires: src/vendor/majra.cyr, lib/alloc.cyr.

# NetworkPool layout: { http_rl@0, dns_rl@8, port_rl@16 }.
enum NetPoolL {
    NP_HTTP = 0;
    NP_DNS = 8;
    NP_PORT = 16;
    NP_SIZE = 24;
}

# NetworkPool::new — three rate limiters with the pool.rs default rate/burst settings.
fn szal_network_pool_new() {
    var p = alloc(NP_SIZE);
    store64(p + NP_HTTP, ratelimit_new(10000, 50));
    store64(p + NP_DNS, ratelimit_new(100000, 200));
    store64(p + NP_PORT, ratelimit_new(50000, 100));
    return p;
}

# NetworkPool::check_http — is an HTTP request to `host` (cstr) allowed under the rate limit?
fn szal_pool_check_http(p, host) {
    return ratelimit_check(load64(p + NP_HTTP), host);
}

# NetworkPool::check_dns — is a DNS lookup for `domain` (cstr) allowed under the rate limit?
fn szal_pool_check_dns(p, domain) {
    return ratelimit_check(load64(p + NP_DNS), domain);
}

# NetworkPool::check_port — is a port scan for `key` (cstr) allowed under the rate limit?
fn szal_pool_check_port(p, key) {
    return ratelimit_check(load64(p + NP_PORT), key);
}

# Global network pool (Rust's `static NETWORK_POOL: LazyLock<NetworkPool>`). The lazy-init guard is
# the prescribed Cyrius idiom (state.md): 0 = uninitialised. ratelimit_check is internally
# mutex-guarded; the first-call init race is benign for a process-global pool (worst case: a
# duplicate NetworkPool is allocated and one is dropped — never observed under the single-threaded
# MCP dispatch entry, and tolerable since buckets only relax limits).
var _network_pool = 0;

# Accessor for the lazily-initialised global NetworkPool (Rust's NETWORK_POOL).
fn szal_net_pool() {
    if (_network_pool == 0) {
        _network_pool = szal_network_pool_new();
    }
    return _network_pool;
}

# --- mcp_tools_encoding.cyr ---

# mcp_tools_encoding.cyr — MCP encoding tools (ports mcp/tools/encoding_tools.rs): szal_uuid + szal_base64.
#
# Each tool is a `szal_tool_new(szal_tool_def(name, desc, props, required), &handler)` pair; handlers
# have the bote ABI `fn(args_cstr, claims) -> result_cstr` (parse the JSON args, return a result_*
# string's cstr). The group is collected by `szal_encoding_tools()` (a fresh vec), aggregated
# into szal_all_tools() by the final tools file.
#
# PARITY NOTE (base64 decode): bayan's base64_decode does not surface decode errors and does not
# UTF-8-validate, so the Rust MCP_INTERNAL "base64 decode error"/"not valid UTF-8" branches cannot be
# reproduced — invalid input yields best-effort bytes rather than a typed error. The encode and
# valid-decode paths are exact. Recorded in docs/development/parity-notes.md.
#
# Usage: include AFTER src/uuid.cyr + src/mcp.cyr (+ lib/bayan for base64/json, lib/str, lib/vec).

# Maximum number of UUIDs generated in one call (encoding_tools.rs 10).
enum EncodingTools {
    MAX_UUID_COUNT = 100;
}

# Parse a handler's args (a NUL-terminated cstr from the bote ABI) into a json_v object. bayan's
# parser takes a Str, so wrap the cstr first; 0 on parse error (handlers then see absent fields).
fn _parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# szal_uuid handler: generate `count` (default 1, capped 100) UUID v4s. count==1 -> the bare string;
# otherwise a JSON array. Mirrors UuidGen::call (encoding_tools.rs 25-44).
fn _uuid_handler(args, claims) {
    var o = _parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var count = 1;
    var cv = bayan_json_v_obj_get_by_cstr(o, "count");
    if (bayan_json_v_is_int(cv) == 1) {
        var c = bayan_json_v_int(cv);
        if (c >= 0) { count = c; }
    }
    if (count > MAX_UUID_COUNT) { count = MAX_UUID_COUNT; }

    if (count == 1) {
        var hi, lo = szal_uuid_generate();
        # CO-01: bind the cstr before str_from (cstr-returning helper as sole call arg miscompiles).
        var one_c = uuid_to_cstr(hi, lo);
        var one = str_from(one_c);
        var r = szal_result_ok(one);
        return str_data(r);
    }

    var arr = bayan_json_v_arr_new();
    var i = 0;
    while (i < count) {
        var h, l = szal_uuid_generate();
        var u_c = uuid_to_cstr(h, l);
        var u = str_from(u_c);
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(u));
        i = i + 1;
    }
    var rj = szal_result_ok_json(arr);
    return str_data(rj);
}

# szal_base64 handler: encode (default) or decode `input`. Missing input -> Validation error; an
# unknown operation -> Validation error. Mirrors Base64Tool::call (encoding_tools.rs 63-104).
fn _base64_handler(args, claims) {
    var o = _parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var iv = bayan_json_v_obj_get_by_cstr(o, "input");
    if (bayan_json_v_is_str(iv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: input"));
        return str_data(e);
    }
    var input = bayan_json_v_str(iv);

    var op = "encode";
    var opv = bayan_json_v_obj_get_by_cstr(o, "operation");
    if (bayan_json_v_is_str(opv) == 1) { op = str_cstr(bayan_json_v_str(opv)); }

    if (streq(op, "encode") == 1) {
        var enc = base64_encode(str_data(input), str_len(input));
        var es = str_from(enc);
        var re = szal_result_ok(es);
        return str_data(re);
    }
    if (streq(op, "decode") == 1) {
        # base64_decode returns a {ptr, len} pair (raw bytes may contain NULs) — build a Str by length.
        var dec = base64_decode(str_data(input), str_len(input));
        var ds = str_new(load64(dec), load64(dec + 8));
        var rd = szal_result_ok(ds);
        return str_data(rd);
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "invalid operation: ");
    str_builder_add_cstr(sb, op);
    var rv = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(sb));
    return str_data(rv);
}

# Build the szal_uuid property schema (one optional "count" integer).
fn _uuid_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("count",
        "{ \"type\": \"integer\", \"description\": \"Number of UUIDs to generate (default: 1, max: 100)\" }"));
    return v;
}

# Build the szal_base64 property schema ("input" string + optional "operation" enum). The operation
# value is assembled in two pieces to keep each source line within the 120-column limit.
fn _base64_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("input", "{ \"type\": \"string\", \"description\": \"Input string\" }"));
    var ob = str_builder_new();
    str_builder_add_cstr(ob, "{ \"type\": \"string\", \"enum\": [\"encode\", \"decode\"], ");
    str_builder_add_cstr(ob, "\"description\": \"Operation to perform (default: encode)\" }");
    var op_c = str_cstr(str_builder_build(ob));
    vec_push(v, schema_prop_new("operation", op_c));
    return v;
}

# The encoding tool group: szal_uuid, szal_base64. Returns a fresh vec of Tool pairs.
fn szal_encoding_tools() {
    var tools = vec_new();
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_uuid", "Generate one or more UUID v4 identifiers", _uuid_props(), vec_new()),
        &_uuid_handler));
    var b64_req = vec_new();
    vec_push(b64_req, "input");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_base64", "Encode or decode a string using base64", _base64_props(), b64_req),
        &_base64_handler));
    return tools;
}

# --- mcp_tools_hash.cyr ---

# mcp_tools_hash.cyr — MCP hash tools (ports mcp/tools/hash_tools.rs): szal_sha256, szal_md5, szal_random_token.
#
# szal_sha256 hashes a string (`input`) or a file (`file`, routed through szal_validate_path); szal_md5
# hashes a string; szal_random_token emits a cryptographically-random hex token. Each handler has the
# bote ABI `fn(args_cstr, claims) -> result_cstr`; see the "MCP tool-handler porting pattern" in
# docs/development/state.md (cstr/Str parse trap, CO-01 binding, result-envelope shape).
#
# PARITY NOTE (sha256 file cap): Rust's szal_sha256 reads the whole file uncapped (tokio::fs::read).
# The port caps the file read at HASH_FILE_CAP (1 MiB) — a single fixed buffer, consistent with szal's
# file-tool read cap and the security posture. Files larger than the cap hash only their first 1 MiB.
# Recorded in docs/development/parity-notes.md. (The hash_tools.rs file test uses 12 bytes.)
#
# Usage: include AFTER src/md5.cyr + lib/sigil.cyr (sha256_hex/hex_encode) + lib/random.cyr +
#   lib/io.cyr (file_read_all) + src/mcp.cyr (szal_validate_path/szal_result_*).

enum HashTools {
    HASH_FILE_CAP = 1048576;
    RANDOM_TOKEN_MAX = 256;
}

# Parse a handler's args cstr into a json_v object (bayan wants a Str — wrap the cstr first).
fn _hash_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# Build {"algorithm":<algo>, "hash":<hex>, "input_bytes":<n>} as a szal_result_ok_json string's cstr.
fn _hash_result(algo, hex_c, nbytes) {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("algorithm"), bayan_json_v_str_new(str_from(algo)));
    var hs = str_from(hex_c);
    bayan_json_v_obj_set(obj, str_from("hash"), bayan_json_v_str_new(hs));
    bayan_json_v_obj_set(obj, str_from("input_bytes"), bayan_json_v_int_new(nbytes));
    var r = szal_result_ok_json(obj);
    return str_data(r);
}

# szal_sha256 handler: hash `input` (string) or `file` (path, via szal_validate_path). Neither -> Validation.
# Mirrors Sha256::call (hash_tools.rs 26-65).
fn _sha256_handler(args, claims) {
    var o = _hash_parse_args(args);
    if (o == 0) { return szal_args_error(args); }

    var iv = bayan_json_v_obj_get_by_cstr(o, "input");
    if (bayan_json_v_is_str(iv) == 1) {
        var input = bayan_json_v_str(iv);
        var h = sha256_hex(str_data(input), str_len(input));
        return _hash_result("sha256", h, str_len(input));
    }

    var fv = bayan_json_v_obj_get_by_cstr(o, "file");
    if (bayan_json_v_is_str(fv) == 1) {
        var path = bayan_json_v_str(fv);
        var vr_t, vr_v = szal_validate_path(path);
        if (is_err_result(vr_t) == 1) {
            var e = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, err_code_of(vr_t, vr_v));
            return str_data(e);
        }
        var vpath = result_unwrap(vr_t, vr_v);
        var pc = str_cstr(vpath);
        var buf = alloc(HASH_FILE_CAP);
        var n = file_read_all(pc, buf, HASH_FILE_CAP);
        if (n < 0) {
            var eb = str_builder_new();
            str_builder_add_cstr(eb, "failed to read ");
            str_builder_add(eb, vpath);
            var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
            return str_data(er);
        }
        var fh = sha256_hex(buf, n);
        return _hash_result("sha256", fh, n);
    }

    var ev = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("provide either 'input' or 'file'"));
    return str_data(ev);
}

# szal_md5 handler: hash the required `input` string. Mirrors Md5::call (hash_tools.rs 83-109).
fn _md5_handler(args, claims) {
    var o = _hash_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var iv = bayan_json_v_obj_get_by_cstr(o, "input");
    if (bayan_json_v_is_str(iv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: input"));
        return str_data(e);
    }
    var input = bayan_json_v_str(iv);
    var h = md5_hex(str_data(input), str_len(input));
    return _hash_result("md5", h, str_len(input));
}

# szal_random_token handler: `bytes` random bytes (default 32, cap 256) as a hex token. Mirrors
# RandomToken::call (hash_tools.rs 125-159).
fn _random_token_handler(args, claims) {
    var o = _hash_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var nbytes = 32;
    var bv = bayan_json_v_obj_get_by_cstr(o, "bytes");
    if (bayan_json_v_is_int(bv) == 1) {
        var b = bayan_json_v_int(bv);
        if (b >= 0) { nbytes = b; }
    }
    if (nbytes > RANDOM_TOKEN_MAX) { nbytes = RANDOM_TOKEN_MAX; }

    var buf = alloc(nbytes + 1);
    var nr = random_bytes(buf, nbytes);
    if (nr < 0) {
        var e = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_from("failed to read random bytes"));
        return str_data(e);
    }
    var hexc = hex_encode(buf, nbytes);
    var hs = str_from(hexc);
    var r = szal_result_ok(hs);
    return str_data(r);
}

# --- schema property builders ---

fn _sha256_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("input",
        "{ \"type\": \"string\", \"description\": \"String to hash (mutually exclusive with file)\" }"));
    vec_push(v, schema_prop_new("file",
        "{ \"type\": \"string\", \"description\": \"File path to hash (mutually exclusive with input)\" }"));
    return v;
}

fn _md5_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("input", "{ \"type\": \"string\", \"description\": \"String to hash\" }"));
    return v;
}

fn _random_token_props() {
    var v = vec_new();
    var b = str_builder_new();
    str_builder_add_cstr(b, "{ \"type\": \"integer\", \"description\": ");
    str_builder_add_cstr(b, "\"Number of random bytes (default: 32, output is 2x hex chars)\" }");
    var bytes_c = str_cstr(str_builder_build(b));
    vec_push(v, schema_prop_new("bytes", bytes_c));
    return v;
}

# The hash tool group: szal_sha256, szal_md5, szal_random_token. Returns a fresh vec of Tool pairs.
fn szal_hash_tools() {
    var tools = vec_new();
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_sha256", "Compute SHA-256 hash of a string or file contents",
          _sha256_props(), vec_new()), &_sha256_handler));

    var md5_req = vec_new();
    vec_push(md5_req, "input");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_md5", "Compute MD5 hash of a string (for checksums, not security)",
          _md5_props(), md5_req), &_md5_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_random_token", "Generate a cryptographically random hex token",
          _random_token_props(), vec_new()), &_random_token_handler));
    return tools;
}

# --- mcp_tools_system.cyr ---

# mcp_tools_system.cyr — MCP system tools (ports mcp/tools/system_tools.rs): szal_system_info,
# szal_cwd, szal_env_get, szal_timestamp.
#
# Handlers follow the bote ABI `fn(args_cstr, claims) -> result_cstr` and the porting pattern in
# docs/development/state.md (cstr/Str parse trap, CO-01, result-envelope shape).
#
# PARITY NOTES:
# - os/arch: Rust uses `std::env::consts::{OS,ARCH}` (compile-time for the build target). The port
#   hardcodes "linux"/"x86_64" — exactly what those consts resolve to on szal's 2.0.0 target — and,
#   from 2.3.3, "agnos" for an `--agnos` build (compile-time too: `CYRIUS_TARGET_AGNOS`). Recorded §14.
# - cpus on agnos is 0 (Rust's own "unknown"): sched_getaffinity is Linux's #204, which is no agnos
#   call, and the agnos peer has no CPU count. (Through 2.3.2 the raw #204 reached agnos too.)
# - timestamp iso8601 is SECOND-precision UTC ("…Z"), not Rust's sub-second RFC3339-with-offset —
#   the existing chrono limitation (parity-notes; iso8601 can't round-trip subseconds).
#
# Usage: include AFTER src/mcp.cyr (+ lib/io getenv/file_read_all, lib/chrono iso8601, lib/bayan).

# Per-call read caps for the small /proc + /etc reads.
enum SystemTools {
    SYS_HOSTNAME_CAP = 256;
    SYS_UPTIME_CAP = 128;
}

fn _sys_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# Count online CPUs via sched_getaffinity(0, 128, &mask) (syscall 204) + popcount. 0 on failure, and
# always 0 on agnos (see the module header).
fn _sys_cpu_count() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var mask = alloc(128);
    var n = syscall(204, 0, 128, mask);
    if (n <= 0) { return 0; }
    var count = 0;
    var i = 0;
    while (i < n) {
        var b = load8(mask + i) & 0xFF;
        while (b != 0) {
            count = count + (b & 1);
            b = b >> 1;
        }
        i = i + 1;
    }
    return count;
    #endif
}

# /etc/hostname contents with trailing whitespace trimmed; "unknown" if unreadable (system_tools.rs 26-30).
fn _sys_hostname() {
    var buf = alloc(SYS_HOSTNAME_CAP);
    var n = file_read_all("/etc/hostname", buf, SYS_HOSTNAME_CAP);
    if (n <= 0) { return str_from("unknown"); }
    var trimming = 1;
    while (trimming == 1) {
        if (n <= 0) {
            trimming = 0;
        } else {
            var c = load8(buf + n - 1);
            if (c == 10 || c == 13 || c == 32 || c == 9) { n = n - 1; } else { trimming = 0; }
        }
    }
    return str_new(buf, n);
}

# Length of the first whitespace-delimited token in buf[0..n].
fn _sys_token_len(buf, n) {
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c == 32 || c == 10 || c == 9 || c == 13) { return i; }
        i = i + 1;
    }
    return n;
}

# /proc/uptime first token as a float json_v, or null if unreadable/unparseable (system_tools.rs 39-43).
fn _sys_uptime_json() {
    var buf = alloc(SYS_UPTIME_CAP);
    var n = file_read_all("/proc/uptime", buf, SYS_UPTIME_CAP);
    if (n <= 0) { return bayan_json_v_null(); }
    var tlen = _sys_token_len(buf, n);
    # bayan 1.3.0+ renamed the cstr+len entry `_parse_str` -> `_parse_buf` (the `_str` suffix is
    # reserved for the Str-taking overload, which Cyrius auto-dispatches to). Same signature.
    var v = bayan_json_v_parse_buf(buf, tlen);
    if (v == 0) { return bayan_json_v_null(); }
    return v;
}

# The build target's OS name, as Rust's std::env::consts::OS spells it: "agnos" or "linux" (a cstr).
fn _sys_os_name() {
    #ifdef CYRIUS_TARGET_AGNOS
    return "agnos";
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return "linux";
    #endif
}

# szal_system_info: hostname, os, arch, cpus, uptime_secs. Mirrors SystemInfo::call (system_tools.rs 26-51).
fn _system_info_handler(args, claims) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("hostname"), bayan_json_v_str_new(_sys_hostname()));
    bayan_json_v_obj_set(o, str_from("os"), bayan_json_v_str_new(str_from(_sys_os_name())));
    bayan_json_v_obj_set(o, str_from("arch"), bayan_json_v_str_new(str_from("x86_64")));
    bayan_json_v_obj_set(o, str_from("cpus"), bayan_json_v_int_new(_sys_cpu_count()));
    bayan_json_v_obj_set(o, str_from("uptime_secs"), _sys_uptime_json());
    var r = szal_result_ok_json(o);
    return str_data(r);
}

# szal_cwd: the current working directory. Mirrors Cwd::call (system_tools.rs 73-78).
fn _cwd_handler(args, claims) {
    var cwd = _mcp_getcwd();
    if (cwd == 0) {
        var e = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_from("failed to get current directory"));
        return str_data(e);
    }
    var p = str_from(cwd);
    var r = szal_result_ok(p);
    return str_data(r);
}

# szal_env_get: value of env var `name` (required). Unset -> NotFound. Mirrors EnvGet::call (system_tools.rs 95-116).
fn _env_get_handler(args, claims) {
    var o = _sys_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var nv = bayan_json_v_obj_get_by_cstr(o, "name");
    if (bayan_json_v_is_str(nv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: name"));
        return str_data(e);
    }
    var name = bayan_json_v_str(nv);
    var name_c = str_cstr(name);
    var val = getenv(name_c);
    if (val == 0) {
        var nb = str_builder_new();
        str_builder_add_cstr(nb, "environment variable not set: ");
        str_builder_add(nb, name);
        var en = szal_result_error_typed(SZAL_MCP_NOT_FOUND, str_builder_build(nb));
        return str_data(en);
    }
    var vs = str_from(val);
    var r = szal_result_ok(vs);
    return str_data(r);
}

# szal_timestamp: current time as iso8601 (second precision) + unix secs/ms.
# Mirrors Timestamp::call (system_tools.rs 133-145).
fn _timestamp_handler(args, claims) {
    var secs = clock_epoch_secs();
    var iso = iso8601(secs);
    var o = bayan_json_v_obj_new();
    var iss = str_from(iso);
    bayan_json_v_obj_set(o, str_from("iso8601"), bayan_json_v_str_new(iss));
    bayan_json_v_obj_set(o, str_from("unix_secs"), bayan_json_v_int_new(secs));
    bayan_json_v_obj_set(o, str_from("unix_ms"), bayan_json_v_int_new(clock_epoch_ns() / 1000000));
    var r = szal_result_ok_json(o);
    return str_data(r);
}

# --- schema property builders ---

fn _env_get_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("name",
        "{ \"type\": \"string\", \"description\": \"Environment variable name\" }"));
    return v;
}

# The system tool group: szal_system_info, szal_cwd, szal_env_get, szal_timestamp.
fn szal_system_tools() {
    var tools = vec_new();
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_system_info", "Get system hostname, OS, architecture, CPU count, and uptime",
          vec_new(), vec_new()), &_system_info_handler));
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_cwd", "Get the current working directory", vec_new(), vec_new()),
        &_cwd_handler));
    var env_req = vec_new();
    vec_push(env_req, "name");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_env_get", "Get the value of an environment variable", _env_get_props(), env_req),
        &_env_get_handler));
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_timestamp", "Get the current timestamp in ISO 8601 and Unix epoch formats",
          vec_new(), vec_new()), &_timestamp_handler));
    return tools;
}

# --- mcp_tools_json.cyr ---

# mcp_tools_json.cyr — MCP JSON tools (ports mcp/tools/json_tools.rs): szal_json_path, szal_json_diff,
# szal_json_validate.
#
# Handlers follow the bote ABI + the porting pattern in docs/development/state.md.
#
# PARITY NOTE (validate error detail): bayan's parser reports a byte position + message, not serde's
# line/column. The invalid-JSON result therefore carries {valid:false, error, position} rather than
# {error, line, column}. The json_validate_bad test only asserts `"valid": false`. Recorded §15.
#
# Usage: include AFTER src/mcp.cyr (+ lib/bayan, lib/str, lib/vec).

fn _json_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# serde Value::== — structural deep equality. Objects are order-independent; INT and FLOAT are
# distinct (serde treats 1 and 1.0 as unequal). Mirrors `a == b` (json_tools.rs 147).
fn _json_eq(a, b) {
    var ta = load64(a);
    var tb = load64(b);
    if (ta != tb) { return 0; }
    if (ta == JTAG_NULL) { return 1; }
    if (ta == JTAG_BOOL) {
        if (bayan_json_v_bool(a) == bayan_json_v_bool(b)) { return 1; }
        return 0;
    }
    if (ta == JTAG_INT) {
        if (bayan_json_v_int(a) == bayan_json_v_int(b)) { return 1; }
        return 0;
    }
    if (ta == JTAG_FLOAT) {
        if (f64_eq(bayan_json_v_float(a), bayan_json_v_float(b)) == 1) { return 1; }
        return 0;
    }
    if (ta == JTAG_STR) {
        if (str_eq(bayan_json_v_str(a), bayan_json_v_str(b)) == 1) { return 1; }
        return 0;
    }
    if (ta == JTAG_ARR) {
        var na = bayan_json_v_arr_len(a);
        if (na != bayan_json_v_arr_len(b)) { return 0; }
        var i = 0;
        while (i < na) {
            if (_json_eq(bayan_json_v_arr_get(a, i), bayan_json_v_arr_get(b, i)) == 0) { return 0; }
            i = i + 1;
        }
        return 1;
    }
    if (ta == JTAG_OBJ) {
        var pa = load64(a + 8);
        var pb = load64(b + 8);
        var n = vec_len(pa);
        if (n != vec_len(pb)) { return 0; }
        var i = 0;
        while (i < n) {
            var pair = vec_get(pa, i);
            var key = load64(pair);
            var va = load64(pair + 8);
            var kc = str_cstr(key);
            var vb = bayan_json_v_obj_get_by_cstr(b, kc);
            if (vb == 0) { return 0; }
            if (_json_eq(va, vb) == 0) { return 0; }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

# serde Value type name (json_tools.rs 157-166). INT/FLOAT both -> "number".
fn _json_type_name(v) {
    var t = load64(v);
    if (t == JTAG_NULL) { return "null"; }
    if (t == JTAG_BOOL) { return "boolean"; }
    if (t == JTAG_INT) { return "number"; }
    if (t == JTAG_FLOAT) { return "number"; }
    if (t == JTAG_STR) { return "string"; }
    if (t == JTAG_ARR) { return "array"; }
    if (t == JTAG_OBJ) { return "object"; }
    return "null";
}

# Parse a path segment as a usize array index (all-digits, non-empty). -1 if not an index.
fn _json_seg_index(seg) {
    var n = str_len(seg);
    if (n == 0) { return (0 - 1); }
    var d = str_data(seg);
    var val = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 48 || c > 57) { return (0 - 1); }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    return val;
}

# szal_json_path: extract a value by dot-separated path. Numeric segments index arrays; others key
# objects. Mirrors JsonPath::call (json_tools.rs 24-84).
fn _json_path_handler(args, claims) {
    var o = _json_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: json"));
        return str_data(e);
    }
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: path"));
        return str_data(e2);
    }

    var json_str = bayan_json_v_str(jv);
    var value = bayan_json_v_parse(json_str);
    if (value == 0) {
        var ej = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid JSON"));
        return str_data(ej);
    }

    var path = bayan_json_v_str(pv);
    var segs = str_split(path, 46);
    var current = value;
    var k = 0;
    var nseg = vec_len(segs);
    while (k < nseg) {
        var seg = vec_get(segs, k);
        k = k + 1;
        var idx = _json_seg_index(seg);
        if (idx >= 0) {
            var next = 0;
            if (bayan_json_v_is_arr(current) == 1) {
                if (idx < bayan_json_v_arr_len(current)) { next = bayan_json_v_arr_get(current, idx); }
            }
            if (next == 0) {
                var nb = str_builder_new();
                str_builder_add_cstr(nb, "index ");
                str_builder_add_int(nb, idx);
                str_builder_add_cstr(nb, " not found at '");
                str_builder_add(nb, seg);
                str_builder_add_cstr(nb, "'");
                var en = szal_result_error_typed(SZAL_MCP_NOT_FOUND, str_builder_build(nb));
                return str_data(en);
            }
            current = next;
        } else {
            var sc = str_cstr(seg);
            var nx = bayan_json_v_obj_get_by_cstr(current, sc);
            if (nx == 0) {
                var kb = str_builder_new();
                str_builder_add_cstr(kb, "key '");
                str_builder_add(kb, seg);
                str_builder_add_cstr(kb, "' not found");
                var ek = szal_result_error_typed(SZAL_MCP_NOT_FOUND, str_builder_build(kb));
                return str_data(ek);
            }
            current = nx;
        }
    }

    var r = szal_result_ok_json(current);
    return str_data(r);
}

# Parse the named string field as JSON, or emit a typed Validation error naming the field. Returns the
# json_v on success; on failure writes the result cstr to *out_err (a 1-slot cell) and returns 0.
fn _json_field_or_err(o, field, out_err) {
    var fv = bayan_json_v_obj_get_by_cstr(o, field);
    if (bayan_json_v_is_str(fv) == 0) {
        var mb = str_builder_new();
        str_builder_add_cstr(mb, "missing required field: ");
        str_builder_add_cstr(mb, field);
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(mb));
        store64(out_err, str_data(e));
        return 0;
    }
    var parsed = bayan_json_v_parse(bayan_json_v_str(fv));
    if (parsed == 0) {
        var ib = str_builder_new();
        str_builder_add_cstr(ib, "invalid JSON in '");
        str_builder_add_cstr(ib, field);
        str_builder_add_cstr(ib, "'");
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(ib));
        store64(out_err, str_data(e2));
        return 0;
    }
    return parsed;
}

# szal_json_diff: structural equality + both type names. Mirrors JsonDiff::call (json_tools.rs 104-154).
fn _json_diff_handler(args, claims) {
    var o = _json_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var err = alloc(8);
    store64(err, 0);

    var a = _json_field_or_err(o, "a", err);
    if (a == 0) { return load64(err); }
    var b = _json_field_or_err(o, "b", err);
    if (b == 0) { return load64(err); }

    var equal = _json_eq(a, b);
    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("equal"), bayan_json_v_bool_new(equal));
    bayan_json_v_obj_set(out, str_from("a_type"), bayan_json_v_str_new(str_from(_json_type_name(a))));
    bayan_json_v_obj_set(out, str_from("b_type"), bayan_json_v_str_new(str_from(_json_type_name(b))));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# szal_json_validate: report whether the input parses + its structure. Mirrors JsonValidate::call
# (json_tools.rs 181-212). Valid -> {valid,type,size_bytes}; invalid -> {valid,error,position}.
fn _json_validate_handler(args, claims) {
    var o = _json_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: json"));
        return str_data(e);
    }
    var json_str = bayan_json_v_str(jv);
    var value = bayan_json_v_parse(json_str);

    var info = bayan_json_v_obj_new();
    if (value != 0) {
        bayan_json_v_obj_set(info, str_from("valid"), bayan_json_v_bool_new(1));
        bayan_json_v_obj_set(info, str_from("type"), bayan_json_v_str_new(str_from(_json_type_name(value))));
        bayan_json_v_obj_set(info, str_from("size_bytes"), bayan_json_v_int_new(str_len(json_str)));
    } else {
        bayan_json_v_obj_set(info, str_from("valid"), bayan_json_v_bool_new(0));
        var emsg = "parse error";
        if (_json_err_msg != 0) { emsg = _json_err_msg; }
        bayan_json_v_obj_set(info, str_from("error"), bayan_json_v_str_new(str_from(emsg)));
        bayan_json_v_obj_set(info, str_from("position"), bayan_json_v_int_new(_json_err_pos));
    }
    var r = szal_result_ok_json(info);
    return str_data(r);
}

# --- schema property builders ---

fn _json_path_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("json", "{ \"type\": \"string\", \"description\": \"JSON string\" }"));
    vec_push(v, schema_prop_new("path",
        "{ \"type\": \"string\", \"description\": \"Dot-separated path (e.g. 'data.items.0.name')\" }"));
    return v;
}

fn _json_diff_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("a", "{ \"type\": \"string\", \"description\": \"First JSON string\" }"));
    vec_push(v, schema_prop_new("b", "{ \"type\": \"string\", \"description\": \"Second JSON string\" }"));
    return v;
}

fn _json_validate_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("json",
        "{ \"type\": \"string\", \"description\": \"JSON string to validate\" }"));
    return v;
}

# req vec [json, path] etc.
fn _req2(a, b) {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    return v;
}

# The JSON tool group: szal_json_path, szal_json_diff, szal_json_validate.
fn szal_json_tools() {
    var tools = vec_new();
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_json_path",
          "Extract a value from JSON using a dot-separated path (e.g. 'a.b.c' or 'a.0.b')",
          _json_path_props(), _req2("json", "path")), &_json_path_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_json_diff", "Compare two JSON values and report differences",
          _json_diff_props(), _req2("a", "b")), &_json_diff_handler));

    var jv_req = vec_new();
    vec_push(jv_req, "json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_json_validate",
          "Validate a JSON string — check if it parses correctly and report structure",
          _json_validate_props(), jv_req), &_json_validate_handler));
    return tools;
}

# --- mcp_tools_template.cyr ---

# mcp_tools_template.cyr — MCP template/text tools (ports mcp/tools/template_tools.rs):
# szal_template_render, szal_wc, szal_text_replace, szal_text_split, szal_text_join.
#
# szal_template_render reuses szal's own condition.cond_render_template (the ported {{var}} renderer).
# Handlers follow the bote ABI + the porting pattern in docs/development/state.md.
#
# PARITY NOTE (wc file cap): like szal_sha256, szal_wc reads a `file` arg through a fixed
# WC_FILE_CAP (1 MiB) buffer (Rust reads it uncapped). Text-field counting is exact. Recorded §16.
#
# Usage: include AFTER src/condition.cyr + src/mcp.cyr (+ lib/bayan, lib/str, lib/vec, lib/io).

enum TemplateTools {
    WC_FILE_CAP = 1048576;
}

fn _tpl_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# First index >= `start` of `needle` within `s`, or -1. Empty needle -> `start`.
fn _indexof_sub(s, start, needle) {
    var sl = str_len(s);
    var nl = str_len(needle);
    if (nl == 0) { return start; }
    var sd = str_data(s);
    var nd = str_data(needle);
    var i = start;
    while (i + nl <= sl) {
        var j = 0;
        var matched = 1;
        while (j < nl) {
            if (load8(sd + i + j) != load8(nd + j)) { matched = 0; j = nl; } else { j = j + 1; }
        }
        if (matched == 1) { return i; }
        i = i + 1;
    }
    return (0 - 1);
}

# Replace occurrences of `search` with `replace` in `text` (all, or just the first if all==0).
# Mirrors str::replace / replacen (template_tools.rs 166-170). Empty search is a no-op.
fn _str_replace(text, search, replace, all) {
    var sl = str_len(search);
    if (sl == 0) { return text; }
    var tl = str_len(text);
    var sb = str_builder_new();
    var pos = 0;
    var done = 0;
    while (done == 0) {
        var idx = _indexof_sub(text, pos, search);
        if (idx < 0) {
            str_builder_add(sb, str_substr(text, pos, tl));
            done = 1;
        } else {
            str_builder_add(sb, str_substr(text, pos, idx));
            str_builder_add(sb, replace);
            pos = idx + sl;
            if (all == 0) {
                str_builder_add(sb, str_substr(text, pos, tl));
                done = 1;
            }
        }
    }
    return str_builder_build(sb);
}

# Split `text` on the string `delim` into a vec of Str parts (str::split semantics).
fn _split_by_str(text, delim) {
    var parts = vec_new();
    var dl = str_len(delim);
    var tl = str_len(text);
    if (dl == 0) {
        vec_push(parts, text);
        return parts;
    }
    var pos = 0;
    var done = 0;
    while (done == 0) {
        var idx = _indexof_sub(text, pos, delim);
        if (idx < 0) {
            vec_push(parts, str_substr(text, pos, tl));
            done = 1;
        } else {
            vec_push(parts, str_substr(text, pos, idx));
            pos = idx + dl;
        }
    }
    return parts;
}

# --- word-count helpers (operate on a raw byte range) ---
fn _wc_is_ws(c) {
    if (c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12) { return 1; }
    return 0;
}
fn _wc_lines(d, n) {
    if (n == 0) { return 0; }
    var nl = 0;
    var i = 0;
    while (i < n) {
        if (load8(d + i) == 10) { nl = nl + 1; }
        i = i + 1;
    }
    if ((load8(d + n - 1) & 0xFF) != 10) { nl = nl + 1; }
    return nl;
}
fn _wc_words(d, n) {
    var w = 0;
    var in_word = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (_wc_is_ws(c) == 1) { in_word = 0; } else {
            if (in_word == 0) { w = w + 1; in_word = 1; }
        }
        i = i + 1;
    }
    return w;
}
fn _wc_chars(d, n) {
    var c = 0;
    var i = 0;
    while (i < n) {
        var b = load8(d + i) & 0xFF;
        if ((b & 0xC0) != 0x80) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# szal_template_render: {{var}} substitution via the condition renderer. Mirrors TemplateRender::call
# (template_tools.rs 24-52).
fn _template_render_handler(args, claims) {
    var o = _tpl_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var tv = bayan_json_v_obj_get_by_cstr(o, "template");
    if (bayan_json_v_is_str(tv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: template"));
        return str_data(e);
    }
    var vv = bayan_json_v_obj_get_by_cstr(o, "variables");
    if (bayan_json_v_is_obj(vv) == 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: variables"));
        return str_data(e2);
    }
    var rendered = cond_render_template(bayan_json_v_str(tv), vv);
    var r = szal_result_ok(rendered);
    return str_data(r);
}

# szal_wc: count lines/words/chars/bytes of `text` or a `file`. Mirrors WordCount::call (template_tools.rs 71-111).
fn _wc_handler(args, claims) {
    var o = _tpl_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var dptr = 0;
    var dlen = 0;

    var tv = bayan_json_v_obj_get_by_cstr(o, "text");
    if (bayan_json_v_is_str(tv) == 1) {
        var input = bayan_json_v_str(tv);
        dptr = str_data(input);
        dlen = str_len(input);
    } else {
        var fv = bayan_json_v_obj_get_by_cstr(o, "file");
        if (bayan_json_v_is_str(fv) == 1) {
            var path = bayan_json_v_str(fv);
            var vr_t, vr_v = szal_validate_path(path);
            if (is_err_result(vr_t) == 1) {
                var e = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, err_code_of(vr_t, vr_v));
                return str_data(e);
            }
            var vpath = result_unwrap(vr_t, vr_v);
            var pc = str_cstr(vpath);
            var buf = alloc(WC_FILE_CAP);
            var n = file_read_all(pc, buf, WC_FILE_CAP);
            if (n < 0) {
                var eb = str_builder_new();
                str_builder_add_cstr(eb, "failed to read ");
                str_builder_add(eb, vpath);
                var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
                return str_data(er);
            }
            dptr = buf;
            dlen = n;
        } else {
            var ev = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("provide either 'text' or 'file'"));
            return str_data(ev);
        }
    }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("lines"), bayan_json_v_int_new(_wc_lines(dptr, dlen)));
    bayan_json_v_obj_set(out, str_from("words"), bayan_json_v_int_new(_wc_words(dptr, dlen)));
    bayan_json_v_obj_set(out, str_from("chars"), bayan_json_v_int_new(_wc_chars(dptr, dlen)));
    bayan_json_v_obj_set(out, str_from("bytes"), bayan_json_v_int_new(dlen));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# szal_text_replace: replace `search` with `replace` (all by default).
# Mirrors TextReplace::call (template_tools.rs 132-173).
fn _text_replace_handler(args, claims) {
    var o = _tpl_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var tv = bayan_json_v_obj_get_by_cstr(o, "text");
    if (bayan_json_v_is_str(tv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: text"));
        return str_data(e);
    }
    var sv = bayan_json_v_obj_get_by_cstr(o, "search");
    if (bayan_json_v_is_str(sv) == 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: search"));
        return str_data(e2);
    }
    var rv = bayan_json_v_obj_get_by_cstr(o, "replace");
    if (bayan_json_v_is_str(rv) == 0) {
        var e3 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: replace"));
        return str_data(e3);
    }
    var all = 1;
    var av = bayan_json_v_obj_get_by_cstr(o, "all");
    if (bayan_json_v_is_bool(av) == 1) { all = bayan_json_v_bool(av); }

    var result = _str_replace(bayan_json_v_str(tv), bayan_json_v_str(sv), bayan_json_v_str(rv), all);
    var rr = szal_result_ok(result);
    return str_data(rr);
}

# szal_text_split: split `text` by `delimiter` (default newline) into a JSON array. Mirrors TextSplit::call
# (template_tools.rs 193-215).
fn _text_split_handler(args, claims) {
    var o = _tpl_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var tv = bayan_json_v_obj_get_by_cstr(o, "text");
    if (bayan_json_v_is_str(tv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: text"));
        return str_data(e);
    }
    var delim = str_from("\n");
    var dv = bayan_json_v_obj_get_by_cstr(o, "delimiter");
    if (bayan_json_v_is_str(dv) == 1) { delim = bayan_json_v_str(dv); }

    var parts = _split_by_str(bayan_json_v_str(tv), delim);
    var arr = bayan_json_v_arr_new();
    var n = vec_len(parts);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(vec_get(parts, i)));
        i = i + 1;
    }
    var pretty = bayan_json_v_build_pretty(arr, 2);
    var r = szal_result_ok(pretty);
    return str_data(r);
}

# szal_text_join: join string elements of `parts` with `separator` (default newline). Mirrors TextJoin::call
# (template_tools.rs 234-253).
fn _text_join_handler(args, claims) {
    var o = _tpl_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var pv = bayan_json_v_obj_get_by_cstr(o, "parts");
    if (bayan_json_v_is_arr(pv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: parts"));
        return str_data(e);
    }
    var sep = str_from("\n");
    var sv = bayan_json_v_obj_get_by_cstr(o, "separator");
    if (bayan_json_v_is_str(sv) == 1) { sep = bayan_json_v_str(sv); }

    var sb = str_builder_new();
    var first = 1;
    var n = bayan_json_v_arr_len(pv);
    var i = 0;
    while (i < n) {
        var e2 = bayan_json_v_arr_get(pv, i);
        if (bayan_json_v_is_str(e2) == 1) {
            if (first == 0) { str_builder_add(sb, sep); }
            str_builder_add(sb, bayan_json_v_str(e2));
            first = 0;
        }
        i = i + 1;
    }
    var joined = str_builder_build(sb);
    var r = szal_result_ok(joined);
    return str_data(r);
}

# --- schema property builders ---

fn _tpl_render_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("template",
        "{ \"type\": \"string\", \"description\": \"Template string with {{var}} placeholders\" }"));
    vec_push(v, schema_prop_new("variables",
        "{ \"type\": \"object\", \"description\": \"Key-value pairs for substitution\" }"));
    return v;
}

fn _wc_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("text",
        "{ \"type\": \"string\", \"description\": \"Text to count (mutually exclusive with file)\" }"));
    vec_push(v, schema_prop_new("file",
        "{ \"type\": \"string\", \"description\": \"File path to count (mutually exclusive with text)\" }"));
    return v;
}

fn _text_replace_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("text", "{ \"type\": \"string\", \"description\": \"Input text\" }"));
    vec_push(v, schema_prop_new("search", "{ \"type\": \"string\", \"description\": \"Text to find\" }"));
    vec_push(v, schema_prop_new("replace", "{ \"type\": \"string\", \"description\": \"Replacement text\" }"));
    var ab = str_builder_new();
    str_builder_add_cstr(ab, "{ \"type\": \"boolean\", \"description\": ");
    str_builder_add_cstr(ab, "\"Replace all occurrences (default: true)\" }");
    var all_c = str_cstr(str_builder_build(ab));
    vec_push(v, schema_prop_new("all", all_c));
    return v;
}

fn _text_split_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("text", "{ \"type\": \"string\", \"description\": \"Text to split\" }"));
    vec_push(v, schema_prop_new("delimiter",
        "{ \"type\": \"string\", \"description\": \"Delimiter (default: newline)\" }"));
    return v;
}

fn _text_join_props() {
    var v = vec_new();
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "{ \"type\": \"array\", \"items\": { \"type\": \"string\" }, ");
    str_builder_add_cstr(pb, "\"description\": \"Array of strings to join\" }");
    var parts_c = str_cstr(str_builder_build(pb));
    vec_push(v, schema_prop_new("parts", parts_c));
    vec_push(v, schema_prop_new("separator",
        "{ \"type\": \"string\", \"description\": \"Separator (default: newline)\" }"));
    return v;
}

fn _req3(a, b, c) {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    return v;
}

fn _req1(a) {
    var v = vec_new();
    vec_push(v, a);
    return v;
}

# The template/text tool group: render, wc, text_replace, text_split, text_join.
fn szal_template_tools() {
    var tools = vec_new();
    var tr_req = vec_new();
    vec_push(tr_req, "template");
    vec_push(tr_req, "variables");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_template_render", "Render a mustache-style template with {{variable}} substitution",
          _tpl_render_props(), tr_req), &_template_render_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_wc", "Count lines, words, and characters in text", _wc_props(), vec_new()),
        &_wc_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_text_replace", "Search and replace text in a string",
          _text_replace_props(), _req3("text", "search", "replace")), &_text_replace_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_text_split", "Split text by a delimiter and return as JSON array",
          _text_split_props(), _req1("text")), &_text_split_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_text_join", "Join array elements into a single string with a separator",
          _text_join_props(), _req1("parts")), &_text_join_handler));
    return tools;
}

# --- mcp_tools_conversion.cyr ---

# mcp_tools_conversion.cyr — MCP conversion tools (ports mcp/tools/conversion_tools.rs):
# szal_base_convert, szal_byte_format, szal_duration_format.
#
# Handlers follow the bote ABI + the porting pattern in docs/development/state.md.
#
# PARITY NOTE (base_convert width): Rust parses/formats via u128. Cyrius has no 128-bit int (no
# bigint dep), so the port uses i64 — values ≥ 2^63 are unsupported (same u64→i64 family as
# parity-notes §1). The conversion_tools.rs tests use small values. Recorded §17.
#
# Usage: include AFTER src/mcp.cyr (+ lib/bayan, lib/str, lib/fmt for fmt_float_buf).

enum ConversionTools {
    SZAL_SECS_PER_MINUTE = 60;
    SZAL_SECS_PER_HOUR = 3600;
    SZAL_SECS_PER_DAY = 86400;
    SZAL_BYTES_PER_KB = 1024;
    SZAL_BYTES_PER_MB = 1048576;
    SZAL_BYTES_PER_GB = 1073741824;
    SZAL_BYTES_PER_TB = 1099511627776;
}

fn _conv_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# --- base convert ---

# Numeric value of a base digit (0-9, a-z, A-Z), or -1 if not a digit.
fn _digit_val(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 122) { return c - 97 + 10; }
    if (c >= 65 && c <= 90) { return c - 65 + 10; }
    return (0 - 1);
}

# Parse buf[0..n] as an unsigned integer in `base`. -1 on any invalid/out-of-range digit or empty.
fn _parse_radix(d, n, base) {
    if (n == 0) { return (0 - 1); }
    var val = 0;
    var i = 0;
    while (i < n) {
        var dv = _digit_val(load8(d + i) & 0xFF);
        if (dv < 0 || dv >= base) { return (0 - 1); }
        val = val * base + dv;
        i = i + 1;
    }
    return val;
}

# Format `n` in `base` (lowercase) prefixed by `prefix_cstr` (e.g. "0x", "0b", "0o", or "").
fn _fmt_radix(n, base, prefix_cstr) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix_cstr);
    if (n == 0) {
        str_builder_add_byte(sb, 48);
        return str_builder_build(sb);
    }
    var tmp = alloc(70);
    var ti = 0;
    var v = n;
    while (v > 0) {
        var dd = v % base;
        var ch = 48 + dd;
        if (dd >= 10) { ch = 97 + dd - 10; }
        store8(tmp + ti, ch);
        ti = ti + 1;
        v = v / base;
    }
    var k = ti - 1;
    while (k >= 0) {
        str_builder_add_byte(sb, load8(tmp + k));
        k = k - 1;
    }
    return str_builder_build(sb);
}

# A base is supported iff it is 2, 8, 10, or 16.
fn _valid_base(b) {
    if (b == 2 || b == 8 || b == 10 || b == 16) { return 1; }
    return 0;
}

# Strip a leading 0x/0X/0b/0B/0o/0O prefix from a Str (returns the same Str if none).
fn _strip_base_prefix(s) {
    if (str_len(s) < 2) { return s; }
    var d = str_data(s);
    if ((load8(d) & 0xFF) != 48) { return s; }
    var c1 = load8(d + 1) & 0xFF;
    if (c1 == 120 || c1 == 88 || c1 == 98 || c1 == 66 || c1 == 111 || c1 == 79) {
        return str_substr(s, 2, str_len(s));
    }
    return s;
}

# szal_base_convert. Mirrors BaseConvert::call (conversion_tools.rs 33-104).
fn _base_convert_handler(args, claims) {
    var o = _conv_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var vv = bayan_json_v_obj_get_by_cstr(o, "value");
    if (bayan_json_v_is_str(vv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: value"));
        return str_data(e);
    }
    var fv = bayan_json_v_obj_get_by_cstr(o, "from_base");
    if (bayan_json_v_is_int(fv) == 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: from_base"));
        return str_data(e2);
    }
    var tv = bayan_json_v_obj_get_by_cstr(o, "to_base");
    if (bayan_json_v_is_int(tv) == 0) {
        var e3 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: to_base"));
        return str_data(e3);
    }
    var from = bayan_json_v_int(fv);
    var to = bayan_json_v_int(tv);
    if (_valid_base(from) == 0 || _valid_base(to) == 0) {
        var eb = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("supported bases: 2, 8, 10, 16"));
        return str_data(eb);
    }

    var value = bayan_json_v_str(vv);
    var clean = _strip_base_prefix(value);
    var n = _parse_radix(str_data(clean), str_len(clean), from);
    if (n < 0) {
        var ib = str_builder_new();
        str_builder_add_cstr(ib, "invalid number '");
        str_builder_add(ib, value);
        str_builder_add_cstr(ib, "' for base ");
        str_builder_add_int(ib, from);
        var ie = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(ib));
        return str_data(ie);
    }

    var result = str_from("");
    if (to == 2) { result = _fmt_radix(n, 2, "0b"); }
    elif (to == 8) { result = _fmt_radix(n, 8, "0o"); }
    elif (to == 16) { result = _fmt_radix(n, 16, "0x"); }
    else { result = _fmt_radix(n, 10, ""); }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("input"), bayan_json_v_str_new(value));
    bayan_json_v_obj_set(out, str_from("from_base"), bayan_json_v_int_new(from));
    bayan_json_v_obj_set(out, str_from("to_base"), bayan_json_v_int_new(to));
    bayan_json_v_obj_set(out, str_from("result"), bayan_json_v_str_new(result));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# --- byte format ---

# bytes / divisor as an f64 json_v value.
fn _ratio_json(bytes, divisor) {
    return bayan_json_v_float_new(f64_div(f64_from(bytes), f64_from(divisor)));
}

# szal_byte_format. Mirrors ByteFormat::call (conversion_tools.rs 120-155).
fn _byte_format_handler(args, claims) {
    var o = _conv_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var bv = bayan_json_v_obj_get_by_cstr(o, "bytes");
    if (bayan_json_v_is_int(bv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: bytes"));
        return str_data(e);
    }
    var bytes = bayan_json_v_int(bv);

    var divisor = 1;
    var unit = "B";
    if (bytes >= SZAL_BYTES_PER_TB) { divisor = SZAL_BYTES_PER_TB; unit = "TB"; }
    elif (bytes >= SZAL_BYTES_PER_GB) { divisor = SZAL_BYTES_PER_GB; unit = "GB"; }
    elif (bytes >= SZAL_BYTES_PER_MB) { divisor = SZAL_BYTES_PER_MB; unit = "MB"; }
    elif (bytes >= SZAL_BYTES_PER_KB) { divisor = SZAL_BYTES_PER_KB; unit = "KB"; }

    var value = f64_div(f64_from(bytes), f64_from(divisor));
    var fbuf = alloc(48);
    var flen = fmt_float_buf(value, fbuf, 2);
    var fb = str_builder_new();
    str_builder_add(fb, str_new(fbuf, flen));
    str_builder_add_byte(fb, 32);
    str_builder_add_cstr(fb, unit);
    var formatted = str_builder_build(fb);

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("bytes"), bayan_json_v_int_new(bytes));
    bayan_json_v_obj_set(out, str_from("formatted"), bayan_json_v_str_new(formatted));
    bayan_json_v_obj_set(out, str_from("kb"), _ratio_json(bytes, SZAL_BYTES_PER_KB));
    bayan_json_v_obj_set(out, str_from("mb"), _ratio_json(bytes, SZAL_BYTES_PER_MB));
    bayan_json_v_obj_set(out, str_from("gb"), _ratio_json(bytes, SZAL_BYTES_PER_GB));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# --- duration format ---

# szal_duration_format. Mirrors DurationFormat::call (conversion_tools.rs 173-216).
fn _duration_format_handler(args, claims) {
    var o = _conv_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var sv = bayan_json_v_obj_get_by_cstr(o, "seconds");
    if (bayan_json_v_is_int(sv) == 0 && bayan_json_v_is_float(sv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: seconds"));
        return str_data(e);
    }
    var total = bayan_json_v_int(sv);
    var secs_f = bayan_json_v_float(sv);

    var days = total / SZAL_SECS_PER_DAY;
    var hours = (total % SZAL_SECS_PER_DAY) / SZAL_SECS_PER_HOUR;
    var minutes = (total % SZAL_SECS_PER_HOUR) / SZAL_SECS_PER_MINUTE;
    var remaining = total % SZAL_SECS_PER_MINUTE;

    var sb = str_builder_new();
    var first = 1;
    if (days > 0) {
        str_builder_add_int(sb, days);
        str_builder_add_cstr(sb, "d");
        first = 0;
    }
    if (hours > 0) {
        if (first == 0) { str_builder_add_byte(sb, 32); }
        str_builder_add_int(sb, hours);
        str_builder_add_cstr(sb, "h");
        first = 0;
    }
    if (minutes > 0) {
        if (first == 0) { str_builder_add_byte(sb, 32); }
        str_builder_add_int(sb, minutes);
        str_builder_add_cstr(sb, "m");
        first = 0;
    }
    if (remaining > 0 || first == 1) {
        if (first == 0) { str_builder_add_byte(sb, 32); }
        str_builder_add_int(sb, remaining);
        str_builder_add_cstr(sb, "s");
        first = 0;
    }
    var formatted = str_builder_build(sb);

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("seconds"), bayan_json_v_float_new(secs_f));
    bayan_json_v_obj_set(out, str_from("formatted"), bayan_json_v_str_new(formatted));
    bayan_json_v_obj_set(out, str_from("days"), bayan_json_v_int_new(days));
    bayan_json_v_obj_set(out, str_from("hours"), bayan_json_v_int_new(total / SZAL_SECS_PER_HOUR));
    bayan_json_v_obj_set(out, str_from("minutes"), bayan_json_v_int_new(total / SZAL_SECS_PER_MINUTE));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# --- schema property builders ---

fn _base_convert_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("value", "{ \"type\": \"string\", \"description\": \"Number to convert\" }"));
    vec_push(v, schema_prop_new("from_base",
        "{ \"type\": \"integer\", \"description\": \"Source base (2, 8, 10, 16)\" }"));
    vec_push(v, schema_prop_new("to_base",
        "{ \"type\": \"integer\", \"description\": \"Target base (2, 8, 10, 16)\" }"));
    return v;
}

fn _byte_format_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("bytes", "{ \"type\": \"integer\", \"description\": \"Number of bytes\" }"));
    return v;
}

fn _duration_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("seconds", "{ \"type\": \"number\", \"description\": \"Duration in seconds\" }"));
    return v;
}

# The conversion tool group: szal_base_convert, szal_byte_format, szal_duration_format.
fn szal_conversion_tools() {
    var tools = vec_new();
    var bc_req = vec_new();
    vec_push(bc_req, "value");
    vec_push(bc_req, "from_base");
    vec_push(bc_req, "to_base");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_base_convert", "Convert a number between bases (binary, octal, decimal, hexadecimal)",
          _base_convert_props(), bc_req), &_base_convert_handler));

    var bf_req = vec_new();
    vec_push(bf_req, "bytes");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_byte_format", "Convert bytes to human-readable format (KB, MB, GB, TB)",
          _byte_format_props(), bf_req), &_byte_format_handler));

    var d_req = vec_new();
    vec_push(d_req, "seconds");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_duration_format", "Convert seconds to human-readable duration (Xd Xh Xm Xs) and reverse",
          _duration_props(), d_req), &_duration_format_handler));
    return tools;
}

# --- mcp_tools_math.cyr ---

# mcp_tools_math.cyr — MCP math tool (ports mcp/tools/math_tools.rs): szal_math_eval.
#
# A recursive-descent f64 expression evaluator: tokenize -> add/sub -> mul/div/mod -> atom, with
# unary minus and parentheses. Operators: + - * / % (the tool description mentions ^, but Rust never
# implemented it — ^ is not in the valid-char set nor the tokenizer, so the port omits it too).
#
# Handler follows the bote ABI + the porting pattern in docs/development/state.md.
#
# PARITY NOTE (float formatting): integer results format as i64 (exact, matching Rust). Non-integer
# results use fmt_float_buf + trailing-zero strip rather than Rust's shortest-round-trip Display, so
# some fractional results may render with slightly different precision. The math_tools.rs tests use
# integer results. Recorded §18.
#
# Usage: include AFTER lib/math.cyr (f64_parse_ok/trunc/fract) + src/mcp.cyr (+ lib/bayan, lib/str).
#
# Token kinds are MEV_TOK_*, never bare TOK_*: src/condition.cyr owns TOK_LPAREN/TOK_RPAREN (13/14)
# and this enum used to redeclare them as 6/7. Cyrius resolves enum constants in one flat namespace
# and does not fold ones registered past var index 1024, so the later value won for EVERY read —
# the condition parser then tokenized `(` as its own TOK_GT and `)` as TOK_GTE, and `(x)`, `!(x)`,
# `x == (1)` stopped parsing in any build that included this file (szal <= 2.1.2).
enum MathTokens {
    MEV_TOK_NUM = 0;
    MEV_TOK_PLUS = 1;
    MEV_TOK_MINUS = 2;
    MEV_TOK_MUL = 3;
    MEV_TOK_DIV = 4;
    MEV_TOK_MOD = 5;
    MEV_TOK_LPAREN = 6;
    MEV_TOK_RPAREN = 7;
}

fn _math_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# Token = { type@0, fval@8 } (fval is the f64 bit pattern for MEV_TOK_NUM).
fn _mev_tok_new(ty, fval) {
    var t = alloc(16);
    store64(t, ty);
    store64(t + 8, fval);
    return t;
}
fn _mev_tok_type(t) { return load64(t); }
fn _mev_tok_fval(t) { return load64(t + 8); }

# Eval context = { tokens@0, pos@8, err@16 (Str|0), result@24 (f64) }.
fn _ec_err(ec) { return load64(ec + 16); }
fn _ec_seterr(ec, s) { store64(ec + 16, s); return 0; }

# 1 if `c` is one of the characters szal_math_eval permits (digits + " +-*/.%()").
fn _mev_valid_chars(s) {
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c == 32 || c == 43 || c == 45 || c == 42 || c == 47 || c == 46 || c == 37
          || c == 40 || c == 41) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Index after the run of digit/'.' chars starting at `start`.
fn _scan_number_end(d, n, start) {
    var i = start;
    var go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; } else {
            var c = load8(d + i) & 0xFF;
            if ((c >= 48 && c <= 57) || c == 46) { i = i + 1; } else { go = 0; }
        }
    }
    return i;
}

# Parse d[start..end] (optionally negated) as f64; on failure sets ec.err and returns 0.0.
fn _mev_num(d, start, end, neg, ec) {
    var len = end - start;
    var buf = alloc(len + 2);
    var off = 0;
    if (neg == 1) { store8(buf, 45); off = 1; }
    var k = 0;
    while (k < len) {
        store8(buf + off + k, load8(d + start + k));
        k = k + 1;
    }
    store8(buf + off + len, 0);
    var out = alloc(8);
    if (f64_parse_ok(buf, out) == 0) {
        _ec_seterr(ec, str_from("invalid number"));
        return f64_from(0);
    }
    return load64(out);
}

# Tokenize `expr` into ec.tokens; sets ec.err on an unexpected character / bad number.
fn _mev_tokenize(ec, expr) {
    var d = str_data(expr);
    var n = str_len(expr);
    var tokens = vec_new();
    store64(ec, tokens);
    var i = 0;
    while (i < n) {
        if (_ec_err(ec) != 0) { return 0; }
        var c = load8(d + i) & 0xFF;
        if (c == 32) {
            i = i + 1;
        } elif (c == 43) {
            vec_push(tokens, _mev_tok_new(MEV_TOK_PLUS, 0)); i = i + 1;
        } elif (c == 45) {
            var is_unary = 0;
            if (vec_len(tokens) == 0) { is_unary = 1; } else {
                var lt = _mev_tok_type(vec_get(tokens, vec_len(tokens) - 1));
                if (lt == MEV_TOK_PLUS || lt == MEV_TOK_MINUS || lt == MEV_TOK_MUL || lt == MEV_TOK_DIV
                  || lt == MEV_TOK_MOD || lt == MEV_TOK_LPAREN) { is_unary = 1; }
            }
            i = i + 1;
            if (is_unary == 1) {
                var end = _scan_number_end(d, n, i);
                var val = _mev_num(d, i, end, 1, ec);
                vec_push(tokens, _mev_tok_new(MEV_TOK_NUM, val));
                i = end;
            } else {
                vec_push(tokens, _mev_tok_new(MEV_TOK_MINUS, 0));
            }
        } elif (c == 42) {
            vec_push(tokens, _mev_tok_new(MEV_TOK_MUL, 0)); i = i + 1;
        } elif (c == 47) {
            vec_push(tokens, _mev_tok_new(MEV_TOK_DIV, 0)); i = i + 1;
        } elif (c == 37) {
            vec_push(tokens, _mev_tok_new(MEV_TOK_MOD, 0)); i = i + 1;
        } elif (c == 40) {
            vec_push(tokens, _mev_tok_new(MEV_TOK_LPAREN, 0)); i = i + 1;
        } elif (c == 41) {
            vec_push(tokens, _mev_tok_new(MEV_TOK_RPAREN, 0)); i = i + 1;
        } elif ((c >= 48 && c <= 57) || c == 46) {
            var nend = _scan_number_end(d, n, i);
            var nval = _mev_num(d, i, nend, 0, ec);
            vec_push(tokens, _mev_tok_new(MEV_TOK_NUM, nval));
            i = nend;
        } else {
            var eb = str_builder_new();
            str_builder_add_cstr(eb, "unexpected character");
            _ec_seterr(ec, str_builder_build(eb));
            return 0;
        }
    }
    return 0;
}

# atom := NUM | '(' add_sub ')'
fn _mev_atom(ec) {
    var tokens = load64(ec);
    var pos = load64(ec + 8);
    if (pos >= vec_len(tokens)) {
        _ec_seterr(ec, str_from("unexpected end of expression"));
        return f64_from(0);
    }
    var t = vec_get(tokens, pos);
    var ty = _mev_tok_type(t);
    if (ty == MEV_TOK_NUM) {
        store64(ec + 8, pos + 1);
        return _mev_tok_fval(t);
    }
    if (ty == MEV_TOK_LPAREN) {
        store64(ec + 8, pos + 1);
        var val = _mev_add_sub(ec);
        if (_ec_err(ec) != 0) { return val; }
        var p2 = load64(ec + 8);
        if (p2 >= vec_len(tokens) || _mev_tok_type(vec_get(tokens, p2)) != MEV_TOK_RPAREN) {
            _ec_seterr(ec, str_from("missing closing parenthesis"));
            return f64_from(0);
        }
        store64(ec + 8, p2 + 1);
        return val;
    }
    _ec_seterr(ec, str_from("unexpected token"));
    return f64_from(0);
}

# mul_div := atom (('*'|'/'|'%') atom)*
fn _mev_mul_div(ec) {
    var left = _mev_atom(ec);
    if (_ec_err(ec) != 0) { return left; }
    var go = 1;
    while (go == 1) {
        var pos = load64(ec + 8);
        var tokens = load64(ec);
        if (pos >= vec_len(tokens)) { go = 0; } else {
            var ty = _mev_tok_type(vec_get(tokens, pos));
            if (ty == MEV_TOK_MUL) {
                store64(ec + 8, pos + 1);
                var r = _mev_atom(ec);
                if (_ec_err(ec) != 0) { return left; }
                left = f64_mul(left, r);
            } elif (ty == MEV_TOK_DIV) {
                store64(ec + 8, pos + 1);
                var r2 = _mev_atom(ec);
                if (_ec_err(ec) != 0) { return left; }
                if (f64_eq(r2, f64_from(0)) == 1) {
                    _ec_seterr(ec, str_from("division by zero"));
                    return f64_from(0);
                }
                left = f64_div(left, r2);
            } elif (ty == MEV_TOK_MOD) {
                store64(ec + 8, pos + 1);
                var r3 = _mev_atom(ec);
                if (_ec_err(ec) != 0) { return left; }
                if (f64_eq(r3, f64_from(0)) == 1) {
                    _ec_seterr(ec, str_from("modulo by zero"));
                    return f64_from(0);
                }
                left = f64_sub(left, f64_mul(f64_trunc(f64_div(left, r3)), r3));
            } else { go = 0; }
        }
    }
    return left;
}

# add_sub := mul_div (('+'|'-') mul_div)*
fn _mev_add_sub(ec) {
    var left = _mev_mul_div(ec);
    if (_ec_err(ec) != 0) { return left; }
    var go = 1;
    while (go == 1) {
        var pos = load64(ec + 8);
        var tokens = load64(ec);
        if (pos >= vec_len(tokens)) { go = 0; } else {
            var ty = _mev_tok_type(vec_get(tokens, pos));
            if (ty == MEV_TOK_PLUS) {
                store64(ec + 8, pos + 1);
                var r = _mev_mul_div(ec);
                if (_ec_err(ec) != 0) { return left; }
                left = f64_add(left, r);
            } elif (ty == MEV_TOK_MINUS) {
                store64(ec + 8, pos + 1);
                var r2 = _mev_mul_div(ec);
                if (_ec_err(ec) != 0) { return left; }
                left = f64_sub(left, r2);
            } else { go = 0; }
        }
    }
    return left;
}

# Evaluate `expr`, returning the eval context (check ec.err; ec.result holds the f64 on success).
fn _mev_eval(expr) {
    var ec = alloc(32);
    store64(ec, 0);
    store64(ec + 8, 0);
    store64(ec + 16, 0);
    store64(ec + 24, f64_from(0));
    _mev_tokenize(ec, expr);
    if (_ec_err(ec) != 0) { return ec; }
    var result = _mev_add_sub(ec);
    if (_ec_err(ec) != 0) { return ec; }
    var pos = load64(ec + 8);
    var tokens = load64(ec);
    if (pos < vec_len(tokens)) {
        var pb = str_builder_new();
        str_builder_add_cstr(pb, "unexpected token at position ");
        str_builder_add_int(pb, pos);
        _ec_seterr(ec, str_builder_build(pb));
        return ec;
    }
    store64(ec + 24, result);
    return ec;
}

# Format an f64 with up to 10 decimals, stripping trailing zeros and any trailing '.'.
fn _fmt_f64_clean(val) {
    var buf = alloc(64);
    var len = fmt_float_buf(val, buf, 10);
    while (len > 0 && (load8(buf + len - 1) & 0xFF) == 48) { len = len - 1; }
    if (len > 0 && (load8(buf + len - 1) & 0xFF) == 46) { len = len - 1; }
    return str_new(buf, len);
}

# szal_math_eval handler. Mirrors MathEval::call (math_tools.rs 21-58).
fn _math_eval_handler(args, claims) {
    var o = _math_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var ev = bayan_json_v_obj_get_by_cstr(o, "expression");
    if (bayan_json_v_is_str(ev) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: expression"));
        return str_data(e);
    }
    var expr = bayan_json_v_str(ev);

    if (_mev_valid_chars(expr) == 0) {
        var ic = szal_result_error_typed(SZAL_MCP_VALIDATION,
          str_from("expression contains invalid characters — only digits, +, -, *, /, %, (, ), . allowed"));
        return str_data(ic);
    }

    var ec = _mev_eval(expr);
    if (_ec_err(ec) != 0) {
        var er = szal_result_error_typed(SZAL_MCP_INTERNAL, _ec_err(ec));
        return str_data(er);
    }

    var val = load64(ec + 24);
    var out = str_from("");
    if (f64_eq(f64_fract(val), f64_from(0)) == 1
      && f64_lt(f64_abs(val), f64_from(9223372036854775807)) == 1) {
        var iv = f64_to(val);
        out = str_from_int(iv);
    } else {
        out = _fmt_f64_clean(val);
    }
    var r = szal_result_ok(out);
    return str_data(r);
}

fn _math_eval_props() {
    var v = vec_new();
    var eb = str_builder_new();
    str_builder_add_cstr(eb, "{ \"type\": \"string\", \"description\": ");
    str_builder_add_cstr(eb, "\"Math expression to evaluate (e.g. '2 + 3 * 4')\" }");
    var expr_c = str_cstr(str_builder_build(eb));
    vec_push(v, schema_prop_new("expression", expr_c));
    return v;
}

# The math tool group: szal_math_eval.
fn szal_math_tools() {
    var tools = vec_new();
    var req = vec_new();
    vec_push(req, "expression");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_math_eval", "Evaluate a basic math expression (+, -, *, /, %, ^)",
          _math_eval_props(), req), &_math_eval_handler));
    return tools;
}

# --- mcp_tools_state.cyr ---

# mcp_tools_state.cyr — MCP state tools (ports mcp/tools/state_tools.rs): szal_state_check,
# szal_state_transition, szal_state_lifecycle.
#
# All three reuse szal's own state.cyr FSM (state_name / state_from_name / state_is_terminal /
# state_valid_transition), so the state semantics are inherited exactly. Handlers follow the bote ABI
# + the porting pattern in docs/development/state.md.
#
# Usage: include AFTER src/state.cyr + src/mcp.cyr (+ lib/bayan, lib/str).

enum StateTools {
    STATE_COUNT = 8;
}

fn _state_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# JSON array of the snake_case names of every state `st` may transition to.
fn _state_transitions_arr(st) {
    var arr = bayan_json_v_arr_new();
    var t = 0;
    while (t < STATE_COUNT) {
        if (state_valid_transition(st, t) == 1) {
            var nm = state_name(t);
            bayan_json_v_arr_push(arr, bayan_json_v_str_new(str_from(nm)));
        }
        t = t + 1;
    }
    return arr;
}

# szal_state_check: terminal-ness + valid transitions of a state. Mirrors StateCheck::call (state_tools.rs 41-76).
fn _state_check_handler(args, claims) {
    var o = _state_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var sv = bayan_json_v_obj_get_by_cstr(o, "state");
    if (bayan_json_v_is_str(sv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: state"));
        return str_data(e);
    }
    var ss = bayan_json_v_str(sv);
    var st = state_from_name(str_cstr(ss));
    if (st < 0) {
        var ib = str_builder_new();
        str_builder_add_cstr(ib, "invalid state: ");
        str_builder_add(ib, ss);
        var ie = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(ib));
        return str_data(ie);
    }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("state"), bayan_json_v_str_new(ss));
    bayan_json_v_obj_set(out, str_from("is_terminal"), bayan_json_v_bool_new(state_is_terminal(st)));
    bayan_json_v_obj_set(out, str_from("valid_transitions"), _state_transitions_arr(st));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# Read a state field as a parsed WorkflowState, or -1 if missing/invalid.
fn _state_field(o, field) {
    var fv = bayan_json_v_obj_get_by_cstr(o, field);
    if (bayan_json_v_is_str(fv) == 0) { return (0 - 1); }
    return state_from_name(str_cstr(bayan_json_v_str(fv)));
}

# szal_state_transition: is from->to a valid transition? Mirrors StateTransition::call (state_tools.rs 94-131).
fn _state_transition_handler(args, claims) {
    var o = _state_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var from = _state_field(o, "from");
    if (from < 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing or invalid 'from' state"));
        return str_data(e);
    }
    var to = _state_field(o, "to");
    if (to < 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing or invalid 'to' state"));
        return str_data(e2);
    }

    var from_s = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(o, "from"));
    var to_s = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(o, "to"));
    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("from"), bayan_json_v_str_new(from_s));
    bayan_json_v_obj_set(out, str_from("to"), bayan_json_v_str_new(to_s));
    bayan_json_v_obj_set(out, str_from("valid"), bayan_json_v_bool_new(state_valid_transition(from, to)));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# szal_state_lifecycle: the full FSM as an array of {state, is_terminal, transitions_to}. Mirrors
# StateLifecycle::call (state_tools.rs 146-158).
fn _state_lifecycle_handler(args, claims) {
    var arr = bayan_json_v_arr_new();
    var s = 0;
    while (s < STATE_COUNT) {
        var obj = bayan_json_v_obj_new();
        var nm = state_name(s);
        bayan_json_v_obj_set(obj, str_from("state"), bayan_json_v_str_new(str_from(nm)));
        bayan_json_v_obj_set(obj, str_from("is_terminal"), bayan_json_v_bool_new(state_is_terminal(s)));
        bayan_json_v_obj_set(obj, str_from("transitions_to"), _state_transitions_arr(s));
        bayan_json_v_arr_push(arr, obj);
        s = s + 1;
    }
    var r = szal_result_ok_json(arr);
    return str_data(r);
}

# --- schema property builders ---

fn _state_check_props() {
    var v = vec_new();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{ \"type\": \"string\", \"enum\": [\"created\",\"running\",\"paused\",");
    str_builder_add_cstr(sb, "\"completed\",\"failed\",\"rolling_back\",\"rolled_back\",\"cancelled\"] }");
    var state_c = str_cstr(str_builder_build(sb));
    vec_push(v, schema_prop_new("state", state_c));
    return v;
}

fn _state_transition_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("from", "{ \"type\": \"string\" }"));
    vec_push(v, schema_prop_new("to", "{ \"type\": \"string\" }"));
    return v;
}

# The state tool group: szal_state_check, szal_state_transition, szal_state_lifecycle.
fn szal_state_tools() {
    var tools = vec_new();
    var c_req = vec_new();
    vec_push(c_req, "state");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_state_check", "Check if a workflow state is terminal and list its valid transitions",
          _state_check_props(), c_req), &_state_check_handler));

    var t_req = vec_new();
    vec_push(t_req, "from");
    vec_push(t_req, "to");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_state_transition", "Check if a state transition from one state to another is valid",
          _state_transition_props(), t_req), &_state_transition_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_state_lifecycle",
          "Show the complete workflow state machine — all states, transitions, and terminal states",
          vec_new(), vec_new()), &_state_lifecycle_handler));
    return tools;
}

# --- mcp_tools_step.cyr ---

# mcp_tools_step.cyr — MCP step tools (ports mcp/tools/step_tools.rs): szal_step_create,
# szal_step_validate, szal_step_inspect.
#
# All three reuse szal's own step.cyr (StepDef builders + step_to_json/step_from_json), so the step
# shape/serde is inherited exactly. Handlers follow the bote ABI + the porting pattern in
# docs/development/state.md.
#
# Usage: include AFTER src/uuid.cyr + src/step.cyr + src/mcp.cyr (+ lib/bayan, lib/str, lib/vec).

fn _stp_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# szal_step_create: build a StepDef from optional fields. Mirrors StepCreate::call (step_tools.rs 34-89).
fn _step_create_handler(args, claims) {
    var o = _stp_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var nv = bayan_json_v_obj_get_by_cstr(o, "name");
    if (bayan_json_v_is_str(nv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: name"));
        return str_data(e);
    }
    var step = step_new(bayan_json_v_str(nv));

    var dv = bayan_json_v_obj_get_by_cstr(o, "description");
    if (bayan_json_v_is_str(dv) == 1) { store64(step + SD_DESCRIPTION, bayan_json_v_str(dv)); }

    var tv = bayan_json_v_obj_get_by_cstr(o, "timeout_ms");
    if (bayan_json_v_is_int(tv) == 1) { step = step_with_timeout(step, bayan_json_v_int(tv)); }

    var rv = bayan_json_v_obj_get_by_cstr(o, "max_retries");
    if (bayan_json_v_is_int(rv) == 1) {
        var delay = 1000;
        var ddv = bayan_json_v_obj_get_by_cstr(o, "retry_delay_ms");
        if (bayan_json_v_is_int(ddv) == 1) { delay = bayan_json_v_int(ddv); }
        step = step_with_retries(step, bayan_json_v_int(rv), delay);
    }

    var bv = bayan_json_v_obj_get_by_cstr(o, "rollbackable");
    if (bayan_json_v_is_bool(bv) == 1) {
        if (bayan_json_v_bool(bv) == 1) { step = step_with_rollback(step); }
    }

    var deps = bayan_json_v_obj_get_by_cstr(o, "depends_on");
    if (bayan_json_v_is_arr(deps) == 1) {
        var n = bayan_json_v_arr_len(deps);
        var i = 0;
        while (i < n) {
            var dep = bayan_json_v_arr_get(deps, i);
            if (bayan_json_v_is_str(dep) == 1) {
                var idc = str_cstr(bayan_json_v_str(dep));
                var hi, lo = uuid_parse(idc);
                if (hi == (0 - 1)) {
                    var ib = str_builder_new();
                    str_builder_add_cstr(ib, "invalid UUID: ");
                    str_builder_add(ib, bayan_json_v_str(dep));
                    var ie = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(ib));
                    return str_data(ie);
                }
                step = step_depends_on_add(step, hi, lo);
            }
            i = i + 1;
        }
    }

    var sj = step_to_json(step);
    var jv = bayan_json_v_parse(sj);
    var r = szal_result_ok_json(jv);
    return str_data(r);
}

# szal_step_validate: parse a StepDef JSON and flag empty name / zero timeout. Mirrors StepValidate::call
# (step_tools.rs 107-145).
fn _step_validate_handler(args, claims) {
    var o = _stp_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "step_json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: step_json"));
        return str_data(e);
    }
    var step = step_from_json(bayan_json_v_str(jv));
    if (step == 0) {
        var ej = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid JSON"));
        return str_data(ej);
    }

    var name_empty = 0;
    if (str_len(step_name(step)) == 0) { name_empty = 1; }
    var timeout_zero = 0;
    if (step_timeout_ms(step) == 0) { timeout_zero = 1; }

    if (name_empty == 0 && timeout_zero == 0) {
        var vb = str_builder_new();
        str_builder_add_cstr(vb, "valid: step '");
        str_builder_add(vb, step_name(step));
        str_builder_add_cstr(vb, "' (id=");
        var idc = uuid_to_cstr(step_id_hi(step), step_id_lo(step));
        var ids = str_from(idc);
        str_builder_add(vb, ids);
        str_builder_add_cstr(vb, ")");
        var rok = szal_result_ok(str_builder_build(vb));
        return str_data(rok);
    }

    var ib = str_builder_new();
    str_builder_add_cstr(ib, "issues: ");
    var first = 1;
    if (name_empty == 1) { str_builder_add_cstr(ib, "name is empty"); first = 0; }
    if (timeout_zero == 1) {
        if (first == 0) { str_builder_add_cstr(ib, ", "); }
        str_builder_add_cstr(ib, "timeout_ms is zero");
    }
    var er = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(ib));
    return str_data(er);
}

# szal_step_inspect: structured config of a StepDef. Mirrors StepInspect::call (step_tools.rs 163-198).
fn _step_inspect_handler(args, claims) {
    var o = _stp_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "step_json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: step_json"));
        return str_data(e);
    }
    var step = step_from_json(bayan_json_v_str(jv));
    if (step == 0) {
        var ej = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid JSON"));
        return str_data(ej);
    }

    var info = bayan_json_v_obj_new();
    var idc = uuid_to_cstr(step_id_hi(step), step_id_lo(step));
    var ids = str_from(idc);
    bayan_json_v_obj_set(info, str_from("id"), bayan_json_v_str_new(ids));
    bayan_json_v_obj_set(info, str_from("name"), bayan_json_v_str_new(step_name(step)));
    bayan_json_v_obj_set(info, str_from("description"), bayan_json_v_str_new(step_description(step)));
    bayan_json_v_obj_set(info, str_from("timeout_ms"), bayan_json_v_int_new(step_timeout_ms(step)));
    bayan_json_v_obj_set(info, str_from("max_retries"), bayan_json_v_int_new(step_max_retries(step)));
    bayan_json_v_obj_set(info, str_from("retry_delay_ms"), bayan_json_v_int_new(step_retry_delay_ms(step)));
    bayan_json_v_obj_set(info, str_from("rollbackable"), bayan_json_v_bool_new(step_rollbackable(step)));
    bayan_json_v_obj_set(info, str_from("dependency_count"), bayan_json_v_int_new(step_depends_on_len(step)));

    var arr = bayan_json_v_arr_new();
    var n = step_depends_on_len(step);
    var i = 0;
    while (i < n) {
        var dc = uuid_to_cstr(step_depends_on_hi(step, i), step_depends_on_lo(step, i));
        var ds = str_from(dc);
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(ds));
        i = i + 1;
    }
    bayan_json_v_obj_set(info, str_from("depends_on"), arr);

    var r = szal_result_ok_json(info);
    return str_data(r);
}

# --- schema property builders ---

fn _step_create_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("name", "{ \"type\": \"string\", \"description\": \"Step name\" }"));
    vec_push(v, schema_prop_new("description",
        "{ \"type\": \"string\", \"description\": \"Step description\" }"));
    vec_push(v, schema_prop_new("timeout_ms",
        "{ \"type\": \"integer\", \"description\": \"Timeout in milliseconds (default: 30000)\" }"));
    vec_push(v, schema_prop_new("max_retries",
        "{ \"type\": \"integer\", \"description\": \"Max retry attempts (default: 0)\" }"));
    vec_push(v, schema_prop_new("retry_delay_ms",
        "{ \"type\": \"integer\", \"description\": \"Delay between retries in ms (default: 1000)\" }"));
    vec_push(v, schema_prop_new("rollbackable",
        "{ \"type\": \"boolean\", \"description\": \"Whether step supports rollback (default: false)\" }"));
    var db = str_builder_new();
    str_builder_add_cstr(db, "{ \"type\": \"array\", \"items\": { \"type\": \"string\" }, ");
    str_builder_add_cstr(db, "\"description\": \"UUIDs of steps this depends on\" }");
    var deps_c = str_cstr(str_builder_build(db));
    vec_push(v, schema_prop_new("depends_on", deps_c));
    return v;
}

fn _step_json_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("step_json",
        "{ \"type\": \"string\", \"description\": \"Step definition as JSON string\" }"));
    return v;
}

# The step tool group: szal_step_create, szal_step_validate, szal_step_inspect.
fn szal_step_tools() {
    var tools = vec_new();
    var c_req = vec_new();
    vec_push(c_req, "name");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_step_create", "Create a workflow step definition with timeout, retry, and rollback config",
          _step_create_props(), c_req), &_step_create_handler));

    var v_req = vec_new();
    vec_push(v_req, "step_json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_step_validate", "Validate a step definition JSON, checking all fields are well-formed",
          _step_json_props(), v_req), &_step_validate_handler));

    var i_req = vec_new();
    vec_push(i_req, "step_json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_step_inspect", "Inspect a step definition, returning its configuration details",
          _step_json_props(), i_req), &_step_inspect_handler));
    return tools;
}

# --- mcp_tools_flow.cyr ---

# mcp_tools_flow.cyr — MCP flow tools (ports mcp/tools/flow_tools.rs): szal_flow_create,
# szal_flow_validate, szal_flow_from_json, szal_flow_list_modes, szal_flow_add_step.
#
# All reuse szal's own flow.cyr (FlowDef builders + flow_validate + flow_to_json/flow_from_json) and
# step.cyr, so flow/step shape, serde, and DAG-cycle validation are inherited exactly. Handlers
# follow the bote ABI + the porting pattern in docs/development/state.md.
#
# PARITY NOTE: FlowCreate's `steps` array elements are deserialized via step.cyr's lenient
# _step_from_v (serde-default, parity-notes §3), so the Rust "invalid step: <e>" branch is effectively
# unreachable (missing fields default rather than erroring) — same lenient-serde family as §3.
#
# Usage: include AFTER src/uuid.cyr + src/step.cyr + src/flow.cyr + src/mcp.cyr (+ lib/bayan, lib/str).

fn _flow_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# Parse a lowercase mode name (cstr) to a FlowMode, or -1 if unrecognized.
fn _flow_mode_parse(s) {
    if (streq(s, "sequential") == 1) { return FLOW_SEQUENTIAL; }
    if (streq(s, "parallel") == 1) { return FLOW_PARALLEL; }
    if (streq(s, "dag") == 1) { return FLOW_DAG; }
    if (streq(s, "hierarchical") == 1) { return FLOW_HIERARCHICAL; }
    return (0 - 1);
}

# szal_flow_create: build a FlowDef from name/mode + options + inline steps. Mirrors FlowCreate::call
# (flow_tools.rs 38-89).
fn _flow_create_handler(args, claims) {
    var o = _flow_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var nv = bayan_json_v_obj_get_by_cstr(o, "name");
    if (bayan_json_v_is_str(nv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: name"));
        return str_data(e);
    }
    var mode = (0 - 1);
    var mv = bayan_json_v_obj_get_by_cstr(o, "mode");
    if (bayan_json_v_is_str(mv) == 1) { mode = _flow_mode_parse(str_cstr(bayan_json_v_str(mv))); }
    if (mode < 0) {
        var em = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing or invalid mode"));
        return str_data(em);
    }

    var flow = flow_new(bayan_json_v_str(nv), mode);

    var rv = bayan_json_v_obj_get_by_cstr(o, "rollback_on_failure");
    if (bayan_json_v_is_bool(rv) == 1) {
        if (bayan_json_v_bool(rv) == 1) { flow = flow_with_rollback(flow); }
    }
    var tv = bayan_json_v_obj_get_by_cstr(o, "timeout_ms");
    if (bayan_json_v_is_int(tv) == 1) { flow = flow_with_timeout(flow, bayan_json_v_int(tv)); }

    var steps = bayan_json_v_obj_get_by_cstr(o, "steps");
    if (bayan_json_v_is_arr(steps) == 1) {
        var n = bayan_json_v_arr_len(steps);
        var i = 0;
        while (i < n) {
            var sv = bayan_json_v_arr_get(steps, i);
            if (bayan_json_v_is_obj(sv) == 1) {
                flow_add_step(flow, _step_from_v(sv));
            }
            i = i + 1;
        }
    }

    var fj = flow_to_json(flow);
    var jv = bayan_json_v_parse(fj);
    var r = szal_result_ok_json(jv);
    return str_data(r);
}

# szal_flow_validate: parse + flow_validate (DAG cycles / missing deps). Mirrors FlowValidate::call
# (flow_tools.rs 104-139).
fn _flow_validate_handler(args, claims) {
    var o = _flow_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "flow_json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: flow_json"));
        return str_data(e);
    }
    var flow = flow_from_json(bayan_json_v_str(jv));
    if (flow == 0) {
        var ej = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid JSON"));
        return str_data(ej);
    }

    var vr_t, vr_v = flow_validate(flow);
    if (is_ok(vr_t) == 1) {
        var vb = str_builder_new();
        str_builder_add_cstr(vb, "valid: flow '");
        str_builder_add(vb, flow_name(flow));
        str_builder_add_cstr(vb, "' (");
        str_builder_add_int(vb, flow_steps_len(flow));
        str_builder_add_cstr(vb, " steps, mode=");
        str_builder_add_cstr(vb, flow_mode_display(flow_mode(flow)));
        str_builder_add_cstr(vb, ")");
        var rok = szal_result_ok(str_builder_build(vb));
        return str_data(rok);
    }
    var eb = str_builder_new();
    str_builder_add_cstr(eb, "validation failed: ");
    str_builder_add(eb, szal_get_err_msg());
    var er = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(eb));
    return str_data(er);
}

# JSON array of a step's depends_on UUID strings.
fn _flow_step_deps_arr(step) {
    var arr = bayan_json_v_arr_new();
    var n = step_depends_on_len(step);
    var i = 0;
    while (i < n) {
        var dc = uuid_to_cstr(step_depends_on_hi(step, i), step_depends_on_lo(step, i));
        var ds = str_from(dc);
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(ds));
        i = i + 1;
    }
    return arr;
}

# szal_flow_from_json: parse + structured summary. Mirrors FlowFromJson::call (flow_tools.rs 154-192).
fn _flow_from_json_handler(args, claims) {
    var o = _flow_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "flow_json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: flow_json"));
        return str_data(e);
    }
    var flow = flow_from_json(bayan_json_v_str(jv));
    if (flow == 0) {
        var ej = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid JSON"));
        return str_data(ej);
    }

    var info = bayan_json_v_obj_new();
    var idc = uuid_to_cstr(flow_id_hi(flow), flow_id_lo(flow));
    var ids = str_from(idc);
    bayan_json_v_obj_set(info, str_from("id"), bayan_json_v_str_new(ids));
    bayan_json_v_obj_set(info, str_from("name"), bayan_json_v_str_new(flow_name(flow)));
    bayan_json_v_obj_set(info, str_from("mode"), bayan_json_v_str_new(str_from(flow_mode_display(flow_mode(flow)))));
    bayan_json_v_obj_set(info, str_from("step_count"), bayan_json_v_int_new(flow_steps_len(flow)));
    bayan_json_v_obj_set(info, str_from("rollback_on_failure"), bayan_json_v_bool_new(flow_rollback_on_failure(flow)));
    if (flow_timeout_present(flow) == 1) {
        bayan_json_v_obj_set(info, str_from("timeout_ms"), bayan_json_v_int_new(flow_timeout_ms(flow)));
    } else {
        bayan_json_v_obj_set(info, str_from("timeout_ms"), bayan_json_v_null());
    }

    var sarr = bayan_json_v_arr_new();
    var n = flow_steps_len(flow);
    var i = 0;
    while (i < n) {
        var step = flow_step_at(flow, i);
        var sobj = bayan_json_v_obj_new();
        var sidc = uuid_to_cstr(step_id_hi(step), step_id_lo(step));
        var sids = str_from(sidc);
        bayan_json_v_obj_set(sobj, str_from("id"), bayan_json_v_str_new(sids));
        bayan_json_v_obj_set(sobj, str_from("name"), bayan_json_v_str_new(step_name(step)));
        bayan_json_v_obj_set(sobj, str_from("depends_on"), _flow_step_deps_arr(step));
        bayan_json_v_arr_push(sarr, sobj);
        i = i + 1;
    }
    bayan_json_v_obj_set(info, str_from("steps"), sarr);

    var r = szal_result_ok_json(info);
    return str_data(r);
}

# One {mode, description} entry for the modes list.
fn _flow_mode_entry(name_c, desc_c) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("mode"), bayan_json_v_str_new(str_from(name_c)));
    bayan_json_v_obj_set(o, str_from("description"), bayan_json_v_str_new(str_from(desc_c)));
    return o;
}

# szal_flow_list_modes: the four execution modes + descriptions. Mirrors FlowListModes::call
# (flow_tools.rs 207-220).
fn _flow_list_modes_handler(args, claims) {
    var arr = bayan_json_v_arr_new();
    bayan_json_v_arr_push(arr, _flow_mode_entry("sequential", "Steps run one after another"));
    bayan_json_v_arr_push(arr, _flow_mode_entry("parallel",
        "Steps run concurrently with no dependencies"));
    bayan_json_v_arr_push(arr, _flow_mode_entry("dag",
        "Steps run based on dependency graph (Kahn's algorithm), with cycle detection"));
    bayan_json_v_arr_push(arr, _flow_mode_entry("hierarchical",
        "Manager step delegates to sub-steps dynamically"));
    var r = szal_result_ok_json(arr);
    return str_data(r);
}

# szal_flow_add_step: append a step to a flow. Mirrors FlowAddStep::call (flow_tools.rs 238-282).
fn _flow_add_step_handler(args, claims) {
    var o = _flow_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var fv = bayan_json_v_obj_get_by_cstr(o, "flow_json");
    if (bayan_json_v_is_str(fv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: flow_json"));
        return str_data(e);
    }
    var sv = bayan_json_v_obj_get_by_cstr(o, "step_json");
    if (bayan_json_v_is_str(sv) == 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: step_json"));
        return str_data(e2);
    }
    var flow = flow_from_json(bayan_json_v_str(fv));
    if (flow == 0) {
        var ef = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid flow JSON"));
        return str_data(ef);
    }
    var step = step_from_json(bayan_json_v_str(sv));
    if (step == 0) {
        var es = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid step JSON"));
        return str_data(es);
    }
    flow_add_step(flow, step);

    var fj = flow_to_json(flow);
    var jv = bayan_json_v_parse(fj);
    var r = szal_result_ok_json(jv);
    return str_data(r);
}

# --- schema property builders ---

fn _flow_create_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("name", "{ \"type\": \"string\" }"));
    var mb = str_builder_new();
    str_builder_add_cstr(mb, "{ \"type\": \"string\", \"enum\": ");
    str_builder_add_cstr(mb, "[\"sequential\", \"parallel\", \"dag\", \"hierarchical\"] }");
    var mode_c = str_cstr(str_builder_build(mb));
    vec_push(v, schema_prop_new("mode", mode_c));
    vec_push(v, schema_prop_new("rollback_on_failure", "{ \"type\": \"boolean\" }"));
    vec_push(v, schema_prop_new("timeout_ms", "{ \"type\": \"integer\" }"));
    vec_push(v, schema_prop_new("steps",
        "{ \"type\": \"array\", \"items\": { \"type\": \"object\" } }"));
    return v;
}

fn _flow_json_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("flow_json", "{ \"type\": \"string\" }"));
    return v;
}

fn _flow_add_step_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("flow_json", "{ \"type\": \"string\" }"));
    vec_push(v, schema_prop_new("step_json", "{ \"type\": \"string\" }"));
    return v;
}

# The flow tool group: create, validate, from_json, list_modes, add_step.
fn szal_flow_tools() {
    var tools = vec_new();
    var c_req = vec_new();
    vec_push(c_req, "name");
    vec_push(c_req, "mode");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_flow_create", "Create a workflow flow definition with execution mode and options",
          _flow_create_props(), c_req), &_flow_create_handler));

    var v_req = vec_new();
    vec_push(v_req, "flow_json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_flow_validate",
          "Validate a flow definition — checks for DAG cycles and missing dependencies",
          _flow_json_props(), v_req), &_flow_validate_handler));

    var f_req = vec_new();
    vec_push(f_req, "flow_json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_flow_from_json", "Parse and inspect a flow definition from JSON",
          _flow_json_props(), f_req), &_flow_from_json_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_flow_list_modes", "List available workflow execution modes with descriptions",
          vec_new(), vec_new()), &_flow_list_modes_handler));

    var a_req = vec_new();
    vec_push(a_req, "flow_json");
    vec_push(a_req, "step_json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_flow_add_step", "Add a step to an existing flow definition, returning the updated flow",
          _flow_add_step_props(), a_req), &_flow_add_step_handler));
    return tools;
}

# --- mcp_tools_engine.cyr ---

# mcp_tools_engine.cyr — MCP engine tools (ports mcp/tools/engine_tools.rs): szal_engine_create,
# szal_result_inspect, szal_step_status_list, szal_error_list, szal_server_info.
#
# Mostly static/JSON-shaping tools (no szal core module needed). Handlers follow the bote ABI + the
# porting pattern in docs/development/state.md.
#
# PARITY NOTE (server version): Rust's szal_server_info reads version/description from
# env!("CARGO_PKG_*") at build time. The Cyrius analog, CYRIUS_PKG_VERSION, is per BUILD UNIT —
# in a consumer that vendors dist/szal-mcp.cyr it would report the consumer's version — so szal
# carries its own SZAL_VERSION below. scripts/version-bump.sh writes it from VERSION, CI checks the
# two agree, and tests/szal_mcp_tools_engine.tcyr compares server_info against ./VERSION at runtime.
# (Through 2.1.2 this was a hand-kept "2.0.0" literal that nobody kept: 2.1.0-2.1.2 all reported
# 2.0.0.) Recorded §20.
#
# Usage: include AFTER src/mcp.cyr (+ lib/bayan, lib/str, lib/vec).

# szal's version, as szal_server_info reports it. Written by scripts/version-bump.sh — do not edit.
var SZAL_VERSION = "2.3.3";

enum EngineTools {
    DEFAULT_MAX_CONCURRENCY = 16;
}

fn _eng_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# {k1:v1, k2:v2} where the values are cstrs wrapped as JSON strings (for the static list tools).
fn _eng_kv2(k1, v1, k2, v2) {
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from(k1), bayan_json_v_str_new(str_from(v1)));
    bayan_json_v_obj_set(o, str_from(k2), bayan_json_v_str_new(str_from(v2)));
    return o;
}

# JSON array of `cstr` strings.
fn _eng_str_arr(items) {
    var arr = bayan_json_v_arr_new();
    var n = vec_len(items);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(str_from(vec_get(items, i))));
        i = i + 1;
    }
    return arr;
}

# szal_engine_create: echo a config with default/overridden concurrency + timeout. Mirrors
# EngineCreate::call (engine_tools.rs 24-41). Default max_concurrency 16, global_timeout_ms None.
fn _engine_create_handler(args, claims) {
    var o = _eng_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var mc = DEFAULT_MAX_CONCURRENCY;
    var mcv = bayan_json_v_obj_get_by_cstr(o, "max_concurrency");
    if (bayan_json_v_is_int(mcv) == 1) { mc = bayan_json_v_int(mcv); }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("max_concurrency"), bayan_json_v_int_new(mc));
    var gtv = bayan_json_v_obj_get_by_cstr(o, "global_timeout_ms");
    if (bayan_json_v_is_int(gtv) == 1) {
        bayan_json_v_obj_set(out, str_from("global_timeout_ms"), bayan_json_v_int_new(bayan_json_v_int(gtv)));
    } else {
        bayan_json_v_obj_set(out, str_from("global_timeout_ms"), bayan_json_v_null());
    }
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# Count steps whose "status" string equals `want_c`.
fn _eng_count_status(steps, want_c) {
    var count = 0;
    var n = bayan_json_v_arr_len(steps);
    var i = 0;
    while (i < n) {
        var st = bayan_json_v_arr_get(steps, i);
        var sv = bayan_json_v_obj_get_by_cstr(st, "status");
        if (bayan_json_v_is_str(sv) == 1) {
            if (str_eq_cstr(bayan_json_v_str(sv), want_c) == 1) { count = count + 1; }
        }
        i = i + 1;
    }
    return count;
}

# szal_result_inspect: summarize a FlowResult JSON. Mirrors ResultInspect::call (engine_tools.rs 56-116).
fn _result_inspect_handler(args, claims) {
    var o = _eng_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var jv = bayan_json_v_obj_get_by_cstr(o, "result_json");
    if (bayan_json_v_is_str(jv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: result_json"));
        return str_data(e);
    }
    var val = bayan_json_v_parse(bayan_json_v_str(jv));
    if (val == 0) {
        var ej = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("invalid JSON"));
        return str_data(ej);
    }

    var flow_name = str_from("unknown");
    var fnv = bayan_json_v_obj_get_by_cstr(val, "flow_name");
    if (bayan_json_v_is_str(fnv) == 1) { flow_name = bayan_json_v_str(fnv); }

    var success = 0;
    var sv = bayan_json_v_obj_get_by_cstr(val, "success");
    if (bayan_json_v_is_bool(sv) == 1) { success = bayan_json_v_bool(sv); }
    var rolled_back = 0;
    var rv = bayan_json_v_obj_get_by_cstr(val, "rolled_back");
    if (bayan_json_v_is_bool(rv) == 1) { rolled_back = bayan_json_v_bool(rv); }
    var total_ms = 0;
    var tv = bayan_json_v_obj_get_by_cstr(val, "total_duration_ms");
    if (bayan_json_v_is_int(tv) == 1) { total_ms = bayan_json_v_int(tv); }

    var step_count = 0;
    var completed = 0;
    var failed = 0;
    var steps = bayan_json_v_obj_get_by_cstr(val, "steps");
    if (bayan_json_v_is_arr(steps) == 1) {
        step_count = bayan_json_v_arr_len(steps);
        completed = _eng_count_status(steps, "Completed");
        failed = _eng_count_status(steps, "Failed");
    }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("flow_name"), bayan_json_v_str_new(flow_name));
    bayan_json_v_obj_set(out, str_from("success"), bayan_json_v_bool_new(success));
    bayan_json_v_obj_set(out, str_from("rolled_back"), bayan_json_v_bool_new(rolled_back));
    bayan_json_v_obj_set(out, str_from("total_duration_ms"), bayan_json_v_int_new(total_ms));
    bayan_json_v_obj_set(out, str_from("step_count"), bayan_json_v_int_new(step_count));
    bayan_json_v_obj_set(out, str_from("completed"), bayan_json_v_int_new(completed));
    bayan_json_v_obj_set(out, str_from("failed"), bayan_json_v_int_new(failed));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# szal_step_status_list: the six step statuses. Mirrors StepStatusList::call (engine_tools.rs 131-145).
fn _step_status_list_handler(args, claims) {
    var arr = bayan_json_v_arr_new();
    bayan_json_v_arr_push(arr, _eng_kv2("status", "pending", "description", "Step has not started"));
    bayan_json_v_arr_push(arr, _eng_kv2("status", "running", "description", "Step is currently executing"));
    bayan_json_v_arr_push(arr, _eng_kv2("status", "completed", "description", "Step finished successfully"));
    bayan_json_v_arr_push(arr, _eng_kv2("status", "failed", "description", "Step execution failed"));
    bayan_json_v_arr_push(arr, _eng_kv2("status", "skipped", "description", "Step was skipped"));
    bayan_json_v_arr_push(arr, _eng_kv2("status", "rolled_back", "description",
        "Step was rolled back after failure"));
    var r = szal_result_ok_json(arr);
    return str_data(r);
}

# szal_error_list: the six workflow error types. Mirrors ErrorList::call (engine_tools.rs 160-174).
fn _error_list_handler(args, claims) {
    var arr = bayan_json_v_arr_new();
    bayan_json_v_arr_push(arr, _eng_kv2("error", "StepFailed", "description",
        "A step failed with a specific reason"));
    bayan_json_v_arr_push(arr, _eng_kv2("error", "StepTimeout", "description",
        "A step exceeded its timeout"));
    bayan_json_v_arr_push(arr, _eng_kv2("error", "InvalidFlow", "description",
        "Flow configuration is invalid"));
    bayan_json_v_arr_push(arr, _eng_kv2("error", "RetryExhausted", "description",
        "All retry attempts failed"));
    bayan_json_v_arr_push(arr, _eng_kv2("error", "RollbackFailed", "description",
        "Rollback operation failed"));
    bayan_json_v_arr_push(arr, _eng_kv2("error", "CycleDetected", "description", "DAG contains a cycle"));
    var r = szal_result_ok_json(arr);
    return str_data(r);
}

# szal_server_info: server identity + capabilities. Mirrors ServerInfo::call (engine_tools.rs 189-205).
fn _server_info_handler(args, claims) {
    var modes = vec_new();
    vec_push(modes, "sequential");
    vec_push(modes, "parallel");
    vec_push(modes, "dag");
    vec_push(modes, "hierarchical");
    var feats = vec_new();
    vec_push(feats, "retry");
    vec_push(feats, "rollback");
    vec_push(feats, "timeout");
    vec_push(feats, "dag_cycle_detection");
    vec_push(feats, "state_machine");

    var caps = bayan_json_v_obj_new();
    bayan_json_v_obj_set(caps, str_from("execution_modes"), _eng_str_arr(modes));
    bayan_json_v_obj_set(caps, str_from("features"), _eng_str_arr(feats));

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("name"), bayan_json_v_str_new(str_from("szal")));
    bayan_json_v_obj_set(out, str_from("version"), bayan_json_v_str_new(str_from(SZAL_VERSION)));
    # Rust reports env!("CARGO_PKG_DESCRIPTION"): rust-old/Cargo.toml's description, verbatim.
    var desc = "Workflow engine — step/flow execution with branching, retry, rollback, and parallel stages";
    bayan_json_v_obj_set(out, str_from("description"), bayan_json_v_str_new(str_from(desc)));
    bayan_json_v_obj_set(out, str_from("mcp_backend"), bayan_json_v_str_new(str_from("bote")));
    bayan_json_v_obj_set(out, str_from("capabilities"), caps);
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# --- schema property builders ---

fn _engine_create_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("max_concurrency", "{ \"type\": \"integer\" }"));
    vec_push(v, schema_prop_new("global_timeout_ms", "{ \"type\": \"integer\" }"));
    return v;
}

fn _result_json_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("result_json", "{ \"type\": \"string\" }"));
    return v;
}

# The engine tool group: engine_create, result_inspect, step_status_list, error_list, server_info.
fn szal_engine_tools() {
    var tools = vec_new();
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_engine_create", "Create an engine configuration with concurrency and timeout settings",
          _engine_create_props(), vec_new()), &_engine_create_handler));

    var ri_req = vec_new();
    vec_push(ri_req, "result_json");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_result_inspect",
          "Inspect a flow execution result — step counts, duration, success/failure",
          _result_json_props(), ri_req), &_result_inspect_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_step_status_list", "List all possible step execution statuses",
          vec_new(), vec_new()), &_step_status_list_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_error_list", "List all workflow error types with descriptions",
          vec_new(), vec_new()), &_error_list_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_server_info", "Show szal server info — version, capabilities",
          vec_new(), vec_new()), &_server_info_handler));
    return tools;
}

# --- mcp_tools_file.cyr ---

# mcp_tools_file.cyr — MCP file tools (ports mcp/tools/file_tools.rs): szal_file_read, szal_file_write,
# szal_dir_list, szal_file_stat, szal_path_exists.
#
# SECURITY: EVERY path is routed through szal_validate_path (mcp.cyr's lexical CWD-confinement boundary)
# before any filesystem access — paths outside the working directory or with `..` escapes are rejected
# with PermissionDenied. Read is capped (DEFAULT_MAX_READ_BYTES), directory listing is bounded
# (MAX_DIR_ENTRIES + MAX_DIR_DEPTH). Do NOT add a filesystem op that skips szal_validate_path.
#
# stat uses newfstatat (syscall 262, stable on x86_64-linux; raw SYS_STAT=4 is aarch64-fragile per
# syscalls.cyr). Handlers follow the bote ABI + the porting pattern in docs/development/state.md.
#
# PARITY NOTES:
# - file_read truncates at a raw byte boundary (read max_bytes), not Rust's UTF-8 char boundary — a
#   file larger than max_bytes may cut mid-codepoint. Files ≤ max_bytes are exact. (§21)
# - file_stat `modified` is second-precision UTC iso8601 (the chrono limitation, §14), not RFC3339.
#
# Usage: include AFTER src/mcp.cyr + lib/fs.cyr (dir_list/path_join) + lib/io.cyr (file_*) + lib/chrono.

enum FileTools {
    DEFAULT_MAX_READ_BYTES = 1048576;
    MAX_DIR_ENTRIES = 10000;
    DEFAULT_DIR_ENTRIES = 500;
    MAX_DIR_DEPTH = 20;
    STAT_BUF_SIZE = 144;
    STAT_MODE_OFF = 24;
    STAT_SIZE_OFF = 48;
    STAT_MTIME_OFF = 88;
}

fn _file_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# newfstatat(AT_FDCWD, path_cstr, statbuf, flags). Returns a 144-byte statbuf or 0 on error.
# nofollow=1 -> AT_SYMLINK_NOFOLLOW (lstat semantics); 0 -> follow symlinks (stat semantics).
# Through sys_fstatat (newfstatat#262 on Linux x86_64): on agnos it is a -ENOSYS stub, so this is 0
# there — never reached, since szal_validate_path refuses every path on agnos first.
fn _fs_stat(path_c, nofollow) {
    var sb = alloc(STAT_BUF_SIZE);
    var flags = 0;
    if (nofollow == 1) { flags = 256; }
    var rc = sys_fstatat(AT_FDCWD, path_c, sb, flags);
    if (rc < 0) { return 0; }
    return sb;
}

# Low 16 bits of st_mode (file type + permission bits).
fn _fs_mode(sb) { return load64(sb + STAT_MODE_OFF) & 0xFFFF; }

# "directory" / "symlink" / "file" for a st_mode value (S_IFMT classification).
fn _fs_kind(mode) {
    var fmt = mode & 0xF000;
    if (fmt == 0x4000) { return "directory"; }
    if (fmt == 0xA000) { return "symlink"; }
    return "file";
}

# Validate `path` (a Str); returns the normalized path Str on success, or writes a PermissionDenied
# result cstr to *out_err and returns 0.
fn _fs_validate(path, out_err) {
    var vr_t, vr_v = szal_validate_path(path);
    if (is_err_result(vr_t) == 1) {
        var e = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, err_code_of(vr_t, vr_v));
        store64(out_err, str_data(e));
        return 0;
    }
    return result_unwrap(vr_t, vr_v);
}

# szal_file_read: read up to max_bytes of a validated path. Mirrors FileRead::call (file_tools.rs 37-79).
fn _file_read_handler(args, claims) {
    var o = _file_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: path"));
        return str_data(e);
    }
    var errc = alloc(8);
    store64(errc, 0);
    var vpath = _fs_validate(bayan_json_v_str(pv), errc);
    if (vpath == 0) { return load64(errc); }

    var max_bytes = DEFAULT_MAX_READ_BYTES;
    var mbv = bayan_json_v_obj_get_by_cstr(o, "max_bytes");
    if (bayan_json_v_is_int(mbv) == 1) {
        var mb = bayan_json_v_int(mbv);
        if (mb > 0) { max_bytes = mb; }
    }

    var pc = str_cstr(vpath);
    var buf = alloc(max_bytes);
    var n = file_read_all(pc, buf, max_bytes);
    if (n < 0) {
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "failed to read ");
        str_builder_add(eb, vpath);
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
        return str_data(er);
    }
    var content = str_new(buf, n);
    var r = szal_result_ok(content);
    return str_data(r);
}

# szal_file_write: write/append content to a validated path. Mirrors FileWrite::call (file_tools.rs 99-154).
fn _file_write_handler(args, claims) {
    var o = _file_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: path"));
        return str_data(e);
    }
    var errc = alloc(8);
    store64(errc, 0);
    var vpath = _fs_validate(bayan_json_v_str(pv), errc);
    if (vpath == 0) { return load64(errc); }

    var cv = bayan_json_v_obj_get_by_cstr(o, "content");
    if (bayan_json_v_is_str(cv) == 0) {
        var e2 = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: content"));
        return str_data(e2);
    }
    var content = bayan_json_v_str(cv);
    var clen = str_len(content);
    var cdata = str_data(content);
    var pc = str_cstr(vpath);

    var append = 0;
    var av = bayan_json_v_obj_get_by_cstr(o, "append");
    if (bayan_json_v_is_bool(av) == 1) { append = bayan_json_v_bool(av); }

    var rc = 0;
    if (append == 1) {
        var fd = file_open(pc, O_WRONLY | O_CREAT | O_APPEND, 0x1A4);
        if (fd < 0) { rc = fd; } else {
            rc = file_write(fd, cdata, clen);
            file_close(fd);
        }
    } else {
        rc = file_write_all(pc, cdata, clen);
    }
    if (rc < 0) {
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "failed to write ");
        str_builder_add(eb, vpath);
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
        return str_data(er);
    }

    var wb = str_builder_new();
    str_builder_add_cstr(wb, "wrote ");
    str_builder_add_int(wb, clen);
    str_builder_add_cstr(wb, " bytes to ");
    str_builder_add(wb, vpath);
    var r = szal_result_ok(str_builder_build(wb));
    return str_data(r);
}

# One dir entry json: {name, path, type, [size if file]}. `dir_path` is the parent Str.
fn _fs_entry(dir_path, name) {
    var full = path_join(dir_path, name);
    var sb = _fs_stat(str_cstr(full), 1);
    var kind = "file";
    var is_file = 0;
    var size = 0;
    if (sb != 0) {
        var mode = _fs_mode(sb);
        kind = _fs_kind(mode);
        if ((mode & 0xF000) == 0x8000) { is_file = 1; size = load64(sb + STAT_SIZE_OFF); }
    }
    var info = bayan_json_v_obj_new();
    bayan_json_v_obj_set(info, str_from("name"), bayan_json_v_str_new(name));
    bayan_json_v_obj_set(info, str_from("path"), bayan_json_v_str_new(full));
    bayan_json_v_obj_set(info, str_from("type"), bayan_json_v_str_new(str_from(kind)));
    if (is_file == 1) {
        bayan_json_v_obj_set(info, str_from("size"), bayan_json_v_int_new(size));
    }
    return info;
}

# Recursively collect directory entries into `entries` (bounded by max + MAX_DIR_DEPTH). Mirrors
# collect_dir (file_tools.rs 208-257).
fn _fs_collect_dir(dir_path, recursive, max, entries, depth) {
    if (depth > MAX_DIR_DEPTH) { return 0; }
    var names = dir_list(dir_path);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        if (vec_len(entries) >= max) { return 0; }
        var name = vec_get(names, i);
        i = i + 1;
        var full = path_join(dir_path, name);
        var sb = _fs_stat(str_cstr(full), 1);
        var is_dir = 0;
        if (sb != 0) {
            if ((_fs_mode(sb) & 0xF000) == 0x4000) { is_dir = 1; }
        }
        vec_push(entries, _fs_entry(dir_path, name));
        if (recursive == 1 && is_dir == 1 && vec_len(entries) < max) {
            _fs_collect_dir(full, 1, max, entries, depth + 1);
        }
    }
    return 0;
}

# szal_dir_list: list a validated directory (optionally recursive). Mirrors DirList::call (file_tools.rs 174-205).
fn _dir_list_handler(args, claims) {
    var o = _file_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var path = str_from(".");
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 1) { path = bayan_json_v_str(pv); }

    var errc = alloc(8);
    store64(errc, 0);
    var vpath = _fs_validate(path, errc);
    if (vpath == 0) { return load64(errc); }

    var recursive = 0;
    var rv = bayan_json_v_obj_get_by_cstr(o, "recursive");
    if (bayan_json_v_is_bool(rv) == 1) { recursive = bayan_json_v_bool(rv); }

    var max = DEFAULT_DIR_ENTRIES;
    var mv = bayan_json_v_obj_get_by_cstr(o, "max_entries");
    if (bayan_json_v_is_int(mv) == 1) {
        var m = bayan_json_v_int(mv);
        if (m >= 0) { max = m; }
    }
    if (max > MAX_DIR_ENTRIES) { max = MAX_DIR_ENTRIES; }

    var entries = vec_new();
    _fs_collect_dir(vpath, recursive, max, entries, 0);

    var arr = bayan_json_v_arr_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        bayan_json_v_arr_push(arr, vec_get(entries, i));
        i = i + 1;
    }
    var r = szal_result_ok_json(arr);
    return str_data(r);
}

# szal_file_stat: metadata of a validated path. Mirrors FileStat::call (file_tools.rs 272-320).
fn _file_stat_handler(args, claims) {
    var o = _file_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: path"));
        return str_data(e);
    }
    var errc = alloc(8);
    store64(errc, 0);
    var vpath = _fs_validate(bayan_json_v_str(pv), errc);
    if (vpath == 0) { return load64(errc); }

    var sb = _fs_stat(str_cstr(vpath), 1);
    if (sb == 0) {
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "failed to stat ");
        str_builder_add(eb, vpath);
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
        return str_data(er);
    }
    var mode = _fs_mode(sb);
    var readonly = 0;
    if ((mode & 0x92) == 0) { readonly = 1; }
    var modc = iso8601(load64(sb + STAT_MTIME_OFF));
    var mods = str_from(modc);

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("path"), bayan_json_v_str_new(vpath));
    bayan_json_v_obj_set(out, str_from("type"), bayan_json_v_str_new(str_from(_fs_kind(mode))));
    bayan_json_v_obj_set(out, str_from("size"), bayan_json_v_int_new(load64(sb + STAT_SIZE_OFF)));
    bayan_json_v_obj_set(out, str_from("readonly"), bayan_json_v_bool_new(readonly));
    bayan_json_v_obj_set(out, str_from("modified"), bayan_json_v_str_new(mods));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# szal_path_exists: existence + file/dir of a validated path (follows symlinks). Mirrors PathExists::call
# (file_tools.rs 336-365).
fn _path_exists_handler(args, claims) {
    var o = _file_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: path"));
        return str_data(e);
    }
    var errc = alloc(8);
    store64(errc, 0);
    var vpath = _fs_validate(bayan_json_v_str(pv), errc);
    if (vpath == 0) { return load64(errc); }

    var sb = _fs_stat(str_cstr(vpath), 0);
    var exists = 0;
    var is_file = 0;
    var is_dir = 0;
    if (sb != 0) {
        exists = 1;
        var fmt = _fs_mode(sb) & 0xF000;
        if (fmt == 0x8000) { is_file = 1; }
        if (fmt == 0x4000) { is_dir = 1; }
    }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("path"), bayan_json_v_str_new(vpath));
    bayan_json_v_obj_set(out, str_from("exists"), bayan_json_v_bool_new(exists));
    bayan_json_v_obj_set(out, str_from("is_file"), bayan_json_v_bool_new(is_file));
    bayan_json_v_obj_set(out, str_from("is_dir"), bayan_json_v_bool_new(is_dir));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# --- schema property builders ---

fn _file_read_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("path", "{ \"type\": \"string\", \"description\": \"File path to read\" }"));
    vec_push(v, schema_prop_new("max_bytes",
        "{ \"type\": \"integer\", \"description\": \"Max bytes to read (default: 1MB)\" }"));
    return v;
}

fn _file_write_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("path", "{ \"type\": \"string\", \"description\": \"File path to write\" }"));
    vec_push(v, schema_prop_new("content", "{ \"type\": \"string\", \"description\": \"Content to write\" }"));
    vec_push(v, schema_prop_new("append",
        "{ \"type\": \"boolean\", \"description\": \"Append instead of overwrite (default: false)\" }"));
    return v;
}

fn _dir_list_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("path",
        "{ \"type\": \"string\", \"description\": \"Directory path (default: current dir)\" }"));
    vec_push(v, schema_prop_new("recursive",
        "{ \"type\": \"boolean\", \"description\": \"Recurse into subdirectories (default: false)\" }"));
    vec_push(v, schema_prop_new("max_entries",
        "{ \"type\": \"integer\", \"description\": \"Max entries to return (default: 500)\" }"));
    return v;
}

fn _path_props(desc_c) {
    var v = vec_new();
    var b = str_builder_new();
    str_builder_add_cstr(b, "{ \"type\": \"string\"");
    str_builder_add_cstr(b, desc_c);
    str_builder_add_cstr(b, " }");
    var p_c = str_cstr(str_builder_build(b));
    vec_push(v, schema_prop_new("path", p_c));
    return v;
}

# The file tool group: file_read, file_write, dir_list, file_stat, path_exists.
fn szal_file_tools() {
    var tools = vec_new();
    var p_req = vec_new();
    vec_push(p_req, "path");

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_file_read", "Read a file's contents as text", _file_read_props(), p_req),
        &_file_read_handler));

    var w_req = vec_new();
    vec_push(w_req, "path");
    vec_push(w_req, "content");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_file_write", "Write text content to a file (creates or overwrites)",
          _file_write_props(), w_req), &_file_write_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_dir_list", "List files and directories in a path", _dir_list_props(), vec_new()),
        &_dir_list_handler));

    var s_req = vec_new();
    vec_push(s_req, "path");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_file_stat", "Get metadata for a file or directory (size, permissions, timestamps)",
          _path_props(", \"description\": \"File or directory path\""), s_req), &_file_stat_handler));

    var e_req = vec_new();
    vec_push(e_req, "path");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_path_exists", "Check if a file or directory exists", _path_props(""), e_req),
        &_path_exists_handler));
    return tools;
}

# --- mcp_tools_process.cyr ---

# mcp_tools_process.cyr — MCP process tools (ports mcp/tools/process_tools.rs): szal_exec, szal_pid,
# szal_which.
#
# SECURITY: szal_exec runs a command WITHOUT a shell (direct fork+execve, no `/bin/sh -c`), and
# rejects any command name containing `..` or `/` (must be a plain PATH-resolved executable name) —
# the exact Rust guard. `cwd` (if given) is routed through validate_path. Do NOT introduce a shell or
# accept path-form command names.
#
# Process model (Linux): PATH is resolved manually (getenv("PATH") + access(X_OK)); the child runs
# with a minimal envp ["PATH=…"]; stdout + stderr are captured via pipes; the exit code comes from
# waitpid.
#
# Process model (agnos, `CYRIUS_TARGET_AGNOS`; 2.3.3): agnos has no execve, dup2 or access, and a
# one-argument waitpid. PATH is resolved the same way, with a stat in place of access(X_OK) and
# "/bin" when the environment sets no PATH (agnos's default environment holds only HOME and PWD).
# The child is started from disk with a real argv (spawn_path#43, SPAWN_F_ARGV + SPAWN_F_CLEANFD),
# argv[0] being the full path the kernel opens; its fd 1 and 2 go to two pipes (exec_redirect#62);
# both pipes are read without blocking, in turn, until each reaches EOF, and only then is the child
# reaped (WAIT_BLOCK) — reading one pipe to EOF first would deadlock on a child that fills the other
# (an agnos pipe holds 4080 B). A working directory cannot be set there: the cyrius 6.7.18 agnos
# peer has no chdir, so a run asked for one is refused, never run elsewhere. The redirect arms are
# per-process state, which is safe because agnos threads run serially (THREADS_CONCURRENT = 0).
# parity-notes §26.
#
# PARITY NOTES:
# - timeout_ms is accepted but NOT enforced — the command runs to completion (no SIGALRM/poll timer
#   wired). Observably identical for fast commands; the Timeout error branch is unreachable. (§22)
# - stdout/stderr are read after the child exits via fixed 64 KiB pipe buffers; a command emitting
#   >64 KiB before exit could block (no select/poll loop). Fine for the tested commands. (§22)
#
# Usage: include AFTER src/mcp.cyr + lib/io.cyr (getenv) + lib/syscalls.cyr (sys_fork/pipe/execve/…
# on Linux; sys_spawn_argv / sys_exec_redirect / sys_waitpid_block / sys_read_nb on agnos).

enum ProcessTools {
    DEFAULT_EXEC_TIMEOUT_MS = 30000;
    PROC_BUF_SIZE = 65536;
}

fn _proc_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# 1 if `cmd` (a Str) contains `/` or `..` (a path form, rejected). Mirrors process_tools.rs 48.
fn _proc_cmd_has_path(cmd) {
    var d = str_data(cmd);
    var n = str_len(cmd);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c == 47) { return 1; }
        if (c == 46 && i + 1 < n) {
            if ((load8(d + i + 1) & 0xFF) == 46) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# 1 if the NUL-terminated `path_c` names a program this target can start, else 0. Linux:
# access(X_OK). agnos has no access(2) (its sys_access answers -1 for every path) and no permission
# bits: a regular file the kernel can stat is what spawn_path#43 will try to load.
fn _proc_runnable(path_c) {
    #ifdef CYRIUS_TARGET_AGNOS
    var sb[64];
    if (sys_stat(path_c, strlen(path_c), &sb) != 0) { return 0; }
    if ((load64(&sb + STAT_MODE) & 0xF000) != 0x8000) { return 0; }
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (sys_access(path_c, 1) == 0) { return 1; }
    return 0;
    #endif
}

# Try "<dir>/<cmd>"; return a NUL-terminated full-path cstr if it is executable (access X_OK), else 0.
fn _proc_try(dir_ptr, dir_len, cmd) {
    var clen = strlen(cmd);
    var buf = alloc(dir_len + 1 + clen + 1);
    memcpy(buf, dir_ptr, dir_len);
    store8(buf + dir_len, 47);
    memcpy(buf + dir_len + 1, cmd, clen);
    store8(buf + dir_len + 1 + clen, 0);
    if (_proc_runnable(buf) == 1) { return buf; }
    return 0;
}

# The program search path: $PATH, or 0 when it is unset. On agnos an unset PATH reads as "/bin":
# its default environment holds only HOME and PWD, and its shell (agnsh) runs a bare name as
# /bin/<name>.
fn _proc_search_path() {
    var pe = getenv("PATH");
    #ifdef CYRIUS_TARGET_AGNOS
    if (pe == 0) { pe = "/bin"; }
    #endif
    return pe;
}

# Resolve `cmd` (cstr) against $PATH; return the full executable cstr or 0 (not found).
fn _proc_path_lookup(cmd) {
    var pe = _proc_search_path();
    if (pe == 0) { return 0; }
    var i = 0;
    var start = 0;
    var go = 1;
    while (go == 1) {
        var c = load8(pe + i) & 0xFF;
        if (c == 58 || c == 0) {
            var seg_len = i - start;
            if (seg_len > 0) {
                var full = _proc_try(pe + start, seg_len, cmd);
                if (full != 0) { return full; }
            }
            start = i + 1;
            if (c == 0) { go = 0; }
        }
        i = i + 1;
    }
    return 0;
}

# Read fd to EOF into buf (capped). Returns bytes read.
fn _proc_read_all(fd, buf, cap) {
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, cap - total);
        if (n <= 0) { rgo = 0; } else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    return total;
}

# Build a minimal envp ["PATH=<value>", NULL] from the current PATH (or [NULL] if unset).
fn _proc_envp() {
    var envp = alloc(16);
    var pe = getenv("PATH");
    if (pe == 0) {
        store64(envp, 0);
        return envp;
    }
    var pl = strlen(pe);
    var pbuf = alloc(5 + pl + 1);
    store8(pbuf, 80);
    store8(pbuf + 1, 65);
    store8(pbuf + 2, 84);
    store8(pbuf + 3, 72);
    store8(pbuf + 4, 61);
    memcpy(pbuf + 5, pe, pl);
    store8(pbuf + 5 + pl, 0);
    store64(envp, pbuf);
    store64(envp + 8, 0);
    return envp;
}

# Run `argv` (a vec of cstr ptrs) with optional `cwd_c` (cstr or 0); capture stdout/stderr/exit code.
# Returns a 40-byte result { exit_code@0, stdout Str@8, stderr Str@16, ran@24, why@32 }. ran: 0 = not
# found (or fork failed), 1 = it ran, 2 = found but not started, with the reason as a cstr at why@32
# (agnos only: a spawn the kernel refused, or a working directory asked for). Treat any ran != 1 as
# "nothing ran" — exit_code is 0 then.
fn _proc_run(argv, cwd_c) {
    var res = alloc(40);
    store64(res, 0);
    store64(res + 8, 0);
    store64(res + 16, 0);
    store64(res + 24, 0);
    store64(res + 32, 0);

    var cmd = vec_get(argv, 0);
    var full = _proc_path_lookup(cmd);
    if (full == 0) { return res; }

    #ifdef CYRIUS_TARGET_AGNOS
    if (cwd_c != 0) {
        store64(res + 24, 2);
        store64(res + 32, "a working directory cannot be set on agnos (no chdir in the cyrius 6.7.18 agnos peer)");
        return res;
    }
    _proc_run_agnos(full, argv, res);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _proc_run_posix(full, argv, cwd_c, res);
    #endif
    return res;
}

#ifndef CYRIUS_TARGET_AGNOS
# Linux: fork, point the child's fd 1/2 at two pipes, chdir to `cwd_c` (cstr or 0), execve `full`
# with `argv`; read stdout then stderr to EOF, reap, and fill `res` (see _proc_run).
fn _proc_run_posix(full, argv, cwd_c, res) {
    var argc = vec_len(argv);
    var av = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(av + i * 8, vec_get(argv, i));
        i = i + 1;
    }
    store64(av + argc * 8, 0);
    var envp = _proc_envp();

    var po[16];
    var pe2[16];
    sys_pipe(&po);
    sys_pipe(&pe2);
    var o_r = load32(&po);
    var o_w = load32(&po + 4);
    var e_r = load32(&pe2);
    var e_w = load32(&pe2 + 4);

    var pid = sys_fork();
    if (pid < 0) { return res; }
    if (pid == 0) {
        sys_close(o_r);
        sys_close(e_r);
        sys_dup2(o_w, 1);
        sys_dup2(e_w, 2);
        sys_close(o_w);
        sys_close(e_w);
        if (cwd_c != 0) { sys_chdir(cwd_c); }
        sys_execve(full, av, envp);
        sys_exit(127);
    }
    sys_close(o_w);
    sys_close(e_w);

    var obuf = alloc(PROC_BUF_SIZE);
    var on = _proc_read_all(o_r, obuf, PROC_BUF_SIZE);
    sys_close(o_r);
    var ebuf = alloc(PROC_BUF_SIZE);
    var en = _proc_read_all(e_r, ebuf, PROC_BUF_SIZE);
    sys_close(e_r);

    var stbuf = alloc(8);
    sys_waitpid(pid, stbuf, 0);
    var status = load64(stbuf);
    var code = (status >> 8) & 0xFF;

    store64(res, code);
    store64(res + 8, str_new(obuf, on));
    store64(res + 16, str_new(ebuf, en));
    store64(res + 24, 1);
    return res;
}
#endif

#ifdef CYRIUS_TARGET_AGNOS
# Why agnos refused a spawn, from spawn_path#43's -SPAWN_E_* code (a cstr).
fn _proc_spawn_why(code) {
    if (code == 0 - SPAWN_E_NOPROC) { return "agnos spawn refused: the process table is full"; }
    if (code == 0 - SPAWN_E_NOMEM) { return "agnos spawn refused: out of memory"; }
    if (code == 0 - SPAWN_E_NOENT) { return "agnos spawn refused: not a regular file it can read"; }
    if (code == 0 - SPAWN_E_NOEXEC) { return "agnos spawn refused: not an ELF64 this kernel loads"; }
    if (code == 0 - SPAWN_E_ARGS) {
        return "agnos spawn refused: more than 16 arguments, or more than 1024 bytes of arguments or of PATH";
    }
    if (code == 0 - SPAWN_E_LIMIT) { return "agnos spawn refused: the program exceeds the spawn memory cap"; }
    return "agnos spawn refused (a kernel older than agnos 1.57.6, or another reason)";
}

# One non-blocking read of pipe `fd` into `buf` past its first `have` bytes (PROC_BUF_SIZE cap).
# Returns the bytes read (> 0), 0 when nothing is there yet (the writer is still open), or -1 when
# this stream is done: EOF, an error, or a full buffer.
fn _proc_pull(fd, buf, have) {
    if (have >= PROC_BUF_SIZE) { return 0 - 1; }
    var n = sys_read_nb(fd, buf + have, PROC_BUF_SIZE - have);
    if (n > 0) { return n; }
    if (n == 0 - 2) { return 0; }
    return 0 - 1;
}

# Block until child `pid` exits and reap it: its wait status (>= 0), or -1. WAIT_BLOCK first; its -1
# (a kernel older than 1.57.7) or -2 (this caller cannot block now) falls back to polling waitpid#4,
# which answers -2 while the child lives. (lib/process_agnos.cyr's _agp_wait, which szal cannot
# reach: a consumer need not include lib/process.cyr.)
fn _proc_wait(pid) {
    var st = sys_waitpid_block(pid);
    if (st >= 0) { return st; }
    var polling = 1;
    while (polling == 1) {
        st = sys_waitpid(pid);
        if (st != 0 - 2) { polling = 0; } else { sys_sleep_ms(1); }
    }
    return st;
}

# agnos: start `full` with `argv` (argv[0] replaced by `full`) and fill `res` (see _proc_run). The
# child gets the same environment as on Linux — "PATH=<$PATH>" alone, or agnos's default one when
# PATH is unset — and a clean fd table holding only fd 0, and fd 1 and 2 redirected to our pipes.
# The exit code is the child's for an exit, and -1 for a death by signal or when it could not be
# reaped (Rust's `status.code()` is None there; the Linux path's §24.3 edge does not apply).
fn _proc_run_agnos(full, argv, res) {
    var argc = vec_len(argv);
    var blen = strlen(full) + 1;
    var i = 1;
    while (i < argc) {
        blen = blen + strlen(vec_get(argv, i)) + 1;
        i = i + 1;
    }
    var blob = alloc(blen);
    var off = strlen(full) + 1;
    memcpy(blob, full, off);
    i = 1;
    while (i < argc) {
        var a = vec_get(argv, i);
        var alen = strlen(a) + 1;
        memcpy(blob + off, a, alen);
        off = off + alen;
        i = i + 1;
    }

    var env = 0;
    var elen = 0;
    var pe = getenv("PATH");
    if (pe != 0) {
        var pl = strlen(pe);
        elen = 5 + pl + 1;
        env = alloc(elen);
        memcpy(env, "PATH=", 5);
        memcpy(env + 5, pe, pl + 1);
    }

    var po[16];
    var pe2[16];
    if (sys_pipe(&po) < 0) {
        store64(res + 24, 2);
        store64(res + 32, "could not create a pipe");
        return res;
    }
    var o_r = load64(&po);
    var o_w = load64(&po + 8);
    if (sys_pipe(&pe2) < 0) {
        sys_close(o_r);
        sys_close(o_w);
        store64(res + 24, 2);
        store64(res + 32, "could not create a pipe");
        return res;
    }
    var e_r = load64(&pe2);
    var e_w = load64(&pe2 + 8);

    var armed = sys_exec_redirect(1, o_w);
    if (armed == 0) { armed = sys_exec_redirect_add(2, e_w); }
    var pid = 0 - 1;
    if (armed == 0) {
        pid = sys_spawn_argv(blob, blen, env, elen, SPAWN_F_CLEANFD);   # every #43 return disarms
    } else {
        sys_exec_redirect_clear();
    }
    sys_close(o_w);
    sys_close(e_w);
    if (pid < 0) {
        sys_close(o_r);
        sys_close(e_r);
        store64(res + 24, 2);
        if (armed == 0) {
            store64(res + 32, _proc_spawn_why(pid));
        } else {
            store64(res + 32, "could not redirect the child's output (a pipe fd past 31)");
        }
        return res;
    }

    var obuf = alloc(PROC_BUF_SIZE);
    var ebuf = alloc(PROC_BUF_SIZE);
    var on = 0;
    var en = 0;
    var o_live = 1;
    var e_live = 1;
    while (o_live + e_live > 0) {
        var moved = 0;
        if (o_live == 1) {
            var g = _proc_pull(o_r, obuf, on);
            if (g < 0) {
                o_live = 0;
                sys_close(o_r);
            } else {
                on = on + g;
                if (g > 0) { moved = 1; }
            }
        }
        if (e_live == 1) {
            var h = _proc_pull(e_r, ebuf, en);
            if (h < 0) {
                e_live = 0;
                sys_close(e_r);
            } else {
                en = en + h;
                if (h > 0) { moved = 1; }
            }
        }
        if (moved == 0) {
            if (o_live + e_live > 0) { sys_sleep_ms(1); }
        }
    }

    var st = _proc_wait(pid);
    var code = 0 - 1;
    if (st >= 0) {
        if (WIFSIGNALED(st) == 0) { code = WEXITSTATUS(st); }
    }
    store64(res, code);
    store64(res + 8, str_new(obuf, on));
    store64(res + 16, str_new(ebuf, en));
    store64(res + 24, 1);
    return res;
}
#endif

# szal_exec: run a PATH-resolved command (no shell) and report exit/stdout/stderr. Mirrors Exec::call
# (process_tools.rs 29-107).
fn _exec_handler(args, claims) {
    var o = _proc_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var cv = bayan_json_v_obj_get_by_cstr(o, "command");
    if (bayan_json_v_is_str(cv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: command"));
        return str_data(e);
    }
    var command = bayan_json_v_str(cv);
    if (_proc_cmd_has_path(command) == 1) {
        var ep = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED,
          str_from("command must be a plain executable name, not a path — use PATH lookup"));
        return str_data(ep);
    }

    var argv = vec_new();
    vec_push(argv, str_cstr(command));
    var av = bayan_json_v_obj_get_by_cstr(o, "args");
    if (bayan_json_v_is_arr(av) == 1) {
        var n = bayan_json_v_arr_len(av);
        var i = 0;
        while (i < n) {
            var a = bayan_json_v_arr_get(av, i);
            if (bayan_json_v_is_str(a) == 1) { vec_push(argv, str_cstr(bayan_json_v_str(a))); }
            i = i + 1;
        }
    }

    var cwd_c = 0;
    var cwv = bayan_json_v_obj_get_by_cstr(o, "cwd");
    if (bayan_json_v_is_str(cwv) == 1) {
        var vr_t, vr_v = szal_validate_path(bayan_json_v_str(cwv));
        if (is_err_result(vr_t) == 1) {
            var ec = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, err_code_of(vr_t, vr_v));
            return str_data(ec);
        }
        cwd_c = str_cstr(result_unwrap(vr_t, vr_v));
    }

    var res = _proc_run(argv, cwd_c);
    if (load64(res + 24) != 1) {
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "command failed: ");
        str_builder_add(eb, command);
        if (load64(res + 24) == 2) {
            str_builder_add_cstr(eb, " could not be started: ");
            str_builder_add_cstr(eb, load64(res + 32));
        } else {
            str_builder_add_cstr(eb, " not found");
        }
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
        return str_data(er);
    }

    var code = load64(res);
    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("exit_code"), bayan_json_v_int_new(code));
    bayan_json_v_obj_set(out, str_from("stdout"), bayan_json_v_str_new(load64(res + 8)));
    bayan_json_v_obj_set(out, str_from("stderr"), bayan_json_v_str_new(load64(res + 16)));
    var success = 0;
    if (code == 0) { success = 1; }
    bayan_json_v_obj_set(out, str_from("success"), bayan_json_v_bool_new(success));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# szal_pid: the current process id (sys_getpid: getpid#39 on Linux x86_64, #2 on agnos). Mirrors Pid::call
# (process_tools.rs 118-123).
fn _pid_handler(args, claims) {
    var p = sys_getpid();
    var ps = str_from_int(p);
    var r = szal_result_ok(ps);
    return str_data(r);
}

# Trim trailing whitespace (newline/space/tab/cr) from a Str.
fn _proc_trim_end(s) {
    var n = str_len(s);
    var d = str_data(s);
    var trimming = 1;
    while (trimming == 1) {
        if (n <= 0) { trimming = 0; } else {
            var c = load8(d + n - 1) & 0xFF;
            if (c == 10 || c == 13 || c == 32 || c == 9) { n = n - 1; } else { trimming = 0; }
        }
    }
    return str_new(d, n);
}

# szal_which: is `command` on PATH? Mirrors Which::call (process_tools.rs 139-174).
fn _which_handler(args, claims) {
    var o = _proc_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var cv = bayan_json_v_obj_get_by_cstr(o, "command");
    if (bayan_json_v_is_str(cv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: command"));
        return str_data(e);
    }
    var command = bayan_json_v_str(cv);

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("command"), bayan_json_v_str_new(command));
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos ships no `which`: look the name up as szal_exec would. A path form is never found
    # (szal_exec refuses one), so this cannot probe for files outside PATH.
    var full = 0;
    if (_proc_cmd_has_path(command) == 0) {
        if (str_len(command) > 0) { full = _proc_path_lookup(str_cstr(command)); }
    }
    if (full != 0) {
        bayan_json_v_obj_set(out, str_from("found"), bayan_json_v_bool_new(1));
        bayan_json_v_obj_set(out, str_from("path"), bayan_json_v_str_new(str_from(full)));
    } else {
        bayan_json_v_obj_set(out, str_from("found"), bayan_json_v_bool_new(0));
    }
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var argv = vec_new();
    vec_push(argv, str_cstr(str_from("which")));
    vec_push(argv, str_cstr(command));
    var res = _proc_run(argv, 0);
    if (load64(res + 24) == 1 && load64(res) == 0) {
        bayan_json_v_obj_set(out, str_from("found"), bayan_json_v_bool_new(1));
        bayan_json_v_obj_set(out, str_from("path"), bayan_json_v_str_new(_proc_trim_end(load64(res + 8))));
    } else {
        bayan_json_v_obj_set(out, str_from("found"), bayan_json_v_bool_new(0));
    }
    #endif
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# --- schema property builders ---

fn _exec_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("command", "{ \"type\": \"string\", \"description\": \"Command to execute\" }"));
    var ab = str_builder_new();
    str_builder_add_cstr(ab, "{ \"type\": \"array\", \"items\": { \"type\": \"string\" }, ");
    str_builder_add_cstr(ab, "\"description\": \"Command arguments\" }");
    var args_c = str_cstr(str_builder_build(ab));
    vec_push(v, schema_prop_new("args", args_c));
    vec_push(v, schema_prop_new("cwd",
        "{ \"type\": \"string\", \"description\": \"Working directory (optional)\" }"));
    vec_push(v, schema_prop_new("timeout_ms",
        "{ \"type\": \"integer\", \"description\": \"Timeout in milliseconds (default: 30000)\" }"));
    return v;
}

fn _which_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("command",
        "{ \"type\": \"string\", \"description\": \"Command name to look up\" }"));
    return v;
}

# The process tool group: szal_exec, szal_pid, szal_which.
fn szal_process_tools() {
    var tools = vec_new();
    var c_req = vec_new();
    vec_push(c_req, "command");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_exec", "Execute a shell command and return stdout, stderr, and exit code",
          _exec_props(), c_req), &_exec_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_pid", "Get the current process ID", vec_new(), vec_new()), &_pid_handler));

    var w_req = vec_new();
    vec_push(w_req, "command");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_which", "Check if a command exists on PATH", _which_props(), w_req),
        &_which_handler));
    return tools;
}

# --- mcp_tools_git.cyr ---

# mcp_tools_git.cyr — MCP git tools (ports mcp/tools/git_tools.rs): szal_git_status, szal_git_log,
# szal_git_diff, szal_git_branch, szal_git_blame.
#
# SECURITY: every ref/file argument that could be attacker-controlled is checked against option
# injection — validate_git_ref rejects a leading `-` (so a value can't masquerade as a git flag);
# git_blame additionally rejects `..` in the file. All git invocations go through the no-shell
# fork/exec from mcp_tools_process (_proc_run) — `git <subcommand> …`, never a shell. Do NOT regress.
#
# Reuses mcp_tools_process._proc_run / _proc_trim_end. As in Rust, the `path` arg sets git's cwd
# directly (git itself confines to the repo); it is NOT routed through validate_path (git_tools.rs).
#
# Usage: include AFTER src/mcp_tools_process.cyr + src/mcp.cyr (+ lib/bayan, lib/str, lib/hashmap).

enum GitTools {
    DEFAULT_LOG_COUNT = 10;
    MAX_LOG_COUNT = 100;
}

fn _git_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# Run `git` with the cstr argv `argv` in `cwd_c` (0 = inherit). Returns { ok@0, output Str@8 }:
# ok=1 + trimmed stdout on exit 0; ok=0 + trimmed stderr on failure; ok=0 + "git not available" if
# git is missing; ok=0 + the reason when it was found but not started (agnos: a refused spawn, or a
# `path`, since no working directory can be set there). Mirrors git_cmd (git_tools.rs 22-35).
fn _git_cmd(argv, cwd_c) {
    var res = _proc_run(argv, cwd_c);
    var out = alloc(16);
    if (load64(res + 24) == 0) {
        store64(out, 0);
        store64(out + 8, str_from("git not available"));
        return out;
    }
    if (load64(res + 24) != 1) {
        store64(out, 0);
        store64(out + 8, str_from(load64(res + 32)));
        return out;
    }
    if (load64(res) == 0) {
        store64(out, 1);
        store64(out + 8, _proc_trim_end(load64(res + 8)));
    } else {
        store64(out, 0);
        store64(out + 8, _proc_trim_end(load64(res + 16)));
    }
    return out;
}

fn _git_ok(o) { return load64(o); }
fn _git_out(o) { return load64(o + 8); }

# 1 if `s` (a Str) starts with '-' (an option-injection ref). Mirrors validate_git_ref (git_tools.rs 14).
fn _git_ref_bad(s) {
    if (str_len(s) == 0) { return 0; }
    if ((load8(str_data(s)) & 0xFF) == 45) { return 1; }
    return 0;
}

# Read the optional `path` arg as a cwd cstr (0 if absent).
fn _git_cwd(o) {
    var pv = bayan_json_v_obj_get_by_cstr(o, "path");
    if (bayan_json_v_is_str(pv) == 1) { return str_cstr(bayan_json_v_str(pv)); }
    return 0;
}

# szal_git_status: branch + porcelain-derived modified/staged/untracked counts. Mirrors GitStatus::call
# (git_tools.rs 50-92).
fn _git_status_handler(args, claims) {
    var o = _git_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var cwd = _git_cwd(o);

    var ba = vec_new();
    vec_push(ba, "git");
    vec_push(ba, "rev-parse");
    vec_push(ba, "--abbrev-ref");
    vec_push(ba, "HEAD");
    var br = _git_cmd(ba, cwd);
    var branch = str_from("");
    if (_git_ok(br) == 1) { branch = _git_out(br); }

    var sa = vec_new();
    vec_push(sa, "git");
    vec_push(sa, "status");
    vec_push(sa, "--porcelain");
    var st = _git_cmd(sa, cwd);
    var status = str_from("");
    if (_git_ok(st) == 1) { status = _git_out(st); }

    var modified = 0;
    var staged = 0;
    var untracked = 0;
    var lines = str_split(status, 10);
    var n = vec_len(lines);
    var i = 0;
    while (i < n) {
        var line = vec_get(lines, i);
        i = i + 1;
        if (str_len(line) >= 2) {
            var d = str_data(line);
            var b0 = load8(d) & 0xFF;
            var b1 = load8(d + 1) & 0xFF;
            if (b0 == 63 && b1 == 63) { untracked = untracked + 1; }
            elif (b0 == 32) { modified = modified + 1; }
            elif (b1 == 32) { staged = staged + 1; }
            else { modified = modified + 1; staged = staged + 1; }
        }
    }
    var clean = 0;
    if (str_len(status) == 0) { clean = 1; }

    var info = bayan_json_v_obj_new();
    bayan_json_v_obj_set(info, str_from("branch"), bayan_json_v_str_new(branch));
    bayan_json_v_obj_set(info, str_from("clean"), bayan_json_v_bool_new(clean));
    bayan_json_v_obj_set(info, str_from("modified"), bayan_json_v_int_new(modified));
    bayan_json_v_obj_set(info, str_from("staged"), bayan_json_v_int_new(staged));
    bayan_json_v_obj_set(info, str_from("untracked"), bayan_json_v_int_new(untracked));
    var r = szal_result_ok_json(info);
    return str_data(r);
}

# Split a "%H|%h|%an|%ae|%aI|%s" log line into a 6-field vec (field 6 keeps any trailing '|'), or 0
# if fewer than 5 separators (line ignored, as in splitn(6,'|') + len==6 filter).
fn _git_split6(line) {
    var d = str_data(line);
    var n = str_len(line);
    var pos = alloc(40);
    var found = 0;
    var i = 0;
    while (i < n && found < 5) {
        if ((load8(d + i) & 0xFF) == 124) { store64(pos + found * 8, i); found = found + 1; }
        i = i + 1;
    }
    if (found < 5) { return 0; }
    var v = vec_new();
    var prev = 0;
    var k = 0;
    while (k < 5) {
        var p = load64(pos + k * 8);
        vec_push(v, str_new(d + prev, p - prev));
        prev = p + 1;
        k = k + 1;
    }
    vec_push(v, str_new(d + prev, n - prev));
    return v;
}

# szal_git_log: recent commits as structured records. Mirrors GitLog::call (git_tools.rs 111-151).
fn _git_log_handler(args, claims) {
    var o = _git_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var cwd = _git_cwd(o);
    var count = DEFAULT_LOG_COUNT;
    var cv = bayan_json_v_obj_get_by_cstr(o, "count");
    if (bayan_json_v_is_int(cv) == 1) {
        var c = bayan_json_v_int(cv);
        if (c >= 0) { count = c; }
    }
    if (count > MAX_LOG_COUNT) { count = MAX_LOG_COUNT; }

    var cb = str_builder_new();
    str_builder_add_cstr(cb, "-");
    str_builder_add_int(cb, count);
    var count_arg = str_cstr(str_builder_build(cb));

    var la = vec_new();
    vec_push(la, "git");
    vec_push(la, "log");
    vec_push(la, count_arg);
    vec_push(la, "--format=%H|%h|%an|%ae|%aI|%s");
    var lg = _git_cmd(la, cwd);
    if (_git_ok(lg) == 0) {
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, _git_out(lg));
        return str_data(er);
    }

    var arr = bayan_json_v_arr_new();
    var lines = str_split(_git_out(lg), 10);
    var n = vec_len(lines);
    var i = 0;
    while (i < n) {
        var parts = _git_split6(vec_get(lines, i));
        i = i + 1;
        if (parts != 0) {
            var c2 = bayan_json_v_obj_new();
            bayan_json_v_obj_set(c2, str_from("hash"), bayan_json_v_str_new(vec_get(parts, 0)));
            bayan_json_v_obj_set(c2, str_from("short_hash"), bayan_json_v_str_new(vec_get(parts, 1)));
            bayan_json_v_obj_set(c2, str_from("author"), bayan_json_v_str_new(vec_get(parts, 2)));
            bayan_json_v_obj_set(c2, str_from("email"), bayan_json_v_str_new(vec_get(parts, 3)));
            bayan_json_v_obj_set(c2, str_from("date"), bayan_json_v_str_new(vec_get(parts, 4)));
            bayan_json_v_obj_set(c2, str_from("message"), bayan_json_v_str_new(vec_get(parts, 5)));
            bayan_json_v_arr_push(arr, c2);
        }
    }
    var r = szal_result_ok_json(arr);
    return str_data(r);
}

# szal_git_diff: diff (staged/stat/refs). validate_git_ref on ref1/ref2. Mirrors GitDiff::call
# (git_tools.rs 173-220).
fn _git_diff_handler(args, claims) {
    var o = _git_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var cwd = _git_cwd(o);

    var da = vec_new();
    vec_push(da, "git");
    vec_push(da, "diff");
    var sv = bayan_json_v_obj_get_by_cstr(o, "staged");
    if (bayan_json_v_is_bool(sv) == 1) {
        if (bayan_json_v_bool(sv) == 1) { vec_push(da, "--cached"); }
    }
    var stv = bayan_json_v_obj_get_by_cstr(o, "stat_only");
    if (bayan_json_v_is_bool(stv) == 1) {
        if (bayan_json_v_bool(stv) == 1) { vec_push(da, "--stat"); }
    }

    var r1v = bayan_json_v_obj_get_by_cstr(o, "ref1");
    if (bayan_json_v_is_str(r1v) == 1) {
        var r1 = bayan_json_v_str(r1v);
        if (_git_ref_bad(r1) == 1) {
            var e = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, _git_ref_msg(r1));
            return str_data(e);
        }
        vec_push(da, str_cstr(r1));
        var r2v = bayan_json_v_obj_get_by_cstr(o, "ref2");
        if (bayan_json_v_is_str(r2v) == 1) {
            var r2 = bayan_json_v_str(r2v);
            if (_git_ref_bad(r2) == 1) {
                var e2 = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, _git_ref_msg(r2));
                return str_data(e2);
            }
            vec_push(da, str_cstr(r2));
        }
    }

    var df = _git_cmd(da, cwd);
    if (_git_ok(df) == 0) {
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, _git_out(df));
        return str_data(er);
    }
    var diff = _git_out(df);
    if (str_len(diff) == 0) { diff = str_from("no changes"); }
    var r = szal_result_ok(diff);
    return str_data(r);
}

# "invalid ref: '<s>' — must not start with '-'"
fn _git_ref_msg(s) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "invalid ref: '");
    str_builder_add(sb, s);
    str_builder_add_cstr(sb, "' — must not start with '-'");
    return str_builder_build(sb);
}

# szal_git_branch: current branch + branch list. Mirrors GitBranch::call (git_tools.rs 239-269).
fn _git_branch_handler(args, claims) {
    var o = _git_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var cwd = _git_cwd(o);
    var all = 0;
    var av = bayan_json_v_obj_get_by_cstr(o, "all");
    if (bayan_json_v_is_bool(av) == 1) { all = bayan_json_v_bool(av); }

    var ca = vec_new();
    vec_push(ca, "git");
    vec_push(ca, "rev-parse");
    vec_push(ca, "--abbrev-ref");
    vec_push(ca, "HEAD");
    var cur = _git_cmd(ca, cwd);
    var current = str_from("");
    if (_git_ok(cur) == 1) { current = _git_out(cur); }

    var ba = vec_new();
    vec_push(ba, "git");
    vec_push(ba, "branch");
    if (all == 1) { vec_push(ba, "-a"); }
    vec_push(ba, "--format=%(refname:short)");
    var br = _git_cmd(ba, cwd);
    var branches = str_from("");
    if (_git_ok(br) == 1) { branches = _git_out(br); }

    var arr = bayan_json_v_arr_new();
    var listed = 0;
    if (str_len(branches) > 0) {
        var lines = str_split(branches, 10);
        var n = vec_len(lines);
        var i = 0;
        while (i < n) {
            var line = vec_get(lines, i);
            i = i + 1;
            if (str_len(line) > 0) {
                bayan_json_v_arr_push(arr, bayan_json_v_str_new(line));
                listed = listed + 1;
            }
        }
    }

    var info = bayan_json_v_obj_new();
    bayan_json_v_obj_set(info, str_from("current"), bayan_json_v_str_new(current));
    bayan_json_v_obj_set(info, str_from("branches"), arr);
    bayan_json_v_obj_set(info, str_from("count"), bayan_json_v_int_new(listed));
    var r = szal_result_ok_json(info);
    return str_data(r);
}

# szal_git_blame: per-author line counts for a file. validate option-injection + `..`. Mirrors
# GitBlame::call (git_tools.rs 288-343).
fn _git_blame_handler(args, claims) {
    var o = _git_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var fv = bayan_json_v_obj_get_by_cstr(o, "file");
    if (bayan_json_v_is_str(fv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: file"));
        return str_data(e);
    }
    var file = bayan_json_v_str(fv);
    if (_git_ref_bad(file) == 1) {
        var ep = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, str_from("file must not start with '-'"));
        return str_data(ep);
    }
    if (str_contains(file, str_from("..")) == 1) {
        var ed = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, str_from("file must not contain '..'"));
        return str_data(ed);
    }
    var cwd = _git_cwd(o);

    var ba = vec_new();
    vec_push(ba, "git");
    vec_push(ba, "blame");
    vec_push(ba, "--porcelain");
    vec_push(ba, str_cstr(file));
    var bl = _git_cmd(ba, cwd);
    if (_git_ok(bl) == 0) {
        var er = szal_result_error_typed(SZAL_MCP_IO_ERROR, _git_out(bl));
        return str_data(er);
    }

    # Count "author <name>" lines per author into a Str-keyed map.
    var authors = map_new_str();
    var order = vec_new();
    var lines = str_split(_git_out(bl), 10);
    var n = vec_len(lines);
    var prefix = str_from("author ");
    var total = 0;
    var i = 0;
    while (i < n) {
        var line = vec_get(lines, i);
        i = i + 1;
        if (str_starts_with(line, prefix) == 1) {
            var name = str_substr(line, 7, str_len(line));
            var cur = map_get(authors, name);
            if (cur == 0) { vec_push(order, name); }
            map_set(authors, name, cur + 1);
            total = total + 1;
        }
    }

    # Sort the distinct authors by descending line count (selection sort).
    var na = vec_len(order);
    var a = 0;
    while (a < na) {
        var best = a;
        var b = a + 1;
        while (b < na) {
            if (map_get(authors, vec_get(order, b)) > map_get(authors, vec_get(order, best))) { best = b; }
            b = b + 1;
        }
        if (best != a) {
            var tmp = vec_get(order, a);
            vec_set(order, a, vec_get(order, best));
            vec_set(order, best, tmp);
        }
        a = a + 1;
    }

    var arr = bayan_json_v_arr_new();
    var j = 0;
    while (j < na) {
        var name2 = vec_get(order, j);
        j = j + 1;
        var ao = bayan_json_v_obj_new();
        bayan_json_v_obj_set(ao, str_from("name"), bayan_json_v_str_new(name2));
        bayan_json_v_obj_set(ao, str_from("lines"), bayan_json_v_int_new(map_get(authors, name2)));
        bayan_json_v_arr_push(arr, ao);
    }

    var info = bayan_json_v_obj_new();
    bayan_json_v_obj_set(info, str_from("file"), bayan_json_v_str_new(file));
    bayan_json_v_obj_set(info, str_from("total_lines"), bayan_json_v_int_new(total));
    bayan_json_v_obj_set(info, str_from("authors"), arr);
    var r = szal_result_ok_json(info);
    return str_data(r);
}

# --- schema property builders ---

fn _git_path_prop() {
    return schema_prop_new("path",
      "{ \"type\": \"string\", \"description\": \"Repository path (default: current dir)\" }");
}

fn _git_status_props() {
    var v = vec_new();
    vec_push(v, _git_path_prop());
    return v;
}

fn _git_log_props() {
    var v = vec_new();
    vec_push(v, _git_path_prop());
    vec_push(v, schema_prop_new("count",
        "{ \"type\": \"integer\", \"description\": \"Number of commits (default: 10, max: 100)\" }"));
    return v;
}

fn _git_diff_props() {
    var v = vec_new();
    vec_push(v, _git_path_prop());
    vec_push(v, schema_prop_new("staged",
        "{ \"type\": \"boolean\", \"description\": \"Show staged changes (default: false)\" }"));
    vec_push(v, schema_prop_new("ref1", "{ \"type\": \"string\", \"description\": \"First ref for comparison\" }"));
    vec_push(v, schema_prop_new("ref2", "{ \"type\": \"string\", \"description\": \"Second ref for comparison\" }"));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{ \"type\": \"boolean\", \"description\": ");
    str_builder_add_cstr(sb, "\"Show only file stats, not full diff (default: false)\" }");
    var so_c = str_cstr(str_builder_build(sb));
    vec_push(v, schema_prop_new("stat_only", so_c));
    return v;
}

fn _git_branch_props() {
    var v = vec_new();
    vec_push(v, _git_path_prop());
    vec_push(v, schema_prop_new("all",
        "{ \"type\": \"boolean\", \"description\": \"Include remote branches (default: false)\" }"));
    return v;
}

fn _git_blame_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("file", "{ \"type\": \"string\", \"description\": \"File path to blame\" }"));
    vec_push(v, _git_path_prop());
    return v;
}

# The git tool group: status, log, diff, branch, blame.
fn szal_git_tools() {
    var tools = vec_new();
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_git_status", "Get git status (branch, modified/staged/untracked files)",
          _git_status_props(), vec_new()), &_git_status_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_git_log", "Get recent git commits", _git_log_props(), vec_new()),
        &_git_log_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_git_diff", "Get git diff (staged, unstaged, or between refs)",
          _git_diff_props(), vec_new()), &_git_diff_handler));

    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_git_branch", "List git branches and show current branch",
          _git_branch_props(), vec_new()), &_git_branch_handler));

    var bl_req = vec_new();
    vec_push(bl_req, "file");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_git_blame", "Show git blame for a file (who last modified each line)",
          _git_blame_props(), bl_req), &_git_blame_handler));
    return tools;
}

# --- mcp_tools_net.cyr ---

# mcp_tools_net.cyr — MCP network tools (ports mcp/tools/net_tools.rs): szal_http, szal_dns_lookup,
# szal_port_check, szal_url_encode. THE FINAL TOOL FILE — also defines szal_all_tools() and the
# registration entry points (szal_register_tools[_with], szal_register_into).
#
# SECURITY (SSRF + rate limits — do NOT regress):
#  - szal_http requires http(s):// and runs `is_safe_url` (this file): blocks cloud-metadata endpoints
#    (169.254.169.254, metadata.google.internal/.goog), localhost/127.0.0.1/::1/0.0.0.0, and RFC1918
#    ranges (10/8, 192.168/16, 172.16-31/12). Header values with CR/LF are rejected (no header
#    injection). curl runs via the no-shell _proc_run.
#  - Every network op consults the majra rate limiter via pool() (mcp_pool.cyr): HTTP per-host, DNS
#    per-hostname, port per host:port — over-limit → Timeout.
#
# PARITY NOTES (§23):
#  - DNS resolution shells out to `getent ahosts <host>` (no getaddrinfo wired) — addresses are its
#    first-column IPs, deduped. szal_port_check connects to a dotted-quad host only (no hostname
#    resolution) via net_connect_nb; the timeout IS enforced (poll-based). url_decode does not
#    UTF-8-validate (the invalid-UTF8 error branch is unreachable). curl exec inherits the §22 limits.
#
# Usage: include AFTER all other mcp_tools_*.cyr + src/mcp_tools_process.cyr + src/mcp_pool.cyr +
#   lib/net.cyr + src/mcp.cyr (+ lib/bayan, lib/str).

enum NetTools {
    DEFAULT_HTTP_TIMEOUT_SECS = 30;
    DEFAULT_PORT_CHECK_TIMEOUT_MS = 3000;
}

fn _net_parse_args(args) {
    var s = str_from(args);
    return bayan_json_v_parse(s);
}

# Lowercase ASCII copy of a Str.
fn _net_lower(s) {
    var n = str_len(s);
    var d = str_data(s);
    var buf = alloc(n);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(buf + i, c);
        i = i + 1;
    }
    return str_new(buf, n);
}

# Extract the host (no scheme, no port, no path) from a URL Str.
fn _net_host(url) {
    var rest = url;
    if (str_starts_with(url, str_from("http://")) == 1) { rest = str_substr(url, 7, str_len(url)); }
    elif (str_starts_with(url, str_from("https://")) == 1) { rest = str_substr(url, 8, str_len(url)); }
    var d = str_data(rest);
    var n = str_len(rest);
    var end = 0;
    while (end < n) {
        var c = load8(d + end) & 0xFF;
        if (c == 47 || c == 58) { end = n + 1; } else { end = end + 1; }
    }
    var hlen = 0;
    while (hlen < n) {
        var c2 = load8(d + hlen) & 0xFF;
        if (c2 == 47 || c2 == 58) { return str_new(d, hlen); }
        hlen = hlen + 1;
    }
    return str_new(d, n);
}

# is_safe_url: 0 if the host is allowed, else an error-message Str. Mirrors is_safe_url (net_tools.rs 14-60).
fn _net_is_safe(url) {
    var host = _net_host(url);
    var lo = _net_lower(host);

    if (str_eq_cstr(lo, "169.254.169.254") == 1 || str_eq_cstr(lo, "metadata.google.internal") == 1
      || str_eq_cstr(lo, "metadata.goog") == 1) {
        var mb = str_builder_new();
        str_builder_add_cstr(mb, "requests to ");
        str_builder_add(mb, host);
        str_builder_add_cstr(mb, " are blocked");
        return str_builder_build(mb);
    }

    var priv = 0;
    if (str_eq_cstr(lo, "localhost") == 1 || str_eq_cstr(lo, "127.0.0.1") == 1
      || str_eq_cstr(lo, "::1") == 1 || str_eq_cstr(lo, "0.0.0.0") == 1) { priv = 1; }
    if (str_starts_with(lo, str_from("10.")) == 1) { priv = 1; }
    if (str_starts_with(lo, str_from("192.168.")) == 1) { priv = 1; }
    if (str_starts_with(lo, str_from("172.")) == 1) {
        # second octet in 16..=31
        var d = str_data(lo);
        var n = str_len(lo);
        var i = 4;
        var oct = 0;
        var got = 0;
        while (i < n) {
            var c = load8(d + i) & 0xFF;
            if (c >= 48 && c <= 57) { oct = oct * 10 + (c - 48); got = 1; i = i + 1; }
            else { i = n; }
        }
        if (got == 1 && oct >= 16 && oct <= 31) { priv = 1; }
    }
    if (priv == 1) {
        var pb = str_builder_new();
        str_builder_add_cstr(pb, "requests to private/internal addresses are blocked: ");
        str_builder_add(pb, host);
        return str_builder_build(pb);
    }
    return 0;
}

# szal_http: HTTP request via curl with SSRF guard + rate limit. Mirrors HttpRequest::call
# (net_tools.rs 81-205). The successful-curl path is faithful but untested (tests cover rejections).
fn _http_handler(args, claims) {
    var o = _net_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var uv = bayan_json_v_obj_get_by_cstr(o, "url");
    if (bayan_json_v_is_str(uv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: url"));
        return str_data(e);
    }
    var url = bayan_json_v_str(uv);
    if (str_starts_with(url, str_from("http://")) == 0 && str_starts_with(url, str_from("https://")) == 0) {
        var es = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("only http:// and https:// URLs are allowed"));
        return str_data(es);
    }
    var unsafe_msg = _net_is_safe(url);
    if (unsafe_msg != 0) {
        var ep = szal_result_error_typed(SZAL_MCP_PERMISSION_DENIED, unsafe_msg);
        return str_data(ep);
    }
    var host = _net_host(url);
    if (szal_pool_check_http(szal_net_pool(), str_cstr(host)) == 0) {
        var rb = str_builder_new();
        str_builder_add_cstr(rb, "rate limit exceeded for host: ");
        str_builder_add(rb, host);
        var er = szal_result_error_typed(SZAL_MCP_TIMEOUT, str_builder_build(rb));
        return str_data(er);
    }

    var method = "GET";
    var mv = bayan_json_v_obj_get_by_cstr(o, "method");
    if (bayan_json_v_is_str(mv) == 1) { method = str_cstr(bayan_json_v_str(mv)); }
    var timeout = DEFAULT_HTTP_TIMEOUT_SECS;
    var tv = bayan_json_v_obj_get_by_cstr(o, "timeout_secs");
    if (bayan_json_v_is_int(tv) == 1) { timeout = bayan_json_v_int(tv); }
    var tb = str_builder_new();
    str_builder_add_int(tb, timeout);
    var timeout_c = str_cstr(str_builder_build(tb));

    var argv = vec_new();
    vec_push(argv, "curl");
    vec_push(argv, "-s");
    vec_push(argv, "-S");
    vec_push(argv, "-w");
    vec_push(argv, "\n%{http_code}");
    vec_push(argv, "-X");
    vec_push(argv, method);
    vec_push(argv, "--max-time");
    vec_push(argv, timeout_c);
    vec_push(argv, "-D");
    vec_push(argv, "-");

    var hv = bayan_json_v_obj_get_by_cstr(o, "headers");
    if (bayan_json_v_is_obj(hv) == 1) {
        var pairs = load64(hv + 8);
        var hn = vec_len(pairs);
        var hi = 0;
        while (hi < hn) {
            var pair = vec_get(pairs, hi);
            hi = hi + 1;
            var key = load64(pair);
            var valv = load64(pair + 8);
            if (bayan_json_v_is_str(valv) == 1) {
                var val = bayan_json_v_str(valv);
                if (_net_has_crlf(key) == 1 || _net_has_crlf(val) == 1) {
                    var hb = str_builder_new();
                    str_builder_add_cstr(hb, "header '");
                    str_builder_add(hb, key);
                    str_builder_add_cstr(hb, "' contains invalid newline characters");
                    var eh = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(hb));
                    return str_data(eh);
                }
                var kb = str_builder_new();
                str_builder_add(kb, key);
                str_builder_add_cstr(kb, ": ");
                str_builder_add(kb, val);
                vec_push(argv, "-H");
                vec_push(argv, str_cstr(str_builder_build(kb)));
            }
        }
    }
    var bv = bayan_json_v_obj_get_by_cstr(o, "body");
    if (bayan_json_v_is_str(bv) == 1) {
        vec_push(argv, "-d");
        vec_push(argv, str_cstr(bayan_json_v_str(bv)));
    }
    vec_push(argv, str_cstr(url));

    var res = _proc_run(argv, 0);
    if (load64(res + 24) != 1) {
        var ef = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_from("failed to execute curl"));
        return str_data(ef);
    }
    # Parse: last stdout line = status code; headers up to the first blank line, then body.
    var raw = load64(res + 8);
    var lines = str_split(raw, 10);
    var nl = vec_len(lines);
    var status_code = 0;
    if (nl > 0) {
        var last = vec_get(lines, nl - 1);
        status_code = _net_atoi(last);
    }
    var headers = bayan_json_v_arr_new();
    var bodyb = str_builder_new();
    var in_headers = 1;
    var first_body = 1;
    var li = 0;
    while (li < nl) {
        var line = vec_get(lines, li);
        var idx = li;
        li = li + 1;
        if (idx == nl - 1) { idx = idx; } else {
            if (in_headers == 1) {
                if (str_len(line) == 0) { in_headers = 0; } else {
                    bayan_json_v_arr_push(headers, bayan_json_v_str_new(line));
                }
            } else {
                if (first_body == 0) { str_builder_add_byte(bodyb, 10); }
                str_builder_add(bodyb, line);
                first_body = 0;
            }
        }
    }
    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("status_code"), bayan_json_v_int_new(status_code));
    bayan_json_v_obj_set(out, str_from("headers"), headers);
    bayan_json_v_obj_set(out, str_from("body"), bayan_json_v_str_new(str_builder_build(bodyb)));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# 1 if a Str contains CR or LF.
fn _net_has_crlf(s) {
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c == 10 || c == 13) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Parse a leading non-negative integer from a Str (0 if none).
fn _net_atoi(s) {
    var d = str_data(s);
    var n = str_len(s);
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); i = i + 1; } else { i = n; }
    }
    return v;
}

# szal_dns_lookup: resolve a hostname (via `getent ahosts`). Mirrors DnsLookup::call (net_tools.rs 221-258).
fn _dns_handler(args, claims) {
    var o = _net_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var hv = bayan_json_v_obj_get_by_cstr(o, "hostname");
    if (bayan_json_v_is_str(hv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: hostname"));
        return str_data(e);
    }
    var hostname = bayan_json_v_str(hv);
    if (szal_pool_check_dns(szal_net_pool(), str_cstr(hostname)) == 0) {
        var rb = str_builder_new();
        str_builder_add_cstr(rb, "rate limit exceeded for DNS: ");
        str_builder_add(rb, hostname);
        var er = szal_result_error_typed(SZAL_MCP_TIMEOUT, str_builder_build(rb));
        return str_data(er);
    }

    var argv = vec_new();
    vec_push(argv, "getent");
    vec_push(argv, "ahosts");
    vec_push(argv, str_cstr(hostname));
    var res = _proc_run(argv, 0);
    if (load64(res + 24) != 1 || load64(res) != 0 || str_len(load64(res + 8)) == 0) {
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "DNS lookup failed for ");
        str_builder_add(eb, hostname);
        var ef = szal_result_error_typed(SZAL_MCP_IO_ERROR, str_builder_build(eb));
        return str_data(ef);
    }

    # Collect the first whitespace-delimited field (the IP) of each line; dedup.
    var seen = map_new_str();
    var arr = bayan_json_v_arr_new();
    var lines = str_split(load64(res + 8), 10);
    var n = vec_len(lines);
    var i = 0;
    while (i < n) {
        var line = vec_get(lines, i);
        i = i + 1;
        var ip = _net_first_field(line);
        if (str_len(ip) > 0) {
            if (map_get(seen, ip) == 0) {
                map_set(seen, ip, 1);
                bayan_json_v_arr_push(arr, bayan_json_v_str_new(ip));
            }
        }
    }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("hostname"), bayan_json_v_str_new(hostname));
    bayan_json_v_obj_set(out, str_from("addresses"), arr);
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# First whitespace-delimited field of a line (Str).
fn _net_first_field(line) {
    var d = str_data(line);
    var n = str_len(line);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c == 32 || c == 9) { return str_new(d, i); }
        i = i + 1;
    }
    return line;
}

# Parse a dotted-quad IPv4 host into a net-order u32 address, or -1 if not a dotted quad.
fn _net_parse_ipv4(host) {
    var d = str_data(host);
    var n = str_len(host);
    var octs = alloc(32);
    var count = 0;
    var cur = 0;
    var got = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        i = i + 1;
        if (c >= 48 && c <= 57) { cur = cur * 10 + (c - 48); got = 1; }
        elif (c == 46) {
            if (got == 0 || cur > 255 || count >= 4) { return (0 - 1); }
            store64(octs + count * 8, cur);
            count = count + 1;
            cur = 0;
            got = 0;
        } else { return (0 - 1); }
    }
    if (got == 0 || cur > 255 || count != 3) { return (0 - 1); }
    store64(octs + 3 * 8, cur);
    var o1 = load64(octs);
    var o2 = load64(octs + 8);
    var o3 = load64(octs + 16);
    var o4 = load64(octs + 24);
    return o1 | (o2 << 8) | (o3 << 16) | (o4 << 24);
}

# szal_port_check: is a TCP port open on a dotted-quad host? Mirrors PortCheck::call (net_tools.rs 278-331).
fn _port_check_handler(args, claims) {
    var o = _net_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var host = str_from("127.0.0.1");
    var hv = bayan_json_v_obj_get_by_cstr(o, "host");
    if (bayan_json_v_is_str(hv) == 1) { host = bayan_json_v_str(hv); }

    var pv = bayan_json_v_obj_get_by_cstr(o, "port");
    if (bayan_json_v_is_int(pv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: port"));
        return str_data(e);
    }
    var port = bayan_json_v_int(pv);
    if (port < 0 || port > 65535) {
        var rb = str_builder_new();
        str_builder_add_cstr(rb, "port ");
        str_builder_add_int(rb, port);
        str_builder_add_cstr(rb, " out of range (0-65535)");
        var er = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(rb));
        return str_data(er);
    }
    var timeout_ms = DEFAULT_PORT_CHECK_TIMEOUT_MS;
    var tv = bayan_json_v_obj_get_by_cstr(o, "timeout_ms");
    if (bayan_json_v_is_int(tv) == 1) { timeout_ms = bayan_json_v_int(tv); }

    var kb = str_builder_new();
    str_builder_add(kb, host);
    str_builder_add_byte(kb, 58);
    str_builder_add_int(kb, port);
    var key = str_builder_build(kb);
    if (szal_pool_check_port(szal_net_pool(), str_cstr(key)) == 0) {
        var rb2 = str_builder_new();
        str_builder_add_cstr(rb2, "rate limit exceeded for port check: ");
        str_builder_add(rb2, key);
        var er2 = szal_result_error_typed(SZAL_MCP_TIMEOUT, str_builder_build(rb2));
        return str_data(er2);
    }

    var open = 0;
    var addr = _net_parse_ipv4(host);
    if (addr != (0 - 1)) {
        var sr_t, sr_v = tcp_socket();
        if (is_ok(sr_t) == 1) {
            var fd = result_unwrap(sr_t, sr_v);
            if (net_connect_nb(fd, addr, port, timeout_ms) == _NET_CONN_NB_OK) { open = 1; }
            sock_close(fd);
        }
    }

    var out = bayan_json_v_obj_new();
    bayan_json_v_obj_set(out, str_from("host"), bayan_json_v_str_new(host));
    bayan_json_v_obj_set(out, str_from("port"), bayan_json_v_int_new(port));
    bayan_json_v_obj_set(out, str_from("open"), bayan_json_v_bool_new(open));
    var r = szal_result_ok_json(out);
    return str_data(r);
}

# Uppercase hex digit for a 0-15 nibble.
fn _net_hex(nib) {
    if (nib < 10) { return 48 + nib; }
    return 65 + nib - 10;
}
fn _net_unhex(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 65 && c <= 70) { return c - 65 + 10; }
    if (c >= 97 && c <= 102) { return c - 97 + 10; }
    return (0 - 1);
}

# szal_url_encode: percent-encode/decode. Mirrors UrlEncode::call (net_tools.rs 350-413).
fn _url_encode_handler(args, claims) {
    var o = _net_parse_args(args);
    if (o == 0) { return szal_args_error(args); }
    var iv = bayan_json_v_obj_get_by_cstr(o, "input");
    if (bayan_json_v_is_str(iv) == 0) {
        var e = szal_result_error_typed(SZAL_MCP_VALIDATION, str_from("missing required field: input"));
        return str_data(e);
    }
    var input = bayan_json_v_str(iv);
    var op = "encode";
    var ov = bayan_json_v_obj_get_by_cstr(o, "operation");
    if (bayan_json_v_is_str(ov) == 1) { op = str_cstr(bayan_json_v_str(ov)); }

    if (streq(op, "encode") == 1) {
        var sb = str_builder_new();
        var d = str_data(input);
        var n = str_len(input);
        var i = 0;
        while (i < n) {
            var c = load8(d + i) & 0xFF;
            i = i + 1;
            var keep = 0;
            if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { keep = 1; }
            if (c == 45 || c == 95 || c == 46 || c == 126) { keep = 1; }
            if (keep == 1) { str_builder_add_byte(sb, c); } else {
                str_builder_add_byte(sb, 37);
                str_builder_add_byte(sb, _net_hex((c >> 4) & 0xF));
                str_builder_add_byte(sb, _net_hex(c & 0xF));
            }
        }
        var re = szal_result_ok(str_builder_build(sb));
        return str_data(re);
    }
    if (streq(op, "decode") == 1) {
        var sb2 = str_builder_new();
        var d2 = str_data(input);
        var n2 = str_len(input);
        var i2 = 0;
        while (i2 < n2) {
            var c2 = load8(d2 + i2) & 0xFF;
            if (c2 == 37 && i2 + 2 < n2) {
                var h1 = _net_unhex(load8(d2 + i2 + 1) & 0xFF);
                var h2 = _net_unhex(load8(d2 + i2 + 2) & 0xFF);
                if (h1 >= 0 && h2 >= 0) {
                    str_builder_add_byte(sb2, (h1 << 4) | h2);
                    i2 = i2 + 3;
                } else {
                    str_builder_add_byte(sb2, 37);
                    i2 = i2 + 1;
                }
            } elif (c2 == 43) {
                str_builder_add_byte(sb2, 32);
                i2 = i2 + 1;
            } else {
                str_builder_add_byte(sb2, c2);
                i2 = i2 + 1;
            }
        }
        var rd = szal_result_ok(str_builder_build(sb2));
        return str_data(rd);
    }

    var sb3 = str_builder_new();
    str_builder_add_cstr(sb3, "invalid operation: ");
    str_builder_add_cstr(sb3, op);
    var rv = szal_result_error_typed(SZAL_MCP_VALIDATION, str_builder_build(sb3));
    return str_data(rv);
}

# --- schema property builders ---

fn _http_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("url", "{ \"type\": \"string\", \"description\": \"URL to request\" }"));
    var mb = str_builder_new();
    str_builder_add_cstr(mb, "{ \"type\": \"string\", \"enum\": [\"GET\", \"POST\", \"PUT\", ");
    str_builder_add_cstr(mb, "\"DELETE\", \"PATCH\", \"HEAD\"], \"description\": \"HTTP method (default: GET)\" }");
    vec_push(v, schema_prop_new("method", str_cstr(str_builder_build(mb))));
    vec_push(v, schema_prop_new("headers",
        "{ \"type\": \"object\", \"description\": \"Request headers as key-value pairs\" }"));
    vec_push(v, schema_prop_new("body",
        "{ \"type\": \"string\", \"description\": \"Request body (for POST/PUT/PATCH)\" }"));
    vec_push(v, schema_prop_new("timeout_secs",
        "{ \"type\": \"integer\", \"description\": \"Timeout in seconds (default: 30)\" }"));
    return v;
}

fn _dns_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("hostname", "{ \"type\": \"string\", \"description\": \"Hostname to resolve\" }"));
    return v;
}

fn _port_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("host",
        "{ \"type\": \"string\", \"description\": \"Host to check (default: 127.0.0.1)\" }"));
    vec_push(v, schema_prop_new("port", "{ \"type\": \"integer\", \"description\": \"TCP port number\" }"));
    vec_push(v, schema_prop_new("timeout_ms",
        "{ \"type\": \"integer\", \"description\": \"Connection timeout in ms (default: 3000)\" }"));
    return v;
}

fn _url_props() {
    var v = vec_new();
    vec_push(v, schema_prop_new("input", "{ \"type\": \"string\", \"description\": \"String to encode/decode\" }"));
    var ob = str_builder_new();
    str_builder_add_cstr(ob, "{ \"type\": \"string\", \"enum\": [\"encode\", \"decode\"], ");
    str_builder_add_cstr(ob, "\"description\": \"Operation (default: encode)\" }");
    vec_push(v, schema_prop_new("operation", str_cstr(str_builder_build(ob))));
    return v;
}

# The network tool group: szal_http, szal_dns_lookup, szal_port_check, szal_url_encode.
fn szal_net_tools() {
    var tools = vec_new();
    var u_req = vec_new();
    vec_push(u_req, "url");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_http", "Make an HTTP request via curl and return status, headers, and body",
          _http_props(), u_req), &_http_handler));

    var h_req = vec_new();
    vec_push(h_req, "hostname");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_dns_lookup", "Perform a DNS lookup for a hostname", _dns_props(), h_req),
        &_dns_handler));

    var p_req = vec_new();
    vec_push(p_req, "port");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_port_check", "Check if a TCP port is open on a host", _port_props(), p_req),
        &_port_check_handler));

    var i_req = vec_new();
    vec_push(i_req, "input");
    vec_push(tools, szal_tool_new(
        szal_tool_def("szal_url_encode", "URL encode or decode a string", _url_props(), i_req),
        &_url_encode_handler));
    return tools;
}

# --- aggregator: all 15 tool groups (54 tools) ---

# Append every Tool pair from `src` into `dst`.
fn _all_append(dst, src) {
    var n = vec_len(src);
    var i = 0;
    while (i < n) {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return 0;
}

# All 54 built-in szal MCP tools, in the rust-old all_tools() order: a fresh vec of Tool pairs
# (szal_tool_def_of / szal_tool_handler_of). The single source of truth for what every
# szal_register_* entry point wires into a dispatcher. (mcp/tools/mod.rs all_tools())
fn szal_all_tools() {
    var t = vec_new();
    _all_append(t, szal_step_tools());
    _all_append(t, szal_flow_tools());
    _all_append(t, szal_state_tools());
    _all_append(t, szal_engine_tools());
    _all_append(t, szal_system_tools());
    _all_append(t, szal_encoding_tools());
    _all_append(t, szal_json_tools());
    _all_append(t, szal_file_tools());
    _all_append(t, szal_process_tools());
    _all_append(t, szal_hash_tools());
    _all_append(t, szal_template_tools());
    _all_append(t, szal_net_tools());
    _all_append(t, szal_math_tools());
    _all_append(t, szal_conversion_tools());
    _all_append(t, szal_git_tools());
    return t;
}

# Register all built-in szal tools into a fresh dispatcher with no audit/event sinks. Mirrors Rust's
# register_tools() (mcp/mod.rs 39-41). Returns the dispatcher.
fn szal_register_tools() {
    return szal_register_tool_vec(szal_all_tools());
}

# Register all built-in szal tools into a fresh dispatcher with optional audit / event sinks (0 =
# None). Mirrors Rust's register_tools_with(audit, events) (mcp/mod.rs 47-82).
fn szal_register_tools_with(audit, events) {
    return szal_register_tool_vec_with(szal_all_tools(), audit, events);
}

# Add all built-in szal tools to a consumer's EXISTING bote dispatcher `d` — next to whatever it
# already registered, under its own audit and event sinks. The entry point for a gateway that owns
# its dispatcher (hoosh's mcp_init registers these beside bote_echo). `d` must be a live dispatcher.
# Returns 0, or the first BoteError bote reports; see szal_register_tool_vec_into.
fn szal_register_into(d) {
    return szal_register_tool_vec_into(d, szal_all_tools());
}
