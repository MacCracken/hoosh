[package]
name = "hoosh"
version = "${file:VERSION}"
description = "AI inference gateway — multi-provider LLM routing, token budgets, caching"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"
repository = "https://github.com/MacCracken/hoosh"

[build]
entry = "src/main.cyr"
output = "build/hoosh"

[deps]
# bayan (6.1.27) is the consolidated bigint + toml + json module — the
# standalone bigint/toml/json snapshot files were merged into it. It must
# precede sigil (sigil references bayan's u256 surface).
# sys must precede sigil too: since sigil 3.12.18 (cyrius 6.6.4) its
# agnosys_uname calls lib/sys.cyr's sys_uname. Without sys the build warns
# `undefined function 'sys_uname'` and that call compiles to a trap.
# Since sigil 3.13.3 (cyrius 6.7.18 ships 3.13.15) the fold includes its own
# leaves (lib/sys.cyr, lib/bayan.cyr, …) and takes uname_release from
# lib/sys.cyr, so the old benign `duplicate fn 'uname_release'` is gone. The
# order above is kept: include-once makes the repeats no-ops.
stdlib = ["string", "fmt", "alloc", "vec", "str", "io", "fs", "args", "hashmap", "freelist", "bayan", "ct", "keccak", "random", "sys", "sigil", "tagged", "http", "net", "chrono", "syscalls", "process", "atomic", "sync", "thread", "thread_local", "sakshi", "patra", "fnptr", "mmap", "dynlib", "fdlopen", "async", "tls", "sandhi", "assert", "bench", "math"]

# Hardware accelerator detection — consumed as the single-file distlib
# bundle (cyrius deps vendors dist/ai-hwaccel.cyr → lib/ai-hwaccel.cyr,
# included from src/main.cyr). Cyrius does not resolve transitive deps,
# so ai-hwaccel's own stdlib needs are already covered by [deps] above.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel"
tag = "2.5.6"
modules = ["dist/ai-hwaccel.cyr"]

# In-process ternary (1.58-bit) inference (2.11.0, ADR 014): tentib's library bundle (1.4.0 since 2.11.1:
# incremental decode, tx_pack_peek, the byte-vocabulary flag, same-shape reloads).
# tentib's manifest declares rosnet and tyche (its f64 substrate), so `cyrius deps` vendors
# lib/rosnet.cyr and lib/tyche.cyr with lib/tentib.cyr; akshara is tentib's test-scope dep
# and does not come. The bundle's requires block names one stdlib leaf (math). None of the
# three shares a function or global name with hoosh, its vendored bundles or its stdlib
# set (checked 2026-11-09, and again for 1.4.0's names: only a function-local `dec_len` in
# lib/unicode/normalize.cyr shares one, and a local shadows the global). Powers src/lib/tentib_local.cyr.
[deps.tentib]
git = "https://github.com/MacCracken/tentib"
tag = "1.5.1"
modules = ["dist/tentib.cyr"]

# The command line (2.12.0, ADR 015): cmdit's single-file bundle, the AGNOS CLI parser. It has no git sub-deps, and
# its `# Requires` block names only stdlib leaves listed above (args, alloc, string, io). Its names are `cmdit_*`,
# `CMDIT_*` and `_cmdit_*`, and none collides with hoosh, its vendored bundles or its stdlib set (checked
# 2026-11-11). src/lib/cli.cyr builds hoosh's handles on it.
[deps.cmdit]
git = "https://github.com/MacCracken/cmdit"
tag = "1.5.1"
modules = ["dist/cmdit.cyr"]

# MCP protocol core (bote) — JSON-RPC 2.0 registry/dispatcher, powers
# /v1/tools/list + /v1/tools/call. We consume bote's **core** bundle
# (`[lib.core]`, 12 transport-free modules: error/protocol/jsonx/registry/
# prompts/resources/events/audit/dispatch/codec/schema/content) — the
# surface for consumers that wrap bote's Dispatcher/Registry but supply
# their own transport, exactly hoosh's HTTP server.
#
# NOT consumed via `[deps.bote]`: unlike ai-hwaccel (whose manifest has no
# git sub-deps), bote's manifest declares `[deps.libro]` + `[deps.majra]`
# for its full bundle's `events_majra`/`audit_libro` modules. `cyrius deps`
# recurses into those git sub-deps, vendoring libro/majra → bayan/ganita/
# agnosys and adding them all to the compile set — where the agnos superset
# (agnosys) collides with bote-core's registry constructor ("last definition
# wins", a correctness hazard) and trips an agnosys slice-include error.
# (As of bote 2.7.6 the constructor is `tool_registry_new`; the other
# `registry_*` ops keep their names. ai-hwaccel's own constructor is
# `hw_registry_new`, so the two no longer share a name.)
# The core bundle itself is self-contained (no libro/majra symbols). Its
# `# Requires` block includes only stdlib leaves listed above (hashmap and
# sys since bote 3.4.13 dropped bayan), and since bote 3.4.0 its log.cyr calls
# sakshi, which a copied bundle must list itself — "sakshi" above covers it.
# So we vendor
# it directly as `src/vendor/bote-core.cyr` (committed; see that file's
# header for the pinned bote tag) and include it from src/main.cyr. Re-sync
# with `./scripts/sync-bote.sh <tag>`.
#
# majra (2.13.0) — provider event bus pubsub — is vendored the same way at
# src/vendor/majra.cyr (self-contained dist/majra.cyr; its `# Requires` block
# names only stdlib leaves listed above, so the includes are no-ops; majra
# ships no pubsub-only profile, so this is its smallest bundle). Re-sync by
# fetching dist/majra.cyr at the new tag. majra still exports
# ratelimit_new/ratelimit_check, which is why src/lib/ratelimit.cyr names its
# own hoosh_ratelimit_* — no function names overlap. The one shared name is
# the enum member ERR_NONE (= 0 in both majra and src/lib/types.cyr; majra
# 2.8.0 renamed its codes MAJRA_ERR_* and keeps ERR_* as aliases until 3.0.0).
# Powers src/lib/events.cyr.
#
# szál's MCP tools (2.12.1) are vendored the same way, at src/vendor/szal-mcp.cyr: szál 2.3.2's `[lib.mcp]`
# profile, 54 tools with no bote-core, majra, ai-hwaccel or stdlib inside. Its `# Requires` block names stdlib
# leaves hoosh lists above, and `math`, added to [deps].stdlib for it (tentib's bundle included it too, so lib/
# already had the file). Its one name in common with hoosh's compile set is the enum member REQ_NONE (= 0 in both
# szál and ai-hwaccel); szál's scripts/consumer-check.sh allow-lists it and passes against hoosh 2.12.0 and its
# bote-core 3.8.15. Re-sync with `./scripts/sync-szal.sh <tag>`. Powers src/lib/mcp.cyr's tool groups.
